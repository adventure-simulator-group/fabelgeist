# Copy to .env (gitignored) and fill in what you use. scripts/deploy.py reads
# this file; real environment variables take precedence. See DEPLOY.md.

# Hetzner Cloud API token with read/write permission. With this set,
# `just deploy <domain>` creates or reuses a server named fabelgeist-<domain>,
# registers ~/.ssh/id_ed25519.pub and applies a firewall. Leave it unset to
# deploy to an existing machine over ssh instead (see DEPLOY_HOST).
HCLOUD_TOKEN=

# Where and what size. Defaults: location ash; cpx11 for the showcase, cpx31
# for the game (it compiles Bevy in release on the box).
# HCLOUD_LOCATION=ash
# HCLOUD_SERVER_TYPE=cpx11
# HCLOUD_IMAGE=ubuntu-24.04

# Reuse a server that already exists under a different name.
# HCLOUD_SERVER_NAME=fabelgeist-play

# SSH is opened only from this address. Unset: your public IP is detected.
# HCLOUD_SSH_CIDR=203.0.113.10/32
# HCLOUD_SSH_KEY_PATH=~/.ssh/id_ed25519.pub

# Deploy to this host and skip Hetzner entirely. Needs key-based ssh access.
# DEPLOY_HOST=203.0.113.20
# DEPLOY_USER=root
# DEPLOY_ROOT=/opt/fabelgeist

# Game target only.
# SERVICE_USER=fabelgeist
# DEPLOY_REPO=https://github.com/adventure-simulator-group/fabelgeist.git
# SPACETIMEDB_DATABASE=adventuresim-stdb-module
