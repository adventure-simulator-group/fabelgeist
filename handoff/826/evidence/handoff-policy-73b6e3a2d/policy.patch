+//! Authored screen-size and shading policies for the three render targets.
+
+use super::{AccumulationFrames, Band, CardLevelIndex, Form, HairShading, LodPolicy};
+use super::{PixelSpan, Quality, ShadowMapSize, ShadowQuality, SimBand, StrandLevelIndex};
+use crate::sim::SimLevel;
+use fabelgeist_math::Ratio;
+
+impl LodPolicy {
+    /// Every strand at every point, always.
+    pub fn cinematic() -> Self {
+        Self {
+            name: "Cinematic",
+            bands: vec![Band {
+                min_pixels: PixelSpan::from_pixels(0.0),
+                form: Form::Strands {
+                    level: StrandLevelIndex::from_index(0),
+                    share: Ratio::from_ratio(1.0),
+                },
+            }],
+            quality: Quality {
+                shading: HairShading::Marschner,
+                shadows: ShadowQuality::DeepOpacity {
+                    size: ShadowMapSize::from_texels(2048),
+                },
+                accumulate: AccumulationFrames::from_count(64),
+                min_pixels: PixelSpan::from_pixels(0.5),
+            },
+            shadow_level: StrandLevelIndex::from_index(0),
+            shadow_share: Ratio::from_ratio(1.0),
+            blend: Ratio::from_ratio(0.0),
+            sim: vec![SimBand {
+                min_pixels: PixelSpan::from_pixels(0.0),
+                level: SimLevel::HIGH,
+            }],
+        }
+    }
+
+    /// Strands close up, thinning with distance, cards far away. Every
+    /// strand until the head is under 300 pixels tall -- a head in a
+    /// medium shot at 1080p -- so what is coarser only shows where too
+    /// little of it is on screen to tell.
+    pub fn desktop() -> Self {
+        Self {
+            name: "Desktop",
+            bands: vec![
+                Band {
+                    min_pixels: PixelSpan::from_pixels(300.0),
+                    form: Form::Strands {
+                        level: StrandLevelIndex::from_index(0),
+                        share: Ratio::from_ratio(1.0),
+                    },
+                },
+                Band {
+                    min_pixels: PixelSpan::from_pixels(150.0),
+                    form: Form::Strands {
+                        level: StrandLevelIndex::from_index(1),
+                        share: Ratio::from_ratio(0.5),
+                    },
+                },
+                Band {
+                    min_pixels: PixelSpan::from_pixels(70.0),
+                    form: Form::Strands {
+                        level: StrandLevelIndex::from_index(2),
+                        share: Ratio::from_ratio(0.2),
+                    },
+                },
+                Band {
+                    min_pixels: PixelSpan::from_pixels(32.0),
+                    form: Form::Cards {
+                        level: CardLevelIndex::from_index(0),
+                    },
+                },
+                Band {
+                    min_pixels: PixelSpan::from_pixels(0.0),
+                    form: Form::Cards {
+                        level: CardLevelIndex::from_index(1),
+                    },
+                },
+            ],
+            quality: Quality {
+                shading: HairShading::Marschner,
+                shadows: ShadowQuality::DeepOpacity {
+                    size: ShadowMapSize::from_texels(1024),
+                },
+                accumulate: AccumulationFrames::from_count(8),
+                min_pixels: PixelSpan::from_pixels(1.0),
+            },
+            shadow_level: StrandLevelIndex::from_index(2),
+            shadow_share: Ratio::from_ratio(0.25),
+            blend: Ratio::from_ratio(0.4),
+            sim: vec![
+                SimBand {
+                    min_pixels: PixelSpan::from_pixels(260.0),
+                    level: SimLevel::HIGH,
+                },
+                SimBand {
+                    min_pixels: PixelSpan::from_pixels(110.0),
+                    level: SimLevel::MEDIUM,
+                },
+                SimBand {
+                    min_pixels: PixelSpan::from_pixels(0.0),
+                    level: SimLevel::LOW,
+                },
+            ],
+        }
+    }
+
+    /// A fifth of the strands close up, a tenth further, cards far away;
+    /// cheap shading and only baked shadowing.
+    pub fn mobile() -> Self {
+        Self {
+            name: "Mobile",
+            bands: vec![
+                Band {
+                    min_pixels: PixelSpan::from_pixels(300.0),
+                    form: Form::Strands {
+                        level: StrandLevelIndex::from_index(2),
+                        share: Ratio::from_ratio(0.2),
+                    },
+                },
+                Band {
+                    min_pixels: PixelSpan::from_pixels(140.0),
+                    form: Form::Strands {
+                        level: StrandLevelIndex::from_index(3),
+                        share: Ratio::from_ratio(0.1),
+                    },
+                },
+                Band {
+                    min_pixels: PixelSpan::from_pixels(55.0),
+                    form: Form::Cards {
+                        level: CardLevelIndex::from_index(0),
+                    },
+                },
+                Band {
+                    min_pixels: PixelSpan::from_pixels(0.0),
+                    form: Form::Cards {
+                        level: CardLevelIndex::from_index(1),
+                    },
+                },
+            ],
+            quality: Quality {
+                shading: HairShading::KajiyaKay,
+                shadows: ShadowQuality::Baked,
+                accumulate: AccumulationFrames::from_count(1),
+                min_pixels: PixelSpan::from_pixels(1.0),
+            },
+            shadow_level: StrandLevelIndex::from_index(3),
+            shadow_share: Ratio::from_ratio(0.1),
+            blend: Ratio::from_ratio(0.4),
+            sim: vec![
+                SimBand {
+                    min_pixels: PixelSpan::from_pixels(220.0),
+                    level: SimLevel::MEDIUM,
+                },
+                SimBand {
+                    min_pixels: PixelSpan::from_pixels(0.0),
+                    level: SimLevel::LOW,
+                },
+            ],
+        }
+    }
+}
diff --git a/crates/fabelgeist-hair/src/lod/quality.rs b/crates/fabelgeist-hair/src/lod/quality.rs
new file mode 100644
index 000000000..e808dcc77
--- /dev/null
+++ b/crates/fabelgeist-hair/src/lod/quality.rs
@@ -0,0 +1,105 @@
+//! Screen-space quantities and the shading choices carried into a renderer.
+
+const MIN_SHADOW_MAP_TEXELS: u32 = 16;
+
+/// A fractional distance on screen, in pixels. Numerical policy calculations
+/// retain signed and non-finite input semantics; render admission checks the
+/// effective finite values before publishing a frame.
+#[derive(Clone, Copy, Debug, Default, PartialEq, PartialOrd)]
+pub struct PixelSpan(f32);
+
+/// Number of samples in a temporal running mean. Zero is an unrendered mean;
+/// a requested target always requires at least one sample.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
+pub struct AccumulationFrames(u32);
+
+/// Width and height in texels of a square deep-opacity map. The existing
+/// renderer minimum is retained; the native device owns upper size limits.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ShadowMapSize(u32);
+
+/// How the hair is shaded and accumulated.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Quality {
+    pub shading: HairShading,
+    pub shadows: ShadowQuality,
+    pub accumulate: AccumulationFrames,
+    /// Narrower strands fade instead of becoming thinner.
+    pub min_pixels: PixelSpan,
+}
+
+/// The real-time hair reflectance model.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum HairShading {
+    /// Marschner's three lobes with multiple scattering, using Karis' fit.
+    Marschner,
+    /// Kajiya-Kay with two shifted highlights.
+    KajiyaKay,
+}
+
+/// Live key-light shadows, or only the groom's baked occlusion.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ShadowQuality {
+    Baked,
+    DeepOpacity { size: ShadowMapSize },
+}
+
+impl PixelSpan {
+    pub const fn from_pixels(pixels: f32) -> Self {
+        Self(pixels)
+    }
+
+    /// Scalar for a screen-space numerical kernel or native shader uniform.
+    pub const fn pixels(self) -> f32 {
+        self.0
+    }
+}
+
+impl AccumulationFrames {
+    pub const fn from_count(count: u32) -> Self {
+        Self(count)
+    }
+
+    /// Sample count for output or the temporal numerical kernel.
+    pub const fn count(self) -> u32 {
+        self.0
+    }
+
+    pub fn target(self) -> Self {
+        Self(self.0.max(1))
+    }
+
+    pub fn next(self) -> Self {
+        Self(self.0.saturating_add(1))
+    }
+
+    pub fn next_weight(self) -> f32 {
+        1.0 / (u64::from(self.0) + 1) as f32
+    }
+}
+
+impl ShadowMapSize {
+    /// Keep the renderer's minimum of sixteen texels per edge.
+    pub fn from_texels(texels: u32) -> Self {
+        Self(texels.max(MIN_SHADOW_MAP_TEXELS))
+    }
+
+    /// Edge extent at the native texture or numerical-kernel boundary.
+    pub const fn texels(self) -> u32 {
+        self.0
+    }
+}
+
+impl ShadowQuality {
+    pub const fn size(self) -> Option<ShadowMapSize> {
+        match self {
+            Self::Baked => None,
+            Self::DeepOpacity { size } => Some(size),
+        }
+    }
+
+    /// Native shader and pass-enable boundary.
+    pub const fn enabled(self) -> bool {
+        matches!(self, Self::DeepOpacity { .. })
+    }
+}
