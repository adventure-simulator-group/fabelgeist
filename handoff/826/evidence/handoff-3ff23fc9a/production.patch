diff --git a/crates/fabelgeist-compute/src/kernel/batch_error.rs b/crates/fabelgeist-compute/src/kernel/batch_error.rs
new file mode 100644
--- /dev/null
+++ b/crates/fabelgeist-compute/src/kernel/batch_error.rs
@@ -0,0 +1,27 @@
+use fabelgeist_gpu::data::gpu::buffer::BufferByteLength;
+use std::{error::Error, fmt};
+
+#[derive(Debug)]
+pub enum KernelBatchError {
+    CopyOutOfBounds {
+        requested: BufferByteLength,
+        source: BufferByteLength,
+        destination: BufferByteLength,
+    },
+}
+
+impl fmt::Display for KernelBatchError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::CopyOutOfBounds {
+                requested,
+                source,
+                destination,
+            } => write!(
+                formatter,
+                "KernelBatch::copy_buffer: {requested} bytes does not fit {source} -> {destination}"
+            ),
+        }
+    }
+}
+impl Error for KernelBatchError {}
diff --git a/crates/fabelgeist-compute/src/kernel/dispatch_count.rs b/crates/fabelgeist-compute/src/kernel/dispatch_count.rs
new file mode 100644
--- /dev/null
+++ b/crates/fabelgeist-compute/src/kernel/dispatch_count.rs
@@ -0,0 +1,15 @@
+//! Recorded dispatches, independent of compilations, items or workgroups.
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, serde::Serialize)]
+#[serde(transparent)]
+pub struct RecordedDispatchCount(usize);
+impl RecordedDispatchCount {
+    pub(super) fn record(&mut self) {
+        self.0 += 1;
+    }
+}
+impl std::fmt::Display for RecordedDispatchCount {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.0.fmt(formatter)
+    }
+}
