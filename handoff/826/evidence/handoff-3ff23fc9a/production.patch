+        self.format
+    }
+    pub fn usage(&self) -> wgpu::TextureUsages {
+        self.usage
+    }
+    pub fn extent(&self) -> wgpu::Extent3d {
+        wgpu::Extent3d {
+            width: self.size.0,
+            height: self.size.1,
+            depth_or_array_layers: self.size.2,
+        }
+    }
+    pub fn native_texture(&self) -> Option<&Arc<wgpu::Texture>> {
+        self.texture.as_ref()
+    }
