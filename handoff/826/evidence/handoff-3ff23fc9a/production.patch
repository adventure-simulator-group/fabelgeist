+++ b/crates/fabelgeist-compute/src/kernel/fast/compile.rs
@@ -0,0 +1,57 @@
+use crate::prelude::*;
+
+pub(super) struct CompiledLayout {
+    pub(super) layout: wgpu::BindGroupLayout,
+    pub(super) pipeline: wgpu::ComputePipeline,
+}
+
+impl CompiledLayout {
+    pub(super) fn new(
+        context: &WgpuContext,
+        entries: &[wgpu::BindGroupLayoutEntry],
+        module: &wgpu::ShaderModule,
+        entry_point: &str,
+    ) -> Result<Self> {
+        #[cfg(not(target_arch = "wasm32"))]
+        let error_scope = context.blocking_validation.then(|| {
+            context
+                .device
+                .push_error_scope(wgpu::ErrorFilter::Validation)
+        });
+        let layout = context
+            .device
+            .create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("Kernel Bind Layout"),
+                entries,
+            });
+        let pipeline_layout =
+            context
+                .device
+                .create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+                    label: Some("Kernel Pipeline Layout"),
+                    bind_group_layouts: &[Some(&layout)],
+                    immediate_size: 0,
+                });
+        let pipeline = context
+            .device
+            .create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+                label: Some("Kernel Pipeline"),
+                layout: Some(&pipeline_layout),
+                module,
+                entry_point: Some(entry_point),
+                compilation_options: wgpu::PipelineCompilationOptions::default(),
+                cache: None,
+            });
+        #[cfg(not(target_arch = "wasm32"))]
+        if let Some(error_scope) = error_scope {
+            let _ = context.device.poll(wgpu::PollType::wait_indefinitely());
+            if let Some(error) = pollster::block_on(error_scope.pop()) {
+                return Err(fabelgeist_gpu::data::ComputePipelineError::Native(
+                    std::sync::Arc::new(error),
+                )
+                .into());
+            }
+        }
+        Ok(Self { layout, pipeline })
+    }
+}
diff --git a/crates/fabelgeist-compute/src/kernel/fast/uniforms.rs b/crates/fabelgeist-compute/src/kernel/fast/uniforms.rs
new file mode 100644
--- /dev/null
+++ b/crates/fabelgeist-compute/src/kernel/fast/uniforms.rs
@@ -0,0 +1,63 @@
+use crate::prelude::*;
+use fabelgeist_gpu::data::gpu::shader::UniformMember;
+
+/// Pack the uniform block from named parameters, by reflected offsets.
+///
+/// Covers the scalar, vector and matrix kinds a solver passes. Anything else
+/// is reported rather than silently skipped -- a uniform quietly left at zero
+/// is a wrong simulation, not an error, and those are the expensive ones.
+pub(super) fn write_uniform(
+    members: &[UniformMember],
+    parameters: &PassParameters,
+    out: &mut [u8],
+) -> Result<()> {
+    for member in members {
+        let Some(value) = parameters.get(&member.name) else {
+            return Err(ComputePassError::MissingParameter {
+                name: member.name.clone(),
+                kind: ComputeBindingKind::Uniform,
+            }
+            .into());
+        };
+        let offset = usize::try_from(u64::from(member.offset))
+            .map_err(ComputePassError::UniformHostAddress)?;
+
+        let mut put = |values: &[f32]| {
+            let end = offset + values.len() * 4;
+            if end <= out.len() {
+                for (index, value) in values.iter().enumerate() {
+                    out[offset + index * 4..offset + index * 4 + 4]
+                        .copy_from_slice(&value.to_le_bytes());
+                }
+            }
+        };
+
+        match value {
+            PassParameter::Number(n) => put(&[*n as f32]),
+            PassParameter::Unsigned(u) => {
+                if offset + 4 <= out.len() {
+                    out[offset..offset + 4].copy_from_slice(&u.to_le_bytes());
+                }
+            }
+            PassParameter::Vec2(v) => put(&[v.x, v.y]),
+            PassParameter::Vec3(v) => put(&[v.x, v.y, v.z]),
+            PassParameter::Vec4(v) => put(&[v.x, v.y, v.z, v.w]),
+            PassParameter::Mat4(m) => {
+                let mut values = Vec::with_capacity(16);
+                for column in 0..4 {
+                    for row in 0..4 {
+                        values.push(m.columns[column][row]);
+                    }
+                }
+                put(&values);
+            }
+            _ => {
+                return Err(ComputePassError::UnsupportedUniform {
+                    name: member.name.clone(),
+                }
+                .into());
+            }
+        }
+    }
+    Ok(())
+}
