+/// Finite admitted operands for a configured or deadline-directed planar turn.
+/// A tiny deadline may overflow the transient rate; only the completed native
+/// quotient -> elapsed product -> pi cap is the retained rotation operation.
+#[derive(Clone, Copy, Debug)]
+pub struct BodyFacingTurn(TurnPolicy);
+
+#[derive(Clone, Copy, Debug)]
+enum TurnPolicy {
+    Speed(AngularSpeedRadians),
+    HalfTurn(PositiveAnimationDuration),
+    Deadline {
+        angle: Radians,
+        duration: PositiveAnimationDuration,
+    },
+}
+
+impl BodyFacingTurn {
+    pub fn configured_half_turn(duration: PositiveAnimationDuration) -> Self {
+        Self(TurnPolicy::HalfTurn(duration))
     }
-    current.angle_to(desired).abs() / duration
+
+    pub fn configured_speed(speed: AngularSpeedRadians) -> Self {
+        Self(TurnPolicy::Speed(speed))
+    }
+
+    /// The effective deadline is the larger of remaining time and frame elapsed.
+    /// Missing planar direction and two real zero intervals preserve no turn.
+    pub fn for_deadline(
+        current: Quat,
+        desired_forward: Vec3,
+        remaining: AnimationElapsed,
+        elapsed: AnimationElapsed,
+    ) -> AnimationValueResult<Self> {
+        let Some(desired) = desired_forward.xz().try_normalize() else {
+            return Ok(Self::configured_speed(AngularSpeedRadians::ZERO));
+        };
+        let current = (current * Vec3::Z).xz().normalize_or_zero();
+        let duration = remaining.max(elapsed);
+        if duration.is_zero() {
+            return Ok(Self::configured_speed(AngularSpeedRadians::ZERO));
+        }
+        let angle = Radians::new(current.angle_to(desired).abs()).map_err(|_| {
+            AnimationValueError::NonFinite {
+                quantity: AnimationQuantity::BodyOrientation,
+            }
+        })?;
+        Ok(Self(TurnPolicy::Deadline {
+            angle,
+            duration: PositiveAnimationDuration::from_elapsed(duration)?,
+        }))
+    }
+
+    /// Native yaw integration is the only rate projection for application facing.
+    pub fn advance(
+        self,
+        current: Quat,
+        desired_forward: Vec3,
+        elapsed: AnimationElapsed,
+    ) -> AnimationValueResult<Quat> {
+        let current_yaw = body_yaw(current);
+        let desired_yaw = desired_forward.x.atan2(desired_forward.z);
+        let mut delta = (desired_yaw - current_yaw + std::f32::consts::PI)
+            .rem_euclid(std::f32::consts::TAU)
+            - std::f32::consts::PI;
+        if (delta + std::f32::consts::PI).abs() <= 1.0e-5 {
+            delta = std::f32::consts::PI;
+        }
+        let maximum = (self.native_radians_per_second() * elapsed.seconds().max(0.0))
+            .min(std::f32::consts::PI);
+        rotation_from_yaw(current_yaw + delta.clamp(-maximum, maximum))
+    }
+
+    /// Captured-vector error budget at the final report's angular measurement.
+    pub fn tracking_residual(self, before: Vec3, desired: Vec3, elapsed: AnimationElapsed) -> f32 {
+        (before.angle_between(desired) - self.native_radians_per_second() * elapsed.seconds())
+            .max(0.0)
+    }
+
+    // Local to the two complete native numerical kernels above. Infinity can be
+    // transient here, but is never an admitted speed, field, or application handoff.
+    fn native_radians_per_second(self) -> f32 {
+        match self.0 {
+            TurnPolicy::Speed(speed) => speed.radians_per_second(),
+            TurnPolicy::HalfTurn(duration) => std::f32::consts::PI / duration.seconds(),
+            TurnPolicy::Deadline { angle, duration } => angle.radians() / duration.seconds(),
+        }
+    }
+}
+
+pub fn body_facing_turn() -> BodyFacingTurn {
+    BodyFacingTurn::configured_half_turn(
+        crate::combat_config::runtime_combat_presentation_config().body_turn_seconds_per_half_turn,
+    )
+}
+
+pub fn downed_turn_speed_radians() -> AngularSpeedRadians {
+    crate::combat_config::runtime_combat_presentation_config().downed_turn_radians_per_second
+}
+
+/// Returns the controller's yaw without allowing camera pitch or roll to tilt
+/// planar locomotion into or out of the ground plane.
+pub fn controller_yaw(orientation: Quat) -> Quat {
+    let forward = orientation * Vec3::NEG_Z;
+    let Some(flat_forward) = forward.xz().try_normalize() else {
+        return Quat::IDENTITY;
+    };
+    Quat::from_rotation_y((-flat_forward.x).atan2(-flat_forward.y))
+}
+
+/// Root orientation committed when a procedural directional dive launches.
+/// Dive travel and pelvis tilt are both camera-relative, so they must capture
+/// the same controller frame before posture-transition facing locks.
+pub fn dive_launch_root_rotation(controller_orientation: Quat) -> Quat {
+    let forward = controller_yaw(controller_orientation) * Vec3::NEG_Z;
+    Quat::from_rotation_y(forward.x.atan2(forward.z))
+}
+
+/// Guard follows look; ordinary moving states follow authoritative planar velocity.
+pub fn advance_body_facing(
+    current: Quat,
+    controller_orientation: Quat,
+    linear_velocity: Vec3,
+    action: SkeletonAction,
+    weapon_guard: WeaponGuardState,
+    elapsed: AnimationElapsed,
+) -> AnimationValueResult<Quat> {
+    advance_body_facing_with_turn(
+        current,
+        controller_orientation,
+        linear_velocity,
+        action,
+        weapon_guard,
+        elapsed,
+        body_facing_turn(),
+    )
+}
+
+pub fn advance_body_facing_with_turn(
+    current: Quat,
+    controller_orientation: Quat,
+    linear_velocity: Vec3,
+    action: SkeletonAction,
+    weapon_guard: WeaponGuardState,
+    elapsed: AnimationElapsed,
+    turn: BodyFacingTurn,
+) -> AnimationValueResult<Quat> {
+    let current_yaw = body_yaw(current);
+    let desired_forward = if weapon_guard == WeaponGuardState::Raised
+        || matches!(action, SkeletonAction::Attack | SkeletonAction::Block)
+    {
+        controller_yaw(controller_orientation) * Vec3::NEG_Z
+    } else {
+        if linear_velocity.xz().length() <= STATIONARY_ANIMATION_SPEED_LIMIT.metres_per_second() {
+            return rotation_from_yaw(current_yaw);
+        }
+        let Some(direction) = linear_velocity.xz().try_normalize() else {
+            return rotation_from_yaw(current_yaw);
+        };
+        Vec3::new(direction.x, 0.0, direction.y)
+    };
+    turn.advance(current, desired_forward, elapsed)
+}
+
+pub fn advance_downed_body_facing(
+    current: Quat,
+    controller_orientation: Quat,
+    elapsed: AnimationElapsed,
+) -> AnimationValueResult<Quat> {
+    advance_downed_body_facing_with_speed(
+        current,
+        controller_orientation,
+        elapsed,
+        downed_turn_speed_radians(),
+    )
+}
+
+pub fn advance_downed_body_facing_with_speed(
+    current: Quat,
+    controller_orientation: Quat,
+    elapsed: AnimationElapsed,
+    speed: AngularSpeedRadians,
+) -> AnimationValueResult<Quat> {
+    let desired_forward = controller_yaw(controller_orientation) * Vec3::NEG_Z;
+    BodyFacingTurn::configured_speed(speed).advance(current, desired_forward, elapsed)
+}
+
+pub(super) fn body_yaw(rotation: Quat) -> f32 {
+    let forward = rotation * Vec3::Z;
+    forward.x.atan2(forward.z)
+}
+
+fn rotation_from_yaw(yaw: f32) -> AnimationValueResult<Quat> {
+    let yaw = Radians::new(yaw).map_err(|_| AnimationValueError::NonFinite {
+        quantity: AnimationQuantity::BodyOrientation,
+    })?;
+    Ok(Quat::from_rotation_y(yaw.radians()))
 }
 
