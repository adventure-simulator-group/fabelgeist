+            vista_revision: vista.revision(),
+        },
+        TerrainTriangleCount(mesh_triangle_count(&detail_mesh)),
+        NotShadowCaster,
+        Mesh3d(meshes.add(detail_mesh)),
+        MeshMaterial3d(detail_material),
+    ));
+    Ok(())
 }
 
