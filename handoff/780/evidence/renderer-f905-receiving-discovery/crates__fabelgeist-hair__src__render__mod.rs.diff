+/// Geometry available to the selected primary representation.
+///
+/// Strand populations retain their point count. Cards report indexed triangles,
+/// including directly supplied meshes that have no generated strip metadata.
+/// These populations precede stochastic coverage and transition cuts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum FramePopulation {
+    Empty,
+    Strands {
+        strands: StrandCount,
+        points: PointsPerStrand,
+    },
+    CardTriangles(MeshTriangleCount),
+}
+
+impl Camera {
+    pub fn view_projection(&self, aspect: f32) -> Mat4 {
+        let distance = math::length(math::sub(self.target, self.eye));
+        let near = (distance * 0.02).max(0.005);
+        let far = distance * 10.0 + 5.0;
+        let forward = math::normalize(math::sub(self.target, self.eye));
+        let up = if forward[1].abs() > 0.99 {
+            [0.0, 0.0, 1.0]
+        } else {
+            [0.0, 1.0, 0.0]
+        };
+        multiply(
+            &perspective(self.fov_y, aspect, near, far),
+            &look_at(self.eye, self.target, up),
+        )
+    }
+}
+
+impl Light {
+    /// From an azimuth (around the vertical, from the front) and an
+    /// elevation, radians.
+    pub fn from_angles(azimuth: f32, elevation: f32, color: [f32; 3], intensity: f32) -> Self {
+        let (sa, ca) = azimuth.sin_cos();
+        let (se, ce) = elevation.sin_cos();
+        Self {
+            direction: [ce * sa, se, ce * ca],
+            color,
+            intensity,
+        }
+    }
+}
+
