+            material: None,
+            resistance,
+            padding,
+            flexibility: 0.5,
+            range_of_motion: 1.0,
+            coverage: 1.0,
+            coverage_geometry: AuthoredArmorCoverage::from_span(ArmorCoverageSpan::centered(1.0)),
+        }
+    }
 }
 
