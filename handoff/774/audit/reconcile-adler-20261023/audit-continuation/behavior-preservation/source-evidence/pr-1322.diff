+#[cfg(not(target_family = "wasm"))]
+fn diagnostic_clips(playback: &AnimationPlayback) -> Vec<DiagnosticClip> {
+    playback
+        .plan
+        .clips()
+        .iter()
+        .map(|clip| DiagnosticClip {
+            weight: clip.weight,
+            time_seconds: clip.time_seconds,
+            mirrored_weight: clip.mirrored_weight,
+        })
+        .collect::<Vec<_>>()
