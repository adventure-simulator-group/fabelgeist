+        &self.mirror.pairs
+    }
+
+    fn retain_stable_role(&mut self, role: BoneRole, entity: Entity) -> Option<Entity> {
+        let retained = self
+            .get(&role)
+            .map_or(entity, |existing| (*existing).min(entity));
+        self.bones.insert(role, retained)
+    }
 }
 
