+
+fn clothing_specifications(loadout: &Loadout<'_>) -> Result<Vec<GarmentSpecification>> {
+    loadout
+        .clothing
+        .iter()
+        .map(|piece| {
+            Ok(GarmentSpecification::from_catalog(
+                format!(
+                    "{} · {}",
+                    piece.selection.item().display_name,
+                    piece.selection.id
+                )
+                .into(),
+                piece.selection,
+            )?)
+        })
+        .collect()
+}
