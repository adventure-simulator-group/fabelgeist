+/// Source emission is the native encoding boundary; preserve the existing f32 literal spellings.
+fn fatigue_source(value: CombatFatigueParameters) -> String {
+    format!(
+        "CombatFatigueParameters {{ mechanical_efficiency: {:?}, capacity_joules_per_endurance: {:?}, recovery_watts_per_endurance: {:?}, aerobic_watts_per_endurance: {:?}, carry_watts_per_kg: {:?}, minimum_endurance: {:?}, minimum_action_seconds: match crate::elapsed::AnimationElapsed::from_seconds({:?}_f32) {{ Ok(elapsed) => elapsed, Err(_) => panic!(\"invalid embedded action duration\") }}, maximum_action_seconds: match crate::elapsed::AnimationElapsed::from_seconds({:?}_f32) {{ Ok(elapsed) => elapsed, Err(_) => panic!(\"invalid embedded action duration\") }}, attack_travel_metres: {:?}, defense_travel_metres: {:?}, dodge_speed_metres_per_second: match crate::linear_speed::PositiveSpeed::from_metres_per_second({:?}_f32) {{ Ok(speed) => speed, Err(_) => panic!(\"invalid embedded dodge speed\") }} }}",
+        value.mechanical_efficiency,
+        value.capacity_joules_per_endurance,
+        value.recovery_watts_per_endurance,
+        value.aerobic_watts_per_endurance,
+        value.carry_watts_per_kg,
+        value.minimum_endurance,
+        value.minimum_action_seconds.seconds(),
+        value.maximum_action_seconds.seconds(),
+        value.attack_travel_metres,
+        value.defense_travel_metres,
+        value.dodge_speed_metres_per_second.metres_per_second(),
+    )
+}
