+//! Authoritative landing observations retained by animation state.
+
+use super::{
+    AnimationEventSpan, AnimationQuantity, AnimationValueError, AnimationValueResult,
+    NonnegativeSpeed,
+};
+use derive_more::{Debug, Display, From};
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize, From, Display)]
+#[serde(transparent)]
+#[debug("{_0:?}")]
+pub struct LandingSequence(u64);
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize, derive_more::Into)]
+#[serde(try_from = "f32", into = "f32")]
+#[debug("{:?}", self.0.metres_per_second())]
+#[into(f32)]
+pub struct LandingImpactSpeed(NonnegativeSpeed);
+
+impl LandingSequence {
+    pub const ZERO: Self = Self(0);
+    pub fn next(self) -> Self {
+        Self(self.0.wrapping_add(1))
+    }
+    pub fn events_since(self, previous: Self) -> Option<AnimationEventSpan> {
+        self.0.checked_sub(previous.0).map(AnimationEventSpan::from)
+    }
+    /// Observed report continuity is distinct from checked event coalescing.
+    pub fn wrapping_distance_from(self, previous: Self) -> AnimationEventSpan {
+        AnimationEventSpan::from(self.0.wrapping_sub(previous.0))
+    }
+    /// Scalar event-stream encoding, separate from a rig slot or sample tick.
+    pub fn encoded(self) -> u64 {
+        self.0
+    }
+}
+
+impl LandingImpactSpeed {
+    pub const ZERO: Self = Self(NonnegativeSpeed::ZERO);
+    pub fn from_metres_per_second(speed: f32) -> AnimationValueResult<Self> {
+        NonnegativeSpeed::from_metres_per_second(speed)
+            .map(Self)
+            .map_err(|error| {
+                AnimationValueError::from(error).for_quantity(AnimationQuantity::LandingImpactSpeed)
+            })
+    }
+    pub fn speed(self) -> NonnegativeSpeed {
+        self.0
+    }
+    pub fn metres_per_second(self) -> f32 {
+        self.0.metres_per_second()
+    }
+}
+
+impl TryFrom<f32> for LandingImpactSpeed {
+    type Error = AnimationValueError;
+    fn try_from(value: f32) -> AnimationValueResult<Self> {
+        Self::from_metres_per_second(value)
+    }
+}
diff --git a/crates/adventuresim-tactical-core/src/animation/locomotion.rs b/crates/adventuresim-tactical-core/src/animation/locomotion.rs
index bb61fb9b9..f55ac992d 100644
--- a/crates/adventuresim-tactical-core/src/animation/locomotion.rs
+++ b/crates/adventuresim-tactical-core/src/animation/locomotion.rs
@@ -1,5 +1,24 @@
 use super::*;
 
+/// One bilateral locomotion cycle hands support between two contacts.
+pub const LOCOMOTION_CONTACTS_PER_CYCLE: u8 = 2;
+pub const LOCOMOTION_SECOND_CONTACT_PHASE: f32 = 0.5;
+
+/// Fixed movement-presence policy used by foot support and presentation. This
+/// deliberately remains distinct from configurable playback hysteresis speeds.
+pub const STATIONARY_ANIMATION_SPEED_LIMIT: NonnegativeSpeed =
+    match NonnegativeSpeed::from_metres_per_second(0.05) {
+        Ok(speed) => speed,
+        Err(_) => panic!("stationary animation speed limit must be finite and nonnegative"),
