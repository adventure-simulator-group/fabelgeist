+        let height = terrain?.height_at(point)?;
+        raised_support_is_actual(nominal_support, ankle.y, height)
+    } else {
+        nominal_support
+    };
+    Some(if supported {
+        UnitInterval::ONE
+    } else {
+        UnitInterval::ZERO
+    })
