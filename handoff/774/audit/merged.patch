+//! Authored travel and inertial target policy in body-local coordinates.
+
+use super::*;
+use adventuresim_tactical_core::animation::UnitInterval;
+
+/// Squared m/s comparison allowance for classifying measured deceleration.
+const DECELERATION_SPEED_SQUARED_ALLOWANCE: f32 = 0.000_1;
+
+pub(in crate::animation::procedural) fn body_response_target(
+    velocity: BodyLocalVelocity,
+    acceleration: BodyLocalAcceleration,
+    braking_scale: BrakingLeanScale,
+) -> AnimationValueResult<BodyResponseAngles> {
+    velocity
+        .planar_squared()
+        .map_err(|_| AnimationValueError::Overflow {
+            quantity: AnimationQuantity::BodyAngle,
+        })?;
+    let tuning = body_response_tuning();
+    let travel = travel_lean(velocity, tuning)?;
+    let inertial = inertial_lean(velocity, acceleration, braking_scale, tuning)?;
+    // A cap-specific radian margin keeps degree reporting below the authored cap.
+    let maximum = BodyAngularMagnitude::from_radians(
+        tuning.maximum_response_degrees.radians() - BODY_RESPONSE_DEGREE_REPORT_MARGIN_RADIANS,
+    )?;
+    travel.checked_sum_capped(inertial, maximum)
+}
+
+pub(super) fn deceleration_lean_scale(
+    previous_velocity: BodyLocalVelocity,
+    velocity: BodyLocalVelocity,
+    acceleration: BodyLocalAcceleration,
+) -> AnimationValueResult<BrakingLeanScale> {
+    let previous_squared = previous_velocity.planar_squared()?;
+    let current_squared = velocity.planar_squared()?;
+    let previous_velocity = previous_velocity.metres_per_second();
+    let velocity = velocity.metres_per_second();
+    let acceleration = acceleration.metres_per_second_squared();
+    let previous_planar = previous_velocity.xz();
+    let planar = velocity.xz();
+    let planar_acceleration = acceleration.xz();
+    if !previous_planar.dot(planar_acceleration).is_finite() {
+        return Err(AnimationValueError::Overflow {
+            quantity: AnimationQuantity::BodyLocalVelocity,
+        });
+    }
+    let is_decelerating = previous_planar.dot(planar_acceleration) < 0.0
+        && current_squared <= previous_squared + DECELERATION_SPEED_SQUARED_ALLOWANCE;
+    BrakingLeanScale::from_fraction(if is_decelerating {
+        (planar.length() / run_locomotion_profile().reference_speed.metres_per_second())
+            .clamp(0.0, 1.0)
+    } else {
+        1.0
+    })
+}
+
+fn travel_lean(
+    velocity: BodyLocalVelocity,
+    tuning: BodyResponseConfig,
+) -> AnimationValueResult<BodyResponseAngles> {
+    let velocity = velocity.metres_per_second();
+
+    // Tactical body forward is local +Z (the authored rig carries its own
+    // facing correction). Authored locomotion keeps a straight back, so steady
+    // travel supplies a pronounced base lean and acceleration adds a somewhat
+    // stronger combined startup pose. Keeping most of the lean in travel avoids
+    // a large initial snap followed by an almost upright steady run.
+    let reference_speed = run_locomotion_profile().reference_speed.metres_per_second();
+    let travel_pitch = BodyAngle::from_authored_scale(
+        velocity.z / reference_speed,
+        tuning.steady_travel_lean_degrees,
+    )?
+    .clamped_symmetric(tuning.maximum_travel_lean_degrees)?;
+    let travel_roll = BodyAngle::from_authored_scale(
+        -velocity.x / reference_speed,
+        tuning.steady_travel_lean_degrees,
+    )?
+    .clamped_symmetric(tuning.maximum_travel_lean_degrees)?;
+    Ok(BodyResponseAngles {
+        pitch: travel_pitch,
+        roll: travel_roll,
+    })
+}
+fn inertial_lean(
+    velocity: BodyLocalVelocity,
+    acceleration: BodyLocalAcceleration,
+    braking_scale: BrakingLeanScale,
+    tuning: BodyResponseConfig,
+) -> AnimationValueResult<BodyResponseAngles> {
+    let velocity = velocity.metres_per_second();
+    let acceleration = acceleration.metres_per_second_squared();
+    // Acceleration is an early accent rather than a second full pose. Fade it
+    // almost completely into the stable velocity posture, so reaching target
+    // speed cannot release a late, visibly separate lean.
+    let speed_ratio =
+        velocity.xz().length() / run_locomotion_profile().reference_speed.metres_per_second();
+    if !speed_ratio.is_finite() {
+        return Err(AnimationValueError::Overflow {
+            quantity: AnimationQuantity::BodyAngle,
+        });
+    }
+    let speed_fraction = UnitInterval::from_fraction(speed_ratio.clamp(0.0, 1.0))?;
+    let startup_inertial_scale = tuning
+        .startup_inertial_lean_scale
+        .interpolated(tuning.sustained_inertial_lean_scale, speed_fraction)?;
+    let inertial_pitch = if acceleration.z > 0.0 {
+        BodyAngle::from_authored_scale(
+            tuning
+                .forward_reference_acceleration_metres_per_second_squared
+                .component_ratio(acceleration.z),
+            tuning.forward_acceleration_lean_degrees,
+        )?
+        .clamped_positive(tuning.maximum_forward_acceleration_lean_degrees)?
+        .scaled_inertial(startup_inertial_scale)?
+    } else {
+        BodyAngle::from_authored_scale(
+            tuning
+                .forward_reference_acceleration_metres_per_second_squared
+                .component_ratio(acceleration.z),
+            tuning.braking_acceleration_lean_degrees,
+        )?
+        .clamped_negative(tuning.maximum_braking_lean_degrees)?
+        .scaled_braking(braking_scale)?
+    };
+    // Turning should read clearly without the extreme motorcycle-like bank of
+    // the first stronger-lean pass. Keep lateral travel posture unchanged and
+    // scale only acceleration-driven turning response to 60% of that tuning.
+    let inertial_roll = BodyAngle::from_authored_scale(
+        tuning
+            .lateral_reference_acceleration_metres_per_second_squared
+            .component_ratio(-acceleration.x),
+        tuning.lateral_acceleration_lean_degrees,
+    )?
+    .clamped_symmetric(tuning.maximum_lateral_acceleration_lean_degrees)?
+    .scaled_inertial(startup_inertial_scale)?;
+    Ok(BodyResponseAngles {
+        pitch: inertial_pitch,
+        roll: inertial_roll,
+    })
+}
diff --git a/crates/adventuresim-tactical-client/src/animation/procedural/body_values.rs b/crates/adventuresim-tactical-client/src/animation/procedural/body_values.rs
new file mode 100644
index 000000000..37c18d48d
--- /dev/null
+++ b/crates/adventuresim-tactical-client/src/animation/procedural/body_values.rs
@@ -0,0 +1,211 @@
+//! Finite signed quantities in the presentation body's local frame.
+
+use crate::animation::sample_values::AnimationValueResult;
+use adventuresim_building_generator::spatial_geometry::Radians;
+use adventuresim_tactical_core::animation::{
+    AngularMagnitudeDegrees, AnimationQuantity, AnimationValueError, InertialLeanGain, UnitInterval,
+};
+use bevy::prelude::*;
+
+#[derive(Clone, Copy, Default, derive_more::Debug)]
+#[debug("BodyAngle({:?})", self.0.radians())]
+/// Signed pitch/roll deflection in the presentation body's local response frame.
+pub(crate) struct BodyAngle(Radians);
+
+#[derive(Debug, Clone, Copy, Default)]
+pub(super) struct BodyAngularVelocity(Vec2);
+
+#[derive(Debug, Clone, Copy, Default)]
+pub(super) struct BodyLocalVelocity(Vec3);
+
+#[derive(Debug, Clone, Copy, Default)]
+pub(super) struct BodyLocalAcceleration(Vec3);
+
+#[derive(Debug, Clone, Copy, Default)]
+pub(super) struct BodyResponseAngles {
+    pub(super) pitch: BodyAngle,
+    pub(super) roll: BodyAngle,
+}
+
+pub(super) struct BodyResponseStep {
+    pub(super) angles: BodyResponseAngles,
+    pub(super) angular_velocity: BodyAngularVelocity,
+}
+
+/// Fraction of the braking-induced lean, independent of additive pose weight.
+#[derive(Clone, Copy, derive_more::Debug, PartialEq)]
+#[debug("BrakingLeanScale({:?})", self.0.fraction())]
+pub(super) struct BrakingLeanScale(UnitInterval);
+
+/// Finite nonnegative angular cap; unlike signed body deflection, it is a magnitude.
+pub(super) struct BodyAngularMagnitude(Radians);
+
+impl BodyAngle {
+    pub(crate) const ZERO: Self = Self(Radians::ZERO);
+    pub(crate) fn from_radians(value: f32) -> AnimationValueResult<Self> {
+        Radians::new(value)
+            .map(Self)
+            .map_err(|_| AnimationValueError::NonFinite {
+                quantity: AnimationQuantity::BodyAngle,
+            })
+    }
+    /// Preserve ratio-before-angle multiplication at the body-target numerical kernel.
+    pub(super) fn from_authored_scale(
+        scale: f32,
+        angle: AngularMagnitudeDegrees,
+    ) -> AnimationValueResult<Self> {
+        Self::from_radians(scale * angle.radians())
+    }
+    pub(super) fn clamped_symmetric(
+        self,
+        maximum: AngularMagnitudeDegrees,
+    ) -> AnimationValueResult<Self> {
+        Self::from_radians(self.radians().clamp(-maximum.radians(), maximum.radians()))
+    }
+    pub(super) fn clamped_positive(
+        self,
+        maximum: AngularMagnitudeDegrees,
+    ) -> AnimationValueResult<Self> {
+        Self::from_radians(self.radians().clamp(0.0, maximum.radians()))
+    }
+    pub(super) fn clamped_negative(
+        self,
+        maximum: AngularMagnitudeDegrees,
+    ) -> AnimationValueResult<Self> {
+        Self::from_radians(self.radians().clamp(-maximum.radians(), 0.0))
+    }
+    pub(super) fn scaled_inertial(self, gain: InertialLeanGain) -> AnimationValueResult<Self> {
+        Self::from_radians(self.radians() * gain.gain())
+    }
+    pub(super) fn scaled_braking(self, scale: BrakingLeanScale) -> AnimationValueResult<Self> {
+        Self::from_radians(self.radians() * scale.fraction())
+    }
+    pub(crate) fn radians(self) -> f32 {
+        self.0.radians()
+    }
+}
+impl BodyAngularVelocity {
+    pub(super) const ZERO: Self = Self(Vec2::ZERO);
+    pub(super) fn from_radians_per_second(value: Vec2) -> AnimationValueResult<Self> {
+        if !value.is_finite() {
+            return Err(AnimationValueError::NonFinite {
+                quantity: AnimationQuantity::BodyAngularVelocity,
+            });
+        }
+        Ok(Self(value))
+    }
+    pub(super) fn radians_per_second(self) -> Vec2 {
+        self.0
+    }
+}
+impl BodyLocalVelocity {
+    pub(super) fn from_metres_per_second(value: Vec3) -> AnimationValueResult<Self> {
+        if !value.is_finite() {
+            return Err(AnimationValueError::NonFinite {
+                quantity: AnimationQuantity::BodyLocalVelocity,
+            });
+        }
+        Ok(Self(value))
+    }
+    /// Checked planar speed squared for the body-response numerical kernels.
+    pub(super) fn planar_squared(self) -> AnimationValueResult<f32> {
+        let squared = self.0.xz().length_squared();
+        if !squared.is_finite() {
+            return Err(AnimationValueError::Overflow {
+                quantity: AnimationQuantity::BodyLocalVelocity,
+            });
+        }
+        Ok(squared)
+    }
+    pub(super) fn metres_per_second(self) -> Vec3 {
+        self.0
+    }
+}
+impl BodyLocalAcceleration {
+    pub(super) const ZERO: Self = Self(Vec3::ZERO);
+    pub(super) fn from_metres_per_second_squared(value: Vec3) -> AnimationValueResult<Self> {
+        if !value.is_finite() {
+            return Err(AnimationValueError::NonFinite {
+                quantity: AnimationQuantity::BodyLocalAcceleration,
+            });
+        }
+        Ok(Self(value))
+    }
+    /// Checked planar acceleration squared; finite components alone cannot prove this.
+    pub(super) fn planar_squared(self) -> AnimationValueResult<f32> {
+        let squared = self.0.xz().length_squared();
+        if !squared.is_finite() {
+            return Err(AnimationValueError::Overflow {
+                quantity: AnimationQuantity::BodyLocalAcceleration,
+            });
+        }
+        Ok(squared)
+    }
+    pub(super) fn metres_per_second_squared(self) -> Vec3 {
+        self.0
+    }
+}
+impl BodyResponseAngles {
+    /// Sum native radian components and cap their resultant before publishing a new target.
+    pub(super) fn checked_sum_capped(
+        self,
+        other: Self,
+        maximum: BodyAngularMagnitude,
+    ) -> AnimationValueResult<Self> {
+        let response = self.radians() + other.radians();
+        if !response.length_squared().is_finite() {
+            return Err(AnimationValueError::Overflow {
+                quantity: AnimationQuantity::BodyAngle,
+            });
+        }
+        let maximum = maximum.radians();
+        let response = if response.length_squared() > maximum * maximum {
+            response.normalize_or_zero() * maximum
+        } else {
+            response
+        };
+        Self::from_radians(response)
+    }
+
+    /// Pitch/roll radians at the native two-axis response kernel boundary.
+    pub(super) fn from_radians(value: Vec2) -> AnimationValueResult<Self> {
+        Ok(Self {
+            pitch: BodyAngle::from_radians(value.x)?,
+            roll: BodyAngle::from_radians(value.y)?,
+        })
+    }
+    pub(super) fn radians(self) -> Vec2 {
+        Vec2::new(self.pitch.radians(), self.roll.radians())
+    }
+}
+
+impl BodyAngularMagnitude {
+    pub(crate) fn from_radians(value: f32) -> AnimationValueResult<Self> {
+        let radians = Radians::new(value).map_err(|_| AnimationValueError::NonFinite {
+            quantity: AnimationQuantity::BodyAngle,
+        })?;
+        if value < 0.0 {
+            return Err(AnimationValueError::Negative {
+                quantity: AnimationQuantity::BodyAngle,
+            });
+        }
+        Ok(Self(radians))
+    }
+    pub(super) fn radians(self) -> f32 {
+        self.0.radians()
+    }
+}
+
+impl BrakingLeanScale {
+    pub(super) const FULL: Self = Self(UnitInterval::ONE);
+    pub(super) fn from_fraction(value: f32) -> AnimationValueResult<Self> {
+        UnitInterval::from_fraction(value)
+            .map(Self)
+            .map_err(|error| {
+                AnimationValueError::from(error).for_quantity(AnimationQuantity::BrakingLeanScale)
+            })
+    }
+    pub(super) fn fraction(self) -> f32 {
+        self.0.fraction()
+    }
+}
