+                > start.y + 0.09
+        );
+        assert!(
+            settle_swing_target(start, landing, SettleProgress::from_progress(0.75).unwrap())
+                .unwrap()
+                .z
+                < start.z
+        );
+        assert!(
+            settle_swing_target(start, landing, SettleProgress::from_progress(1.0).unwrap())
+                .unwrap()
+                .abs_diff_eq(landing, 0.0001)
+        );
+    }
+}
