+)]
+#[serde(transparent)]
+#[debug("{_0:?}")]
+#[as_ref(str)]
+#[from(String)]
+pub struct SkeletonFamily(Cow<'static, str>);
+
+impl SkeletonFamily {
+    pub const HUMANOID: Self = Self(Cow::Borrowed("humanoid"));
+}
