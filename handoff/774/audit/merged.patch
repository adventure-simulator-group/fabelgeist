-fn largest_visible_vista_tree(
-    trees: &Query<
-        (
-            &GlobalTransform,
-            &TreeImpostorProvenance,
-            &VisibilityRange,
-            Has<Collider>,
-        ),
-        (
-            With<VistaTreePresentation>,
-            Without<SceneObstacle>,
