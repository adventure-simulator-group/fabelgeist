+            .get(&BoneRole::FootRight)
+            .and_then(|foot| globals.get(*foot).ok())
+            .map(GlobalTransform::rotation);
+        if [
+            left_last_rendered_world,
+            right_last_rendered_world,
+            left_last_rendered_toe_world,
+            right_last_rendered_toe_world,
