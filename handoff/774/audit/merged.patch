+            (Vec3::NEG_X, camera * Vec3::X),
+        ] {
+            assert!((root * authored_axis).abs_diff_eq(travel, 0.000_01));
+        }
+    }
+
+    #[test]
+    fn downed_camera_alignment_turns_slowly_and_stops_at_the_observed_step() {
+        let first = advance_downed_body_facing(
+            Quat::IDENTITY,
+            Quat::IDENTITY,
+            AnimationElapsed::from_seconds(0.5).unwrap(),
+        )
+        .unwrap();
+        assert!((Quat::IDENTITY.angle_between(first) - std::f32::consts::FRAC_PI_4).abs() < 0.0001);
+        let unchanged_without_another_step = first;
+        assert_eq!(first, unchanged_without_another_step);
+    }
+
+    #[test]
+    fn guard_faces_look_while_locomotion_faces_world_velocity() {
+        let look = Quat::from_rotation_y(0.8);
+        let guard = advance_body_facing(
+            Quat::IDENTITY,
+            look,
+            Vec3::X,
+            SkeletonAction::Block,
+            WeaponGuardState::Lowered,
+            AnimationElapsed::from_seconds(1.0).unwrap(),
+        )
+        .unwrap();
+        assert!((guard * Vec3::Z).abs_diff_eq(look * Vec3::NEG_Z, 0.0001));
+        let travel = advance_body_facing(
+            Quat::IDENTITY,
+            look,
+            Vec3::X,
+            SkeletonAction::None,
+            WeaponGuardState::Lowered,
+            AnimationElapsed::from_seconds(1.0).unwrap(),
+        )
+        .unwrap();
+        assert!((travel * Vec3::Z).abs_diff_eq(Vec3::X, 0.0001));
+        let raised = advance_body_facing(
+            Quat::IDENTITY,
+            look,
+            Vec3::X,
+            SkeletonAction::None,
+            WeaponGuardState::Raised,
+            AnimationElapsed::from_seconds(1.0).unwrap(),
+        )
+        .unwrap();
+        assert!((raised * Vec3::Z).abs_diff_eq(look * Vec3::NEG_Z, 0.0001));
+    }
+
+    #[test]
+    fn local_aim_facing_advances_on_every_render_frame() {
+        let camera = Quat::from_rotation_y(std::f32::consts::FRAC_PI_2);
+        let target = advance_body_facing(
+            Quat::IDENTITY,
+            camera,
+            Vec3::ZERO,
+            SkeletonAction::None,
+            WeaponGuardState::Raised,
+            AnimationElapsed::from_seconds(1.0).unwrap(),
+        )
+        .unwrap();
+        let mut facing = Quat::IDENTITY;
+        let mut previous_distance = facing.angle_between(target);
+
+        for _ in 0..4 {
+            facing = advance_body_facing(
+                facing,
+                camera,
+                Vec3::ZERO,
+                SkeletonAction::None,
+                WeaponGuardState::Raised,
+                AnimationElapsed::from_seconds(1.0 / 60.0).unwrap(),
+            )
+            .unwrap();
+            let distance = facing.angle_between(target);
+            assert!(distance < previous_distance);
+            previous_distance = distance;
+        }
+
+        assert!(previous_distance > 0.0);
+    }
+
+    #[test]
+    fn local_travel_facing_advances_toward_world_velocity() {
+        let velocity = Vec3::X * 3.0;
+        let target = advance_body_facing(
+            Quat::IDENTITY,
+            Quat::IDENTITY,
+            velocity,
+            SkeletonAction::None,
+            WeaponGuardState::Lowered,
+            AnimationElapsed::from_seconds(1.0).unwrap(),
+        )
+        .unwrap();
+        let next = advance_body_facing(
+            Quat::IDENTITY,
+            Quat::IDENTITY,
+            velocity,
+            SkeletonAction::None,
+            WeaponGuardState::Lowered,
+            AnimationElapsed::from_seconds(1.0 / 60.0).unwrap(),
+        )
+        .unwrap();
+
+        assert!(next.angle_between(target) < Quat::IDENTITY.angle_between(target));
+        assert!(next.angle_between(target) > 0.0);
+    }
+
+    #[test]
+    fn attack_facing_reaches_the_target_at_canonical_contact_without_snapping() {
+        let desired = Vec3::X;
+        let delta_seconds = 0.05;
+        let contact_seconds = 0.5;
+        let mut rotation = Quat::IDENTITY;
+
+        for step in 0..10 {
+            let remaining = contact_seconds - step as f32 * delta_seconds;
+            let turn = BodyFacingTurn::for_deadline(
+                rotation,
+                desired,
+                AnimationElapsed::from_seconds(remaining).unwrap(),
+                AnimationElapsed::from_seconds(delta_seconds).unwrap(),
+            )
+            .unwrap();
+            let next = turn
+                .advance(
+                    rotation,
+                    desired,
+                    AnimationElapsed::from_seconds(delta_seconds).unwrap(),
+                )
+                .unwrap();
+            if step == 0 {
+                assert!(next.angle_between(rotation) < std::f32::consts::FRAC_PI_2);
+            }
+            rotation = next;
+        }
+
+        assert!((rotation * Vec3::Z).angle_between(desired) < 1.0e-5);
+    }
 }
