+//! Ordering, uniqueness and scenario counts of captured presentation events.
+
+use super::{FrameSample, LocomotionPresentationPayload, PresentationEventSample, ScenarioId};
+
+pub(super) fn presentation_events_valid(
+    frames: &[FrameSample],
+    presentation_events: &[PresentationEventSample],
+) -> bool {
+    presentation_events
+        .iter()
+        .zip(presentation_events.iter().skip(1))
+        .all(|(previous, current)| {
+            previous.scenario != current.scenario
+                || !previous.payload.same_stream(current.payload)
+                || current.advances_from(previous)
+        })
+        && presentation_events
+            .iter()
+            .enumerate()
+            .all(|(index, event)| {
+                !presentation_events.iter().take(index).any(|previous| {
+                    previous.owner == event.owner
+                        && previous.scenario == event.scenario
+                        && previous.payload == event.payload
+                })
+            })
+        && (!frames
+            .iter()
+            .any(|frame| frame.scenario.is(ScenarioId::CadenceContact))
+            || presentation_events
