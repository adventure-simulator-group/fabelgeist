+
 impl BoundaryBatches {
+    pub fn insert_boundary(
+        &mut self,
+        boundary: &SceneBoundary,
+        placement: BoundaryPlacement,
+        materials: &TacticalBuildingMaterials,
+    ) -> BoundaryBatchResult<()> {
