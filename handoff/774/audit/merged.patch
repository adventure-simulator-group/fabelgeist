+//! Native combat seconds and the client prediction sample clock.
+
+use super::*;
+use adventuresim_core::linear_speed::NonnegativeSpeed;
+use adventuresim_tactical_core::animation::{
+    AnimationElapsed, AnimationValueResult, PositiveAnimationDuration,
+};
+
+/// Timing available only to melee surface-range acquisition. Ranged targeting
+/// has no movement-assisted timing input.
+#[derive(Clone, Copy)]
+pub(super) struct MeleeAcquisitionTiming {
+    forward_speed: NonnegativeSpeed,
+    acceleration: ForwardLungeAcceleration,
+    quickstep_duration: PositiveAnimationDuration,
+}
+
+#[derive(Clone, Copy)]
+pub(super) struct MeleePlaybackTiming {
+    pub(super) start: AnimationSampleTick,
+    pub(super) contact: AnimationSampleTick,
+    pub(super) end: AnimationSampleTick,
+    /// Native seconds consumed by the predicted AttackState timers.
+    pub(super) contact_from_input_seconds: AnimationElapsed,
+}
+
+impl TryFrom<&adventuresim_tactical_core::combat_config::TacticalMovementConfig>
+    for MeleeAcquisitionTiming
+{
+    type Error = adventuresim_tactical_core::animation::AnimationValueError;
+
+    fn try_from(
+        movement: &adventuresim_tactical_core::combat_config::TacticalMovementConfig,
+    ) -> AnimationValueResult<Self> {
+        Ok(Self {
+            forward_speed: movement.speeds_metres_per_second.run,
+            acceleration: conservative_forward_lunge_acceleration(&movement.motor)?,
+            quickstep_duration: movement.maneuvers.quickstep_duration_seconds,
+        })
+    }
+}
+
+impl MeleeAcquisitionTiming {
+    /// A reachable melee surface target owns its movement-assisted delay.
+    pub(super) fn contact_arrival(
+        self,
+        surface_measure: f32,
+        reach: f32,
+        maximum_travel: f32,
+    ) -> AnimationValueResult<Option<MeleeLungeArrival>> {
+        let closure = (surface_measure - reach).max(0.0);
+        if closure > maximum_travel + 1.0e-5 {
+            return Ok(None);
+        }
+        let arrival = melee_lunge_arrival(
+            melee_lunge(surface_measure, reach, 0.0, maximum_travel),
+            self.forward_speed,
+            self.acceleration,
+            self.quickstep_duration,
+        )?;
+        Ok(match arrival {
+            MeleeLungeArrival::CannotArrive => None,
+            admitted => Some(admitted),
+        })
+    }
+}
+
+impl MeleePlaybackTiming {
+    pub(super) fn delayed(
+        skeleton: &SkeletonState,
+        spec: &AttackSpec,
+        input: AnimationSampleTick,
+        delay: AnimationElapsed,
+        contact_seconds: AnimationElapsed,
+        recovery: AnimationElapsed,
+    ) -> AnimationValueResult<Self> {
+        let sequence_start = if spec.continuation {
+            skeleton.attack_continuation_tick().unwrap_or(input)
+        } else {
+            input
+        };
+        let start = sequence_start.saturating_add(delay_ticks(delay)?);
+        let contact = sequence_start.saturating_add(animation_ticks(contact_seconds)?);
+        let end =
+            sequence_start.saturating_add(animation_ticks(contact_seconds.checked_add(recovery)?)?);
+        let contact_from_input_seconds =
+            melee_contact_delay_from_input(skeleton, spec.continuation, contact, contact_seconds)?;
+        Ok(Self {
+            start,
+            contact,
+            end,
+            contact_from_input_seconds,
+        })
+    }
+}
+pub(super) fn on_attack_fired_hook(
+    event: On<Fire<Attack>>,
+    mut cmd: Commands,
+    mut q_character: Query<(Has<AttackState>, &mut SkeletonState)>,
+    viewer: TacticalPlayerViewer,
+    time: Res<Time>,
+    combat_config: Res<TacticalCombatConfig>,
+    targeting: CombatTargeting,
+) {
+    if let Err(error) = try_start_attack(
+        AttackStartRequest {
+            entity: event.context,
+            alternate_attack: false,
+            hand: AttackHand::Main,
+        },
+        &mut cmd,
+        &mut q_character,
+        &viewer,
+        &time,
+        &combat_config,
+        &targeting,
+    ) {
+        warn!(%error, "cannot schedule attack");
+    }
+}
+
+pub(super) fn animation_ticks(
+    seconds: AnimationElapsed,
+) -> AnimationValueResult<AnimationSampleSpan> {
+    let samples = seconds
+        .seconds()
+        .max(locomotion_sample_rate().interval().seconds())
+        * locomotion_sample_rate().hertz();
+    rounded_samples(samples)
+}
+
+pub(super) fn delay_ticks(seconds: AnimationElapsed) -> AnimationValueResult<AnimationSampleSpan> {
+    rounded_samples(seconds.seconds().max(0.0) * locomotion_sample_rate().hertz())
+}
+
+fn rounded_samples(samples: f32) -> AnimationValueResult<AnimationSampleSpan> {
+    if !samples.is_finite() {
+        return Err(
+            adventuresim_tactical_core::animation::AnimationValueError::Overflow {
+                quantity: adventuresim_tactical_core::animation::AnimationQuantity::Elapsed,
+            },
+        );
+    }
+    // Finite values retain Rust's saturating integer conversion at this native
+    // sample-count boundary; overflow of the seconds product is not a deadline.
+    Ok(AnimationSampleSpan::from(samples.round() as u64))
+}
+
+pub(super) fn melee_contact_delay_from_input(
+    skeleton: &SkeletonState,
+    continuation: bool,
+    contact_tick: AnimationSampleTick,
+    ordinary_contact_seconds: AnimationElapsed,
+) -> AnimationValueResult<AnimationElapsed> {
+    if continuation {
+        Ok(AnimationElapsed::from_seconds(
+            contact_tick
+                .saturating_sub(skeleton.locomotion_sample_tick)
+                .samples() as f32
+                / locomotion_sample_rate().hertz(),
+        )?)
+    } else {
+        Ok(ordinary_contact_seconds)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::melee_contact_delay_from_input;
+    use adventuresim_tactical_core::animation::{AnimationSampleTick, SkeletonState};
+
+    #[test]
+    fn continuation_cooldown_uses_the_replicated_animation_clock() {
+        let skeleton = SkeletonState::default().with_locomotion_sample_tick(
+            adventuresim_tactical_core::animation::AnimationSampleTick::from(700u64),
+        );
+
+        assert_eq!(
+            melee_contact_delay_from_input(
+                &skeleton,
+                true,
+                AnimationSampleTick::from(732u64),
+                adventuresim_core::elapsed::AnimationElapsed::from_seconds(0.3).unwrap()
+            )
+            .unwrap()
+            .seconds(),
+            0.5
+        );
+        assert_eq!(
+            melee_contact_delay_from_input(
+                &skeleton,
+                false,
+                AnimationSampleTick::from(732u64),
+                adventuresim_core::elapsed::AnimationElapsed::from_seconds(0.3).unwrap()
+            )
+            .unwrap()
+            .seconds(),
+            0.3
+        );
+    }
+}
diff --git a/crates/adventuresim-tactical-client/src/player/attack_start.rs b/crates/adventuresim-tactical-client/src/player/attack_start.rs
new file mode 100644
index 000000000..5c8385e48
--- /dev/null
+++ b/crates/adventuresim-tactical-client/src/player/attack_start.rs
@@ -0,0 +1,453 @@
+//! Predicted attack admission, buffering and publication.
+
+use super::*;
+
+struct AttackWeaponFacts {
+    reach: f32,
+    ranged: bool,
+    melee: bool,
+    windup: adventuresim_core::elapsed::ElapsedResult<AnimationElapsed>,
+    recovery: adventuresim_core::elapsed::ElapsedResult<AnimationElapsed>,
+    curve: adventuresim_tactical_core::animation::AttackCurve,
+    preferred_style: MeleeAttackStyle,
+}
+
+struct SelectedMeleeAttack {
+    entity: Entity,
+    hand: AttackHand,
+    family: StrikeFamily,
+    spec: AttackSpec,
+    start: AnimationSampleTick,
+    reach: f32,
+}
+
+struct PreparedMeleeAttack {
+    spec: AttackSpec,
+    timing: MeleePlaybackTiming,
+    attack_state: AttackState,
+    target: Option<AttackTarget>,
+}
+
+struct PredictedRangedAttack {
+    entity: Entity,
+    reach: f32,
+    windup: AnimationElapsed,
+    recovery: AnimationElapsed,
+    curve: adventuresim_tactical_core::animation::AttackCurve,
+    start: AnimationSampleTick,
+}
+
+struct ImmediateMeleeAttack {
+    entity: Entity,
+    hand: AttackHand,
+    alternate_attack: bool,
+    attacking: bool,
+    reach: f32,
+    preferred_style: MeleeAttackStyle,
+    start: AnimationSampleTick,
+}
+
+impl AttackWeaponFacts {
+    fn observe(
+        viewer: &TacticalPlayerViewer,
+        entity: Entity,
+        hand: AttackHand,
+        config: &TacticalCombatConfig,
+    ) -> Option<Self> {
+        viewer
+            .get_for_attack(entity, hand)
+            .ok()
+            .map(|character| Self {
+                reach: character.weapon_reach(),
+                ranged: hand == AttackHand::Main && character.weapon_is_ranged(),
+                melee: character.weapon_is_melee(),
+                windup: character.weapon_ranged_windup_secs(),
+                recovery: attack_recovery_secs(
+                    &character,
+                    character.weapon_preferred_melee_style(),
+                    false,
+                ),
+                curve: configure_attack_curve(
+                    AttackSpec::default(),
+                    &character,
+                    &config.presentation.attack_curve,
+                )
+                .curve,
+                preferred_style: character.weapon_preferred_melee_style(),
+            })
+    }
+}
+
+impl PreparedMeleeAttack {
+    fn admit(
+        request: SelectedMeleeAttack,
+        skeleton: &SkeletonState,
+        viewer: &TacticalPlayerViewer,
+        targeting: &CombatTargeting,
+        config: &TacticalCombatConfig,
+    ) -> AnimationValueResult<Option<Self>> {
+        let Ok(character) = viewer.get_for_attack(request.entity, request.hand) else {
+            return Ok(None);
+        };
+        let style = request.family.melee_style();
+        let windup = attack_preparation_secs(&character, style)?;
+        let recovery = attack_recovery_secs(&character, style, request.spec.continuation)?;
+        let spec = AttackSpec {
+            curve: configure_attack_curve(
+                AttackSpec::default(),
+                &character,
+                &config.presentation.attack_curve,
+            )
+            .curve,
+            ..request.spec
+        };
+        Self::prepare(
+            SelectedMeleeAttack { spec, ..request },
+            skeleton,
+            targeting,
+            config,
+            windup,
+            recovery,
+        )
+        .map(Some)
+    }
+
+    fn prepare(
+        request: SelectedMeleeAttack,
+        skeleton: &SkeletonState,
+        targeting: &CombatTargeting,
+        config: &TacticalCombatConfig,
+        windup: AnimationElapsed,
+        recovery: AnimationElapsed,
+    ) -> AnimationValueResult<Self> {
+        let range = targeting.melee_acquisition_range(request.entity, request.reach, config);
+        let (target, position, direction) = targeting.acquire(
+            request.entity,
+            range,
+            Some(MeleeAcquisitionTiming::try_from(&config.movement)?),
+        )?;
+        let arrival = target.map_or(MeleeLungeArrival::NotNeeded, |target| target.arrival);
+        let contact = arrival.contact_timing(windup)?;
+        let timing = MeleePlaybackTiming::delayed(
+            skeleton,
+            &request.spec,
+            request.start,
+            contact.delay,
+            contact.contact,
+            recovery,
+        )?;
+        let attack_state = AttackState::new(
+            timing.contact_from_input_seconds,
+            timing.contact_from_input_seconds,
+            request.reach,
+            false,
+            target,
+            position,
+            direction,
+        )?;
+        Ok(Self {
+            spec: request.spec,
+            timing,
+            attack_state,
+            target,
+        })
+    }
+}
+
+impl PredictedRangedAttack {
+    fn start(
+        self,
+        cmd: &mut Commands,
+        skeleton: &mut SkeletonState,
+        targeting: &CombatTargeting,
+    ) -> AnimationValueResult<()> {
+        let Self {
+            entity,
+            reach,
+            windup,
+            recovery,
+            curve,
+            start,
+        } = self;
+        let spec = AttackSpec { curve, ..default() };
+        let (target, position, direction) = targeting.acquire(entity, (reach, 0.0), None)?;
+        let attack_state =
+            AttackState::new(windup, windup, reach, true, target, position, direction)?;
+        let contact = start.saturating_add(animation_ticks(windup)?);
+        let end = start.saturating_add(animation_ticks(windup.checked_add(recovery)?)?);
+        if skeleton
+            .begin_attack_timed(spec, start, contact, end)
+            .is_err()
+        {
+            return Ok(());
+        }
+        cmd.entity(entity).insert(attack_state);
+        cmd.client_trigger(RangedActionRequest::Start {
+            target: target.map(|target| target.body),
+        });
+        Ok(())
+    }
+}
+
+impl ImmediateMeleeAttack {
+    fn start(
+        self,
+        cmd: &mut Commands,
+        skeleton: &mut SkeletonState,
+        viewer: &TacticalPlayerViewer,
+        targeting: &CombatTargeting,
+        combat_config: &TacticalCombatConfig,
+    ) -> AnimationValueResult<()> {
+        let Self {
+            entity,
+            hand,
+            alternate_attack,
+            attacking,
+            reach,
+            preferred_style,
+            start,
+        } = self;
+        let preferred_family = StrikeFamily::from_melee_style(preferred_style);
+        let requested_family = if alternate_attack && hand == AttackHand::Main {
+            preferred_family.alternate()
+        } else {
+            preferred_family
+        };
+        let Some(strike_family) = skeleton.available_strike_family(requested_family) else {
+            return Ok(());
+        };
+        let Some(spec) = (!attacking)
+            .then(|| match hand {
+                AttackHand::Main => skeleton.select_main_attack(strike_family),
+                AttackHand::Offhand => skeleton.select_offhand_attack(strike_family),
+            })
+            .flatten()
+        else {
+            cmd.entity(entity).insert(BufferedMeleeAttack {
+                family: strike_family,
+                hand,
+            });
+            return Ok(());
+        };
+        let Some(prepared) = PreparedMeleeAttack::admit(
+            SelectedMeleeAttack {
+                entity,
+                hand,
+                family: strike_family,
+                spec,
+                start,
+                reach,
+            },
+            skeleton,
+            viewer,
+            targeting,
+            combat_config,
+        )?
+        else {
+            return Ok(());
+        };
+        let PreparedMeleeAttack {
+            spec,
+            timing,
+            attack_state,
+            target,
+        } = prepared;
+        match skeleton.begin_attack_timed(spec, timing.start, timing.contact, timing.end) {
+            Ok(()) => {}
+            Err(ActionTransitionError::InvalidAnimationValue(error)) => return Err(error),
+            Err(ActionTransitionError::ActionBusy) => {
+                cmd.entity(entity).insert(BufferedMeleeAttack {
+                    family: strike_family,
+                    hand,
+                });
+                return Ok(());
+            }
+            Err(ActionTransitionError::Downed | ActionTransitionError::PostureTransitionActive) => {
+                return Ok(());
+            }
+        }
+        cmd.entity(entity)
+            .insert(attack_state)
+            .remove::<BufferedMeleeAttack>();
+        cmd.client_trigger(MeleeActionRequest {
+            strike_family,
+            hand,
+            target: target.map(|target| target.body),
+        });
+        Ok(())
+    }
+}
+
+pub(super) fn try_start_attack(
+    request: AttackStartRequest,
+    cmd: &mut Commands,
+    q_character: &mut Query<(Has<AttackState>, &mut SkeletonState)>,
+    viewer: &TacticalPlayerViewer,
+    time: &Time,
+    combat_config: &TacticalCombatConfig,
+    targeting: &CombatTargeting,
+) -> AnimationValueResult<()> {
+    let AttackStartRequest {
+        entity,
+        alternate_attack,
+        hand,
+    } = request;
+    let Ok((attacking, mut skeleton)) = q_character.get_mut(entity) else {
+        return Ok(());
+    };
+    let Some(weapon) = AttackWeaponFacts::observe(viewer, entity, hand, combat_config) else {
+        warn!("Trying to attack, but can't get weapon reach. Not holding any weapons ?");
+        return Ok(());
+    };
+    let AttackWeaponFacts {
+        reach,
+        ranged,
+        melee,
+        windup: windup_secs,
+        recovery: recovery_secs,
+        curve,
+        preferred_style,
+    } = weapon;
+
+    let arm_reach = targeting.arm_reach(entity);
+    if !attack_reach_is_usable(ranged, melee, reach, arm_reach) {
+        warn!("Trying to attack without a usable equipped weapon");
+        return Ok(());
+    }
+    if targeting
+        .combatants
+        .get(entity)
+        .is_ok_and(|(_, state, _, _)| state.is_incapacitated())
+    {
+        return Ok(());
+    }
+    let windup_secs = windup_secs?;
+    let recovery_secs = recovery_secs?;
+    let start = AnimationSampleTick::from(
+        (time.elapsed_secs_f64() * locomotion_sample_rate().hertz() as f64).round() as u64,
+    );
+    if ranged {
+        if attacking {
+            return Ok(());
+        }
+        PredictedRangedAttack {
+            entity,
+            reach,
+            windup: windup_secs,
+            recovery: recovery_secs,
+            curve,
+            start,
+        }
+        .start(cmd, &mut skeleton, targeting)?;
+    } else {
+        ImmediateMeleeAttack {
+            entity,
+            hand,
+            alternate_attack,
+            attacking,
+            reach,
+            preferred_style,
+            start,
+        }
+        .start(cmd, &mut skeleton, viewer, targeting, combat_config)?;
+    }
+    Ok(())
+}
+
+pub(super) fn flush_buffered_melee_attacks(
+    mut cmd: Commands,
+    mut characters: Query<
+        (Entity, &BufferedMeleeAttack, &mut SkeletonState),
+        With<ControlledPlayer>,
+    >,
+    viewer: TacticalPlayerViewer,
+    time: Res<Time>,
+    combat_config: Res<TacticalCombatConfig>,
+    targeting: CombatTargeting,
+) {
+    for (entity, buffered, mut skeleton) in &mut characters {
+        let attempt = (|| -> AnimationValueResult<()> {
+            let Some(spec) = (match buffered.hand {
+                AttackHand::Main => skeleton.select_main_attack(buffered.family),
+                AttackHand::Offhand => skeleton.select_offhand_attack(buffered.family),
+            }) else {
+                return Ok(());
+            };
+            let Ok((reach, melee, windup_secs, recovery_secs, curve)) = viewer
+                .get_for_attack(entity, buffered.hand)
+                .map(|character| {
+                    (
+                        character.weapon_reach(),
+                        character.weapon_is_melee(),
+                        attack_preparation_secs(&character, buffered.family.melee_style()),
+                        attack_recovery_secs(
+                            &character,
+                            buffered.family.melee_style(),
+                            spec.continuation,
+                        ),
+                        configure_attack_curve(
+                            AttackSpec::default(),
+                            &character,
+                            &combat_config.presentation.attack_curve,
+                        )
+                        .curve,
+                    )
+                })
+            else {
+                return Ok(());
+            };
+            if !attack_reach_is_usable(false, melee, reach, targeting.arm_reach(entity)) {
+                return Ok(());
+            }
+            if targeting
+                .combatants
+                .get(entity)
+                .is_ok_and(|(_, state, _, _)| state.is_incapacitated())
+            {
+                return Ok(());
+            }
+            let start = AnimationSampleTick::from(
+                (time.elapsed_secs_f64() * locomotion_sample_rate().hertz() as f64).round() as u64,
+            );
+            let prepared = PreparedMeleeAttack::prepare(
+                SelectedMeleeAttack {
+                    entity,
+                    hand: buffered.hand,
+                    family: buffered.family,
+                    spec: AttackSpec { curve, ..spec },
+                    start,
+                    reach,
+                },
+                &skeleton,
+                &targeting,
+                &combat_config,
+                windup_secs?,
+                recovery_secs?,
+            )?;
+            let PreparedMeleeAttack {
+                spec,
+                timing,
+                attack_state,
+                target,
+            } = prepared;
+            if skeleton
+                .begin_attack_timed(spec, timing.start, timing.contact, timing.end)
+                .is_err()
+            {
+                return Ok(());
+            }
+            cmd.entity(entity)
+                .insert(attack_state)
+                .remove::<BufferedMeleeAttack>();
+            cmd.client_trigger(MeleeActionRequest {
+                strike_family: buffered.family,
+                hand: buffered.hand,
+                target: target.map(|target| target.body),
+            });
+            Ok(())
+        })();
+        if let Err(error) = attempt {
+            warn!(?entity, %error, "cannot schedule buffered melee attack");
+        }
+    }
+}
