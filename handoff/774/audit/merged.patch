@@ -0,0 +1,84 @@
+//! Admit Bevy scene labels once, retaining exact identity and animation roles.
+
+use super::{BoneRole, ClipLayer};
+use bevy::prelude::*;
+use fabelgeist_rig::{RigJointName, RigJointPart};
+
+#[derive(Component, Clone, Debug)]
+pub(crate) struct AuthoredRigJoint {
+    name: RigJointName,
+    body_region: AnimationBodyRegion,
+    role: Option<BoneRole>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum AnimationBodyRegion {
+    Upper,
+    Lower,
+}
+
+impl AuthoredRigJoint {
+    pub(crate) fn name(&self) -> &RigJointName {
+        &self.name
+    }
+    pub(super) fn body_region(&self) -> AnimationBodyRegion {
+        self.body_region
+    }
+    pub(super) fn role(&self) -> Option<BoneRole> {
+        self.role
+    }
+
+    pub(crate) fn new(name: RigJointName) -> Self {
+        let body_region = AnimationBodyRegion::from(&name);
+        let role = BoneRole::from_name(&name);
+        Self {
+            name,
+            body_region,
+            role,
+        }
+    }
+}
+
+impl From<&RigJointName> for AnimationBodyRegion {
+    fn from(name: &RigJointName) -> Self {
+        if [
+            RigJointName::SKELETON,
+            RigJointName::BODY_WORLD,
+            RigJointName::ROOT,
+        ]
+        .iter()
+        .any(|root| name.eq_ignore_ascii_case(root))
+            || [
+                RigJointPart::Upleg,
+                RigJointPart::Lowleg,
+                RigJointPart::Foot,
+                RigJointPart::Talocrural,
+                RigJointPart::Subtalar,
+                RigJointPart::Transversetarsal,
+                RigJointPart::Ball,
+            ]
+            .into_iter()
+            .any(|part| {
+                name.as_ref()
+                    .to_ascii_lowercase()
+                    .contains(&format!("_{part}"))
+            })
+        {
+            Self::Lower
+        } else {
+            Self::Upper
+        }
+    }
+}
+
+impl AnimationBodyRegion {
+    pub(super) fn includes(self, layer: ClipLayer, role: Option<BoneRole>) -> bool {
+        match layer {
+            ClipLayer::Whole => true,
+            ClipLayer::Upper => self == Self::Upper,
+            ClipLayer::Lower | ClipLayer::CombatLower => self == Self::Lower,
+            ClipLayer::CombatUpper => self == Self::Upper || role == Some(BoneRole::Pelvis),
+            ClipLayer::MainHand | ClipLayer::Offhand => false,
+        }
+    }
+}
diff --git a/crates/adventuresim-tactical-client/src/animation/sample_values.rs b/crates/adventuresim-tactical-client/src/animation/sample_values.rs
new file mode 100644
index 000000000..f2bcf4e4e
--- /dev/null
+++ b/crates/adventuresim-tactical-client/src/animation/sample_values.rs
@@ -0,0 +1,91 @@
+//! Checked values carried by resolved plans before numerical sampling.
+
+use adventuresim_tactical_core::animation::{AnimationQuantity, AnimationValueError, CyclePhase};
+
+pub(super) use adventuresim_tactical_core::animation::AnimationValueResult;
+
+/// Existing coalescing resolution for samples from the same clip/layer.
+const SAMPLE_COHERENCE_SECONDS: f32 = 0.0001;
+
+#[derive(
+    Debug, Clone, Copy, PartialEq, serde::Serialize, serde::Deserialize, derive_more::Into,
+)]
+#[serde(try_from = "f32", into = "f32")]
+pub(super) struct ClipDuration(f32);
+
+#[derive(
+    Debug, Clone, Copy, PartialEq, serde::Serialize, serde::Deserialize, derive_more::Into,
+)]
+#[serde(try_from = "f32", into = "f32")]
+pub(super) struct ClipTime(f32);
+
+impl ClipDuration {
+    pub(super) fn from_seconds(seconds: f32) -> AnimationValueResult<Self> {
+        if !seconds.is_finite() {
+            return Err(AnimationValueError::NonFinite {
+                quantity: AnimationQuantity::ClipDuration,
+            });
+        }
+        if seconds < 0.0 {
+            return Err(AnimationValueError::Negative {
+                quantity: AnimationQuantity::ClipDuration,
+            });
+        }
+        Ok(Self(seconds))
+    }
+    pub(super) fn seconds(self) -> f32 {
+        self.0
+    }
+    pub(super) fn at_phase(self, phase: CyclePhase) -> AnimationValueResult<ClipTime> {
+        let seconds = self.seconds() * phase.cycles();
+        if !seconds.is_finite() {
+            return Err(AnimationValueError::Overflow {
+                quantity: AnimationQuantity::ClipTime,
+            });
+        }
+        Ok(ClipTime(seconds))
+    }
+}
+
+impl ClipTime {
+    pub(super) const ZERO: Self = Self(0.0);
+    pub(super) fn from_seconds(seconds: f32) -> AnimationValueResult<Self> {
+        if !seconds.is_finite() {
+            return Err(AnimationValueError::NonFinite {
+                quantity: AnimationQuantity::ClipTime,
+            });
+        }
+        Ok(Self(seconds))
+    }
+    pub(super) fn seconds(self) -> f32 {
+        self.0
+    }
+    pub(super) fn same_sample(self, other: Self) -> bool {
+        (self.0 - other.0).abs() < SAMPLE_COHERENCE_SECONDS
+    }
+}
+
+impl TryFrom<f32> for ClipDuration {
+    type Error = AnimationValueError;
+    fn try_from(value: f32) -> AnimationValueResult<Self> {
+        Self::from_seconds(value)
+    }
+}
+
+impl TryFrom<f32> for ClipTime {
+    type Error = AnimationValueError;
+    fn try_from(value: f32) -> AnimationValueResult<Self> {
+        Self::from_seconds(value)
+    }
+}
+
+/// Admission for the still-primitive noncyclic sampling channels. Their complete
+/// quantity migration is separate; retain the existing finite-value rejection.
+pub(super) fn finite_sample_value(value: f32) -> AnimationValueResult<f32> {
+    if !value.is_finite() {
+        return Err(AnimationValueError::NonFinite {
+            quantity: AnimationQuantity::CyclePhase,
+        });
+    }
+    Ok(value)
+}
