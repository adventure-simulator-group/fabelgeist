+//! Native diagnostic JSON records, after application-state interpretation.
+
+use super::*;
+use adventuresim_tactical_core::{
+    city_layout::grounding::SupportElevation, scene_coordinates::ScenePlanPoint,
+};
+use serde::Serialize;
+
+#[derive(Clone, Copy, Serialize)]
