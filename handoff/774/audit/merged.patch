+                Position::from_metres(
+                    root + Vec3::new(azimuth.sin() * 3.8, 1.3, azimuth.cos() * 3.8),
+                )?,
+                Position::from_metres(root + Vec3::Y * 0.08)?,
+                SpatialDirection::from_normalized(Vec3::Y)?,
+            )
+        },
+    )
+}
