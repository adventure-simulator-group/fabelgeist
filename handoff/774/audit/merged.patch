+pub(super) fn ground(state: &SceneCaptureState) -> CaptureCameraResult<SceneCameraView> {
+    SceneCameraView::looking_at(
+        state.ground_eye_position,
+        state.ground_eye_target,
+        SpatialDirection::from_normalized(Vec3::Y)?,
+    )
