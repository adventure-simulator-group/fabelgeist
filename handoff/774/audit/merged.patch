+        0.0,
+        host_mul(host_add(low(2u), high(2u)), 0.5),
+    );
+    // The centre placed along the frame's axes, as `PartFrame::point` places it.
+    var placed: vec3<f32>;
+    let start = origin();
+    for (var c = 0u; c < 3u; c = c + 1u) {
+        let along = host_add(
+            host_add(host_mul(axis(0u)[c], center.x), host_mul(axis(1u)[c], center.y)),
