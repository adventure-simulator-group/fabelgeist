[Unit]
Description=Fabelgeist SpacetimeDB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{SERVICE_USER}}
WorkingDirectory={{DEPLOY_ROOT}}
ExecStart=/usr/local/bin/spacetimedb-standalone start --listen-addr 127.0.0.1:3000 --data-dir {{DEPLOY_ROOT}}/stdb --non-interactive
Restart=always
RestartSec=2
Environment=RUST_LOG=info
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
