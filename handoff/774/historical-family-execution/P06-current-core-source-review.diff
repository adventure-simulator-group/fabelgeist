+        self.mean_scheduled_contact_measure_metres = self
+            .mean_scheduled_contact_measure_metres
+            .mean(self.contact_measure_samples)?;
+        self.mean_actual_contact_measure_metres = self
+            .mean_actual_contact_measure_metres
+            .mean(self.contact_measure_samples)?;
+        Ok(())
+    }
+}
