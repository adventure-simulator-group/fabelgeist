+pub(super) fn sampled_vista_lod_meshes_with_morph(
+    lod: &VistaLod,
+    inner_half_extent: Vec2,
+    coarser_lod: Option<&VistaLod>,
+    playable_terrain: Option<&SceneTerrain>,
+    playable_environment: Option<&SceneEnvironment>,
