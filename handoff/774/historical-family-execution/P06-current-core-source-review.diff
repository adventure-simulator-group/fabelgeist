+pub(super) fn validate_source(lod: &VistaLod) -> VistaMeshResult<()> {
+    if !lod.has_height_grid() || lod.environment.len() != lod.heights_metres.len() {
+        return Err(VistaMeshError::InvalidLod { level: lod.level });
+    }
+    Ok(())
+}
