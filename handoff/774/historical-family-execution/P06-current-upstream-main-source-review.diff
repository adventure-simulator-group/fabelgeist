+//! Where on the scalp's texture each point of the scalp lies.
+//!
+//! The hair crate maps its scalp by the angle from the crown, out to past
+//! the nape, onto a disk inside the square texture: a texel near the crown
+//! covers a few times the skin one near the hairline does, a fifth of the
+//! square is the corners outside the disk, and much of the disk lies below
+//! the hairline. The scalp's texture is mapped afresh, fitted to the scalp:
+//!
+//! * by Lambert's equal-area projection about the scalp's middle -- the
+//!   axis of the narrowest cone from the cranium's centre that holds the
+//!   whole scalp, leaning back from straight up, as the scalp reaches lower
+//!   at the nape than at the brow -- out to its edge, so every texel covers
+//!   about as much skin: the crown, where partings and whorls lie, as
+//!   finely as anywhere;
+//! * the disk spread over the whole square by Shirley and Chiu's concentric
+//!   mapping, which keeps areas too, so no texel is wasted on the corners.
+//!
+//! Both are continuous: the texture has no seam.
+
+use std::f32::consts::{FRAC_PI_2, FRAC_PI_4, PI, TAU};
+
+use fabelgeist_hair::{Head, Surface};
+use fabelgeist_math::Vec3;
+
+/// How far past the scalp's edge the map reaches, radians from its axis:
+/// so the scalp's edge lies inside the texture, not on its rim.
+const RIM_MARGIN: f32 = 0.02;
+/// Steps taken leaning the axis towards the scalp's furthest point, each a
+/// smaller share of the way: the narrowest cone holding the scalp, near
+/// enough.
+const AXIS_STEPS: usize = 64;
+
+/// The scalp's texture map, fitted to one bust's scalp.
+#[derive(Clone, Copy, Debug)]
+pub(super) struct ScalpMap {
+    /// The point the map is projected about: the cranium's centre.
+    pub(crate) center: Vec3,
+    /// The map's axis, and the directions square to it the texture's sides
+    /// run along: towards the face, and towards the head's side.
+    pub(crate) axis: Vec3,
+    pub(crate) forward: Vec3,
+    pub(crate) side: Vec3,
+    /// The sine of half the angle from the axis the map reaches.
+    pub(crate) rim: f32,
+    /// About how much skin a texel's side covers, metres, at `size` texels
+    /// a side.
+    texel_per_side: f32,
+}
+
+impl ScalpMap {
+    /// The map for `head`'s `scalp`.
+    pub(super) fn fit(head: &Head, scalp: &Surface) -> Self {
+        let center = head.cranium.center;
+        let directions: Vec<Vec3> = scalp
+            .positions
+            .iter()
+            .filter_map(|&p| unit(p - center))
+            .collect();
+        let up = Vec3::new(0.0, 1.0, 0.0);
+        let mean = directions
+            .iter()
+            .fold(Vec3::new(0.0, 0.0, 0.0), |sum, &d| sum + d);
+        let mut axis = unit(mean).unwrap_or(up);
+        for step in 1..=AXIS_STEPS {
+            let furthest = directions
+                .iter()
+                .copied()
+                .min_by(|a, b| a.dot(axis).total_cmp(&b.dot(axis)));
+            let Some(furthest) = furthest else {
+                break;
+            };
+            axis = unit(axis + (furthest - axis) * (1.0 / (step + 1) as f32)).unwrap_or(axis);
+        }
+        let widest = directions
+            .iter()
+            .map(|d| angle(*d, axis))
+            .fold(0.0f32, f32::max);
+        let face = Vec3::new(0.0, 0.0, 1.0);
+        let forward = unit(face - axis * face.dot(axis)).unwrap_or(face);
+        let side = axis.cross(forward);
+        let radius = scalp
+            .positions
+            .iter()
+            .map(|&p| (p - center).length())
+            .sum::<f32>()
+            / scalp.positions.len().max(1) as f32;
+        let rim = ((widest + RIM_MARGIN).min(PI) * 0.5).sin();
+        // A sphere's cap out to the rim, the area the square spans.
+        let area = 4.0 * PI * radius * radius * rim * rim;
+        Self {
+            center,
+            axis,
+            forward,
+            side,
+            rim,
+            texel_per_side: area.sqrt(),
+        }
+    }
+
+    /// About how much skin a texel's side covers, metres, in a texture
+    /// `size` texels a side.
+    pub(super) fn texel(&self, size: usize) -> f32 {
+        self.texel_per_side / size as f32
+    }
+
+    /// Where `p`, in the bust's frame, lies in the texture, 0 to 1 each way,
+    /// if within the map.
+    pub(super) fn uv(&self, p: Vec3) -> Option<[f32; 2]> {
+        let direction = unit(p - self.center)?;
+        let reach = (angle(direction, self.axis) * 0.5).sin() / self.rim;
+        if reach > 1.0 {
+            return None;
+        }
+        let azimuth = direction.dot(self.side).atan2(direction.dot(self.forward));
+        let [a, b] = square(reach, azimuth);
+        Some([(a + 1.0) * 0.5, (b + 1.0) * 0.5])
+    }
+}
+
+/// `v` at unit length, if it has a direction.
+fn unit(v: Vec3) -> Option<Vec3> {
+    let length = v.length();
+    (length > 0.0 && length.is_finite()).then(|| v * (1.0 / length))
+}
+
+/// The angle between unit directions `a` and `b`, radians.
+fn angle(a: Vec3, b: Vec3) -> f32 {
+    a.dot(b).clamp(-1.0, 1.0).acos()
+}
+
+/// A point of the unit disk, `reach` from its centre at `azimuth` radians,
+/// on the square from -1 to 1 each way: Shirley and Chiu's concentric
+/// mapping, inverted.
+fn square(reach: f32, azimuth: f32) -> [f32; 2] {
+    // Into the quarter-turn the square's first side starts at.
+    let azimuth = (azimuth + FRAC_PI_4).rem_euclid(TAU) - FRAC_PI_4;
+    let along = |from: f32| (azimuth - from) / FRAC_PI_4 * reach;
+    if azimuth < FRAC_PI_4 {
+        [reach, along(0.0)]
+    } else if azimuth < 3.0 * FRAC_PI_4 {
+        [-along(FRAC_PI_2), reach]
+    } else if azimuth < 5.0 * FRAC_PI_4 {
+        [-reach, -along(PI)]
+    } else {
+        [along(3.0 * FRAC_PI_2), -reach]
+    }
+}
--- before/crates/adventuresim-character-creator/src/hair/shape.rs
+++ after/crates/adventuresim-character-creator/src/hair/shape.rs
@@ -0,0 +1,229 @@
+//! How a hairstyle is varied from its preset.
+//!
+//! A preset is the hair crate's whole look: its follicles' growth pattern,
+//! its cut, its arrangement, and how the strands curl, wave, frizz and
+//! clump. A [`HairShape`] changes it -- another cut, arrangement or growth
+//! pattern, and the rest scaled or shifted from the preset's own -- so the
+//! default shape grows the preset as it is.
+
+use fabelgeist_hair::parameters::Draping;
+use fabelgeist_hair::{Arrangement, Cut, Growth, Haircut, Hairstyle, Look, Preset};
+use fabelgeist_math::units::Metres;
+use fabelgeist_math::units::Ratio;
+use serde::{Deserialize, Serialize};
+
+/// The range of each of a shape's values: the length's scale, the volume
+/// and the part's shift, metres, the curl and clumping added, the waves
+/// added, metres, and the frizz's scale.
+pub const LENGTH: std::ops::RangeInclusive<f32> = 0.3..=2.0;
+pub const VOLUME: std::ops::RangeInclusive<f32> = -0.01..=0.04;
+pub const PART: std::ops::RangeInclusive<f32> = -0.06..=0.06;
+pub const CURL: std::ops::RangeInclusive<f32> = -1.0..=1.0;
+pub const WAVE: std::ops::RangeInclusive<f32> = -0.01..=0.02;
+pub const FRIZZ: std::ops::RangeInclusive<f32> = 0.0..=4.0;
+pub const CLUMPING: std::ops::RangeInclusive<f32> = -1.0..=1.0;
+
+/// What hair grows: a preset, varied by a shape.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Groom {
+    pub preset: Preset,
+    pub shape: HairShape,
+}
+
+impl Groom {
+    /// The hair crate's look for this groom.
+    pub(super) fn look(&self) -> Look {
+        let mut look = Look::new(self.preset);
+        self.shape.apply(&mut look);
+        look
+    }
+}
+
+/// How a hairstyle differs from its preset.
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields, try_from = "ShapeValues")]
+pub struct HairShape {
+    /// The cut, the arrangement and the growth pattern, when not the
+    /// preset's own.
+    cut: Option<Cut>,
+    arrangement: Option<Arrangement>,
+    growth: Option<Growth>,
+    /// Every length of the cut scaled, its hemline as far from the crown as
+    /// the hair is long.
+    length: f32,
+    /// How far further the hair stands off the head at the crown, metres.
+    volume: f32,
+    /// How far the part moves towards the character's left, metres.
+    part: f32,
+    /// Added to how much the strands curl, 0 to 1.
+    curl: f32,
+    /// Added to the waves either side, metres.
+    wave: f32,
+    /// The frizz and the flyaways, scaled.
+    frizz: f32,
+    /// Added to how much the strands gather into locks, 0 to 1.
+    clumping: f32,
+}
+
+/// A shape's values, before their ranges are checked.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ShapeValues {
+    cut: Option<Cut>,
+    arrangement: Option<Arrangement>,
+    growth: Option<Growth>,
+    length: f32,
+    volume: f32,
+    part: f32,
+    curl: f32,
+    wave: f32,
+    frizz: f32,
+    clumping: f32,
+}
+
+/// A shape's value outside its range.
+#[derive(Debug, thiserror::Error)]
+#[error("a hair shape's values must lie within their ranges")]
+pub struct ShapeRangeError;
+
+impl TryFrom<ShapeValues> for HairShape {
+    type Error = ShapeRangeError;
+
+    fn try_from(values: ShapeValues) -> Result<Self, Self::Error> {
+        let within = LENGTH.contains(&values.length)
+            && VOLUME.contains(&values.volume)
+            && PART.contains(&values.part)
+            && CURL.contains(&values.curl)
+            && WAVE.contains(&values.wave)
+            && FRIZZ.contains(&values.frizz)
+            && CLUMPING.contains(&values.clumping);
+        if !within {
+            return Err(ShapeRangeError);
+        }
+        Ok(Self {
+            cut: values.cut,
+            arrangement: values.arrangement,
+            growth: values.growth,
+            length: values.length,
+            volume: values.volume,
+            part: values.part,
+            curl: values.curl,
+            wave: values.wave,
+            frizz: values.frizz,
+            clumping: values.clumping,
+        })
+    }
+}
+
+impl Default for HairShape {
+    /// The preset as it is.
+    fn default() -> Self {
+        Self {
+            cut: None,
+            arrangement: None,
+            growth: None,
+            length: 1.0,
+            volume: 0.0,
+            part: 0.0,
+            curl: 0.0,
+            wave: 0.0,
+            frizz: 1.0,
+            clumping: 0.0,
+        }
+    }
+}
+
+/// A shape's sliding values, each clamped into its range when set.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ShapeKnobs {
+    pub length: f32,
+    pub volume: f32,
+    pub part: f32,
+    pub curl: f32,
+    pub wave: f32,
+    pub frizz: f32,
+    pub clumping: f32,
+}
+
+impl HairShape {
+    pub fn cut(&self) -> Option<Cut> {
+        self.cut
+    }
+
+    pub fn arrangement(&self) -> Option<Arrangement> {
+        self.arrangement
+    }
+
+    pub fn growth(&self) -> Option<Growth> {
+        self.growth
+    }
+
+    pub fn with_cut(self, cut: Option<Cut>) -> Self {
+        Self { cut, ..self }
+    }
+
+    pub fn with_arrangement(self, arrangement: Option<Arrangement>) -> Self {
+        Self {
+            arrangement,
+            ..self
+        }
+    }
+
+    pub fn with_growth(self, growth: Option<Growth>) -> Self {
+        Self { growth, ..self }
+    }
+
+    pub fn knobs(&self) -> ShapeKnobs {
+        ShapeKnobs {
+            length: self.length,
+            volume: self.volume,
+            part: self.part,
+            curl: self.curl,
+            wave: self.wave,
+            frizz: self.frizz,
+            clumping: self.clumping,
+        }
+    }
+
+    /// This shape with `knobs`, each clamped into its range.
+    pub fn with_knobs(self, knobs: ShapeKnobs) -> Self {
+        let within = |value: f32, range: std::ops::RangeInclusive<f32>| {
+            value.clamp(*range.start(), *range.end())
+        };
+        Self {
+            length: within(knobs.length, LENGTH),
+            volume: within(knobs.volume, VOLUME),
+            part: within(knobs.part, PART),
+            curl: within(knobs.curl, CURL),
+            wave: within(knobs.wave, WAVE),
+            frizz: within(knobs.frizz, FRIZZ),
+            clumping: within(knobs.clumping, CLUMPING),
+            ..self
+        }
+    }
+
+    /// Change `look`, a preset's, by this shape.
+    fn apply(&self, look: &mut Look) {
+        let hairdo = &mut look.hairdo;
+        if let Some(cut) = self.cut {
+            hairdo.haircut = Haircut::new(cut);
+        }
+        if let Some(arrangement) = self.arrangement {
+            hairdo.hairstyle = Hairstyle::new(arrangement);
+        }
+        if let Some(growth) = self.growth {
+            hairdo.follicles.growth = growth;
+        }
+        hairdo.haircut = hairdo.haircut.scaled(self.length);
+        let style = &mut hairdo.hairstyle;
+        style.volume = (style.volume + self.volume).max(0.0);
+        style.part += self.part;
+        look.curl = Ratio::from_ratio((look.curl.ratio() + self.curl).clamp(0.0, 1.0));
+        look.wave = Metres::from_metres((look.wave.metres() + self.wave).max(0.0));
+        look.frizz = Metres::from_metres(look.frizz.metres() * (self.frizz));
+        look.flyaways = Ratio::from_ratio((look.flyaways.ratio() * self.frizz).min(1.0));
+        look.clump = Ratio::from_ratio((look.clump.ratio() + self.clumping).clamp(0.0, 1.0));
+        // Only some arrangements hang under gravity.
+        look.drape = Draping::from_enabled(look.hairdo.drapes());
+    }
+}
--- before/crates/adventuresim-character-creator/src/hair_color_controls.rs
+++ after/crates/adventuresim-character-creator/src/hair_color_controls.rs
@@ -0,0 +1,196 @@
+//! The hair page's colours: natural colours and dyes to pick at a click,
+//! any dye from a colour picker, and the melanin and redness sliders that
+//! set a natural colour finely.
+//!
+//! A dye tints the strands' own colour, as a real dye does: on dark hair it
+//! barely shows, so each dye swatch also lightens the hair, as bleaching
+//! before dyeing does.
+use super::*;
+use adventuresim_character_creator::hair::{HairDesign, HairPigment, NO_DYE};
+use studio_theme::stat_slider;
+
+/// The hair crate's named natural colours, darkest first.
+const NATURAL: [&str; 8] = [
+    "black",
+    "dark brown",
+    "brown",
+    "auburn",
+    "red",
+    "blond",
+    "platinum",
+    "grey",
+];
+
+/// A dye swatch: its name, the hair it is put on, and the dye.
+struct Dye {
+    name: &'static str,
+    melanin: f32,
+    redness: f32,
+    dye: [f32; 3],
+}
+
+/// Dyes as hair is commonly dyed, on hair bleached light enough to show
+/// them.
+const DYES: [Dye; 10] = [
+    Dye {
+        name: "Crimson",
+        melanin: 0.3,
+        redness: 0.6,
+        dye: [1.0, 0.12, 0.15],
+    },
+    Dye {
+        name: "Copper",
+        melanin: 0.25,
+        redness: 0.6,
+        dye: [1.0, 0.5, 0.2],
+    },
+    Dye {
+        name: "Rose",
+        melanin: 0.12,
+        redness: 0.3,
+        dye: [1.0, 0.35, 0.55],
+    },
+    Dye {
+        name: "Pastel pink",
+        melanin: 0.06,
+        redness: 0.2,
+        dye: [1.0, 0.62, 0.78],
+    },
+    Dye {
+        name: "Lavender",
+        melanin: 0.06,
+        redness: 0.1,
+        dye: [0.75, 0.62, 1.0],
+    },
+    Dye {
+        name: "Violet",
+        melanin: 0.12,
+        redness: 0.1,
+        dye: [0.5, 0.22, 1.0],
+    },
+    Dye {
+        name: "Electric blue",
+        melanin: 0.1,
+        redness: 0.05,
+        dye: [0.12, 0.38, 1.0],
+    },
+    Dye {
+        name: "Teal",
+        melanin: 0.1,
+        redness: 0.05,
+        dye: [0.1, 0.75, 0.7],
+    },
+    Dye {
+        name: "Emerald",
+        melanin: 0.12,
+        redness: 0.05,
+        dye: [0.15, 0.8, 0.3],
+    },
+    Dye {
+        name: "Silver",
+        melanin: 0.04,
+        redness: 0.02,
+        dye: [0.85, 0.9, 1.0],
+    },
+];
+
+/// A swatch's side, its corners' radius, and the outline of the picked
+/// and of the hovered swatch, points.
+const SWATCH: f32 = 22.0;
+const SWATCH_ROUNDING: f32 = 3.0;
+const PICKED_OUTLINE: f32 = 2.0;
+const HOVERED_OUTLINE: f32 = 1.0;
+
+/// Pick the hair's colour.
+pub(super) fn show(ui: &mut egui::Ui, design: &mut HairDesign) {
+    ui.label(egui::RichText::new("Natural").color(studio_theme::PARCHMENT));
+    ui.horizontal_wrapped(|ui| {
+        for name in NATURAL {
+            let Some(pigment) = HairPigment::named(name) else {
+                continue;
+            };
+            if swatch(ui, pigment, design.pigment, &capitalized(name)) {
+                design.pigment = pigment;
+            }
+        }
+    });
+    ui.add_space(4.0);
+    ui.label(egui::RichText::new("Dyed").color(studio_theme::PARCHMENT));
+    ui.horizontal_wrapped(|ui| {
+        for dye in &DYES {
+            let pigment = HairPigment::new(dye.melanin, dye.redness).dyed(dye.dye);
+            if swatch(ui, pigment, design.pigment, dye.name) {
+                design.pigment = pigment;
+            }
+        }
+    });
+    ui.add_space(4.0);
+    ui.horizontal(|ui| {
+        let mut dye = design.pigment.dye();
+        let picked = egui::color_picker::color_edit_button_rgb(ui, &mut dye)
+            .on_hover_text("Any dye: it tints the hair's own colour.")
+            .changed();
+        if picked {
+            design.pigment = design.pigment.dyed(dye);
+        }
+        ui.label(egui::RichText::new("Dye").color(studio_theme::PARCHMENT));
+        let undyed = design.pigment.dye() == NO_DYE;
+        let clear = ui.add_enabled(!undyed, egui::Button::new("No dye").small());
+        if clear.clicked() {
+            design.pigment = design.pigment.dyed(NO_DYE);
+        }
+    });
+    ui.add_space(4.0);
+    sliders(ui, design);
+}
+
+/// The melanin and redness sliders, keeping any dye.
+fn sliders(ui: &mut egui::Ui, design: &mut HairDesign) {
+    let neutral = HairPigment::default();
+    let mut melanin = design.pigment.melanin();
+    let mut redness = design.pigment.redness();
+    let darker = stat_slider(ui, "Melanin", &mut melanin, 0.0..=1.0, neutral.melanin())
+        .on_hover_text("From white through blond and brown to black.")
+        .changed();
+    let redder = stat_slider(ui, "Redness", &mut redness, 0.0..=1.0, neutral.redness())
+        .on_hover_text("From ashen to red.")
+        .changed();
+    if darker || redder {
+        design.pigment = HairPigment::new(melanin, redness).dyed(design.pigment.dye());
+    }
+}
+
+/// A square of `pigment`'s colour, outlined when it is the `current` one;
+/// true when clicked.
+fn swatch(ui: &mut egui::Ui, pigment: HairPigment, current: HairPigment, name: &str) -> bool {
+    let (rect, response) = ui.allocate_exact_size(egui::vec2(SWATCH, SWATCH), egui::Sense::click());
+    let [red, green, blue] = pigment.color();
+    let fill = egui::Color32::from(egui::Rgba::from_rgb(red, green, blue));
+    let painter = ui.painter();
+    painter.rect_filled(rect, SWATCH_ROUNDING, fill);
+    if pigment == current {
+        painter.rect_stroke(
+            rect.expand(PICKED_OUTLINE),
+            SWATCH_ROUNDING + PICKED_OUTLINE,
+            egui::Stroke::new(PICKED_OUTLINE, studio_theme::GOLD),
+            egui::StrokeKind::Outside,
+        );
+    } else if response.hovered() {
+        painter.rect_stroke(
+            rect,
+            SWATCH_ROUNDING,
+            egui::Stroke::new(HOVERED_OUTLINE, studio_theme::PARCHMENT),
+            egui::StrokeKind::Outside,
+        );
+    }
+    response.on_hover_text(name).clicked()
+}
+
+/// `name` with its first letter capitalized, as the interface shows it.
+fn capitalized(name: &str) -> String {
+    let mut letters = name.chars();
+    letters
+        .next()
+        .map(|first| first.to_uppercase().chain(letters).collect())
+        .unwrap_or_default()
+}
--- before/crates/adventuresim-character-creator/src/hair_controls.rs
+++ after/crates/adventuresim-character-creator/src/hair_controls.rs
@@ -0,0 +1,266 @@
+//! The hair page of the character tab: a hairstyle, its colour, how it is
+//! varied from its preset, and the level of detail it is drawn at.
+//!
+//! Hair changes no body, so these controls leave the studio clean: the hair
+//! preview notices the recipe's new hair and grows or recolours it alone.
+//! The level of detail is the studio's, not the recipe's: a game picks it
+//! from how large the head is on screen.
+use super::*;
+use adventuresim_character_creator::hair::{
+    CLUMPING, CURL, FRIZZ, HairDesign, HairPigment, HairShape, LENGTH, PART, VOLUME, WAVE,
+    variant_label,
+};
+use fabelgeist_hair::lod::Form;
+use fabelgeist_hair::{Arrangement, Cut, Growth, Preset};
+use hair_preview::HairPreview;
+use std::ops::RangeInclusive;
+use studio_theme::stat_slider;
+
+/// What the hairstyle menu calls no hair.
+const BALD: &str = "Bald";
+/// What a cut, arrangement or growth menu calls the preset's own.
+const PRESETS_OWN: &str = "Preset's own";
+/// The sliders' units: centimetres and millimetres a metre.
+const CENTIMETRES: f32 = 100.0;
+const MILLIMETRES: f32 = 1000.0;
+/// The share of strands a strand level starts out drawing.
+const START_SHARE: f32 = 0.25;
+/// The fewest of a level's strands the share slider draws.
+const MIN_SHARE: f32 = 0.01;
+
+pub(super) fn show(ui: &mut egui::Ui, studio: &mut Studio, preview: &HairPreview) {
+    let hair = &mut studio.recipe.hair;
+    let selected = hair.map_or_else(|| BALD.to_owned(), |design| variant_label(design.preset));
+    egui::ComboBox::from_label("Hairstyle")
+        .selected_text(selected)
+        .show_ui(ui, |ui| {
+            if ui.selectable_label(hair.is_none(), BALD).clicked() {
+                *hair = None;
+            }
+            for preset in Preset::ALL {
+                let chosen = hair.is_some_and(|design| design.preset == preset);
+                if ui.selectable_label(chosen, variant_label(preset)).clicked() {
+                    // A new hairstyle keeps its colour, and starts as its
+                    // preset has it.
+                    let pigment = hair.map_or_else(HairPigment::default, |design| design.pigment);
+                    *hair = Some(HairDesign {
+                        preset,
+                        shape: HairShape::default(),
+                        pigment,
+                    });
+                }
+            }
+        });
+    let Some(design) = hair else {
+        return;
+    };
+    ui.add_space(6.0);
+    hair_color_controls::show(ui, design);
+    ui.add_space(6.0);
+    shape(ui, design);
+    ui.add_space(6.0);
+    level_of_detail(ui, &mut studio.hair_form, preview);
+    ui.add_space(6.0);
+    layers(ui, &mut studio.hair_layers);
+}
+
+/// Draw the hair and the scalp under it apart, to look at either alone.
+fn layers(ui: &mut egui::Ui, shown: &mut hair_preview::ShownLayers) {
+    ui.horizontal(|ui| {
+        ui.checkbox(&mut shown.hair, "Show hair")
+            .on_hover_text("Hide the strands or cards to see the scalp alone.");
+        ui.checkbox(&mut shown.scalp, "Show scalp")
+            .on_hover_text("Hide the painted scalp to see the hair alone.");
+    });
+}
+
+/// How the hairstyle is varied from its preset: another cut, arrangement or
+/// growth pattern, and its lengths, volume, part, curl, waves, frizz and
+/// clumping. The sliders show centimetres and millimetres where the shape
+/// keeps metres.
+fn shape(ui: &mut egui::Ui, design: &mut HairDesign) {
+    let shape = &mut design.shape;
+    ui.horizontal(|ui| {
+        ui.label(egui::RichText::new("Shape").color(studio_theme::PARCHMENT));
+        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+            let reset = ui
+                .small_button(PRESETS_OWN)
+                .on_hover_text("Grow the hairstyle as its preset has it.");
+            if reset.clicked() {
+                *shape = HairShape::default();
+            }
+        });
+    });
+    let cut = variant(ui, "Cut", shape.cut(), &Cut::ALL);
+    let arrangement = variant(ui, "Arrangement", shape.arrangement(), &Arrangement::ALL);
+    let growth = variant(ui, "Growth", shape.growth(), &Growth::ALL);
+    *shape = shape
+        .with_cut(cut)
+        .with_arrangement(arrangement)
+        .with_growth(growth);
+    let neutral = HairShape::default().knobs();
+    let mut knobs = shape.knobs();
+    let mut changed = false;
+    let mut slide = |label: &str,
+                     hint: &str,
+                     value: &mut f32,
+                     range: RangeInclusive<f32>,
+                     neutral: f32,
+                     unit: f32| {
+        let mut shown = *value * unit;
+        let range = range.start() * unit..=range.end() * unit;
+        if stat_slider(ui, label, &mut shown, range, neutral * unit)
+            .on_hover_text(hint)
+            .changed()
+        {
+            *value = shown / unit;
+            changed = true;
+        }
+    };
+    slide(
+        "Length",
+        "Every length of the cut, as a share of the preset's.",
+        &mut knobs.length,
+        LENGTH,
+        neutral.length,
+        1.0,
+    );
+    slide(
+        "Volume, cm",
+        "How much further the hair stands off the crown.",
+        &mut knobs.volume,
+        VOLUME,
+        neutral.volume,
+        CENTIMETRES,
+    );
+    slide(
+        "Part, cm",
+        "Where the hair parts: towards the character's left or right.",
+        &mut knobs.part,
+        PART,
+        neutral.part,
+        CENTIMETRES,
+    );
+    slide(
+        "Curl",
+        "Added to how much the strands curl, from straight to tight coils.",
+        &mut knobs.curl,
+        CURL,
+        neutral.curl,
+        1.0,
+    );
+    slide(
+        "Waves, mm",
+        "Added to how far the strands wave either side.",
+        &mut knobs.wave,
+        WAVE,
+        neutral.wave,
+        MILLIMETRES,
+    );
+    slide(
+        "Frizz",
+        "How far stray strands wander, and how many fly away, as a share of the preset's.",
+        &mut knobs.frizz,
+        FRIZZ,
+        neutral.frizz,
+        1.0,
+    );
+    slide(
+        "Clumping",
+        "Added to how much the strands gather into locks.",
+        &mut knobs.clumping,
+        CLUMPING,
+        neutral.clumping,
+        1.0,
+    );
+    if changed {
+        *shape = shape.with_knobs(knobs);
+    }
+}
+
+/// A menu of `options`, or the preset's own when none is picked.
+fn variant<T: Copy + PartialEq + std::fmt::Debug>(
+    ui: &mut egui::Ui,
+    label: &str,
+    picked: Option<T>,
+    options: &[T],
+) -> Option<T> {
+    let mut picked = picked;
+    let selected = picked.map_or_else(|| PRESETS_OWN.to_owned(), variant_label);
+    egui::ComboBox::from_label(label)
+        .selected_text(selected)
+        .show_ui(ui, |ui| {
+            if ui.selectable_label(picked.is_none(), PRESETS_OWN).clicked() {
+                picked = None;
+            }
+            for &option in options {
+                let chosen = picked == Some(option);
+                if ui.selectable_label(chosen, variant_label(option)).clicked() {
+                    picked = Some(option);
+                }
+            }
+        });
+    picked
+}
+
+/// Pick a strand level or a cut of cards, and how many of a level's strands
+/// to draw.
+fn level_of_detail(ui: &mut egui::Ui, form: &mut Form, preview: &HairPreview) {
+    let choices = preview.form_choices();
+    if preview.preparing() || choices.is_empty() {
+        ui.label(egui::RichText::new("Growing the hair…").color(studio_theme::MUTED));
+        return;
+    }
+    let current = choices
+        .iter()
+        .find(|choice| same_level(choice.form, *form))
+        .map_or_else(String::new, |choice| choice.label.clone());
+    egui::ComboBox::from_label("Level of detail")
+        .selected_text(current)
+        .show_ui(ui, |ui| {
+            for choice in &choices {
+                let chosen = same_level(choice.form, *form);
+                if ui.selectable_label(chosen, &choice.label).clicked() && !chosen {
+                    *form = match choice.form {
+                        Form::Strands { level, .. } => Form::Strands {
+                            level,
+                            share: START_SHARE,
+                        },
+                        cards => cards,
+                    };
+                }
+            }
+        });
+    let Form::Strands { level, mut share } = *form else {
+        return;
+    };
+    let resized = stat_slider(
+        ui,
+        "Strands drawn",
+        &mut share,
+        MIN_SHARE..=1.0,
+        START_SHARE,
+    )
+    .changed();
+    if resized {
+        *form = Form::Strands { level, share };
+    }
+    if let Some(count) = preview.strands_drawn(*form) {
+        ui.label(
+            egui::RichText::new(format!(
+                "{} of {} strands, widened to keep the head covered",
+                count.drawn, count.all
+            ))
+            .color(studio_theme::MUTED),
+        );
+    }
+}
+
+/// Whether two forms draw the same level, whatever share of its strands.
+fn same_level(a: Form, b: Form) -> bool {
+    match (a, b) {
+        (Form::Strands { level: a, .. }, Form::Strands { level: b, .. })
+        | (Form::Cards { level: a }, Form::Cards { level: b }) => a == b,
+        _ => false,
+    }
+}
--- before/crates/adventuresim-character-creator/src/hair_preview/gpu.rs
+++ after/crates/adventuresim-character-creator/src/hair_preview/gpu.rs
@@ -0,0 +1,73 @@
+//! The studio's hair GPU: the hair kernels on the device the studio draws
+//! with, so hair grown there can be drawn from where it lies. Compiling the
+//! kernels takes a moment, so the first worker that grows hair compiles
+//! them, and every later one reuses them.
+use super::*;
+use adventuresim_character_creator::hair::HairGpu;
+use bevy::render::RenderApp;
+use bevy::render::renderer::{RenderAdapter, RenderDevice, RenderInstance, RenderQueue};
+use fabelgeist_gpu::globals::WgpuContext;
+use std::sync::OnceLock;
+
+/// The studio's render device, and the hair kernels on it once compiled.
+#[derive(Clone)]
+pub(crate) struct StudioHairGpu(Arc<DeviceKernels>);
+
+struct DeviceKernels {
+    context: WgpuContext,
+    kernels: OnceLock<Result<HairGpu, String>>,
+}
+
+impl StudioHairGpu {
+    /// The hair kernels, compiled on the first call.
+    pub(crate) fn kernels(&self) -> Result<&HairGpu> {
+        self.0
+            .kernels
+            .get_or_init(|| {
+                HairGpu::new(self.0.context.clone()).map_err(|error| format!("{error:#}"))
+            })
+            .as_ref()
+            .map_err(|error| anyhow::anyhow!("compiling the hair kernels: {error}"))
+    }
+}
+
+/// Hands the hair preview the studio's render device once the renderer has
+/// one.
+pub(crate) struct HairGpuPlugin;
+
+impl Plugin for HairGpuPlugin {
+    fn build(&self, _app: &mut App) {}
+
+    fn finish(&self, app: &mut App) {
+        let Some(context) = render_context(app) else {
+            return;
+        };
+        let gpu = StudioHairGpu(Arc::new(DeviceKernels {
+            context,
+            kernels: OnceLock::new(),
+        }));
+        if let Some(mut preview) = app.world_mut().get_resource_mut::<HairPreview>() {
+            preview.gpu = Some(gpu);
+        }
+    }
+}
+
+/// The device `app` renders with, once its renderer has one: hair built
+/// there is drawn from where it lies.
+pub(crate) fn render_context(app: &App) -> Option<WgpuContext> {
+    let instance = app
+        .get_sub_app(RenderApp)?
+        .world()
+        .get_resource::<RenderInstance>()
+        .map(|instance| (**instance.0).clone())?;
+    let world = app.world();
+    let device = world.get_resource::<RenderDevice>()?;
+    let queue = world.get_resource::<RenderQueue>()?;
+    let adapter = world.get_resource::<RenderAdapter>()?;
+    Some(WgpuContext::from_parts(
+        Arc::new(instance),
+        Arc::new((**adapter.0).clone()),
+        Arc::new(device.wgpu_device().clone()),
+        Arc::new((**queue.0).clone()),
+    ))
+}
--- before/crates/adventuresim-character-creator/src/hair_preview/layers.rs
+++ after/crates/adventuresim-character-creator/src/hair_preview/layers.rs
@@ -0,0 +1,52 @@
+//! Showing the hair and the scalp under it apart, to look at either alone:
+//! the scalp's painted strands without the hair over them, or the hair
+//! without the scalp filling its gaps. Only what the studio draws changes;
+//! the recipe keeps its hair.
+use super::*;
+
+/// What a hair entity draws.
+#[derive(Component, Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum HairLayer {
+    /// The strands or cards.
+    Hair,
+    /// The painted scalp cap under them.
+    Scalp,
+}
+
+/// Which hair layers the studio draws.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct ShownLayers {
+    pub(crate) hair: bool,
+    pub(crate) scalp: bool,
+}
+
+impl Default for ShownLayers {
+    fn default() -> Self {
+        Self {
+            hair: true,
+            scalp: true,
+        }
+    }
+}
+
+impl ShownLayers {
+    /// How an entity drawing `layer` is shown.
+    pub(in crate::hair_preview) fn visibility(self, layer: HairLayer) -> Visibility {
+        let shown = match layer {
+            HairLayer::Hair => self.hair,
+            HairLayer::Scalp => self.scalp,
+        };
+        if shown {
+            Visibility::Inherited
+        } else {
+            Visibility::Hidden
+        }
+    }
+}
+
+/// Show or hide each hair entity as the studio asks.
+pub(crate) fn show(studio: Res<Studio>, mut layers: Query<(&HairLayer, &mut Visibility)>) {
+    for (&layer, mut visibility) in &mut layers {
+        visibility.set_if_neq(studio.hair_layers.visibility(layer));
+    }
+}
--- before/crates/adventuresim-character-creator/src/hair_preview/render_test.rs
+++ after/crates/adventuresim-character-creator/src/hair_preview/render_test.rs
@@ -0,0 +1,513 @@
+//! Hair on the default body drawn headless, as the studio draws it -- the
+//! same meshes, materials, scalp paint and lights -- in every level of
+//! detail and from five views: how a change to hair is looked at without
+//! the studio's window.
+//!
+//! ```text
+//! MHR_ASSETS=target/mhr-assets/v1.0.1/assets HAIR_PRESET=long cargo test --release --manifest-path crates/adventuresim-character-creator/Cargo.toml --bin adventuresim-character-creator hair_renders -- --ignored --nocapture
+//! ```
+//!
+//! writes `target/hair-render/<preset>-<form>-<view>.png`. `HAIR_PRESET` takes
+//! a recipe's hairstyle name, `long` when unset. `HAIR_ON_BUST=1` draws the
+//! hair on the hair crate's own bust instead, as it grew there, to
+//! `bust-<preset>-<form>-<view>.png`: what placing it on a character is
+//! measured against. Beside them it writes the scalp's baked textures,
+//! `<preset>-scalp-texture.png` and `<preset>-scalp-strands.png`. `HAIR_SHAPE`
+//! varies the preset as the Hair page does, taking the shape's recipe fields
+//! that differ from its default -- for instance `{"length": 0.6, "curl": 0.5}`
+//! -- and names the images `<preset>-shaped-...`. `HAIR_PIGMENT` colours it as
+//! a recipe's pigment does -- `{"melanin": 0.1, "redness": 0.05, "dye": [0.12,
+//! 0.38, 1.0]}`, say -- and names the images `<preset>-coloured-...`.
+//! `HAIR_SHOW=scalp` or `HAIR_SHOW=hair` draws the scalp or the hair alone, as
+//! the Hair page's switches do, to `<preset>-scalp-only-...` or
+//! `<preset>-hair-only-...`.
+use super::*;
+use adventuresim_character_creator::hair::{
+    GpuGeometry, HairGeometry, HairGpu, HairPigment, HairShape, PlacedHair,
+};
+use adventuresim_character_creator::studio_environment;
+use bevy::app::{PluginsState, ScheduleRunnerPlugin};
+use bevy::camera::RenderTarget;
+use bevy::camera::visibility::{NoFrustumCulling, RenderLayers};
+use bevy::mesh::skinning::{SkinnedMesh, SkinnedMeshInverseBindposes};
+use bevy::render::render_resource::{TextureFormat, TextureUsages};
+use bevy::render::view::screenshot::{Screenshot, save_to_disk};
+use bevy::window::ExitCondition;
+use bevy::winit::WinitPlugin;
+use fabelgeist_gpu::globals::WgpuContext;
+use fabelgeist_gpu::prelude::Buffer;
+use fabelgeist_hair::collider::Collider;
+use fabelgeist_hair::{MeshCollider, Preset};
+use fabelgeist_math::Vec3 as HairVec3;
+use std::path::PathBuf;
+use std::time::Duration;
+
+/// Each image's side, pixels.
+const SIDE: u32 = 640;
+/// Frames drawn before the capture: the atlas, the environment map and the
+/// pipelines settle.
+const SETTLE_FRAMES: u32 = 90;
+/// Frames waited for the captures to be written.
+const WRITE_FRAMES: u32 = 30;
+
+/// A camera round the head: where it stands and where it looks, as offsets
+/// from the head's centre, metres; the face looks along +Z.
+struct View {
+    name: &'static str,
+    eye: Vec3,
+    target: Vec3,
+}
+
+const VIEWS: [View; 5] = [
+    // Close over the parting: how the roots leave the scalp.
+    View {
+        name: "parting",
+        eye: Vec3::new(0.05, 0.2, 0.1),
+        target: Vec3::new(0.0, 0.1, 0.03),
+    },
+    // From above: the roots and the scalp between them.
+    View {
+        name: "crown",
+        eye: Vec3::new(0.0, 0.42, 0.1),
+        target: Vec3::new(0.0, 0.05, 0.0),
+    },
+    // From the front and above: the parting and the crown.
+    View {
+        name: "front",
+        eye: Vec3::new(0.0, 0.3, 0.5),
+        target: Vec3::new(0.0, 0.0, 0.0),
+    },
+    // From behind: the hair down the back.
+    View {
+        name: "back",
+        eye: Vec3::new(0.0, 0.0, -0.75),
+        target: Vec3::new(0.0, -0.2, 0.0),
+    },
+    // Over the left shoulder from behind, close.
+    View {
+        name: "shoulder",
+        eye: Vec3::new(0.45, 0.05, -0.35),
+        target: Vec3::new(0.12, -0.22, 0.0),
+    },
+];
+
+/// The hair placed, and the body it is drawn on.
+struct Subject {
+    placed: PlacedHair,
+    positions: Vec<[f32; 3]>,
+    faces: Vec<[u32; 3]>,
+    body: Mesh,
+}
+
+impl Subject {
+    /// `grown` placed on the default character, as the studio places it.
+    fn character(assets: &std::ffi::OsStr, gpu: &HairGpu, grown: &GroomedHair) -> Result<Self> {
+        let model = load_body_model(
+            std::path::Path::new(assets),
+            adventuresim_character_creator::lod::MIN_CHARACTER_LOD,
+            false,
+            &Device::default(),
+        )?;
+        let generated = generate_character(&model, &CharacterRecipe::default())?;
+        let head = BodyHead::new(&model, &generated);
+        let started = std::time::Instant::now();
+        let placed = head.place(gpu, grown)?;
+        println!("placed in {:.2} s", started.elapsed().as_secs_f32());
+        let body =
+            studio_generation::visible_body_mesh(&generated, &model.mhr.character.mesh.faces);
+        Ok(Self {
+            placed,
+            positions: head.positions,
+            faces: head.faces,
+            body,
+        })
+    }
+
+    /// `grown` left on its own bust, as the hair crate grew it.
+    fn bust(gpu: &HairGpu, grown: &GroomedHair) -> Result<Self> {
+        let (placed, bust) = grown.on_bust(gpu)?;
+        let positions: Vec<[f32; 3]> = bust.positions.iter().map(|p| p.to_array()).collect();
+        let normals: Vec<[f32; 3]> = bust.normals.iter().map(|n| n.to_array()).collect();
+        let faces = bust.triangles.clone();
+        let body = Mesh::new(
+            PrimitiveTopology::TriangleList,
+            RenderAssetUsages::default(),
+        )
+        .with_inserted_attribute(Mesh::ATTRIBUTE_POSITION, positions.clone())
+        .with_inserted_attribute(Mesh::ATTRIBUTE_NORMAL, normals)
+        .with_inserted_indices(Indices::U32(faces.as_flattened().to_vec()));
+        Ok(Self {
+            placed,
+            positions,
+            faces,
+            body,
+        })
+    }
+}
+
+/// The captures still to write.
+#[derive(Resource)]
+struct Captures {
+    shots: Vec<(Handle<Image>, PathBuf)>,
+    frames: u32,
+}
+
+/// The layers `HAIR_SHOW` asks for: `hair` or `scalp` alone, or both.
+fn test_layers() -> Result<ShownLayers> {
+    match std::env::var("HAIR_SHOW").as_deref() {
+        Err(_) => Ok(ShownLayers::default()),
+        Ok("hair") => Ok(ShownLayers {
+            hair: true,
+            scalp: false,
+        }),
+        Ok("scalp") => Ok(ShownLayers {
+            hair: false,
+            scalp: true,
+        }),
+        Ok(other) => anyhow::bail!("HAIR_SHOW takes hair or scalp, not {other}"),
+    }
+}
+
+/// The pigment `HAIR_PIGMENT` asks for, as a recipe gives it, or the
+/// default.
+fn test_pigment() -> Result<HairPigment> {
+    match std::env::var("HAIR_PIGMENT") {
+        Ok(pigment) => Ok(serde_json::from_str(&pigment)?),
+        Err(_) => Ok(HairPigment::default()),
+    }
+}
+
+/// The shape `HAIR_SHAPE` asks for: the default, its fields replaced.
+fn test_shape() -> Result<HairShape> {
+    let mut shape = serde_json::to_value(HairShape::default())?;
+    if let Ok(changes) = std::env::var("HAIR_SHAPE") {
+        let changes: serde_json::Map<String, serde_json::Value> = serde_json::from_str(&changes)?;
+        let fields = shape
+            .as_object_mut()
+            .context("a hair shape is a JSON object")?;
+        fields.extend(changes);
+    }
+    Ok(serde_json::from_value(shape)?)
+}
+
+#[test]
+#[ignore = "requires MHR_ASSETS and a GPU"]
+fn hair_renders() -> Result<()> {
+    let assets = std::env::var_os("MHR_ASSETS").context("set MHR_ASSETS")?;
+    let preset_name = std::env::var("HAIR_PRESET").unwrap_or_else(|_| "long".to_owned());
+    let preset: Preset = serde_json::from_value(serde_json::Value::String(preset_name.clone()))?;
+    let design = HairDesign {
+        preset,
+        shape: test_shape()?,
+        pigment: test_pigment()?,
+    };
+    // Hair is built on the device it is drawn with, as in the studio.
+    let (mut app, context) = render_app()?;
+    let started = std::time::Instant::now();
+    let gpu = HairGpu::new(context)?;
+    println!(
+        "hair kernels compiled in {:.2} s",
+        started.elapsed().as_secs_f32()
+    );
+    let started = std::time::Instant::now();
+    let grown = GroomedHair::grow(design.groom(), &gpu)?;
+    println!("grown in {:.2} s", started.elapsed().as_secs_f32());
+    let on_bust = std::env::var_os("HAIR_ON_BUST").is_some();
+    let subject = if on_bust {
+        Subject::bust(&gpu, &grown)?
+    } else {
+        Subject::character(&assets, &gpu, &grown)?
+    };
+    let Subject {
+        placed,
+        positions,
+        faces,
+        body,
+    } = subject;
+    let center = Vec3::from_array(
+        placed
+            .placement()
+            .point(grown.head().cranium.center.to_array()),
+    );
+    let mut cap = assets::cap_mesh(placed.cap(), placed.placement().head_joint)?;
+    cap.remove_attribute(Mesh::ATTRIBUTE_JOINT_INDEX);
+    cap.remove_attribute(Mesh::ATTRIBUTE_JOINT_WEIGHT);
+    let forms = placed.forms();
+    let out = PathBuf::from("../../target/hair-render");
+    std::fs::create_dir_all(&out)?;
+    let subject_name = if on_bust { "bust-" } else { "" };
+    let preset_name = if design.shape == HairShape::default() {
+        preset_name
+    } else {
+        format!("{preset_name}-shaped")
+    };
+    let preset_name = if design.pigment == HairPigment::default() {
+        preset_name
+    } else {
+        format!("{preset_name}-coloured")
+    };
+    let shown = test_layers()?;
+    let preset_name = match (shown.hair, shown.scalp) {
+        (true, true) => preset_name,
+        (false, _) => format!("{preset_name}-scalp-only"),
+        (true, false) => format!("{preset_name}-hair-only"),
+    };
+    let textures = placed.scalp_texture().read(&gpu)?;
+    for (name, levels) in [("texture", &textures.shade), ("strands", &textures.strands)] {
+        let texture = levels.first().context("no scalp texture")?;
+        image::RgbaImage::from_raw(texture.width, texture.height, texture.rgba.clone())
+            .context("the scalp texture's size")?
+            .save(out.join(format!("{subject_name}{preset_name}-scalp-{name}.png")))?;
+    }
+
+    let skin = MeshCollider::new(
+        positions
+            .iter()
+            .copied()
+            .map(HairVec3::from_array)
+            .collect(),
+        faces,
+        BURIED_REACH,
+    );
+    let mut shots = Vec::new();
+    let mut hairs = Vec::new();
+    for &form in &forms {
+        let started = std::time::Instant::now();
+        let Some(geometry) = placed.gpu_geometry(&gpu, form)? else {
+            continue;
+        };
+        gpu.finish();
+        let built = started.elapsed();
+        let buried = buried_share(&geometry.read(&gpu)?, &skin);
+        println!(
+            "{form:?}: built in {:.2} s, {:.1}% of hair triangles buried in the skin",
+            built.as_secs_f32(),
+            buried * 100.0
+        );
+        let form_name = match form {
+            Form::Strands { level, .. } => format!("strands{level}"),
+            Form::Cards { level } => format!("cards{level}"),
+        };
+        // Drawn in the bind pose, skinned as the studio skins it but to one
+        // joint left where it is.
+        let mesh = assets::mesh(&geometry, 0)?;
+        let paths = VIEWS
+            .iter()
+            .map(|view| {
+                out.join(format!(
+                    "{subject_name}{preset_name}-{form_name}-{}.png",
+                    view.name
+                ))
+            })
+            .collect();
+        hairs.push((form, mesh, geometry, paths));
+    }
+    let stage = Stage {
+        body: Some(body),
+        cap: Some(cap),
+        atlas: Some(assets::atlas_image(&placed)),
+        scalp: Some([
+            placed.scalp_texture().shade().clone(),
+            placed.scalp_texture().strands().clone(),
+        ]),
+        hairs,
+        design,
+        center,
+        shown,
+    };
+
+    app.insert_resource(stage)
+        .insert_resource(Captures {
+            shots: std::mem::take(&mut shots),
+            frames: 0,
+        })
+        .add_systems(Startup, spawn)
+        .add_systems(Update, capture);
+    app.run();
+    gpu.finish();
+    println!("wrote {}", out.display());
+    Ok(())
+}
+
+/// The studio's renderer, headless, started, and the device it draws with,
+/// to build hair on: taken before the render world moves to its own thread.
+fn render_app() -> Result<(App, WgpuContext)> {
+    let mut app = App::new();
+    app.insert_resource(ClearColor(studio_scene::BACKDROP))
+        .add_plugins(
+            DefaultPlugins
+                .set(WindowPlugin {
+                    primary_window: None,
+                    exit_condition: ExitCondition::DontExit,
+                    ..default()
+                })
+                .disable::<WinitPlugin>(),
+        )
+        .add_plugins((
+            ScheduleRunnerPlugin::run_loop(Duration::ZERO),
+            HairShadingPlugin,
+        ));
+    while app.plugins_state() == PluginsState::Adding {
+        bevy::tasks::tick_global_task_pools_on_main_thread();
+    }
+    app.finish();
+    let context = gpu::render_context(&app).context("the renderer has no device")?;
+    app.cleanup();
+    Ok((app, context))
+}
+
+/// What the startup system spawns: the shaded body, the atlas, and each
+/// form's hair mesh with the paths its views are written to.
+#[derive(Resource)]
+struct Stage {
+    body: Option<Mesh>,
+    cap: Option<Mesh>,
+    atlas: Option<Image>,
+    /// The scalp's baked shade and strands chains.
+    scalp: Option<[Buffer; 2]>,
+    hairs: Vec<(Form, Mesh, GpuGeometry, Vec<PathBuf>)>,
+    design: HairDesign,
+    center: Vec3,
+    shown: ShownLayers,
+}
+
+/// The body, the light, and per form its hair and a camera for each view,
+/// each form on its own render layer.
+#[expect(
+    clippy::too_many_arguments,
+    reason = "Bevy injects the stage, the captures and every asset store it fills"
+)]
+fn spawn(
+    mut commands: Commands,
+    mut stage: ResMut<Stage>,
+    mut captures: ResMut<Captures>,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut materials: ResMut<Assets<StandardMaterial>>,
+    mut hair_materials: ResMut<Assets<strand_shading::HairShading>>,
+    mut scalp_materials: ResMut<Assets<scalp_shade::ScalpShading>>,
+    mut images: ResMut<Assets<Image>>,
+    mut bindposes: ResMut<Assets<SkinnedMeshInverseBindposes>>,
+    uploads: Res<scalp_upload::ScalpUploads>,
+) {
+    let (Some(body), Some(cap), Some(atlas), Some([shade, strands])) = (
+        stage.body.take(),
+        stage.cap.take(),
+        stage.atlas.take(),
+        stage.scalp.take(),
+    ) else {
+        return;
+    };
+    let scalp = scalp_shade::ScalpImages {
+        shade: uploads.image(&shade, &mut images),
+        strands: uploads.image(&strands, &mut images),
+    };
+    let atlas = images.add(atlas);
+    let environment = images.add(studio_environment::studio_environment());
+    let every_layer = RenderLayers::from_layers(&(0..=stage.hairs.len()).collect::<Vec<_>>());
+    let skin = materials.add(preview::skin_material());
+    commands.spawn((
+        Mesh3d(meshes.add(body)),
+        MeshMaterial3d(skin),
+        every_layer.clone(),
+    ));
+    commands.spawn((
+        Mesh3d(meshes.add(cap)),
+        MeshMaterial3d(scalp_materials.add(scalp_shade::material(stage.design, &scalp))),
+        stage.shown.visibility(HairLayer::Scalp),
+        every_layer.clone(),
+    ));
+    commands.spawn((
+        SpotLight {
+            color: Color::srgb(1.0, 0.90, 0.79),
+            intensity: 1_050_000.0,
+            range: 8.0,
+            radius: 0.38,
+            inner_angle: 0.30,
+            outer_angle: 0.58,
+            shadow_maps_enabled: true,
+            shadow_depth_bias: 0.025,
+            shadow_normal_bias: 1.9,
+            shadow_map_near_z: 0.1,
+            ..default()
+        },
+        Transform::from_xyz(-2.4, 4.2, 3.0).looking_at(Vec3::new(0.0, 1.0, 0.0), Vec3::Y),
+        every_layer,
+    ));
+    let design = stage.design;
+    let center = stage.center;
+    let skin = SkinnedMesh {
+        inverse_bindposes: bindposes.add(vec![Mat4::IDENTITY]),
+        joints: vec![commands.spawn(Transform::default()).id()],
+    };
+    let hairs = std::mem::take(&mut stage.hairs);
+    for (index, (form, mesh, geometry, paths)) in hairs.into_iter().enumerate() {
+        let layer = index + 1;
+        let material = assets::material(design, form, atlas.clone(), &geometry);
+        commands.spawn((
+            Mesh3d(meshes.add(mesh)),
+            MeshMaterial3d(hair_materials.add(material)),
+            skin.clone(),
+            stage.shown.visibility(HairLayer::Hair),
+            RenderLayers::layer(layer),
+            NoFrustumCulling,
+        ));
+        for (view, path) in VIEWS.iter().zip(paths) {
+            let mut image =
+                Image::new_target_texture(SIDE, SIDE, TextureFormat::Rgba8UnormSrgb, None);
+            image.texture_descriptor.usage |= TextureUsages::COPY_SRC;
+            let image = images.add(image);
+            commands.spawn((
+                Camera3d::default(),
+                RenderTarget::Image(image.clone().into()),
+                Transform::from_translation(center + view.eye)
+                    .looking_at(center + view.target, Vec3::Y),
+                GeneratedEnvironmentMapLight {
+                    environment_map: environment.clone(),
+                    intensity: studio_environment::STUDIO_ENVIRONMENT_INTENSITY,
+                    ..default()
+                },
+                RenderLayers::from_layers(&[0, layer]),
+            ));
+            captures.shots.push((image, path));
+        }
+    }
+}
+
+/// How far the skin collider answers, metres: hair farther out is outside.
+const BURIED_REACH: f32 = 0.05;
+
+/// The share of `geometry`'s triangles whose centre lies under the skin.
+fn buried_share(geometry: &HairGeometry, skin: &MeshCollider) -> f32 {
+    let buried = geometry
+        .faces
+        .iter()
+        .filter(|face| {
+            let centre = face
+                .iter()
+                .map(|&vertex| HairVec3::from_array(geometry.positions[vertex as usize]))
+                .fold(HairVec3::new(0.0, 0.0, 0.0), |sum, point| sum + point)
+                / 3.0;
+            skin.distance(centre) < 0.0
+        })
+        .count();
+    buried as f32 / geometry.faces.len().max(1) as f32
+}
+
+/// Settle, capture every image, wait for them to be written, and leave.
+fn capture(
+    mut commands: Commands,
+    mut captures: ResMut<Captures>,
+    mut exit: MessageWriter<AppExit>,
+) {
+    captures.frames += 1;
+    if captures.frames == SETTLE_FRAMES {
+        for (image, path) in captures.shots.drain(..) {
+            commands
+                .spawn(Screenshot::image(image))
+                .observe(save_to_disk(path));
+        }
+    }
+    if captures.frames == SETTLE_FRAMES + WRITE_FRAMES {
+        exit.write(AppExit::Success);
+    }
+}
--- before/crates/adventuresim-character-creator/src/hair_preview/scalp_shade.rs
+++ after/crates/adventuresim-character-creator/src/hair_preview/scalp_shade.rs
@@ -0,0 +1,71 @@
+//! The scalp under the hair, painted with the hair lying on it and shaded
+//! as the hair is.
+//!
+//! Between strands and cards the skin would show bare. The scalp cap is
+//! drawn as hair instead, from the textures baked from the groom: the
+//! strands lying along the scalp, their shade and the way each runs, lit by
+//! the hair's own material and strand normals ([`ScalpShading`]), so the
+//! hair painted on the scalp and the hair drawn over it look alike. Where
+//! the scalp is bare -- at a parting -- the textures turn clear and the skin
+//! beneath shows. Only the cap is painted -- the body's own skin, the neck
+//! and the shoulders hair falls over, keeps its colour -- and the cap comes
+//! and goes with the hair it lies under. The cap is blended over the skin,
+//! fading out towards its edge.
+use super::*;
+use bevy::pbr::{ExtendedMaterial, MaterialExtension};
+use bevy::render::render_resource::AsBindGroup;
+use bevy::shader::ShaderRef;
+
+pub(super) const SHADER: &str =
+    "embedded://adventuresim_character_creator/hair_preview/scalp_shading.wgsl";
+
+/// The scalp's material: the hair's, shaded by `scalp_shading.wgsl`.
+pub(crate) type ScalpShading = ExtendedMaterial<StandardMaterial, ScalpStrands>;
+
+/// The standard material's extension for the scalp: the baked strands
+/// texture, the way each strand runs across it.
+#[derive(Asset, AsBindGroup, Reflect, Debug, Clone)]
+pub(crate) struct ScalpStrands {
+    #[texture(100)]
+    #[sampler(101)]
+    strands: Handle<Image>,
+}
+
+impl MaterialExtension for ScalpStrands {
+    fn fragment_shader() -> ShaderRef {
+        SHADER.into()
+    }
+}
+
+/// The scalp's baked textures, as images.
+#[derive(Clone)]
+pub(super) struct ScalpImages {
+    /// Shade as grey and coverage as alpha: the base colour's texture.
+    pub(super) shade: Handle<Image>,
+    /// The way each strand runs, and its shade.
+    pub(super) strands: Handle<Image>,
+}
+
+/// The material the scalp cap under hair of `design` is drawn with: the
+/// hair's, its colour shaded by the baked shade, blended over the skin.
+pub(super) fn material(design: HairDesign, images: &ScalpImages) -> ScalpShading {
+    ScalpShading {
+        base: StandardMaterial {
+            base_color_texture: Some(images.shade.clone()),
+            alpha_mode: AlphaMode::Blend,
+            ..assets::hair_surface(design)
+        },
+        extension: ScalpStrands {
+            strands: images.strands.clone(),
+        },
+    }
+}
+
+/// The cap's vertex colours: white, as the material carries the hair's
+/// colour, showing by `opacity`.
+pub(super) fn colors(opacity: &[f32]) -> Vec<[f32; 4]> {
+    opacity
+        .iter()
+        .map(|&opacity| [1.0, 1.0, 1.0, opacity])
+        .collect()
+}
--- before/crates/adventuresim-character-creator/src/hair_preview/scalp_upload.rs
+++ after/crates/adventuresim-character-creator/src/hair_preview/scalp_upload.rs
@@ -0,0 +1,150 @@
+//! The scalp's baked textures, copied on the GPU from the buffers they were
+//! baked in into the images the scalp is drawn with.
+//!
+//! The bake leaves each texture's mip chain in one buffer, every level's
+//! rows padded as a copy into a texture moves them. Its image is made with
+//! no data and copied into once the renderer has made its texture, so no
+//! texel comes back to the CPU.
+use super::*;
+use adventuresim_character_creator::hair::scalp_levels;
+use bevy::image::{ImageAddressMode, ImageFilterMode, ImageSampler, ImageSamplerDescriptor};
+use bevy::render::render_asset::RenderAssets;
+use bevy::render::render_resource::{
+    CommandEncoderDescriptor, Extent3d, Origin3d, TexelCopyBufferInfo, TexelCopyBufferLayout,
+    TexelCopyTextureInfo, TextureAspect, TextureDimension, TextureFormat,
+};
+use bevy::render::renderer::{RenderDevice, RenderQueue};
+use bevy::render::texture::GpuImage;
+use bevy::render::{Render, RenderApp, RenderSystems};
+use fabelgeist_gpu::prelude::Buffer;
+use std::sync::{Mutex, PoisonError};
+
+/// The most samples the scalp's texture is filtered with along the line
+/// of sight: hardware anisotropic filtering's usual ceiling.
+const SCALP_ANISOTROPY: u16 = 16;
+/// Bytes of a texel.
+const TEXEL_BYTES: u32 = 4;
+
+/// Scalp textures waiting for the renderer to make their images, shared by
+/// the main world, which adds them, and the render world, which copies them.
+#[derive(Resource, Clone, Default)]
+pub(crate) struct ScalpUploads(Arc<Mutex<Vec<ScalpUpload>>>);
+
+struct ScalpUpload {
+    /// Held until copied into, so the renderer makes its texture.
+    image: Handle<Image>,
+    chain: Buffer,
+}
+
+impl ScalpUploads {
+    /// An image the baked mip `chain` is copied into on the GPU, sampled
+    /// anisotropically: its strands lie along the scalp, which the eye
+    /// meets at every angle round the head.
+    pub(super) fn image(&self, chain: &Buffer, images: &mut Assets<Image>) -> Handle<Image> {
+        let image = images.add(scalp_image());
+        self.0
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .push(ScalpUpload {
+                image: image.clone(),
+                chain: chain.clone(),
+            });
+        image
+    }
+}
+
+/// An empty image the size of the scalp's textures with their whole mip
+/// chain, filtered linearly and anisotropically.
+fn scalp_image() -> Image {
+    let side = scalp_levels().first().map_or(1, |level| level.side);
+    let mut image = Image::new_uninit(
+        Extent3d {
+            width: side,
+            height: side,
+            depth_or_array_layers: 1,
+        },
+        TextureDimension::D2,
+        TextureFormat::Rgba8Unorm,
+        RenderAssetUsages::RENDER_WORLD,
+    );
+    image.texture_descriptor.mip_level_count = scalp_levels().len() as u32;
+    image.sampler = ImageSampler::Descriptor(ImageSamplerDescriptor {
+        address_mode_u: ImageAddressMode::ClampToEdge,
+        address_mode_v: ImageAddressMode::ClampToEdge,
+        mag_filter: ImageFilterMode::Linear,
+        min_filter: ImageFilterMode::Linear,
+        mipmap_filter: ImageFilterMode::Linear,
+        anisotropy_clamp: SCALP_ANISOTROPY,
+        ..default()
+    });
+    image
+}
+
+/// Copy every scalp texture whose image the renderer has made, each mip
+/// level from its place in the baked chain.
+fn upload(
+    uploads: Res<ScalpUploads>,
+    images: Res<RenderAssets<GpuImage>>,
+    device: Res<RenderDevice>,
+    queue: Res<RenderQueue>,
+) {
+    let mut pending = uploads.0.lock().unwrap_or_else(PoisonError::into_inner);
+    if pending.is_empty() {
+        return;
+    }
+    let mut encoder = device.create_command_encoder(&CommandEncoderDescriptor {
+        label: Some("hair scalp upload"),
+    });
+    let mut copied = false;
+    pending.retain(|upload| {
+        let Some(image) = images.get(&upload.image) else {
+            return true;
+        };
+        for (mip, level) in scalp_levels().into_iter().enumerate() {
+            encoder.copy_buffer_to_texture(
+                TexelCopyBufferInfo {
+                    buffer: &upload.chain.buffer,
+                    layout: TexelCopyBufferLayout {
+                        offset: u64::from(level.offset * TEXEL_BYTES),
+                        bytes_per_row: Some(level.stride * TEXEL_BYTES),
+                        rows_per_image: Some(level.side),
+                    },
+                },
+                TexelCopyTextureInfo {
+                    texture: &image.texture,
+                    mip_level: mip as u32,
+                    origin: Origin3d::ZERO,
+                    aspect: TextureAspect::All,
+                },
+                Extent3d {
+                    width: level.side,
+                    height: level.side,
+                    depth_or_array_layers: 1,
+                },
+            );
+        }
+        copied = true;
+        false
+    });
+    if copied {
+        queue.submit([encoder.finish()]);
+    }
+}
+
+/// Copies the scalp's baked textures into their images on the GPU.
+pub(super) struct ScalpUploadPlugin;
+
+impl Plugin for ScalpUploadPlugin {
+    fn build(&self, app: &mut App) {
+        let uploads = ScalpUploads::default();
+        app.insert_resource(uploads.clone());
+        if let Some(render) = app.get_sub_app_mut(RenderApp) {
+            render.insert_resource(uploads).add_systems(
+                Render,
+                upload
+                    .in_set(RenderSystems::PrepareResources)
+                    .after(RenderSystems::PrepareAssets),
+            );
+        }
+    }
+}
--- before/crates/adventuresim-character-creator/src/hair_preview/strand_shading.rs
+++ after/crates/adventuresim-character-creator/src/hair_preview/strand_shading.rs
@@ -0,0 +1,133 @@
+//! The material hair is drawn with: the standard material, shaded as
+//! strands and, for cards, its atlas coverage turned into a share of each
+//! pixel's samples, by `strand_shading.wgsl`. The strand normal it and the
+//! scalp's material share lives in `strand.wgsl`.
+//!
+//! Hair is built on the GPU it is drawn on and drawn from where it was
+//! built: the material binds the buffers its strips were built into, and
+//! its vertex shaders (`hair_vertex.wgsl` for the main pass,
+//! `hair_prepass.wgsl` for the prepass and shadows) pull each vertex from
+//! them (`hair_vertices.wgsl`). Its mesh carries only how each vertex is
+//! skinned, so no vertex comes back to the CPU.
+use super::*;
+use adventuresim_character_creator::hair::GpuGeometry;
+use bevy::asset::embedded_asset;
+use bevy::mesh::MeshVertexBufferLayoutRef;
+use bevy::pbr::{
+    ExtendedMaterial, MaterialExtension, MaterialExtensionKey, MaterialExtensionPipeline,
+};
+use bevy::render::render_resource::{
+    AsBindGroup, Buffer, RenderPipelineDescriptor, SpecializedMeshPipelineError,
+};
+use bevy::shader::{ShaderDefVal, ShaderRef, load_shader_library};
+
+const SHADER: &str = "embedded://adventuresim_character_creator/hair_preview/strand_shading.wgsl";
+const VERTEX: &str = "embedded://adventuresim_character_creator/hair_preview/hair_vertex.wgsl";
+const PREPASS_VERTEX: &str =
+    "embedded://adventuresim_character_creator/hair_preview/hair_prepass.wgsl";
+/// Bevy's shader definition for the prepass and shadow pipelines.
+const PREPASS: &str = "PREPASS_PIPELINE";
+/// Bevy's shader definition for a prepass writing normals.
+const PREPASS_NORMALS: &str = "NORMAL_PREPASS_OR_DEFERRED_PREPASS";
+
+/// Hair's material, for strands and cards alike.
+pub(crate) type HairShading = ExtendedMaterial<StandardMaterial, StrandShading>;
+
+/// The standard material's extension for hair: the buffers its strips were
+/// built into, four floats a vertex, which its vertex shaders draw from.
+#[derive(Asset, AsBindGroup, Reflect, Debug, Clone)]
+#[reflect(opaque)]
+#[reflect(Clone, Debug)]
+pub(crate) struct StrandShading {
+    /// Position, and baked sky visibility.
+    #[storage(102, read_only, buffer)]
+    positions: Buffer,
+    /// Normal, and the strip's own random value.
+    #[storage(103, read_only, buffer)]
+    normals: Buffer,
+    /// Along the strands, root to tip.
+    #[storage(104, read_only, buffer)]
+    tangents: Buffer,
+    /// Texture coordinates.
+    #[storage(105, read_only, buffer)]
+    texcoords: Buffer,
+}
+
+impl StrandShading {
+    /// Drawing `geometry` from where it was built.
+    pub(super) fn new(geometry: &GpuGeometry) -> Self {
+        let bind =
+            |buffer: &fabelgeist_gpu::prelude::Buffer| Buffer::from((*buffer.buffer).clone());
+        Self {
+            positions: bind(geometry.positions()),
+            normals: bind(geometry.normals()),
+            tangents: bind(geometry.tangents()),
+            texcoords: bind(geometry.texcoords()),
+        }
+    }
+}
+
+impl MaterialExtension for StrandShading {
+    fn vertex_shader() -> ShaderRef {
+        VERTEX.into()
+    }
+
+    fn fragment_shader() -> ShaderRef {
+        SHADER.into()
+    }
+
+    fn prepass_vertex_shader() -> ShaderRef {
+        PREPASS_VERTEX.into()
+    }
+
+    /// The vertex attributes the hair's buffers hold, as Bevy defines them
+    /// for a mesh carrying them: the mesh itself carries only its skin.
+    fn specialize(
+        _pipeline: &MaterialExtensionPipeline,
+        descriptor: &mut RenderPipelineDescriptor,
+        _layout: &MeshVertexBufferLayoutRef,
+        _key: MaterialExtensionKey<Self>,
+    ) -> Result<(), SpecializedMeshPipelineError> {
+        let defined = |name: &str| {
+            descriptor
+                .vertex
+                .shader_defs
+                .contains(&ShaderDefVal::from(name))
+        };
+        let mut attributes = vec![
+            "VERTEX_UVS",
+            "VERTEX_UVS_A",
+            "VERTEX_UVS_B",
+            "VERTEX_COLORS",
+        ];
+        if !defined(PREPASS) || defined(PREPASS_NORMALS) {
+            attributes.extend(["VERTEX_NORMALS", "VERTEX_TANGENTS"]);
+        }
+        let defs = attributes.into_iter().map(ShaderDefVal::from);
+        descriptor.vertex.shader_defs.extend(defs.clone());
+        if let Some(fragment) = &mut descriptor.fragment {
+            fragment.shader_defs.extend(defs);
+        }
+        Ok(())
+    }
+}
+
+/// Draws hair with [`HairShading`] and the scalp under it with
+/// [`scalp_shade::ScalpShading`].
+pub(crate) struct HairShadingPlugin;
+
+impl Plugin for HairShadingPlugin {
+    fn build(&self, app: &mut App) {
+        load_shader_library!(app, "strand.wgsl");
+        load_shader_library!(app, "hair_vertices.wgsl");
+        embedded_asset!(app, "strand_shading.wgsl");
+        embedded_asset!(app, "hair_vertex.wgsl");
+        embedded_asset!(app, "hair_prepass.wgsl");
+        embedded_asset!(app, "scalp_shading.wgsl");
+        app.add_plugins((
+            MaterialPlugin::<HairShading>::default(),
+            MaterialPlugin::<scalp_shade::ScalpShading>::default(),
+            scalp_upload::ScalpUploadPlugin,
+        ));
+    }
+}
