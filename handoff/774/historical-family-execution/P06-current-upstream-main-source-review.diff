+//! The hair node stack.
+//!
+//! DiffLocks' dataset pipeline is a stack of Blender geometry nodes over a
+//! few dozen hand-placed guide strands: interpolate them into ~100K strands
+//! across the scalp, then clump, curl, frizz and noise them -- each several
+//! times at different scales and strengths -- shrinkwrap them off the body,
+//! and drape them under gravity and wind. The node groups it uses are
+//! Blender's procedural hair assets, some in revised copies (`Interpolate
+//! Hair Curves V2`, `Clump Hair Curves_V2`, `Create Guide Index Map`,
+//! `Blend Hair Curves`, `Shrinkwrap Hair Curves`, `Restore Curve Segment
+//! Length`, `Set Hair Curve Profile`).
+//!
+//! Each operation here is one of those groups, written out from its node
+//! graph: the same inputs under the same names, the same fields sampled from
+//! the same places. [`Op`] is one entry of a stack; [`crate::Groom`] runs a
+//! stack. The operations share a few pieces the node groups share:
+//! [`shape_range`] (the `shape_range` group every falloff goes through),
+//! [`GuideMap`] (`Create Guide Index Map`: which strand leads each clump)
+//! and [`restore_lengths`] (`Restore Curve Segment Length`).
+//!
+//! Every operation reads its input from a snapshot and writes a strand per
+//! task, so a stack runs in parallel over strands.
+
+mod clump;
+mod curl;
+mod displace;
+mod interpolate;
+mod orient;
+mod settle;
+mod shrinkwrap;
+mod trim;
+
+pub use clump::Clump;
+pub use curl::Curl;
+pub use displace::{Frizz, Noise, Smooth, Wave};
+pub use interpolate::{DensityMask, Interpolate, Parting};
+pub use orient::Orient;
+pub use settle::{STANDARD_GRAVITY, Settle};
+pub use shrinkwrap::Shrinkwrap;
+pub use trim::Trim;
+
+use fabelgeist_math::Vec3;
+use rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::collider::Collider;
+use crate::grid::PointGrid;
+use crate::rng;
+use crate::strands::{CurveSampler, Strands};
+use crate::surface::Surface;
+
+/// What operations may look at besides the strands.
+pub struct Context<'a> {
+    /// The surface strands grow from.
+    pub scalp: &'a Surface,
+    /// What strands stay out of.
+    pub collider: &'a dyn Collider,
+}
+
+/// One operation of a groom's stack.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(tag = "op", rename_all = "snake_case")]
+pub enum Op {
+    Interpolate(Interpolate),
+    Orient(Orient),
+    Trim(Trim),
+    Clump(Clump),
+    Curl(Curl),
+    Wave(Wave),
+    Frizz(Frizz),
+    Noise(Noise),
+    Smooth(Smooth),
+    Shrinkwrap(Shrinkwrap),
+    Settle(Settle),
+    Profile(Profile),
+}
+
+impl Op {
+    pub fn name(&self) -> &'static str {
+        match self {
+            Op::Interpolate(_) => "Interpolate",
+            Op::Orient(_) => "Orient",
+            Op::Trim(_) => "Trim",
+            Op::Clump(_) => "Clump",
+            Op::Curl(_) => "Curl",
+            Op::Wave(_) => "Wave",
+            Op::Frizz(_) => "Frizz",
+            Op::Noise(_) => "Noise",
+            Op::Smooth(_) => "Smooth",
+            Op::Shrinkwrap(_) => "Shrinkwrap",
+            Op::Settle(_) => "Settle",
+            Op::Profile(_) => "Profile",
+        }
+    }
+
+    /// Run on `strands`. Interpolation replaces them (guides in, the full
+    /// groom out); everything else moves points.
+    pub fn apply(&self, strands: &mut Strands, context: &Context) {
+        match self {
+            Op::Interpolate(op) => *strands = op.apply(strands, context),
+            Op::Orient(op) => op.apply(strands),
+            Op::Trim(op) => op.apply(strands),
+            Op::Clump(op) => op.apply(strands),
+            Op::Curl(op) => op.apply(strands),
+            Op::Wave(op) => op.apply(strands),
+            Op::Frizz(op) => op.apply(strands),
+            Op::Noise(op) => op.apply(strands),
+            Op::Smooth(op) => op.apply(strands),
+            Op::Shrinkwrap(op) => op.apply(strands, context),
+            Op::Settle(op) => op.apply(strands, context),
+            Op::Profile(op) => op.apply(strands),
+        }
+    }
+}
+
+/// `Set Hair Curve Profile`, as far as the strands carry it: each strand's
+/// root radius, with some variation. How the radius falls off to the tip is
+/// the material's ([`crate::HairMaterial::taper`]), applied where strands
+/// are drawn.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Profile {
+    /// Root radius, metres. Human hair is 17 to 90 microns across.
+    pub radius: f32,
+    /// Each strand's radius is scaled by up to this much either way.
+    pub random: f32,
+    pub seed: i32,
+    /// Scale each strand's radius by `radius` over the one it was grown
+    /// with instead of setting it, keeping what interpolation made finer
+    /// (the hairline's fine hair).
+    #[serde(default)]
+    pub relative_to: Option<f32>,
+}
+
+impl Default for Profile {
+    fn default() -> Self {
+        Self {
+            radius: 35e-6,
+            random: 0.25,
+            seed: 0,
+            relative_to: None,
+        }
+    }
+}
+
+impl Profile {
+    pub fn apply(&self, strands: &mut Strands) {
+        let seed = rng::seed(self.seed, 51_823);
+        for (r, &id) in strands.radius.iter_mut().zip(&strands.id) {
+            let base = match self.relative_to {
+                Some(grown) if grown > 0.0 => self.radius * *r / grown,
+                _ => self.radius,
+            };
+            *r = base * (1.0 + self.random * rng::signed((id).word(), seed)).max(0.05);
+        }
+    }
+}
+
+/// The `shape_range` node group: `value` mapped from `[min, max]` to `[0,
+/// 1]`, bent by `shape`, and mapped back. `shape` 0 is constant 1 (the
+/// effect everywhere), 0.5 is linear, towards 1 the effect gathers at the
+/// top of the range; negative shapes mirror it. `base` sets how strongly
+/// the shape bends (2 in every use).
+pub fn shape_range(value: f32, min: f32, max: f32, shape: f32, base: f32) -> f32 {
+    if shape.abs() < 1e-5 {
+        return 1.0;
+    }
+    let x = if (max - min).abs() > 1e-12 {
+        (value - min) / (max - min)
+    } else {
+        0.0
+    };
+    let b = base.max(1.00001);
+    let a = shape.abs().min(0.999999);
+    let negative = shape < 0.0;
+    let flip = if a > 0.5 { !negative } else { negative };
+    let xx = if flip { 1.0 - x } else { x };
+    let pingpong = if a <= 0.5 { a } else { 1.0 - a };
+    let m = pingpong * 2.0 * (1.0 - 1.0 / b);
+    let exponent = -(1.0 - m).max(1e-5).ln() / b.max(1.000_001).ln();
+    let y = xx.max(0.0).powf(exponent);
+    let y = if a > 0.5 { 1.0 - y } else { y };
+    (min + y.clamp(0.0, 1.0) * (max - min)).clamp(min.min(max), min.max(max))
+}
+
+/// Blender's `Map Range` with smootherstep interpolation, clamped.
+pub fn smootherstep(edge0: f32, edge1: f32, x: f32) -> f32 {
+    let t = if (edge1 - edge0).abs() > 1e-12 {
+        ((x - edge0) / (edge1 - edge0)).clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
+}
+
+/// Blender's `Map Range` with smoothstep interpolation, clamped.
+pub fn smoothstep(edge0: f32, edge1: f32, x: f32) -> f32 {
+    let t = if (edge1 - edge0).abs() > 1e-12 {
+        ((x - edge0) / (edge1 - edge0)).clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    t * t * (3.0 - 2.0 * t)
+}
+
+/// Which strand leads each strand's clump: `Create Guide Index Map`.
+///
+/// The node group scatters the roots, keeps each with probability `mask`,
+/// merges them by `distance` -- what is left are the clump guides, spaced at
+/// least that far apart -- and gives every strand the index of the guide
+/// nearest its root, within its parting group. A distance of zero makes
+/// every strand its own guide.
+#[derive(Clone, Debug)]
+pub struct GuideMap {
+    /// For each strand, its guide's strand index.
+    pub guide: Vec<u32>,
+    /// The guides, in the order they were chosen.
+    pub guides: Vec<u32>,
+}
+
+impl GuideMap {
+    pub fn new(strands: &Strands, distance: f32, mask: f32, seed: u32) -> Self {
+        let n = strands.len();
+        if distance <= 0.0 || n == 0 {
+            return Self {
+                guide: (0..n as u32).collect(),
+                guides: (0..n as u32).collect(),
+            };
+        }
+        // Candidates in a random order; each kept with probability `mask`.
+        let mut order: Vec<u32> = (0..n as u32).collect();
+        order.sort_by_key(|&s| rng::hash(strands.id[s as usize].word(), seed));
+        let mut grid = PointGrid::new(distance);
+        let mut guides = Vec::new();
+        for &s in &order {
+            if rng::unit(strands.id[s as usize].word(), seed ^ 0x2F0B_1A3D) >= mask {
+                continue;
+            }
+            let root = strands.root(s as usize);
+            let group = strands.group[s as usize];
+            if !grid.any_within(root, distance, |g| g == group) {
+                grid.insert(root, group);
+                guides.push(s);
+            }
+        }
+        if guides.is_empty() {
+            let s = order[0];
+            grid.insert(strands.root(s as usize), strands.group[s as usize]);
+            guides.push(s);
+        }
+        let guide = (0..n)
+            .into_par_iter()
+            .map(|s| {
+                let root = strands.root(s);
+                let group = strands.group[s];
+                let nearest = grid
+                    .nearest(root, distance * 8.0, |g| g == group)
+                    .or_else(|| grid.nearest(root, f32::INFINITY, |_| true));
+                nearest.map_or(s as u32, |(i, _)| guides[i as usize])
+            })
+            .collect();
+        Self { guide, guides }
+    }
+
+    /// The guide map `strands` carry from an earlier operation, if asked to
+    /// reuse it and there is one; otherwise a new one, which the strands
+    /// then carry (Blender stores it as `guide_curve_index`).
+    pub fn get(strands: &mut Strands, reuse: bool, distance: f32, mask: f32, seed: u32) -> Self {
+        if reuse && let Some(map) = &strands.guide_map {
+            return map.clone();
+        }
+        let map = Self::new(strands, distance, mask, seed);
+        strands.guide_map = Some(map.clone());
+        map
+    }
+
+    /// A sampler for every guide, indexed by strand (only guides filled).
+    pub fn samplers(&self, strands: &Strands) -> Vec<Option<CurveSampler>> {
+        let mut is_guide = vec![false; strands.len()];
+        for &g in &self.guides {
+            is_guide[g as usize] = true;
+        }
+        (0..strands.len())
+            .into_par_iter()
+            .map(|s| is_guide[s].then(|| CurveSampler::new(strands.strand(s))))
+            .collect()
+    }
+}
+
+/// `Restore Curve Segment Length`: keep each segment's current direction
+/// and give it back (by `factor`) the length it has in `reference`, walking
+/// out from the root.
+pub fn restore_lengths(strand: &mut [Vec3], reference: &[Vec3], factor: f32) {
+    let mut previous = strand[0];
+    let mut previous_old = strand[0];
+    for i in 1..strand.len() {
+        let current = strand[i];
+        let direction = current - previous_old;
+        let current_length = direction.length();
+        let rest = (reference[i] - reference[i - 1]).length();
+        let length = current_length + (rest - current_length) * factor;
+        let direction = if current_length > 1e-12 {
+            direction * (1.0 / current_length)
+        } else {
+            (reference[i] - reference[i - 1]).normalize()
+        };
+        previous_old = current;
+        strand[i] = previous + direction * length;
+        previous = strand[i];
+    }
+}
+
+/// Per point: its factor along the strand (arc length over total) and its
+/// arc length.
+pub(crate) fn parameters(strand: &[Vec3], lengths: &mut Vec<f32>, factors: &mut Vec<f32>) {
+    crate::strands::arc_lengths(strand, lengths);
+    let total = lengths.last().copied().unwrap_or(0.0).max(1e-12);
+    factors.clear();
+    factors.extend(lengths.iter().map(|l| l / total));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn shape_range_spans_constant_linear_and_late() {
+        assert_eq!(shape_range(0.3, 0.0, 1.0, 0.0, 2.0), 1.0);
+        for x in [0.0, 0.25, 0.5, 1.0] {
+            assert!((shape_range(x, 0.0, 1.0, 0.5, 2.0) - x).abs() < 1e-4);
+        }
+        // Towards 1 the effect waits for the end.
+        assert!(shape_range(0.5, 0.0, 1.0, 0.95, 2.0) < 0.1);
+        assert!(shape_range(1.0, 0.0, 1.0, 0.95, 2.0) > 0.99);
+        // Small shapes act early.
+        assert!(shape_range(0.2, 0.0, 1.0, 0.1, 2.0) > 0.7);
+    }
+
+    #[test]
+    fn restoring_lengths_undoes_a_stretch() {
+        let reference: Vec<Vec3> = (0..5).map(|i| Vec3::new(0.0, i as f32, 0.0)).collect();
+        let mut stretched: Vec<Vec3> = reference.iter().map(|p| *p * 1.5).collect();
+        restore_lengths(&mut stretched, &reference, 1.0);
+        for (a, b) in stretched.iter().zip(&reference) {
+            assert!((*a - *b).length() < 1e-5);
+        }
+    }
+}
--- before/crates/fabelgeist-hair/src/ops/orient.rs
+++ after/crates/fabelgeist-hair/src/ops/orient.rs
@@ -0,0 +1,129 @@
+//! Each strand's root turned the way its own follicle points.
+//!
+//! Not one of DiffLocks' node groups. Guides are a few centimetres apart
+//! and interpolation blends their shapes, so a growth pattern finer than
+//! that -- the turn of a crown whorl, a cowlick -- is lost between them, and
+//! every strand near a guide leaves the scalp at its guide's angle. This
+//! turns the first `memory` metres of every strand, about its root's normal,
+//! from the way it leaves to the way the growth pattern points there (and
+//! each strand a little off that, and up or down, as follicles are),
+//! fading out along the strand so that past the memory it lies as it did.
+//! Where the turn is large -- hair combed against its growth -- the root
+//! lifts, as a cowlick does.
+
+use fabelgeist_math::Vec3;
+use rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::follicles::GrowthField;
+use crate::rng;
+use crate::strands::{Strands, rotate, safe_normalize};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Orient {
+    /// Which way the follicles point.
+    pub field: GrowthField,
+    /// How far along a strand its follicle's direction holds, metres.
+    pub memory: f32,
+    /// How far each strand's direction and angle stray, radians.
+    pub direction_spread: f32,
+    pub angle_spread: f32,
+    pub seed: i32,
+}
+
+impl Orient {
+    pub fn apply(&self, strands: &mut Strands) {
+        if self.memory <= 0.0 {
+            return;
+        }
+        let points = strands.points;
+        let (ids, normals) = (&strands.id, &strands.root_normal);
+        let seed = rng::seed(self.seed, 0x0F0C);
+        strands
+            .positions
+            .par_chunks_mut(points)
+            .enumerate()
+            .for_each(|(s, strand)| {
+                let root = strand[0];
+                let n = safe_normalize(normals[s], Vec3::up());
+                // The way the strand leaves: its first few millimetres, in
+                // the scalp's plane.
+                let Some(ahead) = strand.iter().find(|p| (**p - root).length() > 0.002) else {
+                    return;
+                };
+                let leaves = *ahead - root;
+                let flat = leaves - n * leaves.dot(n);
+                let grows = self.field.direction(root, n);
+                // Strands standing straight up have no way to turn from.
+                let turn = if flat.length() > 0.25 * leaves.length() {
+                    let flat = flat.normalize();
+                    n.dot(flat.cross(grows)).atan2(flat.dot(grows))
+                } else {
+                    0.0
+                } + self.direction_spread * rng::signed((ids[s]).word(), seed);
+                let tilt = self.angle_spread * rng::signed((ids[s]).word(), seed ^ 0x7117);
+                let tilt_axis = safe_normalize(grows.cross(n), crate::strands::orthogonal(n));
+                // A root turned right round stands up.
+                let lift = (1.0 - turn.cos()) * 0.5 * self.memory * 0.35;
+                let mut along = 0.0;
+                let mut previous = root;
+                for p in strand.iter_mut().skip(1) {
+                    along += (*p - previous).length();
+                    previous = *p;
+                    let share = 1.0 - crate::ops::smoothstep(0.0, self.memory, along);
+                    if share <= 0.0 {
+                        break;
+                    }
+                    let mut offset = rotate(*p - root, n, turn * share);
+                    offset = rotate(offset, tilt_axis, -tilt * share);
+                    let rise = lift * crate::ops::smoothstep(0.0, self.memory, along) * share * 4.0;
+                    *p = root + offset + n * rise;
+                }
+            });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::follicles::{Follicles, Growth};
+    use crate::head::Head;
+    use crate::strands::Attachment;
+
+    #[test]
+    fn a_short_strand_turns_to_its_follicle_and_a_long_one_keeps_its_course() {
+        let head = Head::mannequin();
+        let field = Follicles {
+            growth: Growth::Forward,
+            ..Default::default()
+        }
+        .field(&head);
+        let root = head.crown();
+        let n = head.gradient(root);
+        // Combed back along the top, 5 cm.
+        let mut strands = Strands::new(26);
+        let positions: Vec<Vec3> = (0..26)
+            .map(|j| root + Vec3::new(0.0, 0.001, -0.002 * j as f32))
+            .collect();
+        strands.push(
+            &positions,
+            Attachment {
+                normal: n,
+                ..Default::default()
+            },
+        );
+        Orient {
+            field,
+            memory: 0.01,
+            direction_spread: 0.0,
+            angle_spread: 0.0,
+            seed: 1,
+        }
+        .apply(&mut strands);
+        let strand = strands.strand(0);
+        // It leaves forward, as the follicle grows; past the memory it is
+        // where it was.
+        assert!((strand[1] - strand[0]).z > 0.0, "{}", strand[1] - strand[0]);
+        assert_eq!(strand[25], positions[25]);
+    }
+}
--- before/crates/fabelgeist-hair/src/ops/settle.rs
+++ after/crates/fabelgeist-hair/src/ops/settle.rs
@@ -0,0 +1,256 @@
+//! The drape: how gravity and wind change a groom.
+//!
+//! DiffLocks' last step runs Blender's cloth simulation on the strands, with
+//! the wind's direction and gravity's strength drawn at random, so that
+//! samples of one style hang and blow differently. A dynamic simulation run
+//! for a fixed number of steps is neither settled nor faithful to the
+//! style; here each strand is solved to static equilibrium as an elastic
+//! rod, and the drape is what *changes* between conditions.
+//!
+//! **The rod.** A strand is a chain of segments whose joints resist
+//! bending away from the groomed shape. At each joint, the load of all the
+//! hair beyond it -- gravity plus wind, as an acceleration -- makes a
+//! moment `M`; the joint bends by `M l / (g L_g^3)` towards the load, where
+//! `L_g` is the strand's gravity length (the length at which hair bends
+//! under its own weight: about 5 cm for a single strand, more for a lock).
+//! No joint bends past the load's direction. Moments come from suffix sums,
+//! so a sweep is linear in the points; sweeps are repeated, relaxed, with
+//! the body pushed out after each, until the strand is still.
+//!
+//! **The difference.** A groom is the shape hair has under ordinary
+//! gravity. Solving it under the reference conditions and under the asked
+//! ones, and adding the difference to the groom, leaves it unchanged at 9.81
+//! m/s^2 and no wind, lifts it in weaker gravity, and blows it in wind --
+//! without ever sagging a style into something it was not.
+
+use fabelgeist_math::Vec3;
+use rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::collider::{Collider, push_out};
+use crate::ops::{Context, restore_lengths};
+use crate::strands::{Strands, rotate, safe_normalize, transport};
+
+/// Standard gravity: the conditions a groom is shaped under.
+pub const STANDARD_GRAVITY: f32 = 9.81;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Settle {
+    /// Metres per second squared, down.
+    pub gravity: f32,
+    /// Acceleration, metres per second squared.
+    pub wind: [f32; 3],
+    /// Gravity length `L_g`, metres: how long a strand bears its own
+    /// weight.
+    pub stiffness: f32,
+    /// Sweeps to equilibrium.
+    pub iterations: usize,
+    /// Metres kept off the body.
+    pub collision_offset: f32,
+    /// Apply the change from standard gravity and no wind (true), or solve
+    /// the groom as a rest shape under the conditions outright (false).
+    pub relative: bool,
+}
+
+impl Default for Settle {
+    fn default() -> Self {
+        Self {
+            gravity: STANDARD_GRAVITY,
+            wind: [0.0; 3],
+            stiffness: 0.06,
+            iterations: 60,
+            collision_offset: 0.003,
+            relative: true,
+        }
+    }
+}
+
+impl Settle {
+    pub fn apply(&self, strands: &mut Strands, context: &Context) {
+        let points = strands.points;
+        let collider = context.collider;
+        let load = Vec3::new(0.0, -self.gravity, 0.0) + Vec3::from_array(self.wind);
+        let reference = Vec3::new(0.0, -STANDARD_GRAVITY, 0.0);
+        if self.relative && (load - reference).length() < 1e-4 {
+            return;
+        }
+        strands.positions.par_chunks_mut(points).for_each(|strand| {
+            let groom = strand.to_vec();
+            let under = solve(&groom, load, self, collider);
+            if self.relative {
+                let base = solve(&groom, reference, self, collider);
+                for ((p, a), b) in strand.iter_mut().zip(&under).zip(&base) {
+                    *p += *a - *b;
+                }
+                restore_lengths(strand, &groom, 1.0);
+                for p in strand.iter_mut().skip(1) {
+                    *p = push_out(collider, *p, self.collision_offset * 0.5);
+                }
+            } else {
+                strand.copy_from_slice(&under);
+            }
+        });
+    }
+}
+
+impl Settle {
+    /// The equilibrium of the strand `rest` under `load` (an acceleration),
+    /// rooted at its first point and held up by `collider`: how a strand of
+    /// that shape hangs on that body. Draping one groom on two bodies under
+    /// the same load, the difference is how the second body moves it.
+    pub fn equilibrium(&self, rest: &[Vec3], load: Vec3, collider: &dyn Collider) -> Vec<Vec3> {
+        solve(rest, load, self, collider)
+    }
+}
+
+/// The equilibrium of `rest` as an elastic rod under `load` (an
+/// acceleration), rooted at its first point.
+fn solve(rest: &[Vec3], load: Vec3, settings: &Settle, collider: &dyn Collider) -> Vec<Vec3> {
+    let n = rest.len();
+    let segments = n - 1;
+    let lengths: Vec<f32> = rest.windows(2).map(|w| (w[1] - w[0]).length()).collect();
+    let rest_dirs: Vec<Vec3> = rest
+        .windows(2)
+        .map(|w| safe_normalize(w[1] - w[0], Vec3::down()))
+        .collect();
+    let magnitude = load.length();
+    if magnitude < 1e-6 {
+        return rest.to_vec();
+    }
+    let force = load * (1.0 / magnitude);
+    // Joint compliance: bend per unit moment per unit length.
+    let compliance = 1.0 / (STANDARD_GRAVITY * settings.stiffness.max(1e-3).powi(3));
+
+    let mut dirs = rest_dirs.clone();
+    let mut points = rest.to_vec();
+    let mut moment_arm_sum = vec![Vec3::default(); segments + 1];
+    let mut length_sum = vec![0.0f32; segments + 1];
+    for _ in 0..settings.iterations {
+        // Suffix sums of each segment's centre times its length, and of the
+        // lengths: the moment about point i of the load on everything past
+        // it is (sum c_j l_j - x_i sum l_j) x load.
+        moment_arm_sum[segments] = Vec3::default();
+        length_sum[segments] = 0.0;
+        for j in (0..segments).rev() {
+            let centre = (points[j] + points[j + 1]) * 0.5;
+            moment_arm_sum[j] = moment_arm_sum[j + 1] + centre * lengths[j];
+            length_sum[j] = length_sum[j + 1] + lengths[j];
+        }
+        // Root to tip: each joint bends from its groomed angle -- carried
+        // along as its parent turned -- towards the load.
+        let mut position = points[0];
+        for i in 0..segments {
+            let groomed = if i == 0 {
+                rest_dirs[0]
+            } else {
+                transport(rest_dirs[i], rest_dirs[i - 1], dirs[i - 1])
+            };
+            let moment = (moment_arm_sum[i] - points[i] * length_sum[i]).cross(load);
+            let torque = moment.length();
+            let mut target = groomed;
+            if torque > 1e-12 {
+                let axis = groomed.cross(force);
+                let sin = axis.length();
+                if sin > 1e-6 {
+                    let limit = sin.atan2(groomed.dot(force));
+                    let bend = (torque * compliance * lengths[i]).min(limit);
+                    target = rotate(groomed, axis * (1.0 / sin), bend);
+                }
+            }
+            let d = safe_normalize(dirs[i].lerp(target, 0.5), target);
+            let mut next = position + d * lengths[i];
+            // The body holds the hair up.
+            if collider.distance(next) < settings.collision_offset {
+                next = push_out(collider, next, settings.collision_offset);
+                next = position + safe_normalize(next - position, d) * lengths[i];
+            }
+            dirs[i] = safe_normalize(next - position, d);
+            points[i + 1] = next;
+            position = next;
+        }
+    }
+    points
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::collider::NoCollider;
+    use crate::strands::Attachment;
+    use crate::surface::Surface;
+
+    fn horizontal(length: f32) -> Strands {
+        let mut strands = Strands::new(40);
+        let positions: Vec<Vec3> = (0..40)
+            .map(|j| Vec3::new(j as f32 * length / 39.0, 0.0, 0.0))
+            .collect();
+        strands.push(&positions, Attachment::default());
+        strands
+    }
+
+    fn scalp() -> Surface {
+        Surface::new(
+            vec![Vec3::default(), Vec3::right(), Vec3::forward()],
+            None,
+            None,
+            vec![[0, 1, 2]],
+        )
+    }
+
+    #[test]
+    fn standard_gravity_leaves_the_groom_alone() {
+        let mut strands = horizontal(0.3);
+        let before = strands.clone();
+        let scalp = scalp();
+        let context = Context {
+            scalp: &scalp,
+            collider: &NoCollider,
+        };
+        Settle::default().apply(&mut strands, &context);
+        assert_eq!(strands.positions, before.positions);
+    }
+
+    #[test]
+    fn long_hair_sags_short_hair_holds() {
+        let scalp = scalp();
+        let context = Context {
+            scalp: &scalp,
+            collider: &NoCollider,
+        };
+        let absolute = Settle {
+            relative: false,
+            ..Default::default()
+        };
+        let mut long = horizontal(0.4);
+        absolute.apply(&mut long, &context);
+        let mut short = horizontal(0.02);
+        absolute.apply(&mut short, &context);
+        let long_tip = long.strand(0)[39];
+        let short_tip = short.strand(0)[39];
+        assert!(long_tip.y < -0.3, "{long_tip}");
+        assert!(short_tip.y > -0.002, "{short_tip}");
+        for w in long.strand(0).windows(2) {
+            assert!(((w[1] - w[0]).length() - 0.4 / 39.0).abs() < 1e-4);
+        }
+    }
+
+    #[test]
+    fn wind_blows_hair_along_it() {
+        let scalp = scalp();
+        let context = Context {
+            scalp: &scalp,
+            collider: &NoCollider,
+        };
+        let mut strands = Strands::new(30);
+        let hanging: Vec<Vec3> = (0..30)
+            .map(|j| Vec3::new(0.0, -(j as f32) * 0.01, 0.0))
+            .collect();
+        strands.push(&hanging, Attachment::default());
+        Settle {
+            wind: [0.0, 0.0, 5.0],
+            ..Default::default()
+        }
+        .apply(&mut strands, &context);
+        assert!(strands.strand(0)[29].z > 0.05, "{}", strands.strand(0)[29]);
+    }
+}
--- before/crates/fabelgeist-hair/src/ops/shrinkwrap.rs
+++ after/crates/fabelgeist-hair/src/ops/shrinkwrap.rs
@@ -0,0 +1,99 @@
+//! `Shrinkwrap Hair Curves`: out of the body.
+//!
+//! Every point that has sunk below the surface -- or lies closer to it than
+//! `Offset Distance` -- is moved to the surface plus that offset along the
+//! outward direction: fully when below, fading to `Above Surface` of the
+//! way at the offset distance. The moves are blurred along each strand
+//! (`Smoothing Steps`) so that a strand bends around the body rather than
+//! kinking at it, and mixed in by `Factor`. `Lock Roots` keeps roots on the
+//! scalp. DiffLocks applies it "at various stages in the pipeline"; after
+//! the noise that pushes strands into the head, and after the drape.
+
+use rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::collider::push_out;
+use crate::ops::{Context, restore_lengths};
+use crate::strands::{Strands, blur};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Shrinkwrap {
+    pub factor: f32,
+    /// Metres off the surface.
+    pub offset: f32,
+    /// How much of the way points at the offset distance still move.
+    pub above_surface: f32,
+    pub smoothing: usize,
+    pub lock_roots: bool,
+    pub preserve_length: bool,
+}
+
+impl Default for Shrinkwrap {
+    fn default() -> Self {
+        Self {
+            factor: 1.0,
+            offset: 0.002,
+            above_surface: 0.5,
+            smoothing: 2,
+            lock_roots: true,
+            preserve_length: false,
+        }
+    }
+}
+
+impl Shrinkwrap {
+    pub fn apply(&self, strands: &mut Strands, context: &Context) {
+        let points = strands.points;
+        let collider = context.collider;
+        let offset = self.offset.max(1e-10);
+        let reference = self.preserve_length.then(|| strands.positions.clone());
+        strands
+            .positions
+            .par_chunks_mut(points)
+            .enumerate()
+            .for_each_init(
+                || (Vec::new(), Vec::new()),
+                |(moves, weights), (s, strand)| {
+                    moves.clear();
+                    weights.clear();
+                    let mut any = false;
+                    for (j, &p) in strand.iter().enumerate() {
+                        let locked = j == 0 && self.lock_roots;
+                        let (distance, out) = collider.query(p);
+                        let weight = if locked || distance >= offset {
+                            0.0
+                        } else if distance < 0.0 {
+                            1.0
+                        } else {
+                            1.0 + (self.above_surface - 1.0) * (distance / offset)
+                        };
+                        let target = p + out * (offset - distance);
+                        moves.push((target - p) * weight);
+                        weights.push(if locked { 0.0 } else { 1.0 });
+                        any |= weight > 0.0;
+                    }
+                    if !any {
+                        return;
+                    }
+                    if self.smoothing > 0 {
+                        blur(moves, self.smoothing, weights);
+                    }
+                    for (p, m) in strand.iter_mut().zip(moves.iter()) {
+                        *p += *m * self.factor;
+                    }
+                    if let Some(reference) = &reference {
+                        restore_lengths(strand, &reference[s * points..(s + 1) * points], 1.0);
+                    }
+                    // Blurring spreads a deep point's push over its
+                    // neighbours, and restoring lengths can dip a point back
+                    // in: whatever is still below the surface goes straight
+                    // out, unsmoothed.
+                    if self.factor >= 1.0 {
+                        for p in strand.iter_mut().skip(1) {
+                            *p = push_out(collider, *p, self.offset * 0.5);
+                        }
+                    }
+                },
+            );
+    }
+}
--- before/crates/fabelgeist-hair/src/ops/trim.rs
+++ after/crates/fabelgeist-hair/src/ops/trim.rs
@@ -0,0 +1,81 @@
+//! Length variation: `Trim Hair Curves`.
+//!
+//! A groomed style's strands are not all the length their guides were: a
+//! haircut layers them, and loose ones are shorter. Each strand keeps the
+//! first share of its arc length -- `length`, less up to `random` of it at
+//! random, never more than `max_length` metres -- resampled over its same
+//! number of points.
+
+use rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::rng;
+use crate::strands::{Strands, arc_lengths, resample_into};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Trim {
+    /// Share of each strand's length kept.
+    pub length: f32,
+    /// Up to this share of that is taken off at random.
+    pub random: f32,
+    /// No strand longer than this, metres (0: no limit).
+    pub max_length: f32,
+    pub seed: i32,
+}
+
+impl Default for Trim {
+    fn default() -> Self {
+        Self {
+            length: 1.0,
+            random: 0.2,
+            max_length: 0.0,
+            seed: 0,
+        }
+    }
+}
+
+impl Trim {
+    pub fn apply(&self, strands: &mut Strands) {
+        let seed = rng::seed(self.seed, 77_221);
+        let points = strands.points;
+        let ids = &strands.id;
+        strands
+            .positions
+            .par_chunks_mut(points)
+            .enumerate()
+            .for_each_init(
+                || (Vec::new(), Vec::new(), Vec::new()),
+                |(lengths, cut, scratch), (s, strand)| {
+                    arc_lengths(strand, lengths);
+                    let total = *lengths.last().unwrap_or(&0.0);
+                    if total <= 0.0 {
+                        return;
+                    }
+                    let mut keep = total
+                        * (self.length * (1.0 - self.random * rng::unit((ids[s]).word(), seed)))
+                            .clamp(0.02, 1.0);
+                    if self.max_length > 0.0 {
+                        keep = keep.min(self.max_length);
+                    }
+                    if keep >= total * 0.9999 {
+                        return;
+                    }
+                    // The points up to `keep`, the last one cut to length.
+                    cut.clear();
+                    for j in 0..points {
+                        if lengths[j] >= keep {
+                            let previous = lengths[j - 1];
+                            let t = (keep - previous) / (lengths[j] - previous).max(1e-12);
+                            cut.push(strand[j - 1].lerp(strand[j], t));
+                            break;
+                        }
+                        cut.push(strand[j]);
+                    }
+                    if cut.len() < 2 {
+                        return;
+                    }
+                    resample_into(cut, scratch, strand);
+                },
+            );
+    }
+}
