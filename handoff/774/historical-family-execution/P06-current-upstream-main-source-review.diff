+++ after/crates/adventuresim-character-creator/src/hair/gpu/bake/mod.rs
@@ -0,0 +1,448 @@
+//! The scalp's textures: the hair lying on it, baked from the groom on the
+//! GPU.
+//!
+//! Painted one flat colour, the scalp shows between cards and strands as a
+//! smooth, dead patch. Over a real scalp the eye meets the hair nearest it --
+//! strands lying along the skin in the groom's own direction, parted where
+//! the groom parts and spiralling out of its whorl. Each strand's first few
+//! millimetres off the skin are drawn into the scalp's texture
+//! ([`ScalpMap`]) on the bust the hair grew on, the topmost strand over each
+//! texel showing: lighter the further it lies off the skin, darker where it
+//! meets it, and running the way it runs, so the scalp is shaded as the
+//! strands are. Single strands are far finer than a pixel at any distance
+//! the head is seen from, so what shows is locks: strands rooted together
+//! share a tone, lighter or darker than the next lock, and differ a little
+//! among themselves.
+//!
+//! Where no strand lies, the scalp is either in the shadow of hair standing
+//! further off it -- between an afro's coils, below the coils further out --
+//! or bare: at a parting, at a whorl's eye, along a thinning hairline. How
+//! bare the scalp is round each texel, over a couple of millimetres and
+//! weighted to the nearest, makes the texel clear in the texture's alpha, so
+//! the skin beneath the cap shows there, lit as the rest of the body: hair
+//! thins into a parting over those millimetres, as it does at a real one,
+//! its last strands lying over the skin, while a texel or two between coils
+//! shows no skin at all. Shadowed scalp is the hair's colour in shade.
+//!
+//! Every strand draws itself, an invocation each, keeping the topmost strand
+//! over each texel with an atomic maximum: its height off the skin first in
+//! the packed value, then its direction and shade. Then each texel finds
+//! whether it is bare, the bare share is blurred, the textures are written,
+//! and each smaller mip level is averaged from the one before.
+
+use std::sync::Arc;
+
+use anyhow::Result;
+use fabelgeist_compute::{Kernel, KernelBatch};
+use fabelgeist_gpu::prelude::Buffer;
+use fabelgeist_hair::Head;
+use fabelgeist_hair::gpu::wgsl::common::{HEAD, MATH};
+use fabelgeist_hair::gpu::{GpuGroom, head_shape};
+
+use super::{HairGpu, KernelSource, params, storage, upload};
+use wgsl::{BARE, BLUR, DRAW, FINISH, HALVE, LONGEST, PACKING};
+
+mod wgsl;
+use crate::hair::AtlasLevel;
+use crate::hair::scalp_map::ScalpMap;
+
+/// The texture's side, texels: about an eighth of a millimetre a texel,
+/// near a hair's own width, so lying strands read as lines and a parting's
+/// edge as strands' ends.
+const SIZE: u32 = 2048;
+/// The longest step along a strand mapped as straight, metres: the map
+/// curves, and a strand drawn straight between points a centimetre apart
+/// would cut its corners.
+const STEP: f32 = 0.002;
+/// How far off the skin a strand is drawn, metres: the layer of hair the
+/// eye meets between cards.
+const REACH: f32 = 0.008;
+/// A strand's shade where it meets the skin, and at [`REACH`] off it, as a
+/// share of the hair's colour.
+const AT_SKIN: f32 = 0.25;
+const AT_REACH: f32 = 0.9;
+/// How much darker a lock may be than the lightest, and a strand than the
+/// rest of its lock.
+const LOCK_SPREAD: f32 = 0.5;
+const STRAND_SPREAD: f32 = 0.15;
+/// About how wide a lock is, metres: the cell of the noise its tone is
+/// drawn from, by where its strands are rooted.
+const LOCK_WIDTH: f32 = 0.004;
+/// How far off the skin hair still shadows it, metres: hair this near
+/// over a texel no strand lies on keeps it from showing bare.
+const SHADOW_REACH: f32 = 0.025;
+/// The side of the blocks shadowing is judged over, metres: one strand
+/// passing over a block shadows all of it, as hair further off the skin
+/// shadows more than the line of its own width.
+const SHADOW_BLOCK: f32 = 0.0015;
+/// How far round each texel the bare scalp is measured, metres, twice over
+/// so the nearest counts most: hair thins into a parting over about twice
+/// this.
+const BARE_REACH: f32 = 0.0008;
+/// The share of bare scalp round a texel at which skin starts to show
+/// there, and shows fully: most of a parting is bare, the gaps within and
+/// between an afro's coils single texels among strands.
+const BARE_START: f32 = 0.1;
+const BARE_FULL: f32 = 0.75;
+/// How much of a strand still shows where the scalp round it is bare: at
+/// a parting the hair thins strand by strand, the last strands' ends lying
+/// over the skin, rather than fading as a whole.
+const STRAND_OVER_SKIN: f32 = 0.5;
+/// The scalp's shade where no strand lies on it but hair lies over it.
+const SHADOWED: f32 = 0.35;
+/// Bytes of a texel.
+const TEXEL_BYTES: u64 = 4;
+
+/// The hair lying on the scalp, each a mip chain, largest first, over the
+/// cap's texture coordinates.
+pub struct ScalpTexture {
+    /// The scalp's shade as grey, as a share of the hair's colour, and
+    /// whether hair covers it as alpha.
+    pub shade: Vec<AtlasLevel>,
+    /// The direction the topmost strand runs across the texture, along `u`
+    /// and `v`, each from 0 backwards to 1 forwards (a half each where no
+    /// strand lies), and the shade again.
+    pub strands: Vec<AtlasLevel>,
+}
+
+/// The scalp's textures on the GPU: every mip level, largest first, one
+/// after another ([`levels`]), four bytes a texel.
+pub struct GpuScalpTexture {
+    shade: Buffer,
+    strands: Buffer,
+}
+
+/// The bake's kernels.
+pub(super) struct BakeKernels {
+    draw: Arc<Kernel>,
+    bare: Arc<Kernel>,
+    blur: Arc<Kernel>,
+    finish: Arc<Kernel>,
+    halve: Arc<Kernel>,
+    longest: Arc<Kernel>,
+}
+
+impl BakeKernels {
+    pub(super) fn new(source: &KernelSource) -> Result<Self> {
+        Ok(Self {
+            draw: source.compile(&format!("{DRAW}{MATH}{HEAD}{PACKING}"))?,
+            bare: source.compile(BARE)?,
+            blur: source.compile(BLUR)?,
+            finish: source.compile(&format!("{FINISH}{PACKING}"))?,
+            halve: source.compile(HALVE)?,
+            longest: source.compile(LONGEST)?,
+        })
+    }
+}
+
+/// One mip level's place in the chain: its side, texels; how far apart its
+/// rows start, texels, padded so a row is a whole number of the 256 bytes a
+/// copy into a texture moves rows in; and where it starts, texels in.
+#[derive(Clone, Copy, Debug)]
+pub struct Level {
+    pub side: u32,
+    pub stride: u32,
+    pub offset: u32,
+}
+
+/// Texels in a row a copy into a texture moves rows in multiples of.
+const ROW_TEXELS: u32 = 64;
+
+/// Every mip level of the texture, largest first.
+pub fn levels() -> Vec<Level> {
+    let mut levels = Vec::new();
+    let (mut side, mut offset) = (SIZE, 0);
+    loop {
+        let stride = side.max(ROW_TEXELS);
+        levels.push(Level {
+            side,
+            stride,
+            offset,
+        });
+        if side == 1 {
+            return levels;
+        }
+        offset += stride * side;
+        side /= 2;
+    }
+}
+
+impl GpuScalpTexture {
+    /// `groom`, grown on `bust`, baked into textures mapped by `map`.
+    pub(in crate::hair) fn bake(
+        gpu: &HairGpu,
+        groom: &GpuGroom,
+        bust: &Head,
+        map: &ScalpMap,
+    ) -> Result<Self> {
+        let context = gpu.context();
+        let texel = map.texel(SIZE as usize);
+        let block_side = ((SHADOW_BLOCK / texel).round() as u32).max(1);
+        let blocks = SIZE.div_ceil(block_side);
+        let bare_reach = ((BARE_REACH / texel).round() as u32).max(1);
+        let texels = u64::from(SIZE) * u64::from(SIZE);
+        let chain: u64 = levels()
+            .iter()
+            .map(|level| u64::from(level.stride) * u64::from(level.side))
+            .sum();
+        let topmost = storage(context, texels * TEXEL_BYTES, "hair scalp topmost")?;
+        let shadowed = storage(
+            context,
+            u64::from(blocks * blocks) * TEXEL_BYTES,
+            "hair scalp shadowed",
+        )?;
+        let bare = [
+            storage(context, texels * TEXEL_BYTES, "hair scalp bare")?,
+            storage(context, texels * TEXEL_BYTES, "hair scalp bare, blurred")?,
+        ];
+        let baked = Self {
+            shade: storage(context, chain * TEXEL_BYTES, "hair scalp shade")?,
+            strands: storage(context, chain * TEXEL_BYTES, "hair scalp strands")?,
+        };
+        let mut batch = KernelBatch::labelled(context, "hair scalp bake");
+        batch.encoder().clear_buffer(&topmost.buffer, 0, None);
+        batch.encoder().clear_buffer(&shadowed.buffer, 0, None);
+        let grid = Grid {
+            block_side,
+            blocks,
+            bare_reach,
+        };
+        grid.draw(gpu, &mut batch, groom, bust, map, [&topmost, &shadowed])?;
+        grid.bare(gpu, &mut batch, [&topmost, &shadowed], &bare)?;
+        baked.finish(gpu, &mut batch, &topmost, &bare[0])?;
+        batch.submit();
+        Ok(baked)
+    }
+
+    /// The shade texture's chain: shade as grey, coverage as alpha.
+    pub fn shade(&self) -> &Buffer {
+        &self.shade
+    }
+
+    /// The strands texture's chain: the way each runs, and its shade.
+    pub fn strands(&self) -> &Buffer {
+        &self.strands
+    }
+
+    /// The textures back on the host.
+    pub fn read(&self, gpu: &HairGpu) -> Result<ScalpTexture> {
+        let context = gpu.context();
+        let chain = |buffer: &Buffer| -> Result<Vec<AtlasLevel>> {
+            let texels: Vec<u32> = pollster::block_on(buffer.read(context))?;
+            let bytes: &[u8] = bytemuck::cast_slice(&texels);
+            Ok(levels()
+                .into_iter()
+                .map(|level| {
+                    let texel = TEXEL_BYTES as usize;
+                    let rgba = (0..level.side as usize)
+                        .flat_map(|row| {
+                            let start =
+                                (level.offset as usize + row * level.stride as usize) * texel;
+                            bytes[start..start + level.side as usize * texel]
+                                .iter()
+                                .copied()
+                        })
+                        .collect();
+                    AtlasLevel {
+                        width: level.side,
+                        height: level.side,
+                        rgba,
+                    }
+                })
+                .collect())
+        };
+        Ok(ScalpTexture {
+            shade: chain(&self.shade)?,
+            strands: chain(&self.strands)?,
+        })
+    }
+}
+
+/// How the bake's grid is judged: the side of the blocks shadowing is
+/// judged over, how many a row, and how far bare scalp is measured, texels.
+struct Grid {
+    block_side: u32,
+    blocks: u32,
+    bare_reach: u32,
+}
+
+impl Grid {
+    /// Record every strand of `groom`, grown on `bust`, drawn into
+    /// `topmost`, or marking the blocks it shadows.
+    fn draw(
+        &self,
+        gpu: &HairGpu,
+        batch: &mut KernelBatch<'_>,
+        groom: &GpuGroom,
+        bust: &Head,
+        map: &ScalpMap,
+        [topmost, shadowed]: [&Buffer; 2],
+    ) -> Result<()> {
+        let context = gpu.context();
+        let kernels = &gpu.bake;
+        let [center, axis, forward, side] = [map.center, map.axis, map.forward, map.side];
+        let (block_side, blocks) = (self.block_side, self.blocks);
+        batch.dispatch_folded(
+            &kernels.draw,
+            &params! {
+                "positions" => groom.positions.clone(),
+                "strands" => groom.attributes.clone(),
+                "head_shape" => upload(context, &head_shape(bust), "hair bust shape")?,
+                "topmost" => topmost.clone(),
+                "shadowed" => shadowed.clone(),
+                "center_x" => center.x,
+                "center_y" => center.y,
+                "center_z" => center.z,
+                "rim" => map.rim,
+                "axis_x" => axis.x,
+                "axis_y" => axis.y,
+                "axis_z" => axis.z,
+                "size" => SIZE,
+                "forward_x" => forward.x,
+                "forward_y" => forward.y,
+                "forward_z" => forward.z,
+                "count" => groom.strands,
+                "side_x" => side.x,
+                "side_y" => side.y,
+                "side_z" => side.z,
+                "points" => groom.points,
+                "step" => STEP,
+                "reach" => REACH,
+                "shadow_reach" => SHADOW_REACH,
+                "at_skin" => AT_SKIN,
+                "at_reach" => AT_REACH,
+                "lock_spread" => LOCK_SPREAD,
+                "strand_spread" => STRAND_SPREAD,
+                "lock_width" => LOCK_WIDTH,
+                "block_side" => block_side,
+                "blocks" => blocks,
+                "pad0" => 0u32,
+                "pad1" => 0u32,
+            },
+            groom.strands,
+        )?;
+        Ok(())
+    }
+
+    /// Record which texels are bare, into `bare[0]`, and their share round
+    /// each texel, blurred twice along rows and columns, back into it.
+    fn bare(
+        &self,
+        gpu: &HairGpu,
+        batch: &mut KernelBatch<'_>,
+        [topmost, shadowed]: [&Buffer; 2],
+        bare: &[Buffer; 2],
+    ) -> Result<()> {
+        let kernels = &gpu.bake;
+        let (block_side, blocks, bare_reach) = (self.block_side, self.blocks, self.bare_reach);
+        let texel_count = SIZE * SIZE;
+        batch.dispatch_folded(
+            &kernels.bare,
+            &params! {
+                "topmost" => topmost.clone(),
+                "shadowed" => shadowed.clone(),
+                "bare" => bare[0].clone(),
+                "size" => SIZE,
+                "block_side" => block_side,
+                "blocks" => blocks,
+                "pad0" => 0u32,
+            },
+            texel_count,
+        )?;
+        // Twice over, along rows then columns each time, so the nearest
+        // scalp counts most and the share falls smoothly.
+        for pass in 0..4u32 {
+            let (from, to) = (&bare[(pass % 2) as usize], &bare[((pass + 1) % 2) as usize]);
+            batch.dispatch_folded(
+                &kernels.blur,
+                &params! {
+                    "blur_in" => from.clone(),
+                    "blur_out" => to.clone(),
+                    "size" => SIZE,
+                    "stride" => if pass % 2 == 0 { 1 } else { SIZE },
+                    "reach" => bare_reach,
+                    "pad0" => 0u32,
+                },
+                texel_count,
+            )?;
+        }
+        Ok(())
+    }
+}
+
+impl GpuScalpTexture {
+    /// Record the textures written from `topmost` and the bare `share`, and
+    /// every smaller mip level.
+    fn finish(
+        &self,
+        gpu: &HairGpu,
+        batch: &mut KernelBatch<'_>,
+        topmost: &Buffer,
+        share: &Buffer,
+    ) -> Result<()> {
+        let kernels = &gpu.bake;
+        let texel_count = SIZE * SIZE;
+        batch.dispatch_folded(
+            &kernels.finish,
+            &params! {
+                "topmost" => topmost.clone(),
+                "share" => share.clone(),
+                "shade" => self.shade.clone(),
+                "strands" => self.strands.clone(),
+                "size" => SIZE,
+                "shadowed_shade" => SHADOWED,
+                "bare_start" => BARE_START,
+                "bare_full" => BARE_FULL,
+                "strand_over_skin" => STRAND_OVER_SKIN,
+                "pad0" => 0u32,
+                "pad1" => 0u32,
+                "pad2" => 0u32,
+            },
+            texel_count,
+        )?;
+        for pair in levels().windows(2) {
+            let [from, to] = [pair[0], pair[1]];
+            for texture in [&self.shade, &self.strands] {
+                batch.dispatch_folded(
+                    &kernels.halve,
+                    &params! {
+                        "chain" => texture.clone(),
+                        "from_side" => from.side,
+                        "from_stride" => from.stride,
+                        "from_offset" => from.offset,
+                        "to_side" => to.side,
+                        "to_stride" => to.stride,
+                        "to_offset" => to.offset,
+                        "pad0" => 0u32,
+                        "pad1" => 0u32,
+                    },
+                    to.side * to.side,
+                )?;
+            }
+        }
+        Ok(())
+    }
+}
+
+/// The longest of `groom`'s strands, metres.
+pub(crate) fn longest(gpu: &HairGpu, groom: &GpuGroom) -> Result<f32> {
+    let context = gpu.context();
+    let out = storage(context, 16, "hair longest strand")?;
+    let mut batch = KernelBatch::labelled(context, "hair longest strand");
+    batch.encoder().clear_buffer(&out.buffer, 0, None);
+    batch.dispatch_folded(
+        &gpu.bake.longest,
+        &params! {
+            "positions" => groom.positions.clone(),
+            "longest" => out.clone(),
+            "count" => groom.strands,
+            "points" => groom.points,
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+        },
+        groom.strands,
+    )?;
+    batch.submit();
+    let words: Vec<u32> = pollster::block_on(out.read(context))?;
+    Ok(f32::from_bits(words.first().copied().unwrap_or(0)))
+}
--- before/crates/adventuresim-character-creator/src/hair/gpu/bake/wgsl.rs
+++ after/crates/adventuresim-character-creator/src/hair/gpu/bake/wgsl.rs
@@ -0,0 +1,400 @@
+//! The bake's WGSL: each strand drawn into the texture, the bare scalp
+//! found and blurred, the textures written, and each mip level averaged
+//! from the one before; and the longest strand measured.
+
+/// A topmost strand's packing: its height, direction and shade in one word,
+/// height first, so the greatest is the topmost. 0 is no strand.
+pub(super) const PACKING: &str = r#"
+const HEIGHT_BITS: u32 = 12u;
+const DIRECTION_BITS: u32 = 12u;
+const SHADE_BITS: u32 = 8u;
+const TURN: f32 = 6.283185307179586;
+
+fn quantize(value: f32, bits: u32) -> u32 {
+    return u32(round(clamp(value, 0.0, 1.0) * f32((1u << bits) - 1u)));
+}
+
+fn field_of(packed: u32, shift: u32, bits: u32) -> f32 {
+    let most = (1u << bits) - 1u;
+    return f32((packed >> shift) & most) / f32(most);
+}
+
+fn pack(height: f32, direction: f32, shade: f32) -> u32 {
+    let turn = (direction - TURN * floor(direction / TURN)) / TURN;
+    return max(
+        (quantize(height, HEIGHT_BITS) << (DIRECTION_BITS + SHADE_BITS))
+            | (quantize(turn, DIRECTION_BITS) << SHADE_BITS)
+            | quantize(shade, SHADE_BITS),
+        1u,
+    );
+}
+
+fn item(id: vec3<u32>, groups: vec3<u32>) -> u32 {
+    return id.y * groups.x * 64u + id.x;
+}
+"#;
+
+pub(super) const DRAW: &str = r#"
+struct StrandGpu {
+    normal: vec3<f32>,
+    id: u32,
+    uv: vec2<f32>,
+    group: i32,
+    radius: f32,
+};
+@group(0) @binding(0) var<storage, read> positions: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> strands: array<StrandGpu>;
+@group(0) @binding(2) var<storage, read> head_shape: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> topmost: array<atomic<u32>>;
+@group(0) @binding(4) var<storage, read_write> shadowed: array<atomic<u32>>;
+struct Params {
+    center_x: f32,
+    center_y: f32,
+    center_z: f32,
+    rim: f32,
+    axis_x: f32,
+    axis_y: f32,
+    axis_z: f32,
+    size: u32,
+    forward_x: f32,
+    forward_y: f32,
+    forward_z: f32,
+    count: u32,
+    side_x: f32,
+    side_y: f32,
+    side_z: f32,
+    points: u32,
+    step: f32,
+    reach: f32,
+    shadow_reach: f32,
+    at_skin: f32,
+    at_reach: f32,
+    lock_spread: f32,
+    strand_spread: f32,
+    lock_width: f32,
+    block_side: u32,
+    blocks: u32,
+    pad0: u32,
+    pad1: u32,
+};
+@group(0) @binding(5) var<uniform> params: Params;
+
+// A well-mixed 32-bit hash (the "lowbias32" of Chris Wellons).
+fn mix_hash(value: u32) -> u32 {
+    var x = value + 0x9e3779b9u;
+    x ^= x >> 16u;
+    x *= 0x7feb352du;
+    x ^= x >> 15u;
+    x *= 0x846ca68bu;
+    x ^= x >> 16u;
+    return x;
+}
+
+fn unit_of(value: u32) -> f32 {
+    return f32(mix_hash(value)) / 4294967295.0;
+}
+
+// Smooth noise, 0 to 1, varying over about a unit of `p`.
+fn lock_noise(p: vec3<f32>) -> f32 {
+    let base = floor(p);
+    let t = p - base;
+    let fraction = t * t * (vec3<f32>(3.0) - 2.0 * t);
+    var sum = 0.0;
+    for (var corner = 0u; corner < 8u; corner++) {
+        let offset = vec3<u32>(corner & 1u, (corner >> 1u) & 1u, (corner >> 2u) & 1u);
+        var key = 0u;
+        for (var axis = 0u; axis < 3u; axis++) {
+            key = mix_hash(key ^ bitcast<u32>(i32(base[axis]) + i32(offset[axis])));
+        }
+        var weight = 1.0;
+        for (var axis = 0u; axis < 3u; axis++) {
+            weight *= select(1.0 - fraction[axis], fraction[axis], offset[axis] == 1u);
+        }
+        sum += weight * unit_of(key);
+    }
+    return sum;
+}
+
+// A point of the unit disk on the square from -1 to 1 each way: Shirley and
+// Chiu's concentric mapping, inverted.
+fn square(reach: f32, azimuth_in: f32) -> vec2<f32> {
+    let quarter = 0.7853981633974483;
+    let shifted = azimuth_in + quarter;
+    let azimuth = shifted - TURN * floor(shifted / TURN) - quarter;
+    if (azimuth < quarter) {
+        return vec2<f32>(reach, azimuth / quarter * reach);
+    }
+    if (azimuth < 3.0 * quarter) {
+        return vec2<f32>(-(azimuth - 2.0 * quarter) / quarter * reach, reach);
+    }
+    if (azimuth < 5.0 * quarter) {
+        return vec2<f32>(-reach, -(azimuth - 4.0 * quarter) / quarter * reach);
+    }
+    return vec2<f32>((azimuth - 6.0 * quarter) / quarter * reach, -reach);
+}
+
+// Where `p` lies in the texture, texels, and whether it lies in it.
+fn map_texel(p: vec3<f32>) -> vec3<f32> {
+    let offset = p - vec3<f32>(params.center_x, params.center_y, params.center_z);
+    let length_of = length(offset);
+    if (length_of <= 1e-7) {
+        return vec3<f32>(0.0);
+    }
+    let direction = offset / length_of;
+    let axis = vec3<f32>(params.axis_x, params.axis_y, params.axis_z);
+    let reach = sin(acos(clamp(dot(direction, axis), -1.0, 1.0)) * 0.5) / params.rim;
+    if (reach > 1.0) {
+        return vec3<f32>(0.0);
+    }
+    let azimuth = atan2(
+        dot(direction, vec3<f32>(params.side_x, params.side_y, params.side_z)),
+        dot(direction, vec3<f32>(params.forward_x, params.forward_y, params.forward_z)),
+    );
+    let ab = square(reach, azimuth);
+    return vec3<f32>((ab + vec2<f32>(1.0)) * 0.5 * f32(params.size), 1.0);
+}
+
+fn draw(begin: vec2<f32>, end: vec2<f32>, begin_height: f32, end_height: f32, tone: f32) {
+    let direction = atan2(end.y - begin.y, end.x - begin.x);
+    let steps = max(u32(ceil(max(abs(end.x - begin.x), abs(end.y - begin.y)))), 1u);
+    for (var i = 0u; i <= steps; i++) {
+        let t = f32(i) / f32(steps);
+        let at = begin + (end - begin) * t;
+        let column = u32(at.x);
+        let row = u32(at.y);
+        if (column < params.size && row < params.size) {
+            let height = min((begin_height + (end_height - begin_height) * t) / params.reach, 1.0);
+            let shade = (params.at_skin + (params.at_reach - params.at_skin) * height) * tone;
+            atomicMax(&topmost[row * params.size + column], pack(height, direction, shade));
+        }
+    }
+}
+
+fn shade_blocks(begin: vec2<f32>, end: vec2<f32>) {
+    let steps = max(u32(ceil(max(abs(end.x - begin.x), abs(end.y - begin.y)))), 1u);
+    for (var i = 0u; i <= steps; i++) {
+        let at = begin + (end - begin) * (f32(i) / f32(steps));
+        let column = u32(at.x);
+        let row = u32(at.y);
+        if (column < params.size && row < params.size) {
+            let block = (row / params.block_side) * params.blocks + column / params.block_side;
+            atomicStore(&shadowed[block], 1u);
+        }
+    }
+}
+
+// One point along a strand: drawn from the last if both lie near enough
+// the skin, or their stretch marked as shadowing the scalp below.
+fn visit(
+    q: vec3<f32>,
+    tone: f32,
+    last_seen: ptr<function, bool>,
+    last_at: ptr<function, vec2<f32>>,
+    last_height: ptr<function, f32>,
+) {
+    let height = max(head_distance(q), 0.0);
+    let mapped = map_texel(q);
+    let seen = mapped.z > 0.5 && height < params.shadow_reach;
+    if (seen && *last_seen) {
+        if (min(*last_height, height) < params.reach) {
+            draw(*last_at, mapped.xy, *last_height, height, tone);
+        } else {
+            shade_blocks(*last_at, mapped.xy);
+        }
+    }
+    *last_seen = seen;
+    *last_at = mapped.xy;
+    *last_height = height;
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let base = s * params.points;
+    let lock = lock_noise(positions[base].xyz / params.lock_width);
+    let tone = 1.0 - params.lock_spread * lock - params.strand_spread * unit_of(strands[s].id);
+    var last_seen = false;
+    var last_at = vec2<f32>(0.0);
+    var last_height = 0.0;
+    var last = positions[base].xyz;
+    visit(last, tone, &last_seen, &last_at, &last_height);
+    for (var j = 1u; j < params.points; j++) {
+        let next = positions[base + j].xyz;
+        let pieces = max(u32(ceil(length(next - last) / params.step)), 1u);
+        for (var piece = 1u; piece <= pieces; piece++) {
+            visit(mix(last, next, f32(piece) / f32(pieces)), tone, &last_seen, &last_at, &last_height);
+        }
+        last = next;
+    }
+}
+"#;
+
+pub(super) const BARE: &str = r#"
+@group(0) @binding(0) var<storage, read> topmost: array<u32>;
+@group(0) @binding(1) var<storage, read> shadowed: array<u32>;
+@group(0) @binding(2) var<storage, read_write> bare: array<f32>;
+struct Params {
+    size: u32,
+    block_side: u32,
+    blocks: u32,
+    pad0: u32,
+};
+@group(0) @binding(3) var<uniform> params: Params;
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let k = id.y * groups.x * 64u + id.x;
+    if (k >= params.size * params.size) {
+        return;
+    }
+    let row = k / params.size;
+    let column = k % params.size;
+    let block = (row / params.block_side) * params.blocks + column / params.block_side;
+    bare[k] = select(0.0, 1.0, topmost[k] == 0u && shadowed[block] == 0u);
+}
+"#;
+
+pub(super) const BLUR: &str = r#"
+@group(0) @binding(0) var<storage, read> blur_in: array<f32>;
+@group(0) @binding(1) var<storage, read_write> blur_out: array<f32>;
+struct Params {
+    size: u32,
+    stride: u32,
+    reach: u32,
+    pad0: u32,
+};
+@group(0) @binding(2) var<uniform> params: Params;
+
+// The mean within `reach` texels along a row (`stride` 1) or a column.
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let k = id.y * groups.x * 64u + id.x;
+    if (k >= params.size * params.size) {
+        return;
+    }
+    let position = (k / params.stride) % params.size;
+    let start = k - position * params.stride;
+    let first = select(position - params.reach, 0u, position < params.reach);
+    let last = min(position + params.reach, params.size - 1u);
+    var sum = 0.0;
+    for (var other = first; other <= last; other++) {
+        sum += blur_in[start + other * params.stride];
+    }
+    blur_out[k] = sum / f32(last - first + 1u);
+}
+"#;
+
+pub(super) const FINISH: &str = r#"
+@group(0) @binding(0) var<storage, read> topmost: array<u32>;
+@group(0) @binding(1) var<storage, read> share: array<f32>;
+@group(0) @binding(2) var<storage, read_write> shade: array<u32>;
+@group(0) @binding(3) var<storage, read_write> strands: array<u32>;
+struct Params {
+    size: u32,
+    shadowed_shade: f32,
+    bare_start: f32,
+    bare_full: f32,
+    strand_over_skin: f32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(4) var<uniform> params: Params;
+
+fn to_byte(value: f32) -> u32 {
+    return u32(round(clamp(value, 0.0, 1.0) * 255.0));
+}
+
+fn texel_of(r: f32, g: f32, b: f32, a: f32) -> u32 {
+    return to_byte(r) | (to_byte(g) << 8u) | (to_byte(b) << 16u) | (to_byte(a) << 24u);
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let k = item(id, groups);
+    if (k >= params.size * params.size) {
+        return;
+    }
+    let packed = topmost[k];
+    let t = clamp((share[k] - params.bare_start) / (params.bare_full - params.bare_start), 0.0, 1.0);
+    let skin = t * t * (3.0 - 2.0 * t);
+    var tone = params.shadowed_shade;
+    var along = vec2<f32>(0.0);
+    var clear = 1.0;
+    if (packed != 0u) {
+        tone = field_of(packed, 0u, SHADE_BITS);
+        let direction = field_of(packed, SHADE_BITS, DIRECTION_BITS) * TURN;
+        along = vec2<f32>(cos(direction), sin(direction));
+        clear = 1.0 - params.strand_over_skin;
+    }
+    shade[k] = texel_of(tone, tone, tone, 1.0 - skin * clear);
+    strands[k] = texel_of(along.x * 0.5 + 0.5, along.y * 0.5 + 0.5, tone, 1.0);
+}
+"#;
+
+pub(super) const HALVE: &str = r#"
+@group(0) @binding(0) var<storage, read_write> chain: array<u32>;
+struct Params {
+    from_side: u32,
+    from_stride: u32,
+    from_offset: u32,
+    to_side: u32,
+    to_stride: u32,
+    to_offset: u32,
+    pad0: u32,
+    pad1: u32,
+};
+@group(0) @binding(1) var<uniform> params: Params;
+
+fn texel_at(x: u32, y: u32) -> vec4<u32> {
+    let side = params.from_side;
+    let v = chain[params.from_offset + min(y, side - 1u) * params.from_stride + min(x, side - 1u)];
+    return vec4<u32>(v & 255u, (v >> 8u) & 255u, (v >> 16u) & 255u, v >> 24u);
+}
+
+// Each texel of the next level the mean of four of this one's.
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let k = id.y * groups.x * 64u + id.x;
+    if (k >= params.to_side * params.to_side) {
+        return;
+    }
+    let x = k % params.to_side;
+    let y = k / params.to_side;
+    let sum = texel_at(2u * x, 2u * y) + texel_at(2u * x + 1u, 2u * y)
+        + texel_at(2u * x, 2u * y + 1u) + texel_at(2u * x + 1u, 2u * y + 1u);
+    let mean = sum / 4u;
+    chain[params.to_offset + y * params.to_stride + x] = mean.x | (mean.y << 8u) | (mean.z << 16u) | (mean.w << 24u);
+}
+"#;
+
+/// The longest strand's arc length, as the bits of a float: lengths are
+/// never negative, so the greatest bits are the greatest length.
+pub(super) const LONGEST: &str = r#"
+@group(0) @binding(0) var<storage, read> positions: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> longest: array<atomic<u32>>;
+struct Params {
+    count: u32,
+    points: u32,
+    pad0: u32,
+    pad1: u32,
+};
+@group(0) @binding(2) var<uniform> params: Params;
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = id.y * groups.x * 64u + id.x;
+    if (s >= params.count) {
+        return;
+    }
+    let base = s * params.points;
+    var length_of = 0.0;
+    for (var j = 1u; j < params.points; j++) {
+        length_of += distance(positions[base + j].xyz, positions[base + j - 1u].xyz);
+    }
+    atomicMax(&longest[0], bitcast<u32>(length_of));
+}
