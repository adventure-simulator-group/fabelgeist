+pub struct HairRenderer {
+    device: Arc<wgpu::Device>,
+    queue: Arc<wgpu::Queue>,
+    output_format: wgpu::TextureFormat,
+    layouts: Layouts,
+    pipelines: Pipelines,
+    globals: wgpu::Buffer,
+    globals_group: wgpu::BindGroup,
+    draws: [wgpu::Buffer; 3],
+    card_draws: [wgpu::Buffer; 2],
+    card_groups: [wgpu::BindGroup; 2],
+    post: [wgpu::Buffer; 2],
+    empty_group: wgpu::BindGroup,
+    linear: wgpu::Sampler,
+    comparison: wgpu::Sampler,
+    levels: Vec<GpuLevel>,
+    dynamics: Option<Dynamics>,
+    head_matrix: Mat4,
+    deform_layout: wgpu::BindGroupLayout,
+    deform_pipeline: wgpu::ComputePipeline,
+    cards: Vec<GpuMesh>,
+    card_quads: Vec<usize>,
+    /// The sizes of the groom's levels, to choose among them.
+    counts: LodCounts,
+    atlas: wgpu::TextureView,
+    atlas_variants: u32,
+    head: Option<GpuMesh>,
+    /// The head's surface, to measure how much hair covers it.
+    head_surface: Option<HeadSurface>,
+    /// How much hair covers each of the head's vertices.
+    head_cover: Option<Arc<wgpu::Buffer>>,
+    shadows: ShadowMaps,
+    lighting_group: wgpu::BindGroup,
+    opacity_group: wgpu::BindGroup,
+    targets: Option<Targets>,
+    /// The bounds everything drawn fits in, for the light's frustum.
+    bounds: [[f32; 3]; 2],
+    center: [f32; 3],
+    /// The accumulation: frames in the mean, which history holds it, and
+    /// what the view was.
+    frames: u32,
+    history: usize,
+    last: Option<(Globals, Representation, Option<Blend>)>,
+    generation: u64,
+    last_generation: u64,
+    /// The simulated strands moved since the last frame: keep blending
+    /// frames (a temporal filter) rather than starting the mean again.
+    moving: bool,
+}
+
+fn uniform_entry(binding: u32, visibility: wgpu::ShaderStages) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility,
+        ty: wgpu::BindingType::Buffer {
+            ty: wgpu::BufferBindingType::Uniform,
+            has_dynamic_offset: false,
+            min_binding_size: None,
+        },
+        count: None,
+    }
+}
+
+fn storage_entry(binding: u32) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::VERTEX,
+        ty: wgpu::BindingType::Buffer {
+            ty: wgpu::BufferBindingType::Storage { read_only: true },
+            has_dynamic_offset: false,
+            min_binding_size: None,
+        },
+        count: None,
+    }
+}
+
+fn texture_entry(binding: u32, sample_type: wgpu::TextureSampleType) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::FRAGMENT,
+        ty: wgpu::BindingType::Texture {
+            sample_type,
+            view_dimension: wgpu::TextureViewDimension::D2,
+            multisampled: false,
+        },
+        count: None,
+    }
+}
+
+fn sampler_entry(binding: u32, kind: wgpu::SamplerBindingType) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::FRAGMENT,
+        ty: wgpu::BindingType::Sampler(kind),
+        count: None,
+    }
+}
+
+/// The WGSL of the scene passes and of the full-screen passes after them.
+pub const HAIR_WGSL: &str = include_str!("hair.wgsl");
+pub const POST_WGSL: &str = include_str!("post.wgsl");
+pub const DEFORM_WGSL: &str = include_str!("deform.wgsl");
+
+/// The deform pass's source: [`DEFORM_WGSL`] and the head's distance field
+/// it keeps the drawn strands off.
+fn deform_source() -> String {
+    format!(
+        "{DEFORM_WGSL}{}{}",
+        crate::gpu::wgsl::common::MATH,
+        crate::gpu::wgsl::common::HEAD
+    )
+}
+
+impl HairRenderer {
+    pub fn new(
+        device: Arc<wgpu::Device>,
+        queue: Arc<wgpu::Queue>,
+        output_format: wgpu::TextureFormat,
+    ) -> Result<Self> {
+        use wgpu::ShaderStages as S;
+        let d = &*device;
+        let float = wgpu::TextureSampleType::Float { filterable: true };
+        let unfilterable = wgpu::TextureSampleType::Float { filterable: false };
+        let layouts = Layouts {
+            globals: d.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("hair globals"),
+                entries: &[uniform_entry(0, S::VERTEX | S::FRAGMENT)],
+            }),
+            strands: d.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("hair strands"),
+                entries: &[
+                    storage_entry(0),
+                    storage_entry(1),
+                    uniform_entry(2, S::VERTEX | S::FRAGMENT),
+                ],
+            }),
+            cards: d.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("hair cards"),
+                entries: &[uniform_entry(3, S::FRAGMENT)],
+            }),
+            lighting: d.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("hair lighting"),
+                entries: &[
+                    texture_entry(0, wgpu::TextureSampleType::Depth),
+                    texture_entry(1, float),
+                    texture_entry(2, wgpu::TextureSampleType::Depth),
+                    sampler_entry(3, wgpu::SamplerBindingType::Comparison),
+                    sampler_entry(4, wgpu::SamplerBindingType::Filtering),
+                    texture_entry(5, float),
+                ],
+            }),
+            opacity: d.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("hair opacity"),
+                entries: &[texture_entry(0, wgpu::TextureSampleType::Depth)],
+            }),
+            post: d.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("hair post"),
+                entries: &[
+                    texture_entry(0, unfilterable),
+                    texture_entry(1, unfilterable),
+                    uniform_entry(2, S::FRAGMENT),
+                ],
+            }),
+        };
+        let empty_layout = d.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("hair empty"),
+            entries: &[],
+        });
+        let empty_group = d.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("hair empty"),
+            layout: &empty_layout,
+            entries: &[],
+        });
+
+        let shader = d.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("hair"),
+            source: wgpu::ShaderSource::Wgsl(HAIR_WGSL.into()),
+        });
+        let post_shader = d.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("hair post"),
+            source: wgpu::ShaderSource::Wgsl(POST_WGSL.into()),
+        });
+        let layout = |label: &str, groups: &[&wgpu::BindGroupLayout]| {
+            let groups: Vec<Option<&wgpu::BindGroupLayout>> =
+                groups.iter().map(|g| Some(*g)).collect();
+            d.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+                label: Some(label),
+                bind_group_layouts: &groups,
+                immediate_size: 0,
+            })
+        };
+        let scene_layout = layout(
+            "hair scene",
+            &[&layouts.globals, &layouts.strands, &layouts.lighting],
+        );
+        let mesh_layout = layout(
+            "hair mesh",
+            &[&layouts.globals, &empty_layout, &layouts.lighting],
+        );
+        let card_layout = layout(
+            "hair cards",
+            &[&layouts.globals, &layouts.cards, &layouts.lighting],
+        );
+        let globals_layout = layout("hair globals only", &[&layouts.globals]);
+        let light_layout = layout("hair light", &[&layouts.globals, &layouts.strands]);
+        let opacity_layout = layout(
+            "hair opacity",
+            &[&layouts.globals, &layouts.strands, &layouts.opacity],
+        );
+        let post_layout = layout("hair post", &[&layouts.post]);
+
+        let depth_state = |write: bool, compare: wgpu::CompareFunction| wgpu::DepthStencilState {
+            format: DEPTH,
+            depth_write_enabled: Some(write),
+            depth_compare: Some(compare),
+            stencil: Default::default(),
+            bias: Default::default(),
+        };
+        let card_attributes = wgpu::vertex_attr_array![
+            0 => Float32x3, 1 => Float32, 2 => Float32x3, 3 => Float32,
+            4 => Float32x3, 5 => Float32, 6 => Float32, 7 => Float32
+        ];
+        let head_attributes = wgpu::vertex_attr_array![0 => Float32x3, 1 => Float32x3];
+        let cover_attributes = wgpu::vertex_attr_array![2 => Float32x2];
+        let card_buffer = wgpu::VertexBufferLayout {
+            array_stride: std::mem::size_of::<CardVertex>() as u64,
+            step_mode: wgpu::VertexStepMode::Vertex,
+            attributes: &card_attributes,
+        };
+        let head_buffer = wgpu::VertexBufferLayout {
+            array_stride: 24,
+            step_mode: wgpu::VertexStepMode::Vertex,
+            attributes: &head_attributes,
+        };
+        // How much hair covers each vertex, a buffer of its own: written on
+        // the host for a groom made there, the groomer's own for one made on
+        // the GPU.
+        let cover_buffer = wgpu::VertexBufferLayout {
+            array_stride: 8,
+            step_mode: wgpu::VertexStepMode::Vertex,
+            attributes: &cover_attributes,
+        };
+        #[allow(clippy::too_many_arguments)]
+        let scene = |label: &str,
+                     layout: &wgpu::PipelineLayout,
+                     vs: &str,
+                     fs: &str,
+                     buffers: &[wgpu::VertexBufferLayout],
+                     topology: wgpu::PrimitiveTopology,
+                     cull: Option<wgpu::Face>,
+                     coverage: bool,
+                     depth: wgpu::DepthStencilState| {
+            d.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some(label),
+                layout: Some(layout),
+                vertex: wgpu::VertexState {
+                    module: &shader,
+                    entry_point: Some(vs),
+                    compilation_options: Default::default(),
+                    buffers,
+                },
+                fragment: Some(wgpu::FragmentState {
+                    module: &shader,
+                    entry_point: Some(fs),
+                    compilation_options: Default::default(),
+                    targets: &[Some(wgpu::ColorTargetState {
+                        format: HDR,
+                        blend: None,
+                        write_mask: wgpu::ColorWrites::ALL,
+                    })],
+                }),
+                primitive: wgpu::PrimitiveState {
+                    topology,
+                    cull_mode: cull,
+                    ..Default::default()
+                },
+                depth_stencil: Some(depth),
+                multisample: wgpu::MultisampleState {
+                    count: SAMPLES,
+                    mask: !0,
+                    alpha_to_coverage_enabled: coverage,
+                },
+                multiview_mask: None,
+                cache: None,
+            })
+        };
+        let less = wgpu::CompareFunction::LessEqual;
+        let strip = wgpu::PrimitiveTopology::TriangleStrip;
+        let list = wgpu::PrimitiveTopology::TriangleList;
+        let shadow_bias = wgpu::DepthBiasState {
+            constant: 2,
+            slope_scale: 1.5,
+            clamp: 0.0,
+        };
+        let full_screen = |label: &str, fs: &str, format: wgpu::TextureFormat| {
+            d.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some(label),
+                layout: Some(&post_layout),
+                vertex: wgpu::VertexState {
+                    module: &post_shader,
+                    entry_point: Some("screen_vs"),
+                    compilation_options: Default::default(),
+                    buffers: &[],
+                },
+                fragment: Some(wgpu::FragmentState {
+                    module: &post_shader,
+                    entry_point: Some(fs),
+                    compilation_options: Default::default(),
+                    targets: &[Some(wgpu::ColorTargetState {
+                        format,
+                        blend: None,
+                        write_mask: wgpu::ColorWrites::ALL,
+                    })],
+                }),
+                primitive: Default::default(),
+                depth_stencil: None,
+                multisample: Default::default(),
+                multiview_mask: None,
+                cache: None,
+            })
+        };
+        let pipelines = Pipelines {
+            strands: scene(
+                "hair strands",
+                &scene_layout,
+                "strand_vs",
+                "strand_fs",
+                &[],
+                strip,
+                None,
+                false,
+                depth_state(true, less),
+            ),
+            cards: scene(
+                "hair cards",
+                &card_layout,
+                "card_vs",
+                "card_fs",
+                &[card_buffer],
+                list,
+                None,
+                false,
+                depth_state(true, less),
+            ),
+            head: scene(
+                "hair head",
+                &mesh_layout,
+                "head_vs",
+                "head_fs",
+                &[head_buffer.clone(), cover_buffer],
+                list,
+                Some(wgpu::Face::Back),
+                false,
+                depth_state(true, less),
+            ),
+            backdrop: d.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some("hair backdrop"),
+                layout: Some(&globals_layout),
+                vertex: wgpu::VertexState {
+                    module: &shader,
+                    entry_point: Some("screen_vs"),
+                    compilation_options: Default::default(),
+                    buffers: &[],
+                },
+                fragment: Some(wgpu::FragmentState {
+                    module: &shader,
+                    entry_point: Some("backdrop_fs"),
+                    compilation_options: Default::default(),
+                    targets: &[Some(wgpu::ColorTargetState {
+                        format: HDR,
+                        blend: None,
+                        write_mask: wgpu::ColorWrites::ALL,
+                    })],
+                }),
+                primitive: Default::default(),
+                depth_stencil: Some(depth_state(false, wgpu::CompareFunction::Always)),
+                multisample: wgpu::MultisampleState {
+                    count: SAMPLES,
+                    mask: !0,
+                    alpha_to_coverage_enabled: false,
+                },
+                multiview_mask: None,
+                cache: None,
+            }),
+            strand_depth: d.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some("hair strand depth"),
+                layout: Some(&light_layout),
+                vertex: wgpu::VertexState {
+                    module: &shader,
+                    entry_point: Some("strand_light_vs"),
+                    compilation_options: Default::default(),
+                    buffers: &[],
+                },
+                fragment: None,
+                primitive: wgpu::PrimitiveState {
+                    topology: strip,
+                    ..Default::default()
+                },
+                depth_stencil: Some(wgpu::DepthStencilState {
+                    bias: shadow_bias,
+                    ..depth_state(true, less)
+                }),
+                multisample: Default::default(),
+                multiview_mask: None,
+                cache: None,
+            }),
+            strand_opacity: d.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some("hair strand opacity"),
+                layout: Some(&opacity_layout),
+                vertex: wgpu::VertexState {
+                    module: &shader,
+                    entry_point: Some("strand_light_vs"),
+                    compilation_options: Default::default(),
+                    buffers: &[],
+                },
+                fragment: Some(wgpu::FragmentState {
+                    module: &shader,
+                    entry_point: Some("strand_opacity_fs"),
+                    compilation_options: Default::default(),
+                    targets: &[Some(wgpu::ColorTargetState {
+                        format: HDR,
+                        blend: Some(wgpu::BlendState {
+                            color: wgpu::BlendComponent {
+                                src_factor: wgpu::BlendFactor::One,
+                                dst_factor: wgpu::BlendFactor::One,
+                                operation: wgpu::BlendOperation::Add,
+                            },
+                            alpha: wgpu::BlendComponent {
+                                src_factor: wgpu::BlendFactor::One,
+                                dst_factor: wgpu::BlendFactor::One,
+                                operation: wgpu::BlendOperation::Add,
+                            },
+                        }),
+                        write_mask: wgpu::ColorWrites::ALL,
+                    })],
+                }),
+                primitive: wgpu::PrimitiveState {
+                    topology: strip,
+                    ..Default::default()
+                },
+                depth_stencil: None,
+                multisample: Default::default(),
+                multiview_mask: None,
+                cache: None,
+            }),
+            head_depth: d.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some("hair head depth"),
+                layout: Some(&globals_layout),
+                vertex: wgpu::VertexState {
+                    module: &shader,
+                    entry_point: Some("head_light_vs"),
+                    compilation_options: Default::default(),
+                    buffers: &[head_buffer],
+                },
+                fragment: None,
+                primitive: Default::default(),
+                depth_stencil: Some(wgpu::DepthStencilState {
+                    bias: shadow_bias,
+                    ..depth_state(true, less)
+                }),
+                multisample: Default::default(),
+                multiview_mask: None,
+                cache: None,
+            }),
+            accumulate: full_screen("hair accumulate", "accumulate_fs", HDR),
+            tonemap: full_screen("hair tonemap", "tonemap_fs", output_format),
+        };
+
+        let globals = d.create_buffer(&wgpu::BufferDescriptor {
+            label: Some("hair globals"),
+            size: std::mem::size_of::<Globals>() as u64,
+            usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+            mapped_at_creation: false,
+        });
+        let globals_group = d.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("hair globals"),
+            layout: &layouts.globals,
+            entries: &[wgpu::BindGroupEntry {
+                binding: 0,
+                resource: globals.as_entire_binding(),
+            }],
+        });
+        let small_uniform = |label: &str, size: usize| {
+            d.create_buffer(&wgpu::BufferDescriptor {
+                label: Some(label),
+                size: size as u64,
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            })
+        };
+        let draws = [
+            small_uniform("hair draw", std::mem::size_of::<DrawGpu>()),
+            small_uniform("hair shadow draw", std::mem::size_of::<DrawGpu>()),
+            small_uniform("hair blend draw", std::mem::size_of::<DrawGpu>()),
+        ];
+        let card_draws = [
+            small_uniform("hair card draw", std::mem::size_of::<CardDrawGpu>()),
+            small_uniform("hair card blend draw", std::mem::size_of::<CardDrawGpu>()),
+        ];
+        let card_groups = [0, 1].map(|i| {
+            d.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("hair card draw"),
+                layout: &layouts.cards,
+                entries: &[wgpu::BindGroupEntry {
+                    binding: 3,
+                    resource: card_draws[i].as_entire_binding(),
+                }],
+            })
+        });
+        let post = [
+            small_uniform("hair accumulate", 16),
+            small_uniform("hair tonemap", 16),
+        ];
+        let linear = d.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("hair linear"),
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            mipmap_filter: wgpu::MipmapFilterMode::Linear,
+            ..Default::default()
+        });
+        let comparison = d.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("hair shadow compare"),
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            compare: Some(wgpu::CompareFunction::LessEqual),
+            ..Default::default()
+        });
+        let compute_entry = |binding: u32, read_only: bool| wgpu::BindGroupLayoutEntry {
+            binding,
+            visibility: S::COMPUTE,
+            ty: wgpu::BindingType::Buffer {
+                ty: wgpu::BufferBindingType::Storage { read_only },
+                has_dynamic_offset: false,
+                min_binding_size: None,
+            },
+            count: None,
+        };
+        let deform_layout = d.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("hair deform"),
+            entries: &[
+                compute_entry(0, true),
+                compute_entry(1, false),
+                compute_entry(2, true),
+                compute_entry(3, true),
+                compute_entry(4, true),
+                compute_entry(5, true),
+                uniform_entry(6, S::COMPUTE),
+                compute_entry(7, true),
+            ],
+        });
+        let deform_shader = d.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("hair deform"),
+            source: wgpu::ShaderSource::Wgsl(deform_source().into()),
+        });
+        let deform_pipeline = d.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+            label: Some("hair deform"),
+            layout: Some(&d.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+                label: Some("hair deform"),
+                bind_group_layouts: &[Some(&deform_layout)],
+                immediate_size: 0,
+            })),
+            module: &deform_shader,
+            entry_point: Some("deform"),
+            compilation_options: Default::default(),
+            cache: None,
+        });
+        let atlas = Self::atlas_texture(d, &queue, 1, 1, &[vec![0; 4]]);
+        let shadows = Self::shadow_maps(d, 16);
+        let (lighting_group, opacity_group) =
+            Self::lighting_groups(d, &layouts, &shadows, &atlas, &linear, &comparison);
+        Ok(Self {
+            device,
+            queue,
+            output_format,
+            layouts,
+            pipelines,
+            globals,
+            globals_group,
+            draws,
+            card_draws,
+            card_groups,
+            post,
+            empty_group,
+            linear,
+            comparison,
+            levels: Vec::new(),
+            dynamics: None,
+            head_matrix: IDENTITY,
+            deform_layout,
+            deform_pipeline,
+            cards: Vec::new(),
+            card_quads: Vec::new(),
+            counts: LodCounts::default(),
+            atlas,
+            atlas_variants: 1,
+            head: None,
+            head_surface: None,
+            head_cover: None,
+            shadows,
+            lighting_group,
+            opacity_group,
+            targets: None,
+            bounds: [[-0.2, -0.3, -0.2], [0.2, 0.2, 0.2]],
+            center: [0.0; 3],
+            frames: 0,
+            history: 0,
+            last: None,
+            generation: 0,
+            last_generation: u64::MAX,
+            moving: false,
+        })
+    }
+
+    fn atlas_texture(
+        device: &wgpu::Device,
+        queue: &wgpu::Queue,
+        width: u32,
+        height: u32,
+        levels: &[Vec<u8>],
+    ) -> wgpu::TextureView {
+        let texture = device.create_texture(&wgpu::TextureDescriptor {
+            label: Some("hair card atlas"),
+            size: wgpu::Extent3d {
+                width,
+                height,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: levels.len() as u32,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: wgpu::TextureFormat::Rgba8Unorm,
+            usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+            view_formats: &[],
+        });
+        for (level, data) in levels.iter().enumerate() {
+            let w = (width >> level).max(1);
+            let h = (height >> level).max(1);
+            queue.write_texture(
+                wgpu::TexelCopyTextureInfo {
+                    texture: &texture,
+                    mip_level: level as u32,
+                    origin: wgpu::Origin3d::ZERO,
+                    aspect: wgpu::TextureAspect::All,
+                },
+                data,
+                wgpu::TexelCopyBufferLayout {
+                    offset: 0,
+                    bytes_per_row: Some(w * 4),
+                    rows_per_image: Some(h),
+                },
+                wgpu::Extent3d {
+                    width: w,
+                    height: h,
+                    depth_or_array_layers: 1,
+                },
+            );
+        }
+        texture.create_view(&Default::default())
+    }
+
+    fn shadow_maps(device: &wgpu::Device, resolution: u32) -> ShadowMaps {
+        let texture = |label: &str, format: wgpu::TextureFormat| {
+            device
+                .create_texture(&wgpu::TextureDescriptor {
+                    label: Some(label),
+                    size: wgpu::Extent3d {
+                        width: resolution,
+                        height: resolution,
+                        depth_or_array_layers: 1,
+                    },
+                    mip_level_count: 1,
+                    sample_count: 1,
+                    dimension: wgpu::TextureDimension::D2,
+                    format,
+                    usage: wgpu::TextureUsages::RENDER_ATTACHMENT
+                        | wgpu::TextureUsages::TEXTURE_BINDING,
+                    view_formats: &[],
+                })
+                .create_view(&Default::default())
+        };
+        ShadowMaps {
+            resolution,
+            depth: texture("hair shadow depth", DEPTH),
+            layers: texture("hair shadow layers", HDR),
+            head: texture("hair head shadow", DEPTH),
+        }
+    }
+
+    fn lighting_groups(
+        device: &wgpu::Device,
+        layouts: &Layouts,
+        shadows: &ShadowMaps,
+        atlas: &wgpu::TextureView,
+        linear: &wgpu::Sampler,
+        comparison: &wgpu::Sampler,
+    ) -> (wgpu::BindGroup, wgpu::BindGroup) {
+        let lighting = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("hair lighting"),
+            layout: &layouts.lighting,
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::TextureView(&shadows.depth),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: wgpu::BindingResource::TextureView(&shadows.layers),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 2,
+                    resource: wgpu::BindingResource::TextureView(&shadows.head),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 3,
+                    resource: wgpu::BindingResource::Sampler(comparison),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 4,
+                    resource: wgpu::BindingResource::Sampler(linear),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 5,
+                    resource: wgpu::BindingResource::TextureView(atlas),
+                },
+            ],
+        });
+        let opacity = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("hair opacity"),
+            layout: &layouts.opacity,
+            entries: &[wgpu::BindGroupEntry {
+                binding: 0,
+                resource: wgpu::BindingResource::TextureView(&shadows.depth),
+            }],
+        });
+        (lighting, opacity)
+    }
+
+    fn rebind_lighting(&mut self) {
+        let (lighting, opacity) = Self::lighting_groups(
+            &self.device,
+            &self.layouts,
+            &self.shadows,
+            &self.atlas,
+            &self.linear,
+            &self.comparison,
+        );
+        self.lighting_group = lighting;
+        self.opacity_group = opacity;
+    }
+
+    /// Upload a groom: every strand level, the cards and their atlas. A
+    /// level larger than one storage binding may hold keeps the prefix of
+    /// its strands that fits -- an even sample of the rest.
+    pub fn set_groom(&mut self, lods: &HairLods) {
+        let limit = self.device.limits().max_storage_buffer_binding_size as usize;
+        // New strands: any physics bound to the old ones is gone.
+        self.dynamics = None;
+        self.head_matrix = IDENTITY;
+        self.levels = lods
+            .levels
+            .iter()
+            .map(|level| self.upload_level(level, limit))
+            .collect();
+        self.cards = lods.cards.iter().map(|c| self.upload_cards(c)).collect();
+        self.card_quads = lods.cards.iter().map(|c| c.indices.len() / 6).collect();
+        self.counts = lods.counts();
+        let atlas = &lods.atlas;
+        self.atlas = Self::atlas_texture(
+            &self.device,
+            &self.queue,
+            atlas.width,
+            atlas.height,
+            &atlas.levels,
+        );
+        self.atlas_variants = atlas.variants;
+        self.rebind_lighting();
+        let [lo, hi] = lods.bounds;
+        // The head is in the light's frustum too, however short the hair.
+        self.bounds = [
+            lo.min(Vec3::new(-0.12, -0.3, -0.13)).to_array(),
+            hi.max(Vec3::new(0.12, 0.13, 0.13)).to_array(),
+        ];
+        self.center = lods.center.to_array();
+        self.cover_head(lods);
+        self.generation += 1;
+    }
+
+    /// Upload a groom made on the GPU ([`crate::gpu::GpuGroomer::lods`]):
+    /// nothing is copied -- the levels, the cards and the head's cover are
+    /// drawn from the buffers the groomer's kernels wrote.
+    pub fn set_gpu_groom(&mut self, lods: &crate::gpu::GpuLods) {
+        self.dynamics = None;
+        self.head_matrix = IDENTITY;
+        self.levels = lods
+            .levels
+            .iter()
+            .map(|l| {
+                self.level_groups(
+                    l.points as usize,
+                    l.count as usize,
+                    l.positions.buffer.clone(),
+                    l.infos.buffer.clone(),
+                )
+            })
+            .collect();
+        self.cards = lods
+            .cards
+            .iter()
+            .map(|c| GpuMesh {
+                vertices: c.vertices.buffer.clone(),
+                indices: c.indices.buffer.clone(),
+                count: c.index_count(),
+            })
+            .collect();
+        self.card_quads = lods.cards.iter().map(|c| c.quads() as usize).collect();
+        self.counts = lods.counts();
+        let atlas = &lods.atlas;
+        self.atlas = Self::atlas_texture(
+            &self.device,
+            &self.queue,
+            atlas.width,
+            atlas.height,
+            &atlas.levels,
+        );
+        self.atlas_variants = atlas.variants;
+        self.rebind_lighting();
+        if let Some(cover) = &lods.cover {
+            self.head_cover = Some(cover.buffer.clone());
+        }
+        let [lo, hi] = lods.bounds;
+        self.bounds = [
+            lo.min(Vec3::new(-0.12, -0.3, -0.13)).to_array(),
+            hi.max(Vec3::new(0.12, 0.13, 0.13)).to_array(),
+        ];
+        self.center = lods.center.to_array();
+        self.generation += 1;
+    }
+
+    /// A level's bind groups, around its buffers.
+    fn level_groups(
+        &self,
+        points: usize,
+        count: usize,
+        positions: Arc<wgpu::Buffer>,
+        infos: Arc<wgpu::Buffer>,
+    ) -> GpuLevel {
+        let group = |draw: &wgpu::Buffer| {
+            self.device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("hair strands"),
+                layout: &self.layouts.strands,
+                entries: &[
+                    wgpu::BindGroupEntry {
+                        binding: 0,
+                        resource: positions.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 1,
+                        resource: infos.as_entire_binding(),
+                    },
+                    wgpu::BindGroupEntry {
+                        binding: 2,
+                        resource: draw.as_entire_binding(),
+                    },
+                ],
+            })
+        };
+        GpuLevel {
+            points: points as u32,
+            count: count as u32,
+            groups: [
+                group(&self.draws[MAIN]),
+                group(&self.draws[SHADOW]),
+                group(&self.draws[BLEND]),
+            ],
+            positions,
+            _infos: infos,
+        }
+    }
+
+    fn upload_level(&self, level: &StrandLevel, limit: usize) -> GpuLevel {
+        let per_strand = level.points * 16;
+        let count = level
+            .len()
+            .min(limit / per_strand.max(1))
+            .max(1.min(level.len()));
+        let positions = self
+            .device
+            .create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some("hair positions"),
+                contents: bytemuck::cast_slice(&level.positions[..count * level.points]),
+                usage: wgpu::BufferUsages::STORAGE
+                    | wgpu::BufferUsages::COPY_SRC
+                    | wgpu::BufferUsages::COPY_DST,
+            });
+        let infos = self
+            .device
+            .create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some("hair strand info"),
+                contents: bytemuck::cast_slice(
+                    &level.strands[..count.max(1).min(level.len().max(1))],
+                ),
+                usage: wgpu::BufferUsages::STORAGE,
+            });
+        self.level_groups(level.points, count, Arc::new(positions), Arc::new(infos))
+    }
+
+    fn upload_cards(&self, mesh: &CardMesh) -> GpuMesh {
+        let vertices = if mesh.vertices.is_empty() {
+            vec![CardVertex::default(); 3]
+        } else {
+            mesh.vertices.clone()
+        };
+        GpuMesh {
+            vertices: Arc::new(
+                self.device
+                    .create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                        label: Some("hair cards"),
+                        contents: bytemuck::cast_slice(&vertices),
+                        usage: wgpu::BufferUsages::VERTEX,
+                    }),
+            ),
+            indices: Arc::new(
+                self.device
+                    .create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                        label: Some("hair card indices"),
+                        contents: bytemuck::cast_slice(if mesh.indices.is_empty() {
+                            &[0u32, 1, 2][..]
+                        } else {
+                            &mesh.indices
+                        }),
+                        usage: wgpu::BufferUsages::INDEX,
+                    }),
+            ),
+            count: mesh.indices.len() as u32,
+        }
+    }
+
+    /// Turn real-time physics on for the uploaded groom: every drawn strand
+    /// will follow the simulated strands `binding` ties it to, whose groomed
+    /// points (in the head's frame) are `guide_rest`. Each level keeps a
+    /// copy of its rest pose to deform from.
+    pub fn set_dynamics(&mut self, binding: &SimBinding, guide_rest: &[[f32; 4]]) {
+        use wgpu::BufferUsages as U;
+        let d = &*self.device;
+        let init = |label: &str, bytes: &[u8], usage: U| {
+            Arc::new(d.create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                label: Some(label),
+                contents: bytes,
+                usage,
+            }))
+        };
+        let ids = init(
+            "hair bind ids",
+            bytemuck::cast_slice(&binding.guides),
+            U::STORAGE,
+        );
+        let weights = init(
+            "hair bind weights",
+            bytemuck::cast_slice(&binding.weights),
+            U::STORAGE,
+        );
+        let guide_rest_buffer = init(
+            "hair guide rest",
+            bytemuck::cast_slice(guide_rest),
+            U::STORAGE,
+        );
+        let guide_now = init(
+            "hair guide now",
+            bytemuck::cast_slice(guide_rest),
+            U::STORAGE | U::COPY_DST,
+        );
+        self.bind_dynamics(
+            ids,
+            weights,
+            guide_rest_buffer,
+            guide_now,
+            binding.points as u32,
+            None,
+        );
+    }
+
+    /// Turn real-time physics on for a groom made on the GPU, simulated
+    /// there ([`crate::gpu::GpuSim`]): the levels deform straight from the
+    /// simulation's buffers, which never leave the GPU. Each frame's step is
+    /// [`HairRenderer::set_moved`].
+    pub fn set_gpu_dynamics(&mut self, sim: &crate::gpu::GpuSim) {
+        let (ids, weights) = sim.binding();
+        self.bind_dynamics(
+            ids.buffer.clone(),
+            weights.buffer.clone(),
+            sim.rest().buffer.clone(),
+            sim.positions().buffer.clone(),
+            sim.points() as u32,
+            sim.body()
+                .map(|body| (body.buffer.clone(), sim.settings.collision_offset)),
+        );
+    }
+
+    /// Each level's rest pose, and the pass deforming it from the simulated
+    /// strands in `guide_now`.
+    fn bind_dynamics(
+        &mut self,
+        ids: Arc<wgpu::Buffer>,
+        weights: Arc<wgpu::Buffer>,
+        guide_rest_buffer: Arc<wgpu::Buffer>,
+        guide_now: Arc<wgpu::Buffer>,
+        sim_points: u32,
+        body: Option<(Arc<wgpu::Buffer>, f32)>,
+    ) {
+        use wgpu::BufferUsages as U;
+        let (body_buffer, body) = match body {
+            Some((buffer, offset)) => (buffer, Some(offset)),
+            None => (
+                Arc::new(self.device.create_buffer(&wgpu::BufferDescriptor {
+                    label: Some("hair no body"),
+                    size: 17 * 16,
+                    usage: U::STORAGE,
+                    mapped_at_creation: false,
+                })),
+                None,
+            ),
+        };
+        // Physics already on (a simulation moved to another level): the
+        // levels are deformed, and their rest poses are the copies made
+        // when it started.
+        let mut kept: Vec<Option<wgpu::Buffer>> = match self.dynamics.take() {
+            Some(old) => old.levels.into_iter().map(|l| Some(l.rest)).collect(),
+            None => Vec::new(),
+        };
+        let d = &*self.device;
+        let mut encoder = d.create_command_encoder(&wgpu::CommandEncoderDescriptor {
+            label: Some("hair rest poses"),
+        });
+        let levels = self
+            .levels
+            .iter()
+            .enumerate()
+            .map(|(at, level)| {
+                let size = level.positions.size();
+                let rest = match kept.get_mut(at).and_then(Option::take) {
+                    Some(rest) => rest,
+                    None => {
+                        let rest = d.create_buffer(&wgpu::BufferDescriptor {
+                            label: Some("hair rest pose"),
+                            size,
+                            usage: U::STORAGE | U::COPY_DST | U::COPY_SRC,
+                            mapped_at_creation: false,
+                        });
+                        encoder.copy_buffer_to_buffer(&level.positions, 0, &rest, 0, size);
+                        rest
+                    }
+                };
+                let params = d.create_buffer(&wgpu::BufferDescriptor {
+                    label: Some("hair deform params"),
+                    size: std::mem::size_of::<DeformGpu>() as u64,
+                    usage: U::UNIFORM | U::COPY_DST,
+                    mapped_at_creation: false,
+                });
+                let entries: [&wgpu::Buffer; 8] = [
+                    &rest,
+                    &level.positions,
+                    &guide_rest_buffer,
+                    &guide_now,
+                    &ids,
+                    &weights,
+                    &params,
+                    &body_buffer,
+                ];
+                let group = d.create_bind_group(&wgpu::BindGroupDescriptor {
+                    label: Some("hair deform"),
+                    layout: &self.deform_layout,
+                    entries: &entries
+                        .iter()
+                        .enumerate()
+                        .map(|(k, buffer)| wgpu::BindGroupEntry {
+                            binding: k as u32,
+                            resource: buffer.as_entire_binding(),
+                        })
+                        .collect::<Vec<_>>(),
+                });
+                DeformLevel {
+                    rest,
+                    params,
+                    group,
+                    sim_points,
+                }
+            })
+            .collect();
+        self.queue.submit([encoder.finish()]);
+        self.dynamics = Some(Dynamics {
+            _ids: ids,
+            _weights: weights,
+            _guide_rest: guide_rest_buffer,
+            guide_now,
+            _body: body_buffer,
+            body,
+            levels,
+            dirty: true,
+        });
+        self.generation += 1;
+    }
+
+    /// The simulated strands' points this frame (world space), and where
+    /// the head is.
+    pub fn set_simulated(&mut self, guides: &[[f32; 4]], head: &Rigid) {
+        let Some(dynamics) = &self.dynamics else {
+            return;
+        };
+        self.queue
+            .write_buffer(&dynamics.guide_now, 0, bytemuck::cast_slice(guides));
+        self.set_moved(head);
+    }
+
+    /// The simulated strands moved -- on the GPU, where the renderer reads
+    /// them -- and the head is at `head`.
+    pub fn set_moved(&mut self, head: &Rigid) {
+        let Some(dynamics) = &mut self.dynamics else {
+            return;
+        };
+        dynamics.dirty = true;
+        self.head_matrix = head.matrix();
+        self.moving = true;
+    }
+
+    /// Physics off: every level back to its rest pose, the head home.
+    pub fn clear_dynamics(&mut self) {
+        let Some(dynamics) = self.dynamics.take() else {
+            return;
+        };
+        let mut encoder = self.device.create_command_encoder(&Default::default());
+        for (level, deform) in self.levels.iter().zip(&dynamics.levels) {
+            encoder.copy_buffer_to_buffer(
+                &deform.rest,
+                0,
+                &level.positions,
+                0,
+                level.positions.size(),
+            );
+        }
+        self.queue.submit([encoder.finish()]);
+        self.head_matrix = IDENTITY;
+        self.generation += 1;
+    }
+
+    /// Whether physics is on.
+    pub fn has_dynamics(&self) -> bool {
+        self.dynamics.is_some()
+    }
+
+    /// Deform `level`'s strands from the simulated ones.
+    fn deform(&self, encoder: &mut wgpu::CommandEncoder, level: usize) {
+        let (Some(dynamics), Some(gpu)) = (&self.dynamics, self.levels.get(level)) else {
+            return;
+        };
+        let deform = &dynamics.levels[level];
+        let params = DeformGpu {
+            head: self.head_matrix,
+            points: gpu.points,
+            sim_points: deform.sim_points,
+            strands: gpu.count,
+            body: u32::from(dynamics.body.is_some()),
+            offset: dynamics.body.unwrap_or(0.0),
+            pad: [0; 3],
+        };
+        self.queue
+            .write_buffer(&deform.params, 0, bytemuck::bytes_of(&params));
+        let groups = (gpu.points * gpu.count).div_ceil(64);
+        let x = groups.clamp(1, 65535);
+        let y = groups.div_ceil(x);
+        let mut pass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
+            label: Some("hair deform"),
+            timestamp_writes: None,
+        });
+        pass.set_pipeline(&self.deform_pipeline);
+        pass.set_bind_group(0, &deform.group, &[]);
+        pass.dispatch_workgroups(x, y, 1);
+    }
+
+    /// Upload the body the hair is on.
+    pub fn set_head(&mut self, surface: &Surface) {
+        let vertices: Vec<[f32; 6]> = surface
+            .positions
+            .iter()
+            .zip(&surface.normals)
+            .map(|(p, n)| [p.x, p.y, p.z, n.x, n.y, n.z])
+            .collect();
+        let indices: Vec<u32> = surface.triangles.iter().flatten().copied().collect();
+        // Bare until a groom covers it.
+        self.head_cover = Some(Arc::new(self.device.create_buffer_init(
+            &wgpu::util::BufferInitDescriptor {
+                label: Some("hair head cover"),
+                contents: bytemuck::cast_slice(&vec![[0.0f32; 2]; vertices.len().max(1)]),
+                usage: wgpu::BufferUsages::VERTEX | wgpu::BufferUsages::COPY_DST,
+            },
+        )));
+        self.head_surface = Some(HeadSurface {
+            positions: surface.positions.clone(),
+            normals: surface.normals.clone(),
+            triangles: surface.triangles.clone(),
+        });
+        self.head =
+            Some(GpuMesh {
+                vertices: Arc::new(self.device.create_buffer_init(
+                    &wgpu::util::BufferInitDescriptor {
+                        label: Some("hair head"),
+                        contents: bytemuck::cast_slice(&vertices),
+                        usage: wgpu::BufferUsages::VERTEX,
+                    },
+                )),
+                indices: Arc::new(self.device.create_buffer_init(
+                    &wgpu::util::BufferInitDescriptor {
+                        label: Some("hair head indices"),
+                        contents: bytemuck::cast_slice(&indices),
+                        usage: wgpu::BufferUsages::INDEX,
+                    },
+                )),
+                count: indices.len() as u32,
+            });
+        self.generation += 1;
+    }
+
+    /// Shade the head under the groom's hair: how much of each vertex's
+    /// skin the hair covers, smoothed over the mesh -- measured a vertex at
+    /// a time it steps along the hairline.
+    fn cover_head(&mut self, lods: &HairLods) {
+        let Some(surface) = &self.head_surface else {
+            return;
+        };
+        let HeadSurface {
+            positions,
+            normals,
+            triangles,
+        } = surface;
+        let mut cover = lods.cover.at(positions, normals);
+        let n = cover.len();
+        let mut sum = vec![[0.0f32; 2]; n];
+        let mut count = vec![0.0f32; n];
+        for _ in 0..3 {
+            sum.iter_mut().for_each(|s| *s = [0.0; 2]);
+            count.iter_mut().for_each(|c| *c = 0.0);
+            for t in triangles {
+                for &a in t {
+                    for &b in t {
+                        let (a, b) = (a as usize, b as usize);
+                        sum[a][0] += cover[b][0];
+                        sum[a][1] += cover[b][1];
+                        count[a] += 1.0;
+                    }
+                }
+            }
+            for i in 0..n {
+                if count[i] > 0.0 {
+                    cover[i] = [sum[i][0] / count[i], sum[i][1] / count[i]];
+                }
+            }
+        }
+        // A buffer of the renderer's own: a groom from the GPU may have left
+        // its groomer's bound here.
+        let buffer = Arc::new(
+            self.device
+                .create_buffer_init(&wgpu::util::BufferInitDescriptor {
+                    label: Some("hair head cover"),
+                    contents: bytemuck::cast_slice(&cover),
+                    usage: wgpu::BufferUsages::VERTEX | wgpu::BufferUsages::COPY_DST,
+                }),
+        );
+        self.head_cover = Some(buffer);
+    }
+
+    /// The output texture at `width` by `height`; whether it was made anew
+    /// (and so needs registering again wherever it is shown).
+    pub fn resize(
+        &mut self,
+        width: u32,
+        height: u32,
+    ) -> (Arc<wgpu::Texture>, Arc<wgpu::TextureView>, bool) {
+        let (width, height) = (width.max(1), height.max(1));
+        if let Some(t) = &self.targets
+            && t.width == width
+            && t.height == height
+        {
+            return (t.output.clone(), t.output_view.clone(), false);
+        }
+        let texture =
+            |label: &str, format: wgpu::TextureFormat, samples: u32, usage: wgpu::TextureUsages| {
+                self.device.create_texture(&wgpu::TextureDescriptor {
+                    label: Some(label),
+                    size: wgpu::Extent3d {
+                        width,
+                        height,
+                        depth_or_array_layers: 1,
+                    },
+                    mip_level_count: 1,
+                    sample_count: samples,
+                    dimension: wgpu::TextureDimension::D2,
+                    format,
+                    usage,
+                    view_formats: &[],
+                })
+            };
+        use wgpu::TextureUsages as U;
+        let color = texture("hair color", HDR, SAMPLES, U::RENDER_ATTACHMENT)
+            .create_view(&Default::default());
+        let depth = texture("hair depth", DEPTH, SAMPLES, U::RENDER_ATTACHMENT)
+            .create_view(&Default::default());
+        let resolved = texture(
+            "hair resolved",
+            HDR,
+            1,
+            U::RENDER_ATTACHMENT | U::TEXTURE_BINDING,
+        )
+        .create_view(&Default::default());
+        let accum = [0, 1].map(|_| {
+            texture(
+                "hair history",
+                HDR,
+                1,
+                U::RENDER_ATTACHMENT | U::TEXTURE_BINDING,
+            )
+            .create_view(&Default::default())
+        });
+        let output = Arc::new(texture(
+            "hair output",
+            self.output_format,
+            1,
+            U::RENDER_ATTACHMENT | U::TEXTURE_BINDING | U::COPY_SRC,
+        ));
+        let output_view = Arc::new(output.create_view(&Default::default()));
+        let post_group =
+            |input: &wgpu::TextureView, history: &wgpu::TextureView, post: &wgpu::Buffer| {
+                self.device.create_bind_group(&wgpu::BindGroupDescriptor {
+                    label: Some("hair post"),
+                    layout: &self.layouts.post,
+                    entries: &[
+                        wgpu::BindGroupEntry {
+                            binding: 0,
+                            resource: wgpu::BindingResource::TextureView(input),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 1,
+                            resource: wgpu::BindingResource::TextureView(history),
+                        },
+                        wgpu::BindGroupEntry {
+                            binding: 2,
+                            resource: post.as_entire_binding(),
+                        },
+                    ],
+                })
+            };
+        let accumulate = [
+            post_group(&resolved, &accum[0], &self.post[0]),
+            post_group(&resolved, &accum[1], &self.post[0]),
+        ];
+        let tonemap_resolved = post_group(&resolved, &accum[0], &self.post[1]);
+        let tonemap_accum = [
+            post_group(&accum[0], &accum[1], &self.post[1]),
+            post_group(&accum[1], &accum[0], &self.post[1]),
+        ];
+        self.targets = Some(Targets {
+            width,
+            height,
+            color,
+            depth,
+            resolved,
+            accum,
+            output: output.clone(),
+            output_view: output_view.clone(),
+            accumulate,
+            tonemap_resolved,
+            tonemap_accum,
+        });
+        self.last = None;
+        (output, output_view, true)
+    }
+
+    /// Whether another frame would change the image: the view moved, or the
+    /// running mean has not yet taken all its frames.
+    pub fn converged(&self, policy: &LodPolicy) -> bool {
+        self.frames >= policy.quality.accumulate.max(1) && self.last_generation == self.generation
+    }
+
+    /// Draw a frame into the output texture.
+    pub fn render(
+        &mut self,
+        camera: &Camera,
+        lighting: &Lighting,
+        material: &HairMaterial,
+        policy: &LodPolicy,
+    ) -> Result<FrameInfo> {
+        let Some(targets) = &self.targets else {
+            return Err(HairGpuError::MissingRenderTargets);
+        };
+        let (width, height) = (targets.width, targets.height);
+        let aspect = width as f32 / height as f32;
+        let quality = policy.quality;
+
+        // How tall the head is on screen, and what to draw for it.
+        let distance = math::length(math::sub(self.center, camera.eye)).max(1e-3);
+        let pixel_angle = 2.0 * (camera.fov_y * 0.5).tan() / height as f32;
+        let pixels = 0.25 / (distance * pixel_angle);
+        let (representation, blend) = if self.levels.is_empty() {
+            (Representation::Cards { level: 0 }, None)
+        } else {
+            policy.select_blended(pixels, self.counts)
+        };
+        let shadow_draw = policy.shadow(self.counts);
+
+        // The key light's frustum: a box around everything, from the light.
+        let [mut lo, mut hi] = self.bounds;
+        // Moving hair may leave its rest bounds: room for it in the light's
+        // frustum.
+        if self.dynamics.is_some() {
+            lo = math::sub(lo, [0.12; 3]);
+            hi = math::add(hi, [0.12; 3]);
+        }
+        let center = math::scale(math::add(lo, hi), 0.5);
+        let radius = math::length(math::sub(hi, lo)) * 0.5;
+        let key = math::normalize(lighting.key.direction);
+        let light_up = if key[1].abs() > 0.99 {
+            [0.0, 0.0, 1.0]
+        } else {
+            [0.0, 1.0, 0.0]
+        };
+        let light_eye = math::add(center, math::scale(key, radius * 2.0));
+        let light_view_proj = multiply(
+            &orthographic(-radius, radius, -radius, radius, radius, radius * 3.0),
+            &look_at(light_eye, center, light_up),
+        );
+        let resolution = quality.shadow_resolution.max(16);
+        if quality.shadows && self.shadows.resolution != resolution {
+            self.shadows = Self::shadow_maps(&self.device, resolution);
+            self.rebind_lighting();
+        }
+        let texel = 2.0 * radius / self.shadows.resolution as f32;
+        let base = material.base_color();
+        let darkness = 1.0 - (base[0] * 0.3 + base[1] * 0.59 + base[2] * 0.11).clamp(0.0, 1.0);
+        let light = |l: &Light| {
+            let d = math::normalize(l.direction);
+            (
+                [d[0], d[1], d[2], l.intensity],
+                [l.color[0], l.color[1], l.color[2], 0.0],
+            )
+        };
+        let (key_dir, key_color) = light(&lighting.key);
+        let (fill_dir, fill_color) = light(&lighting.fill);
+        let (rim_dir, rim_color) = light(&lighting.rim);
+        let mut globals = Globals {
+            view_proj: camera.view_projection(aspect),
+            light_view_proj,
+            head: self.head_matrix,
+            camera: [camera.eye[0], camera.eye[1], camera.eye[2], pixel_angle],
+            jitter: [0.0, 0.0, 0.0, lighting.exposure],
+            viewport: [
+                width as f32,
+                height as f32,
+                1.0 / width as f32,
+                1.0 / height as f32,
+            ],
+            key_dir,
+            key_color,
+            fill_dir,
+            fill_color,
+            rim_dir,
+            rim_color,
+            sky_top: [
+                lighting.sky_top[0],
+                lighting.sky_top[1],
+                lighting.sky_top[2],
+                0.0,
+            ],
+            sky_bottom: [
+                lighting.sky_bottom[0],
+                lighting.sky_bottom[1],
+                lighting.sky_bottom[2],
+                0.0,
+            ],
+            base_color: [base[0], base[1], base[2], material.random_color],
+            material: [
+                material.roughness,
+                material.radial_roughness,
+                material.cuticle_tilt,
+                material.random_roughness,
+            ],
+            taper: [material.taper.tip, material.taper.shape, 0.35, 0.45],
+            dom: [0.003, 0.01, 0.03, 2.0 * radius],
+            shadow: [
+                texel,
+                0.9,
+                0.35 + 0.5 * darkness,
+                if quality.shadows { 1.0 } else { 0.0 },
+            ],
+            mode: [
+                if quality.marschner { 1.0 } else { 0.0 },
+                self.atlas_variants as f32,
+                material.tip_lightness,
+                material.grey,
+            ],
+            // The key's softness: a 12 mm penumbra, in shadow-map UV.
+            skin: [
+                lighting.skin[0],
+                lighting.skin[1],
+                lighting.skin[2],
+                0.012 / (2.0 * radius),
+            ],
+            roots: [
+                material.root_darkness_start,
+                material.root_darkness_end,
+                material.root_darkness_strength,
+                material.wave_strength,
+            ],
+            waves: [
+                material.wave_scale,
+                material.wave_phase.to_radians(),
+                0.0,
+                0.0,
+            ],
+        };
+
+        // A new view starts the mean again; a still one takes the next
+        // jittered frame, until it has all it wants.
+        let wanted = quality.accumulate.max(1);
+        // The head's pose moves with the simulation, which does not start
+        // the mean again: the view is the same, the hair is moving.
+        let mut view = globals;
+        view.head = IDENTITY;
+        let same = self.last_generation == self.generation
+            && self
+                .last
+                .is_some_and(|(g, r, b)| g == view && r == representation && b == blend);
+        if !same {
+            self.frames = 0;
+        }
+        self.last = Some((view, representation, blend));
+        self.last_generation = self.generation;
+        let moving = std::mem::take(&mut self.moving);
+        if self.frames >= wanted && !moving {
+            return Ok(FrameInfo {
+                representation,
+                pixels,
+                frames: self.frames,
+                primitives: self.primitives(representation),
+            });
+        }
+        if self.frames > 0 {
+            let n = self.frames % 64 + 1;
+            globals.jitter[0] = (halton(n, 2) - 0.5) * 2.0 / width as f32;
+            globals.jitter[1] = (halton(n, 3) - 0.5) * 2.0 / height as f32;
+            globals.jitter[2] = n as f32;
+        }
+        self.queue
+            .write_buffer(&self.globals, 0, bytemuck::bytes_of(&globals));
+        let draw = |r: Representation, levels: &[GpuLevel]| -> Option<DrawGpu> {
+            let Representation::Strands {
+                level,
+                count,
+                width_scale,
+            } = r
+            else {
+                return None;
+            };
+            let l = levels.get(level)?;
+            Some(DrawGpu {
+                points: l.points,
+                count: (count as u32).min(l.count),
+                pad: [0; 2],
+                width_scale,
+                min_pixels: quality.min_pixels,
+                pad2: [0.0; 2],
+            })
+        };
+        let main_draw = draw(representation, &self.levels);
+        let shadow_gpu = draw(shadow_draw, &self.levels);
+        if let Some(d) = main_draw {
+            self.queue
+                .write_buffer(&self.draws[MAIN], 0, bytemuck::bytes_of(&d));
+        }
+        // What the view draws: the band's form, and the coarser one fading
+        // in -- strands handing over along the shared order (the first
+        // strands at the finer level, the rest at the coarser, all as wide
+        // as the finer count wants), cards dissolving in card by card.
+        let strands_of = |r: Representation| match r {
+            Representation::Strands { count, .. } => count as u32,
+            Representation::Cards { .. } => 0,
+        };
+        let amount = blend.map_or(0.0, |b| b.amount);
+        let handed = |count: u32| ((count as f32) * (1.0 - amount)).round() as u32;
+        let mut strand_draws: Vec<(usize, usize, std::ops::Range<u32>)> = Vec::new();
+        let mut card_draws: Vec<(usize, [f32; 2])> = Vec::new();
+        match representation {
+            Representation::Strands { level, .. } => {
+                let count = strands_of(representation);
+                strand_draws.push((level, MAIN, 0..handed(count)));
+            }
+            Representation::Cards { level } => card_draws.push((level, [amount, 2.0])),
+        }
+        if let Some(Blend { to, .. }) = blend {
+            match (representation, to) {
+                (Representation::Strands { .. }, Representation::Strands { level, .. }) => {
+                    let count = strands_of(representation);
+                    strand_draws.push((level, BLEND, handed(count)..count));
+                }
+                (Representation::Cards { .. }, Representation::Strands { level, .. }) => {
+                    let count = strands_of(to);
+                    strand_draws.push((level, BLEND, 0..count - handed(count)));
+                }
+                (_, Representation::Cards { level }) => card_draws.push((level, [-1.0, amount])),
+            }
+            if let (Representation::Strands { .. }, Some(d)) = (to, draw(to, &self.levels)) {
+                // As wide as the finer form draws its strands.
+                let width_scale = match representation {
+                    Representation::Strands { width_scale, .. } => width_scale,
+                    _ => d.width_scale,
+                };
+                let d = DrawGpu { width_scale, ..d };
+                self.queue
+                    .write_buffer(&self.draws[BLEND], 0, bytemuck::bytes_of(&d));
+            }
+        }
+        for (i, (_, keep)) in card_draws.iter().enumerate() {
+            self.queue.write_buffer(
+                &self.card_draws[i],
+                0,
+                bytemuck::bytes_of(&CardDrawGpu {
+                    keep: [keep[0], keep[1], 0.0, 0.0],
+                }),
+            );
+        }
+        if let Some(d) = shadow_gpu {
+            self.queue
+                .write_buffer(&self.draws[SHADOW], 0, bytemuck::bytes_of(&d));
+        }
+
+        let mut encoder = self
+            .device
+            .create_command_encoder(&wgpu::CommandEncoderDescriptor {
+                label: Some("hair frame"),
+            });
+        // Physics: move the levels this frame draws.
+        if self.dynamics.as_ref().is_some_and(|d| d.dirty) {
+            let mut levels = Vec::new();
+            if let Representation::Strands { level, .. } = representation {
+                levels.push(level);
+            }
+            if let (true, Representation::Strands { level, .. }) = (quality.shadows, shadow_draw)
+                && !levels.contains(&level)
+            {
+                levels.push(level);
+            }
+            for level in levels {
+                self.deform(&mut encoder, level);
+            }
+            if let Some(d) = &mut self.dynamics {
+                d.dirty = false;
+            }
+        }
+        let targets = self.targets.as_ref().expect("checked above");
+        if quality.shadows {
+            // The head's shadow.
+            {
+                let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some("hair head shadow"),
+                    color_attachments: &[],
+                    depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                        view: &self.shadows.head,
+                        depth_ops: Some(wgpu::Operations {
+                            load: wgpu::LoadOp::Clear(1.0),
+                            store: wgpu::StoreOp::Store,
+                        }),
+                        stencil_ops: None,
+                    }),
+                    timestamp_writes: None,
+                    occlusion_query_set: None,
+                    multiview_mask: None,
+                });
+                if let Some(head) = &self.head {
+                    pass.set_pipeline(&self.pipelines.head_depth);
+                    pass.set_bind_group(0, &self.globals_group, &[]);
+                    pass.set_vertex_buffer(0, head.vertices.slice(..));
+                    pass.set_index_buffer(head.indices.slice(..), wgpu::IndexFormat::Uint32);
+                    pass.draw_indexed(0..head.count, 0, 0..1);
+                }
+            }
+            // The hair's nearest depth.
+            {
+                let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some("hair shadow depth"),
+                    color_attachments: &[],
+                    depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                        view: &self.shadows.depth,
+                        depth_ops: Some(wgpu::Operations {
+                            load: wgpu::LoadOp::Clear(1.0),
+                            store: wgpu::StoreOp::Store,
+                        }),
+                        stencil_ops: None,
+                    }),
+                    timestamp_writes: None,
+                    occlusion_query_set: None,
+                    multiview_mask: None,
+                });
+                if let (Some(d), Representation::Strands { level, .. }) = (shadow_gpu, shadow_draw)
+                {
+                    pass.set_pipeline(&self.pipelines.strand_depth);
+                    pass.set_bind_group(0, &self.globals_group, &[]);
+                    pass.set_bind_group(1, &self.levels[level].groups[SHADOW], &[]);
+                    pass.draw(0..d.points * 2, 0..d.count);
+                }
+            }
+            // Its opacity, layer by layer behind that.
+            {
+                let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some("hair shadow opacity"),
+                    color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                        view: &self.shadows.layers,
+                        depth_slice: None,
+                        resolve_target: None,
+                        ops: wgpu::Operations {
+                            load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),
+                            store: wgpu::StoreOp::Store,
+                        },
+                    })],
+                    depth_stencil_attachment: None,
+                    timestamp_writes: None,
+                    occlusion_query_set: None,
+                    multiview_mask: None,
+                });
+                if let (Some(d), Representation::Strands { level, .. }) = (shadow_gpu, shadow_draw)
+                {
+                    pass.set_pipeline(&self.pipelines.strand_opacity);
+                    pass.set_bind_group(0, &self.globals_group, &[]);
+                    pass.set_bind_group(1, &self.levels[level].groups[SHADOW], &[]);
+                    pass.set_bind_group(2, &self.opacity_group, &[]);
+                    pass.draw(0..d.points * 2, 0..d.count);
+                }
+            }
+        }
+
+        // The view.
+        {
+            let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("hair view"),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: &targets.color,
+                    depth_slice: None,
+                    resolve_target: Some(&targets.resolved),
+                    ops: wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                        store: wgpu::StoreOp::Discard,
+                    },
+                })],
+                depth_stencil_attachment: Some(wgpu::RenderPassDepthStencilAttachment {
+                    view: &targets.depth,
+                    depth_ops: Some(wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(1.0),
+                        store: wgpu::StoreOp::Discard,
+                    }),
+                    stencil_ops: None,
+                }),
+                timestamp_writes: None,
+                occlusion_query_set: None,
+                multiview_mask: None,
+            });
+            pass.set_bind_group(0, &self.globals_group, &[]);
+            pass.set_pipeline(&self.pipelines.backdrop);
+            pass.draw(0..3, 0..1);
+            pass.set_bind_group(1, &self.empty_group, &[]);
+            pass.set_bind_group(2, &self.lighting_group, &[]);
+            if let (Some(head), Some(cover)) = (&self.head, &self.head_cover) {
+                pass.set_pipeline(&self.pipelines.head);
+                pass.set_vertex_buffer(0, head.vertices.slice(..));
+                pass.set_vertex_buffer(1, cover.slice(..));
+                pass.set_index_buffer(head.indices.slice(..), wgpu::IndexFormat::Uint32);
+                pass.draw_indexed(0..head.count, 0, 0..1);
+            }
+            for (level, slot, instances) in &strand_draws {
+                let Some(l) = self.levels.get(*level) else {
+                    continue;
+                };
+                let instances = instances.start.min(l.count)..instances.end.min(l.count);
+                if instances.is_empty() {
+                    continue;
+                }
+                pass.set_pipeline(&self.pipelines.strands);
+                pass.set_bind_group(1, &l.groups[*slot], &[]);
+                pass.draw(0..l.points * 2, instances);
+            }
+            for (i, (level, _)) in card_draws.iter().enumerate() {
+                if let Some(cards) = self.cards.get(*level)
+                    && cards.count > 0
+                {
+                    pass.set_pipeline(&self.pipelines.cards);
+                    pass.set_bind_group(1, &self.card_groups[i], &[]);
+                    pass.set_vertex_buffer(0, cards.vertices.slice(..));
+                    pass.set_index_buffer(cards.indices.slice(..), wgpu::IndexFormat::Uint32);
+                    pass.draw_indexed(0..cards.count, 0, 0..1);
+                }
+            }
+        }
+
+        // Into the running mean, then onto the screen.
+        let accumulating = wanted > 1 || moving;
+        let source = if accumulating {
+            let from = self.history;
+            let to = 1 - from;
+            // Moving hair keeps a share of each new frame: an exponential
+            // mean, which smooths the stochastic coverage without trailing
+            // far behind the motion.
+            let mut weight = 1.0 / (self.frames + 1) as f32;
+            if moving {
+                weight = weight.max(0.35);
+            }
+            self.queue.write_buffer(
+                &self.post[0],
+                0,
+                bytemuck::bytes_of(&PostGpu {
+                    params: [weight, 0.0, 0.0, 0.0],
+                }),
+            );
+            {
+                let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                    label: Some("hair accumulate"),
+                    color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                        view: &targets.accum[to],
+                        depth_slice: None,
+                        resolve_target: None,
+                        ops: wgpu::Operations {
+                            load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                            store: wgpu::StoreOp::Store,
+                        },
+                    })],
+                    depth_stencil_attachment: None,
+                    timestamp_writes: None,
+                    occlusion_query_set: None,
+                    multiview_mask: None,
+                });
+                pass.set_pipeline(&self.pipelines.accumulate);
+                pass.set_bind_group(0, &targets.accumulate[from], &[]);
+                pass.draw(0..3, 0..1);
+            }
+            self.history = to;
+            &targets.tonemap_accum[to]
+        } else {
+            &targets.tonemap_resolved
+        };
+        self.queue.write_buffer(
+            &self.post[1],
+            0,
+            bytemuck::bytes_of(&PostGpu {
+                params: [
+                    0.0,
+                    lighting.exposure,
+                    if self.output_format.is_srgb() {
+                        0.0
+                    } else {
+                        1.0
+                    },
+                    0.0,
+                ],
+            }),
+        );
+        {
+            let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("hair tonemap"),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: &targets.output_view,
+                    depth_slice: None,
+                    resolve_target: None,
+                    ops: wgpu::Operations {
+                        load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
+                        store: wgpu::StoreOp::Store,
+                    },
+                })],
+                depth_stencil_attachment: None,
+                timestamp_writes: None,
+                occlusion_query_set: None,
+                multiview_mask: None,
+            });
+            pass.set_pipeline(&self.pipelines.tonemap);
+            pass.set_bind_group(0, source, &[]);
+            pass.draw(0..3, 0..1);
+        }
+        self.queue.submit([encoder.finish()]);
+        self.frames += 1;
+        Ok(FrameInfo {
+            representation,
+            pixels,
+            frames: self.frames,
+            primitives: self.primitives(representation),
+        })
+    }
+
+    fn primitives(&self, representation: Representation) -> usize {
+        match representation {
+            Representation::Strands { level, count, .. } => {
+                count.min(self.levels.get(level).map_or(0, |l| l.count as usize))
+            }
+            Representation::Cards { level } => self.card_quads.get(level).copied().unwrap_or(0),
+        }
+    }
+
+    /// Render until the running mean is complete: for stills.
+    pub fn render_converged(
+        &mut self,
+        camera: &Camera,
+        lighting: &Lighting,
+        material: &HairMaterial,
+        policy: &LodPolicy,
+    ) -> Result<FrameInfo> {
+        let mut info = self.render(camera, lighting, material, policy)?;
+        while info.frames < policy.quality.accumulate.max(1) {
+            info = self.render(camera, lighting, material, policy)?;
+        }
+        Ok(info)
+    }
+
+    /// The output texture's pixels, tightly packed rows of four bytes each.
+    pub fn read_rgba(&self) -> Result<(u32, u32, Vec<u8>)> {
+        let Some(targets) = &self.targets else {
+            return Err(HairGpuError::NothingRendered);
+        };
+        let (width, height) = (targets.width, targets.height);
+        let row = width * 4;
+        let padded = row.next_multiple_of(wgpu::COPY_BYTES_PER_ROW_ALIGNMENT);
+        let buffer = self.device.create_buffer(&wgpu::BufferDescriptor {
+            label: Some("hair readback"),
+            size: (padded * height) as u64,
+            usage: wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            mapped_at_creation: false,
+        });
+        let mut encoder = self.device.create_command_encoder(&Default::default());
+        encoder.copy_texture_to_buffer(
+            targets.output.as_image_copy(),
+            wgpu::TexelCopyBufferInfo {
+                buffer: &buffer,
+                layout: wgpu::TexelCopyBufferLayout {
+                    offset: 0,
+                    bytes_per_row: Some(padded),
+                    rows_per_image: Some(height),
+                },
+            },
+            wgpu::Extent3d {
+                width,
+                height,
+                depth_or_array_layers: 1,
+            },
+        );
+        self.queue.submit([encoder.finish()]);
+        let (tx, rx) = std::sync::mpsc::channel();
+        buffer.slice(..).map_async(wgpu::MapMode::Read, move |r| {
+            let _ = tx.send(r);
+        });
+        self.device.poll(wgpu::PollType::wait_indefinitely())?;
+        rx.recv()??;
+        let mapped = buffer.slice(..).get_mapped_range();
+        let mut pixels = Vec::with_capacity((row * height) as usize);
+        for y in 0..height {
+            let start = (y * padded) as usize;
+            pixels.extend_from_slice(&mapped[start..start + row as usize]);
+        }
+        // Blue-first formats read back swapped.
+        if matches!(
+            self.output_format,
+            wgpu::TextureFormat::Bgra8Unorm | wgpu::TextureFormat::Bgra8UnormSrgb
+        ) {
+            for p in pixels.chunks_mut(4) {
+                p.swap(0, 2);
+            }
+        }
+        Ok((width, height, pixels))
+    }
+}
+
+/// A device and queue of their own, for drawing without a window: the
+/// dataset's renders, snapshots and tests. Asks for the adapter's own
+/// storage limits, so a full groom fits in one binding.
+pub fn headless_device() -> Result<(Arc<wgpu::Device>, Arc<wgpu::Queue>)> {
+    pollster::block_on(async {
+        let instance = wgpu::Instance::new(wgpu::InstanceDescriptor {
+            backends: wgpu::Backends::all(),
+            ..wgpu::InstanceDescriptor::new_without_display_handle()
+        });
+        let adapter = instance
+            .request_adapter(&wgpu::RequestAdapterOptions {
+                power_preference: wgpu::PowerPreference::HighPerformance,
+                compatible_surface: None,
+                force_fallback_adapter: false,
+            })
+            .await
+            .map_err(HairGpuError::Adapter)?;
+        let adapter_limits = adapter.limits();
+        let limits = wgpu::Limits {
+            max_buffer_size: adapter_limits.max_buffer_size,
+            max_storage_buffer_binding_size: adapter_limits.max_storage_buffer_binding_size,
+            ..Default::default()
+        };
+        let (device, queue) = adapter
+            .request_device(&wgpu::DeviceDescriptor {
+                label: Some("hair"),
+                required_features: wgpu::Features::empty(),
+                required_limits: limits,
+                memory_hints: wgpu::MemoryHints::Performance,
+                experimental_features: wgpu::ExperimentalFeatures::default(),
+                trace: Default::default(),
+            })
+            .await?;
+        Ok((Arc::new(device), Arc::new(queue)))
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn validate(source: &str) {
+        let module = naga::front::wgsl::parse_str(source)
+            .unwrap_or_else(|e| panic!("{}", e.emit_to_string(source)));
+        naga::valid::Validator::new(
+            naga::valid::ValidationFlags::all(),
+            naga::valid::Capabilities::all(),
+        )
+        .validate(&module)
+        .unwrap_or_else(|e| panic!("{e:?}"));
+    }
+
+    #[test]
+    fn the_shaders_validate() {
+        validate(HAIR_WGSL);
+        validate(POST_WGSL);
+        validate(&deform_source());
+    }
+
+    #[test]
+    fn uniforms_match_their_wgsl_sizes() {
+        assert_eq!(std::mem::size_of::<Globals>(), 3 * 64 + 20 * 16);
+        assert_eq!(std::mem::size_of::<CardDrawGpu>(), 16);
+        assert_eq!(std::mem::size_of::<DeformGpu>(), 96);
+        assert_eq!(std::mem::size_of::<DrawGpu>(), 32);
+        assert_eq!(std::mem::size_of::<CardVertex>(), 64);
+    }
+}
--- before/crates/fabelgeist-hair/src/rng.rs
+++ after/crates/fabelgeist-hair/src/rng.rs
@@ -0,0 +1,168 @@
+//! Deterministic randomness.
+//!
+//! Blender's hair nodes draw their randomness from `Random Value` nodes keyed
+//! by an ID (a curve's stable ID, or a point's index) and a seed, so that a
+//! curve's curl phase or tip spread does not change when other curves are
+//! added or removed. [`unit`] and friends are that: stateless hashes of an ID
+//! and a seed. [`Rng`] is a sequential source for the few places that draw in
+//! order -- placing roots, choosing a dataset sample's parameters.
+
+use fabelgeist_math::Vec3;
+
+/// SplitMix64: tiny, fast, and statistically fine for placing roots.
+#[derive(Clone, Debug)]
+pub struct Rng(u64);
+
+impl Rng {
+    pub fn new(seed: u64) -> Self {
+        Self(seed ^ 0x9E37_79B9_7F4A_7C15)
+    }
+
+    pub fn next_u64(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+
+    pub fn next_u32(&mut self) -> u32 {
+        (self.next_u64() >> 32) as u32
+    }
+
+    /// Uniform in `[0, 1)`.
+    pub fn next_f32(&mut self) -> f32 {
+        (self.next_u64() >> 40) as f32 / (1u64 << 24) as f32
+    }
+
+    /// Uniform in `[low, high)`.
+    pub fn range(&mut self, low: f32, high: f32) -> f32 {
+        low + (high - low) * self.next_f32()
+    }
+
+    /// Uniform in `[low, high)`, but spread evenly on a log scale: for
+    /// parameters like a curl's frequency, where 5 to 10 is as big a step as
+    /// 20 to 40.
+    pub fn log_range(&mut self, low: f32, high: f32) -> f32 {
+        (low.ln() + (high.ln() - low.ln()) * self.next_f32()).exp()
+    }
+
+    /// True with probability `p`.
+    pub fn chance(&mut self, p: f32) -> bool {
+        self.next_f32() < p
+    }
+
+    /// An index into `0..n`.
+    pub fn index(&mut self, n: usize) -> usize {
+        ((self.next_f32() * n as f32) as usize).min(n.saturating_sub(1))
+    }
+
+    /// A standard normal draw (Box-Muller).
+    pub fn gaussian(&mut self) -> f32 {
+        let u = self.next_f32().max(1e-7);
+        let v = self.next_f32();
+        (-2.0 * u.ln()).sqrt() * (std::f32::consts::TAU * v).cos()
+    }
+
+    /// A fresh generator derived from this one.
+    pub fn fork(&mut self) -> Self {
+        Self::new(self.next_u64())
+    }
+}
+
+/// Draws in order from one word: each the hash of the key and a counter.
+/// Where [`Rng`] keeps sixty-four bits of state, this keeps a counter, so a
+/// GPU thread draws the very same numbers ([`crate::gpu`]): the guides are
+/// grown with it.
+#[derive(Clone, Debug)]
+pub struct Stream {
+    key: u32,
+    counter: u32,
+}
+
+impl Stream {
+    pub fn new(key: u32) -> Self {
+        Self { key, counter: 0 }
+    }
+
+    pub fn next_u32(&mut self) -> u32 {
+        let value = hash(self.key, self.counter);
+        self.counter = self.counter.wrapping_add(1);
+        value
+    }
+
+    /// Uniform in `[0, 1)`.
+    pub fn next_f32(&mut self) -> f32 {
+        (self.next_u32() >> 8) as f32 / (1u32 << 24) as f32
+    }
+
+    /// A standard normal draw (Box-Muller).
+    pub fn gaussian(&mut self) -> f32 {
+        let u = self.next_f32().max(1e-7);
+        let v = self.next_f32();
+        (-2.0 * u.ln()).sqrt() * (std::f32::consts::TAU * v).cos()
+    }
+}
+
+/// A 32-bit avalanche of two words (the finaliser of MurmurHash3 over a
+/// combined key).
+pub fn hash(a: u32, b: u32) -> u32 {
+    let mut h = a.wrapping_mul(0x9E37_79B1) ^ b.rotate_left(16).wrapping_mul(0x85EB_CA6B);
+    h ^= h >> 16;
+    h = h.wrapping_mul(0x85EB_CA6B);
+    h ^= h >> 13;
+    h = h.wrapping_mul(0xC2B2_AE35);
+    h ^ (h >> 16)
+}
+
+/// Three words into one.
+pub fn hash3(a: u32, b: u32, c: u32) -> u32 {
+    hash(hash(a, b), c)
+}
+
+/// Uniform in `[0, 1)` for an ID under a seed.
+pub fn unit(id: u32, seed: u32) -> f32 {
+    (hash(id, seed) >> 8) as f32 / (1u32 << 24) as f32
+}
+
+/// Uniform in `[-1, 1)` for an ID under a seed.
+pub fn signed(id: u32, seed: u32) -> f32 {
+    unit(id, seed) * 2.0 - 1.0
+}
+
+/// Each component uniform in `[-1, 1)`: Blender's vector `Random Value`
+/// between -1 and 1.
+pub fn signed_vec3(id: u32, seed: u32) -> Vec3 {
+    Vec3::new(
+        signed(id, hash(seed, 1)),
+        signed(id, hash(seed, 2)),
+        signed(id, hash(seed, 3)),
+    )
+}
+
+/// A seed from a user-facing integer, as Blender's `Hash Value` node does
+/// before feeding a seed to `Random Value`.
+pub fn seed(value: i32, salt: u32) -> u32 {
+    hash(value as u32, salt)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn units_are_uniform_enough() {
+        let n = 20_000;
+        let mean: f32 = (0..n).map(|i| unit(i, 7)).sum::<f32>() / n as f32;
+        assert!((mean - 0.5).abs() < 0.01, "{mean}");
+        assert!((0..n).all(|i| (0.0..1.0).contains(&unit(i, 3))));
+    }
+
+    #[test]
+    fn seeds_decorrelate() {
+        let same = (0..1000)
+            .filter(|&i| (unit(i, 1) - unit(i, 2)).abs() < 1e-3)
+            .count();
+        assert!(same < 10);
+    }
+}
--- before/crates/fabelgeist-hair/src/rod.rs
+++ after/crates/fabelgeist-hair/src/rod.rs
@@ -0,0 +1,911 @@
+//! The elastic rods hair is simulated as ([`crate::sim`]): the solver
+//! [`crate::sim::HairSim`] runs on the host, which the GPU's kernels
+//! ([`crate::gpu::GpuSim`]) mirror step for step.
+//!
+//! A simulated strand is a Cosserat rod (Pai 2002, Spillmann and Teschner
+//! 2007): point masses -- its fibres' mass, lumped half a segment each way
+//! -- and, for each segment, a material frame with the cross-section's
+//! rotational inertia. Two energies hold it together, in real units:
+//!
+//! * **Stretch and shear.** Each segment is to run along its frame's axis,
+//!   at its length, with the fibre's Young's modulus: hair barely stretches.
+//! * **Bend and twist.** Each frame is to keep its turn from the one before
+//!   (the Darboux vector, as a quaternion's vector part), with the fibre's
+//!   bending stiffness times how many fibres its clump bends as one
+//!   ([`SimSettings::clump`]), and twisting stiffness as an isotropic
+//!   rod's. The root's frame turns from the follicle's, which the head
+//!   carries. Frames are degrees of freedom, so the energy is local, and
+//!   curls and twist come out as they are.
+//!
+//! Gravity pulls, the air drags on the clump as on a cylinder (by White's
+//! correlation for its drag coefficient), and the bending is viscoelastic
+//! (stiffness-proportional damping). Each substep is one step of implicit
+//! Euler, Newton-linearised (Baraff and Witkin 1998) in the points'
+//! velocities and the frames' angular velocities: grouping each frame with
+//! the point at its segment's end, every group couples only to the groups
+//! beside it, so the strand's system is block tridiagonal in 6x6 blocks and
+//! is solved exactly, by block LDLᵀ, in one pass down the strand and one
+//! back. Stiffness costs nothing, and no iteration count sets how stiff the
+//! hair looks.
+//!
+//! **At rest under gravity.** A groom is drawn as it hangs, so the shape the
+//! rod rests at is solved for so that the groom is its equilibrium
+//! ([`rest_shape`]): each segment carries the weight below it, which sets
+//! its rest length and shear, and each joint the moment of that weight
+//! about it, which sets its rest bend and twist (Derouet-Jourdan et al.
+//! 2013, Hsu et al. 2023). The groom then neither sags when the simulation
+//! starts nor springs back to it when moved: it moves only as forces move
+//! it.
+
+use std::f32::consts::PI;
+use std::ops::{Add, Mul, Neg, Sub};
+
+use fabelgeist_math::Vec3;
+
+use crate::collider::{Collider, push_out};
+use crate::sim::{Rigid, SimSettings};
+use crate::strands::{orthogonal, safe_normalize, transport};
+
+/// Air at room temperature: density, kilograms a cubic metre, and
+/// kinematic viscosity, square metres a second.
+pub const AIR_DENSITY: f32 = 1.2;
+pub const AIR_VISCOSITY: f32 = 1.5e-5;
+/// How much of a clump's cross-section its fibres fill.
+const PACKING: f32 = 0.6;
+/// Keratin's Poisson ratio: an isotropic rod twists `1 / (1 + ν)` as
+/// stiffly as it bends.
+const POISSON: f32 = 0.4;
+
+/// The rod's material, per unit of its mass per length: what the solver
+/// needs of [`SimSettings`].
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Rod {
+    /// Young's modulus over density, square metres a second squared: a
+    /// segment's stretch stiffness times its length.
+    pub stretch: f32,
+    /// Bending and twisting stiffness over mass per length, metres to the
+    /// fourth a second squared.
+    pub bend: f32,
+    pub twist: f32,
+    /// The clump's radius squared: its frames' inertia per unit of mass is
+    /// a half of it about the axis, a quarter about a diameter.
+    pub gyration: f32,
+    /// Seconds: viscous bending force over elastic, per unit of rate.
+    pub damping: f32,
+    /// The air's drag a metre of strand, per unit of speed squared, over
+    /// mass per length; and the viscous term, which slow strands feel.
+    pub drag: f32,
+    pub drag_viscous: f32,
+    pub gravity: Vec3,
+}
+
+impl Rod {
+    pub fn new(s: &SimSettings) -> Self {
+        let r = s.fibre_radius.max(1e-7);
+        let density = s.density.max(1.0);
+        let per_length = density * PI * r * r;
+        let clump = s.clump.max(1.0);
+        let diameter = 2.0 * r * (clump / PACKING).sqrt();
+        let bend = clump * s.youngs_modulus.max(1.0) * r * r / (4.0 * density);
+        Self {
+            stretch: s.youngs_modulus.max(1.0) / density,
+            bend,
+            twist: bend / (1.0 + POISSON),
+            gyration: 0.25 * diameter * diameter,
+            damping: s.internal_damping.max(0.0),
+            drag: s.air_drag.max(0.0) * 0.5 * AIR_DENSITY * diameter / (clump * per_length),
+            drag_viscous: 10.0 * (AIR_VISCOSITY / diameter).powf(2.0 / 3.0),
+            gravity: Vec3::new(0.0, -s.gravity, 0.0),
+        }
+    }
+
+    /// The stiffness of the joint before segment `s`, in its first frame's
+    /// axes: a segment's frame is the strand's at its middle, so the joint
+    /// spans from the middle of the segment before (the follicle, for the
+    /// root's) to the middle of this one. Four times, as the Darboux vector
+    /// is half the turn.
+    fn joint(&self, lengths: &[f32], s: usize) -> Vec3 {
+        let span = if s == 0 {
+            0.5 * lengths[0]
+        } else {
+            0.5 * (lengths[s - 1] + lengths[s])
+        };
+        Vec3::new(self.bend, self.bend, self.twist) * (4.0 / span)
+    }
+}
+
+/// Point `i`'s mass over mass per length: half of each segment beside it.
+fn point_mass(lengths: &[f32], i: usize) -> f32 {
+    0.5 * (lengths[i - 1] + lengths.get(i).copied().unwrap_or(0.0))
+}
+
+/// A 3x3 matrix, by columns.
+#[derive(Clone, Copy, Debug)]
+pub struct M3(pub [Vec3; 3]);
+
+impl M3 {
+    pub const ZERO: Self = Self(
+        [Vec3 {
+            x: 0.0,
+            y: 0.0,
+            z: 0.0,
+        }; 3],
+    );
+
+    pub fn diagonal(s: f32) -> Self {
+        Self::scaling(Vec3::splat(s))
+    }
+
+    pub fn scaling(s: Vec3) -> Self {
+        Self([
+            Vec3::new(s.x, 0.0, 0.0),
+            Vec3::new(0.0, s.y, 0.0),
+            Vec3::new(0.0, 0.0, s.z),
+        ])
+    }
+
+    /// `a bᵀ`.
+    pub fn outer(a: Vec3, b: Vec3) -> Self {
+        Self([a * b.x, a * b.y, a * b.z])
+    }
+
+    /// `[a]×`: `a ×` as a matrix.
+    pub fn skew(a: Vec3) -> Self {
+        Self([
+            Vec3::new(0.0, a.z, -a.y),
+            Vec3::new(-a.z, 0.0, a.x),
+            Vec3::new(a.y, -a.x, 0.0),
+        ])
+    }
+
+    pub fn transpose(&self) -> Self {
+        let [c0, c1, c2] = self.0;
+        Self([
+            Vec3::new(c0.x, c1.x, c2.x),
+            Vec3::new(c0.y, c1.y, c2.y),
+            Vec3::new(c0.z, c1.z, c2.z),
+        ])
+    }
+
+    pub fn inverse(&self) -> Self {
+        let [a, b, c] = self.0;
+        // Rows of the inverse are the columns' pairwise crosses over the
+        // determinant.
+        let (r0, r1, r2) = (b.cross(c), c.cross(a), a.cross(b));
+        let det = a.dot(r0);
+        let inv = if det.abs() > 1e-30 { 1.0 / det } else { 0.0 };
+        Self([r0 * inv, r1 * inv, r2 * inv]).transpose()
+    }
+}
+
+impl Add for M3 {
+    type Output = Self;
+    fn add(self, o: Self) -> Self {
+        Self([self.0[0] + o.0[0], self.0[1] + o.0[1], self.0[2] + o.0[2]])
+    }
+}
+
+impl Sub for M3 {
+    type Output = Self;
+    fn sub(self, o: Self) -> Self {
+        Self([self.0[0] - o.0[0], self.0[1] - o.0[1], self.0[2] - o.0[2]])
+    }
+}
+
+impl Neg for M3 {
+    type Output = Self;
+    fn neg(self) -> Self {
+        self * -1.0
+    }
+}
+
+impl Mul<f32> for M3 {
+    type Output = Self;
+    fn mul(self, s: f32) -> Self {
+        Self([self.0[0] * s, self.0[1] * s, self.0[2] * s])
+    }
+}
+
+impl Mul<Vec3> for M3 {
+    type Output = Vec3;
+    fn mul(self, v: Vec3) -> Vec3 {
+        self.0[0] * v.x + self.0[1] * v.y + self.0[2] * v.z
+    }
+}
+
+impl Mul for M3 {
+    type Output = Self;
+    fn mul(self, o: Self) -> Self {
+        Self([self * o.0[0], self * o.0[1], self * o.0[2]])
+    }
+}
+
+/// A 6x6 matrix of 3x3 blocks, `[[a, b], [c, d]]`, acting on a frame's
+/// angular velocity then a point's velocity.
+#[derive(Clone, Copy, Debug)]
+struct M6 {
+    a: M3,
+    b: M3,
+    c: M3,
+    d: M3,
+}
+
+/// A frame's angular velocity and a point's velocity.
+type V6 = (Vec3, Vec3);
+
+impl M6 {
+    const ZERO: Self = Self {
+        a: M3::ZERO,
+        b: M3::ZERO,
+        c: M3::ZERO,
+        d: M3::ZERO,
+    };
+
+    fn mul(&self, o: &Self) -> Self {
+        Self {
+            a: self.a * o.a + self.b * o.c,
+            b: self.a * o.b + self.b * o.d,
+            c: self.c * o.a + self.d * o.c,
+            d: self.c * o.b + self.d * o.d,
+        }
+    }
+
+    fn apply(&self, (p, q): V6) -> V6 {
+        (self.a * p + self.b * q, self.c * p + self.d * q)
+    }
+
+    fn transpose(&self) -> Self {
+        Self {
+            a: self.a.transpose(),
+            b: self.c.transpose(),
+            c: self.b.transpose(),
+            d: self.d.transpose(),
+        }
+    }
+
+    fn sub(&self, o: &Self) -> Self {
+        Self {
+            a: self.a - o.a,
+            b: self.b - o.b,
+            c: self.c - o.c,
+            d: self.d - o.d,
+        }
+    }
+
+    /// By the Schur complement of `a`.
+    fn inverse(&self) -> Self {
+        let ai = self.a.inverse();
+        let aib = ai * self.b;
+        let cai = self.c * ai;
+        let si = (self.d - self.c * aib).inverse();
+        Self {
+            a: ai + aib * si * cai,
+            b: -(aib * si),
+            c: -(si * cai),
+            d: si,
+        }
+    }
+}
+
+/// A unit quaternion: `v` its vector part, `w` its scalar.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Quat {
+    pub v: Vec3,
+    pub w: f32,
+}
+
+impl Mul for Quat {
+    type Output = Self;
+
+    /// The rotation `o`, then this one.
+    fn mul(self, o: Self) -> Self {
+        Self {
+            v: o.v * self.w + self.v * o.w + self.v.cross(o.v),
+            w: self.w * o.w - self.v.dot(o.v),
+        }
+    }
+}
+
+impl Quat {
+    pub const IDENTITY: Self = Self {
+        v: Vec3 {
+            x: 0.0,
+            y: 0.0,
+            z: 0.0,
+        },
+        w: 1.0,
+    };
+
+    pub fn conj(self) -> Self {
+        Self {
+            v: -self.v,
+            w: self.w,
+        }
+    }
+
+    pub fn rotate(self, p: Vec3) -> Vec3 {
+        let t = self.v.cross(p) * 2.0;
+        p + t * self.w + self.v.cross(t)
+    }
+
+    pub fn matrix(self) -> M3 {
+        M3([
+            self.rotate(Vec3::new(1.0, 0.0, 0.0)),
+            self.rotate(Vec3::new(0.0, 1.0, 0.0)),
+            self.rotate(Vec3::new(0.0, 0.0, 1.0)),
+        ])
+    }
+
+    pub fn normalize(self) -> Self {
+        let l = (self.v.length_squared() + self.w * self.w).sqrt();
+        if l > 1e-12 {
+            Self {
+                v: self.v * (1.0 / l),
+                w: self.w / l,
+            }
+        } else {
+            Self::IDENTITY
+        }
+    }
+
+    /// The rotation by `theta` (axis times angle).
+    pub fn exp(theta: Vec3) -> Self {
+        let angle = theta.length();
+        if angle < 1e-12 {
+            return Self::IDENTITY;
+        }
+        let half = 0.5 * angle;
+        Self {
+            v: theta * (half.sin() / angle),
+            w: half.cos(),
+        }
+    }
+
+    /// The rotation whose matrix is `m`, by Shepperd's method.
+    pub fn from_matrix(m: M3) -> Self {
+        let [c0, c1, c2] = m.0;
+        let (m00, m11, m22) = (c0.x, c1.y, c2.z);
+        let trace = m00 + m11 + m22;
+        let q = if trace > 0.0 {
+            let s = (trace + 1.0).sqrt() * 2.0;
+            Self {
+                v: Vec3::new(c1.z - c2.y, c2.x - c0.z, c0.y - c1.x) * (1.0 / s),
+                w: 0.25 * s,
+            }
+        } else if m00 > m11 && m00 > m22 {
+            let s = (1.0 + m00 - m11 - m22).sqrt() * 2.0;
+            Self {
+                v: Vec3::new(0.25 * s, (c1.x + c0.y) / s, (c2.x + c0.z) / s),
+                w: (c1.z - c2.y) / s,
+            }
+        } else if m11 > m22 {
+            let s = (1.0 + m11 - m00 - m22).sqrt() * 2.0;
+            Self {
+                v: Vec3::new((c1.x + c0.y) / s, 0.25 * s, (c2.y + c1.z) / s),
+                w: (c2.x - c0.z) / s,
+            }
+        } else {
+            let s = (1.0 + m22 - m00 - m11).sqrt() * 2.0;
+            Self {
+                v: Vec3::new((c2.x + c0.z) / s, (c2.y + c1.z) / s, 0.25 * s),
+                w: (c0.y - c1.x) / s,
+            }
+        };
+        q.normalize()
+    }
+
+    /// The frame whose axes are `d1`, `d3 × d1` and `d3`.
+    pub fn from_frame(d1: Vec3, d3: Vec3) -> Self {
+        Self::from_matrix(M3([d1, d3.cross(d1), d3]))
+    }
+
+    pub fn to_array(self) -> [f32; 4] {
+        [self.v.x, self.v.y, self.v.z, self.w]
+    }
+
+    pub fn from_array(a: [f32; 4]) -> Self {
+        Self {
+            v: Vec3::new(a[0], a[1], a[2]),
+            w: a[3],
+        }
+    }
+}
+
+/// The head's rotation as a quaternion.
+pub fn rigid_rotation(pose: &Rigid) -> Quat {
+    Quat::from_matrix(M3(pose.axes))
+}
+
+/// The turn from frame `a` to frame `b`, `a⁻¹ b`, signed as near as can be
+/// to `groomed` (the groom's turn there), so that it changes smoothly
+/// however far the joint bends from rest, short of a half turn: its vector
+/// part, the Darboux vector, in `a`'s axes; how that changes with `a`'s
+/// rotation in `a`'s axes (with `b`'s in `b`'s axes, this times the turn's
+/// matrix, negated); and the turn's matrix.
+fn darboux(a: Quat, b: Quat, groomed: Quat) -> (Vec3, M3, M3) {
+    let mut q = a.conj().mul(b);
+    // The groom's turn the short way round, as the rest was solved for.
+    let side = (q.v.dot(groomed.v) + q.w * groomed.w) * groomed.w;
+    if side < 0.0 || (side == 0.0 && q.w < 0.0) {
+        q = Quat { v: -q.v, w: -q.w };
+    }
+    let change = (M3::skew(q.v) - M3::diagonal(q.w)) * 0.5;
+    (q.v, change, q.matrix())
+}
+
+/// The segments' lengths and directions, groomed.
+fn segments(points: &[Vec3]) -> (Vec<f32>, Vec<Vec3>) {
+    points
+        .windows(2)
+        .map(|w| {
+            let d = w[1] - w[0];
+            (d.length().max(1e-6), safe_normalize(d, Vec3::down()))
+        })
+        .unzip()
+}
+
+/// The rod a strand rests as, two slots a point: each segment's frame (the
+/// head's frame), then the Darboux vector of the joint before it and the
+/// length it rests at; the last point's slots hold the follicle's frame. If
+/// `sag_free`, the groom `rest` (in the head's frame, the head upright) is
+/// the rod's equilibrium under gravity; otherwise the rod rests as groomed
+/// and hangs from there.
+pub fn rest_shape(rod: &Rod, rest: &[Vec3], sag_free: bool, shape: &mut [[f32; 4]]) {
+    let n = rest.len();
+    if n < 2 {
+        shape.fill([0.0; 4]);
+        return;
+    }
+    let segs = n - 1;
+    let (lengths, tangents) = segments(rest);
+    // What each segment carries: the weight below it.
+    let mut carried = vec![Vec3::splat(0.0); segs];
+    if sag_free {
+        let mut below = Vec3::splat(0.0);
+        for j in (0..segs).rev() {
+            below += rod.gravity * point_mass(&lengths, j + 1);
+            carried[j] = below;
+        }
+    }
+    // Frames carried from the follicle's, twist-free, each axis sheared off
+    // its segment as far as the weight it carries strains it.
+    let normal = orthogonal(tangents[0]);
+    let follicle = Quat::from_frame(normal, tangents[0]);
+    let mut frames = Vec::with_capacity(segs);
+    let mut rest_lengths = Vec::with_capacity(segs);
+    let mut strains = Vec::with_capacity(segs);
+    let (mut t, mut u) = (tangents[0], normal);
+    for j in 0..segs {
+        u = transport(u, t, tangents[j]);
+        t = tangents[j];
+        let strain = carried[j] * (lengths[j] / rod.stretch);
+        let chord = tangents[j] * lengths[j] - strain;
+        let length = chord.length().max(1e-9);
+        let axis = chord * (1.0 / length);
+        let d1 = safe_normalize(transport(u, t, axis), u);
+        frames.push(Quat::from_frame(d1, axis));
+        rest_lengths.push(length);
+        strains.push(strain);
+    }
+    // Each joint rests bent and twisted by the moment it carries: the
+    // weights' below it, through the segments as levers.
+    let mut moment = Vec3::splat(0.0);
+    for s in (0..segs).rev() {
+        let a = if s == 0 { follicle } else { frames[s - 1] };
+        let (turn, change, _) = darboux(a, frames[s], Quat::IDENTITY);
+        let mut rest_turn = turn;
+        if sag_free {
+            let axis = frames[s].rotate(Vec3::new(0.0, 0.0, 1.0));
+            let stretch = rod.stretch / lengths[s];
+            moment += axis.cross(strains[s]) * (stretch * rest_lengths[s]);
+            // The joint's torque on its second frame, `Gᵀ K (turn - rest)`
+            // in the first frame's axes, holds the moment below it.
+            let k = rod.joint(&lengths, s);
+            let wanted = change.transpose().inverse() * (a.conj().rotate(moment) * -1.0);
+            rest_turn = turn - Vec3::new(wanted.x / k.x, wanted.y / k.y, wanted.z / k.z);
+        }
+        shape[2 * s] = frames[s].to_array();
+        shape[2 * s + 1] = [rest_turn.x, rest_turn.y, rest_turn.z, rest_lengths[s]];
+    }
+    shape[2 * segs] = follicle.to_array();
+    shape[2 * segs + 1] = [0.0; 4];
+}
+
+/// One substep of `h` seconds, the head going from `from` to `to`.
+pub struct Substep<'a> {
+    pub rod: &'a Rod,
+    pub h: f32,
+    /// Seconds the strands' last substep took: their velocities are their
+    /// moves over it.
+    pub h_last: f32,
+    pub from: Rigid,
+    pub to: Rigid,
+    pub collider: Option<&'a (dyn Collider + Sync)>,
+    pub offset: f32,
+    pub friction: f32,
+}
+
+/// A joint as a substep sees it, in its first frame's axes: with `G` how
+/// its turn changes with that frame's rotation, its stiffness `Gᵀ K G`
+/// against it, the torque `Gᵀ K (turn - rest)` that frame feels the
+/// opposite of (the second, the same in its own axes), and the turn's
+/// matrix, which takes the second frame's axes to the first's.
+#[derive(Clone, Copy)]
+struct Joint {
+    stiffness: M3,
+    torque: Vec3,
+    turn: M3,
+    /// The Darboux vector's curvature against either frame's rotation,
+    /// `-(K (turn - rest)) · turn / 4` alike about every axis, where it
+    /// stiffens: Gauss-Newton misses it, and a joint bent far from rest
+    /// would overshoot without it.
+    curving: f32,
+}
+
+impl Joint {
+    /// The stiffness against the first frame's rotation, in its own axes.
+    fn first(&self) -> M3 {
+        self.stiffness + M3::diagonal(self.curving)
+    }
+
+    /// The stiffness against the second frame's rotation, in its own axes.
+    fn second(&self) -> M3 {
+        self.turn.transpose() * self.stiffness * self.turn + M3::diagonal(self.curving)
+    }
+
+    /// Against the second frame's rotation and the first's.
+    fn across(&self) -> M3 {
+        -(self.turn.transpose() * self.stiffness)
+    }
+}
+
+/// A segment as a substep sees it: its frame's axes, how far it is from
+/// running along the third at its rest length, its stiffness and that
+/// length.
+#[derive(Clone, Copy)]
+struct Segment {
+    axes: M3,
+    strain: Vec3,
+    stiffness: f32,
+    length: f32,
+}
+
+impl Segment {
+    fn axis(&self) -> Vec3 {
+        self.axes.0[2]
+    }
+
+    /// How the strain changes with the frame's rotation in its own axes,
+    /// transposed: `L [e3]×ᵀ Rᵀ`.
+    fn lever(&self) -> M3 {
+        M3::skew(Vec3::new(0.0, 0.0, 1.0)).transpose() * self.axes.transpose() * self.length
+    }
+}
+
+impl Substep<'_> {
+    /// Step one strand: `rest` its groomed points (the head's frame),
+    /// `shape` its rod's rest ([`rest_shape`]), `air` the air's velocity
+    /// about it; `x` and `previous` its points now and one substep's
+    /// velocity behind, and `frames` each segment's frame and angular
+    /// velocity (world space), two slots a point, which it leaves likewise.
+    /// A frame's angular velocity is solved for in its own axes, where its
+    /// twist, light and soft beside its stretch, stands apart exactly.
+    pub fn strand(
+        &self,
+        rest: &[Vec3],
+        shape: &[[f32; 4]],
+        air: Vec3,
+        x: &mut [Vec3],
+        previous: &mut [Vec3],
+        frames: &mut [[f32; 4]],
+    ) {
+        let n = x.len();
+        if n < 2 {
+            return;
+        }
+        let segs = n - 1;
+        let rod = self.rod;
+        let h = self.h;
+        let (lengths, _) = segments(rest);
+        // The root rides the head, its follicle turning with it.
+        let root_from = self.from.apply(rest[0]);
+        let root_to = self.to.apply(rest[0]);
+        let root_velocity = (root_to - root_from) * (1.0 / h);
+        x[0] = root_from;
+        let head_from = rigid_rotation(&self.from);
+        let follicle = head_from.mul(Quat::from_array(shape[2 * segs]));
+        let follicle_spin = follicle
+            .conj()
+            .rotate(spin(head_from, rigid_rotation(&self.to), h));
+        let frame = |j: usize| Quat::from_array(frames[2 * j]);
+
+        let segments: Vec<Segment> = (0..segs)
+            .map(|j| {
+                let axes = frame(j).matrix();
+                let length = shape[2 * j + 1][3];
+                Segment {
+                    axes,
+                    strain: x[j + 1] - x[j] - axes.0[2] * length,
+                    stiffness: rod.stretch / lengths[j],
+                    length,
+                }
+            })
+            .collect();
+        // Joint s is the one before segment s.
+        let joints: Vec<Joint> = (0..segs)
+            .map(|s| {
+                let a = if s == 0 { follicle } else { frame(s - 1) };
+                let groomed = Quat::from_array(shape[2 * if s == 0 { segs } else { s - 1 }])
+                    .conj()
+                    .mul(Quat::from_array(shape[2 * s]));
+                let (turn, change, matrix) = darboux(a, frame(s), groomed);
+                let r = shape[2 * s + 1];
+                let off = turn - Vec3::new(r[0], r[1], r[2]);
+                let k = rod.joint(&lengths, s);
+                let gk = change.transpose() * M3::scaling(k);
+                let held = Vec3::new(k.x * off.x, k.y * off.y, k.z * off.z);
+                Joint {
+                    stiffness: gk * change,
+                    torque: gk * off,
+                    turn: matrix,
+                    curving: (-0.25 * held.dot(turn)).max(0.0),
+                }
+            })
+            .collect();
+
+        // Implicit Euler for each frame's and point's new velocities, a
+        // group (frame g, in its axes, and point g + 1) a row, factored as
+        // it goes: (M + h D + (h² + h β) H_bend + h² H_stretch) v' = M v
+        // + h F + h D air, the root's and follicle's known velocities moved
+        // right.
+        let elastic = h * h;
+        let viscous = h * h + h * rod.damping;
+        let identity = M3::diagonal(1.0);
+        let mut factors: Vec<(M6, V6)> = Vec::with_capacity(segs);
+        let mut d_last = M6::ZERO;
+        let mut y_last = (Vec3::splat(0.0), Vec3::splat(0.0));
+        for g in 0..segs {
+            let i = g + 1;
+            let seg = segments[g];
+            let next = segments.get(g + 1);
+            let after = joints.get(g + 1);
+            let m = point_mass(&lengths, i);
+            let velocity = (x[i] - previous[i]) * (1.0 / self.h_last);
+            let w = frames[2 * g + 1];
+            let spinning = seg.axes.transpose() * Vec3::new(w[0], w[1], w[2]);
+            // The air, across the point's tangent.
+            let mut tangent = seg.strain + seg.axis() * seg.length;
+            if let Some(next) = next {
+                tangent += next.strain + next.axis() * next.length;
+            }
+            let tangent = safe_normalize(tangent, seg.axis());
+            let relative = velocity - air;
+            let across = relative - tangent * relative.dot(tangent);
+            let speed = across.length();
+            let c = rod.drag * (speed + rod.drag_viscous * speed.cbrt());
+            let drag = (identity - M3::outer(tangent, tangent)) * (m * c);
+
+            let inertia = M3::scaling(Vec3::new(0.25, 0.25, 0.5)) * (lengths[g] * rod.gyration);
+            let lever = seg.lever() * seg.stiffness;
+            let local_strain = seg.axes.transpose() * seg.strain;
+            let mut bend = joints[g].second();
+            let mut torque = Vec3::new(0.0, 0.0, 1.0).cross(local_strain)
+                * (seg.stiffness * seg.length)
+                + joints[g].turn.transpose() * joints[g].torque;
+            if let Some(after) = after {
+                bend = bend + after.first();
+                torque -= after.torque;
+            }
+            let mut force = rod.gravity * m - seg.strain * seg.stiffness;
+            let mut pull = seg.stiffness;
+            if let Some(next) = next {
+                force += next.strain * next.stiffness;
+                pull += next.stiffness;
+            }
+            // Turning the frame across its axis: the shear's stiffness, and
+            // the tension's along it (which the Gauss-Newton part misses,
+            // and without which a stretched segment's light frame
+            // overshoots).
+            let across_axis = seg.length * (seg.length + local_strain.z.max(0.0));
+            let diagonal = M6 {
+                a: inertia
+                    + M3::scaling(Vec3::new(1.0, 1.0, 0.0))
+                        * (elastic * seg.stiffness * across_axis)
+                    + bend * viscous,
+                b: lever * elastic,
+                c: lever.transpose() * elastic,
+                d: identity * (m + elastic * pull) + drag * h,
+            };
+            let left = M6 {
+                a: joints[g].across() * viscous,
+                b: -(lever * elastic),
+                c: M3::ZERO,
+                d: -(identity * (elastic * seg.stiffness)),
+            };
+            let mut rhs = (
+                inertia * spinning + torque * h,
+                velocity * m + force * h + drag * air * h,
+            );
+            let left = if g == 0 {
+                let (p, q) = left.apply((follicle_spin, root_velocity));
+                rhs = (rhs.0 - p, rhs.1 - q);
+                M6::ZERO
+            } else {
+                left
+            };
+            // Block LDLᵀ: this row's L against the last row's D.
+            let l = left.mul(&d_last);
+            let d = diagonal.sub(&l.mul(&left.transpose()));
+            let d_inverse = d.inverse();
+            let ly = l.apply(y_last);
+            let y = (rhs.0 - ly.0, rhs.1 - ly.1);
+            factors.push((l, d_inverse.apply(y)));
+            d_last = d_inverse;
+            y_last = y;
+        }
+
+        // Back up the strand: each group's new velocities, then where its
+        // point goes, the head's push, and its frame's turn.
+        x[0] = root_to;
+        previous[0] = root_from;
+        let mut later = (Vec3::splat(0.0), Vec3::splat(0.0));
+        for g in (0..segs).rev() {
+            let mut u = factors[g].1;
+            if g + 1 < segs {
+                let lu = factors[g + 1].0.transpose().apply(later);
+                u = (u.0 - lu.0, u.1 - lu.1);
+            }
+            later = u;
+            let (w, v) = u;
+            let i = g + 1;
+            let (p, v) = self.contact(x[i] + v * h, v, rest[i]);
+            x[i] = p;
+            previous[i] = p - v * h;
+            let w = segments[g].axes * w;
+            let turned = Quat::exp(w * h)
+                .mul(Quat::from_array(frames[2 * g]))
+                .normalize();
+            frames[2 * g] = turned.to_array();
+            frames[2 * g + 1] = [w.x, w.y, w.z, 0.0];
+        }
+    }
+
+    /// Off the head, if `p` is in it: out to the offset -- or as near as
+    /// the groom has the point (`groomed`, the head's frame; even a little
+    /// in, where the groom's head and the collider's differ), hair lying on
+    /// the scalp staying as it lies -- the velocity into it stopped and the
+    /// sliding slowed by Coulomb friction, relative to the head's surface
+    /// there.
+    fn contact(&self, p: Vec3, v: Vec3, groomed: Vec3) -> (Vec3, Vec3) {
+        let Some(collider) = self.collider else {
+            return (p, v);
+        };
+        let local = self.to.unapply(p);
+        if collider.distance(local) >= self.offset {
+            return (p, v);
+        }
+        let offset = self.offset.min(collider.distance(groomed));
+        if collider.distance(local) >= offset {
+            return (p, v);
+        }
+        let out = push_out(collider, local, offset);
+        let normal = self.to.rotate(collider.query(out).1);
+        let p = self.to.apply(out);
+        // The head's own velocity there.
+        let surface = (p - self.from.apply(self.to.unapply(p))) * (1.0 / self.h);
+        let mut relative = v - surface;
+        let into = relative.dot(normal);
+        if into < 0.0 {
+            relative -= normal * into;
+            let sliding = relative.length();
+            if sliding > 1e-9 {
+                relative *= (1.0 - self.friction * -into / sliding).max(0.0);
+            }
+        }
+        (p, relative + surface)
+    }
+}
+
+/// The angular velocity turning `from` to `to` in `h` seconds.
+pub fn spin(from: Quat, to: Quat, h: f32) -> Vec3 {
+    let mut q = to.mul(from.conj());
+    if q.w < 0.0 {
+        q = Quat { v: -q.v, w: -q.w };
+    }
+    let s = q.v.length();
+    if s < 1e-9 {
+        return q.v * (2.0 / h);
+    }
+    q.v * (2.0 * s.atan2(q.w) / (s * h))
+}
+
+/// Each segment's frame for a strand at `x` whose rod rests as `shape`,
+/// groomed as `rest`, the head at `head`: the head-carried rest frame turned
+/// the least way from the groomed segment onto the segment now, not
+/// spinning; two slots a point.
+pub fn frames_along(
+    head: &Rigid,
+    rest: &[Vec3],
+    shape: &[[f32; 4]],
+    x: &[Vec3],
+    frames: &mut [[f32; 4]],
+) {
+    let q = rigid_rotation(head);
+    for j in 0..x.len().saturating_sub(1) {
+        let carried = q.mul(Quat::from_array(shape[2 * j]));
+        let groomed = head.rotate(safe_normalize(rest[j + 1] - rest[j], Vec3::down()));
+        let along = safe_normalize(x[j + 1] - x[j], groomed);
+        let turned = least_turn(groomed, along).mul(carried).normalize();
+        frames[2 * j] = turned.to_array();
+        frames[2 * j + 1] = [0.0; 4];
+    }
+}
+
+/// The least rotation taking unit `a` to unit `b`.
+fn least_turn(a: Vec3, b: Vec3) -> Quat {
+    let c = a.dot(b);
+    if c < -0.999_999 {
+        return Quat {
+            v: orthogonal(a),
+            w: 0.0,
+        };
+    }
+    Quat {
+        v: a.cross(b),
+        w: 1.0 + c,
+    }
+    .normalize()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The implicit step is only as good as its derivatives: the Darboux
+    /// vector changes with either frame's turn as `darboux` says.
+    #[test]
+    fn the_turn_changes_as_its_derivative_says() {
+        let a = Quat::exp(Vec3::new(0.3, -0.2, 0.5));
+        let b = Quat::exp(Vec3::new(-0.6, 0.9, 0.4)).mul(a);
+        let (turn, change, matrix) = darboux(a, b, Quat::IDENTITY);
+        let e = 1e-3;
+        for k in 0..3 {
+            let mut d = Vec3::splat(0.0);
+            d.set_axis(k, e);
+            let (by_a, _, _) = darboux(a.mul(Quat::exp(d)), b, Quat::IDENTITY);
+            let (by_b, _, _) = darboux(a, b.mul(Quat::exp(d)), Quat::IDENTITY);
+            let off_a = (by_a - turn) - change * d;
+            let off_b = (by_b - turn) + change * matrix * d;
+            assert!(
+                off_a.length() < 1e-5 && off_b.length() < 1e-5,
+                "{off_a:?} {off_b:?}"
+            );
+        }
+    }
+
+    /// A 6x6 block solve undoes its matrix.
+    #[test]
+    fn a_block_inverts() {
+        let m = M6 {
+            a: M3([
+                Vec3::new(4.0, 1.0, 0.5),
+                Vec3::new(1.0, 3.0, 0.2),
+                Vec3::new(0.5, 0.2, 2.0),
+            ]),
+            b: M3([
+                Vec3::new(0.3, 0.1, 0.0),
+                Vec3::new(0.2, 0.4, 0.1),
+                Vec3::new(0.0, 0.1, 0.5),
+            ]),
+            c: M3::ZERO,
+            d: M3::diagonal(5.0),
+        };
+        let m = M6 {
+            c: m.b.transpose(),
+            ..m
+        };
+        let v = (Vec3::new(1.0, 2.0, 3.0), Vec3::new(-1.0, 0.5, 2.0));
+        let (p, q) = m.inverse().apply(m.apply(v));
+        assert!((p - v.0).length() + (q - v.1).length() < 1e-5);
+    }
+}
