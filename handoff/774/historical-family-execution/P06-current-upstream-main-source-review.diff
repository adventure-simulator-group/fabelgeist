+//! Hair cards: the groom as a few thousand textured strips.
+//!
+//! Games far from the camera, and phones at any distance, cannot draw a
+//! hundred thousand strands. They draw cards: strips following the groom's
+//! locks, each showing a painted bundle of strands with transparency. Here
+//! the cards come from the groom itself rather than from an artist -- the
+//! strands are clustered into locks by the same guide map that clumps them
+//! ([`GuideMap`]), and each lock becomes a strip along its members' mean
+//! path, as wide as they spread across it, lying flat against the head
+//! (its face turned out from the head's centre), starting behind its middle
+//! root far enough to cover the scalp its lock grows from -- a card from
+//! the middle would leave the half of the lock behind it bare, as partings
+//! show -- and kept off the head where its few segments would cut through
+//! the curve of the scalp. The bundle it shows is one
+//! of a few variants in an atlas painted procedurally: wavy strands
+//! converging towards the tip, each with its own shade and depth in the
+//! bundle, mipmapped by coverage.
+
+use crate::identity::StrandId;
+use fabelgeist_math::Vec3;
+use rayon::prelude::*;
+
+use crate::collider::{Collider, keep_clear, push_out};
+use crate::occlusion::Occlusion;
+use crate::ops::{GuideMap, smoothstep};
+use crate::rng::{self, Rng};
+use crate::strands::{Strands, safe_normalize};
+
+#[derive(Clone, Copy, Debug)]
+pub struct CardSettings {
+    /// Width of a lock at the root, metres: smaller makes more cards.
+    pub size: f32,
+    /// Quads along each card.
+    pub segments: usize,
+    /// Scale on each card's measured width.
+    pub width_scale: f32,
+    /// Locks of fewer strands than this are left out.
+    pub min_strands: usize,
+}
+
+impl Default for CardSettings {
+    fn default() -> Self {
+        Self {
+            size: 0.009,
+            segments: 12,
+            width_scale: 1.3,
+            min_strands: 3,
+        }
+    }
+}
+
+/// One card vertex, as the card shader reads it.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct CardVertex {
+    pub position: [f32; 3],
+    /// Across the card, 0 to 1.
+    pub u: f32,
+    /// Along the lock, root to tip.
+    pub tangent: [f32; 3],
+    /// Along the card, 0 at the root.
+    pub v: f32,
+    /// The card's face.
+    pub normal: [f32; 3],
+    /// Which atlas variant.
+    pub variant: f32,
+    /// Per card, 0 to 1.
+    pub random: f32,
+    /// Baked sky visibility.
+    pub occlusion: f32,
+    pub pad: [f32; 2],
+}
+
+/// Cards as a triangle list.
+#[derive(Clone, Debug, Default)]
+pub struct CardMesh {
+    pub vertices: Vec<CardVertex>,
+    pub indices: Vec<u32>,
+    pub cards: usize,
+}
+
+impl CardMesh {
+    pub fn build(
+        strands: &Strands,
+        center: Vec3,
+        occlusion: Option<&Occlusion>,
+        body: Option<&dyn Collider>,
+        settings: &CardSettings,
+        variants: u32,
+    ) -> Self {
+        let map = GuideMap::new(strands, settings.size, 1.0, 0xCA4D);
+        let mut members: Vec<Vec<u32>> = vec![Vec::new(); strands.len()];
+        for (s, &g) in map.guide.iter().enumerate() {
+            members[g as usize].push(s as u32);
+        }
+        let segments = settings.segments.max(1);
+        let points = strands.points;
+        let cards: Vec<(Vec<CardVertex>, StrandId)> = map
+            .guides
+            .par_iter()
+            .filter_map(|&g| {
+                let lock = &members[g as usize];
+                if lock.len() < settings.min_strands {
+                    return None;
+                }
+                let at = |s: u32, t: f32| {
+                    let x = t * (points - 1) as f32;
+                    let i = (x as usize).min(points - 2);
+                    let strand = strands.strand(s as usize);
+                    strand[i].lerp(strand[i + 1], x - i as f32)
+                };
+                let mut spine: Vec<Vec3> = (0..=segments)
+                    .map(|j| {
+                        let t = j as f32 / segments as f32;
+                        lock.iter()
+                            .map(|&s| at(s, t))
+                            .fold(Vec3::default(), |a, b| a + b)
+                            * (1.0 / lock.len() as f32)
+                    })
+                    .collect();
+                // Back from the middle root over the roots behind it, on the
+                // scalp.
+                let ahead = safe_normalize(spine[1] - spine[0], Vec3::down());
+                let mut behind: Vec<f32> = lock
+                    .iter()
+                    .map(|&s| (spine[0] - strands.root(s as usize)).dot(ahead).max(0.0))
+                    .collect();
+                behind.sort_by(|a, b| a.total_cmp(b));
+                let back = behind[(behind.len() * 9 / 10).min(behind.len() - 1)].min(settings.size);
+                spine[0] -= ahead * back;
+                if let Some(body) = body {
+                    spine[0] = push_out(body, spine[0], 0.0005);
+                    keep_clear(body, &mut spine, 0.0015, 4);
+                }
+                let radius = lock
+                    .iter()
+                    .map(|&s| strands.radius[s as usize])
+                    .fold(0.0, f32::max);
+                let mut frames = Vec::with_capacity(segments + 1);
+                let mut widths = Vec::with_capacity(segments + 1);
+                for j in 0..=segments {
+                    let t = j as f32 / segments as f32;
+                    let tangent = safe_normalize(
+                        spine[(j + 1).min(segments)] - spine[j.saturating_sub(1)],
+                        Vec3::down(),
+                    );
+                    let out = safe_normalize(spine[j] - center, Vec3::up());
+                    let normal = safe_normalize(out - tangent * out.dot(tangent), Vec3::forward());
+                    let side = tangent.cross(normal);
+                    let mut spread: Vec<f32> = lock
+                        .iter()
+                        .map(|&s| (at(s, t) - spine[j]).dot(side).abs())
+                        .collect();
+                    spread.sort_by(|a, b| a.total_cmp(b));
+                    let p85 = spread[(spread.len() * 85 / 100).min(spread.len() - 1)];
+                    widths.push((2.0 * p85 + 4.0 * radius).clamp(0.0015, settings.size * 3.0));
+                    frames.push((tangent, normal, side));
+                }
+                // Smooth the widths along the card.
+                let raw = widths.clone();
+                for j in 1..segments {
+                    widths[j] = (raw[j - 1] + 2.0 * raw[j] + raw[j + 1]) * 0.25;
+                }
+                let id = strands.id[g as usize];
+                let variant = (rng::hash((id).word(), 0x7A) % variants.max(1)) as f32;
+                let random = rng::unit((id).word(), 0x7B);
+                let mut vertices = Vec::with_capacity((segments + 1) * 2);
+                for j in 0..=segments {
+                    let (tangent, normal, side) = frames[j];
+                    let half = widths[j] * 0.5 * settings.width_scale;
+                    // As light reaches the lock's outer strands, which are
+                    // what is seen: its middle is deeper in the hair.
+                    let occlusion = occlusion.map_or(1.0, |o| o.at(spine[j] + normal * 0.002));
+                    for (u, sign) in [(0.0, -1.0), (1.0, 1.0)] {
+                        vertices.push(CardVertex {
+                            position: (spine[j] + side * (half * sign)).to_array(),
+                            u,
+                            tangent: tangent.to_array(),
+                            v: j as f32 / segments as f32,
+                            normal: normal.to_array(),
+                            variant,
+                            random,
+                            occlusion,
+                            pad: [0.0; 2],
+                        });
+                    }
+                }
+                Some((vertices, id))
+            })
+            .collect();
+
+        let mut mesh = CardMesh::default();
+        for (vertices, _) in cards {
+            let base = mesh.vertices.len() as u32;
+            for j in 0..segments as u32 {
+                let (a, b, c, d) = (
+                    base + 2 * j,
+                    base + 2 * j + 1,
+                    base + 2 * j + 2,
+                    base + 2 * j + 3,
+                );
+                mesh.indices.extend_from_slice(&[a, c, b, b, c, d]);
+            }
+            mesh.vertices.extend(vertices);
+            mesh.cards += 1;
+        }
+        mesh
+    }
+}
+
+/// Painted strand bundles, side by side, with their mip chain.
+pub struct CardAtlas {
+    pub width: u32,
+    pub height: u32,
+    pub variants: u32,
+    /// RGBA8 per level: coverage, strand shade, depth in the bundle,
+    /// coverage again.
+    pub levels: Vec<Vec<u8>>,
+}
+
+impl CardAtlas {
+    /// `variants` bundles, each `width` by `height` texels.
+    pub fn paint(variants: u32, width: u32, height: u32, seed: u64) -> Self {
+        let atlas_width = width * variants;
+        let mut base = vec![0u8; (atlas_width * height * 4) as usize];
+        let columns: Vec<Vec<u8>> = (0..variants)
+            .into_par_iter()
+            .map(|v| paint_bundle(width, height, seed ^ (v as u64 * 0x9E37)))
+            .collect();
+        for (v, column) in columns.iter().enumerate() {
+            for y in 0..height {
+                let from = (y * width * 4) as usize;
+                let to = ((y * atlas_width + v as u32 * width) * 4) as usize;
+                base[to..to + (width * 4) as usize]
+                    .copy_from_slice(&column[from..from + (width * 4) as usize]);
+            }
+        }
+        let mut levels = vec![base];
+        let (mut w, mut h) = (atlas_width, height);
+        while w > 1 && h > 1 && levels.len() < 12 {
+            let previous = levels.last().unwrap();
+            let (nw, nh) = ((w / 2).max(1), (h / 2).max(1));
+            let mut next = vec![0u8; (nw * nh * 4) as usize];
+            for y in 0..nh {
+                for x in 0..nw {
+                    for c in 0..4 {
+                        let texel =
+                            |xx: u32, yy: u32| previous[((yy * w + xx) * 4 + c) as usize] as u32;
+                        let sum = texel(2 * x, 2 * y)
+                            + texel((2 * x + 1).min(w - 1), 2 * y)
+                            + texel(2 * x, (2 * y + 1).min(h - 1))
+                            + texel((2 * x + 1).min(w - 1), (2 * y + 1).min(h - 1));
+                        next[((y * nw + x) * 4 + c) as usize] = ((sum + 2) / 4) as u8;
+                    }
+                }
+            }
+            levels.push(next);
+            w = nw;
+            h = nh;
+        }
+        Self {
+            width: atlas_width,
+            height,
+            variants,
+            levels,
+        }
+    }
+}
+
+/// One bundle: strands down a `width` by `height` column, root at the top.
+fn paint_bundle(width: u32, height: u32, seed: u64) -> Vec<u8> {
+    let mut rng = Rng::new(seed);
+    let mut coverage = vec![0.0f32; (width * height) as usize];
+    let mut shade = vec![0.0f32; (width * height) as usize];
+    let mut depth = vec![0.0f32; (width * height) as usize];
+    let strands = 26 + rng.index(20);
+    let converge = rng.range(0.2, 0.6);
+    for _ in 0..strands {
+        let x0 = rng.range(0.1, 0.9);
+        let amplitude = rng.range(0.0, 0.035);
+        let frequency = rng.range(0.5, 3.0);
+        let phase = rng.range(0.0, std::f32::consts::TAU);
+        let end = rng.range(0.7, 1.0);
+        let start = rng.range(0.0, 0.05);
+        let root_width = rng.range(0.9, 1.6) * width as f32 / 64.0;
+        let tone = rng.next_f32();
+        let layer = rng.next_f32();
+        let path = |v: f32| {
+            let pull = smoothstep(0.2, 1.0, v) * converge;
+            let x = x0
+                + (0.5 - x0) * pull
+                + amplitude * (frequency * v * std::f32::consts::TAU + phase).sin();
+            [x * width as f32, v * height as f32]
+        };
+        let steps = height as usize * 2;
+        for k in 0..steps {
+            let v = start + (end - start) * k as f32 / steps as f32;
+            let [px, py] = path(v);
+            let taper = 1.0 - smoothstep(0.6, 1.0, (v - start) / (end - start)) * 0.7;
+            let r = (root_width * 0.5 * taper).max(0.35);
+            let (x0i, x1i) = ((px - r - 1.0).floor() as i32, (px + r + 1.0).ceil() as i32);
+            let y = py as i32;
+            if y < 0 || y >= height as i32 {
+                continue;
+            }
+            for x in x0i..=x1i {
+                // The column wraps, so bundles tile across wide cards.
+                let xw = x.rem_euclid(width as i32) as u32;
+                let d = (x as f32 + 0.5 - px).abs();
+                let c = (r + 0.5 - d).clamp(0.0, 1.0);
+                let i = (y as u32 * width + xw) as usize;
+                if c > coverage[i] || (c > 0.0 && layer < depth[i]) {
+                    coverage[i] = coverage[i].max(c);
+                    shade[i] = tone;
+                    depth[i] = layer;
+                }
+            }
+        }
+    }
+    let mut out = vec![0u8; (width * height * 4) as usize];
+    for i in 0..(width * height) as usize {
+        let c = (coverage[i] * 255.0).round() as u8;
+        out[i * 4] = c;
+        out[i * 4 + 1] = (shade[i] * 255.0) as u8;
+        out[i * 4 + 2] = (depth[i] * 255.0) as u8;
+        out[i * 4 + 3] = c;
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::identity::PartingGroup;
+    use crate::strands::Attachment;
+
+    #[test]
+    fn a_comb_of_strands_becomes_a_few_cards() {
+        let mut strands = Strands::new(16);
+        for i in 0..60 {
+            let x = (i % 30) as f32 * 0.001 + (i / 30) as f32 * 0.05;
+            let positions: Vec<Vec3> = (0..16)
+                .map(|j| Vec3::new(x, 0.1 - j as f32 * 0.01, 0.1))
+                .collect();
+            strands.push(
+                &positions,
+                Attachment {
+                    id: StrandId::from_word(i),
+                    group: PartingGroup::Unassigned,
+                    radius: 3e-5,
+                    ..Default::default()
+                },
+            );
+        }
+        let mesh = CardMesh::build(
+            &strands,
+            Vec3::default(),
+            None,
+            None,
+            &CardSettings {
+                size: 0.02,
+                ..Default::default()
+            },
+            4,
+        );
+        assert!(mesh.cards >= 2 && mesh.cards <= 8, "{}", mesh.cards);
+        assert_eq!(mesh.indices.len(), mesh.cards * 12 * 6);
+        let atlas = CardAtlas::paint(4, 32, 128, 1);
+        assert_eq!(
+            atlas.levels[0].len(),
+            (atlas.width * atlas.height * 4) as usize
+        );
+        assert!(atlas.levels[0].chunks(4).any(|t| t[0] > 200));
+    }
+}
--- before/crates/fabelgeist-hair/src/collider.rs
+++ after/crates/fabelgeist-hair/src/collider.rs
@@ -0,0 +1,171 @@
+//! What strands must stay outside of.
+//!
+//! The pipeline keeps hair out of the body twice: shrinkwrap pushes points
+//! that sank below the surface back onto it, and the drape collides every
+//! point it moves. Both need the same query -- how far a point is from the
+//! body, signed, and which way is out -- which a distance field answers
+//! directly ([`crate::Head`]) and a mesh answers through its closest
+//! triangle ([`MeshCollider`]).
+
+use fabelgeist_bvh::TriangleBvh;
+use fabelgeist_math::Vec3;
+
+use crate::surface::vertex_normals;
+
+pub trait Collider: Sync {
+    /// Signed distance to the surface (negative inside) and the outward
+    /// direction at the closest point.
+    fn query(&self, p: Vec3) -> (f32, Vec3);
+
+    /// Signed distance alone, where that is cheaper.
+    fn distance(&self, p: Vec3) -> f32 {
+        self.query(p).0
+    }
+}
+
+/// Move `p` until it is at least `offset` outside, stepping along the
+/// outward direction. A distance field built from smooth unions is only a
+/// bound inside, and where two parts meet (an ear on the head) its gradient
+/// can point into the other part, so a single step is not always enough.
+pub fn push_out(collider: &(impl Collider + ?Sized), mut p: Vec3, offset: f32) -> Vec3 {
+    for _ in 0..6 {
+        if collider.distance(p) >= offset {
+            break;
+        }
+        let (distance, out) = collider.query(p);
+        p += out * (offset - distance + 1e-5);
+    }
+    p
+}
+
+/// Keep a coarse polyline -- a strand drawn with a few points, a card's
+/// spine -- off the body. Its points lie on the fine strand, which is off
+/// the body, but the straight segments between them cut the corners of a
+/// strand wrapping a curved scalp and sink into it: at a distance the hair
+/// there disappears, and the head looks bald. Wherever a segment comes
+/// nearer than `clearance`, its ends are pushed out until it does not; the
+/// root stays where it is, so a first segment is cleared by lifting its far
+/// end.
+pub fn keep_clear(
+    collider: &(impl Collider + ?Sized),
+    polyline: &mut [Vec3],
+    clearance: f32,
+    passes: usize,
+) {
+    let n = polyline.len();
+    if n < 2 {
+        return;
+    }
+    let mut push = vec![Vec3::default(); n];
+    let longer = |a: Vec3, b: Vec3| {
+        if b.length_squared() > a.length_squared() {
+            b
+        } else {
+            a
+        }
+    };
+    for _ in 0..passes {
+        push.iter_mut().for_each(|p| *p = Vec3::default());
+        let mut any = false;
+        let mut near = collider.distance(polyline[0]);
+        for i in 0..n - 1 {
+            let (a, b) = (polyline[i], polyline[i + 1]);
+            let far = collider.distance(b);
+            let reach = 0.5 * (b - a).length();
+            // A distance field changes no faster than distance: a segment
+            // whose ends are well clear cannot come near in between.
+            let closest = near.min(far);
+            near = far;
+            if closest - reach >= clearance {
+                continue;
+            }
+            for t in [0.25, 0.5, 0.75] {
+                let q = a.lerp(b, t);
+                let d = collider.distance(q);
+                if d >= clearance {
+                    continue;
+                }
+                any = true;
+                let (_, out) = collider.query(q);
+                let need = clearance - d;
+                if i == 0 {
+                    push[1] = longer(push[1], out * (need / t).min(0.01));
+                } else {
+                    push[i] = longer(push[i], out * need);
+                    push[i + 1] = longer(push[i + 1], out * need);
+                }
+            }
+        }
+        if !any {
+            break;
+        }
+        for (p, d) in polyline.iter_mut().zip(&push).skip(1) {
+            *p += *d;
+        }
+    }
+}
+
+/// A closed triangle mesh as a collider: distance to its closest triangle,
+/// signed by the side of that triangle the point is on (by the
+/// angle-weighted pseudo-normal of its closest feature, approximated by the
+/// interpolated vertex normals).
+pub struct MeshCollider {
+    bvh: TriangleBvh,
+    positions: Vec<Vec3>,
+    normals: Vec<Vec3>,
+    triangles: Vec<[u32; 3]>,
+    /// Queries further than this report "far outside".
+    reach: f32,
+}
+
+impl MeshCollider {
+    pub fn new(positions: Vec<Vec3>, triangles: Vec<[u32; 3]>, reach: f32) -> Self {
+        let normals = vertex_normals(&positions, &triangles);
+        Self {
+            bvh: TriangleBvh::new(positions.clone(), triangles.clone()),
+            positions,
+            normals,
+            triangles,
+            reach,
+        }
+    }
+}
+
+impl Collider for MeshCollider {
+    fn query(&self, p: Vec3) -> (f32, Vec3) {
+        let Some((t, closest, distance)) = self.bvh.closest_point(p, self.reach) else {
+            return (self.reach, Vec3::up());
+        };
+        let [a, b, c] = self.triangles[t as usize];
+        let w = crate::surface::barycentric(
+            closest,
+            self.positions[a as usize],
+            self.positions[b as usize],
+            self.positions[c as usize],
+        );
+        let normal = (self.normals[a as usize] * w[0]
+            + self.normals[b as usize] * w[1]
+            + self.normals[c as usize] * w[2])
+            .normalize();
+        let outside = (p - closest).dot(normal) >= 0.0;
+        let away = if distance > 1e-7 {
+            (p - closest) * (1.0 / distance)
+        } else {
+            normal
+        };
+        if outside {
+            (distance, away)
+        } else {
+            (-distance, -away)
+        }
+    }
+}
+
+/// Nothing to collide with.
+pub struct NoCollider;
+
+impl Collider for NoCollider {
+    fn query(&self, _: Vec3) -> (f32, Vec3) {
+        (f32::INFINITY, Vec3::up())
+    }
+}
--- before/crates/fabelgeist-hair/src/cover.rs
+++ after/crates/fabelgeist-hair/src/cover.rs
@@ -0,0 +1,173 @@
+//! How much hair covers the skin: what makes a scalp read as a head of hair
+//! and not as bald skin between strands.
+//!
+//! Hair covers the scalp two ways. It grows from it -- a hundred and more
+//! follicles a square centimetre, each dark with pigment and with the first
+//! millimetre of its hair -- and it lies over it, in layers, so the skin
+//! beneath is in the hair's shadow. Strands drawn as ribbons only ever show
+//! the second, sparsely: between them the skin shows as if lit, bare and
+//! pale, at every part and whorl and wherever locks gather. Every hair
+//! renderer paints the scalp under the hair for this; here it is measured
+//! from the groom. [`ScalpCover::at`] gives, for points on the skin, how
+//! densely roots grow around each and how much hair lies over it (the
+//! chance a line straight out from the skin meets a strand in the first
+//! couple of centimetres), and the head is shaded by it.
+
+use crate::identity::PartingGroup;
+use fabelgeist_math::Vec3;
+use rayon::prelude::*;
+
+use crate::grid::PointGrid;
+use crate::strands::Strands;
+
+/// Around how far from a point of skin its roots count, metres.
+const ROOT_RADIUS: f32 = 0.004;
+/// The hair density grid's cell, metres.
+const CELL: f32 = 0.004;
+/// How far out from the skin hair counts as over it, metres.
+const REACH: f32 = 0.024;
+
+pub struct ScalpCover {
+    roots: PointGrid,
+    lo: Vec3,
+    dims: [usize; 3],
+    /// Hair's optical density per cell: projected strand area per volume,
+    /// per metre -- the expected number of strands a line crosses a metre.
+    density: Vec<f32>,
+}
+
+impl ScalpCover {
+    pub fn new(strands: &Strands) -> Self {
+        let roots = PointGrid::build(
+            &(0..strands.len())
+                .map(|s| (strands.root(s), PartingGroup::Unassigned))
+                .collect::<Vec<_>>(),
+            ROOT_RADIUS,
+        );
+        let [lo, hi] = strands.bounds();
+        let lo = lo - Vec3::splat(REACH);
+        let hi = hi + Vec3::splat(REACH);
+        let extent = hi - lo;
+        let dims = [extent.x, extent.y, extent.z].map(|e| ((e / CELL).ceil() as usize).max(1));
+        let mut density = vec![0.0f32; dims[0] * dims[1] * dims[2]];
+        let volume = CELL * CELL * CELL;
+        for s in 0..strands.len() {
+            let diameter = 2.0 * strands.radius[s].max(1e-6);
+            for pair in strands.strand(s).windows(2) {
+                let mid = (pair[0] + pair[1]) * 0.5;
+                if let Some(i) = index(lo, dims, mid) {
+                    density[i] += (pair[1] - pair[0]).length() * diameter / volume;
+                }
+            }
+        }
+        Self {
+            roots,
+            lo,
+            dims,
+            density,
+        }
+    }
+
+    /// How much hair covers each point of skin (normal `normals`), each 0
+    /// to 1: how densely roots grow around it -- by the share of the densest
+    /// growth over these points -- and how much of it the hair over it
+    /// hides. Roots colour the skin, as a scalp; hair over any skin shades
+    /// it, a scalp or a forehead under a fringe.
+    pub fn at(&self, points: &[Vec3], normals: &[Vec3]) -> Vec<[f32; 2]> {
+        let counts: Vec<usize> = points
+            .par_iter()
+            .map(|&p| self.roots.count_within(p, ROOT_RADIUS))
+            .collect();
+        let mut growing: Vec<usize> = counts.iter().copied().filter(|&c| c > 0).collect();
+        growing.sort_unstable();
+        let full = growing
+            .get(growing.len() * 4 / 5)
+            .copied()
+            .unwrap_or(1)
+            .max(1) as f32;
+        points
+            .par_iter()
+            .zip(normals)
+            .zip(&counts)
+            .map(|((&p, &n), &count)| {
+                let grown = (count as f32 / full).min(1.0);
+                let steps = 8;
+                let ds = REACH / steps as f32;
+                let depth: f32 = (0..steps)
+                    .map(|k| {
+                        let q = p + n * (0.002 + (k as f32 + 0.5) * ds);
+                        self.density_at(q) * ds
+                    })
+                    .sum();
+                let over = 1.0 - (-depth).exp();
+                [grown, grown.max(over)]
+            })
+            .collect()
+    }
+
+    /// The hair's density at `p`, trilinear between cell centres.
+    fn density_at(&self, p: Vec3) -> f32 {
+        let q = (p - self.lo) * (1.0 / CELL) - Vec3::splat(0.5);
+        let base = [q.x.floor(), q.y.floor(), q.z.floor()];
+        let f = [q.x - base[0], q.y - base[1], q.z - base[2]];
+        let mut sum = 0.0;
+        for corner in 0..8 {
+            let o = [corner & 1, (corner >> 1) & 1, (corner >> 2) & 1];
+            let c: [i64; 3] = std::array::from_fn(|k| base[k] as i64 + o[k] as i64);
+            if c.iter()
+                .zip(self.dims)
+                .any(|(&v, d)| v < 0 || v >= d as i64)
+            {
+                continue;
+            }
+            let w: f32 = (0..3)
+                .map(|k| if o[k] == 1 { f[k] } else { 1.0 - f[k] })
+                .product();
+            let [x, y, z] = c.map(|v| v as usize);
+            sum += w * self.density[(z * self.dims[1] + y) * self.dims[0] + x];
+        }
+        sum
+    }
+}
+
+fn index(lo: Vec3, dims: [usize; 3], p: Vec3) -> Option<usize> {
+    let q = (p - lo) * (1.0 / CELL);
+    let c = [q.x, q.y, q.z];
+    if c.iter().zip(dims).any(|(&v, d)| v < 0.0 || v >= d as f32) {
+        return None;
+    }
+    let [x, y, z] = c.map(|v| v as usize);
+    Some((z * dims[1] + y) * dims[0] + x)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::strands::Attachment;
+
+    #[test]
+    fn skin_under_hair_is_covered_and_bare_skin_is_not() {
+        // A mat of strands lying along a flat scalp at y = 0, x < 0.
+        let mut strands = Strands::new(12);
+        for i in 0..400 {
+            let (x, z) = (-0.05 + (i % 20) as f32 * 0.0025, (i / 20) as f32 * 0.0025);
+            let positions: Vec<Vec3> = (0..12)
+                .map(|j| Vec3::new(x, 0.001, z + j as f32 * 0.004))
+                .collect();
+            strands.push(
+                &positions,
+                Attachment {
+                    radius: 4e-5,
+                    ..Default::default()
+                },
+            );
+        }
+        let cover = ScalpCover::new(&strands);
+        let at = cover.at(
+            &[Vec3::new(-0.025, 0.0, 0.02), Vec3::new(0.05, 0.0, 0.02)],
+            &[Vec3::up(), Vec3::up()],
+        );
+        assert!(at[0][0] > 0.8 && at[0][1] > 0.8, "{at:?}");
+        assert!(at[1][0] < 0.05 && at[1][1] < 0.05, "{at:?}");
+    }
+}
--- before/crates/fabelgeist-hair/src/dataset.rs
+++ after/crates/fabelgeist-hair/src/dataset.rs
@@ -0,0 +1,265 @@
+//! A synthetic dataset in DiffLocks' image: randomized grooms, their
+//! strands, their scalp density, and a picture of each.
+//!
+//! DiffLocks made 40K samples by running its Blender pipeline with 110
+//! parameters drawn at random -- base style, geometry, material -- then
+//! rendering each through a path tracer under a random HDRI, with a random
+//! camera (focal length 40 to 150 mm, aimed at the head). A [`Sample`] is one
+//! such draw here: the preset and its [`Look`], the material, the camera and
+//! the light, all recorded, so a sample can be grown again exactly.
+//!
+//! On disk the dataset is laid out as DiffLocks' is ([`crate::difflocks`]),
+//! so its loader reads ours: `body_data/scalp.ply` (the mannequin's scalp,
+//! with the UV map every root's `root_uv` is on) and the mannequin as
+//! `body_data/mannequin.ply` -- DiffLocks has the SMPL-X body there, as
+//! `smplx_base.ply` -- and a directory a sample,
+//! `generated_hairstyles/base_<preset>_idx_<index>/`, of
+//!
+//! * `full_strands.npz` -- `positions` (strands x 256 x 3), `root_uv`
+//!   (strands x 2) and `root_normal` (strands x 3), `float32`, metres, `y`
+//!   up. Positions are in the head's frame ([`crate::Head`]: origin between
+//!   the ears, face towards `+z`), not SMPL-X's, whose head is 30 cm higher.
+//! * `guide_strands.npz` -- the guides the sample grew from, likewise.
+//! * `density.png` -- the scalp's strand density (DiffLocks' density map):
+//!   roots per texel of the scalp UV map, blurred, normalised to 0 to 255.
+//! * `metadata.json` -- DiffLocks' keys for the material
+//!   ([`Sample::difflocks_metadata`]), and everything the sample was made
+//!   from under its own keys.
+//! * `cam.npz` -- the camera: `RT` (world to camera) and `K` (pixels).
+//! * `rgb.png` -- the render, when there is a GPU to make it.
+//! * `numpy_state.npz` -- last, as DiffLocks writes it: the sample is
+//!   complete. Here it holds the seed and the index.
+
+use serde::{Deserialize, Serialize};
+
+use crate::lod::LodPolicy;
+use crate::look::Look;
+use crate::material::HairMaterial;
+use crate::presets::Preset;
+use crate::rng::Rng;
+use crate::strands::Strands;
+
+/// Where a sample's picture is taken from and how it is lit.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Shot {
+    /// Around the head from the front, and above the horizon, radians.
+    pub yaw: f32,
+    pub pitch: f32,
+    /// Focal length on a 36 mm frame, millimetres.
+    pub focal_mm: f32,
+    /// How much of the frame the head fills, about one.
+    pub framing: f32,
+    /// The key light: around and above, radians, and its strength.
+    pub key_azimuth: f32,
+    pub key_elevation: f32,
+    pub key_intensity: f32,
+    pub exposure: f32,
+    pub skin: [f32; 3],
+}
+
+impl Shot {
+    pub fn random(rng: &mut Rng) -> Self {
+        let skin_tone = rng.next_f32();
+        let light_skin = [0.72, 0.53, 0.43];
+        let dark_skin = [0.22, 0.13, 0.09];
+        Self {
+            yaw: rng.range(-0.7, 0.7),
+            pitch: rng.range(-0.1, 0.3),
+            focal_mm: rng.range(40.0, 150.0),
+            framing: rng.range(0.9, 1.3),
+            key_azimuth: rng.range(-2.2, 2.2),
+            key_elevation: rng.range(0.1, 1.2),
+            key_intensity: rng.range(1.5, 4.0),
+            exposure: rng.range(0.6, 1.1),
+            skin: std::array::from_fn(|k| {
+                light_skin[k] + (dark_skin[k] - light_skin[k]) * skin_tone
+            }),
+        }
+    }
+
+    /// Vertical field of view, radians, on a 36 mm square frame.
+    pub fn fov_y(&self) -> f32 {
+        2.0 * (18.0 / self.focal_mm).atan()
+    }
+
+    /// Camera distance for the head to fill the frame as asked.
+    pub fn distance(&self) -> f32 {
+        0.2 * self.framing / (self.fov_y() * 0.5).tan()
+    }
+}
+
+/// One draw of the dataset.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Sample {
+    pub index: u64,
+    pub seed: u64,
+    pub preset: Preset,
+    pub look: Look,
+    pub material: HairMaterial,
+    pub shot: Shot,
+}
+
+impl Sample {
+    /// Sample `index` of a dataset seeded `seed`, from `presets`.
+    pub fn draw(seed: u64, index: u64, presets: &[Preset]) -> Self {
+        let mut rng = Rng::new(seed ^ index.wrapping_mul(0x9E37_79B9_7F4A_7C15));
+        let preset = presets[rng.index(presets.len())];
+        let look = Look::random(preset, &mut rng);
+        let material = HairMaterial {
+            // Darker hair is the more common.
+            melanin: rng.next_f32().powf(0.6),
+            redness: rng.range(0.0, 1.0).powf(1.5),
+            tint: if rng.chance(0.08) {
+                [
+                    rng.range(0.2, 1.0),
+                    rng.range(0.2, 1.0),
+                    rng.range(0.2, 1.0),
+                ]
+            } else {
+                [1.0; 3]
+            },
+            roughness: rng.range(0.2, 0.45),
+            radial_roughness: rng.range(0.25, 0.4),
+            random_color: rng.range(0.05, 0.2),
+            random_roughness: rng.range(0.1, 0.3),
+            tip_lightness: rng.range(0.0, 0.35),
+            grey: if rng.chance(0.12) {
+                rng.range(0.1, 0.9)
+            } else {
+                0.0
+            },
+            ..Default::default()
+        };
+        let mut material = material;
+        // DiffLocks' variations along the strand: roots darker, melanin in
+        // waves, now and then a coat.
+        if rng.chance(0.4) {
+            material.root_darkness_start = rng.range(0.0, 0.05);
+            material.root_darkness_end = material.root_darkness_start + rng.range(0.05, 0.3);
+            material.root_darkness_strength = rng.range(0.1, 0.8);
+        }
+        if rng.chance(0.35) {
+            material.wave_scale = rng.range(1.0, 30.0);
+            material.wave_phase = rng.range(0.0, 360.0);
+            material.wave_strength = rng.range(0.05, 0.3);
+        }
+        if rng.chance(0.2) {
+            material.coat = rng.range(0.0, 0.4);
+        }
+        Self {
+            index,
+            seed,
+            preset,
+            look,
+            material,
+            shot: Shot::random(&mut rng),
+        }
+    }
+
+    /// The material under the names DiffLocks' `metadata.json` gives it,
+    /// which its loaders read.
+    pub fn difflocks_metadata(&self) -> serde_json::Value {
+        let m = &self.material;
+        serde_json::json!({
+            "mirror_hair": false,
+            "material_melanin_amount": m.melanin,
+            "bsdf_melanin_redness": m.redness,
+            "bsdf_roughness": m.roughness,
+            "bsdf_radial_roughness": m.radial_roughness,
+            "bsdf_coat": m.coat,
+            "root_darkness_start": m.root_darkness_start,
+            "root_darkness_end": m.root_darkness_end,
+            "root_darkness_strength": m.root_darkness_strength,
+            "material_wave_scale": m.wave_scale,
+            "material_wave_phase_offset": m.wave_phase,
+            "material_wave_strength": m.wave_strength,
+        })
+    }
+
+    /// The camera's eye and target, in the head's frame.
+    pub fn eye(&self) -> ([f32; 3], [f32; 3]) {
+        let shot = &self.shot;
+        let d = shot.distance();
+        (
+            [
+                d * shot.pitch.cos() * shot.yaw.sin(),
+                d * shot.pitch.sin(),
+                d * shot.pitch.cos() * shot.yaw.cos(),
+            ],
+            [0.0; 3],
+        )
+    }
+
+    /// The policy a sample is drawn with: every strand, accumulated.
+    pub fn policy(frames: u32) -> LodPolicy {
+        let mut policy = LodPolicy::cinematic();
+        policy.quality.accumulate = frames.max(1);
+        policy
+    }
+}
+
+/// The scalp's strand density: roots per texel of a `size` square over the
+/// UV map, blurred once, scaled so the densest texel is 255.
+pub fn density_map(strands: &Strands, size: usize) -> Vec<u8> {
+    let mut counts = vec![0.0f32; size * size];
+    for uv in &strands.root_uv {
+        let x = ((uv[0].clamp(0.0, 1.0) * size as f32) as usize).min(size - 1);
+        let y = ((uv[1].clamp(0.0, 1.0) * size as f32) as usize).min(size - 1);
+        counts[y * size + x] += 1.0;
+    }
+    let mut blurred = vec![0.0f32; size * size];
+    for y in 0..size {
+        for x in 0..size {
+            let mut sum = 0.0;
+            let mut n = 0.0;
+            for dy in -1i32..=1 {
+                for dx in -1i32..=1 {
+                    let (xx, yy) = (x as i32 + dx, y as i32 + dy);
+                    if xx >= 0 && yy >= 0 && (xx as usize) < size && (yy as usize) < size {
+                        sum += counts[yy as usize * size + xx as usize];
+                        n += 1.0;
+                    }
+                }
+            }
+            blurred[y * size + x] = sum / n;
+        }
+    }
+    let max = blurred.iter().copied().fold(0.0, f32::max).max(1e-6);
+    blurred
+        .iter()
+        .map(|v| (v / max * 255.0).round() as u8)
+        .collect()
+}
+
+/// A grey image as binary PGM.
+pub fn pgm(width: usize, height: usize, pixels: &[u8]) -> Vec<u8> {
+    let mut out = format!("P5\n{width} {height}\n255\n").into_bytes();
+    out.extend_from_slice(pixels);
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn draws_are_reproducible_and_varied() {
+        let a = Sample::draw(7, 3, &Preset::ALL);
+        let b = Sample::draw(7, 3, &Preset::ALL);
+        assert_eq!(
+            serde_json::to_string(&a).unwrap(),
+            serde_json::to_string(&b).unwrap()
+        );
+        let presets: std::collections::HashSet<_> = (0..40)
+            .map(|i| Sample::draw(7, i, &Preset::ALL).preset)
+            .collect();
+        assert!(presets.len() > 5);
+        let shot = &a.shot;
+        assert!((40.0..=150.0).contains(&shot.focal_mm));
+        assert!(
+            shot.distance() > 0.2 && shot.distance() < 3.0,
+            "{}",
+            shot.distance()
+        );
+    }
+}
