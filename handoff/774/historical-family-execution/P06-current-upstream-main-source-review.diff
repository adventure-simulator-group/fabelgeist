+    let length_ab = distance(scalp_points[key >> 16u].xyz, scalp_points[key & 0xFFFFu].xyz);
+    steps[k] = u32(max(ceil(length_ab / max(params.step, 1e-5)), 1.0));
+    fine[k] = u32(max(ceil(length_ab / max(params.fine_step, 1e-5)), 1.0));
+}
+"#,
+    )
+}
