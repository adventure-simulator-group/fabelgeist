+impl GpuGroomer {
+    pub fn new(context: WgpuContext) -> Result<Self> {
+        let cache = KernelCache::new();
+        let kernels = Kernels::new(&context, &cache)?;
+        let scan = PrefixSum::with_cache(&context, &cache)?;
+        let scan_scratch = PrefixSumScratch::new(&context, ScanElementCount::from_elements(1024))?;
+        let sort = RadixSort::with_cache(&context, &cache)?;
+        let sort_scratch = SortScratch::new(&context, 1024)?;
+        let grid = GpuHashGrid::new(&context, HashKernels::new(&context, &cache)?, 1024)?;
+        Ok(Self {
+            context,
+            kernels,
+            scan,
+            scan_scratch,
+            sort,
+            sort_scratch,
+            grid,
+            scratch: Scratches::default(),
+            head_mesh: None,
+            atlas: None,
+        })
+    }
+
+    pub fn context(&self) -> &WgpuContext {
+        &self.context
+    }
+
+    /// The head the hair is drawn on, to measure how much hair covers each
+    /// of its vertices ([`GpuLods::cover`]): its points, normals, and which
+    /// vertices neighbour which.
+    pub fn set_head_mesh(&mut self, surface: &Surface) -> Result<()> {
+        let n = surface.positions.len();
+        let mut neighbors: Vec<Vec<u32>> = vec![Vec::new(); n];
+        for t in &surface.triangles {
+            for &a in t {
+                for &b in t {
+                    if a != b && !neighbors[a as usize].contains(&b) {
+                        neighbors[a as usize].push(b);
+                    }
+                }
+            }
+        }
+        let mut start = Vec::with_capacity(n + 1);
+        let mut adjacency = Vec::new();
+        for list in &neighbors {
+            start.push(adjacency.len() as u32);
+            adjacency.extend_from_slice(list);
+        }
+        start.push(adjacency.len() as u32);
+        let four = |v: &[Vec3]| {
+            v.iter()
+                .map(|p| [p.x, p.y, p.z, 0.0])
+                .collect::<Vec<[f32; 4]>>()
+        };
+        self.head_mesh = Some(HeadMesh {
+            vertices: n as u32,
+            points: upload(
+                &self.context,
+                &four(&surface.positions),
+                "hair head points".into(),
+            )?,
+            normals: upload(
+                &self.context,
+                &four(&surface.normals),
+                "hair head normals".into(),
+            )?,
+            adjacency_start: upload(&self.context, &start, "hair head adjacency start".into())?,
+            adjacency: upload(&self.context, &adjacency, "hair head adjacency".into())?,
+        });
+        Ok(())
+    }
+
+    /// Strands already grown -- a DiffLocks sample, say -- onto the GPU, to
+    /// be prepared for drawing like a groom grown there.
+    pub fn upload(&self, strands: &Strands, head: Option<&Head>) -> Result<GpuGroom> {
+        let n = strands.len();
+        let positions: Vec<[f32; 4]> = strands
+            .positions
+            .iter()
+            .map(|p| [p.x, p.y, p.z, 0.0])
+            .collect();
+        let attributes: Vec<StrandGpu> = (0..n)
+            .map(|s| {
+                let a = strands.attachment(s);
+                StrandGpu {
+                    normal: a.normal.to_array(),
+                    id: (a.id).word(),
+                    uv: a.uv,
+                    group: (a.group).gpu_word(),
+                    radius: a.radius,
+                }
+            })
+            .collect();
+        let roots: Vec<[f32; 4]> = (0..n)
+            .map(|s| {
+                let r = strands.root(s);
+                [r.x, r.y, r.z, 1.0]
+            })
+            .collect();
+        let [lo, hi] = strands.bounds();
+        let (mut root_lo, mut root_hi) =
+            (Vec3::splat(f32::INFINITY), Vec3::splat(f32::NEG_INFINITY));
+        for s in 0..n {
+            root_lo = root_lo.min(strands.root(s));
+            root_hi = root_hi.max(strands.root(s));
+        }
+        Ok(GpuGroom {
+            strands: n as u32,
+            points: strands.points as u32,
+            positions: upload(&self.context, &positions, "hair positions".into())?,
+            attributes: upload(&self.context, &attributes, "hair strands".into())?,
+            roots: upload(&self.context, &roots, "hair roots".into())?,
+            bounds: Some([lo, hi]),
+            root_bounds: [root_lo, root_hi],
+            head: head.cloned(),
+            guides: None,
+        })
+    }
+
+    /// Wait for everything submitted to finish.
+    pub fn finish(&self) {
+        let _ = self
+            .context
+            .device
+            .poll(wgpu::PollType::wait_indefinitely());
+    }
+
+    /// One word of `buffer`, `at` words in, read back.
+    fn read_word(&mut self, batch: KernelBatch, buffer: &Buffer, at: u32) -> Result<u32> {
+        Ok(self.read_words(batch, &[(buffer.clone(), at)])?[0])
+    }
+
+    /// Words of buffers (each `at` words in), read back after `batch` in
+    /// one wait.
+    fn read_words(&mut self, batch: KernelBatch, words: &[(Buffer, u32)]) -> Result<Vec<u32>> {
+        let mut batch = batch;
+        let out = self.scratch.word.fit(
+            &self.context,
+            ((words.len() as u64 * 4).max(16)).into(),
+            "hair readback words".into(),
+        )?;
+        for (k, (buffer, at)) in words.iter().enumerate() {
+            batch.encoder().copy_buffer_to_buffer(
+                &buffer.buffer,
+                *at as u64 * 4,
+                &out.buffer,
+                k as u64 * 4,
+                4,
+            );
+        }
+        batch.submit();
+        let values: Vec<u32> = pollster::block_on(out.read(&self.context))?;
+        if values.len() < words.len() {
+            return Err(HairGpuError::ShortReadback {
+                expected: (words.len() * std::mem::size_of::<u32>()).into(),
+                actual: (values.len() * std::mem::size_of::<u32>()).into(),
+            });
+        }
+        Ok(values[..words.len()].to_vec())
+    }
+
+    fn ensure_scan(&mut self, count: u32) -> Result<()> {
+        self.scan_scratch
+            .ensure(&self.context, ScanElementCount::from_elements(count))?;
+        Ok(())
+    }
+}
+
+impl GpuGroom {
+    /// The strands back on the host.
+    pub fn read(&self, context: &WgpuContext) -> Result<Strands> {
+        read_strands(
+            context,
+            &self.positions,
+            &self.attributes,
+            self.strands,
+            self.points,
+        )
+    }
+}
+
+/// `count` strands of `points` points back on the host.
+fn read_strands(
+    context: &WgpuContext,
+    positions: &Buffer,
+    attributes: &Buffer,
+    count: u32,
+    points: u32,
+) -> Result<Strands> {
+    let positions: Vec<[f32; 4]> = pollster::block_on(positions.read(context))?;
+    let attributes: Vec<StrandGpu> = pollster::block_on(attributes.read(context))?;
+    let points = points as usize;
+    let mut strands = Strands::with_capacity(points, count as usize);
+    let mut strand = vec![Vec3::default(); points];
+    for s in 0..count as usize {
+        for (j, p) in strand.iter_mut().enumerate() {
+            let q = positions[s * points + j];
+            *p = Vec3::new(q[0], q[1], q[2]);
+        }
+        let a = attributes[s];
+        strands.push(
+            &strand,
+            Attachment {
+                uv: a.uv,
+                normal: Vec3::from_array(a.normal),
+                id: StrandId::from_word(a.id),
+                group: PartingGroup::from_gpu_word(a.group),
+                radius: a.radius,
+            },
+        );
+    }
+    Ok(strands)
+}
+
+/// A device of its own, for grooming and drawing without a window.
+pub fn headless_context() -> Result<WgpuContext> {
+    pollster::block_on(async {
+        let instance = wgpu::Instance::new(wgpu::InstanceDescriptor {
+            backends: wgpu::Backends::all(),
+            ..wgpu::InstanceDescriptor::new_without_display_handle()
+        });
+        let adapter = instance
+            .request_adapter(&wgpu::RequestAdapterOptions {
+                power_preference: wgpu::PowerPreference::HighPerformance,
+                compatible_surface: None,
+                force_fallback_adapter: false,
+            })
+            .await
+            .map_err(HairGpuError::Adapter)?;
+        let limits = required_limits(&adapter);
+        let (device, queue) = adapter
+            .request_device(&wgpu::DeviceDescriptor {
+                label: Some("hair"),
+                required_features: wgpu::Features::empty(),
+                required_limits: limits,
+                memory_hints: wgpu::MemoryHints::Performance,
+                experimental_features: wgpu::ExperimentalFeatures::default(),
+                trace: Default::default(),
+            })
+            .await?;
+        Ok(WgpuContext::from_parts(
+            Arc::new(instance),
+            Arc::new(adapter),
+            Arc::new(device),
+            Arc::new(queue),
+        ))
+    })
+}
+
+/// The limits a device grooming on the GPU needs beyond wgpu's defaults:
+/// the largest buffers the adapter allows -- a full groom's positions are
+/// one buffer -- and as many of them to a kernel as it allows.
+pub fn required_limits(adapter: &wgpu::Adapter) -> wgpu::Limits {
+    let adapter_limits = adapter.limits();
+    wgpu::Limits {
+        max_buffer_size: adapter_limits.max_buffer_size,
+        max_storage_buffer_binding_size: adapter_limits.max_storage_buffer_binding_size,
+        max_storage_buffers_per_shader_stage: adapter_limits.max_storage_buffers_per_shader_stage,
+        ..Default::default()
+    }
+}
