index 000000000..ce2a375e8
--- /dev/null
+++ b/crates/fabelgeist-spatial-hash/src/gpu.rs
@@ -0,0 +1,406 @@
+//! The GPU grid: hash, radix sort and bucket ranges as compute passes.
+//!
+//! # Buffer layout
+//!
+//! * `points: array<vec4<f32>>` -- the caller's; `.xyz` is hashed, `.w` is
+//!   free for a radius or anything else.
+//! * `hash_indices: array<u32>` -- entry indices, grouped by bucket.
+//! * `hash_ranges: array<u32>` -- two words per bucket, `[begin, end)` into
+//!   `hash_indices`; `begin` is [`EMPTY`](crate::EMPTY) for an empty bucket.
+//!
+//! A kernel that queries the grid binds `hash_indices` and `hash_ranges` under
+//! those names ([`GpuHashGrid::bind`] does it), pastes [`HASH_WGSL`] and
+//! [`RANGE_WGSL`], and
+//! walks the cells around its point:
+//!
+//! ```wgsl
+//! let base = spatial_hash_cell(p, inverse_cell);
+//! for (var dz = -1; dz <= 1; dz++) { for (var dy = -1; dy <= 1; dy++) { for (var dx = -1; dx <= 1; dx++) {
+//!     let cell = base + vec3<i32>(dx, dy, dz);
+//!     let range = spatial_hash_range(cell, table_size);
+//!     for (var k = range.x; k < range.y; k++) {
+//!         let j = hash_indices[k];
+//!         if (any(spatial_hash_cell(points[j].xyz, inverse_cell) != cell)) { continue; }
+//!         // ... j is a neighbour candidate
+//!     }
+//! }}}
+//! ```
+
+use anyhow::{Result, anyhow};
+use fabelgeist_compute::{
+    FOLDED_INDEX_WGSL, Kernel, KernelBatch, KernelCache, RadixSort, SortScratch,
+};
+use fabelgeist_gpu::data::gpu::buffer::{Buffer, BufferDefinition};
+use fabelgeist_gpu::data::gpu::parameters::PassParameters;
+use fabelgeist_gpu::globals::WgpuContext;
+use std::sync::Arc;
+
+use crate::table_size_for;
+
+/// The cell and bucket functions alone, with no bindings.
+pub const HASH_WGSL: &str = r#"
+fn spatial_hash_cell(p: vec3<f32>, inverse_cell: f32) -> vec3<i32> {
+    return vec3<i32>(floor(p * inverse_cell));
+}
+
+fn spatial_hash_bucket(cell: vec3<i32>, table_size: u32) -> u32 {
+    let h = (u32(cell.x) * 73856093u) ^ (u32(cell.y) * 19349663u) ^ (u32(cell.z) * 83492791u);
+    return h & (table_size - 1u);
+}
+"#;
+
+/// The range lookup, for kernels to paste in after [`HASH_WGSL`]. Expects
+/// `hash_ranges: array<u32>` bound in the including kernel.
+pub const RANGE_WGSL: &str = r#"
+const SPATIAL_HASH_EMPTY: u32 = 0xFFFFFFFFu;
+
+// [begin, end) into `hash_indices`; empty when begin == end.
+fn spatial_hash_range(cell: vec3<i32>, table_size: u32) -> vec2<u32> {
+    let bucket = spatial_hash_bucket(cell, table_size);
+    let begin = hash_ranges[bucket * 2u];
+    if (begin == SPATIAL_HASH_EMPTY) {
+        return vec2<u32>(0u, 0u);
+    }
+    return vec2<u32>(begin, hash_ranges[bucket * 2u + 1u]);
+}
+"#;
+
+const PARAMS: &str = r#"
+struct HashParams {
+    count: u32,
+    table_size: u32,
+    inverse_cell: f32,
+    pad: u32,
+};
+"#;
+
+fn hash_source() -> String {
+    format!(
+        r#"
+@group(0) @binding(0) var<storage, read> points: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> hash_keys: array<u32>;
+@group(0) @binding(2) var<storage, read_write> hash_indices: array<u32>;
+{PARAMS}
+@group(0) @binding(3) var<uniform> params: HashParams;
+{HASH_WGSL}
+{FOLDED_INDEX_WGSL}
+
+@compute @workgroup_size(256)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {{
+    let i = folded_index(id, groups, 256u);
+    if (i >= params.count) {{
+        return;
+    }}
+    hash_keys[i] = spatial_hash_bucket(spatial_hash_cell(points[i].xyz, params.inverse_cell), params.table_size);
+    hash_indices[i] = i;
+}}
+"#
+    )
+}
+
+fn clear_source() -> String {
+    format!(
+        r#"
+@group(0) @binding(0) var<storage, read_write> hash_ranges: array<u32>;
+{PARAMS}
+@group(0) @binding(1) var<uniform> params: HashParams;
+{FOLDED_INDEX_WGSL}
+
+@compute @workgroup_size(256)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {{
+    let i = folded_index(id, groups, 256u);
+    if (i >= params.table_size) {{
+        return;
+    }}
+    hash_ranges[i * 2u] = 0xFFFFFFFFu;
+    hash_ranges[i * 2u + 1u] = 0xFFFFFFFFu;
+}}
+"#
+    )
+}
+
+fn ranges_source() -> String {
+    format!(
+        r#"
+@group(0) @binding(0) var<storage, read> hash_keys: array<u32>;
+@group(0) @binding(1) var<storage, read_write> hash_ranges: array<u32>;
+{PARAMS}
+@group(0) @binding(2) var<uniform> params: HashParams;
+{FOLDED_INDEX_WGSL}
+
+@compute @workgroup_size(256)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {{
+    let i = folded_index(id, groups, 256u);
+    if (i >= params.count) {{
+        return;
+    }}
+    let key = hash_keys[i];
+    if (i == 0u || hash_keys[i - 1u] != key) {{
+        hash_ranges[key * 2u] = i;
+    }}
+    if (i + 1u == params.count || hash_keys[i + 1u] != key) {{
+        hash_ranges[key * 2u + 1u] = i + 1u;
+    }}
+}}
+"#
+    )
+}
+
+/// The compiled passes, shareable between grids.
+#[derive(Clone, Debug)]
+pub struct HashKernels {
+    hash: Arc<Kernel>,
+    clear: Arc<Kernel>,
+    ranges: Arc<Kernel>,
+    sort: RadixSort,
+}
+
+impl HashKernels {
+    pub fn new(context: &WgpuContext, cache: &KernelCache) -> Result<Self> {
+        Ok(Self {
+            hash: cache.get(context, &hash_source())?,
+            clear: cache.get(context, &clear_source())?,
+            ranges: cache.get(context, &ranges_source())?,
+            sort: RadixSort::with_cache(context, cache)?,
+        })
+    }
+}
+
+/// A spatial hash over up to `capacity` points, built on the GPU.
+pub struct GpuHashGrid {
+    kernels: HashKernels,
+    capacity: u32,
+    table_size: u32,
+    count: u32,
+    inverse_cell: f32,
+    keys: Buffer,
+    pub indices: Buffer,
+    pub ranges: Buffer,
+    scratch: SortScratch,
+}
+
+impl GpuHashGrid {
+    pub fn new(context: &WgpuContext, kernels: HashKernels, capacity: u32) -> Result<Self> {
+        let capacity = capacity.max(1);
+        let table_size = table_size_for(capacity);
+        let storage = BufferDefinition::storage();
+        Ok(Self {
+            kernels,
+            capacity,
+            table_size,
+            count: 0,
+            inverse_cell: 1.0,
+            keys: Buffer::new(
+                context,
+                (capacity as u64 * 4).into(),
+                storage.clone().with_label(("hash keys").into()),
+            )?,
+            indices: Buffer::new(
+                context,
+                (capacity as u64 * 4).into(),
+                storage.clone().with_label(("hash indices").into()),
+            )?,
+            ranges: Buffer::new(
+                context,
+                (table_size as u64 * 8).into(),
+                storage.with_label(("hash ranges").into()),
+            )?,
+            scratch: SortScratch::new(context, capacity)?,
+        })
+    }
+
+    /// Reallocate if `capacity` no longer fits; returns whether it grew.
+    /// Grows by half again, so a slowly growing population does not
+    /// reallocate every step.
+    pub fn ensure_capacity(&mut self, context: &WgpuContext, capacity: u32) -> Result<bool> {
+        if capacity <= self.capacity {
+            return Ok(false);
+        }
+        let grown = capacity.max(self.capacity + self.capacity / 2);
+        *self = Self::new(context, self.kernels.clone(), grown)?;
+        Ok(true)
+    }
+
+    pub fn capacity(&self) -> u32 {
+        self.capacity
+    }
+
+    pub fn table_size(&self) -> u32 {
+        self.table_size
+    }
+
+    pub fn inverse_cell(&self) -> f32 {
+        self.inverse_cell
+    }
+
+    pub fn count(&self) -> u32 {
+        self.count
+    }
+
+    fn params(&self, count: u32) -> PassParameters {
+        let mut parameters = PassParameters::new();
+        parameters.insert("count", count);
+        parameters.insert("table_size", self.table_size);
+        parameters.insert("inverse_cell", self.inverse_cell);
+        parameters.insert("pad", 0u32);
+        parameters
+    }
+
+    /// Record a build over the first `count` entries of `points`
+    /// (`array<vec4<f32>>`), in cells of side `cell_size`.
+    pub fn record_build(
+        &mut self,
+        batch: &mut KernelBatch,
+        points: &Buffer,
+        count: u32,
+        cell_size: f32,
+    ) -> Result<()> {
+        if count > self.capacity {
+            return Err(anyhow!(
+                "GpuHashGrid: built for {} points, asked for {count}",
+                self.capacity
+            ));
+        }
+        self.count = count;
+        self.inverse_cell = 1.0 / cell_size.max(f32::MIN_POSITIVE);
+
+        let mut clear = self.params(count);
+        clear.insert("hash_ranges", self.ranges.clone());
+        batch.dispatch_folded(&self.kernels.clear, &clear, self.table_size)?;
+        if count == 0 {
+            return Ok(());
+        }
+
+        let mut hash = self.params(count);
+        hash.insert("points", points.clone());
+        hash.insert("hash_keys", self.keys.clone());
+        hash.insert("hash_indices", self.indices.clone());
+        batch.dispatch_folded(&self.kernels.hash, &hash, count)?;
+
+        let bits = self.table_size.trailing_zeros();
+        self.kernels.sort.record(
+            batch,
+            &self.keys,
+            &self.indices,
+            &mut self.scratch,
+            count,
+            bits,
+        )?;
+
+        let mut ranges = self.params(count);
+        ranges.insert("hash_keys", self.keys.clone());
+        ranges.insert("hash_ranges", self.ranges.clone());
+        batch.dispatch_folded(&self.kernels.ranges, &ranges, count)?;
+        Ok(())
+    }
+
+    /// Bind `hash_indices` and `hash_ranges` for a querying kernel.
+    pub fn bind(&self, parameters: &mut PassParameters) {
+        parameters.insert("hash_indices", self.indices.clone());
+        parameters.insert("hash_ranges", self.ranges.clone());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::HashGrid;
+    use fabelgeist_gpu::prelude::BufferUpload;
+
+    const COUNT_KERNEL: &str = r#"
+@group(0) @binding(0) var<storage, read> points: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> hash_indices: array<u32>;
+@group(0) @binding(2) var<storage, read> hash_ranges: array<u32>;
+@group(0) @binding(3) var<storage, read_write> counts: array<u32>;
+struct QueryParams {
+    count: u32,
+    table_size: u32,
+    inverse_cell: f32,
+    radius: f32,
+};
+@group(0) @binding(4) var<uniform> params: QueryParams;
+"#;
+
+    const COUNT_MAIN: &str = r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>) {
+    let i = id.x;
+    if (i >= params.count) { return; }
+    let p = points[i].xyz;
+    let base = spatial_hash_cell(p, params.inverse_cell);
+    var n = 0u;
+    for (var dz = -1; dz <= 1; dz++) { for (var dy = -1; dy <= 1; dy++) { for (var dx = -1; dx <= 1; dx++) {
+        let cell = base + vec3<i32>(dx, dy, dz);
+        let range = spatial_hash_range(cell, params.table_size);
+        for (var k = range.x; k < range.y; k++) {
+            let j = hash_indices[k];
+            if (any(spatial_hash_cell(points[j].xyz, params.inverse_cell) != cell)) { continue; }
+            if (distance(points[j].xyz, p) <= params.radius) { n += 1u; }
+        }
+    }}}
+    counts[i] = n;
+}
+"#;
+
+    #[tokio::test]
+    async fn gpu_neighbour_counts_match_the_host_grid() -> Result<()> {
+        let context = WgpuContext::new().await?;
+        let cache = KernelCache::new();
+        let kernels = HashKernels::new(&context, &cache)?;
+
+        let mut state = 12345u32;
+        let mut next = || {
+            state ^= state << 13;
+            state ^= state >> 17;
+            state ^= state << 5;
+            (state as f32 / u32::MAX as f32) * 16.0 - 8.0
+        };
+        let points: Vec<[f32; 4]> = (0..5000).map(|_| [next(), next(), next(), 0.0]).collect();
+        let radius = 0.9;
+
+        let buffer = Buffer::from_upload(
+            &context,
+            BufferUpload::from_elements(&points),
+            BufferDefinition::storage(),
+        )?;
+        let counts = Buffer::new(
+            &context,
+            (points.len() as u64 * 4).into(),
+            BufferDefinition::storage(),
+        )?;
+        let mut grid = GpuHashGrid::new(&context, kernels, points.len() as u32)?;
+
+        let kernel = Kernel::new(
+            &context,
+            format!("{COUNT_KERNEL}{HASH_WGSL}{RANGE_WGSL}{COUNT_MAIN}"),
+        )?;
+        let mut batch = KernelBatch::new(&context);
+        grid.record_build(&mut batch, &buffer, points.len() as u32, radius)?;
+        let mut parameters = PassParameters::new();
+        parameters.insert("points", buffer.clone());
+        parameters.insert("counts", counts.clone());
+        parameters.insert("count", points.len() as u32);
+        parameters.insert("table_size", grid.table_size());
+        parameters.insert("inverse_cell", grid.inverse_cell());
+        parameters.insert("radius", radius);
+        grid.bind(&mut parameters);
+        batch.dispatch_items(&kernel, &parameters, points.len() as u32)?;
+        batch.submit();
+
+        let gpu: Vec<u32> = counts.read(&context).await?;
+        let host = HashGrid::new(points.iter().map(|p| [p[0], p[1], p[2]]), radius);
+        for (i, p) in points.iter().enumerate() {
+            let mut n = 0;
+            host.for_each_near([p[0], p[1], p[2]], 1, |j| {
+                let q = points[j as usize];
+                let d =
+                    ((p[0] - q[0]).powi(2) + (p[1] - q[1]).powi(2) + (p[2] - q[2]).powi(2)).sqrt();
+                if d <= radius {
+                    n += 1;
+                }
+            });
+            assert_eq!(gpu[i], n, "point {i}");
+        }
+        Ok(())
+    }
+}
diff --git a/crates/fabelgeist-spatial-hash/src/host.rs b/crates/fabelgeist-spatial-hash/src/host.rs
new file mode 100644
index 000000000..849b9dbed
--- /dev/null
+++ b/crates/fabelgeist-spatial-hash/src/host.rs
@@ -0,0 +1,163 @@
+//! The host grid.
+
+use crate::{EMPTY, bucket_of, cell_of, table_size_for};
+
+/// Spheres (or points) hashed into a uniform grid.
+///
+/// Built with a counting sort over buckets, so a build is two linear passes
+/// and no allocation beyond the tables themselves when reused through
+/// [`HashGrid::rebuild`].
+#[derive(Clone, Debug, Default)]
+pub struct HashGrid {
+    inverse_cell: f32,
+    table_size: u32,
+    /// Each entry's own cell, to reject bucket collisions.
+    cells: Vec<[i32; 3]>,
+    /// Entry indices, grouped by bucket.
+    sorted: Vec<u32>,
+    /// `[begin, end)` into `sorted` per bucket; `begin == EMPTY` if empty.
+    ranges: Vec<[u32; 2]>,
+    buckets: Vec<u32>,
+}
+
+impl HashGrid {
+    /// Hash `points` (the centres) into cells of side `cell_size`.
+    pub fn new(points: impl ExactSizeIterator<Item = [f32; 3]>, cell_size: f32) -> Self {
+        let mut grid = Self::default();
+        grid.rebuild(points, cell_size);
+        grid
+    }
+
+    /// Rebuild in place, reusing the tables.
+    pub fn rebuild(&mut self, points: impl ExactSizeIterator<Item = [f32; 3]>, cell_size: f32) {
+        let count = points.len();
+        self.inverse_cell = 1.0 / cell_size.max(f32::MIN_POSITIVE);
+        self.table_size = table_size_for(count as u32);
+        self.cells.clear();
+        self.buckets.clear();
+        self.ranges.clear();
+        self.ranges.resize(self.table_size as usize, [0, 0]);
+
+        for point in points {
+            let cell = cell_of(point, self.inverse_cell);
+            let bucket = bucket_of(cell, self.table_size);
+            self.cells.push(cell);
+            self.buckets.push(bucket);
+            self.ranges[bucket as usize][1] += 1;
+        }
+
+        // Exclusive scan of the counts into run starts.
+        let mut offset = 0u32;
+        for range in &mut self.ranges {
+            let n = range[1];
+            *range = if n == 0 {
+                [EMPTY, EMPTY]
+            } else {
+                [offset, offset]
+            };
+            offset += n;
+        }
+
+        self.sorted.clear();
+        self.sorted.resize(count, 0);
+        for (index, &bucket) in self.buckets.iter().enumerate() {
+            let range = &mut self.ranges[bucket as usize];
+            self.sorted[range[1] as usize] = index as u32;
+            range[1] += 1;
+        }
+    }
+
+    pub fn len(&self) -> usize {
+        self.cells.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.cells.is_empty()
+    }
+
+    pub fn cell_size(&self) -> f32 {
+        1.0 / self.inverse_cell
+    }
+
+    /// Call `visit` with every entry whose cell lies within `reach` cells of
+    /// the one `point` is in, along every axis. `reach` of one is the usual
+    /// 27-cell neighbourhood, which covers every entry within one cell size.
+    pub fn for_each_near(&self, point: [f32; 3], reach: i32, mut visit: impl FnMut(u32)) {
+        if self.cells.is_empty() {
+            return;
+        }
+        let base = cell_of(point, self.inverse_cell);
+        for dz in -reach..=reach {
+            for dy in -reach..=reach {
+                for dx in -reach..=reach {
+                    let cell = [base[0] + dx, base[1] + dy, base[2] + dz];
+                    let [begin, end] = self.ranges[bucket_of(cell, self.table_size) as usize];
+                    if begin == EMPTY {
+                        continue;
+                    }
+                    for &entry in &self.sorted[begin as usize..end as usize] {
+                        if self.cells[entry as usize] == cell {
+                            visit(entry);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn lattice() -> Vec<[f32; 3]> {
+        let mut points = Vec::new();
+        let mut state = 0x9e37_79b9u32;
+        for _ in 0..2000 {
+            let mut next = || {
+                state ^= state << 13;
+                state ^= state >> 17;
+                state ^= state << 5;
+                (state as f32 / u32::MAX as f32) * 20.0 - 10.0
+            };
+            points.push([next(), next(), next()]);
+        }
+        points
+    }
+
+    #[test]
+    fn finds_exactly_the_neighbours_brute_force_finds() {
+        let points = lattice();
+        let radius = 1.3;
+        let grid = HashGrid::new(points.iter().copied(), radius);
+        for (i, p) in points.iter().enumerate().step_by(37) {
+            let mut found = Vec::new();
+            grid.for_each_near(*p, 1, |j| {
+                let q = points[j as usize];
+                let d2 = (0..3).map(|k| (p[k] - q[k]).powi(2)).sum::<f32>();
+                if d2 <= radius * radius {
+                    found.push(j);
+                }
+            });
+            found.sort_unstable();
+            let brute: Vec<u32> = points
+                .iter()
+                .enumerate()
+                .filter(|(_, q)| {
+                    (0..3).map(|k| (p[k] - q[k]).powi(2)).sum::<f32>() <= radius * radius
+                })
+                .map(|(j, _)| j as u32)
+                .collect();
+            assert_eq!(found, brute, "point {i}");
+        }
+    }
+
+    #[test]
+    fn visits_each_entry_once() {
+        let points = lattice();
+        let grid = HashGrid::new(points.iter().copied(), 3.0);
+        let mut seen = vec![0u32; points.len()];
+        grid.for_each_near([0.0; 3], 4, |j| seen[j as usize] += 1);
+        assert!(seen.iter().all(|&n| n <= 1));
+    }
+}
diff --git a/crates/fabelgeist-spatial-hash/src/lib.rs b/crates/fabelgeist-spatial-hash/src/lib.rs
new file mode 100644
index 000000000..53cc39e6e
--- /dev/null
+++ b/crates/fabelgeist-spatial-hash/src/lib.rs
@@ -0,0 +1,67 @@
+//! Uniform-grid spatial hashing of spheres.
+//!
+//! Many solvers ask the same question of a cloud of spheres: *which of them are
+//! near this one?* Cloth self-collision asks it of particles, a plant ecosystem
+//! asks it of the bounding spheres of its branch modules. The answer is the
+//! same structure every time: hash each sphere's centre into a grid cell, sort
+//! by bucket, and remember where each bucket's run begins and ends. A query
+//! then walks the 27 cells around a point.
+//!
+//! Two builds of it:
+//!
+//! * [`HashGrid`] -- on the host, with a counting sort. The oracle the GPU
+//!   build is checked against, and the path for scenes too small to be worth a
+//!   dispatch.
+//! * [`gpu::GpuHashGrid`] -- hash, radix sort and bucket ranges as compute
+//!   passes recorded into a caller's [`fabelgeist_compute::KernelBatch`]. Its query
+//!   is published as WGSL source ([`gpu::HASH_WGSL`], [`gpu::RANGE_WGSL`]) so that a kernel can walk
+//!   the grid itself, without a round trip.
+//!
+//! Both use the same hash, so a bucket index means the same thing on either
+//! side. Distinct cells can share a bucket; a query rejects the entries whose
+//! own cell is not the one it asked for, so a collision costs a comparison and
+//! never a duplicate.
+//!
+//! [`overlap`] holds the sphere-sphere intersection volume, on the host and in
+//! WGSL, because "how much do these spheres overlap" is what most callers do
+//! with the neighbours they find.
+
+pub mod host;
+pub mod overlap;
+
+#[cfg(feature = "gpu")]
+pub mod gpu;
+
+pub use host::HashGrid;
+pub use overlap::{SPHERE_OVERLAP_WGSL, sphere_overlap_volume, sphere_volume};
+
+/// Marks an empty bucket in the range table.
+pub const EMPTY: u32 = u32::MAX;
+
+/// The integer cell a point falls into.
+#[inline]
+pub fn cell_of(point: [f32; 3], inverse_cell: f32) -> [i32; 3] {
+    [
+        (point[0] * inverse_cell).floor() as i32,
+        (point[1] * inverse_cell).floor() as i32,
+        (point[2] * inverse_cell).floor() as i32,
+    ]
+}
+
+/// The bucket a cell hashes to. `table_size` must be a power of two.
+///
+/// Three large odd primes, the usual spatial hash; the WGSL in
+/// [`gpu::HASH_WGSL`] is the same function word for word.
+#[inline]
+pub fn bucket_of(cell: [i32; 3], table_size: u32) -> u32 {
+    let h = (cell[0] as u32).wrapping_mul(73_856_093)
+        ^ (cell[1] as u32).wrapping_mul(19_349_663)
+        ^ (cell[2] as u32).wrapping_mul(83_492_791);
+    h & (table_size - 1)
+}
+
+/// A table size for `count` entries: a power of two with roughly two buckets
+/// per entry, which keeps a bucket to a handful of entries.
+pub fn table_size_for(count: u32) -> u32 {
+    (count.max(1) * 2).next_power_of_two().max(64)
+}
diff --git a/crates/fabelgeist-spatial-hash/src/overlap.rs b/crates/fabelgeist-spatial-hash/src/overlap.rs
new file mode 100644
index 000000000..ef5e8051e
--- /dev/null
+++ b/crates/fabelgeist-spatial-hash/src/overlap.rs
@@ -0,0 +1,83 @@
+//! The volume two spheres share.
+
+use std::f32::consts::PI;
+
+/// Volume of a sphere of radius `r`.
+#[inline]
+pub fn sphere_volume(r: f32) -> f32 {
+    4.0 / 3.0 * PI * r * r * r
+}
+
+/// The volume of the lens two spheres of radii `r1` and `r2` share when their
+/// centres are `d` apart.
+///
+/// Zero when they are apart, the smaller sphere's whole volume when one holds
+/// the other, and the closed-form lens in between:
+///
+/// ```text
+/// V = pi (r1 + r2 - d)^2 (d^2 + 2d(r1 + r2) - 3(r1 - r2)^2) / (12 d)
+/// ```
+#[inline]
+pub fn sphere_overlap_volume(r1: f32, r2: f32, d: f32) -> f32 {
+    if r1 <= 0.0 || r2 <= 0.0 || d >= r1 + r2 {
+        return 0.0;
+    }
+    if d <= (r1 - r2).abs() {
+        return sphere_volume(r1.min(r2));
+    }
+    let sum = r1 + r2;
+    let diff = r1 - r2;
+    let gap = sum - d;
+    PI * gap * gap * (d * d + 2.0 * d * sum - 3.0 * diff * diff) / (12.0 * d)
+}
+
+/// [`sphere_volume`] and [`sphere_overlap_volume`] in WGSL, for kernels to
+/// paste in.
+pub const SPHERE_OVERLAP_WGSL: &str = r#"
+fn sphere_volume(r: f32) -> f32 {
+    return 4.18879020479 * r * r * r;
+}
+
+fn sphere_overlap_volume(r1: f32, r2: f32, d: f32) -> f32 {
+    if (r1 <= 0.0 || r2 <= 0.0 || d >= r1 + r2) {
+        return 0.0;
+    }
+    if (d <= abs(r1 - r2)) {
+        return sphere_volume(min(r1, r2));
+    }
+    let sum = r1 + r2;
+    let diff = r1 - r2;
+    let gap = sum - d;
+    return 3.14159265359 * gap * gap * (d * d + 2.0 * d * sum - 3.0 * diff * diff) / (12.0 * d);
+}
+"#;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn apart_touching_and_nested() {
+        assert_eq!(sphere_overlap_volume(1.0, 1.0, 2.5), 0.0);
+        assert_eq!(sphere_overlap_volume(1.0, 1.0, 2.0), 0.0);
+        let nested = sphere_overlap_volume(2.0, 0.5, 0.3);
+        assert!((nested - sphere_volume(0.5)).abs() < 1e-6);
+    }
+
+    #[test]
+    fn continuous_at_the_nesting_boundary() {
+        // At d = r1 - r2 the lens must equal the smaller sphere.
+        let (r1, r2) = (1.5, 0.5);
+        let lens = sphere_overlap_volume(r1, r2, 1.0 + 1e-4);
+        assert!((lens - sphere_volume(r2)).abs() < 1e-3, "{lens}");
+    }
+
+    #[test]
+    fn equal_spheres_match_two_caps() {
+        // Two unit spheres a unit apart: two caps of height 1/2.
+        let h: f32 = 0.5;
+        let cap = PI * h * h * (3.0 - h) / 3.0;
+        let lens = sphere_overlap_volume(1.0, 1.0, 1.0);
+        assert!((lens - 2.0 * cap).abs() < 1e-5, "{lens} vs {}", 2.0 * cap);
+    }
+}
