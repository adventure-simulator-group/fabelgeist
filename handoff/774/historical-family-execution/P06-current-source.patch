+/// The flat item index of a folded dispatch with 64-wide workgroups.
+pub const INDEX: &str = r#"
+fn item(id: vec3<u32>, groups: vec3<u32>) -> u32 {
+    return id.y * groups.x * 64u + id.x;
+}
