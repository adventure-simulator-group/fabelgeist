--- /dev/null
+++ b/crates/fabelgeist-hair/src/look.rs
@@ -0,0 +1,469 @@
+//! A look: the few knobs a person turns, expanded into a full stack.
+//!
+//! DiffLocks draws 110 parameters per sample -- geometry and material -- each
+//! from a range chosen by eye, and runs them through a fixed pipeline: guides
+//! interpolated to ~100K strands, then clumping, curling and noise "repeated
+//! multiple times with various intensities", shrinkwrap "at various
+//! stages", the material, and a drape under random wind and gravity. A
+//! [`Look`] is that pipeline with its knobs gathered into a handful that
+//! mean something to a person (how clumped, how curly, how frizzy, how long
+//! the drape) and [`Look::groom`] is the stack they expand to, in
+//! DiffLocks' order:
+//!
+//! 1. the drape, on the guides (cheap there, and the full groom inherits it):
+//!    the change gravity and wind make from standard conditions;
+//! 2. interpolation, with the style's part, the balding mask, the uneven
+//!    cover and the hairline's thinning, then every root turned the way its
+//!    follicle points ([`crate::ops::Orient`]);
+//! 3. length variation;
+//! 4. coarse clumps -- the large locks;
+//! 5. curls, following their own locks, or waves rippling through them;
+//! 6. fine clumps at the tips;
+//! 7. noise, then frizz on a few flyaway strands;
+//! 8. shrinkwrap off the body -- the face and shoulders included, which
+//!    hair reaching them rests on;
+//! 9. the strands' radii.
+//!
+//! What the hair grows from, how it is cut and how it is styled are the
+//! look's [`Hairdo`]; the rest of the look is the hair's texture.
+//! [`Look::random`] draws one the way the dataset does, from a preset.
+
+use crate::parameters::Draping;
+use crate::parameters::GuideNeighborCount;
+use crate::parameters::HairSeed;
+use crate::parameters::LockFormation;
+use crate::parameters::PointsPerStrand;
+use crate::parameters::StrandCount;
+use fabelgeist_math::units::Acceleration;
+use fabelgeist_math::units::AccelerationVector;
+use fabelgeist_math::units::Metres;
+use fabelgeist_math::units::PerMetre;
+use fabelgeist_math::units::RadiansPerMetre;
+use fabelgeist_math::units::Ratio;
+use fabelgeist_math::units::TurnsPerMetre;
+use serde::{Deserialize, Serialize};
+
+use crate::hairdo::Hairdo;
+use crate::hairstyle::Arrangement;
+use crate::head::Head;
+use crate::ops::Context;
+use crate::presets::Preset;
+use crate::rng::Rng;
+use crate::strands::Strands;
+use crate::surface::Surface;
+mod groom;
+mod random;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Look {
+    /// The preset this look started from.
+    pub preset: Preset,
+    /// The follicles, the cut and the style.
+    pub hairdo: Hairdo,
+    /// Strands grown from the guides.
+    pub strands: StrandCount,
+    /// Points per strand.
+    pub points: PointsPerStrand,
+    /// Guide jitter, 0 to 1.
+    pub variation: Ratio,
+    /// Neighbours blended by interpolation.
+    pub neighbors: GuideNeighborCount,
+    /// Share of length taken off at random: how ragged the ends are.
+    pub length_variation: Ratio,
+    /// Overall clumping, 0 to 1.
+    pub clump: Ratio,
+    /// Coarse lock size at the root, metres.
+    pub clump_size: Metres,
+    /// Twist of the coarse locks, radians a metre.
+    pub twist: RadiansPerMetre,
+    /// Locks clumped all along into ropes: dreadlocks.
+    #[serde(default)]
+    pub locs: LockFormation,
+    /// How much the strands curl, 0 to 1.
+    pub curl: Ratio,
+    /// Curl radius, metres.
+    pub curl_radius: Metres,
+    /// Curl turns a metre.
+    pub curl_turns: TurnsPerMetre,
+    /// Curl lock size at the root, metres.
+    pub curl_size: Metres,
+    /// Where along the strand curls start, 0 to 1.
+    pub curl_start: Ratio,
+    /// Waves either side, metres, and crest to crest.
+    #[serde(default)]
+    pub wave: Metres,
+    #[serde(default = "default_wavelength")]
+    pub wavelength: Metres,
+    /// Coherent waviness, metres.
+    pub noise: Metres,
+    /// Noise cells a metre along a strand.
+    pub noise_scale: PerMetre,
+    /// How far flyaway strands wander, metres.
+    pub frizz: Metres,
+    /// Share of strands that fly away.
+    #[serde(default = "default_flyaways")]
+    pub flyaways: Ratio,
+    /// Drape under gravity and wind.
+    pub drape: Draping,
+    pub gravity: Acceleration,
+    pub wind: AccelerationVector,
+    pub seed: HairSeed,
+}
+
+fn default_wavelength() -> Metres {
+    Metres::from_metres(0.08)
+}
+
+fn default_flyaways() -> Ratio {
+    Ratio::from_ratio(0.06)
+}
+
+impl Look {
+    /// A tidy default for a preset.
+    pub fn new(preset: Preset) -> Self {
+        let hairdo = preset.hairdo();
+        let mut look = Self {
+            preset,
+            hairdo,
+            strands: StrandCount::from_count(80_000),
+            points: PointsPerStrand::from_count(48),
+            variation: Ratio::from_ratio(0.4),
+            neighbors: GuideNeighborCount::from_count(4),
+            length_variation: Ratio::from_ratio(0.15),
+            clump: Ratio::from_ratio(0.6),
+            clump_size: Metres::from_metres(0.025),
+            twist: RadiansPerMetre::from_radians_per_metre(0.0),
+            locs: LockFormation::from_enabled(false),
+            curl: Ratio::from_ratio(0.0),
+            curl_radius: Metres::from_metres(0.008),
+            curl_turns: TurnsPerMetre::from_turns_per_metre(12.0),
+            curl_size: Metres::from_metres(0.008),
+            curl_start: Ratio::from_ratio(0.15),
+            wave: Metres::from_metres(0.004),
+            wavelength: Metres::from_metres(0.09),
+            noise: Metres::from_metres(0.006),
+            noise_scale: PerMetre::from_per_metre(5.0),
+            frizz: Metres::from_metres(0.003),
+            flyaways: Ratio::from_ratio(0.04),
+            drape: Draping::from_enabled(hairdo.drapes()),
+            gravity: Acceleration::from_metres_per_second_squared(9.81),
+            wind: AccelerationVector::from_components([0.0; 3]),
+            seed: HairSeed::from_word(1),
+        };
+        match preset {
+            Preset::Dreadlocks => {
+                look.points = PointsPerStrand::from_count(64);
+                look.locs = LockFormation::from_enabled(true);
+                look.clump = Ratio::from_ratio(1.0);
+                look.clump_size = Metres::from_metres(0.013);
+                look.twist = RadiansPerMetre::from_radians_per_metre(30.0);
+                look.wave = Metres::from_metres(0.006);
+                look.frizz = Metres::from_metres(0.002);
+                look.flyaways = Ratio::from_ratio(0.25);
+                look.length_variation = Ratio::from_ratio(0.25);
+            }
+            Preset::Braid => {
+                look.frizz = Metres::from_metres(0.0015);
+                look.points = PointsPerStrand::from_count(128);
+                look.clump = Ratio::from_ratio(0.15);
+                look.wave = Metres::from_metres(0.0);
+                look.length_variation = Ratio::from_ratio(0.05);
+                look.flyaways = Ratio::from_ratio(0.03);
+            }
+            Preset::Ponytail => {
+                look.points = PointsPerStrand::from_count(64);
+                look.clump = Ratio::from_ratio(0.3);
+                look.wave = Metres::from_metres(0.003);
+            }
+            Preset::Bun => {
+                look.frizz = Metres::from_metres(0.001);
+                look.points = PointsPerStrand::from_count(128);
+                look.clump = Ratio::from_ratio(0.2);
+                look.wave = Metres::from_metres(0.0);
+                look.length_variation = Ratio::from_ratio(0.05);
+            }
+            Preset::Undercut | Preset::Mohawk => {
+                look.strands = StrandCount::from_count(90_000);
+                look.points = PointsPerStrand::from_count(24);
+                look.clump = Ratio::from_ratio(0.5);
+                look.clump_size = Metres::from_metres(0.012);
+                look.wave = Metres::from_metres(0.0);
+                look.noise = Metres::from_metres(0.0015);
+                look.frizz = Metres::from_metres(0.002);
+            }
+            // Tight coils in small locks, wandering: a cloud, not rays.
+            Preset::Afro => {
+                look.strands = StrandCount::from_count(80_000);
+                look.points = PointsPerStrand::from_count(160);
+                look.curl = Ratio::from_ratio(1.0);
+                look.curl_radius = Metres::from_metres(0.0035);
+                look.curl_turns = TurnsPerMetre::from_turns_per_metre(110.0);
+                look.curl_size = Metres::from_metres(0.003);
+                look.curl_start = Ratio::from_ratio(0.0);
+                look.clump = Ratio::from_ratio(0.25);
+                look.clump_size = Metres::from_metres(0.01);
+                look.noise = Metres::from_metres(0.012);
+                look.noise_scale = PerMetre::from_per_metre(12.0);
+                look.frizz = Metres::from_metres(0.003);
+                look.flyaways = Ratio::from_ratio(0.3);
+                look.wave = Metres::from_metres(0.0);
+            }
+            Preset::CurlyTop => {
+                look.strands = StrandCount::from_count(100_000);
+                look.points = PointsPerStrand::from_count(96);
+                look.curl = Ratio::from_ratio(1.0);
+                look.curl_radius = Metres::from_metres(0.004);
+                look.curl_turns = TurnsPerMetre::from_turns_per_metre(70.0);
+                look.curl_size = Metres::from_metres(0.004);
+                look.curl_start = Ratio::from_ratio(0.05);
+                look.clump = Ratio::from_ratio(0.3);
+                look.clump_size = Metres::from_metres(0.01);
+                look.wave = Metres::from_metres(0.0);
+                look.noise = Metres::from_metres(0.004);
+                look.noise_scale = PerMetre::from_per_metre(15.0);
+            }
+            Preset::Ringlets => {
+                look.points = PointsPerStrand::from_count(160);
+                look.curl = Ratio::from_ratio(1.0);
+                look.curl_radius = Metres::from_metres(0.007);
+                look.curl_turns = TurnsPerMetre::from_turns_per_metre(18.0);
+                look.curl_size = Metres::from_metres(0.01);
+                look.curl_start = Ratio::from_ratio(0.12);
+                look.clump = Ratio::from_ratio(0.4);
+                look.wave = Metres::from_metres(0.0);
+            }
+            Preset::Shag => {
+                look.clump = Ratio::from_ratio(0.7);
+                look.wave = Metres::from_metres(0.01);
+                look.wavelength = Metres::from_metres(0.08);
+                look.noise = Metres::from_metres(0.012);
+                look.noise_scale = PerMetre::from_per_metre(6.0);
+                look.frizz = Metres::from_metres(0.004);
+                look.flyaways = Ratio::from_ratio(0.1);
+            }
+            // A fringe is cut blunt: its tips must not gather into points.
+            Preset::Bangs => {
+                look.clump = Ratio::from_ratio(0.3);
+                look.length_variation = Ratio::from_ratio(0.08);
+            }
+            Preset::BowlCut => {
+                look.clump = Ratio::from_ratio(0.3);
+                look.wave = Metres::from_metres(0.0);
+                look.length_variation = Ratio::from_ratio(0.05);
+            }
+            Preset::Quiff | Preset::SweptFringe => {
+                look.strands = StrandCount::from_count(90_000);
+                look.points = PointsPerStrand::from_count(32);
+                look.clump = Ratio::from_ratio(0.6);
+                look.clump_size = Metres::from_metres(0.015);
+                look.wave = Metres::from_metres(0.0);
+                look.noise = Metres::from_metres(0.004);
+                look.noise_scale = PerMetre::from_per_metre(10.0);
+                look.frizz = Metres::from_metres(0.002);
+            }
+            Preset::Balding => {
+                look.strands = StrandCount::from_count(100_000);
+                look.points = PointsPerStrand::from_count(12);
+                look.clump = Ratio::from_ratio(0.2);
+                look.wave = Metres::from_metres(0.0);
+                look.noise = Metres::from_metres(0.001);
+                look.frizz = Metres::from_metres(0.0);
+            }
+            Preset::Buzz => {
+                look.strands = StrandCount::from_count(120_000);
+                look.points = PointsPerStrand::from_count(8);
+                look.clump = Ratio::from_ratio(0.0);
+                look.noise = Metres::from_metres(0.0003);
+                look.frizz = Metres::from_metres(0.0);
+                look.wave = Metres::from_metres(0.0);
+                look.length_variation = Ratio::from_ratio(0.3);
+            }
+            Preset::Crop | Preset::Spiky => {
+                look.strands = StrandCount::from_count(100_000);
+                look.points = PointsPerStrand::from_count(16);
+                look.clump = Ratio::from_ratio(if preset == Preset::Crop { 0.3 } else { 0.55 });
+                look.clump_size = Metres::from_metres(0.012);
+                look.noise = Metres::from_metres(0.004);
+                look.noise_scale = PerMetre::from_per_metre(20.0);
+                look.wave = Metres::from_metres(0.0);
+                look.frizz = Metres::from_metres(0.002);
+            }
+            Preset::Pixie => {
+                look.strands = StrandCount::from_count(80_000);
+                look.points = PointsPerStrand::from_count(24);
+                look.clump_size = Metres::from_metres(0.015);
+                look.wave = Metres::from_metres(0.002);
+                look.frizz = Metres::from_metres(0.002);
+            }
+            _ => {}
+        }
+        look
+    }
+
+    /// A look drawn the way the dataset draws one: every knob from a range
+    /// that reads as real hair for the preset -- its follicles, cut and
+    /// style as much as its texture.
+    pub fn random(preset: Preset, rng: &mut Rng) -> Self {
+        let mut look = Self::new(preset);
+        look.seed = HairSeed::from_word(rng.next_u32() as i32 & 0x7FFF_FFFF);
+        look.variation = Ratio::from_ratio(rng.range(0.2, 0.8));
+        let hairdo = &mut look.hairdo;
+
+        random::follicles(&mut hairdo.follicles, rng);
+
+        // The cut, longer or shorter; the style fuller or flatter, lifted
+        // more or less, parted elsewhere -- and now and then combed another
+        // way.
+        hairdo.haircut = hairdo.haircut.scaled(rng.range(0.75, 1.25));
+        let style = &mut hairdo.hairstyle;
+        style.volume *= rng.log_range(0.6, 2.2);
+        style.lift *= rng.range(0.7, 1.5);
+        style.part += rng.range(-0.03, 0.03);
+        let loose = [
+            Arrangement::Natural,
+            Arrangement::Parted,
+            Arrangement::Swept,
+            Arrangement::Down,
+        ];
+        if loose.contains(&style.arrangement) && rng.chance(0.25) {
+            style.arrangement = loose[rng.index(loose.len())];
+            if style.arrangement == Arrangement::Swept && style.part.abs() < 0.02 {
+                style.part = if rng.chance(0.5) { 0.045 } else { -0.045 };
+            }
+        }
+
+        look.neighbors = GuideNeighborCount::from_count(3 + rng.index(4));
+        look.length_variation = Ratio::from_ratio(rng.range(0.0, 0.35));
+        look.clump = Ratio::from_ratio(rng.range(0.1, 0.9));
+        look.clump_size = Metres::from_metres(rng.log_range(0.01, 0.05));
+        look.twist = RadiansPerMetre::from_radians_per_metre(if rng.chance(0.3) {
+            rng.range(-8.0, 8.0)
+        } else {
+            0.0
+        });
+        look.noise = Metres::from_metres(rng.log_range(0.001, 0.012));
+        look.noise_scale = PerMetre::from_per_metre(rng.log_range(2.0, 15.0));
+        look.frizz = Metres::from_metres(rng.log_range(0.001, 0.006));
+        look.flyaways = Ratio::from_ratio(rng.log_range(0.01, 0.2));
+        let short = preset.is_short();
+        let tied = look.hairdo.hairstyle.arrangement.tied();
+        // Texture: straight, wavy, loose curls, curly or coily -- weighted
+        // as hair is, most of it straight or wavy.
+        let kind = match preset {
+            Preset::Afro => 4,
+            Preset::CurlyTop => [3, 4][rng.index(2)],
+            Preset::Ringlets => [2, 3][rng.index(2)],
+            Preset::Dreadlocks | Preset::Buzz | Preset::Balding => 0,
+            _ if short => [0, 0, 1, 3][rng.index(4)],
+            _ if tied => [0, 0, 1, 1, 2][rng.index(5)],
+            _ => [0, 0, 0, 1, 1, 1, 2, 2, 3, 4][rng.index(10)],
+        };
+        look.wave = Metres::from_metres(0.0);
+        look.curl = Ratio::from_ratio(0.0);
+        match kind {
+            0 => look.wave = Metres::from_metres(rng.range(0.0, 0.004)),
+            1 => {
+                look.wave = Metres::from_metres(rng.range(0.005, 0.016));
+                look.wavelength = Metres::from_metres(rng.range(0.05, 0.11));
+            }
+            2 => {
+                look.curl = Ratio::from_ratio(rng.range(0.5, 1.0));
+                look.curl_radius = Metres::from_metres(rng.range(0.006, 0.014));
+                look.curl_turns = TurnsPerMetre::from_turns_per_metre(rng.range(6.0, 12.0));
+                look.curl_size = Metres::from_metres(rng.log_range(0.008, 0.025));
+                look.curl_start = Ratio::from_ratio(rng.range(0.1, 0.35));
+            }
+            3 => {
+                look.curl = Ratio::from_ratio(rng.range(0.8, 1.0));
+                look.curl_radius = Metres::from_metres(rng.range(0.004, 0.009));
+                look.curl_turns = TurnsPerMetre::from_turns_per_metre(rng.range(15.0, 40.0));
+                look.curl_size = Metres::from_metres(rng.log_range(0.004, 0.012));
+                look.curl_start = Ratio::from_ratio(rng.range(0.03, 0.2));
+            }
+            _ => {
+                look.curl = Ratio::from_ratio(1.0);
+                look.curl_radius = Metres::from_metres(rng.range(0.002, 0.005));
+                look.curl_turns = TurnsPerMetre::from_turns_per_metre(rng.range(60.0, 140.0));
+                look.curl_size = Metres::from_metres(rng.log_range(0.002, 0.006));
+                look.curl_start = Ratio::from_ratio(rng.range(0.0, 0.06));
+                // Coily hair's follicles are curved: it wanders.
+                look.hairdo.follicles.kink = rng.range(1.0, 3.0);
+            }
+        }
+        if preset == Preset::Afro {
+            look.noise = Metres::from_metres(rng.range(0.008, 0.02));
+            look.noise_scale = PerMetre::from_per_metre(rng.range(8.0, 16.0));
+            look.curl_size = Metres::from_metres(rng.range(0.002, 0.005));
+            look.flyaways = Ratio::from_ratio(rng.range(0.15, 0.4));
+            look.hairdo.follicles.kink = rng.range(2.0, 4.0);
+        }
+        let follicles = &mut look.hairdo.follicles;
+        if preset == Preset::Balding {
+            follicles.balding = [
+                rng.range(0.5, 1.0),
+                rng.range(0.4, 1.0),
+                rng.range(0.3, 0.8),
+            ];
+        } else if rng.chance(0.15) {
+            follicles.balding = [
+                rng.range(0.0, 1.0),
+                rng.range(0.0, 1.0),
+                rng.range(0.0, 0.8),
+            ];
+        }
+        if preset == Preset::Dreadlocks {
+            look.clump = Ratio::from_ratio(rng.range(0.9, 1.0));
+            look.clump_size = Metres::from_metres(rng.range(0.01, 0.02));
+            look.twist = RadiansPerMetre::from_radians_per_metre(rng.range(15.0, 40.0));
+        }
+        // Enough points for about eight a turn, within the dataset's 256.
+        if look.curl.ratio() > 0.0 && !short {
+            let length = 0.5;
+            let turns = look.curl_turns.turns_per_metre() * length;
+            look.points = PointsPerStrand::from_count(
+                ((turns * 8.0) as usize).clamp(look.points.count(), 256),
+            );
+        }
+        look.drape = Draping::from_enabled(look.hairdo.drapes() && rng.chance(0.85));
+        look.gravity = Acceleration::from_metres_per_second_squared(rng.range(7.0, 12.0));
+        let wind_angle = rng.range(0.0, std::f32::consts::TAU);
+        let wind = if rng.chance(0.5) {
+            rng.range(0.0, 4.0)
+        } else {
+            0.0
+        };
+        look.wind = AccelerationVector::from_components([
+            wind_angle.sin() * wind,
+            0.0,
+            wind_angle.cos() * wind,
+        ]);
+        look
+    }
+
+    /// `base` with this look's hairline: the head to grow it on, and to cut
+    /// its scalp from ([`Head::scalp`]).
+    pub fn head(&self, base: &Head) -> Head {
+        self.hairdo.head(base)
+    }
+
+    /// The guides this look grows from, on its `head` ([`Look::head`]).
+    pub fn guides(&self, head: &Head, scalp: &Surface) -> Strands {
+        self.hairdo.guides(
+            head,
+            scalp,
+            64,
+            self.variation.ratio(),
+            self.seed.word() as u64,
+        )
+    }
+
+    /// The whole groom on its `head` ([`Look::head`]), rooted on `scalp`:
+    /// the guides, and the stack run over them.
+    pub fn grow(&self, head: &Head, scalp: &Surface) -> Strands {
+        let context = Context {
+            scalp,
+            collider: head,
+        };
+        self.groom(head).grow(&self.guides(head, scalp), &context)
+    }
+}
diff --git a/crates/fabelgeist-hair/src/look/groom.rs b/crates/fabelgeist-hair/src/look/groom.rs
new file mode 100644
index 000000000..74839cad2
--- /dev/null
+++ b/crates/fabelgeist-hair/src/look/groom.rs
@@ -0,0 +1,193 @@
+//! Expansion of semantic hair parameters into the native numerical node graph.
+//!
+//! Unit getters here are the handoff to the CPU/WGSL numerical operations.
+//! Keep operation order, seed words and floating-point expression order stable.
+
+use super::Look;
+use crate::ops::{
+    Clump, Curl, DensityMask, Frizz, Interpolate, Noise, Op, Orient, Profile, Settle, Shrinkwrap,
+    Trim, Wave,
+};
+use crate::{Groom, Head};
+
+impl Look {
+    /// Expand into the original numerical operation graph, in evaluation order.
+    pub fn groom(&self, head: &Head) -> Groom {
+        let mut ops = Vec::new();
+        self.guide_operations(head, &mut ops);
+        self.coarse_texture(&mut ops);
+        self.fine_texture(&mut ops);
+        Groom {
+            points: self.points.count(),
+            ops,
+        }
+    }
+
+    fn guide_operations(&self, head: &Head, ops: &mut Vec<Op>) {
+        let seed = self.seed.word();
+        let hairdo = &self.hairdo;
+        let follicles = &self.hairdo.follicles;
+        if self.drape.enabled() {
+            ops.push(Op::Settle(Settle {
+                gravity: self.gravity.metres_per_second_squared(),
+                wind: self.wind.components(),
+                ..Default::default()
+            }));
+            ops.push(Op::Shrinkwrap(Shrinkwrap {
+                offset: 0.003,
+                smoothing: 4,
+                preserve_length: true,
+                ..Default::default()
+            }));
+        }
+        let [crown, temples, top] = follicles.balding;
+        ops.push(Op::Interpolate(Interpolate {
+            count: self.strands.count(),
+            neighbors: self.neighbors.count(),
+            parting: hairdo.parting(),
+            // Where neighbouring guides are combed apart, a strand follows
+            // one of them: the hair parts, it does not fill the gap.
+            divergence: 0.5,
+            // Hair that stands out follows its own root's normal all the
+            // way; hair that lies on the head only leaves the scalp so.
+            follow_length: if hairdo.stands() { 1.0 } else { 0.05 },
+            density: if crown + temples + top > 0.0 {
+                DensityMask::Balding {
+                    crown,
+                    temples,
+                    top,
+                }
+            } else {
+                DensityMask::Uniform
+            },
+            patchiness: follicles.patchiness,
+            edge: follicles.hairline.softness,
+            radius: follicles.radius,
+            seed,
+            ..Default::default()
+        }));
+        ops.push(Op::Orient(Orient {
+            field: follicles.field(head),
+            memory: follicles.memory,
+            direction_spread: follicles.direction_spread,
+            angle_spread: follicles.angle_spread,
+            seed: seed + 9,
+        }));
+        if self.length_variation.ratio() > 0.0 {
+            ops.push(Op::Trim(Trim {
+                length: 1.0,
+                random: self.length_variation.ratio(),
+                max_length: 0.0,
+                seed: seed + 1,
+            }));
+        }
+    }
+
+    fn coarse_texture(&self, ops: &mut Vec<Op>) {
+        let seed = self.seed.word();
+        if self.clump.ratio() > 0.0 {
+            // Dreadlocks are clumped all along, into ropes.
+            let rope = self.locs.enabled();
+            ops.push(Op::Clump(Clump {
+                guide_distance: self.clump_size.metres(),
+                factor: if rope {
+                    0.93 * self.clump.ratio()
+                } else {
+                    self.clump.ratio() * 0.8
+                },
+                // A rope gathers within a few centimetres of the scalp.
+                shape: if rope { 0.05 } else { 0.3 },
+                twist: self.twist.radians_per_metre(),
+                twist_random: 0.5,
+                tip_spread: self.clump_size.metres() * 0.15,
+                clump_offset: self.clump_size.metres() * 0.2,
+                preserve_length: true,
+                seed: seed + 2,
+                min_length: 0.015,
+                ..Default::default()
+            }));
+        }
+        if self.curl.ratio() > 0.0 {
+            ops.push(Op::Curl(Curl {
+                guide_distance: self.curl_size.metres(),
+                reuse_guide_map: false,
+                factor: self.curl.ratio(),
+                curl_start: self.curl_start.ratio(),
+                radius: self.curl_radius.metres(),
+                factor_start: 0.7,
+                factor_end: 1.0,
+                frequency: self.curl_turns.turns_per_metre() / 3.0,
+                random_offset: 0.15,
+                seed: seed + 3,
+                ..Default::default()
+            }));
+        }
+        if self.wave.metres() > 0.0 {
+            ops.push(Op::Wave(Wave {
+                amplitude: self.wave.metres(),
+                wavelength: self.wavelength.metres(),
+                seed: seed + 8,
+                ..Default::default()
+            }));
+        }
+    }
+
+    fn fine_texture(&self, ops: &mut Vec<Op>) {
+        let seed = self.seed.word();
+        let follicles = &self.hairdo.follicles;
+        if self.clump.ratio() > 0.0 && !self.locs.enabled() {
+            ops.push(Op::Clump(Clump {
+                guide_distance: (self.clump_size.metres() * 0.3).max(0.003),
+                factor: self.clump.ratio() * 0.6,
+                shape: 0.75,
+                tip_spread: 0.001,
+                preserve_length: true,
+                seed: seed + 4,
+                min_length: 0.015,
+                ..Default::default()
+            }));
+        }
+        if self.noise.metres() > 0.0 {
+            ops.push(Op::Noise(Noise {
+                // Offsets, not a walk: Blender's cumulative noise sums a
+                // point's offset per point, so its reach grows with the
+                // point count. Here `distance` is how far hair strays.
+                cumulative: false,
+                distance: self.noise.metres(),
+                scale: 6.0,
+                scale_along_curve: self.noise_scale.per_metre() / 5.0,
+                offset_per_curve: 0.02,
+                shape: 0.6,
+                preserve_length: true,
+                seed: seed + 5,
+                ..Default::default()
+            }));
+        }
+        if self.frizz.metres() > 0.0 {
+            ops.push(Op::Frizz(Frizz {
+                distance: self.frizz.metres(),
+                shape: 0.5,
+                cumulative: true,
+                seed: seed + 6,
+                share: self.flyaways.ratio(),
+                // Every strand wanders a little on its own, so that no two
+                // lie quite parallel: the highlight breaks into strands.
+                calm: 0.12,
+                frequency: 15.0,
+                ..Default::default()
+            }));
+        }
+        ops.push(Op::Shrinkwrap(Shrinkwrap {
+            offset: 0.0015,
+            smoothing: 3,
+            preserve_length: false,
+            ..Default::default()
+        }));
+        ops.push(Op::Profile(Profile {
+            radius: follicles.radius,
+            random: follicles.radius_spread,
+            seed: seed + 7,
+            relative_to: Some(follicles.radius),
+        }));
+    }
+}
diff --git a/crates/fabelgeist-hair/src/look/random.rs b/crates/fabelgeist-hair/src/look/random.rs
new file mode 100644
index 000000000..aaa069ad3
--- /dev/null
+++ b/crates/fabelgeist-hair/src/look/random.rs
@@ -0,0 +1,50 @@
+//! Follicle sampling in the look's existing random stream.
+use crate::follicles::{Follicles, Growth};
+use crate::rng::Rng;
+
+pub(super) fn follicles(f: &mut Follicles, rng: &mut Rng) {
+    let mut pick = rng.index(100) as i32;
+    f.growth = Growth::Whorl;
+    for (growth, weight) in [
+        (Growth::Whorl, 55),
+        (Growth::Cowlick, 12),
+        (Growth::DoubleWhorl, 8),
+        (Growth::Radial, 5),
+        (Growth::Forward, 8),
+        (Growth::Backward, 7),
+        (Growth::Down, 5),
+    ] {
+        pick -= weight;
+        if pick < 0 {
+            f.growth = growth;
+            break;
+        }
+    }
+    f.whorl = [rng.range(-0.3, 0.3), rng.range(0.3, 0.8)];
+    f.spiral = rng.range(0.6, 1.6);
+    f.clockwise = rng.chance(0.75);
+    f.angle = (f.angle * rng.range(0.7, 1.5)).clamp(0.1, 1.2);
+    f.angle_spread = rng.range(0.05, 0.2);
+    f.direction_spread = rng.range(0.05, 0.3);
+    f.memory = rng.log_range(0.003, 0.015);
+    f.radius = rng.range(25e-6, 50e-6);
+    f.radius_spread = rng.range(0.15, 0.35);
+    f.patchiness = if rng.chance(0.3) {
+        rng.range(0.0, 0.5)
+    } else {
+        0.0
+    };
+    let h = &mut f.hairline;
+    h.front = rng.range(-0.008, 0.01);
+    h.sides = rng.range(-0.008, 0.008);
+    h.nape = rng.range(-0.01, 0.01);
+    if rng.chance(0.25) {
+        h.recession += rng.range(0.0, 0.02);
+    }
+    h.peak = if rng.chance(0.15) {
+        rng.range(0.0, 0.012)
+    } else {
+        0.0
+    };
+    h.softness = rng.range(0.002, 0.008);
+}
diff --git a/crates/fabelgeist-hair/src/material.rs b/crates/fabelgeist-hair/src/material.rs
new file mode 100644
index 000000000..e3e96ce1d
--- /dev/null
+++ b/crates/fabelgeist-hair/src/material.rs
@@ -0,0 +1,225 @@
+//! What hair is made of: the parameters of the Chiang hair BSDF.
+//!
+//! DiffLocks shades its strands with Blender's Principled Hair BSDF in the
+//! Chiang model (Chiang et al. 2016): a dielectric cylinder with cuticle
+//! scales, its colour the absorption of the melanin in its cortex. Colour
+//! comes from how much melanin there is and how much of it is the red
+//! pheomelanin rather than the dark eumelanin, as Blender parameterises it,
+//! plus an optional dye. [`HairMaterial::absorption`] is that coefficient;
+//! [`HairMaterial::base_color`] the colour it gives a strand (Chiang's
+//! mapping, inverted), which the real-time shading uses.
+//!
+//! Along the strand DiffLocks' material varies the melanin two ways, which
+//! its metadata records: darker towards the root (`root_darkness_start`,
+//! `_end`, `_strength`, as shares of the strand) and in waves along it
+//! (`material_wave_scale`, `_phase_offset`, `_strength`); and it takes the
+//! BSDF's `coat`. [`HairMaterial`] has the same, under those names.
+
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+pub struct HairMaterial {
+    /// 0 is white, 0.2 blond, 0.5 brown, 0.8 dark brown, 1 black.
+    pub melanin: f32,
+    /// Share of pheomelanin: 0 ashen, 1 red.
+    pub redness: f32,
+    /// A dye's colour; white is none.
+    pub tint: [f32; 3],
+    /// Longitudinal roughness: how far highlights spread along the strand.
+    pub roughness: f32,
+    /// Azimuthal roughness: how soft the look across it is.
+    pub radial_roughness: f32,
+    /// The cuticle tilt, radians (about 2 to 4 degrees).
+    pub cuticle_tilt: f32,
+    pub ior: f32,
+    /// How much each strand's melanin varies.
+    pub random_color: f32,
+    /// How much each strand's roughness varies.
+    pub random_roughness: f32,
+    /// How much lighter the tips are than the roots (sun-bleached), 0 to 1.
+    #[serde(default)]
+    pub tip_lightness: f32,
+    /// Share of strands with no pigment left: grey.
+    #[serde(default)]
+    pub grey: f32,
+    /// Darker towards the root: fully `root_darkness_strength` more melanin
+    /// before `root_darkness_start` along the strand (0 root, 1 tip), none
+    /// past `root_darkness_end`.
+    #[serde(default)]
+    pub root_darkness_start: f32,
+    #[serde(default)]
+    pub root_darkness_end: f32,
+    #[serde(default)]
+    pub root_darkness_strength: f32,
+    /// Melanin rising and falling in waves along the strand: `wave_scale`
+    /// waves from root to tip, starting `wave_phase` degrees in, up to
+    /// `wave_strength` either way.
+    #[serde(default)]
+    pub wave_scale: f32,
+    #[serde(default)]
+    pub wave_phase: f32,
+    #[serde(default)]
+    pub wave_strength: f32,
+    /// The Principled Hair BSDF's coat: a clear layer over the strand, as
+    /// on fur. Recorded for an offline renderer; the real-time shading has
+    /// no coat lobe.
+    #[serde(default)]
+    pub coat: f32,
+    /// How the radius falls to the tip.
+    pub taper: Taper,
+}
+
+/// Radius along a strand as `Set Hair Curve Profile` shapes it: the root
+/// radius times a factor running from 1 at the root to `tip` at the tip,
+/// by `shape_range(1 - factor, shape)`.
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+pub struct Taper {
+    pub tip: f32,
+    pub shape: f32,
+}
+
+impl Default for Taper {
+    fn default() -> Self {
+        Self {
+            tip: 0.2,
+            shape: 0.85,
+        }
+    }
+}
+
+impl Taper {
+    /// The radius factor at `factor` along the strand.
+    pub fn at(&self, factor: f32) -> f32 {
+        let f = crate::ops::shape_range(1.0 - factor, 0.0, 1.0, self.shape, 2.0);
+        self.tip + (1.0 - self.tip) * f
+    }
+}
+
+impl Default for HairMaterial {
+    fn default() -> Self {
+        Self {
+            melanin: 0.65,
+            redness: 0.35,
+            tint: [1.0; 3],
+            roughness: 0.3,
+            radial_roughness: 0.3,
+            cuticle_tilt: 2.5f32.to_radians(),
+            ior: 1.55,
+            random_color: 0.3,
+            random_roughness: 0.2,
+            tip_lightness: 0.15,
+            grey: 0.0,
+            root_darkness_start: 0.0,
+            root_darkness_end: 0.1,
+            root_darkness_strength: 0.0,
+            wave_scale: 3.0,
+            wave_phase: 0.0,
+            wave_strength: 0.0,
+            coat: 0.0,
+            taper: Taper::default(),
+        }
+    }
+}
+
+/// Chiang's polynomial in the azimuthal roughness, relating a colour to its
+/// absorption.
+fn chiang(beta_n: f32) -> f32 {
+    let b = beta_n;
+    5.969 - 0.215 * b + 2.532 * b.powi(2) - 10.73 * b.powi(3)
+        + 5.574 * b.powi(4)
+        + 0.245 * b.powi(5)
+}
+
+impl HairMaterial {
+    pub fn named(name: &str) -> Option<Self> {
+        let (melanin, redness) = match name {
+            "black" => (0.95, 0.1),
+            "dark brown" => (0.8, 0.25),
+            "brown" => (0.7, 0.35),
+            "auburn" => (0.55, 0.75),
+            "red" => (0.4, 0.95),
+            "blond" => (0.22, 0.4),
+            "platinum" => (0.08, 0.2),
+            "grey" => (0.25, 0.02),
+            _ => return None,
+        };
+        Some(Self {
+            melanin,
+            redness,
+            ..Default::default()
+        })
+    }
+
+    /// Absorption coefficient per unit of fibre diameter, Blender's melanin
+    /// model: eumelanin and pheomelanin in proportion `1 - redness :
+    /// redness`, their total `-ln(1 - melanin)`, and a dye on top.
+    pub fn absorption(&self) -> [f32; 3] {
+        let quantity = -(1.0 - self.melanin).max(1e-4).ln();
+        let eumelanin = quantity * (1.0 - self.redness);
+        let pheomelanin = quantity * self.redness;
+        const EU: [f32; 3] = [0.506, 0.841, 1.653];
+        const PHEO: [f32; 3] = [0.343, 0.733, 1.924];
+        let f = chiang(self.radial_roughness);
+        std::array::from_fn(|k| {
+            let dye = (self.tint[k].clamp(1e-3, 1.0).ln() / f).powi(2);
+            eumelanin * EU[k] + pheomelanin * PHEO[k] + dye
+        })
+    }
+
+    /// The colour a real-time model should give a strand of this material.
+    ///
+    /// Chiang's mapping between colour and absorption, inverted, over a
+    /// quarter of the absorption: over the whole of it, the melanin
+    /// quantities Blender calls brown come out near black and saturated,
+    /// where Cycles renders them a mid brown. The quarter is calibrated by
+    /// eye against Cycles' renders of the named colours; offline rendering
+    /// should take [`HairMaterial::absorption`] itself.
+    pub fn base_color(&self) -> [f32; 3] {
+        let f = chiang(self.radial_roughness);
+        let melanin = Self {
+            tint: [1.0; 3],
+            ..*self
+        }
+        .absorption();
+        std::array::from_fn(|k| {
+            (-(melanin[k].max(0.0) * REAL_TIME_ABSORPTION).sqrt() * f).exp()
+                * self.tint[k].clamp(0.0, 1.0)
+        })
+    }
+}
+
+/// The share of the absorption [`HairMaterial::base_color`] takes.
+const REAL_TIME_ABSORPTION: f32 = 0.25;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn more_melanin_is_darker_and_redness_is_red() {
+        let light = HairMaterial::named("blond").unwrap().base_color();
+        let dark = HairMaterial::named("black").unwrap().base_color();
+        assert!(light.iter().zip(&dark).all(|(l, d)| l > d));
+        let red = HairMaterial::named("red").unwrap().base_color();
+        assert!(red[0] > red[1] && red[1] > red[2], "{red:?}");
+    }
+
+    #[test]
+    fn a_dye_alone_gives_back_its_colour() {
+        let dyed = HairMaterial {
+            melanin: 0.0,
+            tint: [0.2, 0.5, 0.9],
+            ..Default::default()
+        };
+        for (c, t) in dyed.base_color().iter().zip(dyed.tint) {
+            assert!((c - t).abs() < 1e-3, "{c} {t}");
+        }
+    }
+
+    #[test]
+    fn the_taper_runs_from_one_to_the_tip() {
+        let taper = Taper::default();
+        assert!((taper.at(0.0) - 1.0).abs() < 1e-4);
+        assert!((taper.at(1.0) - taper.tip).abs() < 1e-3);
+    }
+}
diff --git a/crates/fabelgeist-hair/src/noise.rs b/crates/fabelgeist-hair/src/noise.rs
new file mode 100644
index 000000000..6dc77203c
--- /dev/null
+++ b/crates/fabelgeist-hair/src/noise.rs
@@ -0,0 +1,122 @@
+//! Gradient noise on the host: Blender's `Noise Texture` for the hair noise
+//! operation, and `White Noise Texture` for the clump twist.
+
+use fabelgeist_math::Vec3;
+
+use crate::rng::{hash, hash3};
+
+fn fade(t: f32) -> f32 {
+    t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
+}
+
+/// One of the twelve edge gradients of Perlin's improved noise, for a
+/// lattice corner.
+fn gradient(ix: i32, iy: i32, iz: i32, x: f32, y: f32, z: f32) -> f32 {
+    let h = hash3(ix as u32, iy as u32, iz as u32) % 12;
+    let (u, v) = match h {
+        0..=3 => (x, y),
+        4..=7 => (x, z),
+        _ => (y, z),
+    };
+    let u = if h & 1 == 0 { u } else { -u };
+    let v = if h & 2 == 0 { v } else { -v };
+    u + v
+}
+
+/// Improved Perlin noise, in about `[-1, 1]`.
+pub fn perlin(p: Vec3) -> f32 {
+    let (fx, fy, fz) = (p.x.floor(), p.y.floor(), p.z.floor());
+    let (ix, iy, iz) = (fx as i32, fy as i32, fz as i32);
+    let (x, y, z) = (p.x - fx, p.y - fy, p.z - fz);
+    let (u, v, w) = (fade(x), fade(y), fade(z));
+    let lerp = |a: f32, b: f32, t: f32| a + (b - a) * t;
+    let g = |dx: i32, dy: i32, dz: i32| {
+        gradient(
+            ix + dx,
+            iy + dy,
+            iz + dz,
+            x - dx as f32,
+            y - dy as f32,
+            z - dz as f32,
+        )
+    };
+    let value = lerp(
+        lerp(
+            lerp(g(0, 0, 0), g(1, 0, 0), u),
+            lerp(g(0, 1, 0), g(1, 1, 0), u),
+            v,
+        ),
+        lerp(
+            lerp(g(0, 0, 1), g(1, 0, 1), u),
+            lerp(g(0, 1, 1), g(1, 1, 1), u),
+            v,
+        ),
+        w,
+    );
+    // Blender scales its Perlin noise so that it spans about [-1, 1].
+    (value * 0.982).clamp(-1.0, 1.0)
+}
+
+/// Fractal noise: `octaves` layers, each at twice the frequency and
+/// `roughness` times the amplitude of the last, normalised to `[0, 1]`.
+pub fn fractal(p: Vec3, octaves: u32, roughness: f32) -> f32 {
+    let mut sum = 0.0;
+    let mut amplitude = 1.0;
+    let mut total = 0.0;
+    let mut q = p;
+    for _ in 0..octaves.max(1) {
+        sum += perlin(q) * amplitude;
+        total += amplitude;
+        amplitude *= roughness;
+        q *= 2.0;
+    }
+    0.5 + 0.5 * sum / total
+}
+
+/// Blender's `Noise Texture` colour: three decorrelated fractal noises, each
+/// in `[0, 1]`, at `scale` cells a unit.
+pub fn noise_color(p: Vec3, scale: f32) -> Vec3 {
+    let q = p * scale;
+    Vec3::new(
+        fractal(q, 1, 0.5),
+        fractal(q + Vec3::new(31.416, -47.853, 12.679), 1, 0.5),
+        fractal(q + Vec3::new(-83.1, 71.3, -21.7), 1, 0.5),
+    )
+}
+
+/// Blender's `White Noise Texture`: a value in `[0, 1)` per position,
+/// constant nowhere.
+pub fn white(p: Vec3) -> f32 {
+    let h = hash3(
+        p.x.to_bits(),
+        p.y.to_bits(),
+        hash(p.z.to_bits(), 0x5bd1_e995),
+    );
+    (h >> 8) as f32 / (1u32 << 24) as f32
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn perlin_is_zero_on_the_lattice_and_bounded() {
+        assert_eq!(perlin(Vec3::new(3.0, -2.0, 5.0)), 0.0);
+        let mut lo: f32 = 0.0;
+        let mut hi: f32 = 0.0;
+        for i in 0..5000 {
+            let t = i as f32 * 0.137;
+            let v = perlin(Vec3::new(t, t * 0.31 + 1.7, t * 0.73 - 4.1));
+            lo = lo.min(v);
+            hi = hi.max(v);
+        }
+        assert!(lo > -1.01 && hi < 1.01 && hi - lo > 0.8, "{lo} {hi}");
+    }
+
+    #[test]
+    fn perlin_is_continuous() {
+        let a = perlin(Vec3::new(0.4999, 0.3, 0.2));
+        let b = perlin(Vec3::new(0.5001, 0.3, 0.2));
+        assert!((a - b).abs() < 1e-3);
+    }
+}
