+    /// Two strands swung into each other across their paths stop where
+    /// they meet, the one above still above; without the strands'
+    /// collisions they pass through.
+    #[test]
+    fn a_strand_does_not_pass_through_another() {
+        use crate::strands::{Attachment, Strands};
+        let Ok(context) = headless_context() else {
+            eprintln!("no GPU: skipped");
+            return;
+        };
+        let mut groomer = GpuGroomer::new(context).expect("kernels");
+        let points = 16;
+        let mut strands = Strands::new(points);
+        let line = |from: Vec3, to: Vec3| -> Vec<Vec3> {
+            (0..points)
+                .map(|j| from.lerp(to, j as f32 / (points - 1) as f32))
+                .collect()
+        };
+        // One along x, swinging down; one along z beneath it, swinging up:
+        // their bending brings them back, after passing through if nothing
+        // stops them.
+        strands.push(
+            &line(Vec3::new(-0.1, 0.0, 0.0), Vec3::new(0.16, 0.0, 0.0)),
+            Attachment {
+                id: StrandId::from_word(1),
+                ..Default::default()
+            },
+        );
+        strands.push(
+            &line(Vec3::new(0.05, -0.03, -0.1), Vec3::new(0.05, -0.03, 0.16)),
+            Attachment {
+                id: StrandId::from_word(2),
+                ..Default::default()
+            },
+        );
+        let mut crossing = |collide: bool| {
+            // Hair's own bending and damping, nothing pulling it back.
+            let settings = crate::sim::SimSettings {
+                guides: 2,
+                points,
+                strand_collision: collide,
+                collision_radius: 0.006,
+                clump: crate::sim::SimSettings::default().clump,
+                internal_damping: crate::sim::SimSettings::default().internal_damping,
+                ..quiet()
+            };
+            let mut sim = bare_sim(&mut groomer, &strands, settings);
+            let rest = sim.read_rest(&groomer).expect("read");
+            // Which simulated strand is the upper: rooted at -x.
+            let upper = if rest[0][0] < -0.05 { 0 } else { 1 };
+            // Each moving towards the other, faster towards its tip.
+            let previous: Vec<[f32; 4]> = rest
+                .iter()
+                .enumerate()
+                .map(|(i, p)| {
+                    let along = (i % points) as f32 / (points - 1) as f32;
+                    let towards = if i / points == upper { 1.0 } else { -1.0 };
+                    [p[0], p[1] + 0.004 * along * towards, p[2], 1.0]
+                })
+                .collect();
+            sim.set_state(&groomer, &rest, &previous).expect("state");
+            // Wherever the two cross, seen from above, every frame: how far
+            // the upper is above the lower there.
+            let mut heights = Vec::new();
+            for _ in 0..20 {
+                sim.step(&groomer, 1.0 / 60.0, crate::sim::Rigid::default())
+                    .expect("step");
+                let now = sim.read_positions(&groomer).expect("read");
+                let strand = |g: usize| &now[g * points..(g + 1) * points];
+                let (top, bottom) = (strand(upper), strand(1 - upper));
+                for a in top.windows(2) {
+                    for b in bottom.windows(2) {
+                        let (p, r) = ([a[0][0], a[0][2]], [a[1][0] - a[0][0], a[1][2] - a[0][2]]);
+                        let (q, t) = ([b[0][0], b[0][2]], [b[1][0] - b[0][0], b[1][2] - b[0][2]]);
+                        let cross = r[0] * t[1] - r[1] * t[0];
+                        if cross.abs() < 1e-12 {
+                            continue;
+                        }
+                        let d = [q[0] - p[0], q[1] - p[1]];
+                        let u = (d[0] * t[1] - d[1] * t[0]) / cross;
+                        let v = (d[0] * r[1] - d[1] * r[0]) / cross;
+                        if (0.0..=1.0).contains(&u) && (0.0..=1.0).contains(&v) {
+                            let ya = a[0][1] + (a[1][1] - a[0][1]) * u;
+                            let yb = b[0][1] + (b[1][1] - b[0][1]) * v;
+                            heights.push(ya - yb);
+                        }
+                    }
+                }
+            }
+            heights
+        };
+        let with = crossing(true);
+        let without = crossing(false);
+        assert!(
+            without.iter().any(|&h| h < -0.01),
+            "without collisions they should pass: {without:?}"
+        );
+        // Through by no more than a sliver of the radius.
+        assert!(
+            with.iter().all(|&h| h > -0.002),
+            "they passed through: {with:?} above"
+        );
+    }
+
+    /// A bundle pressed together spreads again: the volume pushes hair
+    /// denser than at rest apart.
+    #[test]
+    fn hair_pressed_together_keeps_its_volume() {
+        use crate::strands::{Attachment, Strands};
+        let Ok(context) = headless_context() else {
+            eprintln!("no GPU: skipped");
+            return;
+        };
+        let mut groomer = GpuGroomer::new(context).expect("kernels");
+        let points = 12;
+        let mut strands = Strands::new(points);
+        let mut id = 0;
+        for a in 0..8 {
+            for b in 0..8 {
+                let root = Vec3::new((a as f32 - 3.5) * 0.01, 0.0, (b as f32 - 3.5) * 0.01);
+                let strand: Vec<Vec3> = (0..points)
+                    .map(|j| root + Vec3::new(0.0, -0.15 * j as f32 / (points - 1) as f32, 0.0))
+                    .collect();
+                id += 1;
+                strands.push(
+                    &strand,
+                    Attachment {
+                        id: StrandId::from_word(id),
+                        ..Default::default()
+                    },
+                );
+            }
+        }
+        let mut spread = |volume: f32| {
+            let settings = crate::sim::SimSettings {
+                guides: 64,
+                points,
+                volume,
+                grid_cell: 0.008,
+                ..quiet()
+            };
+            let mut sim = bare_sim(&mut groomer, &strands, settings);
+            // Every point below the root pulled onto the bundle's axis.
+            let rest = sim.read_rest(&groomer).expect("read");
+            let pressed: Vec<[f32; 4]> = rest
+                .iter()
+                .enumerate()
+                .map(|(i, p)| {
+                    if i % points == 0 {
+                        *p
+                    } else {
+                        [p[0] * 0.1, p[1], p[2] * 0.1, 1.0]
+                    }
+                })
+                .collect();
+            sim.set_state(&groomer, &pressed, &pressed).expect("state");
+            for _ in 0..30 {
+                sim.step(&groomer, 1.0 / 60.0, crate::sim::Rigid::default())
+                    .expect("step");
+            }
+            let now = sim.read_positions(&groomer).expect("read");
+            let middle: Vec<f32> = now
+                .chunks(points)
+                .map(|s| (s[points / 2][0].powi(2) + s[points / 2][2].powi(2)).sqrt())
+                .collect();
+            middle.iter().sum::<f32>() / middle.len() as f32
+        };
+        let kept = spread(0.5);
+        let pressed = spread(0.0);
+        assert!(
+            kept > pressed * 1.5,
+            "the bundle stayed pressed: {kept} m out against {pressed} m"
+        );
+    }
+
+    /// Every hairstyle, curls and all, rests as groomed under gravity with
+    /// its strands meeting each other, and swings with a shaking head
+    /// without blowing up.
+    #[test]
+    fn every_hairstyle_rests_and_swings() {
+        use crate::sim::{Rigid, SimLevel, SimSettings};
+        let Ok(context) = headless_context() else {
+            eprintln!("no GPU: skipped");
+            return;
+        };
+        let mut groomer = GpuGroomer::new(context).expect("kernels");
+        groomer
+            .set_head_mesh(&Head::mannequin().mesh(0.008))
+            .expect("head");
+        let shake = |t: f32| {
+            Rigid::from_angles(
+                0.6 * (7.0 * t).sin(),
+                0.2 * (5.0 * t).sin(),
+                0.0,
+                Vec3::new(0.0, -0.12, -0.02),
+                Vec3::default(),
+            )
+        };
+        for preset in Preset::ALL {
+            let mut look = Look::new(preset);
+            look.strands = StrandCount::from_count(20_000);
+            let head = look.head(&Head::mannequin());
+            let scalp = groomer.cut_scalp(&head, 0.006).expect("scalp");
+            let grown = groomer.grow_look(&look, &head, &scalp).expect("grown");
+            let lods = groomer
+                .lods(&grown, head.cranium.center, &crate::LodSettings::default())
+                .expect("levels");
+            let mut sim = groomer
+                .simulate(
+                    &lods,
+                    Some(&head),
+                    SimSettings::default().at(SimLevel::MEDIUM),
+                )
+                .expect("sim");
+            for _ in 0..30 {
+                sim.step(&groomer, 1.0 / 60.0, Rigid::default())
+                    .expect("step");
+            }
+            let rest = sim.read_rest(&groomer).expect("read");
+            let still = sim.read_positions(&groomer).expect("read");
+            let drift = still
+                .iter()
+                .zip(&rest)
+                .map(|(a, b)| (Vec3::new(a[0], a[1], a[2]) - Vec3::new(b[0], b[1], b[2])).length())
+                .fold(0.0f32, f32::max);
+            for frame in 1..=90 {
+                sim.step(&groomer, 1.0 / 60.0, shake(frame as f32 / 60.0))
+                    .expect("step");
+            }
+            let shaken = sim.read_positions(&groomer).expect("read");
+            let centre = head.cranium.center;
+            let farthest = shaken
+                .iter()
+                .map(|p| (Vec3::new(p[0], p[1], p[2]) - centre).length())
+                .fold(
+                    0.0f32,
+                    |a, b| if b.is_nan() { f32::INFINITY } else { a.max(b) },
+                );
+            eprintln!("{preset:?}: drifts {drift} m at rest, reaches {farthest} m shaken");
+            // Dense curls settle a few millimetres as their strands find
+            // each other; nothing else moves.
+            assert!(drift < 0.01, "{preset:?} drifts {drift} m at rest");
+            assert!(
+                farthest < 0.8,
+                "{preset:?} reaches {farthest} m from the head"
+            );
+        }
+    }
+
+    /// A simulation moved to a finer level carries on as it was: the
+    /// strands both simulate are where they were.
+    #[test]
+    fn a_simulation_changes_level_without_a_jump() {
+        use crate::sim::{Rigid, SimLevel, SimSettings};
+        let Ok(context) = headless_context() else {
+            eprintln!("no GPU: skipped");
+            return;
+        };
+        let mut groomer = GpuGroomer::new(context).expect("kernels");
+        groomer
+            .set_head_mesh(&Head::mannequin().mesh(0.008))
+            .expect("head");
+        let mut look = Look::new(Preset::Long);
+        look.strands = StrandCount::from_count(20_000);
+        let head = look.head(&Head::mannequin());
+        let scalp = groomer.cut_scalp(&head, 0.006).expect("scalp");
+        let grown = groomer.grow_look(&look, &head, &scalp).expect("grown");
+        let lods = groomer
+            .lods(&grown, head.cranium.center, &crate::LodSettings::default())
+            .expect("levels");
+        let settings = SimSettings::default();
+        let mut low = groomer
+            .simulate(&lods, Some(&head), settings.at(SimLevel::LOW))
+            .expect("sim");
+        let sway = Rigid::from_angles(0.4, 0.1, 0.0, Vec3::new(0.0, -0.12, -0.02), Vec3::default());
+        for _ in 0..20 {
+            low.step(&groomer, 1.0 / 60.0, sway).expect("step");
+        }
+        let high = groomer
+            .resimulate(&low, &lods, Some(&head), settings.at(SimLevel::HIGH))
+            .expect("resimulated");
+        assert_eq!(high.level(), SimLevel::HIGH);
+        let before = low.read_positions(&groomer).expect("read");
+        let after = high.read_positions(&groomer).expect("read");
+        let (lp, hp) = (low.points(), high.points());
+        // The low level's strands, at their tips, in both.
+        for g in 0..low.strands() {
+            let a = before[g * lp + lp - 1];
+            let b = after[g * hp + hp - 1];
+            let off = (Vec3::new(a[0], a[1], a[2]) - Vec3::new(b[0], b[1], b[2])).length();
+            assert!(off < 1e-4, "strand {g} jumped {off} m");
+        }
+        // And none of the new strands left at rest while the head is turned.
+        let rest = high.read_rest(&groomer).expect("read");
+        let moved = (low.strands()..high.strands())
+            .filter(|g| {
+                let i = g * hp + hp - 1;
+                let p = Vec3::new(after[i][0], after[i][1], after[i][2]);
+                let r = Vec3::new(rest[i][0], rest[i][1], rest[i][2]);
+                (p - r).length() > 1e-3
+            })
+            .count();
+        assert!(
+            moved * 10 > (high.strands() - low.strands()) * 9,
+            "{moved} new strands moved"
+        );
+    }
+}
diff --git a/crates/fabelgeist-hair/src/gpu/scalp.rs b/crates/fabelgeist-hair/src/gpu/scalp.rs
new file mode 100644
index 000000000..dfe3c6b20
--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/scalp.rs
@@ -0,0 +1,412 @@
+//! A scalp on the GPU: what roots and guides are placed on -- cut there from
+//! the head's field ([`GpuGroomer::cut_scalp`]), or uploaded -- kept for as
+//! long as the hairline stays.
+
+use crate::gpu::error::{HairGpuError, Result};
+use fabelgeist_compute::KernelBatch;
+use fabelgeist_compute::ScanElementCount;
+use fabelgeist_gpu::data::gpu::buffer::Buffer;
+use fabelgeist_math::Vec3;
+
+use super::grow::params;
+use super::{GpuGroomer, head_shape, storage, upload};
+use crate::head::Head;
+use crate::surface::Surface;
+
+mod layout;
+
+/// A scalp mesh on the GPU: its triangles with their running area (to
+/// place points by area), its vertices, and its open edge -- the hairline
+/// -- as points two millimetres apart (the guides' row along it) and one
+/// apart (how far in from it each vertex is).
+pub struct GpuScalp {
+    pub(super) triangles: u32,
+    pub(super) vertices: u32,
+    pub(super) area: f32,
+    pub(super) tri_cdf: Buffer,
+    pub(super) tri_index: Buffer,
+    pub(super) points: Buffer,
+    pub(super) normals: Buffer,
+    pub(super) uvs: Buffer,
+    pub(super) boundary: Buffer,
+    pub(super) boundary_count: u32,
+    pub(super) boundary_fine: Buffer,
+    pub(super) boundary_fine_count: u32,
+    /// A box the scalp is inside.
+    pub bounds: [Vec3; 2],
+}
+
+impl GpuScalp {
+    /// Triangles, and vertices.
+    pub fn counts(&self) -> (usize, usize) {
+        (self.triangles as usize, self.vertices as usize)
+    }
+
+    /// The whole area, square metres.
+    pub fn area(&self) -> f32 {
+        self.area
+    }
+
+    /// Points along the open edge (the hairline), two millimetres apart,
+    /// and one.
+    pub fn boundary_counts(&self) -> (usize, usize) {
+        (
+            self.boundary_count as usize,
+            self.boundary_fine_count as usize,
+        )
+    }
+
+    /// The scalp back on the host: its vertices (position, normal, UV) and
+    /// triangles.
+    pub fn read(&self, groomer: &GpuGroomer) -> Result<Surface> {
+        let context = groomer.context();
+        let n = self.vertices as usize;
+        let four = |buffer: &Buffer| -> Result<Vec<[f32; 4]>> {
+            let mut all: Vec<[f32; 4]> = pollster::block_on(buffer.read(context))?;
+            all.truncate(n);
+            Ok(all)
+        };
+        let positions = four(&self.points)?;
+        let normals = four(&self.normals)?;
+        let uvs = four(&self.uvs)?;
+        let mut triangles: Vec<[u32; 4]> = pollster::block_on(self.tri_index.read(context))?;
+        triangles.truncate(self.triangles as usize);
+        let v = |p: &[f32; 4]| Vec3::new(p[0], p[1], p[2]);
+        Ok(Surface::new(
+            positions.iter().map(v).collect(),
+            Some(normals.iter().map(v).collect()),
+            Some(uvs.iter().map(|uv| [uv[0], uv[1]]).collect()),
+            triangles.iter().map(|t| [t[0], t[1], t[2]]).collect(),
+        ))
+    }
+}
+
+impl GpuGroomer {
+    /// `scalp` onto the GPU, for [`GpuGroomer::grow`] to root hair on.
+    pub fn upload_scalp(&self, scalp: &Surface) -> Result<GpuScalp> {
+        let context = &self.context;
+        let mut tri_cdf = Vec::with_capacity(scalp.triangles.len());
+        let mut tri_index = Vec::with_capacity(scalp.triangles.len());
+        let mut total = 0.0;
+        for t in &scalp.triangles {
+            let [a, b, c] = t.map(|i| scalp.positions[i as usize]);
+            total += (b - a).cross(c - a).length() * 0.5;
+            tri_cdf.push(total);
+            tri_index.push([t[0], t[1], t[2], 0]);
+        }
+        let four = |v: &[Vec3]| v.iter().map(|p| [p.x, p.y, p.z, 0.0]).collect::<Vec<_>>();
+        let uvs: Vec<[f32; 4]> = scalp
+            .uvs
+            .iter()
+            .map(|uv| [uv[0], uv[1], 0.0, 0.0])
+            .collect();
+        let boundary = scalp.boundary(0.002);
+        let boundary_fine = scalp.boundary(0.001);
+        let (mut lo, mut hi) = (Vec3::splat(f32::INFINITY), Vec3::splat(f32::NEG_INFINITY));
+        for p in &scalp.positions {
+            lo = lo.min(*p);
+            hi = hi.max(*p);
+        }
+        Ok(GpuScalp {
+            triangles: scalp.triangles.len() as u32,
+            vertices: scalp.positions.len() as u32,
+            area: scalp.area(),
+            tri_cdf: upload(context, &tri_cdf, "hair scalp areas".into())?,
+            tri_index: upload(context, &tri_index, "hair scalp triangles".into())?,
+            points: upload(context, &four(&scalp.positions), "hair scalp points".into())?,
+            normals: upload(context, &four(&scalp.normals), "hair scalp normals".into())?,
+            uvs: upload(context, &uvs, "hair scalp uvs".into())?,
+            boundary: upload(context, &four(&boundary), "hair scalp edge".into())?,
+            boundary_count: boundary.len() as u32,
+            boundary_fine: upload(
+                context,
+                &four(&boundary_fine),
+                "hair scalp edge, fine".into(),
+            )?,
+            boundary_fine_count: boundary_fine.len() as u32,
+            bounds: [lo, hi],
+        })
+    }
+
+    /// `head`'s scalp, cut on the GPU as [`Head::scalp`] cuts it on the
+    /// host -- surface nets over the head's field on a grid of `cell`
+    /// metres, the part above the hairline -- to the same triangles and
+    /// vertices in the same order. Two waits, for how many triangles and
+    /// then how many vertices and hairline points.
+    pub fn cut_scalp(&mut self, head: &Head, cell: f32) -> Result<GpuScalp> {
+        let context = self.context.clone();
+        let shape = upload(&context, &head_shape(head), "hair head shape".into())?;
+        let layout = layout::ScalpGrid::new(head, cell);
+        let (corners, cells, edges) = (layout.corners, layout.cells, layout.edges);
+        let grid = |count| layout.parameters(head, count);
+        let one = |count: u32| {
+            params! {
+                "count" => count,
+                "pad0" => 0u32,
+                "pad1" => 0u32,
+                "pad2" => 0u32,
+            }
+        };
+
+        // The field, the cells' vertices, and how many triangles each grid
+        // edge's quad keeps.
+        let mut batch = KernelBatch::labelled(&context, "hair scalp cells");
+        let values = self.scratch.nets_values.fit(
+            &context,
+            (corners as u64 * 4).into(),
+            "hair scalp field".into(),
+        )?;
+        let mut p = grid(corners);
+        p.insert("head_shape", shape.clone());
+        p.insert("values", values.clone());
+        batch.dispatch_folded(&self.kernels.nets_values, &p, corners)?;
+        let cell_vertices = self.scratch.nets_cells.fit(
+            &context,
+            (cells as u64 * 16).into(),
+            "hair scalp cells".into(),
+        )?;
+        let mut p = grid(cells);
+        p.insert("head_shape", shape.clone());
+        p.insert("values", values.clone());
+        p.insert("cells", cell_vertices.clone());
+        batch.dispatch_folded(&self.kernels.nets_cells, &p, cells)?;
+        let counts = self.scratch.nets_counts.fit(
+            &context,
+            ((edges as u64 + 1) * 4).into(),
+            "hair scalp quad counts".into(),
+        )?;
+        batch.clear_buffer(&counts);
+        let mut p = grid(edges);
+        p.insert("values", values.clone());
+        p.insert("cells", cell_vertices.clone());
+        p.insert("counts", counts.clone());
+        batch.dispatch_folded(&self.kernels.nets_quads_count, &p, edges)?;
+        self.ensure_scan(edges + 1)?;
+        self.scan.record(
+            &mut batch,
+            &counts,
+            &self.scan_scratch,
+            ScanElementCount::from_elements(edges + 1),
+        )?;
+        let triangles = self.read_words(batch, &[(counts.clone(), edges)])?[0];
+        if triangles == 0 {
+            return Err(HairGpuError::EmptyScalp);
+        }
+
+        // The triangles in order, their vertices numbered as the host
+        // numbers them, the running area, and the open edges.
+        let mut batch = KernelBatch::labelled(&context, "hair scalp mesh");
+        let tri_cells = self.scratch.nets_triangles.fit(
+            &context,
+            (triangles as u64 * 16).into(),
+            "hair scalp triangle cells".into(),
+        )?;
+        let mut p = grid(edges);
+        p.insert("values", values.clone());
+        p.insert("cells", cell_vertices.clone());
+        p.insert("offsets", counts.clone());
+        p.insert("triangles", tri_cells.clone());
+        batch.dispatch_folded(&self.kernels.nets_quads_emit, &p, edges)?;
+        let first = self.scratch.nets_first.fit(
+            &context,
+            (cells as u64 * 4).into(),
+            "hair scalp first uses".into(),
+        )?;
+        batch.clear_buffer(&first);
+        let mut p = one(triangles);
+        p.insert("triangles", tri_cells.clone());
+        p.insert("first", first.clone());
+        batch.dispatch_folded(&self.kernels.nets_first, &p, triangles)?;
+        let uses = triangles * 3;
+        let flags = self.scratch.nets_flags.fit(
+            &context,
+            ((uses as u64 + 1) * 4).into(),
+            "hair scalp vertex flags".into(),
+        )?;
+        batch.clear_buffer(&flags);
+        let cell_at = self.scratch.nets_cell_at.fit(
+            &context,
+            (uses as u64 * 4).into(),
+            "hair scalp vertex cells".into(),
+        )?;
+        let mut p = one(cells);
+        p.insert("first", first);
+        p.insert("flags", flags.clone());
+        p.insert("cell_at", cell_at.clone());
+        batch.dispatch_folded(&self.kernels.nets_order, &p, cells)?;
+        self.ensure_scan(uses + 1)?;
+        self.scan.record(
+            &mut batch,
+            &flags,
+            &self.scan_scratch,
+            ScanElementCount::from_elements(uses + 1),
+        )?;
+        let vertex_of = self.scratch.nets_vertex_of.fit(
+            &context,
+            (cells as u64 * 4).into(),
+            "hair scalp vertex numbers".into(),
+        )?;
+        // At most a vertex a use: sized before the count is known.
+        let points = storage(
+            &context,
+            (uses as u64 * 16).into(),
+            "hair scalp points".into(),
+        )?;
+        let normals = storage(
+            &context,
+            (uses as u64 * 16).into(),
+            "hair scalp normals".into(),
+        )?;
+        let uvs = storage(&context, (uses as u64 * 16).into(), "hair scalp uvs".into())?;
+        let mut p = one(uses);
+        p.insert("head_shape", shape.clone());
+        p.insert("cells", cell_vertices);
+        p.insert("flags", flags.clone());
+        p.insert("cell_at", cell_at);
+        p.insert("vertex_of", vertex_of.clone());
+        p.insert("scalp_points", points.clone());
+        p.insert("scalp_normals", normals.clone());
+        p.insert("scalp_uvs", uvs.clone());
+        batch.dispatch_folded(&self.kernels.nets_vertices, &p, uses)?;
+        let tri_index = storage(
+            &context,
+            (triangles as u64 * 16).into(),
+            "hair scalp triangles".into(),
+        )?;
+        let areas = self.scratch.nets_areas.fit(
+            &context,
+            (triangles as u64 * 4).into(),
+            "hair scalp triangle areas".into(),
+        )?;
+        let keys = self.scratch.nets_keys.fit(
+            &context,
+            (uses as u64 * 4).into(),
+            "hair scalp edges".into(),
+        )?;
+        let ids = self.scratch.nets_ids.fit(
+            &context,
+            (uses as u64 * 4).into(),
+            "hair scalp edge ids".into(),
+        )?;
+        let box_words = self
+            .scratch
+            .box_words
+            .fit(&context, 32_u64.into(), "hair box".into())?;
+        batch.clear_buffer(&box_words);
+        let mut p = one(triangles);
+        p.insert("triangles", tri_cells);
+        p.insert("vertex_of", vertex_of);
+        p.insert("scalp_points", points.clone());
+        p.insert("tri_index", tri_index.clone());
+        p.insert("areas", areas.clone());
+        p.insert("edge_keys", keys.clone());
+        p.insert("edge_ids", ids.clone());
+        p.insert("box_words", box_words.clone());
+        batch.dispatch_folded(&self.kernels.nets_triangles, &p, triangles)?;
+        let tri_cdf = storage(
+            &context,
+            (triangles as u64 * 4).into(),
+            "hair scalp areas".into(),
+        )?;
+        let mut p = one(triangles);
+        p.insert("areas", areas);
+        p.insert("tri_cdf", tri_cdf.clone());
+        batch.dispatch(&self.kernels.nets_cdf, &p, [1, 1, 1])?;
+        // The edges sorted by their vertices, as the host sorts its open
+        // edges; how many points each open one gets at either spacing.
+        self.sort_scratch.ensure(&context, uses)?;
+        self.sort
+            .record(&mut batch, &keys, &ids, &mut self.sort_scratch, uses, 32)?;
+        let (step, fine_step) = (0.002f32, 0.001f32);
+        let steps = self.scratch.nets_steps.fit(
+            &context,
+            ((uses as u64 + 1) * 4).into(),
+            "hair scalp edge steps".into(),
+        )?;
+        let fine = self.scratch.nets_fine.fit(
+            &context,
+            ((uses as u64 + 1) * 4).into(),
+            "hair scalp fine edge steps".into(),
+        )?;
+        batch.clear_buffer(&steps);
+        batch.clear_buffer(&fine);
+        batch.dispatch_folded(
+            &self.kernels.nets_open,
+            &params! {
+                "edge_keys" => keys.clone(),
+                "scalp_points" => points.clone(),
+                "steps" => steps.clone(),
+                "fine" => fine.clone(),
+                "count" => uses,
+                "pad0" => 0u32,
+                "step" => step,
+                "fine_step" => fine_step,
+            },
+            uses,
+        )?;
+        self.scan.record(
+            &mut batch,
+            &steps,
+            &self.scan_scratch,
+            ScanElementCount::from_elements(uses + 1),
+        )?;
+        self.scan.record(
+            &mut batch,
+            &fine,
+            &self.scan_scratch,
+            ScanElementCount::from_elements(uses + 1),
+        )?;
+        let mut words = vec![
+            (flags, uses),
+            (steps.clone(), uses),
+            (fine.clone(), uses),
+            (tri_cdf.clone(), triangles - 1),
+        ];
+        words.extend((0..6).map(|k| (box_words.clone(), k)));
+        let read = self.read_words(batch, &words)?;
+        let (vertices, boundary_count, boundary_fine_count) = (read[0], read[1], read[2]);
+        if vertices >= 1 << 16 {
+            return Err(HairGpuError::ScalpVertexLimit);
+        }
+        let area = f32::from_bits(read[3]);
+        let bounds = layout::ordered_bounds(&read[4..10]);
+
+        // The points along the hairline.
+        let mut batch = KernelBatch::labelled(&context, "hair scalp edge");
+        let boundary = storage(
+            &context,
+            (boundary_count as u64 * 16).into(),
+            "hair scalp edge".into(),
+        )?;
+        let boundary_fine = storage(
+            &context,
+            (boundary_fine_count as u64 * 16).into(),
+            "hair scalp edge, fine".into(),
+        )?;
+        for (offsets, out) in [(&steps, &boundary), (&fine, &boundary_fine)] {
+            let mut p = one(uses);
+            p.insert("edge_keys", keys.clone());
+            p.insert("scalp_points", points.clone());
+            p.insert("offsets", offsets.clone());
+            p.insert("boundary", out.clone());
+            batch.dispatch_folded(&self.kernels.nets_boundary, &p, uses)?;
+        }
+        batch.submit();
+
+        Ok(GpuScalp {
+            triangles,
+            vertices,
+            area,
+            tri_cdf,
+            tri_index,
+            points: layout::trimmed(points, (vertices as u64 * 16).into()),
+            normals: layout::trimmed(normals, (vertices as u64 * 16).into()),
+            uvs: layout::trimmed(uvs, (vertices as u64 * 16).into()),
+            boundary,
+            boundary_count,
+            boundary_fine,
+            boundary_fine_count,
+            bounds,
+        })
+    }
+}
diff --git a/crates/fabelgeist-hair/src/gpu/scalp/layout.rs b/crates/fabelgeist-hair/src/gpu/scalp/layout.rs
new file mode 100644
index 000000000..a6481d1d0
--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/scalp/layout.rs
@@ -0,0 +1,93 @@
+//! Surface-net shader grid: native metre coordinates and invocation extents.
+use super::*;
+use fabelgeist_gpu::data::gpu::parameters::PassParameters;
+pub(super) struct ScalpGrid {
+    lo: Vec3,
+    cell: f32,
+    nx: u32,
+    ny: u32,
+    nz: u32,
+    j0: u32,
+    keep_y: f32,
+    pub(super) corners: u32,
+    pub(super) cells: u32,
+    pub(super) edges: u32,
+}
+impl ScalpGrid {
+    pub(super) fn new(head: &Head, cell: f32) -> Self {
+        // The bust's grid, as `Head::mesh` lays it, from the rows the scalp
+        // can reach: a kept vertex is above `keep_y`, and within three
+        // cells of its own (two Newton steps each less than a cell), and a
+        // quad joins cells a row apart.
+        let lo = Vec3::new(-0.24, head.base - 0.01, -0.16);
+        let hi = Vec3::new(0.24, 0.14, 0.14);
+        let cells_along = [hi.x - lo.x, hi.y - lo.y, hi.z - lo.z]
+            .map(|extent| ((extent / cell).ceil() as u32).max(1));
+        let keep_y = head.neck.a.y - 0.04;
+        let j0 =
+            (((keep_y - lo.y) / cell).floor() as i64 - 6).clamp(0, cells_along[1] as i64) as u32;
+        let (nx, ny, nz) = (
+            cells_along[0] + 1,
+            cells_along[1] + 1 - j0,
+            cells_along[2] + 1,
+        );
+        let corners = nx * ny * nz;
+        let cells = (nx - 1) * (ny - 1) * (nz - 1);
+        let edges = corners * 3;
+        Self {
+            lo,
+            cell,
+            nx,
+            ny,
+            nz,
+            j0,
+            keep_y,
+            corners,
+            cells,
+            edges,
+        }
+    }
+    pub(super) fn parameters(&self, head: &Head, count: u32) -> PassParameters {
+        params! {
+            "lo_x" => self.lo.x,
+            "lo_y" => self.lo.y,
+            "lo_z" => self.lo.z,
+            "cell" => self.cell,
+            "nx" => self.nx,
+            "ny" => self.ny,
+            "nz" => self.nz,
+            "j0" => self.j0,
+            "hairline_front" => head.hairline[0],
+            "hairline_side" => head.hairline[1],
+            "hairline_back" => head.hairline[2],
+            "recession" => head.recession,
+            "peak" => head.peak,
+            "keep_y" => self.keep_y,
+            "count" => count,
+            "pad0" => 0u32,
+        }
+    }
+}
+
+/// Decode the surface-net bounds pass's six ordered IEEE-754 words.
+pub(super) fn ordered_bounds(words: &[u32]) -> [Vec3; 2] {
+    let float = |key: u32| {
+        f32::from_bits(if key & 0x8000_0000 != 0 {
+            key & 0x7FFF_FFFF
+        } else {
+            !key
+        })
+    };
+    [
+        Vec3::new(float(!words[0]), float(!words[1]), float(!words[2])),
+        Vec3::new(float(words[3]), float(words[4]), float(words[5])),
+    ]
+}
+
+pub(super) fn trimmed(
+    mut buffer: Buffer,
+    bytes: fabelgeist_gpu::data::gpu::buffer::BufferByteLength,
+) -> Buffer {
+    buffer.size = u64::from(bytes).max(16).into();
+    buffer
+}
diff --git a/crates/fabelgeist-hair/src/gpu/sim.rs b/crates/fabelgeist-hair/src/gpu/sim.rs
new file mode 100644
index 000000000..5d342a950
--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/sim.rs
@@ -0,0 +1,797 @@
+//! Real-time physics on the GPU: [`crate::sim::HairSim`]'s strands, stepped
+//! where the groom already is and read where it is drawn, and meeting each
+//! other -- volume, friction and collisions (see [`crate::sim`]).
+//!
+//! A groom made on the GPU never comes back to the host, and neither does
+//! its simulation: the simulated strands are the first of the groom's
+//! shuffled order (an even sample of the head, as on the host), resampled
+//! to the simulation's points; each drawn strand is bound to the four
+//! nearest its root by a kernel, and a substep is a dispatch with an
+//! invocation a simulated strand, which takes its rod through the
+//! substep's implicit steps ([`crate::rod`]) before the strands meet. The renderer deforms the levels it draws
+//! straight from the positions buffer
+//! ([`crate::render::HairRenderer::set_gpu_dynamics`]).
+//!
+//! How many strands, of how many points, is the simulation's level of
+//! detail ([`SimLevel`]); [`GpuGroomer::resimulate`] moves a running
+//! simulation to another, carrying its motion.
+
+use crate::gpu::error::Result;
+use fabelgeist_compute::KernelBatch;
+use fabelgeist_compute::PrefixSumScratch;
+use fabelgeist_compute::ScanElementCount;
+use fabelgeist_gpu::data::gpu::buffer::Buffer;
+use fabelgeist_gpu::data::gpu::parameters::PassParameters;
+use fabelgeist_math::Vec3;
+
+use super::grow::params;
+use super::{GpuGroomer, GpuLods, head_shape, storage, upload};
+use crate::head::Head;
+use crate::rod::Rod;
+use crate::sim::{Rigid, SimLevel, SimSettings, blend};
+
+mod density;
+
+/// The density grid, in the head's frame.
+struct SimGrid {
+    lo: Vec3,
+    cell: f32,
+    dims: [u32; 3],
+    /// Density and momentum, four words a cell, cleared every substep.
+    words: Buffer,
+    /// The groom's density at rest.
+    rest_density: Buffer,
+    /// The rest density's sum and how many cells hold any.
+    stats: Buffer,
+}
+
+impl SimGrid {
+    fn cells(&self) -> u32 {
+        self.dims[0] * self.dims[1] * self.dims[2]
+    }
+
+    fn insert(&self, p: &mut PassParameters) {
+        p.insert("lo_x", self.lo.x);
+        p.insert("lo_y", self.lo.y);
+        p.insert("lo_z", self.lo.z);
+        p.insert("cell", self.cell);
+        p.insert("nx", self.dims[0]);
+        p.insert("ny", self.dims[1]);
+        p.insert("nz", self.dims[2]);
+    }
+}
+
+/// The grid the strands' samples are sorted into to find their neighbours:
+/// cells as wide as a sample's reach, round the groom in the head's frame
+/// (samples outside are kept in the nearest cell), and how many samples
+/// each holds, scanned into where each cell's begin.
+struct CollisionCells {
+    lo: Vec3,
+    cell: f32,
+    dims: [u32; 3],
+    counts: Buffer,
+    scan: PrefixSumScratch,
+}
+
+impl CollisionCells {
+    fn cells(&self) -> u32 {
+        self.dims[0] * self.dims[1] * self.dims[2]
+    }
+}
+
+/// Simulated strands on the GPU, and each drawn strand's binding to them.
+pub struct GpuSim {
+    pub settings: SimSettings,
+    count: u32,
+    points: u32,
+    /// Groomed points, in the head's frame, `w` one.
+    rest: Buffer,
+    /// Each strand's rod's rest ([`crate::rod::rest_shape`]), two words a
+    /// point, and the material and choice it was solved for.
+    shape: Buffer,
+    shaped: Option<(Rod, bool)>,
+    /// The implicit steps' factors, fourteen words a point.
+    factors: Buffer,
+    /// World space, `w` one, as the renderer reads them; `previous` is a
+    /// substep's velocity behind, the substep `h_last` seconds. Each
+    /// segment's frame and angular velocity, two words a point.
+    position: Buffer,
+    previous: Buffer,
+    frames: Buffer,
+    h_last: f32,
+    /// Per drawn strand, in the groom's shuffled order: four simulated
+    /// strands and their weights.
+    ids: Buffer,
+    weights: Buffer,
+    head_shape: Buffer,
+    body: u32,
+    head: Rigid,
+    time: f32,
+    grid: SimGrid,
+    /// The strands' collisions: how many strands collide, samples along
+    /// their segments -- this pass's and the last's, in turn -- with their
+    /// segments and velocities, sorted into a grid of cells in the head's
+    /// frame.
+    colliders: u32,
+    cells: CollisionCells,
+    samples: [Buffer; 2],
+    current: usize,
+    have_before: bool,
+    /// Each sample's segment, now and at rest, and its velocity.
+    sample_data: Buffer,
+    per_segment: u32,
+    radius: f32,
+    /// Each sample's cell and place in it.
+    sample_slots: Buffer,
+    /// The samples in the cells' order, eight words a sample, and which
+    /// sample each is.
+    sorted: Buffer,
+    sorted_index: Buffer,
+    /// What each sample asks, two words a sample.
+    asks: Buffer,
+}
+
+fn insert_rigid(p: &mut PassParameters, head: &Rigid) {
+    let [x, y, z] = head.axes;
+    let t = head.translation;
+    for (name, value) in [
+        ("ax_x", x.x),
+        ("ax_y", x.y),
+        ("ax_z", x.z),
+        ("ay_x", y.x),
+        ("ay_y", y.y),
+        ("ay_z", y.z),
+        ("az_x", z.x),
+        ("az_y", z.y),
+        ("az_z", z.z),
+        ("tx", t.x),
+        ("ty", t.y),
+        ("tz", t.z),
+    ] {
+        p.insert(name, value);
+    }
+}
+
+/// The pose a substep starts from, as [`crate::gpu::wgsl::sim`]'s
+/// `FROM_PARAMS` names it.
+fn insert_from(p: &mut PassParameters, head: &Rigid) {
+    let [x, y, z] = head.axes;
+    let t = head.translation;
+    for (name, value) in [
+        ("from_xx", x.x),
+        ("from_xy", x.y),
+        ("from_xz", x.z),
+        ("from_yx", y.x),
+        ("from_yy", y.y),
+        ("from_yz", y.z),
+        ("from_zx", z.x),
+        ("from_zy", z.y),
+        ("from_zz", z.z),
+        ("from_tx", t.x),
+        ("from_ty", t.y),
+        ("from_tz", t.z),
+    ] {
+        p.insert(name, value);
+    }
+}
+
+impl GpuGroomer {
+    /// Simulate `lods`' groom at `settings`' level (its strands and
+    /// points), keeping it out of `head` when there is one: the strands
+    /// bound and at rest, the head where [`Rigid::default`] has it until
+    /// [`GpuSim::reset`].
+    pub fn simulate(
+        &mut self,
+        lods: &GpuLods,
+        head: Option<&Head>,
+        settings: SimSettings,
+    ) -> Result<GpuSim> {
+        let mut sim = self.make_sim(lods, head, settings)?;
+        sim.reset(self, Rigid::default())?;
+        Ok(sim)
+    }
+
+    /// `old`'s simulation moved to `settings`' level: the strands both
+    /// simulate carry on as they were, resampled, and the others start as
+    /// the old strands around them have moved.
+    pub fn resimulate(
+        &mut self,
+        old: &GpuSim,
+        lods: &GpuLods,
+        head: Option<&Head>,
+        settings: SimSettings,
+    ) -> Result<GpuSim> {
+        let mut sim = self.make_sim(lods, head, settings)?;
+        let context = self.context.clone();
+        let first = &lods.levels[0];
+        // Each new strand's nearest among the old ones.
+        let ids = storage(
+            &context,
+            (sim.count as u64 * 16).into(),
+            "hair sim transfer ids".into(),
+        )?;
+        let weights = storage(
+            &context,
+            (sim.count as u64 * 16).into(),
+            "hair sim transfer weights".into(),
+        )?;
+        let mut batch = KernelBatch::labelled(&context, "hair sim transfer");
+        batch.dispatch_folded(
+            &self.kernels.sim_bind,
+            &params! {
+                "level" => first.positions.clone(),
+                "ids" => ids.clone(),
+                "weights" => weights.clone(),
+                "strands" => sim.count,
+                "points" => first.points,
+                "count" => old.count,
+                "pad0" => 0u32,
+            },
+            sim.count,
+        )?;
+        let mut p = params! {
+            "rest" => sim.rest.clone(),
+            "position" => sim.position.clone(),
+            "previous" => sim.previous.clone(),
+            "old_rest" => old.rest.clone(),
+            "old_position" => old.position.clone(),
+            "old_previous" => old.previous.clone(),
+            "ids" => ids,
+            "weights" => weights,
+            "count" => sim.count,
+            "points" => sim.points,
+            "old_points" => old.points,
+            "pad0" => 0u32,
+        };
+        insert_rigid(&mut p, &old.head);
+        batch.dispatch_folded(&self.kernels.sim_transfer, &p, sim.count * sim.points)?;
+        sim.record_shape(self, &mut batch)?;
+        sim.record_orient(self, &mut batch, &old.head)?;
+        batch.submit();
+        sim.head = old.head;
+        sim.time = old.time;
+        sim.h_last = old.h_last;
+        Ok(sim)
+    }
+
+    fn make_sim(
+        &mut self,
+        lods: &GpuLods,
+        head: Option<&Head>,
+        settings: SimSettings,
+    ) -> Result<GpuSim> {
+        let context = self.context.clone();
+        let first = &lods.levels[0];
+        let strands = first.count;
+        let count = (settings.guides as u32).min(strands).max(1.min(strands));
+        let points = (settings.points as u32).max(2);
+        let words = (count * points) as u64 * 16;
+        let rest = storage(&context, (words).into(), "hair sim rest".into())?;
+        let shape = storage(&context, (words * 2).into(), "hair sim rod rest".into())?;
+        let frames = storage(&context, (words * 2).into(), "hair sim frames".into())?;
+        let factors = storage(&context, (words * 14).into(), "hair sim factors".into())?;
+        let position = storage(&context, (words).into(), "hair sim positions".into())?;
+        let previous = storage(&context, (words).into(), "hair sim previous".into())?;
+        let ids = storage(
+            &context,
+            (strands as u64 * 16).into(),
+            "hair sim bind ids".into(),
+        )?;
+        let weights = storage(
+            &context,
+            (strands as u64 * 16).into(),
+            "hair sim bind weights".into(),
+        )?;
+        let body = upload(
+            &context,
+            &head.map(head_shape).unwrap_or_else(|| vec![[0.0; 4]; 17]),
+            "hair sim head".into(),
+        )?;
+        let longest = storage(&context, 16_u64.into(), "hair sim longest segment".into())?;
+        let mut batch = KernelBatch::labelled(&context, "hair sim");
+        batch.clear_buffer(&longest);
+        batch.dispatch_folded(
+            &self.kernels.sim_rest,
+            &params! {
+                "level" => first.positions.clone(),
+                "rest" => rest.clone(),
+                "longest" => longest.clone(),
+                "count" => count,
+                "points" => points,
+                "level_points" => first.points,
+                "pad0" => 0u32,
+            },
+            count,
+        )?;
+        batch.dispatch_folded(
+            &self.kernels.sim_bind,
+            &params! {
+                "level" => first.positions.clone(),
+                "ids" => ids.clone(),
+                "weights" => weights.clone(),
+                "strands" => strands,
+                "points" => first.points,
+                "count" => count,
+                "pad0" => 0u32,
+            },
+            strands,
+        )?;
+
+        // The density grid, round the groom with room for it to swing, in
+        // the head's frame (the groom's).
+        let [lo, hi] = lods.bounds;
+        let pad = Vec3::new(0.08, 0.15, 0.08);
+        let (lo, hi) = (lo - pad, hi + pad);
+        let grid = self.record_rest_density(
+            &mut batch,
+            &rest,
+            count * points,
+            lo,
+            hi,
+            settings.grid_cell,
+        )?;
+
+        // The colliding strands are the first: a wisp each, as wide as
+        // their spacing over a scalp of about six hundred square
+        // centimetres, with samples along a segment no further apart.
+        let colliders = (settings.collision_strands as u32).clamp(1, count);
+        let radius = if settings.collision_radius > 0.0 {
+            settings.collision_radius
+        } else {
+            (0.6 * (0.06 / colliders as f32).sqrt()).clamp(0.002, 0.008)
+        };
+        let longest = f32::from_bits(self.read_words(batch, &[(longest, 0)])?[0]);
+        // Samples two radii apart along their segments lie no more than
+        // this apart when the segments are a radius apart: a radius each way
+        // along them, and the radius between.
+        let reach = radius * 1.75;
+        let mut cell = reach;
+        let cell_dims = |cell: f32| {
+            let e = hi - lo;
+            [e.x, e.y, e.z].map(|e| ((e / cell).ceil() as u32).max(1))
+        };
+        while cell_dims(cell).iter().map(|&d| d as u64).product::<u64>() > 1 << 23 {
+            cell *= 1.25;
+        }
+        let dims = cell_dims(cell);
+        let cell_count = dims.iter().product::<u32>();
+        let cells = CollisionCells {
+            lo,
+            cell,
+            dims,
+            counts: storage(
+                &context,
+                ((cell_count as u64 + 1) * 4).into(),
+                "hair sim collision cells".into(),
+            )?,
+            scan: PrefixSumScratch::new(&context, ScanElementCount::from_elements(cell_count + 1))?,
+        };
+        // Samples two radii apart: the narrow phase takes the segments as
+        // they are, and samples need only find which are near.
+        let per_segment = ((longest / (2.0 * radius)).ceil() as u32).clamp(1, 16);
+        let sample_count = (colliders * (points - 1) * per_segment).max(1);
+        let sample_buffer =
+            |label: &str| storage(&context, (sample_count as u64 * 16).into(), (label).into());
+        Ok(GpuSim {
+            settings,
+            count,
+            points,
+            rest,
+            shape,
+            shaped: None,
+            factors,
+            position,
+            previous,
+            frames,
+            h_last: 1.0 / 240.0,
+            ids,
+            weights,
+            head_shape: body,
+            body: u32::from(head.is_some()),
+            head: Rigid::default(),
+            time: 0.0,
+            grid,
+            colliders,
+            cells,
+            samples: [
+                sample_buffer("hair sim samples")?,
+                sample_buffer("hair sim samples before")?,
+            ],
+            current: 0,
+            have_before: false,
+            sample_data: storage(
+                &context,
+                (sample_count as u64 * 80).into(),
+                "hair sim sample segments".into(),
+            )?,
+            per_segment,
+            radius,
+            sample_slots: storage(
+                &context,
+                (sample_count as u64 * 8).into(),
+                "hair sim sample cells".into(),
+            )?,
+            sorted: storage(
+                &context,
+                (sample_count as u64 * 128).into(),
+                "hair sim sorted samples".into(),
+            )?,
+            sorted_index: storage(
+                &context,
+                (sample_count as u64 * 4).into(),
+                "hair sim sorted samples' order".into(),
+            )?,
+            asks: storage(
+                &context,
+                (sample_count as u64 * 32).into(),
+                "hair sim collision asks".into(),
+            )?,
+        })
+    }
+}
+
+impl GpuSim {
+    /// Strands simulated.
+    pub fn strands(&self) -> usize {
+        self.count as usize
+    }
+
+    /// Points per simulated strand.
+    pub fn points(&self) -> usize {
+        self.points as usize
+    }
+
+    /// The level simulated.
+    pub fn level(&self) -> SimLevel {
+        SimLevel {
+            strands: self.count as usize,
+            points: self.points as usize,
+        }
+    }
+
+    /// How far apart strands keep, metres.
+    pub fn collision_radius(&self) -> f32 {
+        self.radius
+    }
+
+    /// How many of the strands collide.
+    pub fn colliding(&self) -> usize {
+        self.colliders as usize
+    }
+
+    pub fn head(&self) -> Rigid {
+        self.head
+    }
+
+    /// The simulated strands' groomed points, in the head's frame.
+    pub fn rest(&self) -> &Buffer {
+        &self.rest
+    }
+
+    /// The simulated strands' points now, world space.
+    pub fn positions(&self) -> &Buffer {
+        &self.position
+    }
+
+    /// The body the strands are kept off ([`super::head_shape`]), if any.
+    pub fn body(&self) -> Option<&Buffer> {
+        (self.body != 0).then_some(&self.head_shape)
+    }
+
+    /// Each drawn strand's four simulated strands, and their weights.
+    pub fn binding(&self) -> (&Buffer, &Buffer) {
+        (&self.ids, &self.weights)
+    }
+
+    /// Back to the groom, the head where it is.
+    pub fn reset(&mut self, groomer: &GpuGroomer, head: Rigid) -> Result<()> {
+        self.head = head;
+        let context = groomer.context();
+        let count = self.count * self.points;
+        let mut p = params! {
+            "rest" => self.rest.clone(),
+            "position" => self.position.clone(),
+            "previous" => self.previous.clone(),
+            "count" => count,
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+            "pad2" => 0u32,
+        };
+        insert_rigid(&mut p, &head);
+        let mut batch = KernelBatch::labelled(context, "hair sim reset");
+        batch.dispatch_folded(&groomer.kernels.sim_reset, &p, count)?;
+        self.record_shape(groomer, &mut batch)?;
+        self.record_orient(groomer, &mut batch, &head)?;
+        batch.submit();
+        Ok(())
+    }
+
+    /// The rods' rest solved for the settings, if they changed.
+    fn record_shape(&mut self, groomer: &GpuGroomer, batch: &mut KernelBatch) -> Result<()> {
+        let s = self.settings;
+        let rod = Rod::new(&s);
+        if self.shaped == Some((rod, s.sag_free)) {
+            return Ok(());
+        }
+        batch.dispatch_folded(
+            &groomer.kernels.sim_shape,
+            &params! {
+                "rest" => self.rest.clone(),
+                "shape" => self.shape.clone(),
+                "count" => self.count,
+                "points" => self.points,
+                "sag_free" => u32::from(s.sag_free),
+                "pad0" => 0u32,
+                "stretch" => rod.stretch,
+                "bend" => rod.bend,
+                "twist" => rod.twist,
+                "gravity" => s.gravity,
+            },
+            self.count,
+        )?;
+        self.shaped = Some((rod, s.sag_free));
+        Ok(())
+    }
+
+    /// Each segment's frame onto where its strand now is, the head at
+    /// `head`, not spinning.
+    fn record_orient(
+        &self,
+        groomer: &GpuGroomer,
+        batch: &mut KernelBatch,
+        head: &Rigid,
+    ) -> Result<()> {
+        let count = self.count * self.points;
+        let mut p = params! {
+            "rest" => self.rest.clone(),
+            "shape" => self.shape.clone(),
+            "position" => self.position.clone(),
+            "frames" => self.frames.clone(),
+            "count" => count,
+            "points" => self.points,
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+        };
+        insert_rigid(&mut p, head);
+        batch.dispatch_folded(&groomer.kernels.sim_orient, &p, count)?;
+        Ok(())
+    }
+
+    /// Step `dt` seconds with the head moved to `head`: the substeps are
+    /// recorded, not waited for -- the frame drawn next reads them. Each
+    /// substep takes the rods through their implicit steps, then keeps the
+    /// strands' volume and stops them closing through each other.
+    pub fn step(&mut self, groomer: &GpuGroomer, dt: f32, head: Rigid) -> Result<()> {
+        let dt = dt.min(1.0 / 20.0);
+        if dt.is_nan() || dt <= 0.0 {
+            return Ok(());
+        }
+        let s = self.settings;
+        let rod = Rod::new(&s);
+        let mut batch = KernelBatch::labelled(groomer.context(), "hair sim step");
+        self.record_shape(groomer, &mut batch)?;
+        let substeps = s.substeps.max(1);
+        let inner = s.solver_substeps.max(1) as u32;
+        let h = dt / (substeps as u32 * inner) as f32;
+        let from = self.head;
+        let particles = self.count * self.points;
+        let interacting = s.volume > 0.0 || s.friction > 0.0;
+        for k in 0..substeps {
+            // The head moves through the frame's substeps.
+            let start = blend(&from, &head, k as f32 / substeps as f32);
+            let now = blend(&from, &head, (k + 1) as f32 / substeps as f32);
+            let wind = Vec3::from_array(s.wind);
+            let mut p = params! {
+                "rest" => self.rest.clone(),
+                "shape" => self.shape.clone(),
+                "position" => self.position.clone(),
+                "previous" => self.previous.clone(),
+                "frames" => self.frames.clone(),
+                "head_shape" => self.head_shape.clone(),
+                "factors" => self.factors.clone(),
+                "count" => self.count,
+                "points" => self.points,
+                "body" => self.body,
+                "inner" => inner,
+                "h" => h,
+                "h_last" => self.h_last,
+                "time" => self.time,
+                "gravity" => s.gravity,
+                "wind_x" => wind.x,
+                "wind_y" => wind.y,
+                "wind_z" => wind.z,
+                "turbulence" => s.turbulence,
+                "collision_offset" => s.collision_offset,
+                "head_friction" => s.head_friction,
+                "stretch" => rod.stretch,
+                "bend" => rod.bend,
+                "twist" => rod.twist,
+                "gyration" => rod.gyration,
+                "damping" => rod.damping,
+                "drag" => rod.drag,
+                "drag_viscous" => rod.drag_viscous,
+                "pad0" => 0.0f32,
+                "pad1" => 0.0f32,
+                "pad2" => 0.0f32,
+            };
+            insert_rigid(&mut p, &now);
+            insert_from(&mut p, &start);
+            batch.dispatch_folded(&groomer.kernels.sim_step, &p, self.count)?;
+            self.h_last = h;
+
+            if interacting {
+                batch.clear_buffer(&self.grid.words);
+                let mut p = params! {
+                    "position" => self.position.clone(),
+                    "previous" => self.previous.clone(),
+                    "grid_words" => self.grid.words.clone(),
+                    "count" => particles,
+                };
+                insert_rigid(&mut p, &now);
+                self.grid.insert(&mut p);
+                batch.dispatch_folded(&groomer.kernels.sim_splat, &p, particles)?;
+                let mut p = params! {
+                    "position" => self.position.clone(),
+                    "previous" => self.previous.clone(),
+                    "grid_words" => self.grid.words.clone(),
+                    "rest_density" => self.grid.rest_density.clone(),
+                    "stats" => self.grid.stats.clone(),
+                    "count" => particles,
+                    "points" => self.points,
+                    "volume" => s.volume,
+                    "tolerance" => s.volume_tolerance,
+                    "friction" => s.friction,
+                };
+                insert_rigid(&mut p, &now);
+                self.grid.insert(&mut p);
+                batch.dispatch_folded(&groomer.kernels.sim_volume, &p, particles)?;
+            }
+            if s.strand_collision && (k + 1) % s.collision_interval.clamp(1, substeps) == 0 {
+                self.record_collisions(groomer, &mut batch, &now)?;
+            }
+            self.time += h * inner as f32;
+        }
+        if !s.strand_collision {
+            self.have_before = false;
+        }
+        batch.submit();
+        self.head = head;
+        Ok(())
+    }
+
+    /// The colliding strands' collisions, the head at `head`: their samples
+    /// counted into the grid's cells, the counts scanned, the samples
+    /// scattered into the cells' order, each sample's asks, and the asks
+    /// gathered by the points.
+    fn record_collisions(
+        &mut self,
+        groomer: &GpuGroomer,
+        batch: &mut KernelBatch,
+        head: &Rigid,
+    ) -> Result<()> {
+        let samples = self.colliders * (self.points - 1) * self.per_segment;
+        // Last pass's samples become the ones before.
+        self.current = 1 - self.current;
+        let (now, before) = (
+            self.samples[self.current].clone(),
+            self.samples[1 - self.current].clone(),
+        );
+        let cells = &self.cells;
+        let cell_count = cells.cells();
+        batch.clear_buffer(&cells.counts);
+        let mut p = params! {
+            "position" => self.position.clone(),
+            "previous" => self.previous.clone(),
+            "rest" => self.rest.clone(),
+            "samples" => now.clone(),
+            "sample_data" => self.sample_data.clone(),
+            "cell_counts" => cells.counts.clone(),
+            "sample_slots" => self.sample_slots.clone(),
+            "cell_lo_x" => cells.lo.x,
+            "cell_lo_y" => cells.lo.y,
+            "cell_lo_z" => cells.lo.z,
+            "cell_size" => cells.cell,
+            "cell_nx" => cells.dims[0],
+            "cell_ny" => cells.dims[1],
+            "cell_nz" => cells.dims[2],
+            "count" => samples,
+            "points" => self.points,
+            "per_segment" => self.per_segment,
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+        };
+        insert_rigid(&mut p, head);
+        batch.dispatch_folded(&groomer.kernels.sim_samples, &p, samples)?;
+        groomer.scan.record(
+            batch,
+            &cells.counts,
+            &cells.scan,
+            ScanElementCount::from_elements(cell_count + 1),
+        )?;
+        batch.dispatch_folded(
+            &groomer.kernels.sim_sort_samples,
+            &params! {
+                "samples" => now,
+                "samples_before" => before,
+                "sample_data" => self.sample_data.clone(),
+                "sample_slots" => self.sample_slots.clone(),
+                "cell_offsets" => cells.counts.clone(),
+                "sorted" => self.sorted.clone(),
+                "sorted_index" => self.sorted_index.clone(),
+                "count" => samples,
+                "pad0" => 0u32,
+                "pad1" => 0u32,
+                "pad2" => 0u32,
+            },
+            samples,
+        )?;
+        batch.dispatch_folded(
+            &groomer.kernels.sim_collide,
+            &params! {
+                "sorted" => self.sorted.clone(),
+                "sorted_index" => self.sorted_index.clone(),
+                "cell_offsets" => cells.counts.clone(),
+                "asks" => self.asks.clone(),
+                "count" => samples,
+                "cell_nx" => cells.dims[0],
+                "cell_ny" => cells.dims[1],
+                "cell_nz" => cells.dims[2],
+                "radius" => self.radius,
+                "reach" => self.radius * 1.75,
+                "friction" => self.settings.collision_friction,
+                "have_before" => u32::from(self.have_before),
+            },
+            samples,
+        )?;
+        // Only the colliding strands' points gather asks.
+        let colliding = self.colliders * self.points;
+        batch.dispatch_folded(
+            &groomer.kernels.sim_collide_apply,
+            &params! {
+                "position" => self.position.clone(),
+                "previous" => self.previous.clone(),
+                "asks" => self.asks.clone(),
+                "count" => colliding,
+                "points" => self.points,
+                "per_segment" => self.per_segment,
+                "pad0" => 0u32,
+            },
+            colliding,
+        )?;
+        self.have_before = true;
+        Ok(())
+    }
+
+    /// The simulated strands' points, read back: for tests and tools.
+    pub fn read_positions(&self, groomer: &GpuGroomer) -> Result<Vec<[f32; 4]>> {
+        Ok(pollster::block_on(self.position.read(groomer.context()))?)
+    }
+
+    /// The simulated strands' groomed points, read back.
+    pub fn read_rest(&self, groomer: &GpuGroomer) -> Result<Vec<[f32; 4]>> {
+        Ok(pollster::block_on(self.rest.read(groomer.context()))?)
+    }
+
+    /// Where the strands are, and were a substep ago, their frames along
+    /// them: for tests to set a scene up.
+    #[cfg(test)]
+    pub(crate) fn set_state(
+        &self,
+        groomer: &GpuGroomer,
+        positions: &[[f32; 4]],
+        previous: &[[f32; 4]],
+    ) -> Result<()> {
+        self.position.write(
+            groomer.context(),
+            fabelgeist_gpu::prelude::BufferUpload::from_elements(positions),
+        )?;
+        self.previous.write(
+            groomer.context(),
+            fabelgeist_gpu::prelude::BufferUpload::from_elements(previous),
+        )?;
+        let mut batch = KernelBatch::labelled(groomer.context(), "hair sim state");
+        self.record_orient(groomer, &mut batch, &self.head)?;
+        batch.submit();
+        Ok(())
+    }
+}
diff --git a/crates/fabelgeist-hair/src/gpu/sim/density.rs b/crates/fabelgeist-hair/src/gpu/sim/density.rs
new file mode 100644
index 000000000..16847da0e
--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/sim/density.rs
@@ -0,0 +1,65 @@
+//! Rest-density grid allocation and recording in the head's metre frame.
+use super::*;
+impl GpuGroomer {
+    pub(super) fn record_rest_density(
+        &mut self,
+        batch: &mut KernelBatch,
+        rest: &Buffer,
+        samples: u32,
+        lo: Vec3,
+        hi: Vec3,
+        cell_metres: f32,
+    ) -> Result<SimGrid> {
+        let context = self.context.clone();
+        let mut cell = cell_metres.max(0.002);
+        let dims = |cell: f32| {
+            let e = hi - lo;
+            [e.x, e.y, e.z].map(|e| ((e / cell).ceil() as u32).max(1))
+        };
+        while dims(cell).iter().map(|&d| d as u64).product::<u64>() > 1 << 21 {
+            cell *= 1.25;
+        }
+        let grid = {
+            let dims = dims(cell);
+            let cells = dims.iter().product::<u32>() as u64;
+            SimGrid {
+                lo,
+                cell,
+                dims,
+                words: storage(&context, (cells * 16).into(), "hair sim grid".into())?,
+                rest_density: storage(
+                    &context,
+                    (cells * 4).into(),
+                    "hair sim rest density".into(),
+                )?,
+                stats: storage(
+                    &context,
+                    16_u64.into(),
+                    "hair sim rest density stats".into(),
+                )?,
+            }
+        };
+        batch.clear_buffer(&grid.rest_density);
+        batch.clear_buffer(&grid.stats);
+        let mut p = params! {
+            "rest" => rest.clone(),
+            "rest_density" => grid.rest_density.clone(),
+            "count" => samples,
+        };
+        grid.insert(&mut p);
+        batch.dispatch_folded(&self.kernels.sim_rest_density, &p, samples)?;
+        batch.dispatch_folded(
+            &self.kernels.sim_rest_stats,
+            &params! {
+                "rest_density" => grid.rest_density.clone(),
+                "stats" => grid.stats.clone(),
+                "count" => grid.cells(),
+                "pad0" => 0u32,
+                "pad1" => 0u32,
+                "pad2" => 0u32,
+            },
+            grid.cells(),
+        )?;
+        Ok(grid)
+    }
+}
diff --git a/crates/fabelgeist-hair/src/gpu/wgsl/common.rs b/crates/fabelgeist-hair/src/gpu/wgsl/common.rs
new file mode 100644
index 000000000..f1360e0cb
--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/wgsl/common.rs
@@ -0,0 +1,446 @@
+//! WGSL shared by the grooming kernels: the host's hashes and noise, the
+//! maths of strand frames, the head's distance field, and a walker that
+//! samples a strand by arc length. Pasted into each kernel after its own
+//! bindings, as the compute kernels compose theirs.
+
+/// Hashes, as [`crate::rng`] computes them, bit for bit.
+pub const RANDOM: &str = r#"
+fn hash2(a: u32, b: u32) -> u32 {
+    var h = (a * 0x9E3779B1u) ^ (((b << 16u) | (b >> 16u)) * 0x85EBCA6Bu);
+    h = h ^ (h >> 16u);
+    h = h * 0x85EBCA6Bu;
+    h = h ^ (h >> 13u);
+    h = h * 0xC2B2AE35u;
+    return h ^ (h >> 16u);
+}
+
+fn hash3(a: u32, b: u32, c: u32) -> u32 {
+    return hash2(hash2(a, b), c);
+}
+
+// Uniform in [0, 1) for an id under a seed.
+fn unit(id: u32, seed: u32) -> f32 {
+    return f32(hash2(id, seed) >> 8u) / 16777216.0;
+}
+
+fn signed1(id: u32, seed: u32) -> f32 {
+    return unit(id, seed) * 2.0 - 1.0;
+}
+
+fn signed3(id: u32, seed: u32) -> vec3<f32> {
+    return vec3<f32>(
+        signed1(id, hash2(seed, 1u)),
+        signed1(id, hash2(seed, 2u)),
+        signed1(id, hash2(seed, 3u)),
+    );
+}
+"#;
+
+/// Blender's noise, as [`crate::noise`] computes it.
+pub const NOISE: &str = r#"
+fn noise_fade(t: f32) -> f32 {
+    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
+}
+
+fn noise_gradient(ix: i32, iy: i32, iz: i32, x: f32, y: f32, z: f32) -> f32 {
+    let h = hash3(bitcast<u32>(ix), bitcast<u32>(iy), bitcast<u32>(iz)) % 12u;
+    var u = y;
+    var v = z;
+    if (h <= 3u) {
+        u = x;
+        v = y;
+    } else if (h <= 7u) {
+        u = x;
+        v = z;
+    }
+    if ((h & 1u) != 0u) {
+        u = -u;
+    }
+    if ((h & 2u) != 0u) {
+        v = -v;
+    }
+    return u + v;
+}
+
+fn perlin(p: vec3<f32>) -> f32 {
+    let f = floor(p);
+    let i = vec3<i32>(f);
+    let q = p - f;
+    let w = vec3<f32>(noise_fade(q.x), noise_fade(q.y), noise_fade(q.z));
+    let g000 = noise_gradient(i.x, i.y, i.z, q.x, q.y, q.z);
+    let g100 = noise_gradient(i.x + 1, i.y, i.z, q.x - 1.0, q.y, q.z);
+    let g010 = noise_gradient(i.x, i.y + 1, i.z, q.x, q.y - 1.0, q.z);
+    let g110 = noise_gradient(i.x + 1, i.y + 1, i.z, q.x - 1.0, q.y - 1.0, q.z);
+    let g001 = noise_gradient(i.x, i.y, i.z + 1, q.x, q.y, q.z - 1.0);
+    let g101 = noise_gradient(i.x + 1, i.y, i.z + 1, q.x - 1.0, q.y, q.z - 1.0);
+    let g011 = noise_gradient(i.x, i.y + 1, i.z + 1, q.x, q.y - 1.0, q.z - 1.0);
+    let g111 = noise_gradient(i.x + 1, i.y + 1, i.z + 1, q.x - 1.0, q.y - 1.0, q.z - 1.0);
+    let value = mix(
+        mix(mix(g000, g100, w.x), mix(g010, g110, w.x), w.y),
+        mix(mix(g001, g101, w.x), mix(g011, g111, w.x), w.y),
+        w.z,
+    );
+    return clamp(value * 0.982, -1.0, 1.0);
+}
+
+// Octaves at twice the frequency, `roughness` the amplitude, in [0, 1].
+fn fractal(p: vec3<f32>, octaves: u32, roughness: f32) -> f32 {
+    var sum = 0.0;
+    var amplitude = 1.0;
+    var total = 0.0;
+    var q = p;
+    for (var o = 0u; o < max(octaves, 1u); o++) {
+        sum += perlin(q) * amplitude;
+        total += amplitude;
+        amplitude *= roughness;
+        q *= 2.0;
+    }
+    return 0.5 + 0.5 * sum / total;
+}
+
+fn noise_color(p: vec3<f32>, scale: f32) -> vec3<f32> {
+    let q = p * scale;
+    return vec3<f32>(
+        fractal(q, 1u, 0.5),
+        fractal(q + vec3<f32>(31.416, -47.853, 12.679), 1u, 0.5),
+        fractal(q + vec3<f32>(-83.1, 71.3, -21.7), 1u, 0.5),
+    );
+}
+
+fn white(p: vec3<f32>) -> f32 {
+    let h = hash3(bitcast<u32>(p.x), bitcast<u32>(p.y), hash2(bitcast<u32>(p.z), 0x5bd1e995u));
+    return f32(h >> 8u) / 16777216.0;
+}
+"#;
+
+/// Frames, rotations, falloffs: [`crate::strands`] and [`crate::ops`].
+pub const MATH: &str = r#"
+const PI: f32 = 3.14159265;
+const TAU: f32 = 6.2831853;
+
+fn smoothstep1(e0: f32, e1: f32, x: f32) -> f32 {
+    if (abs(e1 - e0) <= 1e-12) {
+        return 0.0;
+    }
+    let t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
+    return t * t * (3.0 - 2.0 * t);
+}
+
+fn smootherstep1(e0: f32, e1: f32, x: f32) -> f32 {
+    if (abs(e1 - e0) <= 1e-12) {
+        return 0.0;
+    }
+    let t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
+    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
+}
+
+// Blender's `shape_range` group with base 2.
+fn shape_range(value: f32, lo: f32, hi: f32, shape: f32) -> f32 {
+    if (abs(shape) < 1e-5) {
+        return 1.0;
+    }
+    var x = 0.0;
+    if (abs(hi - lo) > 1e-12) {
+        x = (value - lo) / (hi - lo);
+    }
+    let b = 2.0;
+    let a = min(abs(shape), 0.999999);
+    let negative = shape < 0.0;
+    let flip = select(negative, !negative, a > 0.5);
+    let xx = select(x, 1.0 - x, flip);
+    let pingpong = select(1.0 - a, a, a <= 0.5);
+    let m = pingpong * 2.0 * (1.0 - 1.0 / b);
+    let exponent = -log(max(1.0 - m, 1e-5)) / log(b);
+    var y = pow(max(xx, 0.0), exponent);
+    if (a > 0.5) {
+        y = 1.0 - y;
+    }
+    return clamp(lo + clamp(y, 0.0, 1.0) * (hi - lo), min(lo, hi), max(lo, hi));
+}
+
+fn safe_normalize(v: vec3<f32>, fallback: vec3<f32>) -> vec3<f32> {
+    let l = length(v);
+    if (l > 1e-12 && l < 1e30) {
+        return v / l;
+    }
+    return fallback;
+}
+
+// Blender's `math::orthogonal`.
+fn orthogonal(v: vec3<f32>) -> vec3<f32> {
+    let a = abs(v);
+    var o = vec3<f32>(-v.y, v.x, 0.0);
+    if (a.x <= a.y && a.x <= a.z) {
+        o = vec3<f32>(0.0, -v.z, v.y);
+    } else if (a.y <= a.z) {
+        o = vec3<f32>(-v.z, 0.0, v.x);
+    }
+    return safe_normalize(o, vec3<f32>(1.0, 0.0, 0.0));
+}
+
+fn rotate(v: vec3<f32>, axis: vec3<f32>, angle: f32) -> vec3<f32> {
+    let s = sin(angle);
+    let c = cos(angle);
+    return v * c + cross(axis, v) * s + axis * (dot(axis, v) * (1.0 - c));
+}
+
+fn transport(v: vec3<f32>, source: vec3<f32>, target_dir: vec3<f32>) -> vec3<f32> {
+    let axis = cross(source, target_dir);
+    let s = length(axis);
+    let c = dot(source, target_dir);
+    if (s < 1e-7) {
+        return select(-v, v, c > 0.0);
+    }
+    return rotate(v, axis / s, atan2(s, c));
+}
+
+// `Vec3::lerp` as the host computes it: `mix` may round otherwise.
+fn lerp3(a: vec3<f32>, b: vec3<f32>, t: f32) -> vec3<f32> {
+    return a + (b - a) * t;
+}
+
+fn in_plane(v: vec3<f32>, n: vec3<f32>) -> vec3<f32> {
+    return v - n * dot(v, n);
+}
+"#;
+
+/// The body's distance field, from `head_shape`: the mannequin's shapes
+/// (see [`super::super::head_shape`] for the layout), or a field sampled
+/// on a grid ([`super::super::FieldHeader`]), told apart by the first
+/// entry's `w`.
+pub const HEAD: &str = r#"
+// A sampled field: its header, then the distances, four to an entry, `x`
+// fastest. Outside its box, everything is `reach` from the body.
+fn field_value(i: vec3<i32>, n: vec3<i32>) -> f32 {
+    let c = clamp(i, vec3<i32>(0), n - vec3<i32>(1));
+    let k = u32(c.x + n.x * (c.y + n.y * c.z));
+    return head_shape[3u + k / 4u][k % 4u];
+}
+
+fn field_distance(p: vec3<f32>) -> f32 {
+    let lo = head_shape[0].xyz;
+    let cell = head_shape[1].x;
+    let n = vec3<i32>(head_shape[1].yzw);
+    let reach = head_shape[2].x;
+    let g = (p - lo) / cell - vec3<f32>(0.5);
+    if (any(g < vec3<f32>(-0.5)) || any(g > vec3<f32>(n) - vec3<f32>(0.5))) {
+        return reach;
+    }
+    let i = vec3<i32>(floor(g));
+    let f = g - floor(g);
+    let x00 = mix(field_value(i, n), field_value(i + vec3<i32>(1, 0, 0), n), f.x);
+    let x10 = mix(field_value(i + vec3<i32>(0, 1, 0), n), field_value(i + vec3<i32>(1, 1, 0), n), f.x);
+    let x01 = mix(field_value(i + vec3<i32>(0, 0, 1), n), field_value(i + vec3<i32>(1, 0, 1), n), f.x);
+    let x11 = mix(field_value(i + vec3<i32>(0, 1, 1), n), field_value(i + vec3<i32>(1, 1, 1), n), f.x);
+    return mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z);
+}
+
+fn ellipsoid_distance(p: vec3<f32>, center: vec3<f32>, radii: vec3<f32>) -> f32 {
+    let q = p - center;
+    let k0 = length(q / radii);
+    let k1 = length(q / (radii * radii));
+    if (k1 < 1e-12) {
+        return -min(radii.x, min(radii.y, radii.z));
+    }
+    return k0 * (k0 - 1.0) / k1;
+}
+
+fn capsule_distance(p: vec3<f32>, a: vec3<f32>, b: vec3<f32>, radius: f32) -> f32 {
+    let ab = b - a;
+    let t = clamp(dot(p - a, ab) / dot(ab, ab), 0.0, 1.0);
+    return length(p - (a + ab * t)) - radius;
+}
+
+fn smooth_min(a: f32, b: f32, k: f32) -> f32 {
+    let h = max(k - abs(a - b), 0.0) / k;
+    return min(a, b) - h * h * k * 0.25;
+}
+
+fn head_part(i: u32, p: vec3<f32>) -> f32 {
+    return ellipsoid_distance(p, head_shape[i].xyz, head_shape[i + 1u].xyz);
+}
+
+fn head_distance(p: vec3<f32>) -> f32 {
+    if (head_shape[0].w > 0.5) {
+        return field_distance(p);
+    }
+    var d = smooth_min(head_part(0u, p), head_part(2u, p), 0.04);
+    d = smooth_min(d, head_part(4u, p), 0.012);
+    let ears = min(head_part(6u, p), head_part(8u, p));
+    d = smooth_min(d, ears, 0.006);
+    let neck = smooth_min(d, capsule_distance(p, head_shape[10].xyz, head_shape[11].xyz, head_shape[10].w), 0.03);
+    let torso = smooth_min(head_part(12u, p), head_part(14u, p), 0.08);
+    let body = smooth_min(neck, torso, 0.06);
+    return max(body, head_shape[16].x - p.y);
+}
+
+// Stable at the crown, where normalize followed by acos loses the angle.
+fn head_polar(p: vec3<f32>) -> f32 {
+    let offset = p - head_shape[0].xyz;
+    return atan2(length(offset.xz), offset.y);
+}
+
+fn head_gradient(p: vec3<f32>) -> vec3<f32> {
+    let e = 2e-4;
+    let g = vec3<f32>(
+        head_distance(p + vec3<f32>(e, 0.0, 0.0)) - head_distance(p - vec3<f32>(e, 0.0, 0.0)),
+        head_distance(p + vec3<f32>(0.0, e, 0.0)) - head_distance(p - vec3<f32>(0.0, e, 0.0)),
+        head_distance(p + vec3<f32>(0.0, 0.0, e)) - head_distance(p - vec3<f32>(0.0, 0.0, e)),
+    );
+    return safe_normalize(g, vec3<f32>(0.0, 1.0, 0.0));
+}
+
+// Out until at least `offset` off the body, as `collider::push_out` does.
+fn push_out(q: vec3<f32>, offset: f32) -> vec3<f32> {
+    var p = q;
+    for (var k = 0; k < 6; k++) {
+        let d = head_distance(p);
+        if (d >= offset) {
+            break;
+        }
+        p += head_gradient(p) * (offset - d + 1e-5);
+    }
+    return p;
+}
+"#;
+
+/// A strand's tangents (Blender's poly-curve tangent) and arc lengths, and
+/// a walker sampling a strand by arc length with parallel-transported
+/// normals -- [`crate::strands::CurveSampler`] computed as it goes, so a
+/// kernel sampling a guide needs no frames stored for it. Reads `src`.
+pub const WALK: &str = r#"
+fn point_at(base: u32, j: u32) -> vec3<f32> {
+    return src[base + j].xyz;
+}
+
+fn tangent_at(base: u32, points: u32, j: u32) -> vec3<f32> {
+    var d: vec3<f32>;
+    if (j == 0u) {
+        d = point_at(base, 1u) - point_at(base, 0u);
+    } else if (j == points - 1u) {
+        d = point_at(base, j) - point_at(base, j - 1u);
+    } else {
+        let a = point_at(base, j + 1u) - point_at(base, j);
+        let b = point_at(base, j) - point_at(base, j - 1u);
+        d = safe_normalize(a, vec3<f32>(0.0, 1.0, 0.0)) + safe_normalize(b, vec3<f32>(0.0, 1.0, 0.0));
+    }
+    return safe_normalize(d, vec3<f32>(0.0, 1.0, 0.0));
+}
+
+fn strand_length(base: u32, points: u32) -> f32 {
+    var total = 0.0;
+    for (var j = 1u; j < points; j++) {
+        total += distance(point_at(base, j), point_at(base, j - 1u));
+    }
+    return total;
+}
+
+struct Walker {
+    base: u32,
+    points: u32,
+    i: u32,
+    l0: f32,
+    l1: f32,
+    t0: vec3<f32>,
+    t1: vec3<f32>,
+    n0: vec3<f32>,
+    n1: vec3<f32>,
+    total: f32,
+};
+
+struct Frame {
+    position: vec3<f32>,
+    tangent: vec3<f32>,
+    normal: vec3<f32>,
+    binormal: vec3<f32>,
+};
+
+fn walker_new(base: u32, points: u32) -> Walker {
+    var w: Walker;
+    w.base = base;
+    w.points = points;
+    w.i = 0u;
+    w.l0 = 0.0;
+    w.t0 = tangent_at(base, points, 0u);
+    w.n0 = orthogonal(w.t0);
+    w.t1 = tangent_at(base, points, 1u);
+    w.n1 = transport(w.n0, w.t0, w.t1);
+    w.l1 = distance(point_at(base, 1u), point_at(base, 0u));
+    w.total = strand_length(base, points);
+    return w;
+}
+
+// The frame at arc length `s`, clamped to the strand. Lengths must be
+// asked for in increasing order.
+fn walker_at(w: ptr<function, Walker>, length_along: f32) -> Frame {
+    let s = clamp(length_along, 0.0, (*w).total);
+    while ((*w).l1 <= s && (*w).i + 2u < (*w).points) {
+        let next = (*w).i + 2u;
+        (*w).i += 1u;
+        (*w).l0 = (*w).l1;
+        (*w).t0 = (*w).t1;
+        (*w).n0 = (*w).n1;
+        (*w).t1 = tangent_at((*w).base, (*w).points, next);
+        (*w).n1 = transport((*w).n0, (*w).t0, (*w).t1);
+        (*w).l1 += distance(point_at((*w).base, next), point_at((*w).base, next - 1u));
+    }
+    let span = (*w).l1 - (*w).l0;
+    var t = 0.0;
+    if (span > 1e-12) {
+        t = clamp((s - (*w).l0) / span, 0.0, 1.0);
+    }
+    var f: Frame;
+    f.position = mix(point_at((*w).base, (*w).i), point_at((*w).base, (*w).i + 1u), t);
+    f.tangent = safe_normalize(mix((*w).t0, (*w).t1, t), (*w).t0);
+    let n = mix((*w).n0, (*w).n1, t);
+    f.normal = safe_normalize(n - f.tangent * dot(n, f.tangent), (*w).n0);
+    f.binormal = cross(f.tangent, f.normal);
+    return f;
+}
+
+// `Restore Curve Segment Length`: `dst` given back `src`'s segment lengths.
+fn restore_lengths(base: u32, points: u32, factor: f32) {
+    var previous = dst[base].xyz;
+    var previous_old = dst[base].xyz;
+    for (var j = 1u; j < points; j++) {
+        let current = dst[base + j].xyz;
+        let direction = current - previous_old;
+        let current_length = length(direction);
+        let rest_vector = src[base + j].xyz - src[base + j - 1u].xyz;
+        let rest = length(rest_vector);
+        let target_length = current_length + (rest - current_length) * factor;
+        var unit_direction = safe_normalize(rest_vector, vec3<f32>(0.0, -1.0, 0.0));
+        if (current_length > 1e-12) {
+            unit_direction = direction / current_length;
+        }
+        previous_old = current;
+        let placed = previous + unit_direction * target_length;
+        dst[base + j] = vec4<f32>(placed, dst[base + j].w);
+        previous = placed;
+    }
+}
+
+fn copy_strand(base: u32, points: u32) {
+    for (var j = 0u; j < points; j++) {
+        dst[base + j] = src[base + j];
+    }
+}
