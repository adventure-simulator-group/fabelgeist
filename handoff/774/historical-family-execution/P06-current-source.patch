+//! The scalp cut on the GPU: [`crate::head::Head::scalp`], naive surface
+//! nets over the head's field and the part above the hairline, in the
+//! host's order -- the same triangles, the same vertex numbering, the same
+//! running area -- so roots and guides land where the host's would.
+
+use super::common::{HEAD, INDEX, MATH};
+use super::guides::HAIRLINE;
+
+fn kernel(bindings: &str, helpers: &[&str], body: &str) -> String {
+    let mut source = String::from(bindings);
+    for h in helpers {
+        source.push_str(h);
+    }
+    source.push_str(INDEX);
+    source.push_str(body);
+    source
+}
+
+/// The grid: the corners `nx` by `ny` by `nz` from `lo` a `cell` apart, its
+/// rows from `j0` of the whole bust's grid (corner `j` at `lo + (j0 + j) *
+/// cell`, computed as the host computes it), and what is kept: above the
+/// hairline and above `keep_y`.
+const GRID_PARAMS: &str = r#"
+    lo_x: f32,
+    lo_y: f32,
+    lo_z: f32,
+    cell: f32,
+    nx: u32,
+    ny: u32,
+    nz: u32,
+    j0: u32,
+    hairline_front: f32,
+    hairline_side: f32,
+    hairline_back: f32,
+    recession: f32,
+    peak: f32,
+    keep_y: f32,
+    count: u32,
+    pad0: u32,
+"#;
+
+const GRID: &str = r#"
+fn corner_at(i: u32, j: u32, k: u32) -> vec3<f32> {
+    return vec3<f32>(params.lo_x, params.lo_y, params.lo_z)
+        + vec3<f32>(f32(i) * params.cell, f32(params.j0 + j) * params.cell, f32(k) * params.cell);
+}
+
+fn corner_index(i: u32, j: u32, k: u32) -> u32 {
+    return (k * params.ny + j) * params.nx + i;
+}
+
+fn cell_index(i: u32, j: u32, k: u32) -> u32 {
+    return (k * (params.ny - 1u) + j) * (params.nx - 1u) + i;
+}
+"#;
+
+fn with_grid(bindings: &str) -> String {
+    format!(
+        "{bindings}struct Params {{{GRID_PARAMS}}};\n",
+        bindings = bindings,
+        GRID_PARAMS = GRID_PARAMS,
+    )
+}
+
+/// The field at every corner.
+pub fn nets_values() -> String {
+    kernel(
+        &(with_grid(
+            r#"
+@group(0) @binding(0) var<storage, read> head_shape: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> values: array<f32>;
+"#,
+        ) + "@group(0) @binding(2) var<uniform> params: Params;\n"),
+        &[MATH, HEAD, GRID],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let c = item(id, groups);
+    if (c >= params.count) {
+        return;
+    }
+    let i = c % params.nx;
+    let j = (c / params.nx) % params.ny;
+    let k = c / (params.nx * params.ny);
+    values[c] = head_distance(corner_at(i, j, k));
+}
+"#,
+    )
+}
+
+/// A vertex in every cell the surface crosses: the mean of its edges'
+/// crossings, two Newton steps onto the surface. `w` is 0 for none, 1 for
+/// a vertex, 2 for one the scalp keeps.
+pub fn nets_cells() -> String {
+    kernel(
+        &(with_grid(
+            r#"
+@group(0) @binding(0) var<storage, read> head_shape: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> values: array<f32>;
+@group(0) @binding(2) var<storage, read_write> cells: array<vec4<f32>>;
+"#,
+        ) + "@group(0) @binding(3) var<uniform> params: Params;\n"),
+        &[MATH, HEAD, GRID, &HAIRLINE.replace("hairdo.", "params.")],
+        r#"
+// The cube's twelve edges as corner pairs (corner `c` at `c & 1`,
+// `c >> 1 & 1`, `c >> 2 & 1`), in the host's order.
+fn edge_corner(e: u32, end: u32) -> u32 {
+    switch e {
+        case 0u: { return select(0u, 1u, end == 1u); }
+        case 1u: { return select(2u, 3u, end == 1u); }
+        case 2u: { return select(4u, 5u, end == 1u); }
+        case 3u: { return select(6u, 7u, end == 1u); }
+        case 4u: { return select(0u, 2u, end == 1u); }
+        case 5u: { return select(1u, 3u, end == 1u); }
+        case 6u: { return select(4u, 6u, end == 1u); }
+        case 7u: { return select(5u, 7u, end == 1u); }
+        case 8u: { return select(0u, 4u, end == 1u); }
+        case 9u: { return select(1u, 5u, end == 1u); }
+        case 10u: { return select(2u, 6u, end == 1u); }
+        default: { return select(3u, 7u, end == 1u); }
+    }
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let c = item(id, groups);
+    let cx = params.nx - 1u;
+    let cy = params.ny - 1u;
+    if (c >= cx * cy * (params.nz - 1u)) {
+        return;
+    }
+    let i = c % cx;
+    let j = (c / cx) % cy;
+    let k = c / (cx * cy);
+    var sum = vec3<f32>(0.0);
+    var count = 0u;
+    for (var e = 0u; e < 12u; e++) {
+        let a = edge_corner(e, 0u);
+        let b = edge_corner(e, 1u);
+        let ia = vec3<u32>(i + (a & 1u), j + ((a >> 1u) & 1u), k + ((a >> 2u) & 1u));
+        let ib = vec3<u32>(i + (b & 1u), j + ((b >> 1u) & 1u), k + ((b >> 2u) & 1u));
+        let va = values[corner_index(ia.x, ia.y, ia.z)];
+        let vb = values[corner_index(ib.x, ib.y, ib.z)];
+        if ((va < 0.0) != (vb < 0.0)) {
+            let pa = corner_at(ia.x, ia.y, ia.z);
+            let pb = corner_at(ib.x, ib.y, ib.z);
+            sum += lerp3(pa, pb, va / (va - vb));
+            count += 1u;
+        }
+    }
+    if (count == 0u) {
+        cells[c] = vec4<f32>(0.0);
+        return;
+    }
+    var p = sum * (1.0 / f32(count));
+    // Two Newton steps onto the surface, staying near the cell.
+    for (var n = 0; n < 2; n++) {
+        let e = params.cell * 0.05;
+        let d = head_distance(p);
+        let g = vec3<f32>(
+            head_distance(p + vec3<f32>(e, 0.0, 0.0)) - head_distance(p - vec3<f32>(e, 0.0, 0.0)),
+            head_distance(p + vec3<f32>(0.0, e, 0.0)) - head_distance(p - vec3<f32>(0.0, e, 0.0)),
+            head_distance(p + vec3<f32>(0.0, 0.0, e)) - head_distance(p - vec3<f32>(0.0, 0.0, e)),
+        ) * (0.5 / e);
+        let g2 = dot(g, g);
+        if (g2 > 1e-12) {
+            let step = g * (d / g2);
+            if (length(step) < params.cell) {
+                p -= step;
+            }
+        }
+    }
+    let kept = above_hairline(p) > 0.0 && p.y > params.keep_y;
+    cells[c] = vec4<f32>(p, select(1.0, 2.0, kept));
+}
+"#,
+    )
+}
+
+/// The quads: one across every grid edge the surface cuts, joining the
+/// four cells around it, split in two; each triangle the scalp keeps
+/// (all its vertices kept) counted, or (`emit`) written at its offset.
+pub fn nets_quads(emit: bool) -> String {
+    let out = if emit {
+        "@group(0) @binding(2) var<storage, read> offsets: array<u32>;\n\
+         @group(0) @binding(3) var<storage, read_write> triangles: array<vec4<u32>>;\n"
+    } else {
+        "@group(0) @binding(2) var<storage, read_write> counts: array<u32>;\n"
+    };
+    let uniform = if emit { 4 } else { 3 };
+    let body = r#"
+// The cell `du`, `dw` back from corner `c` across the edge's two other
+// axes, if it is in the grid and has a vertex: its index, or none.
+fn around(c: vec3<u32>, u: u32, w: u32, du: u32, dw: u32) -> i32 {
+    var at = vec3<i32>(c);
+    at[u] -= i32(du);
+    at[w] -= i32(dw);
+    let n = vec3<i32>(i32(params.nx) - 1, i32(params.ny) - 1, i32(params.nz) - 1);
+    if (any(at < vec3<i32>(0)) || any(at >= n)) {
+        return -1;
+    }
+    let index = cell_index(u32(at.x), u32(at.y), u32(at.z));
+    if (cells[index].w < 0.5) {
+        return -1;
+    }
+    return i32(index);
+}
+
+fn kept(cell: i32) -> bool {
+    return cells[u32(cell)].w > 1.5;
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let e = item(id, groups);
+    if (e >= params.count) {
+        return;
+    }
+    let corner = e / 3u;
+    let axis = e % 3u;
+    let i = corner % params.nx;
+    let j = (corner / params.nx) % params.ny;
+    let k = corner / (params.nx * params.ny);
+    var c1 = vec3<u32>(i, j, k);
+    c1[axis] += 1u;
+    var total = 0u;
+    if (all(c1 < vec3<u32>(params.nx, params.ny, params.nz))) {
+        let v0 = values_at(i, j, k);
+        let v1 = values_at(c1.x, c1.y, c1.z);
+        if ((v0 < 0.0) != (v1 < 0.0)) {
+            var u = 1u;
+            var w = 2u;
+            if (axis == 1u) {
+                u = 2u;
+                w = 0u;
+            } else if (axis == 2u) {
+                u = 0u;
+                w = 1u;
+            }
+            let c = vec3<u32>(i, j, k);
+            let a = around(c, u, w, 0u, 0u);
+            let b = around(c, u, w, 1u, 0u);
+            let cc = around(c, u, w, 1u, 1u);
+            let d = around(c, u, w, 0u, 1u);
+            if (a >= 0 && b >= 0 && cc >= 0 && d >= 0) {
+                // Inside to outside along the axis: counter-clockwise seen
+                // from outside.
+                var first = vec3<i32>(a, b, cc);
+                var second = vec3<i32>(a, cc, d);
+                if (v0 >= 0.0) {
+                    first = vec3<i32>(a, cc, b);
+                    second = vec3<i32>(a, d, cc);
+                }
+                let keep_first = kept(first.x) && kept(first.y) && kept(first.z);
+                let keep_second = kept(second.x) && kept(second.y) && kept(second.z);
+                EMIT
+            }
+        }
+    }
+    COUNT
+}
+"#;
+    let (emit_code, count_code) = if emit {
+        (
+            r#"var at = offsets[e];
+                if (keep_first) {
+                    triangles[at] = vec4<u32>(vec3<u32>(first), 0u);
+                    at += 1u;
+                }
+                if (keep_second) {
+                    triangles[at] = vec4<u32>(vec3<u32>(second), 0u);
+                }"#,
+            "",
+        )
+    } else {
+        (
+            "total = u32(keep_first) + u32(keep_second);",
+            "counts[e] = total;",
+        )
+    };
+    let body = body.replace("EMIT", emit_code).replace("COUNT", count_code);
+    kernel(
+        &(with_grid(&format!(
+            "@group(0) @binding(0) var<storage, read> values: array<f32>;\n\
+             @group(0) @binding(1) var<storage, read> cells: array<vec4<f32>>;\n{out}"
+        )) + &format!("@group(0) @binding({uniform}) var<uniform> params: Params;\n")),
+        &[GRID],
+        &(String::from(
+            r#"
+fn values_at(i: u32, j: u32, k: u32) -> f32 {
+    return values[corner_index(i, j, k)];
+}
+"#,
+        ) + &body),
+    )
+}
+
+/// Where each kept vertex first appears among the triangles (its triangle
+/// times three plus its corner), the least of them kept inverted in `first`
+/// so a cleared buffer starts empty: the host numbers vertices so.
+pub fn nets_first() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> triangles: array<vec4<u32>>;
+@group(0) @binding(1) var<storage, read_write> first: array<atomic<u32>>;
+struct Params {
+    count: u32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(2) var<uniform> params: Params;
+"#,
+        &[],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let t = item(id, groups);
+    if (t >= params.count) {
+        return;
+    }
+    let tri = triangles[t];
+    atomicMax(&first[tri.x], ~(t * 3u));
+    atomicMax(&first[tri.y], ~(t * 3u + 1u));
+    atomicMax(&first[tri.z], ~(t * 3u + 2u));
+}
+"#,
+    )
+}
+
+/// Each vertex's cell at its first appearance, and a flag there to scan
+/// into its number.
+pub fn nets_order() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> first: array<u32>;
+@group(0) @binding(1) var<storage, read_write> flags: array<u32>;
+@group(0) @binding(2) var<storage, read_write> cell_at: array<u32>;
+struct Params {
+    count: u32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(3) var<uniform> params: Params;
+"#,
+        &[],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let c = item(id, groups);
+    if (c >= params.count || first[c] == 0u) {
+        return;
+    }
+    let key = ~first[c];
+    flags[key] = 1u;
+    cell_at[key] = c;
+}
+"#,
+    )
+}
+
+/// The scalp's vertices in the host's order: position, normal (the field's
+/// gradient, as `Head::gradient`), UV (`Head::scalp_uv`); each cell's
+/// vertex number; and the box they are in.
+pub fn nets_vertices() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> head_shape: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> cells: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> flags: array<u32>;
+@group(0) @binding(3) var<storage, read> cell_at: array<u32>;
+@group(0) @binding(4) var<storage, read_write> vertex_of: array<u32>;
+@group(0) @binding(5) var<storage, read_write> scalp_points: array<vec4<f32>>;
+@group(0) @binding(6) var<storage, read_write> scalp_normals: array<vec4<f32>>;
+@group(0) @binding(7) var<storage, read_write> scalp_uvs: array<vec4<f32>>;
+struct Params {
+    count: u32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(8) var<uniform> params: Params;
+"#,
+        &[MATH, HEAD],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let key = item(id, groups);
+    if (key >= params.count || flags[key + 1u] == flags[key]) {
+        return;
+    }
+    let v = flags[key];
+    let cell = cell_at[key];
+    let p = cells[cell].xyz;
+    vertex_of[cell] = v;
+    scalp_points[v] = vec4<f32>(p, 0.0);
+    scalp_normals[v] = vec4<f32>(head_gradient(p), 0.0);
+    // The polar projection about the crown.
+    let q = p - head_shape[0].xyz;
+    let r = head_polar(p) / 2.6;
+    let a = atan2(q.x, q.z);
+    scalp_uvs[v] = vec4<f32>(0.5 + 0.5 * r * sin(a), 0.5 + 0.5 * r * cos(a), 0.0, 0.0);
+}
+"#,
+    )
+}
+
+/// The triangles by vertex number, their areas, their edges as sort keys
+/// (the lesser vertex's number above the greater's), and the box the
+/// vertices are in, as ordered words ([`super::lod::bounds`]).
+pub fn nets_triangles() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> triangles: array<vec4<u32>>;
+@group(0) @binding(1) var<storage, read> vertex_of: array<u32>;
+@group(0) @binding(2) var<storage, read> scalp_points: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> tri_index: array<vec4<u32>>;
+@group(0) @binding(4) var<storage, read_write> areas: array<f32>;
+@group(0) @binding(5) var<storage, read_write> edge_keys: array<u32>;
+@group(0) @binding(6) var<storage, read_write> edge_ids: array<u32>;
+@group(0) @binding(7) var<storage, read_write> box_words: array<atomic<u32>>;
+struct Params {
+    count: u32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(8) var<uniform> params: Params;
+"#,
+        &[],
+        r#"
+fn ordered(x: f32) -> u32 {
+    let bits = bitcast<u32>(x);
+    return select(bits | 0x80000000u, ~bits, (bits & 0x80000000u) != 0u);
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let t = item(id, groups);
+    if (t >= params.count) {
+        return;
+    }
+    let cells = triangles[t];
+    let v = vec3<u32>(vertex_of[cells.x], vertex_of[cells.y], vertex_of[cells.z]);
+    tri_index[t] = vec4<u32>(v, 0u);
+    let a = scalp_points[v.x].xyz;
+    let b = scalp_points[v.y].xyz;
+    let c = scalp_points[v.z].xyz;
+    areas[t] = length(cross(b - a, c - a)) * 0.5;
+    // The box: every vertex is some triangle's.
+    for (var e = 0u; e < 3u; e++) {
+        let p = scalp_points[v[e]].xyz;
+        for (var k = 0u; k < 3u; k++) {
+            let key = ordered(p[k]);
+            atomicMax(&box_words[k], ~key);
+            atomicMax(&box_words[3u + k], key);
+        }
+    }
+    for (var e = 0u; e < 3u; e++) {
+        let p = v[e];
+        let q = v[(e + 1u) % 3u];
+        edge_keys[t * 3u + e] = (min(p, q) << 16u) | max(p, q);
+        edge_ids[t * 3u + e] = t * 3u + e;
+    }
+}
+"#,
+    )
+}
+
+/// The running area, one invocation adding in the host's order: which
+/// triangle a share of the area falls in depends on every rounding.
+pub fn nets_cdf() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> areas: array<f32>;
+@group(0) @binding(1) var<storage, read_write> tri_cdf: array<f32>;
+struct Params {
+    count: u32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(2) var<uniform> params: Params;
+"#,
+        &[],
+        r#"
+@compute @workgroup_size(1)
+fn main() {
+    var total = 0.0;
+    for (var t = 0u; t < params.count; t++) {
+        total += areas[t];
+        tri_cdf[t] = total;
+    }
+}
+"#,
+    )
+}
+
+/// Along the sorted edges, which are open (used by one triangle only) and
+/// how many points each gets at two spacings (`steps` then `fine`), for
+/// the scans to place them.
+pub fn nets_open() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> edge_keys: array<u32>;
+@group(0) @binding(1) var<storage, read> scalp_points: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> steps: array<u32>;
+@group(0) @binding(3) var<storage, read_write> fine: array<u32>;
+struct Params {
+    count: u32,
+    pad0: u32,
+    step: f32,
+    fine_step: f32,
+};
+@group(0) @binding(4) var<uniform> params: Params;
+"#,
+        &[],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let k = item(id, groups);
+    if (k >= params.count) {
+        return;
+    }
+    let key = edge_keys[k];
+    let open = (k == 0u || edge_keys[k - 1u] != key) && (k + 1u >= params.count || edge_keys[k + 1u] != key);
+    steps[k] = 0u;
+    fine[k] = 0u;
+    if (!open) {
+        return;
+    }
+    let length_ab = distance(scalp_points[key >> 16u].xyz, scalp_points[key & 0xFFFFu].xyz);
+    steps[k] = u32(max(ceil(length_ab / max(params.step, 1e-5)), 1.0));
+    fine[k] = u32(max(ceil(length_ab / max(params.fine_step, 1e-5)), 1.0));
+}
+"#,
+    )
+}
+
+/// The points along the open edges, each edge's from its lesser vertex.
+pub fn nets_boundary() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> edge_keys: array<u32>;
+@group(0) @binding(1) var<storage, read> scalp_points: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> offsets: array<u32>;
+@group(0) @binding(3) var<storage, read_write> boundary: array<vec4<f32>>;
+struct Params {
+    count: u32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(4) var<uniform> params: Params;
+"#,
+        &[MATH],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let k = item(id, groups);
+    if (k >= params.count) {
+        return;
+    }
+    let first = offsets[k];
+    let steps = offsets[k + 1u] - first;
+    let key = edge_keys[k];
+    let a = scalp_points[key >> 16u].xyz;
+    let b = scalp_points[key & 0xFFFFu].xyz;
+    for (var i = 0u; i < steps; i++) {
+        boundary[first + i] = vec4<f32>(lerp3(a, b, f32(i) / f32(steps)), 0.0);
+    }
+}
+"#,
+    )
+}
diff --git a/crates/fabelgeist-hair/src/gpu/wgsl/sim.rs b/crates/fabelgeist-hair/src/gpu/wgsl/sim.rs
new file mode 100644
index 000000000..eed7e2b7f
--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/wgsl/sim.rs
@@ -0,0 +1,1653 @@
+//! Real-time physics' kernels: [`crate::sim::HairSim`] on the GPU.
+
+use super::common::{HEAD, INDEX, MATH, NOISE, RANDOM};
+
+fn kernel(bindings: &str, helpers: &[&str], body: &str) -> String {
+    let mut source = String::from(bindings);
+    for h in helpers {
+        source.push_str(h);
+    }
+    source.push_str(INDEX);
+    source.push_str(body);
+    source
+}
+
+/// Each drawn strand's four simulated strands, nearest its root, weighted
+/// by inverse square distance -- the simulated ones follow themselves. The
+/// nearest four are kept sorted in registers, not a local array.
+pub fn sim_bind() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> level: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> ids: array<vec4<u32>>;
+@group(0) @binding(2) var<storage, read_write> weights: array<vec4<f32>>;
+struct Params {
+    strands: u32,
+    points: u32,
+    count: u32,
+    pad0: u32,
+};
+@group(0) @binding(3) var<uniform> params: Params;
+"#,
+        &[],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.strands) {
+        return;
+    }
+    if (s < params.count) {
+        ids[s] = vec4<u32>(s, 0u, 0u, 0u);
+        weights[s] = vec4<f32>(1.0, 0.0, 0.0, 0.0);
+        return;
+    }
+    let root = level[s * params.points].xyz;
+    let far = 1e30;
+    var best = vec4<f32>(far);
+    var near = vec4<u32>(0u);
+    for (var g = 0u; g < params.count; g++) {
+        let d = distance(root, level[g * params.points].xyz);
+        if (d >= best.w) {
+            continue;
+        }
+        if (d < best.z) {
+            best.w = best.z;
+            near.w = near.z;
+            if (d < best.y) {
+                best.z = best.y;
+                near.z = near.y;
+                if (d < best.x) {
+                    best.y = best.x;
+                    near.y = near.x;
+                    best.x = d;
+                    near.x = g;
+                } else {
+                    best.y = d;
+                    near.y = g;
+                }
+            } else {
+                best.z = d;
+                near.z = g;
+            }
+        } else {
+            best.w = d;
+            near.w = g;
+        }
+    }
+    var w = vec4<f32>(1.0) / (best * best + vec4<f32>(1e-8));
+    w = select(vec4<f32>(0.0), w, best < vec4<f32>(far));
+    ids[s] = near;
+    weights[s] = w / max(w.x + w.y + w.z + w.w, 1e-12);
+}
+"#,
+    )
+}
+
+const RIGID: &str = r#"
+fn head_apply(p: vec3<f32>) -> vec3<f32> {
+    return head_rotate(p) + vec3<f32>(params.tx, params.ty, params.tz);
+}
+
+fn head_rotate(v: vec3<f32>) -> vec3<f32> {
+    return vec3<f32>(params.ax_x, params.ax_y, params.ax_z) * v.x
+        + vec3<f32>(params.ay_x, params.ay_y, params.ay_z) * v.y
+        + vec3<f32>(params.az_x, params.az_y, params.az_z) * v.z;
+}
+
+// From the world into the head's frame.
+fn head_unapply(p: vec3<f32>) -> vec3<f32> {
+    let q = p - vec3<f32>(params.tx, params.ty, params.tz);
+    return vec3<f32>(
+        dot(vec3<f32>(params.ax_x, params.ax_y, params.ax_z), q),
+        dot(vec3<f32>(params.ay_x, params.ay_y, params.ay_z), q),
+        dot(vec3<f32>(params.az_x, params.az_y, params.az_z), q),
+    );
+}
+"#;
+
+const RIGID_PARAMS: &str = r#"
+    ax_x: f32,
+    ax_y: f32,
+    ax_z: f32,
+    ay_x: f32,
+    ay_y: f32,
+    ay_z: f32,
+    az_x: f32,
+    az_y: f32,
+    az_z: f32,
+    tx: f32,
+    ty: f32,
+    tz: f32,
+"#;
+
+/// The simulated strands' rest: each of the first `count` strands of the
+/// groom's finest level (`level`, `level_points` points a strand)
+/// resampled evenly by arc length to `points`, in the head's frame (the
+/// groom's), `w` one; and the longest segment, as its bits, in `longest`.
+pub fn sim_rest() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> level: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> rest: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> longest: array<atomic<u32>>;
+struct Params {
+    count: u32,
+    points: u32,
+    level_points: u32,
+    pad0: u32,
+};
+@group(0) @binding(3) var<uniform> params: Params;
+"#,
+        &[MATH],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let g = item(id, groups);
+    if (g >= params.count) {
+        return;
+    }
+    let from_points = params.level_points;
+    let base = g * from_points;
+    var total = 0.0;
+    for (var j = 1u; j < from_points; j++) {
+        total += distance(level[base + j].xyz, level[base + j - 1u].xyz);
+    }
+    let points = params.points;
+    var segment = 0u;
+    var segment_start = 0.0;
+    var segment_end = distance(level[base + 1u].xyz, level[base].xyz);
+    for (var j = 0u; j < points; j++) {
+        let target_length = total * f32(j) / f32(max(points - 1u, 1u));
+        while (segment + 2u < from_points && segment_end < target_length) {
+            segment += 1u;
+            segment_start = segment_end;
+            segment_end += distance(level[base + segment + 1u].xyz, level[base + segment].xyz);
+        }
+        let span = segment_end - segment_start;
+        var t = 0.0;
+        if (span > 1e-12) {
+            t = clamp((target_length - segment_start) / span, 0.0, 1.0);
+        }
+        rest[g * points + j] = vec4<f32>(lerp3(level[base + segment].xyz, level[base + segment + 1u].xyz, t), 1.0);
+    }
+    // Evenly resampled: every segment is as long.
+    atomicMax(&longest[0], bitcast<u32>(total / f32(max(points - 1u, 1u))));
+}
+"#,
+    )
+}
+
+/// Back to the groom, the head where it is: both positions from the rest.
+pub fn sim_reset() -> String {
+    kernel(
+        &format!(
+            r#"
+@group(0) @binding(0) var<storage, read> rest: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> position: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> previous: array<vec4<f32>>;
+struct Params {{
+{RIGID_PARAMS}
+    count: u32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+}};
+@group(0) @binding(3) var<uniform> params: Params;
+"#
+        ),
+        &[RIGID],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let i = item(id, groups);
+    if (i >= params.count) {
+        return;
+    }
+    let p = vec4<f32>(head_apply(rest[i].xyz), 1.0);
+    position[i] = p;
+    previous[i] = p;
+}
+"#,
+    )
+}
+
+/// A new level's simulation from the old one's: each new strand's points
+/// at its rest, moved as the four old strands nearest its root have moved
+/// at the same share of their length (a strand the old level simulated
+/// too follows only itself), its previous points likewise, so it carries
+/// on as it was moving.
+pub fn sim_transfer() -> String {
+    kernel(
+        &format!(
+            r#"
+@group(0) @binding(0) var<storage, read> rest: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> position: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> previous: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read> old_rest: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read> old_position: array<vec4<f32>>;
+@group(0) @binding(5) var<storage, read> old_previous: array<vec4<f32>>;
+@group(0) @binding(6) var<storage, read> ids: array<vec4<u32>>;
+@group(0) @binding(7) var<storage, read> weights: array<vec4<f32>>;
+struct Params {{
+{RIGID_PARAMS}
+    count: u32,
+    points: u32,
+    old_points: u32,
+    pad0: u32,
+}};
+@group(0) @binding(8) var<uniform> params: Params;
+"#
+        ),
+        &[MATH, RIGID],
+        r#"
+// Strand `g` of the old level at `share` of its points.
+fn old_at(buffer: u32, g: u32, share: f32) -> vec3<f32> {
+    let f = share * f32(params.old_points - 1u);
+    let i = min(u32(floor(f)), params.old_points - 2u);
+    let t = f - f32(i);
+    let a = g * params.old_points + i;
+    switch buffer {
+        case 0u: { return lerp3(old_rest[a].xyz, old_rest[a + 1u].xyz, t); }
+        case 1u: { return lerp3(old_position[a].xyz, old_position[a + 1u].xyz, t); }
+        default: { return lerp3(old_previous[a].xyz, old_previous[a + 1u].xyz, t); }
+    }
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let i = item(id, groups);
+    if (i >= params.count * params.points) {
+        return;
+    }
+    let g = i / params.points;
+    let share = f32(i % params.points) / f32(max(params.points - 1u, 1u));
+    let here = head_apply(rest[i].xyz);
+    var moved = vec3<f32>(0.0);
+    var before = vec3<f32>(0.0);
+    let near = ids[g];
+    let w = weights[g];
+    for (var k = 0u; k < 4u; k++) {
+        if (w[k] <= 0.0) {
+            continue;
+        }
+        let old_rest_here = head_apply(old_at(0u, near[k], share));
+        moved += (old_at(1u, near[k], share) - old_rest_here) * w[k];
+        before += (old_at(2u, near[k], share) - old_rest_here) * w[k];
+    }
+    position[i] = vec4<f32>(here + moved, 1.0);
+    previous[i] = vec4<f32>(here + before, 1.0);
+}
+"#,
+    )
+}
+
+/// The density grid's parameters: `lo` and `cell` of an `nx` by `ny` by
+/// `nz` grid of cells in the head's frame.
+const GRID_PARAMS: &str = r#"
+    lo_x: f32,
+    lo_y: f32,
+    lo_z: f32,
+    cell: f32,
+    nx: u32,
+    ny: u32,
+    nz: u32,
+"#;
+
+/// Trilinear weights over cell centres: the eight cells around a point.
+const GRID: &str = r#"
+const DENSITY_FIXED: f32 = 65536.0;
+const MOMENTUM_FIXED: f32 = 10000000.0;
+
+fn grid_base(local: vec3<f32>) -> vec3<f32> {
+    return (local - vec3<f32>(params.lo_x, params.lo_y, params.lo_z)) / params.cell - vec3<f32>(0.5);
+}
+
+// The `corner`th of the eight cells around `f` (from `grid_base`), its
+// index (or -1 outside the grid) and its weight.
+fn grid_corner(f: vec3<f32>, corner: u32) -> vec2<f32> {
+    let i0 = floor(f);
+    let t = f - i0;
+    let o = vec3<f32>(f32(corner & 1u), f32((corner >> 1u) & 1u), f32((corner >> 2u) & 1u));
+    let c = vec3<i32>(i0 + o);
+    let w = select(1.0 - t, t, o > vec3<f32>(0.5));
+    let n = vec3<i32>(i32(params.nx), i32(params.ny), i32(params.nz));
+    if (any(c < vec3<i32>(0)) || any(c >= n)) {
+        return vec2<f32>(-1.0, 0.0);
+    }
+    let index = (c.z * n.y + c.y) * n.x + c.x;
+    return vec2<f32>(f32(index), w.x * w.y * w.z);
+}
+"#;
+
+/// The groom's own density at rest, splatted into `rest_density` (fixed
+/// point) from the rest points, which are in the head's frame already.
+pub fn sim_rest_density() -> String {
+    kernel(
+        &format!(
+            r#"
+@group(0) @binding(0) var<storage, read> rest: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> rest_density: array<atomic<u32>>;
+struct Params {{
+{GRID_PARAMS}
+    count: u32,
+}};
+@group(0) @binding(2) var<uniform> params: Params;
+"#
+        ),
+        &[GRID],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let i = item(id, groups);
+    if (i >= params.count) {
+        return;
+    }
+    let f = grid_base(rest[i].xyz);
+    for (var corner = 0u; corner < 8u; corner++) {
+        let c = grid_corner(f, corner);
+        if (c.x >= 0.0) {
+            atomicAdd(&rest_density[u32(c.x)], u32(c.y * DENSITY_FIXED));
+        }
+    }
+}
+"#,
+    )
+}
+
+/// The rest density's sum (in 256ths of a point) and how many cells hold
+/// any: their mean is the density hair has where there is hair.
+pub fn sim_rest_stats() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> rest_density: array<u32>;
+@group(0) @binding(1) var<storage, read_write> stats: array<atomic<u32>>;
+struct Params {
+    count: u32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(2) var<uniform> params: Params;
+"#,
+        &[],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let c = item(id, groups);
+    if (c >= params.count || rest_density[c] == 0u) {
+        return;
+    }
+    atomicAdd(&stats[0], rest_density[c] >> 8u);
+    atomicAdd(&stats[1], 1u);
+}
+"#,
+    )
+}
+
+/// Every point's density and momentum (its velocity a substep) splatted
+/// into the grid, in the head's frame: four words a cell, density then
+/// momentum, in fixed point.
+pub fn sim_splat() -> String {
+    kernel(
+        &format!(
+            r#"
+@group(0) @binding(0) var<storage, read> position: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> previous: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> grid_words: array<atomic<i32>>;
+struct Params {{
+{RIGID_PARAMS}
+{GRID_PARAMS}
+    count: u32,
+}};
+@group(0) @binding(3) var<uniform> params: Params;
+"#
+        ),
+        &[RIGID, GRID],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let i = item(id, groups);
+    if (i >= params.count) {
+        return;
+    }
+    let x = position[i].xyz;
+    let v = x - previous[i].xyz;
+    let f = grid_base(head_unapply(x));
+    for (var corner = 0u; corner < 8u; corner++) {
+        let c = grid_corner(f, corner);
+        if (c.x < 0.0) {
+            continue;
+        }
+        let at = u32(c.x) * 4u;
+        atomicAdd(&grid_words[at], i32(c.y * DENSITY_FIXED));
+        let m = v * (c.y * MOMENTUM_FIXED);
+        atomicAdd(&grid_words[at + 1u], i32(m.x));
+        atomicAdd(&grid_words[at + 2u], i32(m.y));
+        atomicAdd(&grid_words[at + 3u], i32(m.z));
+    }
+}
+"#,
+    )
+}
+
+/// Volume and friction, a point an invocation (roots stay): pushed down
+/// the gradient of how much denser the hair is than it may be -- than at
+/// rest, or than hair's typical density where there was none, and a
+/// tolerance more -- and its velocity drawn towards the grid's there.
+pub fn sim_volume() -> String {
+    kernel(
+        &format!(
+            r#"
+@group(0) @binding(0) var<storage, read_write> position: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> previous: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> grid_words: array<i32>;
+@group(0) @binding(3) var<storage, read> rest_density: array<u32>;
+@group(0) @binding(4) var<storage, read> stats: array<u32>;
+struct Params {{
+{RIGID_PARAMS}
+{GRID_PARAMS}
+    count: u32,
+    points: u32,
+    volume: f32,
+    tolerance: f32,
+    friction: f32,
+}};
+@group(0) @binding(5) var<uniform> params: Params;
+"#
+        ),
+        &[MATH, RIGID, GRID],
+        r#"
+// The density at `local`, and what it may be there.
+fn densities(local: vec3<f32>, typical: f32) -> vec2<f32> {
+    let f = grid_base(local);
+    var now = 0.0;
+    var rest = 0.0;
+    for (var corner = 0u; corner < 8u; corner++) {
+        let c = grid_corner(f, corner);
+        if (c.x < 0.0) {
+            continue;
+        }
+        let index = u32(c.x);
+        now += f32(grid_words[index * 4u]) * c.y;
+        rest += f32(rest_density[index]) * c.y;
+    }
+    let allowed = max(rest / DENSITY_FIXED, typical) * (1.0 + params.tolerance);
+    return vec2<f32>(now / DENSITY_FIXED, allowed);
+}
+
+fn excess(local: vec3<f32>, typical: f32) -> f32 {
+    let d = densities(local, typical);
+    return max(d.x - d.y, 0.0);
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let i = item(id, groups);
+    if (i >= params.count || i % params.points == 0u) {
+        return;
+    }
+    let x = position[i].xyz;
+    let v = x - previous[i].xyz;
+    let local = head_unapply(x);
+    // Points a cell where there is hair, from the rest.
+    let typical = f32(stats[0]) * 256.0 / DENSITY_FIXED / max(f32(stats[1]), 1.0);
+    let here = densities(local, typical);
+    var push = vec3<f32>(0.0);
+    if (params.volume > 0.0 && here.x > here.y) {
+        // The excess's gradient across a cell, as a share of what is
+        // allowed: how far, in cells, to move.
+        let h = params.cell * 0.5;
+        let g = vec3<f32>(
+            excess(local + vec3<f32>(h, 0.0, 0.0), typical) - excess(local - vec3<f32>(h, 0.0, 0.0), typical),
+            excess(local + vec3<f32>(0.0, h, 0.0), typical) - excess(local - vec3<f32>(0.0, h, 0.0), typical),
+            excess(local + vec3<f32>(0.0, 0.0, h), typical) - excess(local - vec3<f32>(0.0, 0.0, h), typical),
+        ) / max(here.y, 1e-3);
+        push = -g * (params.volume * params.cell);
+        let reach = 0.5 * params.cell;
+        let l = length(push);
+        if (l > reach) {
+            push *= reach / l;
+        }
+        push = head_rotate(push);
+    }
+    var velocity = v;
+    if (params.friction > 0.0) {
+        // The hair's mean velocity here.
+        let f = grid_base(local);
+        var m = vec3<f32>(0.0);
+        var d = 0.0;
+        for (var corner = 0u; corner < 8u; corner++) {
+            let c = grid_corner(f, corner);
+            if (c.x < 0.0) {
+                continue;
+            }
+            let at = u32(c.x) * 4u;
+            d += f32(grid_words[at]) * c.y;
+            m += vec3<f32>(f32(grid_words[at + 1u]), f32(grid_words[at + 2u]), f32(grid_words[at + 3u])) * c.y;
+        }
+        if (d > 0.0) {
+            let mean = m / MOMENTUM_FIXED / (d / DENSITY_FIXED);
+            velocity = lerp3(v, mean, params.friction);
+        }
+    }
+    // The velocity drawn to the hair's; the push moves the point, and so
+    // carries on as velocity, a pressure.
+    position[i] = vec4<f32>(x + push, 1.0);
+    previous[i] = vec4<f32>(x - velocity, 1.0);
+}
+"#,
+    )
+}
+
+/// The collision grid's parameters: `lo` and `cell` of an `nx` by `ny` by
+/// `nz` grid in the head's frame.
+const CELL_PARAMS: &str = r#"
+    cell_lo_x: f32,
+    cell_lo_y: f32,
+    cell_lo_z: f32,
+    cell_size: f32,
+    cell_nx: u32,
+    cell_ny: u32,
+    cell_nz: u32,
+"#;
+
+/// Points along the colliding strands' segments, `per_segment` a segment,
+/// to find which segments are near which: each sample's position (`w` its
+/// strand), what the narrow phase needs of it -- its segment's ends now
+/// (`w` the strand) and at rest, its velocity a substep -- and its cell in
+/// the collision grid (in the head's frame, clamped to it) with its place
+/// among the cell's samples, counted.
+pub fn sim_samples() -> String {
+    kernel(
+        &format!(
+            r#"
+@group(0) @binding(0) var<storage, read> position: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> previous: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> rest: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> samples: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read_write> sample_data: array<vec4<f32>>;
+@group(0) @binding(5) var<storage, read_write> cell_counts: array<atomic<u32>>;
+@group(0) @binding(6) var<storage, read_write> sample_slots: array<u32>;
+struct Params {{
+{RIGID_PARAMS}
+{CELL_PARAMS}
+    count: u32,
+    points: u32,
+    per_segment: u32,
+    pad0: u32,
+    pad1: u32,
+}};
+@group(0) @binding(7) var<uniform> params: Params;
+"#
+        ),
+        &[MATH, RIGID],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let k = item(id, groups);
+    if (k >= params.count) {
+        return;
+    }
+    let segment = k / params.per_segment;
+    let segments = params.points - 1u;
+    let g = segment / segments;
+    let a = g * params.points + segment % segments;
+    let t = (f32(k % params.per_segment) + 0.5) / f32(params.per_segment);
+    let strand = f32(g);
+    let here = lerp3(position[a].xyz, position[a + 1u].xyz, t);
+    samples[k] = vec4<f32>(here, strand);
+    let va = position[a].xyz - previous[a].xyz;
+    let vb = position[a + 1u].xyz - previous[a + 1u].xyz;
+    let local = head_unapply(here);
+    let n = vec3<i32>(i32(params.cell_nx), i32(params.cell_ny), i32(params.cell_nz));
+    let c = clamp(
+        vec3<i32>(floor((local - vec3<f32>(params.cell_lo_x, params.cell_lo_y, params.cell_lo_z)) / params.cell_size)),
+        vec3<i32>(0),
+        n - vec3<i32>(1),
+    );
+    let cell = u32((c.z * n.y + c.y) * n.x + c.x);
+    sample_data[k * 5u] = vec4<f32>(position[a].xyz, strand);
+    sample_data[k * 5u + 1u] = vec4<f32>(position[a + 1u].xyz, 0.0);
+    sample_data[k * 5u + 2u] = vec4<f32>(rest[a].xyz, 0.0);
+    sample_data[k * 5u + 3u] = vec4<f32>(rest[a + 1u].xyz, 0.0);
+    sample_data[k * 5u + 4u] = vec4<f32>(lerp3(va, vb, t), f32(cell));
+    sample_slots[k * 2u] = cell;
+    sample_slots[k * 2u + 1u] = atomicAdd(&cell_counts[cell], 1u);
+}
+"#,
+    )
+}
+
+/// The samples scattered into the collision grid's order (`cell_offsets`,
+/// the counts scanned), so that a cell's samples lie together in memory and
+/// neighbouring invocations look about the same place: eight words a
+/// sample -- where it is (`w` its strand), where it was at the last pass,
+/// its segment's ends now and at rest, its velocity (`w` its cell) -- and
+/// which sample it is.
+pub fn sim_sort_samples() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> samples: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> samples_before: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> sample_data: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read> sample_slots: array<u32>;
+@group(0) @binding(4) var<storage, read> cell_offsets: array<u32>;
+@group(0) @binding(5) var<storage, read_write> sorted: array<vec4<f32>>;
+@group(0) @binding(6) var<storage, read_write> sorted_index: array<u32>;
+struct Params {
+    count: u32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(7) var<uniform> params: Params;
+"#,
+        &[],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let k = item(id, groups);
+    if (k >= params.count) {
+        return;
+    }
+    let r = cell_offsets[sample_slots[k * 2u]] + sample_slots[k * 2u + 1u];
+    sorted_index[r] = k;
+    sorted[r * 8u] = samples[k];
+    sorted[r * 8u + 1u] = samples_before[k];
+    for (var w = 0u; w < 5u; w++) {
+        sorted[r * 8u + 2u + w] = sample_data[k * 5u + w];
+    }
+}
+"#,
+    )
+}
+
+/// The strands' collisions, a sample an invocation (in the grid's order).
+/// Samples find which segments are near which; each pair of segments
+/// within the radius is then taken as it is: its closest points, how far
+/// apart, and the normal between them. A pair may come as near as the
+/// radius, or as near as the groom had the two segments at rest if nearer
+/// (hair lying on hair stays as it lies); nearer than that, each side is to
+/// move half the shortfall apart -- to the side its samples were on at the
+/// last pass, so a pair that crossed in between goes back -- without
+/// gaining speed, and lose its half of the closing velocity, the sliding
+/// slowed by Coulomb friction. Each sample writes the mean of its asks, two
+/// words: the move and whether it asks, then the velocity change. No
+/// atomics: a point's samples are gathered after.
+pub fn sim_collide() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> sorted: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> sorted_index: array<u32>;
+@group(0) @binding(2) var<storage, read> cell_offsets: array<u32>;
+@group(0) @binding(3) var<storage, read_write> asks: array<vec4<f32>>;
+struct Params {
+    count: u32,
+    cell_nx: u32,
+    cell_ny: u32,
+    cell_nz: u32,
+    radius: f32,
+    reach: f32,
+    friction: f32,
+    have_before: u32,
+};
+@group(0) @binding(4) var<uniform> params: Params;
+"#,
+        &[MATH],
+        r#"
+// The closest points of segments `p1 q1` and `p2 q2` (Ericson's), as the
+// two parameters along them.
+fn closest_parameters(p1: vec3<f32>, q1: vec3<f32>, p2: vec3<f32>, q2: vec3<f32>) -> vec2<f32> {
+    let d1 = q1 - p1;
+    let d2 = q2 - p2;
+    let r = p1 - p2;
+    let a = dot(d1, d1);
+    let e = dot(d2, d2);
+    let f = dot(d2, r);
+    if (a <= 1e-12 && e <= 1e-12) {
+        return vec2<f32>(0.0);
+    }
+    if (a <= 1e-12) {
+        return vec2<f32>(0.0, clamp(f / e, 0.0, 1.0));
+    }
+    let c = dot(d1, r);
+    if (e <= 1e-12) {
+        return vec2<f32>(clamp(-c / a, 0.0, 1.0), 0.0);
+    }
+    let b = dot(d1, d2);
+    let denom = a * e - b * b;
+    var s = 0.0;
+    if (denom > 1e-12) {
+        s = clamp((b * f - c * e) / denom, 0.0, 1.0);
+    }
+    var t = (b * s + f) / e;
+    if (t < 0.0) {
+        t = 0.0;
+        s = clamp(-c / a, 0.0, 1.0);
+    } else if (t > 1.0) {
+        t = 1.0;
+        s = clamp((b - c) / a, 0.0, 1.0);
+    }
+    return vec2<f32>(s, t);
+}
+
+fn segment_distance(p1: vec3<f32>, q1: vec3<f32>, p2: vec3<f32>, q2: vec3<f32>) -> f32 {
+    let st = closest_parameters(p1, q1, p2, q2);
+    return distance(lerp3(p1, q1, st.x), lerp3(p2, q2, st.y));
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let r = item(id, groups);
+    if (r >= params.count) {
+        return;
+    }
+    let own = sorted[r * 8u];
+    let own_before = sorted[r * 8u + 1u].xyz;
+    let a1 = sorted[r * 8u + 2u].xyz;
+    let b1 = sorted[r * 8u + 3u].xyz;
+    let rest_a1 = sorted[r * 8u + 4u].xyz;
+    let rest_b1 = sorted[r * 8u + 5u].xyz;
+    let own_velocity = sorted[r * 8u + 6u].xyz;
+    let p = own.xyz;
+    let reach2 = params.reach * params.reach;
+    let n = vec3<i32>(i32(params.cell_nx), i32(params.cell_ny), i32(params.cell_nz));
+    let own_cell = i32(sorted[r * 8u + 6u].w);
+    let base = vec3<i32>(own_cell % n.x, (own_cell / n.x) % n.y, own_cell / (n.x * n.y));
+    var shift = vec3<f32>(0.0);
+    var change = vec3<f32>(0.0);
+    var contacts = 0u;
+    for (var m = 0u; m < 27u; m++) {
+        let c = base + vec3<i32>(i32(m % 3u) - 1, i32((m / 3u) % 3u) - 1, i32(m / 9u) - 1);
+        if (any(c < vec3<i32>(0)) || any(c >= n)) {
+            continue;
+        }
+        let cell = u32((c.z * n.y + c.y) * n.x + c.x);
+        let last = cell_offsets[cell + 1u];
+        for (var o = cell_offsets[cell]; o < last; o++) {
+            let q = sorted[o * 8u];
+            let near = p - q.xyz;
+            if (dot(near, near) >= reach2 || q.w == own.w) {
+                continue;
+            }
+            // The segments themselves.
+            let a2 = sorted[o * 8u + 2u].xyz;
+            let b2 = sorted[o * 8u + 3u].xyz;
+            let st = closest_parameters(a1, b1, a2, b2);
+            let apart = lerp3(a1, b1, st.x) - lerp3(a2, b2, st.y);
+            let d = length(apart);
+            if (d >= params.radius) {
+                continue;
+            }
+            let allowed = min(
+                params.radius,
+                segment_distance(rest_a1, rest_b1, sorted[o * 8u + 4u].xyz, sorted[o * 8u + 5u].xyz),
+            );
+            // Between the segments, to the side the samples were on.
+            var normal = safe_normalize(apart, safe_normalize(near, vec3<f32>(0.0, 1.0, 0.0)));
+            if (params.have_before != 0u && dot(normal, own_before - sorted[o * 8u + 1u].xyz) < 0.0) {
+                normal = -normal;
+            }
+            let gap = dot(apart, normal);
+            if (gap >= allowed) {
+                continue;
+            }
+            let relative = own_velocity - sorted[o * 8u + 6u].xyz;
+            let closing = dot(relative, normal);
+            // Hair lying on hair as at rest, to rounding, and still: nothing
+            // to ask.
+            let short = allowed - gap;
+            if (short < 0.02 * params.radius && closing >= 0.0) {
+                continue;
+            }
+            shift += normal * (0.5 * short);
+            if (closing < 0.0) {
+                var dv = -0.5 * closing * normal;
+                let sliding = relative - closing * normal;
+                let s = length(sliding);
+                if (s > 1e-9) {
+                    dv -= sliding * min(params.friction * (-0.5 * closing) / s, 0.5);
+                }
+                change += dv;
+            }
+            contacts += 1u;
+        }
+    }
+    let k = sorted_index[r];
+    if (contacts == 0u) {
+        asks[k * 2u] = vec4<f32>(0.0);
+        return;
+    }
+    let mean = 1.0 / f32(contacts);
+    asks[k * 2u] = vec4<f32>(shift * mean, 1.0);
+    asks[k * 2u + 1u] = vec4<f32>(change * mean, 0.0);
+}
+"#,
+    )
+}
+
+/// The collisions applied, a point an invocation (roots stay): the asks of
+/// the samples on its two segments, weighted by how near each is, averaged
+/// over those that ask; it moves, with the point it was a substep ago so
+/// the move is not speed, and its velocity changes.
+pub fn sim_collide_apply() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read_write> position: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> previous: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> asks: array<vec4<f32>>;
+struct Params {
+    count: u32,
+    points: u32,
+    per_segment: u32,
+    pad0: u32,
+};
+@group(0) @binding(3) var<uniform> params: Params;
+"#,
+        &[],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let i = item(id, groups);
+    let points = params.points;
+    let j = i % points;
+    if (i >= params.count || j == 0u) {
+        return;
+    }
+    let segments = points - 1u;
+    let g = i / points;
+    var shift = vec3<f32>(0.0);
+    var change = vec3<f32>(0.0);
+    var weight = 0.0;
+    // The segment before (this point its far end) and after (its near end).
+    for (var side = 0u; side < 2u; side++) {
+        if (side == 1u && j >= segments) {
+            continue;
+        }
+        let segment = g * segments + j - 1u + side;
+        for (var s = 0u; s < params.per_segment; s++) {
+            let k = segment * params.per_segment + s;
+            let a = asks[k * 2u];
+            if (a.w == 0.0) {
+                continue;
+            }
+            let t = (f32(s) + 0.5) / f32(params.per_segment);
+            let w = select(t, 1.0 - t, side == 1u);
+            shift += a.xyz * w;
+            change += asks[k * 2u + 1u].xyz * w;
+            weight += w;
+        }
+    }
+    if (weight <= 0.0) {
+        return;
+    }
+    shift /= weight;
+    change /= weight;
+    position[i] = vec4<f32>(position[i].xyz + shift + change, 1.0);
+    previous[i] = vec4<f32>(previous[i].xyz + shift, 1.0);
+}
+"#,
+    )
+}
+
+/// A pose as a kernel holds it, and the host's [`crate::sim::blend`].
+const POSE: &str = r#"
+struct Pose {
+    x: vec3<f32>,
+    y: vec3<f32>,
+    z: vec3<f32>,
+    t: vec3<f32>,
+};
+
+fn pose_rotate(q: Pose, v: vec3<f32>) -> vec3<f32> {
+    return q.x * v.x + q.y * v.y + q.z * v.z;
+}
+
+fn pose_apply(q: Pose, p: vec3<f32>) -> vec3<f32> {
+    return pose_rotate(q, p) + q.t;
+}
+
+fn pose_unapply(q: Pose, p: vec3<f32>) -> vec3<f32> {
+    let d = p - q.t;
+    return vec3<f32>(dot(q.x, d), dot(q.y, d), dot(q.z, d));
+}
+
+fn pose_blend(a: Pose, b: Pose, s: f32) -> Pose {
+    let x = safe_normalize(lerp3(a.x, b.x, s), b.x);
+    let y0 = lerp3(a.y, b.y, s);
+    let y = safe_normalize(y0 - x * dot(y0, x), b.y);
+    return Pose(x, y, cross(x, y), lerp3(a.t, b.t, s));
+}
+"#;
+
+/// The other pose a kernel takes, where the head starts: [`RIGID_PARAMS`]
+/// is where it ends.
+const FROM_PARAMS: &str = r#"
+    from_xx: f32,
+    from_xy: f32,
+    from_xz: f32,
+    from_yx: f32,
+    from_yy: f32,
+    from_yz: f32,
+    from_zx: f32,
+    from_zy: f32,
+    from_zz: f32,
+    from_tx: f32,
+    from_ty: f32,
+    from_tz: f32,
+"#;
+
+/// [`crate::rod`]'s matrices and quaternions (`xyz` the vector part, `w`
+/// the scalar), and the rod's lengths and masses from the strand's groomed
+/// points in `rest`.
+const ROD: &str = r#"
+fn identity3() -> mat3x3<f32> {
+    return mat3x3<f32>(vec3<f32>(1.0, 0.0, 0.0), vec3<f32>(0.0, 1.0, 0.0), vec3<f32>(0.0, 0.0, 1.0));
+}
+
+fn scaling3(s: vec3<f32>) -> mat3x3<f32> {
+    return mat3x3<f32>(vec3<f32>(s.x, 0.0, 0.0), vec3<f32>(0.0, s.y, 0.0), vec3<f32>(0.0, 0.0, s.z));
+}
+
+fn outer3(a: vec3<f32>, b: vec3<f32>) -> mat3x3<f32> {
+    return mat3x3<f32>(a * b.x, a * b.y, a * b.z);
+}
+
+fn skew3(a: vec3<f32>) -> mat3x3<f32> {
+    return mat3x3<f32>(vec3<f32>(0.0, a.z, -a.y), vec3<f32>(-a.z, 0.0, a.x), vec3<f32>(a.y, -a.x, 0.0));
+}
+
+fn inverse3(m: mat3x3<f32>) -> mat3x3<f32> {
+    let r0 = cross(m[1], m[2]);
+    let r1 = cross(m[2], m[0]);
+    let r2 = cross(m[0], m[1]);
+    let det = dot(m[0], r0);
+    var inv = 0.0;
+    if (abs(det) > 1e-30) {
+        inv = 1.0 / det;
+    }
+    return transpose(mat3x3<f32>(r0 * inv, r1 * inv, r2 * inv));
+}
+
+fn qmul(a: vec4<f32>, b: vec4<f32>) -> vec4<f32> {
+    return vec4<f32>(b.xyz * a.w + a.xyz * b.w + cross(a.xyz, b.xyz), a.w * b.w - dot(a.xyz, b.xyz));
+}
+
+fn qconj(a: vec4<f32>) -> vec4<f32> {
+    return vec4<f32>(-a.xyz, a.w);
+}
+
+fn qrotate(q: vec4<f32>, p: vec3<f32>) -> vec3<f32> {
+    let t = cross(q.xyz, p) * 2.0;
+    return p + t * q.w + cross(q.xyz, t);
+}
+
+fn qmatrix(q: vec4<f32>) -> mat3x3<f32> {
+    return mat3x3<f32>(
+        qrotate(q, vec3<f32>(1.0, 0.0, 0.0)),
+        qrotate(q, vec3<f32>(0.0, 1.0, 0.0)),
+        qrotate(q, vec3<f32>(0.0, 0.0, 1.0)),
+    );
+}
+
+fn qnormalize(q: vec4<f32>) -> vec4<f32> {
+    let l = sqrt(dot(q.xyz, q.xyz) + q.w * q.w);
+    if (l > 1e-12) {
+        return vec4<f32>(q.xyz * (1.0 / l), q.w / l);
+    }
+    return vec4<f32>(0.0, 0.0, 0.0, 1.0);
+}
+
+fn qexp(theta: vec3<f32>) -> vec4<f32> {
+    let angle = length(theta);
+    if (angle < 1e-12) {
+        return vec4<f32>(0.0, 0.0, 0.0, 1.0);
+    }
+    let half_angle = 0.5 * angle;
+    return vec4<f32>(theta * (sin(half_angle) / angle), cos(half_angle));
+}
+
+// Shepperd's method.
+fn qfrom_matrix(m: mat3x3<f32>) -> vec4<f32> {
+    let c0 = m[0];
+    let c1 = m[1];
+    let c2 = m[2];
+    let trace = c0.x + c1.y + c2.z;
+    var q: vec4<f32>;
+    if (trace > 0.0) {
+        let s = sqrt(trace + 1.0) * 2.0;
+        q = vec4<f32>(vec3<f32>(c1.z - c2.y, c2.x - c0.z, c0.y - c1.x) * (1.0 / s), 0.25 * s);
+    } else if (c0.x > c1.y && c0.x > c2.z) {
+        let s = sqrt(1.0 + c0.x - c1.y - c2.z) * 2.0;
+        q = vec4<f32>(0.25 * s, (c1.x + c0.y) / s, (c2.x + c0.z) / s, (c1.z - c2.y) / s);
+    } else if (c1.y > c2.z) {
+        let s = sqrt(1.0 + c1.y - c0.x - c2.z) * 2.0;
+        q = vec4<f32>((c1.x + c0.y) / s, 0.25 * s, (c2.y + c1.z) / s, (c2.x - c0.z) / s);
+    } else {
+        let s = sqrt(1.0 + c2.z - c0.x - c1.y) * 2.0;
+        q = vec4<f32>((c2.x + c0.z) / s, (c2.y + c1.z) / s, 0.25 * s, (c0.y - c1.x) / s);
+    }
+    return qnormalize(q);
+}
+
+fn qfrom_frame(d1: vec3<f32>, d3: vec3<f32>) -> vec4<f32> {
+    return qfrom_matrix(mat3x3<f32>(d1, cross(d3, d1), d3));
+}
+
+// The least rotation taking unit `a` to unit `b`.
+fn least_turn(a: vec3<f32>, b: vec3<f32>) -> vec4<f32> {
+    let c = dot(a, b);
+    if (c < -0.999999) {
+        return vec4<f32>(orthogonal(a), 0.0);
+    }
+    return qnormalize(vec4<f32>(cross(a, b), 1.0 + c));
+}
+
+// The turn from frame `a` to `b`, `rod::darboux`.
+struct Turn {
+    v: vec3<f32>,
+    change: mat3x3<f32>,
+    matrix: mat3x3<f32>,
+};
+
+fn darboux(a: vec4<f32>, b: vec4<f32>, groomed: vec4<f32>) -> Turn {
+    var q = qmul(qconj(a), b);
+    // The groom's turn the short way round, as the rest was solved for.
+    let side = dot(q, groomed) * groomed.w;
+    if (side < 0.0 || (side == 0.0 && q.w < 0.0)) {
+        q = -q;
+    }
+    return Turn(q.xyz, (skew3(q.xyz) - identity3() * q.w) * 0.5, qmatrix(q));
+}
+
+// Groomed segment `j` of the strand from `base`.
+fn rest_segment(base: u32, j: u32) -> vec3<f32> {
+    return rest[base + j + 1u].xyz - rest[base + j].xyz;
+}
+
+fn rest_length(base: u32, j: u32) -> f32 {
+    return max(length(rest_segment(base, j)), 1e-6);
+}
+
+fn rest_tangent(base: u32, j: u32) -> vec3<f32> {
+    return safe_normalize(rest_segment(base, j), vec3<f32>(0.0, -1.0, 0.0));
+}
+
+// Point `i`'s mass over mass per length.
+fn point_mass(base: u32, i: u32, segs: u32) -> f32 {
+    var next = 0.0;
+    if (i < segs) {
+        next = rest_length(base, i);
+    }
+    return 0.5 * (rest_length(base, i - 1u) + next);
+}
+
+// The stiffness of the joint before segment `s`, `Rod::joint`.
+fn joint_stiffness(base: u32, s: u32) -> vec3<f32> {
+    var span = 0.5 * rest_length(base, 0u);
+    if (s > 0u) {
+        span = 0.5 * (rest_length(base, s - 1u) + rest_length(base, s));
+    }
+    return vec3<f32>(params.bend, params.bend, params.twist) * (4.0 / span);
+}
+"#;
+
+/// Each simulated strand's rod's rest, a strand an invocation:
+/// [`crate::rod::rest_shape`] into `shape`, two slots a point -- which
+/// holds each segment's strain and length while the strand is walked back
+/// from the tip.
+pub fn sim_shape() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> rest: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> shape: array<vec4<f32>>;
+struct Params {
+    count: u32,
+    points: u32,
+    sag_free: u32,
+    pad0: u32,
+    stretch: f32,
+    bend: f32,
+    twist: f32,
+    gravity: f32,
+};
+@group(0) @binding(2) var<uniform> params: Params;
+"#,
+        &[MATH, ROD],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let g = item(id, groups);
+    if (g >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let base = g * points;
+    let segs = points - 1u;
+    let gravity = vec3<f32>(0.0, -params.gravity, 0.0);
+    // What each segment carries: the weight below it.
+    var below = vec3<f32>(0.0);
+    if (params.sag_free != 0u) {
+        for (var i = segs; i >= 1u; i--) {
+            below += gravity * point_mass(base, i, segs);
+        }
+    }
+    let normal = orthogonal(rest_tangent(base, 0u));
+    let follicle = qfrom_frame(normal, rest_tangent(base, 0u));
+    var t = rest_tangent(base, 0u);
+    var u = normal;
+    for (var j = 0u; j < segs; j++) {
+        if (j > 0u && params.sag_free != 0u) {
+            below -= gravity * point_mass(base, j, segs);
+        }
+        let tangent = rest_tangent(base, j);
+        u = transport(u, t, tangent);
+        t = tangent;
+        let lj = rest_length(base, j);
+        let strain = below * (lj / params.stretch);
+        let chord = tangent * lj - strain;
+        let len = max(length(chord), 1e-9);
+        let axis = chord * (1.0 / len);
+        let d1 = safe_normalize(transport(u, t, axis), u);
+        shape[base * 2u + 2u * j] = qfrom_frame(d1, axis);
+        shape[base * 2u + 2u * j + 1u] = vec4<f32>(strain, len);
+    }
+    // Each joint rests bent and twisted by the moment it carries.
+    var moment = vec3<f32>(0.0);
+    for (var s = segs; s >= 1u; s--) {
+        let k = s - 1u;
+        var a = follicle;
+        if (k > 0u) {
+            a = shape[base * 2u + 2u * (k - 1u)];
+        }
+        let b = shape[base * 2u + 2u * k];
+        let held = shape[base * 2u + 2u * k + 1u];
+        let turn = darboux(a, b, vec4<f32>(0.0, 0.0, 0.0, 1.0));
+        var rest_turn = turn.v;
+        if (params.sag_free != 0u) {
+            let axis = qrotate(b, vec3<f32>(0.0, 0.0, 1.0));
+            let stretch = params.stretch / rest_length(base, k);
+            moment += cross(axis, held.xyz) * (stretch * held.w);
+            let stiffness = joint_stiffness(base, k);
+            let wanted = inverse3(transpose(turn.change)) * (qrotate(qconj(a), moment) * -1.0);
+            rest_turn = turn.v - wanted / stiffness;
+        }
+        shape[base * 2u + 2u * k + 1u] = vec4<f32>(rest_turn, held.w);
+    }
+    shape[base * 2u + 2u * segs] = follicle;
+    shape[base * 2u + 2u * segs + 1u] = vec4<f32>(0.0);
+}
+"#,
+    )
+}
+
+/// Each simulated segment's frame onto where its strand now is, the head
+/// at the pose given, not spinning: [`crate::rod::frames_along`], a point
+/// an invocation (the last of each strand has no segment).
+pub fn sim_orient() -> String {
+    kernel(
+        &format!(
+            r#"
+@group(0) @binding(0) var<storage, read> rest: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> shape: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> position: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> frames: array<vec4<f32>>;
+struct Params {{
+{RIGID_PARAMS}
+    count: u32,
+    points: u32,
+    pad0: u32,
+    pad1: u32,
+}};
+@group(0) @binding(4) var<uniform> params: Params;
+"#
+        ),
+        &[MATH, RIGID],
+        &format!(
+            "{}{}",
+            ROD_QUATERNIONS,
+            r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let k = item(id, groups);
+    if (k >= params.count || k % params.points == params.points - 1u) {
+        return;
+    }
+    let head = qfrom_matrix(mat3x3<f32>(
+        vec3<f32>(params.ax_x, params.ax_y, params.ax_z),
+        vec3<f32>(params.ay_x, params.ay_y, params.ay_z),
+        vec3<f32>(params.az_x, params.az_y, params.az_z),
+    ));
+    let carried = qmul(head, shape[2u * k]);
+    let groomed = head_rotate(safe_normalize(rest[k + 1u].xyz - rest[k].xyz, vec3<f32>(0.0, -1.0, 0.0)));
+    let along = safe_normalize(position[k + 1u].xyz - position[k].xyz, groomed);
+    frames[2u * k] = qnormalize(qmul(least_turn(groomed, along), carried));
+    frames[2u * k + 1u] = vec4<f32>(0.0);
+}
+"#
+        ),
+    )
+}
+
+/// The quaternion helpers of [`ROD`] alone, for kernels without its rod.
+const ROD_QUATERNIONS: &str = r#"
+fn qmul(a: vec4<f32>, b: vec4<f32>) -> vec4<f32> {
+    return vec4<f32>(b.xyz * a.w + a.xyz * b.w + cross(a.xyz, b.xyz), a.w * b.w - dot(a.xyz, b.xyz));
+}
+
+fn qnormalize(q: vec4<f32>) -> vec4<f32> {
+    let l = sqrt(dot(q.xyz, q.xyz) + q.w * q.w);
+    if (l > 1e-12) {
+        return vec4<f32>(q.xyz * (1.0 / l), q.w / l);
+    }
+    return vec4<f32>(0.0, 0.0, 0.0, 1.0);
+}
+
+fn qfrom_matrix(m: mat3x3<f32>) -> vec4<f32> {
+    let c0 = m[0];
+    let c1 = m[1];
+    let c2 = m[2];
+    let trace = c0.x + c1.y + c2.z;
+    var q: vec4<f32>;
+    if (trace > 0.0) {
+        let s = sqrt(trace + 1.0) * 2.0;
+        q = vec4<f32>(vec3<f32>(c1.z - c2.y, c2.x - c0.z, c0.y - c1.x) * (1.0 / s), 0.25 * s);
+    } else if (c0.x > c1.y && c0.x > c2.z) {
+        let s = sqrt(1.0 + c0.x - c1.y - c2.z) * 2.0;
+        q = vec4<f32>(0.25 * s, (c1.x + c0.y) / s, (c2.x + c0.z) / s, (c1.z - c2.y) / s);
+    } else if (c1.y > c2.z) {
+        let s = sqrt(1.0 + c1.y - c0.x - c2.z) * 2.0;
+        q = vec4<f32>((c1.x + c0.y) / s, 0.25 * s, (c2.y + c1.z) / s, (c2.x - c0.z) / s);
+    } else {
+        let s = sqrt(1.0 + c2.z - c0.x - c1.y) * 2.0;
+        q = vec4<f32>((c2.x + c0.z) / s, (c2.y + c1.z) / s, 0.25 * s, (c0.y - c1.x) / s);
+    }
+    return qnormalize(q);
+}
+
+fn least_turn(a: vec3<f32>, b: vec3<f32>) -> vec4<f32> {
+    let c = dot(a, b);
+    if (c < -0.999999) {
+        return vec4<f32>(orthogonal(a), 0.0);
+    }
+    return qnormalize(vec4<f32>(cross(a, b), 1.0 + c));
+}
+"#;
+
+/// The simulated strands' substeps of a step, a strand an invocation:
+/// [`crate::rod::Substep::strand`] `inner` times, the head going from
+/// `from` to the end pose, after turning each frame back onto its segment
+/// (the strands meeting each other move points, not frames). Each solves its strand's implicit step by block
+/// LDLᵀ, its factors in `factors` (fourteen words a point: the 6x6 block of
+/// L left of the diagonal, and the forward solve's solution), and leaves
+/// `previous` a substep's velocity behind `position` and each segment's
+/// frame and angular velocity in `frames`.
+pub fn sim_step() -> String {
+    kernel(
+        &format!(
+            r#"
+@group(0) @binding(0) var<storage, read> rest: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> shape: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> position: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> previous: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read_write> frames: array<vec4<f32>>;
+@group(0) @binding(5) var<storage, read> head_shape: array<vec4<f32>>;
+@group(0) @binding(6) var<storage, read_write> factors: array<vec4<f32>>;
+struct Params {{
+{RIGID_PARAMS}
+{FROM_PARAMS}
+    count: u32,
+    points: u32,
+    body: u32,
+    inner: u32,
+    h: f32,
+    h_last: f32,
+    time: f32,
+    gravity: f32,
+    wind_x: f32,
+    wind_y: f32,
+    wind_z: f32,
+    turbulence: f32,
+    collision_offset: f32,
+    head_friction: f32,
+    stretch: f32,
+    bend: f32,
+    twist: f32,
+    gyration: f32,
+    damping: f32,
+    drag: f32,
+    drag_viscous: f32,
+    pad0: f32,
+    pad1: f32,
+    pad2: f32,
+}};
+@group(0) @binding(7) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM, NOISE, MATH, HEAD, POSE, ROD],
+        r#"
+struct M6 {
+    a: mat3x3<f32>,
+    b: mat3x3<f32>,
+    c: mat3x3<f32>,
+    d: mat3x3<f32>,
+};
+
+struct V6 {
+    w: vec3<f32>,
+    v: vec3<f32>,
+};
+
+fn m6_zero() -> M6 {
+    return M6(mat3x3<f32>(), mat3x3<f32>(), mat3x3<f32>(), mat3x3<f32>());
+}
+
+fn m6_mul(p: M6, o: M6) -> M6 {
+    return M6(p.a * o.a + p.b * o.c, p.a * o.b + p.b * o.d, p.c * o.a + p.d * o.c, p.c * o.b + p.d * o.d);
+}
+
+fn m6_apply(p: M6, u: V6) -> V6 {
+    return V6(p.a * u.w + p.b * u.v, p.c * u.w + p.d * u.v);
+}
+
+fn m6_transpose(p: M6) -> M6 {
+    return M6(transpose(p.a), transpose(p.c), transpose(p.b), transpose(p.d));
+}
+
+fn m6_inverse(p: M6) -> M6 {
+    let ai = inverse3(p.a);
+    let aib = ai * p.b;
+    let cai = p.c * ai;
+    let si = inverse3(p.d - p.c * aib);
+    return M6(ai + aib * si * cai, (aib * si) * -1.0, (si * cai) * -1.0, si);
+}
+
+// A segment as a substep sees it, `rod::Segment`.
+struct Segment {
+    axes: mat3x3<f32>,
+    strain: vec3<f32>,
+    stiffness: f32,
+    len: f32,
+};
+
+// A joint as a substep sees it, `rod::Joint`.
+struct Joint {
+    stiffness: mat3x3<f32>,
+    torque: vec3<f32>,
+    turn: mat3x3<f32>,
+    curving: f32,
+};
+
+fn no_segment() -> Segment {
+    return Segment(mat3x3<f32>(), vec3<f32>(0.0), 0.0, 0.0);
+}
+
+fn no_joint() -> Joint {
+    return Joint(mat3x3<f32>(), vec3<f32>(0.0), mat3x3<f32>(), 0.0);
+}
+
+fn frame_at(base: u32, j: u32) -> vec4<f32> {
+    return frames[2u * (base + j)];
+}
+
+fn segment_at(base: u32, j: u32) -> Segment {
+    let axes = qmatrix(frame_at(base, j));
+    let len = shape[2u * (base + j) + 1u].w;
+    return Segment(
+        axes,
+        position[base + j + 1u].xyz - position[base + j].xyz - axes[2] * len,
+        params.stretch / rest_length(base, j),
+        len,
+    );
+}
+
+fn joint_at(base: u32, s: u32, before: vec4<f32>) -> Joint {
+    var groomed_before = shape[2u * (base + params.points - 1u)];
+    if (s > 0u) {
+        groomed_before = shape[2u * (base + s - 1u)];
+    }
+    let groomed = qmul(qconj(groomed_before), shape[2u * (base + s)]);
+    let turn = darboux(before, frame_at(base, s), groomed);
+    let r = shape[2u * (base + s) + 1u];
+    let k = joint_stiffness(base, s);
+    let gk = transpose(turn.change) * scaling3(k);
+    let curving = max(-0.25 * dot(k * (turn.v - r.xyz), turn.v), 0.0);
+    return Joint(gk * turn.change, gk * (turn.v - r.xyz), turn.matrix, curving);
+}
+
+fn factor_l(row: u32) -> M6 {
+    let f = row * 14u;
+    return M6(
+        mat3x3<f32>(factors[f].xyz, factors[f + 1u].xyz, factors[f + 2u].xyz),
+        mat3x3<f32>(factors[f + 3u].xyz, factors[f + 4u].xyz, factors[f + 5u].xyz),
+        mat3x3<f32>(factors[f + 6u].xyz, factors[f + 7u].xyz, factors[f + 8u].xyz),
+        mat3x3<f32>(factors[f + 9u].xyz, factors[f + 10u].xyz, factors[f + 11u].xyz),
+    );
+}
+
+fn store_factor(row: u32, l: M6, z: V6) {
+    let f = row * 14u;
+    factors[f] = vec4<f32>(l.a[0], 0.0);
+    factors[f + 1u] = vec4<f32>(l.a[1], 0.0);
+    factors[f + 2u] = vec4<f32>(l.a[2], 0.0);
+    factors[f + 3u] = vec4<f32>(l.b[0], 0.0);
+    factors[f + 4u] = vec4<f32>(l.b[1], 0.0);
+    factors[f + 5u] = vec4<f32>(l.b[2], 0.0);
+    factors[f + 6u] = vec4<f32>(l.c[0], 0.0);
+    factors[f + 7u] = vec4<f32>(l.c[1], 0.0);
+    factors[f + 8u] = vec4<f32>(l.c[2], 0.0);
+    factors[f + 9u] = vec4<f32>(l.d[0], 0.0);
+    factors[f + 10u] = vec4<f32>(l.d[1], 0.0);
+    factors[f + 11u] = vec4<f32>(l.d[2], 0.0);
+    factors[f + 12u] = vec4<f32>(z.w, 0.0);
+    factors[f + 13u] = vec4<f32>(z.v, 0.0);
+}
+
+// Off the head: out to the offset, or as near as the groom has the point,
+// the velocity into it stopped and the sliding slowed by Coulomb friction,
+// relative to the head's surface.
+fn contact(p: vec3<f32>, v: vec3<f32>, groomed: vec3<f32>, from_pose: Pose, to_pose: Pose, h: f32) -> array<vec3<f32>, 2> {
+    if (params.body == 0u) {
+        return array<vec3<f32>, 2>(p, v);
+    }
+    let local = pose_unapply(to_pose, p);
+    let distance_now = head_distance(local);
+    if (distance_now >= params.collision_offset) {
+        return array<vec3<f32>, 2>(p, v);
+    }
+    let offset = min(params.collision_offset, head_distance(groomed));
+    if (distance_now >= offset) {
+        return array<vec3<f32>, 2>(p, v);
+    }
+    let out = push_out(local, offset);
+    let normal = pose_rotate(to_pose, head_gradient(out));
+    let q = pose_apply(to_pose, out);
+    let surface = (q - pose_apply(from_pose, pose_unapply(to_pose, q))) * (1.0 / h);
+    var relative = v - surface;
+    let into = dot(relative, normal);
+    if (into < 0.0) {
+        relative = relative - normal * into;
+        let sliding = length(relative);
+        if (sliding > 1e-9) {
+            relative = relative * max(1.0 - params.head_friction * -into / sliding, 0.0);
+        }
+    }
+    return array<vec3<f32>, 2>(q, relative + surface);
+}
+
+// The angular velocity turning `from_q` to `to_q` in `h` seconds.
+fn spin(from_q: vec4<f32>, to_q: vec4<f32>, h: f32) -> vec3<f32> {
+    var q = qmul(to_q, qconj(from_q));
+    if (q.w < 0.0) {
+        q = -q;
+    }
+    let s = length(q.xyz);
+    if (s < 1e-9) {
+        return q.xyz * (2.0 / h);
+    }
+    return q.xyz * (2.0 * atan2(s, q.w) / (s * h));
+}
+
+fn pose_rotation(q: Pose) -> vec4<f32> {
+    return qfrom_matrix(mat3x3<f32>(q.x, q.y, q.z));
+}
+
+@compute @workgroup_size(32)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    // Thirty-two strands a workgroup: a strand's solve is long and
+    // serial, so the workgroups are spread over as many cores as can be.
+    let g = id.y * groups.x * 32u + id.x;
+    if (g >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let segs = points - 1u;
+    let base = g * points;
+    let h = params.h;
+    let start = Pose(
+        vec3<f32>(params.from_xx, params.from_xy, params.from_xz),
+        vec3<f32>(params.from_yx, params.from_yy, params.from_yz),
+        vec3<f32>(params.from_zx, params.from_zy, params.from_zz),
+        vec3<f32>(params.from_tx, params.from_ty, params.from_tz),
+    );
+    let end = Pose(
+        vec3<f32>(params.ax_x, params.ax_y, params.ax_z),
+        vec3<f32>(params.ay_x, params.ay_y, params.ay_z),
+        vec3<f32>(params.az_x, params.az_y, params.az_z),
+        vec3<f32>(params.tx, params.ty, params.tz),
+    );
+    let gravity = vec3<f32>(0.0, -params.gravity, 0.0);
+    let elastic = h * h;
+    let viscous = h * h + h * params.damping;
+    let identity = identity3();
+    let unbent = scaling3(vec3<f32>(1.0, 1.0, 0.0));
+    let e3 = vec3<f32>(0.0, 0.0, 1.0);
+    // The strands meeting each other moved their points, not their frames:
+    // each frame turned the least way back onto its segment.
+    for (var j = 0u; j < segs; j++) {
+        let q = frame_at(base, j);
+        let along = safe_normalize(position[base + j + 1u].xyz - position[base + j].xyz, qrotate(q, e3));
+        frames[2u * (base + j)] = qnormalize(qmul(least_turn(qrotate(q, e3), along), q));
+    }
+    var h_last = params.h_last;
+    for (var m = 0u; m < params.inner; m++) {
+        let from_pose = pose_blend(start, end, f32(m) / f32(params.inner));
+        let to_pose = pose_blend(start, end, f32(m + 1u) / f32(params.inner));
+        let root_from = pose_apply(from_pose, rest[base].xyz);
+        let root_to = pose_apply(to_pose, rest[base].xyz);
+        let root_velocity = (root_to - root_from) * (1.0 / h);
+        position[base] = vec4<f32>(root_from, 1.0);
+        let head_from = pose_rotation(from_pose);
+        let follicle = qmul(head_from, shape[2u * (base + segs)]);
+        let follicle_spin = qrotate(qconj(follicle), spin(head_from, pose_rotation(to_pose), h));
+        var gust = 1.0;
+        if (params.turbulence > 0.0) {
+            let time = params.time + f32(m) * h;
+            let q = rest[base].xyz * 3.0 + vec3<f32>(time * 0.9, time * 0.4, 0.0);
+            gust = 1.0 + params.turbulence * perlin(q) * 2.0;
+        }
+        let air = vec3<f32>(params.wind_x, params.wind_y, params.wind_z) * gust;
+
+        // Segments g and g + 1, the joints before them, about row g.
+        var seg = segment_at(base, 0u);
+        var joint = joint_at(base, 0u, follicle);
+        var next = no_segment();
+        var after = no_joint();
+        if (segs > 1u) {
+            next = segment_at(base, 1u);
+            after = joint_at(base, 1u, frame_at(base, 0u));
+        }
+        var d_last = m6_zero();
+        var y_last = V6(vec3<f32>(0.0), vec3<f32>(0.0));
+        for (var r = 0u; r < segs; r++) {
+            let i = r + 1u;
+            let mass = point_mass(base, i, segs);
+            let velocity = (position[base + i].xyz - previous[base + i].xyz) * (1.0 / h_last);
+            let spinning = transpose(seg.axes) * frames[2u * (base + r) + 1u].xyz;
+            // The air, across the point's tangent.
+            let tangent = safe_normalize(seg.strain + seg.axes[2] * seg.len + next.strain + next.axes[2] * next.len, seg.axes[2]);
+            let relative = velocity - air;
+            let across = relative - tangent * dot(relative, tangent);
+            let speed = length(across);
+            let c = params.drag * (speed + params.drag_viscous * pow(speed, 1.0 / 3.0));
+            let drag = (identity - outer3(tangent, tangent)) * (mass * c);
+
+            let inertia = scaling3(vec3<f32>(0.25, 0.25, 0.5)) * (rest_length(base, r) * params.gyration);
+            let lever = transpose(skew3(e3)) * transpose(seg.axes) * (seg.len * seg.stiffness);
+            let local_strain = transpose(seg.axes) * seg.strain;
+            let bend = transpose(joint.turn) * joint.stiffness * joint.turn + identity * joint.curving
+                + after.stiffness + identity * after.curving;
+            let torque = cross(e3, local_strain) * (seg.stiffness * seg.len)
+                + transpose(joint.turn) * joint.torque - after.torque;
+            let force = gravity * mass - seg.strain * seg.stiffness + next.strain * next.stiffness;
+            // Turning the frame across its axis: the shear's stiffness and
+            // the tension's along it.
+            let across_axis = seg.len * (seg.len + max(local_strain.z, 0.0));
+            let diagonal = M6(
+                inertia + unbent * (elastic * seg.stiffness * across_axis) + bend * viscous,
+                lever * elastic,
+                transpose(lever) * elastic,
+                identity * (mass + elastic * (seg.stiffness + next.stiffness)) + drag * h,
+            );
+            var left = M6(
+                transpose(joint.turn) * joint.stiffness * -viscous,
+                lever * -elastic,
+                mat3x3<f32>(),
+                identity * -(elastic * seg.stiffness),
+            );
+            var rhs = V6(inertia * spinning + torque * h, velocity * mass + force * h + drag * air * h);
+            if (r == 0u) {
+                let known = m6_apply(left, V6(follicle_spin, root_velocity));
+                rhs = V6(rhs.w - known.w, rhs.v - known.v);
+                left = m6_zero();
+            }
+            let l = m6_mul(left, d_last);
+            let lt = m6_mul(l, m6_transpose(left));
+            let d = M6(diagonal.a - lt.a, diagonal.b - lt.b, diagonal.c - lt.c, diagonal.d - lt.d);
+            let d_inverse = m6_inverse(d);
+            let ly = m6_apply(l, y_last);
+            let y = V6(rhs.w - ly.w, rhs.v - ly.v);
+            store_factor(base + r, l, m6_apply(d_inverse, y));
+            d_last = d_inverse;
+            y_last = y;
+
+            // Along by one.
+            seg = next;
+            joint = after;
+            next = no_segment();
+            after = no_joint();
+            if (r + 2u < segs) {
+                next = segment_at(base, r + 2u);
+                after = joint_at(base, r + 2u, frame_at(base, r + 1u));
+            }
+        }
+
+        // Back up the strand.
+        var later = V6(vec3<f32>(0.0), vec3<f32>(0.0));
+        for (var r = segs; r >= 1u; r--) {
+            let row = r - 1u;
+            let f = (base + row) * 14u;
+            var u = V6(factors[f + 12u].xyz, factors[f + 13u].xyz);
+            if (row + 1u < segs) {
+                let lu = m6_apply(m6_transpose(factor_l(base + row + 1u)), later);
+                u = V6(u.w - lu.w, u.v - lu.v);
+            }
+            later = u;
+            let i = row + 1u;
+            let moved = contact(position[base + i].xyz + u.v * h, u.v, rest[base + i].xyz, from_pose, to_pose, h);
+            position[base + i] = vec4<f32>(moved[0], 1.0);
+            previous[base + i] = vec4<f32>(moved[0] - moved[1] * h, 1.0);
+            let old = frame_at(base, row);
+            let w = qmatrix(old) * u.w;
+            frames[2u * (base + row)] = qnormalize(qmul(qexp(w * h), old));
+            frames[2u * (base + row) + 1u] = vec4<f32>(w, 0.0);
+        }
+        position[base] = vec4<f32>(root_to, 1.0);
+        previous[base] = vec4<f32>(root_from, 1.0);
+        h_last = h;
+    }
+}
+"#,
+    )
+}
diff --git a/crates/fabelgeist-hair/src/grid.rs b/crates/fabelgeist-hair/src/grid.rs
new file mode 100644
index 000000000..2918d213e
--- /dev/null
+++ b/crates/fabelgeist-hair/src/grid.rs
@@ -0,0 +1,189 @@
+//! A hash grid over points, for the nearest-root queries the hair nodes
+//! make: the guides nearest a new strand's root, the clump guide nearest a
+//! strand, whether a root is too close to one already placed.
+//!
+//! Points carry a group; a query sees only the groups its filter accepts,
+//! which is how parting keeps strands from interpolating across a part
+//! (Blender offsets each group's points far apart for the same effect).
+
+use crate::identity::PartingGroup;
+use std::collections::HashMap;
+
+use fabelgeist_math::Vec3;
+
+pub struct PointGrid {
+    cell: f32,
+    cells: HashMap<[i32; 3], Vec<u32>>,
+    points: Vec<(Vec3, PartingGroup)>,
+}
+
+impl PointGrid {
+    pub fn new(cell: f32) -> Self {
+        Self {
+            cell: cell.max(1e-6),
+            cells: HashMap::new(),
+            points: Vec::new(),
+        }
+    }
+
+    /// A grid over `points`, sized so a cell holds a few of them.
+    pub fn build(points: &[(Vec3, PartingGroup)], cell: f32) -> Self {
+        let mut grid = Self::new(cell);
+        for &(p, g) in points {
+            grid.insert(p, g);
+        }
+        grid
+    }
+
+    fn key(&self, p: Vec3) -> [i32; 3] {
+        [p.x, p.y, p.z].map(|v| (v / self.cell).floor() as i32)
+    }
+
+    /// Add a point; returns its index.
+    pub fn insert(&mut self, p: Vec3, group: PartingGroup) -> u32 {
+        let index = self.points.len() as u32;
+        self.points.push((p, group));
+        let key = self.key(p);
+        self.cells.entry(key).or_default().push(index);
+        index
+    }
+
+    pub fn len(&self) -> usize {
+        self.points.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.points.is_empty()
+    }
+
+    pub fn point(&self, index: u32) -> Vec3 {
+        self.points[index as usize].0
+    }
+
+    /// Visit every point in the cells within `ring` cells of `p`'s.
+    fn visit_shell(&self, p: Vec3, ring: i32, mut visit: impl FnMut(u32)) {
+        let c = self.key(p);
+        for dz in -ring..=ring {
+            for dy in -ring..=ring {
+                for dx in -ring..=ring {
+                    if dx.abs().max(dy.abs()).max(dz.abs()) != ring {
+                        continue;
+                    }
+                    if let Some(list) = self.cells.get(&[c[0] + dx, c[1] + dy, c[2] + dz]) {
+                        list.iter().for_each(|&i| visit(i));
+                    }
+                }
+            }
+        }
+    }
+
+    /// Whether any accepted point lies within `radius` of `p`.
+    pub fn any_within(&self, p: Vec3, radius: f32, accept: impl Fn(PartingGroup) -> bool) -> bool {
+        let rings = (radius / self.cell).ceil() as i32;
+        let r2 = radius * radius;
+        for ring in 0..=rings {
+            let mut hit = false;
+            self.visit_shell(p, ring, |i| {
+                let (q, g) = self.points[i as usize];
+                if !hit && accept(g) && (q - p).length_squared() < r2 {
+                    hit = true;
+                }
+            });
+            if hit {
+                return true;
+            }
+        }
+        false
+    }
+
+    /// How many points lie within `radius` of `p`.
+    pub fn count_within(&self, p: Vec3, radius: f32) -> usize {
+        let rings = (radius / self.cell).ceil() as i32;
+        let mut count = 0;
+        for ring in 0..=rings {
+            self.visit_shell(p, ring, |i| {
+                if (self.points[i as usize].0 - p).length() <= radius {
+                    count += 1;
+                }
+            });
+        }
+        count
+    }
+
+    /// The `k` accepted points nearest `p`, nearest first, searching no
+    /// further than `max_radius`. Distances are Euclidean.
+    pub fn nearest_k(
+        &self,
+        p: Vec3,
+        k: usize,
+        max_radius: f32,
+        accept: impl Fn(PartingGroup) -> bool,
+    ) -> Vec<(u32, f32)> {
+        let mut found: Vec<(u32, f32)> = Vec::with_capacity(k + 8);
+        let max_rings = (max_radius / self.cell).ceil().min(1e6) as i32;
+        for ring in 0..=max_rings {
+            self.visit_shell(p, ring, |i| {
+                let (q, g) = self.points[i as usize];
+                if accept(g) {
+                    found.push((i, (q - p).length()));
+                }
+            });
+            // Every point outside the searched rings is at least `ring *
+            // cell` away; once k are nearer than that, the search is done.
+            if found.len() >= k {
+                found.sort_by(|a, b| a.1.total_cmp(&b.1));
+                if found[k - 1].1 <= ring as f32 * self.cell {
+                    found.truncate(k);
+                    return found;
+                }
+            }
+        }
+        found.sort_by(|a, b| a.1.total_cmp(&b.1));
+        found.retain(|f| f.1 <= max_radius);
+        found.truncate(k);
+        found
+    }
+
+    pub fn nearest(
+        &self,
+        p: Vec3,
+        max_radius: f32,
+        accept: impl Fn(PartingGroup) -> bool,
+    ) -> Option<(u32, f32)> {
+        self.nearest_k(p, 1, max_radius, accept).first().copied()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::rng::Rng;
+
+    #[test]
+    fn nearest_k_matches_brute_force() {
+        let mut rng = Rng::new(3);
+        let points: Vec<(Vec3, PartingGroup)> = (0..500)
+            .map(|i| {
+                (
+                    Vec3::new(rng.next_f32(), rng.next_f32(), rng.next_f32() * 0.1),
+                    PartingGroup::from_gpu_word(i % 2),
+                )
+            })
+            .collect();
+        let grid = PointGrid::build(&points, 0.05);
+        for _ in 0..50 {
+            let q = Vec3::new(rng.next_f32(), rng.next_f32(), 0.05);
+            let got = grid.nearest_k(q, 4, 10.0, |g| g == PartingGroup::from_gpu_word(1));
+            let mut brute: Vec<(u32, f32)> = points
+                .iter()
+                .enumerate()
+                .filter(|(_, (_, g))| *g == PartingGroup::from_gpu_word(1))
+                .map(|(i, (p, _))| (i as u32, (*p - q).length()))
+                .collect();
+            brute.sort_by(|a, b| a.1.total_cmp(&b.1));
+            let got: Vec<u32> = got.iter().map(|g| g.0).collect();
+            let want: Vec<u32> = brute[..4].iter().map(|g| g.0).collect();
+            assert_eq!(got, want);
+        }
+    }
+}
diff --git a/crates/fabelgeist-hair/src/groom.rs b/crates/fabelgeist-hair/src/groom.rs
new file mode 100644
index 000000000..394134ff7
--- /dev/null
+++ b/crates/fabelgeist-hair/src/groom.rs
@@ -0,0 +1,79 @@
+//! A groom: the stack of operations that turns guides into hair.
+
+use serde::{Deserialize, Serialize};
+use web_time::Instant;
+
+use crate::ops::{Context, Op};
+use crate::strands::Strands;
+
+/// A stack of operations and the resolution they run at -- the recipe of
+/// one hairstyle, as a Blender object's modifier stack of hair node groups
+/// is. Serialises to JSON, so a dataset sample records exactly how it was
+/// made.
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+pub struct Groom {
+    /// Points per strand. DiffLocks' strands have 256; tight curls need
+    /// about eight a turn.
+    pub points: usize,
+    pub ops: Vec<Op>,
+}
+
+/// How long each operation took.
+#[derive(Clone, Debug, Default)]
+pub struct GrowReport {
+    pub steps: Vec<(&'static str, f32, usize)>,
+}
+
+impl GrowReport {
+    pub fn total_ms(&self) -> f32 {
+        self.steps.iter().map(|s| s.1).sum()
+    }
+}
+
+impl std::fmt::Display for GrowReport {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        for (name, ms, strands) in &self.steps {
+            writeln!(f, "{name:>12}: {ms:8.1} ms  ({strands} strands)")?;
+        }
+        write!(f, "{:>12}: {:8.1} ms", "total", self.total_ms())
+    }
+}
+
+impl Groom {
+    /// Run the stack over `guides`: they are resampled to the groom's point
+    /// count, and every operation applied in order.
+    pub fn grow(&self, guides: &Strands, context: &Context) -> Strands {
+        self.grow_reporting(guides, context).0
+    }
+
+    pub fn grow_reporting(&self, guides: &Strands, context: &Context) -> (Strands, GrowReport) {
+        self.grow_while(guides, context, || true)
+            .expect("never stopped")
+    }
+
+    /// Grow, asking `keep_going` before every operation: `None` if it
+    /// said to stop -- the groom is no longer wanted, and the rest of the
+    /// stack need not run.
+    pub fn grow_while(
+        &self,
+        guides: &Strands,
+        context: &Context,
+        keep_going: impl Fn() -> bool,
+    ) -> Option<(Strands, GrowReport)> {
+        let mut strands = guides.resampled(self.points.max(2));
+        let mut report = GrowReport::default();
+        for op in &self.ops {
+            if !keep_going() {
+                return None;
+            }
+            let started = Instant::now();
+            op.apply(&mut strands, context);
+            report.steps.push((
+                op.name(),
+                started.elapsed().as_secs_f32() * 1e3,
+                strands.len(),
+            ));
+        }
+        Some((strands, report))
+    }
+}
diff --git a/crates/fabelgeist-hair/src/haircut.rs b/crates/fabelgeist-hair/src/haircut.rs
new file mode 100644
index 000000000..2f1577943
--- /dev/null
+++ b/crates/fabelgeist-hair/src/haircut.rs
@@ -0,0 +1,409 @@
+//! Haircuts: how long the hair is, everywhere on the head, and where its
+//! ends are cut.
+//!
+//! A cut is the same whatever the hair then does -- a bob is a bob parted,
+//! swept back or tied -- so it is kept apart from the style
+//! ([`crate::Hairstyle`]). [`Haircut`] gives a length for every follicle,
+//! from the lengths at the top, the front hairline, over the ears and at the
+//! back, and then what a hairdresser does to that:
+//!
+//! * a **hemline**, the line the ends are cut straight along, level or
+//!   sloping down towards the face (an A-line) or away from it;
+//! * **clippers** up the back and sides to a height, with a hard line (an
+//!   undercut) or a fade;
+//! * a **strip** down the middle kept long and the rest clipped (a mohawk);
+//! * a **fringe**, the front cut to the brows;
+//! * a **dome**, the ends cut round to a sphere (an afro's shape).
+//!
+//! [`Cut`] names the usual cuts; [`Haircut::new`] makes one, whose numbers
+//! are then free to change.
+
+use serde::{Deserialize, Serialize};
+
+use crate::head::{Head, around};
+use crate::ops::smoothstep;
+use fabelgeist_math::Vec3;
+
+/// The usual cuts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Cut {
+    /// One length, well past the shoulders.
+    Long,
+    /// One length to the shoulders.
+    Shoulder,
+    /// Long, the top and front cut shorter in layers.
+    Layered,
+    /// Shoulder length, heavily layered, the front shortest.
+    Shag,
+    /// One length to the collar.
+    Collar,
+    /// To the jaw, one length.
+    Bob,
+    /// A bob longer in front than behind.
+    AngledBob,
+    /// Straight all round at the brow, a fringe in front.
+    BowlCut,
+    /// Short, a little longer on top.
+    Pixie,
+    /// A few centimetres all over.
+    Crop,
+    /// Clipped back and sides under a longer top, faded.
+    ShortBackAndSides,
+    /// Clipped back and sides to a hard line under a long top.
+    Undercut,
+    /// Clipped almost to the skin low, growing longer up the head.
+    Fade,
+    /// A strip down the middle, the rest clipped.
+    Mohawk,
+    /// Clipped close all over.
+    Buzz,
+    /// The ends cut round to a dome.
+    Rounded,
+}
+
+impl Cut {
+    pub const ALL: [Cut; 16] = [
+        Cut::Long,
+        Cut::Shoulder,
+        Cut::Layered,
+        Cut::Shag,
+        Cut::Collar,
+        Cut::Bob,
+        Cut::AngledBob,
+        Cut::BowlCut,
+        Cut::Pixie,
+        Cut::Crop,
+        Cut::ShortBackAndSides,
+        Cut::Undercut,
+        Cut::Fade,
+        Cut::Mohawk,
+        Cut::Buzz,
+        Cut::Rounded,
+    ];
+
+    pub const fn name(self) -> &'static str {
+        match self {
+            Cut::Long => "Long",
+            Cut::Shoulder => "Shoulder length",
+            Cut::Layered => "Long layers",
+            Cut::Shag => "Shag",
+            Cut::Collar => "Collar length",
+            Cut::Bob => "Bob",
+            Cut::AngledBob => "Angled bob",
+            Cut::BowlCut => "Bowl cut",
+            Cut::Pixie => "Pixie",
+            Cut::Crop => "Crop",
+            Cut::ShortBackAndSides => "Short back and sides",
+            Cut::Undercut => "Undercut",
+            Cut::Fade => "Fade",
+            Cut::Mohawk => "Mohawk",
+            Cut::Buzz => "Buzz",
+            Cut::Rounded => "Rounded",
+        }
+    }
+}
+
+/// A fringe: the front of the scalp cut short, to hang over the forehead.
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Fringe {
+    /// Half its width, metres.
+    pub width: f32,
+    /// How far back from the front of the head it reaches, metres.
+    pub depth: f32,
+    /// How far below the front hairline its ends are, metres (about 5 cm
+    /// is the brows).
+    pub drop: f32,
+}
+
+impl Default for Fringe {
+    fn default() -> Self {
+        Self {
+            width: 0.066,
+            depth: 0.07,
+            drop: 0.048,
+        }
+    }
+}
+
+impl Fringe {
+    /// Whether a root belongs to the fringe.
+    pub fn holds(&self, root: Vec3) -> bool {
+        root.z > FRONT - self.depth && root.x.abs() < self.width
+    }
+
+    /// The `z` behind which the fringe ends.
+    pub fn back(&self) -> f32 {
+        FRONT - self.depth
+    }
+}
+
+/// About where the front of the head is, `z`.
+const FRONT: f32 = 0.1;
+
+/// A haircut: a length for every follicle, and where the ends are cut.
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Haircut {
+    /// The cut this one started from.
+    pub cut: Cut,
+    /// Lengths, metres: at the top, at the front hairline, over the ears
+    /// and at the back.
+    pub top: f32,
+    pub front: f32,
+    pub sides: f32,
+    pub back: f32,
+    /// The height the ends are cut straight along behind, `y` metres, if
+    /// they are.
+    pub hemline: Option<f32>,
+    /// How much lower the hemline is a metre towards the face: positive is
+    /// an A-line, longer in front.
+    pub slope: f32,
+    /// Clippers up to this height on the scalp (0 the hairline, 1 the
+    /// crown); below it hair is `clipper` long. The change takes `fade` of
+    /// the height: 0 is a hard line.
+    pub clip: f32,
+    pub clipper: f32,
+    pub fade: f32,
+    /// A strip this wide either side of the middle kept long, the rest
+    /// clipped, metres (0: none).
+    pub strip: f32,
+    pub fringe: Option<Fringe>,
+    /// The ends cut to a dome this far from the head's centre, metres (0:
+    /// none).
+    pub dome: f32,
+}
+
+impl Haircut {
+    pub fn new(cut: Cut) -> Self {
+        let long = Self {
+            cut,
+            top: 0.45,
+            front: 0.4,
+            sides: 0.43,
+            back: 0.45,
+            hemline: None,
+            slope: 0.0,
+            clip: 0.0,
+            clipper: 0.006,
+            fade: 0.0,
+            strip: 0.0,
+            fringe: None,
+            dome: 0.0,
+        };
+        let short = |top: f32, front: f32, sides: f32, back: f32| Self {
+            top,
+            front,
+            sides,
+            back,
+            ..long
+        };
+        match cut {
+            Cut::Long => Self {
+                hemline: Some(-0.45),
+                ..long
+            },
+            Cut::Shoulder => Self {
+                top: 0.32,
+                front: 0.26,
+                sides: 0.3,
+                back: 0.32,
+                hemline: Some(-0.27),
+                ..long
+            },
+            Cut::Layered => Self {
+                top: 0.24,
+                front: 0.2,
+                sides: 0.34,
+                back: 0.45,
+                hemline: Some(-0.4),
+                ..long
+            },
+            Cut::Shag => Self {
+                top: 0.2,
+                front: 0.15,
+                sides: 0.24,
+                back: 0.3,
+                hemline: Some(-0.24),
+                ..long
+            },
+            Cut::Collar => Self {
+                top: 0.2,
+                front: 0.2,
+                sides: 0.2,
+                back: 0.2,
+                hemline: Some(-0.12),
+                ..long
+            },
+            Cut::Bob => Self {
+                top: 0.26,
+                front: 0.2,
+                sides: 0.23,
+                back: 0.26,
+                hemline: Some(-0.09),
+                ..long
+            },
+            Cut::AngledBob => Self {
+                top: 0.28,
+                front: 0.24,
+                sides: 0.26,
+                back: 0.26,
+                hemline: Some(-0.06),
+                slope: 0.45,
+                ..long
+            },
+            Cut::BowlCut => Self {
+                top: 0.16,
+                front: 0.13,
+                sides: 0.15,
+                back: 0.16,
+                hemline: Some(-0.01),
+                fringe: Some(Fringe::default()),
+                ..long
+            },
+            Cut::Pixie => short(0.08, 0.11, 0.05, 0.05),
+            Cut::Crop => short(0.045, 0.04, 0.035, 0.04),
+            Cut::ShortBackAndSides => Self {
+                clip: 0.45,
+                clipper: 0.012,
+                fade: 0.12,
+                ..short(0.1, 0.12, 0.08, 0.08)
+            },
+            Cut::Undercut => Self {
+                clip: 0.5,
+                clipper: 0.008,
+                ..short(0.14, 0.15, 0.14, 0.14)
+            },
+            Cut::Fade => Self {
+                clip: 0.55,
+                clipper: 0.001,
+                fade: 0.45,
+                ..short(0.06, 0.07, 0.05, 0.05)
+            },
+            Cut::Mohawk => Self {
+                strip: 0.022,
+                clipper: 0.006,
+                ..short(0.12, 0.1, 0.12, 0.12)
+            },
+            Cut::Buzz => short(0.009, 0.007, 0.008, 0.009),
+            Cut::Rounded => Self {
+                dome: 0.18,
+                ..short(0.14, 0.1, 0.12, 0.12)
+            },
+        }
+    }
+
+    /// The cut, every length times `factor`, the hemline as far from the
+    /// crown as the hair is long.
+    pub fn scaled(mut self, factor: f32) -> Self {
+        for length in [
+            &mut self.top,
+            &mut self.front,
+            &mut self.sides,
+            &mut self.back,
+        ] {
+            *length *= factor;
+        }
+        let crown = 0.115;
+        self.hemline = self.hemline.map(|y| crown - (crown - y) * factor);
+        self.dome = if self.dome > 0.0 {
+            0.09 + (self.dome - 0.09) * factor
+        } else {
+            0.0
+        };
+        self
+    }
+
+    /// The longest hair anywhere, metres.
+    pub fn longest(&self) -> f32 {
+        self.top.max(self.front).max(self.sides).max(self.back)
+    }
+
+    /// Whether a root is clipped short (under the clippers, or outside a
+    /// mohawk's strip).
+    pub fn clipped(&self, head: &Head, root: Vec3) -> bool {
+        (self.clip > 0.0 && head.elevation(root) < self.clip - 0.5 * self.fade)
+            || (self.strip > 0.0 && root.x.abs() > self.strip)
+    }
+
+    /// Whether a root is in the fringe.
+    pub fn in_fringe(&self, root: Vec3) -> bool {
+        self.fringe.is_some_and(|f| f.holds(root))
+    }
+
+    /// How long the hair rooted at `root` is, metres (before any hemline
+    /// or dome).
+    pub fn length(&self, head: &Head, root: Vec3) -> f32 {
+        if let Some(fringe) = self.fringe
+            && fringe.holds(root)
+        {
+            // Long enough to reach the fringe's line.
+            return 0.1 + fringe.drop;
+        }
+        let e = head.elevation(root);
+        let a = head.azimuth(root);
+        // Round the head by where the root is near the hairline, the top's
+        // length towards the crown.
+        let ring = around(self.front, self.sides, self.back, a);
+        let mut length = ring + (self.top - ring) * smoothstep(0.25, 0.85, e);
+        if self.clip > 0.0 {
+            let half = 0.5 * self.fade + 1e-3;
+            let t = smoothstep(self.clip - half, self.clip + half, e);
+            length = self.clipper + (length - self.clipper) * t;
+        }
+        if self.strip > 0.0 {
+            // Clipped outside the strip, the full length a little inside.
+            let t = 1.0 - smoothstep(self.strip - 0.006, self.strip, root.x.abs());
+            length = self.clipper + (length - self.clipper) * t;
+        }
+        length.max(0.0005)
+    }
+
+    /// The height a strand rooted at `root` is cut at where it is at `p`,
+    /// if it is cut on a line: the fringe's line for the fringe, the
+    /// hemline for the rest.
+    pub fn line(&self, head: &Head, root: Vec3, p: Vec3) -> Option<f32> {
+        if let Some(fringe) = self.fringe
+            && fringe.holds(root)
+        {
+            return Some(head.hairline_height(0.0) - fringe.drop);
+        }
+        self.hemline.map(|y| y - self.slope * p.z)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn clippers_cut_the_sides_and_leave_the_top() {
+        let head = Head::mannequin();
+        let cut = Haircut::new(Cut::Undercut);
+        let side = head.cranium.center + Vec3::new(head.cranium.radii.x, 0.0, 0.0);
+        let top = head.crown();
+        assert!(cut.length(&head, side) < 0.01);
+        assert!(cut.length(&head, top) > 0.1);
+        assert!(cut.clipped(&head, side) && !cut.clipped(&head, top));
+    }
+
+    #[test]
+    fn an_angled_bob_is_longer_in_front() {
+        let head = Head::mannequin();
+        let cut = Haircut::new(Cut::AngledBob);
+        let root = head.crown();
+        let front = cut.line(&head, root, Vec3::new(0.0, 0.0, 0.08)).unwrap();
+        let back = cut.line(&head, root, Vec3::new(0.0, 0.0, -0.08)).unwrap();
+        assert!(front < back - 0.05);
+    }
+
+    #[test]
+    fn scaling_keeps_every_cut_positive() {
+        let head = Head::mannequin();
+        for cut in Cut::ALL {
+            let haircut = Haircut::new(cut).scaled(0.7);
+            for p in [head.crown(), Vec3::new(0.07, 0.03, 0.0)] {
+                assert!(haircut.length(&head, p) > 0.0, "{cut:?}");
+            }
+        }
+    }
+}
diff --git a/crates/fabelgeist-hair/src/hairdo.rs b/crates/fabelgeist-hair/src/hairdo.rs
new file mode 100644
index 000000000..3949e0448
--- /dev/null
+++ b/crates/fabelgeist-hair/src/hairdo.rs
@@ -0,0 +1,710 @@
+//! A hairdo: follicles, a cut and a style, and the guides they grow.
+//!
+//! DiffLocks' artists drew 75 base hairstyles by hand in Blender, each about
+//! fifty guide strands giving only "the overall shape and direction of the
+//! hair"; the randomisation adds everything else. Those guides are not
+//! published. Here a base style is three independent choices -- the
+//! [`Follicles`] (which way hair grows), the [`Haircut`] (how long it is)
+//! and the [`Hairstyle`] (how it is combed) -- and every guide is grown as a
+//! strand of hair would lie:
+//!
+//! * **Out of the scalp.** A strand leaves its follicle the way it is
+//!   combed, at the follicle's angle to the scalp (lifted as the style lifts
+//!   it), and rises over a few centimetres to its layer: the hair under it.
+//!   (Which way the follicle itself points shows in the first centimetre of
+//!   every strand, [`crate::ops::Orient`], and in how hair lies where the
+//!   style leaves it as it grows.) Hair rooted higher up -- nearer the part
+//!   or the crown -- lies over hair rooted lower down, so the layer's height
+//!   grows from nothing at the hairline to the style's volume at the top.
+//! * **On the head.** Lying on its layer, a strand follows the style's comb
+//!   (away from a part, back, forward, to a tie, or as it grows), turned
+//!   into the layer's tangent plane, and slides downhill as much as the
+//!   hair still to come weighs on it: long hair on the side of the head
+//!   runs down it, short hair keeps the way it was combed. In front of the
+//!   face, hair keeps to its comb until it is past the face.
+//! * **Off the head.** Free -- past the head's widest, or lifted off it -- a
+//!   strand is a cantilever: gravity bends it with the curvature a rod's own
+//!   weight gives, `(L - s)^2 / (2 L_g^3)` for `L - s` of it still to come
+//!   and `L_g` the style's hold (about 5 cm for a strand, more for a styled
+//!   or curly lock). Long hair drops straight down where it leaves the
+//!   head; short hair stands out.
+//! * **Cut.** A strand is as long as the cut makes hair at its root, and
+//!   ends where it crosses the cut's line (the hemline, or a fringe's line
+//!   at the brows) or the cut's dome.
+//! * **Ties.** A ponytail's, bun's or braid's strands run over the scalp to
+//!   the tie, then become the tail, the coil or one of the braid's three
+//!   lanes.
+
+use crate::identity::PartingGroup;
+use crate::identity::StrandId;
+use fabelgeist_math::Vec3;
+use rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::follicles::{Follicles, GrowthField};
+use crate::grid::PointGrid;
+use crate::haircut::Haircut;
+use crate::hairstyle::{Arrangement, Hairstyle};
+use crate::head::Head;
+use crate::ops::{Parting, smoothstep};
+use crate::rng::{self, Stream};
+use crate::strands::{Attachment, Strands, resample_into, rotate, safe_normalize};
+use crate::surface::Surface;
+
+mod tied;
+pub(crate) use tied::Tied;
+
+/// Follicles, a cut and a style: everything that shapes the guides.
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Hairdo {
+    pub follicles: Follicles,
+    pub haircut: Haircut,
+    pub hairstyle: Hairstyle,
+}
+
+/// Which way the comb runs.
+#[derive(Clone, Copy, Debug)]
+enum Flow {
+    /// As the hair grows.
+    Natural,
+    /// Away from a part at `x`.
+    Part(f32),
+    /// Swept over to one side (`+1` or `-1`) from a deep part.
+    Swept(f32),
+    Back,
+    Forward,
+    /// Out from the head's centre.
+    Radial,
+    /// Down, round the head: hair with no part.
+    Down,
+    /// Over the scalp to a tie, then as the tie has it.
+    Tie(Tie),
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Tie {
+    Tail,
+    Bun,
+    Braid,
+}
+
+impl Hairdo {
+    /// `base` with the follicles' hairline: the head to grow this hairdo
+    /// on, and to cut its scalp from.
+    pub fn head(&self, base: &Head) -> Head {
+        self.follicles.head(base)
+    }
+
+    /// Whether the cut's fringe hangs over the forehead: it does unless
+    /// the style combs it back or up.
+    pub fn fringe_falls(&self) -> bool {
+        self.haircut.fringe.is_some()
+            && !matches!(
+                self.hairstyle.arrangement,
+                Arrangement::Back | Arrangement::Up
+            )
+    }
+
+    /// Whether the hair stands out from the head rather than lying on it:
+    /// its shape follows each root's own normal all the way.
+    pub fn stands(&self) -> bool {
+        self.hairstyle.stands()
+    }
+
+    /// Whether the hair hangs free, and so is draped. Tied hair is held at
+    /// its tie, and styled hair by its product, which the drape knows
+    /// nothing of.
+    pub fn drapes(&self) -> bool {
+        matches!(
+            self.hairstyle.arrangement,
+            Arrangement::Natural
+                | Arrangement::Parted
+                | Arrangement::Swept
+                | Arrangement::Forward
+                | Arrangement::Down
+        ) && self.haircut.longest() > 0.2
+            && self.haircut.dome == 0.0
+    }
+
+    /// How interpolation should keep strands apart: a braid's three lanes,
+    /// a fringe from the rest, or either side of a part.
+    pub fn parting(&self) -> Parting {
+        if self.hairstyle.arrangement == Arrangement::Braid {
+            return Parting::Lanes { count: 3 };
+        }
+        if self.fringe_falls()
+            && let Some(fringe) = self.haircut.fringe
+        {
+            return Parting::Fringe {
+                front: fringe.back(),
+                half_width: fringe.width,
+            };
+        }
+        match self.hairstyle.arrangement {
+            Arrangement::Parted | Arrangement::Swept => Parting::line(self.hairstyle.part, -0.03),
+            _ => Parting::None,
+        }
+    }
+
+    fn flow(&self) -> Flow {
+        let style = &self.hairstyle;
+        match style.arrangement {
+            Arrangement::Natural => Flow::Natural,
+            Arrangement::Parted => Flow::Part(style.part),
+            Arrangement::Swept => Flow::Swept(style.sweep()),
+            Arrangement::Back => Flow::Back,
+            Arrangement::Forward => Flow::Forward,
+            Arrangement::Down => Flow::Down,
+            Arrangement::Up => Flow::Radial,
+            Arrangement::Ponytail => Flow::Tie(Tie::Tail),
+            Arrangement::Bun => Flow::Tie(Tie::Bun),
+            Arrangement::Braid => Flow::Tie(Tie::Braid),
+        }
+    }
+
+    /// How many guides to place, before the row along the hairline.
+    pub(crate) fn guide_count(&self) -> usize {
+        if self.haircut.dome > 0.0 {
+            160
+        } else if self.haircut.longest() < 0.02 {
+            140
+        } else {
+            110
+        }
+    }
+
+    /// The guides on `head` (the hairdo's own, [`Hairdo::head`]), rooted on
+    /// `scalp`, `points` points each. `variation` (0 to 1) jitters their
+    /// lengths and directions.
+    pub fn guides(
+        &self,
+        head: &Head,
+        scalp: &Surface,
+        points: usize,
+        variation: f32,
+        seed: u64,
+    ) -> Strands {
+        let count = self.guide_count();
+        let key = guide_key(seed);
+        let spacing = guide_spacing(scalp.area(), count);
+        let mut placed = PointGrid::new(spacing);
+        let mut roots = Vec::new();
+        // Candidates drawn by index, so the GPU draws the same ones.
+        let [a, u, v] = [1, 2, 3].map(|k| rng::hash(key, k));
+        for i in 0..(count * 40) as u32 {
+            if roots.len() >= count {
+                break;
+            }
+            let p = scalp.sample_at(rng::unit(i, a), rng::unit(i, u), rng::unit(i, v));
+            if placed.any_within(p.position, spacing, |_| true) {
+                continue;
+            }
+            placed.insert(p.position, PartingGroup::from_gpu_word(0));
+            roots.push(p);
+        }
+        // And a row along the hairline, closer together. The hairline is
+        // where hair is seen most and where combing turns most -- aside at
+        // the temples, down at the nape -- and a strand rooted there takes
+        // its shape from the guides nearest it: from a guide centimetres up
+        // the head it would hang across the face.
+        let edge_spacing = edge_spacing(spacing);
+        let mut edge = PointGrid::new(edge_spacing);
+        for p in scalp.boundary(0.002) {
+            if edge.any_within(p, edge_spacing, |_| true)
+                || placed.any_within(p, 0.5 * spacing, |_| true)
+            {
+                continue;
+            }
+            // Just inside the edge, on the scalp.
+            let Some(on) = scalp.closest(p, 0.01) else {
+                continue;
+            };
+            edge.insert(p, PartingGroup::from_gpu_word(0));
+            roots.push(on);
+        }
+        let parting = self.parting();
+        let field = self.follicles.field(head);
+        let tie = Tied::new(head, self);
+        // Every guide on its own, in parallel, each with its own random
+        // numbers.
+        let paths: Vec<Vec<Vec3>> = roots
+            .par_iter()
+            .enumerate()
+            .map(|(i, root)| {
+                let mut rng = Stream::new(comb_key(key, i as u32));
+                let path = self.comb(
+                    head,
+                    &field,
+                    &parting,
+                    tie.as_ref(),
+                    root.position,
+                    root.normal,
+                    &mut rng,
+                    variation,
+                );
+                let mut positions = vec![Vec3::default(); points];
+                resample_into(&path, &mut Vec::new(), &mut positions);
+                positions
+            })
+            .collect();
+        let mut strands = Strands::with_capacity(points, roots.len());
+        for (i, (root, positions)) in roots.iter().zip(&paths).enumerate() {
+            strands.push(
+                positions,
+                Attachment {
+                    uv: root.uv,
+                    normal: root.normal,
+                    id: StrandId::from_word(rng::hash(i as u32, 0x006D_1DE5)),
+                    group: parting.group(root.position),
+                    radius: self.follicles.radius,
+                },
+            );
+        }
+        strands
+    }
+
+    /// Grow one guide: a polyline from `root`, in steps of a millimetre or
+    /// two.
+    #[allow(clippy::too_many_arguments)]
+    fn comb(
+        &self,
+        head: &Head,
+        field: &GrowthField,
+        parting: &Parting,
+        tie: Option<&Tied>,
+        root: Vec3,
+        normal: Vec3,
+        rng: &mut Stream,
+        variation: f32,
+    ) -> Vec<Vec3> {
+        let (follicles, cut, style) = (&self.follicles, &self.haircut, &self.hairstyle);
+        let elevation = head.elevation(root);
+        let azimuth = head.azimuth(root);
+        let frontness = smoothstep(0.3, 0.95, azimuth.cos()) * (1.0 - elevation).powf(0.5);
+
+        // The follicle: which way it points and at what angle.
+        let spread = follicles.direction_spread * rng.gaussian().clamp(-2.5, 2.5);
+        let grows = rotate(field.direction(root, normal), normal, spread);
+        let follicle_angle =
+            follicles.angle + follicles.angle_spread * rng.gaussian().clamp(-2.5, 2.5);
+
+        let mut flow = self.flow();
+        let mut stiffness = style.hold;
+        let mut angle = follicle_angle + style.lift;
+        let mut length = cut.length(head, root);
+        let mut tuck = style.tuck;
+        let fringed = cut.in_fringe(root) && self.fringe_falls();
+        if fringed {
+            // A fringe is combed down over the forehead.
+            flow = Flow::Forward;
+            stiffness = 0.06;
+            tuck = 0.0;
+        } else if cut.clipped(head, root) {
+            // Clipped hair lies as it grows.
+            flow = Flow::Natural;
+            angle = follicle_angle;
+            stiffness = 1.0;
+            tuck = 0.0;
+        }
+        let angle = angle.clamp(0.05, 1.5);
+        length *= 1.0 + variation * 0.12 * rng.gaussian().clamp(-2.0, 2.0);
+        let wander =
+            Vec3::new(rng.gaussian(), rng.gaussian() * 0.3, rng.gaussian()) * (0.12 * variation);
+
+        // The layer this strand lies on, and how far it takes to rise to it.
+        let layer = if matches!(flow, Flow::Radial) {
+            0.0
+        } else {
+            style.volume * elevation.powf(0.7)
+        };
+        let floor = 0.0008;
+        let rise = (layer / angle.tan().max(0.05)).max(0.01);
+        // The face, from the head itself: skin below the hairline that faces
+        // forward, near enough to lie on. No hair grows there, so hair over
+        // it has none beneath: a fringe lies a few millimetres off it (a
+        // little more for some strands, so it has body), not on the layer it
+        // came from.
+        let fringe_gap = 0.005 + 0.004 * rng.next_f32();
+        let over_face = |p: Vec3| {
+            head.above_hairline(p) < 0.0 && head.distance(p) < 0.03 && head.gradient(p).z > 0.35
+        };
+        let height = |p: Vec3, s: f32| {
+            let own = layer * smoothstep(0.0, rise, s) + floor;
+            if over_face(p) {
+                own.min(fringe_gap)
+            } else {
+                own
+            }
+        };
+
+        let part_side = |x: f32| if root.x - x >= 0.0 { 1.0 } else { -1.0 };
+        // Down and round the head; at the front, aside and back from the
+        // face.
+        let down_at = |p: Vec3| {
+            let outward = safe_normalize(p - head.cranium.center, Vec3::up());
+            if p.z > 0.0 {
+                let side = if root.x >= 0.0 { 1.0 } else { -1.0 };
+                Vec3::new(side, -0.2, -0.6)
+            } else {
+                Vec3::new(outward.x, -0.6, outward.z - 0.3)
+            }
+        };
+        // Long hair left as it grows, or combed forward, does not stay
+        // that way: it falls round the head, clear of the face, as its
+        // own weight takes it.
+        let falls = if fringed || !matches!(flow, Flow::Natural | Flow::Forward) {
+            0.0
+        } else {
+            0.85 * smoothstep(0.12, 0.3, length)
+        };
+        let flow_at = |p: Vec3| -> Vec3 {
+            let outward = safe_normalize(p - head.cranium.center, Vec3::up());
+            let own = |v: Vec3| {
+                safe_normalize(v, Vec3::down()) * (1.0 - falls)
+                    + safe_normalize(down_at(p), Vec3::down()) * falls
+            };
+            match flow {
+                Flow::Natural => own(field.direction(p, head.gradient(p))),
+                Flow::Part(x) => Vec3::new(
+                    part_side(x) * (0.8 + 0.6 * frontness),
+                    -0.1,
+                    -0.35 * (1.0 - frontness),
+                ),
+                // Over to the swept side, and down the other from beyond the part.
+                Flow::Swept(side) => {
+                    let side = if (root.x - style.part) * side < 0.0 {
+                        -side
+                    } else {
+                        side
+                    };
+                    Vec3::new(side, -0.05, 0.1 * (1.0 - elevation))
+                }
+                Flow::Back => Vec3::new(0.0, -0.05, -1.0),
+                Flow::Forward => own(Vec3::new(0.0, -0.3, 1.0)),
+                Flow::Radial => outward,
+                Flow::Down => down_at(p),
+                Flow::Tie(_) => tie.map_or(Vec3::down(), |t| t.point - p),
+            }
+        };
+
+        // Out of the follicle the way it is combed, a little off as each
+        // follicle is. Which way the follicle itself points near the root is
+        // for every strand to take ([`crate::ops::Orient`]): a guide turning
+        // from it to the comb over a few millimetres would be a hook
+        // interpolation spreads over centimetres.
+        let first = rotate(
+            safe_normalize(tangent(flow_at(root) + wander, normal), grows),
+            normal,
+            spread,
+        );
+        let leaving = first * angle.cos() + normal * angle.sin();
+
+        let mut path = vec![root];
+        let mut p = root;
+        let mut d = safe_normalize(leaving, normal);
+        if cut.dome > 0.0 {
+            // Out to the dome, and a little more for the wandering on the way.
+            // Centred above and a little in front of the cranium's centre:
+            // an afro is fullest over the crown and the temples, and short at
+            // the nape.
+            let centre = head.cranium.center + Vec3::new(0.0, 0.04, 0.012);
+            let o = root - centre;
+            let b = d.dot(o);
+            let c = o.dot(o) - cut.dome * cut.dome;
+            let reach = -b + (b * b - c).max(0.0).sqrt();
+            length = reach.max(0.02) * (1.2 + 0.1 * rng.gaussian().clamp(-2.0, 2.0));
+        }
+        let ds = (length / 300.0).clamp(0.0004, 0.002);
+        let steps = (length / ds).ceil() as usize;
+        // Where a tied strand is in its bundle, and in its braid lane.
+        let mut tied_at: Option<f32> = None;
+        let bundle = Vec3::new(rng.gaussian(), rng.gaussian(), 0.0) * 0.004;
+        let lane = match parting {
+            Parting::Lanes { count } => parting.group(root).lane(*count),
+            _ => 0.0,
+        };
+        let bun_phase = azimuth;
+        let is_cut = |p: Vec3| cut.line(head, root, p).is_some_and(|y| p.y < y);
+        let to_tie = tie.map_or(0.0, |t| (t.point - root).length());
+
+        for step in 1..=steps {
+            let s = step as f32 * ds;
+            let remaining = length - s;
+
+            // Past the tie: the tail, the coil or the braid, all strands in
+            // one bundle about the tie's axis.
+            if let (Some(tie), Some(at)) = (tie, tied_at) {
+                let along = s - at;
+                p = tie.bundled(along, bundle, lane, bun_phase);
+                path.push(p);
+                if is_cut(p) {
+                    break;
+                }
+                continue;
+            }
+
+            let lift = height(p, s);
+            let (distance, n) = (head.distance(p), head.gradient(p));
+            let gap = distance - lift;
+            // Hair over the forehead rests on it, however high it came from.
+            let resting = over_face(p) && gap < 0.03;
+            let supported =
+                (gap < style.cling || resting) && n.y > -0.3 && !matches!(flow, Flow::Radial);
+            let force = Vec3::down();
+
+            if let (Flow::Tie(_), Some(tie)) = (flow, tie) {
+                // At the tie -- or, for a strand that cannot reach it from
+                // right beneath it, as far as it would have come.
+                if (tie.point - p).length() < 0.02 || s > 1.6 * to_tie + 0.03 {
+                    tied_at = Some(s);
+                    continue;
+                }
+                // Over the scalp to the tie, held there: no sliding.
+                let want = safe_normalize(tangent(tie.point - p, n), d);
+                d = safe_normalize(d.lerp(want, (ds / 0.01).min(1.0)), want);
+            } else if supported {
+                // Lying on the hair beneath: the comb, and gravity down the
+                // slope as the hair still to come weighs.
+                // A fringe combed forward over the hairline falls straight down
+                // the forehead: forward, turned into a curved forehead, would
+                // gather it to a point over the nose.
+                let comb_to = if over_face(p) && fringed {
+                    Vec3::down()
+                } else {
+                    flow_at(p) + wander
+                };
+                let combed = safe_normalize(tangent(comb_to, n), d);
+                let downhill = tangent(force, n);
+                let mut slide = smoothstep(0.0, 4.0 * stiffness, remaining);
+                // Hair lying combed on the hair beneath is held there by
+                // friction, and slides only where the weight of what hangs
+                // from it pulls it off. Over the front of the head that pull
+                // is along the comb, to where the hair hangs beside the face:
+                // downhill there would be onto the face, which only hair
+                // combed that way (a fringe) goes.
+                if !fringed && over_face(p + safe_normalize(downhill, d) * 0.02) {
+                    slide *= 0.05;
+                }
+                let want = safe_normalize(combed * (1.0 - slide) + downhill * slide, combed);
+                // Rising to its layer near the root, the strand keeps its angle.
+                let rising = 1.0 - smoothstep(0.0, rise, s);
+                let want = safe_normalize(want * (1.0 - rising) + leaving * rising, want);
+                d = safe_normalize(d.lerp(want, (ds / 0.012).min(1.0)), want);
+            } else {
+                // Free: a cantilever under its own weight -- stiff or short
+                // hair standing out barely bends.
+                d = cantilever(d, force, remaining, stiffness, ds);
+            }
+            // Coily hair wanders: a random turn a step, growing with the root of
+            // the distance (a random walk in direction).
+            if follicles.kink > 0.0 {
+                let axis = safe_normalize(
+                    d.cross(Vec3::new(rng.gaussian(), rng.gaussian(), rng.gaussian())),
+                    crate::strands::orthogonal(d),
+                );
+                d = rotate(d, axis, rng.gaussian() * follicles.kink * ds.sqrt());
+                let outward = safe_normalize(p - head.cranium.center, d);
+                d = safe_normalize(d + outward * 0.05, d);
+            }
+            // The last few centimetres of a tucked cut turn in towards the neck.
+            if tuck > 0.0 && remaining < 0.05 {
+                let neck = Vec3::new(0.0, p.y, head.neck.a.z);
+                let inward = safe_normalize(tangent(neck - p, d), d);
+                d = safe_normalize(d + inward * (tuck * ds / 0.05), d);
+            }
+
+            let mut next = p + d * ds;
+            let floor_here = height(next, s + ds);
+            let distance = head.distance(next);
+            if distance < floor_here {
+                next += head.gradient(next) * (floor_here - distance);
+                next = p + safe_normalize(next - p, d) * ds;
+            } else if supported && distance > floor_here {
+                // Lying on the layer below: settle onto it where it drops away.
+                next -= head.gradient(next) * ((distance - floor_here) * 0.15);
+                next = p + safe_normalize(next - p, d) * ds;
+            }
+            d = safe_normalize(next - p, d);
+            p = next;
+            path.push(p);
+            if is_cut(p) {
+                break;
+            }
+        }
+        path
+    }
+}
+
+/// The key every draw of a hairdo's guides derives from.
+pub(crate) fn guide_key(seed: u64) -> u32 {
+    rng::hash(seed as u32 ^ 0x0571_71E5, (seed >> 32) as u32)
+}
+
+/// The key of guide `i`'s own draws as it is combed.
+pub(crate) fn comb_key(key: u32, i: u32) -> u32 {
+    rng::hash(key ^ 0x0C0B, i)
+}
+
+/// How far apart guides are placed, `count` of them on `area`.
+pub(crate) fn guide_spacing(area: f32, count: usize) -> f32 {
+    0.7 * (area / count as f32).sqrt()
+}
+
+/// How far apart the row of guides along the hairline is.
+pub(crate) fn edge_spacing(spacing: f32) -> f32 {
+    (0.6 * spacing).max(0.008)
+}
+
+impl Hairdo {
+    /// How the comb runs, as the GPU's guide kernel takes it: a code
+    /// (natural, part, swept, back, forward, radial, down, tie) and its one
+    /// value (the part's `x`, the sweep's side, the tie: tail, bun or
+    /// braid).
+    #[cfg_attr(not(feature = "gpu"), allow(dead_code))]
+    pub(crate) fn flow_code(&self) -> (u32, f32) {
+        match self.flow() {
+            Flow::Natural => (0, 0.0),
+            Flow::Part(x) => (1, x),
+            Flow::Swept(side) => (2, side),
+            Flow::Back => (3, 0.0),
+            Flow::Forward => (4, 0.0),
+            Flow::Radial => (5, 0.0),
+            Flow::Down => (6, 0.0),
+            Flow::Tie(Tie::Tail) => (7, 0.0),
+            Flow::Tie(Tie::Bun) => (7, 1.0),
+            Flow::Tie(Tie::Braid) => (7, 2.0),
+        }
+    }
+}
+
+/// Bend `d` towards `force` as a cantilever with `remaining` metres of hair
+/// still to hang off it: curvature `remaining^2 / (2 L_g^3)` times the sine
+/// of the angle between them, over one step, never past the force.
+fn cantilever(d: Vec3, force: Vec3, remaining: f32, stiffness: f32, ds: f32) -> Vec3 {
+    let axis = d.cross(force);
+    let sin = axis.length();
+    if sin < 1e-6 {
+        return d;
+    }
+    let angle = sin.atan2(d.dot(force));
+    let curvature = remaining.max(0.0).powi(2) / (2.0 * stiffness.powi(3)) * sin;
+    rotate(d, axis * (1.0 / sin), (curvature * ds).min(angle))
+}
+
+/// The component of `v` in the plane with normal `n`.
+fn tangent(v: Vec3, n: Vec3) -> Vec3 {
+    v - n * v.dot(n)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::follicles::Growth;
+    use crate::haircut::Cut;
+    use crate::presets::Preset;
+
+    fn outside(head: &Head, guides: &Strands) -> bool {
+        let inside = guides
+            .positions
+            .iter()
+            .filter(|p| head.distance(**p) < -0.002)
+            .count();
+        inside * 50 < guides.positions.len()
+    }
+
+    #[test]
+    fn every_preset_grows_guides_outside_the_head() {
+        let base = Head::mannequin();
+        for preset in Preset::ALL {
+            let hairdo = preset.hairdo();
+            let head = hairdo.head(&base);
+            let scalp = head.scalp(0.008);
+            let guides = hairdo.guides(&head, &scalp, 32, 0.5, 1);
+            assert!(guides.len() > 30, "{}: {}", preset.name(), guides.len());
+            assert!(!guides.has_non_finite(), "{}", preset.name());
+            assert!(outside(&head, &guides), "{}", preset.name());
+        }
+    }
+
+    #[test]
+    fn every_cut_style_and_growth_combine() {
+        let head = Head::mannequin();
+        let scalp = head.scalp(0.01);
+        for (i, cut) in Cut::ALL.into_iter().enumerate() {
+            for (j, arrangement) in Arrangement::ALL.into_iter().enumerate() {
+                let hairdo = Hairdo {
+                    follicles: Follicles {
+                        growth: Growth::ALL[(i + j) % Growth::ALL.len()],
+                        ..Default::default()
+                    },
+                    haircut: Haircut::new(cut),
+                    hairstyle: Hairstyle::new(arrangement),
+                };
+                let guides = hairdo.guides(&head, &scalp, 16, 0.5, 2);
+                assert!(!guides.has_non_finite(), "{cut:?} {arrangement:?}");
+                assert!(outside(&head, &guides), "{cut:?} {arrangement:?}");
+            }
+        }
+    }
+
+    #[test]
+    fn roots_leave_the_scalp_gently() {
+        let base = Head::mannequin();
+        let hairdo = Preset::Long.hairdo();
+        let head = hairdo.head(&base);
+        let scalp = head.scalp(0.008);
+        let guides = hairdo.guides(&head, &scalp, 256, 0.0, 3);
+        // Rooted on the scalp, and the first few millimetres -- leaving it
+        // at the follicle's angle over a curving head, rising to its layer
+        // -- within a centimetre: at a steep follicle's 0.7 rad (the angle
+        // two spreads up) and some of the layer, 8 mm along is 8 mm up.
+        for s in 0..guides.len() {
+            let strand = guides.strand(s);
+            assert!(head.distance(strand[0]).abs() < 0.002);
+            for p in &strand[..6] {
+                assert!(head.distance(*p) < 0.01, "{}", head.distance(*p));
+            }
+        }
+    }
+
+    #[test]
+    fn short_hair_follows_the_growth_pattern() {
+        let head = Head::mannequin();
+        let scalp = head.scalp(0.008);
+        for growth in [Growth::Forward, Growth::Backward] {
+            let hairdo = Hairdo {
+                follicles: Follicles {
+                    growth,
+                    direction_spread: 0.0,
+                    ..Default::default()
+                },
+                haircut: Haircut::new(Cut::Crop),
+                hairstyle: Hairstyle::new(Arrangement::Natural),
+            };
+            let guides = hairdo.guides(&head, &scalp, 16, 0.0, 4);
+            // On top, the tips lie towards the face or away from it.
+            let (mut sum, mut n) = (0.0, 0);
+            for s in 0..guides.len() {
+                let strand = guides.strand(s);
+                if strand[0].y > 0.1 {
+                    sum += (strand[15] - strand[0]).z;
+                    n += 1;
+                }
+            }
+            let mean = sum / n.max(1) as f32;
+            match growth {
+                Growth::Forward => assert!(mean > 0.01, "{mean}"),
+                _ => assert!(mean < -0.01, "{mean}"),
+            }
+        }
+    }
+
+    #[test]
+    fn long_hair_hangs_short_hair_stands() {
+        let straight_down = |d: Vec3| d.dot(Vec3::down());
+        let long = cantilever(Vec3::right(), Vec3::down(), 0.4, 0.05, 0.002);
+        let short = cantilever(Vec3::right(), Vec3::down(), 0.02, 0.05, 0.002);
+        assert!(straight_down(long) > 0.9);
+        assert!(straight_down(short) < 0.01);
+    }
+}
diff --git a/crates/fabelgeist-hair/src/hairdo/tied.rs b/crates/fabelgeist-hair/src/hairdo/tied.rs
new file mode 100644
index 000000000..cb4fa34b7
--- /dev/null
+++ b/crates/fabelgeist-hair/src/hairdo/tied.rs
@@ -0,0 +1,111 @@
+//! Geometry of tails, buns and braids. Native vectors are metres in the head frame.
+use super::{Flow, Hairdo, Tie, cantilever, safe_normalize, smoothstep, tangent};
+use crate::head::Head;
+use fabelgeist_math::Vec3;
+
+/// Where a tied style's strands meet, and the path the tie hangs along.
+pub(crate) struct Tied {
+    kind: Tie,
+    /// The tie, off the scalp.
+    pub(crate) point: Vec3,
+    /// Out of the head at the tie.
+    pub(crate) out: Vec3,
+    /// The tail's axis from the tie, a polyline two millimetres a step.
+    pub(crate) axis: Vec<Vec3>,
+}
+
+impl Tied {
+    pub(crate) fn new(head: &Head, hairdo: &Hairdo) -> Option<Self> {
+        let Flow::Tie(kind) = hairdo.flow() else {
+            return None;
+        };
+        let c = head.cranium.center;
+        let r = head.cranium.radii;
+        // Up the back of the head: high for a tail, on the crown's back for
+        // a bun, low at the nape for a braid.
+        let a = hairdo.hairstyle.tie;
+        let on_scalp = c + Vec3::new(0.0, r.y * a.sin(), -r.z * a.cos());
+        let out = head.gradient(on_scalp);
+        let point = on_scalp + out * (0.012 - head.distance(on_scalp));
+        // The tail leaves the tie out of the head and bends down as a
+        // cantilever -- stiffer than one strand: it is a bundle.
+        let mut axis = vec![point];
+        if !matches!(kind, Tie::Bun) {
+            // As long as the longest hair: clippers leave the back short.
+            let length = hairdo.haircut.longest();
+            let stiffness = hairdo.hairstyle.hold * 2.0;
+            let mut p = point;
+            let mut d = safe_normalize(out + Vec3::down() * 0.4, Vec3::down());
+            let ds = 0.002;
+            let mut s = 0.0;
+            while s < length {
+                d = cantilever(d, Vec3::down(), length - s, stiffness, ds);
+                let mut next = p + d * ds;
+                let distance = head.distance(next);
+                if distance < 0.02 {
+                    next += head.gradient(next) * (0.02 - distance);
+                    next = p + safe_normalize(next - p, d) * ds;
+                }
+                d = safe_normalize(next - p, d);
+                p = next;
+                axis.push(p);
+                s += ds;
+            }
+        }
+        if axis.len() < 2 {
+            axis.push(point + out * 0.002);
+        }
+        Some(Self {
+            kind,
+            point,
+            out,
+            axis,
+        })
+    }
+
+    /// The axis at arc length `s` from the tie, its direction and a frame
+    /// across it (the second axis points out of the head).
+    fn frame(&self, s: f32) -> (Vec3, Vec3, Vec3, Vec3) {
+        let f = (s / 0.002).max(0.0);
+        let i = (f as usize).min(self.axis.len().saturating_sub(2));
+        let t = (f - i as f32).clamp(0.0, 1.0);
+        let p = self.axis[i].lerp(self.axis[i + 1], t);
+        let d = safe_normalize(self.axis[i + 1] - self.axis[i], Vec3::down());
+        let across = safe_normalize(d.cross(self.out), Vec3::right());
+        let depth = across.cross(d);
+        (p, d, across, depth)
+    }
+
+    /// Where a strand is `along` metres past the tie: in the tail, coiled
+    /// in the bun or plaited in its lane of the braid, `bundle` off the
+    /// middle.
+    pub(super) fn bundled(&self, along: f32, bundle: Vec3, lane: f32, phase: f32) -> Vec3 {
+        use std::f32::consts::TAU;
+        match self.kind {
+            Tie::Tail => {
+                let (c, _, across, depth) = self.frame(along);
+                let spread = 1.0 + 0.6 * smoothstep(0.1, 0.4, along);
+                c + (across * bundle.x + depth * bundle.y) * spread
+            }
+            Tie::Braid => {
+                let (c, _, across, depth) = self.frame(along);
+                let phase = along / 0.035 * TAU + lane * TAU / 3.0;
+                let width = 0.016 * (1.0 - 0.45 * smoothstep(0.0, 0.45, along));
+                let taper = 1.0 - smoothstep(0.38, 0.5, along);
+                c + across * (phase.sin() * width * taper + bundle.x * 0.6)
+                    + depth * ((2.0 * phase).sin() * width * 0.35 * taper + bundle.y * 0.6)
+            }
+            Tie::Bun => {
+                // Coiled round the tie, out from the head as it winds.
+                let turns = along / 0.11;
+                let a = phase + turns * TAU;
+                let r = 0.018 + 0.01 * (turns * 0.5).min(1.0) + bundle.x;
+                let u = safe_normalize(tangent(Vec3::up(), self.out), Vec3::up());
+                let v = self.out.cross(u);
+                self.point
+                    + (u * a.cos() + v * a.sin()) * r
+                    + self.out * (0.004 + 0.012 * (turns * 0.4).min(1.0) + bundle.y)
+            }
+        }
+    }
+}
