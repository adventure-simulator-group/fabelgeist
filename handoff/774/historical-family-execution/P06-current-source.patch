index 000000000..ec9746055
--- /dev/null
+++ b/crates/adventuresim-character-creator/src/hair.rs
@@ -0,0 +1,177 @@
+//! The hair a character wears, and the forms it is drawn in.
+//!
+//! `fabelgeist-hair` grows a hairstyle as strands on its mannequin bust
+//! ([`GroomedHair`]). A [`HeadPlacement`] carries the strands onto the
+//! character's own head, stretched to its width, depth and crown and facing
+//! the way its eyes do; there the hair's levels of detail are prepared
+//! against the character's body ([`PlacedHair`]), so no strand or card sinks
+//! into a scalp the bust did not have. Each level is drawn as plain triangles
+//! ([`HairGeometry`]): strands as ribbons, cards as textured strips.
+
+mod cap;
+mod geometry;
+mod gpu;
+mod groom;
+mod placement;
+mod scalp_map;
+mod shape;
+
+pub use cap::ScalpCap;
+pub use geometry::{AtlasLevel, HairGeometry};
+pub use gpu::HairGpu;
+pub use gpu::{GpuGeometry, GpuScalpTexture, ScalpLevel, ScalpTexture, scalp_levels};
+pub use groom::{BodySurface, GroomedHair, PlacedHair};
+pub use placement::{HeadPlacement, HeadPlacementError, HeadSkin};
+pub use shape::{
+    CLUMPING, CURL, FRIZZ, Groom, HairShape, LENGTH, PART, ShapeKnobs, ShapeRangeError, VOLUME,
+    WAVE,
+};
+
+use fabelgeist_hair::{HairMaterial, Preset};
+use serde::{Deserialize, Serialize};
+
+/// Hair's perceptual roughness when drawn as cards: a rough dielectric whose
+/// sheen comes from the strands painted in the atlas.
+pub const HAIR_ROUGHNESS: f32 = 0.55;
+
+/// Hair pigment as Blender's Principled Hair takes it. Both shares run from 0
+/// to 1: melanin from white through blond and brown to black, redness from
+/// ashen to red. A dye tints the strands on top, linear RGB, each channel 0
+/// to 1 of the light it lets through: white is no dye. A dye shows best on
+/// light hair, as on bleached hair.
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields, try_from = "PigmentShares")]
+pub struct HairPigment {
+    melanin: f32,
+    redness: f32,
+    dye: [f32; 3],
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PigmentShares {
+    melanin: f32,
+    redness: f32,
+    dye: [f32; 3],
+}
+
+/// A pigment share or a dye channel outside 0 to 1.
+#[derive(Debug, thiserror::Error)]
+#[error("hair pigment shares and dye channels must lie between 0 and 1")]
+pub struct PigmentRangeError;
+
+impl TryFrom<PigmentShares> for HairPigment {
+    type Error = PigmentRangeError;
+
+    fn try_from(shares: PigmentShares) -> Result<Self, Self::Error> {
+        let share = 0.0..=1.0;
+        let within = share.contains(&shares.melanin)
+            && share.contains(&shares.redness)
+            && shares.dye.iter().all(|channel| share.contains(channel));
+        if !within {
+            return Err(PigmentRangeError);
+        }
+        Ok(Self {
+            melanin: shares.melanin,
+            redness: shares.redness,
+            dye: shares.dye,
+        })
+    }
+}
+
+impl Default for HairPigment {
+    /// A mid brown, undyed.
+    fn default() -> Self {
+        let material = HairMaterial::default();
+        Self {
+            melanin: material.melanin,
+            redness: material.redness,
+            dye: NO_DYE,
+        }
+    }
+}
+
+/// The dye that leaves hair its own colour.
+pub const NO_DYE: [f32; 3] = [1.0; 3];
+
+impl HairPigment {
+    /// An undyed pigment with both shares clamped to 0 to 1.
+    pub fn new(melanin: f32, redness: f32) -> Self {
+        Self {
+            melanin: melanin.clamp(0.0, 1.0),
+            redness: redness.clamp(0.0, 1.0),
+            dye: NO_DYE,
+        }
+    }
+
+    /// The hair crate's named natural colour, as "auburn" or "platinum".
+    pub fn named(name: &str) -> Option<Self> {
+        HairMaterial::named(name).map(|material| Self::new(material.melanin, material.redness))
+    }
+
+    /// This pigment dyed `dye`, each channel clamped to 0 to 1.
+    pub fn dyed(self, dye: [f32; 3]) -> Self {
+        Self {
+            dye: dye.map(|channel| channel.clamp(0.0, 1.0)),
+            ..self
+        }
+    }
+
+    pub fn melanin(self) -> f32 {
+        self.melanin
+    }
+
+    pub fn redness(self) -> f32 {
+        self.redness
+    }
+
+    pub fn dye(self) -> [f32; 3] {
+        self.dye
+    }
+
+    /// The hair's real-time colour, linear RGB.
+    pub fn color(self) -> [f32; 3] {
+        HairMaterial {
+            melanin: self.melanin,
+            redness: self.redness,
+            tint: self.dye,
+            ..HairMaterial::default()
+        }
+        .base_color()
+    }
+}
+
+/// A hairstyle, how it is varied from its preset, and its colour.
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct HairDesign {
+    pub preset: Preset,
+    pub shape: HairShape,
+    pub pigment: HairPigment,
+}
+
+impl HairDesign {
+    /// What grows: the colour aside.
+    pub fn groom(&self) -> Groom {
+        Groom {
+            preset: self.preset,
+            shape: self.shape,
+        }
+    }
+}
+
+/// A hairstyle's, a cut's, an arrangement's or a growth pattern's name as
+/// the interface shows it: `SideSwept` as "Side swept".
+pub fn variant_label(variant: impl std::fmt::Debug) -> String {
+    let name = format!("{variant:?}");
+    let mut label = String::with_capacity(name.len() + 2);
+    for (index, letter) in name.chars().enumerate() {
+        if index > 0 && letter.is_uppercase() {
+            label.push(' ');
+            label.extend(letter.to_lowercase());
+        } else {
+            label.push(letter);
+        }
+    }
+    label
+}
diff --git a/crates/adventuresim-character-creator/src/hair/cap.rs b/crates/adventuresim-character-creator/src/hair/cap.rs
new file mode 100644
index 000000000..737fb48a5
--- /dev/null
+++ b/crates/adventuresim-character-creator/src/hair/cap.rs
@@ -0,0 +1,256 @@
+//! The scalp under the hair, as a fine cap fitted to the character's skull.
+//!
+//! Between strands and cards the skin would show bare, so the scalp is
+//! painted the hair's colour. The character's body is far too coarse over
+//! the skull for that -- a few dozen vertices -- and painting it per vertex
+//! smears a parting across centimetres. The bust's own scalp, cut in the
+//! hair crate's four-millimetre cells, is carried onto the character
+//! instead and laid just over its skin. Over the body's coarse facets a cap
+//! triangle laid by its corners alone would dip under the skin wherever it
+//! spans a ridge or a corner of the body, and the bare skin would show
+//! through it in specks along the body's edges; such triangles are lifted
+//! until every point of them clears the skin.
+//!
+//! The bust's scalp is cut from its cells, so its edge runs in steps a cell
+//! high. The cap fades out to nothing at its edge: above the hairline from
+//! above the highest of those steps, so the hairline is the hair crate's
+//! smooth curve, and over a row of cells along the rest of its edge, as at
+//! the nape.
+
+use std::collections::{HashMap, VecDeque};
+
+use fabelgeist_hair::collider::Collider;
+use fabelgeist_hair::{Head, MeshCollider, Surface};
+use fabelgeist_math::Vec3;
+use rayon::prelude::*;
+
+use super::HeadPlacement;
+use super::scalp_map::ScalpMap;
+
+/// How far over the skin the cap lies, metres: under the hair's roots,
+/// clear of the skin's own triangles.
+const CAP_LIFT: f32 = 0.0004;
+/// Rows of cells from the scalp's edge over which the cap fades in: one, so
+/// no band of bare skin runs along it where the edge is not the hairline,
+/// as at the nape.
+const EDGE_FADE_ROWS: f32 = 1.0;
+/// How far above the hairline the cap starts to show, metres: above the
+/// scalp's stepped edge, which lies up to a cell above it.
+const HAIRLINE_STEPS: f32 = 0.005;
+/// Over how far above that the cap fades in, metres: a little more than
+/// the follicles thin out over.
+const HAIRLINE_SOFTNESS: f32 = 0.006;
+/// How finely each cap triangle is sampled for dipping under the skin:
+/// points at this many steps along each edge, and inside.
+const DIP_STEPS: usize = 4;
+/// The most passes made lifting triangles off the skin: a lift moves a
+/// triangle's neighbours too, so it settles in a few.
+const DIP_PASSES: usize = 4;
+
+/// The scalp, fitted to a character's skull, and how much each of its
+/// points shows over the skin beneath.
+pub struct ScalpCap {
+    pub positions: Vec<[f32; 3]>,
+    /// The scalp's own smooth normals: the body's facets would show through
+    /// the strands painted on it as flat patches.
+    pub normals: Vec<[f32; 3]>,
+    /// Where each point lies in the scalp's texture.
+    pub texcoords: Vec<[f32; 2]>,
+    /// Along the texture's `u`, square to the normal, and as the fourth
+    /// value which way its `v` runs: `v` runs along the normal crossed
+    /// with the tangent, times that.
+    pub tangents: Vec<[f32; 4]>,
+    pub faces: Vec<[u32; 3]>,
+    /// 0 to 1: none at the cap's edge, all a little way in.
+    pub opacity: Vec<f32>,
+}
+
+impl ScalpCap {
+    /// The scalp of the bust `head`, mapped onto its texture by `map`,
+    /// carried onto a character by `placement` and laid over its `body`.
+    pub(super) fn fit(
+        scalp: &Surface,
+        head: &Head,
+        map: &ScalpMap,
+        placement: &HeadPlacement,
+        body: &MeshCollider,
+    ) -> Self {
+        let mut positions: Vec<Vec3> = scalp
+            .positions
+            .par_iter()
+            .map(|&point| {
+                let carried = Vec3::from_array(placement.point(point.to_array()));
+                let (distance, out) = body.query(carried);
+                carried - out * (distance - CAP_LIFT)
+            })
+            .collect();
+        clear_skin(&mut positions, &scalp.triangles, body);
+        let normals: Vec<Vec3> = scalp
+            .normals
+            .iter()
+            .map(|normal| Vec3::from_array(placement.normal(normal.to_array())))
+            .collect();
+        // The map reaches past the scalp's lowest point, so every point of
+        // the scalp lies within it.
+        let texcoords: Vec<[f32; 2]> = scalp
+            .positions
+            .iter()
+            .map(|&point| map.uv(point).unwrap_or_default())
+            .collect();
+        let tangents = tangents(&positions, &normals, &texcoords, &scalp.triangles);
+        let opacity = edge_fade(positions.len(), &scalp.triangles)
+            .into_iter()
+            .zip(&scalp.positions)
+            .map(|(edge, &point)| {
+                let above = head.above_hairline(point) - HAIRLINE_STEPS;
+                let t = (above / HAIRLINE_SOFTNESS).clamp(0.0, 1.0);
+                edge.min(t * t * (3.0 - 2.0 * t))
+            })
+            .collect();
+        Self {
+            positions: positions.iter().map(|point| point.to_array()).collect(),
+            normals: normals.iter().map(|normal| normal.to_array()).collect(),
+            texcoords,
+            tangents,
+            faces: scalp.triangles.clone(),
+            opacity,
+        }
+    }
+}
+
+/// Each point's direction along the texture's `u` over `triangles`, square
+/// to its `normal`, and the sign that turns the normal crossed with it into
+/// the direction along `v`.
+fn tangents(
+    positions: &[Vec3],
+    normals: &[Vec3],
+    texcoords: &[[f32; 2]],
+    triangles: &[[u32; 3]],
+) -> Vec<[f32; 4]> {
+    let zero = Vec3::new(0.0, 0.0, 0.0);
+    let mut along_u = vec![zero; positions.len()];
+    let mut along_v = vec![zero; positions.len()];
+    for &[a, b, c] in triangles {
+        let [a, b, c] = [a, b, c].map(|corner| corner as usize);
+        let (first, second) = (positions[b] - positions[a], positions[c] - positions[a]);
+        let [du1, dv1] = [
+            texcoords[b][0] - texcoords[a][0],
+            texcoords[b][1] - texcoords[a][1],
+        ];
+        let [du2, dv2] = [
+            texcoords[c][0] - texcoords[a][0],
+            texcoords[c][1] - texcoords[a][1],
+        ];
+        let area = du1 * dv2 - du2 * dv1;
+        if area == 0.0 || !area.is_finite() {
+            continue;
+        }
+        let u = (first * dv2 - second * dv1) * (1.0 / area);
+        let v = (second * du1 - first * du2) * (1.0 / area);
+        for corner in [a, b, c] {
+            along_u[corner] += u;
+            along_v[corner] += v;
+        }
+    }
+    normals
+        .iter()
+        .zip(along_u.iter().zip(&along_v))
+        .map(|(&normal, (&u, &v))| {
+            let square = u - normal * normal.dot(u);
+            let length = square.length();
+            if length == 0.0 || !length.is_finite() {
+                return [1.0, 0.0, 0.0, 1.0];
+            }
+            let tangent = square * (1.0 / length);
+            let handedness = if normal.cross(tangent).dot(v) < 0.0 {
+                -1.0
+            } else {
+                1.0
+            };
+            [tangent.x, tangent.y, tangent.z, handedness]
+        })
+        .collect()
+}
+
+/// Lift every triangle of the cap whose `positions` dip under `body`'s skin
+/// between its corners, until each point of it lies [`CAP_LIFT`] off the
+/// skin.
+fn clear_skin(positions: &mut [Vec3], triangles: &[[u32; 3]], body: &MeshCollider) {
+    let samples: Vec<[f32; 3]> = (0..=DIP_STEPS)
+        .flat_map(|i| (0..=DIP_STEPS - i).map(move |j| [i, j, DIP_STEPS - i - j]))
+        .filter(|steps| steps.iter().all(|&step| step < DIP_STEPS))
+        .map(|steps| steps.map(|step| step as f32 / DIP_STEPS as f32))
+        .collect();
+    for _ in 0..DIP_PASSES {
+        let dips: Vec<f32> = triangles
+            .par_iter()
+            .map(|&[a, b, c]| {
+                let corners = [a, b, c].map(|corner| positions[corner as usize]);
+                samples
+                    .iter()
+                    .map(|weights| {
+                        let point = corners[0] * weights[0]
+                            + corners[1] * weights[1]
+                            + corners[2] * weights[2];
+                        CAP_LIFT - body.distance(point)
+                    })
+                    .fold(0.0, f32::max)
+            })
+            .collect();
+        let mut lifts = vec![0.0f32; positions.len()];
+        for (&dip, triangle) in dips.iter().zip(triangles) {
+            for &corner in triangle {
+                let lift = &mut lifts[corner as usize];
+                *lift = lift.max(dip);
+            }
+        }
+        if lifts.iter().all(|&lift| lift <= 0.0) {
+            break;
+        }
+        positions
+            .par_iter_mut()
+            .zip(&lifts)
+            .filter(|(_, lift)| **lift > 0.0)
+            .for_each(|(position, &lift)| {
+                let (_, out) = body.query(*position);
+                *position += out * lift;
+            });
+    }
+}
+
+/// For each of `points` vertices, 0 on the edge of `triangles` rising to 1
+/// [`EDGE_FADE_ROWS`] edges in.
+fn edge_fade(points: usize, triangles: &[[u32; 3]]) -> Vec<f32> {
+    let mut uses: HashMap<(u32, u32), u32> = HashMap::new();
+    let mut neighbours = vec![Vec::new(); points];
+    for &[a, b, c] in triangles {
+        for (p, q) in [(a, b), (b, c), (c, a)] {
+            *uses.entry((p.min(q), p.max(q))).or_default() += 1;
+            neighbours[p as usize].push(q);
+        }
+    }
+    // A breadth-first walk in from the edge, where an edge bounds one
+    // triangle only.
+    let mut rows = vec![u32::MAX; points];
+    let mut queue = VecDeque::new();
+    for (&(p, q), &count) in &uses {
+        if count == 1 {
+            for point in [p, q] {
+                rows[point as usize] = 0;
+                queue.push_back(point);
+            }
+        }
+    }
+    while let Some(point) = queue.pop_front() {
+        let next = rows[point as usize] + 1;
+        for &neighbour in &neighbours[point as usize] {
+            if rows[neighbour as usize] > next {
+                rows[neighbour as usize] = next;
+                queue.push_back(neighbour);
+            }
+        }
+    }
+    rows.into_iter()
+        .map(|row| (row as f32 / EDGE_FADE_ROWS).min(1.0))
+        .collect()
+}
diff --git a/crates/adventuresim-character-creator/src/hair/geometry.rs b/crates/adventuresim-character-creator/src/hair/geometry.rs
new file mode 100644
index 000000000..e478b093f
--- /dev/null
+++ b/crates/adventuresim-character-creator/src/hair/geometry.rs
@@ -0,0 +1,172 @@
+//! Hair's levels of detail as plain triangles: cards as textured strips,
+//! strands as ribbons, built on the GPU the hair was placed on
+//! ([`super::gpu`]'s strips) and read back.
+
+use anyhow::Result;
+use fabelgeist_hair::lod::Form;
+
+use super::gpu::{GpuGeometry, StripSource};
+use super::{HairGpu, HeadPlacement, PlacedHair};
+
+/// The most ribbon vertices drawn at once: about a hundred megabytes of
+/// vertex data in the preview.
+const RIBBON_VERTEX_BUDGET: usize = 1_500_000;
+
+/// Triangles to draw hair with, in model space.
+pub struct HairGeometry {
+    pub positions: Vec<[f32; 3]>,
+    pub normals: Vec<[f32; 3]>,
+    pub texcoords: Vec<[f32; 2]>,
+    /// Baked sky visibility, 0 to 1, from the groom's own self-shadowing.
+    pub occlusion: Vec<f32>,
+    /// Each card's own random value, 0 to 1: which of a pixel's samples it
+    /// covers, so stacked cards do not all cover the same ones. 0 for
+    /// strands.
+    pub randoms: Vec<f32>,
+    /// Along the strands, root to tip.
+    pub tangents: Vec<[f32; 3]>,
+    pub faces: Vec<[u32; 3]>,
+}
+
+/// One mip level of the card atlas: coverage as alpha, the painted strand
+/// shade as grey.
+pub struct AtlasLevel {
+    pub width: u32,
+    pub height: u32,
+    pub rgba: Vec<u8>,
+}
+
+impl PlacedHair {
+    /// The triangles of `form`, built on `gpu` and read back.
+    pub fn geometry(&self, gpu: &HairGpu, form: Form) -> Result<HairGeometry> {
+        match self.gpu_geometry(gpu, form)? {
+            Some(geometry) => geometry.read(gpu),
+            None => Ok(HairGeometry::empty()),
+        }
+    }
+
+    /// The triangles of `form`, built on `gpu` and left there, to draw from
+    /// where they lie; none for a form this hair has not.
+    pub fn gpu_geometry(&self, gpu: &HairGpu, form: Form) -> Result<Option<GpuGeometry>> {
+        let source = self.strip_source();
+        let built = match form {
+            Form::Cards { level } => {
+                let Some(cards) = self
+                    .lods
+                    .cards
+                    .get(level)
+                    .or_else(|| self.lods.cards.last())
+                else {
+                    return Ok(None);
+                };
+                source.cards(gpu, cards, self.lods.atlas.variants)?
+            }
+            Form::Strands { level, .. } => {
+                let Some(strands) = self.lods.levels.get(level) else {
+                    return Ok(None);
+                };
+                let drawn = self.strands_drawn(form);
+                let widen = strands.count as f32 / drawn.max(1) as f32;
+                source.ribbons(gpu, strands, drawn as u32, widen, self.lods.center)?
+            }
+        };
+        Ok(Some(built))
+    }
+
+    /// Where strips of this hair are built from.
+    fn strip_source(&self) -> StripSource<'_> {
+        StripSource {
+            body: &self.body,
+            longest: self.longest,
+        }
+    }
+
+    /// How many strands `form` draws: its share of the level's strands,
+    /// within the ribbon budget. Cards draw none.
+    pub fn strands_drawn(&self, form: Form) -> usize {
+        let Form::Strands { level, share } = form else {
+            return 0;
+        };
+        let Some(level) = self.lods.levels.get(level) else {
+            return 0;
+        };
+        let strands = level.count as usize;
+        let wanted = (strands as f32 * share.clamp(0.0, 1.0)).round() as usize;
+        let rows = self.strip_source().ribbon_rows(level.points) as usize;
+        let affordable = RIBBON_VERTEX_BUDGET / (2 * rows).max(1);
+        wanted.clamp(1, strands.max(1)).min(affordable)
+    }
+
+    /// The card atlas's mip chain, largest first.
+    pub fn atlas_levels(&self) -> Vec<AtlasLevel> {
+        let atlas = &self.lods.atlas;
+        // The atlas's width already spans every variant.
+        let mut width = atlas.width;
+        let mut height = atlas.height;
+        atlas
+            .levels
+            .iter()
+            .map(|texels| {
+                let level = AtlasLevel {
+                    width,
+                    height,
+                    rgba: shade_and_coverage(texels),
+                };
+                width = (width / 2).max(1);
+                height = (height / 2).max(1);
+                level
+            })
+            .collect()
+    }
+}
+
+impl HairGeometry {
+    pub(super) fn empty() -> Self {
+        Self {
+            positions: Vec::new(),
+            normals: Vec::new(),
+            texcoords: Vec::new(),
+            occlusion: Vec::new(),
+            randoms: Vec::new(),
+            tangents: Vec::new(),
+            faces: Vec::new(),
+        }
+    }
+
+    /// This geometry, placed by `from`, carried to where `to` places the
+    /// same hair: how hair follows a head reshaped by a morph channel.
+    pub fn carried(&self, from: &HeadPlacement, to: &HeadPlacement) -> Self {
+        Self {
+            positions: self
+                .positions
+                .iter()
+                .map(|&point| to.point(from.bust_point(point)))
+                .collect(),
+            normals: self
+                .normals
+                .iter()
+                .map(|&normal| to.normal(from.bust_normal(normal)))
+                .collect(),
+            texcoords: self.texcoords.clone(),
+            occlusion: self.occlusion.clone(),
+            randoms: self.randoms.clone(),
+            tangents: self
+                .tangents
+                .iter()
+                .map(|&tangent| to.direction(from.bust_direction(tangent)))
+                .collect(),
+            faces: self.faces.clone(),
+        }
+    }
+}
+
+/// The atlas stores coverage, shade, depth and coverage; drawing wants the
+/// shade as colour and the coverage as alpha.
+fn shade_and_coverage(texels: &[u8]) -> Vec<u8> {
+    texels
+        .as_chunks::<4>()
+        .0
+        .iter()
+        .flat_map(|&[coverage, shade, _, _]| [shade, shade, shade, coverage])
+        .collect()
+}
diff --git a/crates/adventuresim-character-creator/src/hair/gpu/bake/mod.rs b/crates/adventuresim-character-creator/src/hair/gpu/bake/mod.rs
new file mode 100644
index 000000000..f7d3b9090
--- /dev/null
+++ b/crates/adventuresim-character-creator/src/hair/gpu/bake/mod.rs
@@ -0,0 +1,448 @@
+//! The scalp's textures: the hair lying on it, baked from the groom on the
+//! GPU.
+//!
+//! Painted one flat colour, the scalp shows between cards and strands as a
+//! smooth, dead patch. Over a real scalp the eye meets the hair nearest it --
+//! strands lying along the skin in the groom's own direction, parted where
+//! the groom parts and spiralling out of its whorl. Each strand's first few
+//! millimetres off the skin are drawn into the scalp's texture
+//! ([`ScalpMap`]) on the bust the hair grew on, the topmost strand over each
+//! texel showing: lighter the further it lies off the skin, darker where it
+//! meets it, and running the way it runs, so the scalp is shaded as the
+//! strands are. Single strands are far finer than a pixel at any distance
+//! the head is seen from, so what shows is locks: strands rooted together
+//! share a tone, lighter or darker than the next lock, and differ a little
+//! among themselves.
+//!
+//! Where no strand lies, the scalp is either in the shadow of hair standing
+//! further off it -- between an afro's coils, below the coils further out --
+//! or bare: at a parting, at a whorl's eye, along a thinning hairline. How
+//! bare the scalp is round each texel, over a couple of millimetres and
+//! weighted to the nearest, makes the texel clear in the texture's alpha, so
+//! the skin beneath the cap shows there, lit as the rest of the body: hair
+//! thins into a parting over those millimetres, as it does at a real one,
+//! its last strands lying over the skin, while a texel or two between coils
+//! shows no skin at all. Shadowed scalp is the hair's colour in shade.
+//!
+//! Every strand draws itself, an invocation each, keeping the topmost strand
+//! over each texel with an atomic maximum: its height off the skin first in
+//! the packed value, then its direction and shade. Then each texel finds
+//! whether it is bare, the bare share is blurred, the textures are written,
+//! and each smaller mip level is averaged from the one before.
+
+use std::sync::Arc;
+
+use anyhow::Result;
+use fabelgeist_compute::{Kernel, KernelBatch};
+use fabelgeist_gpu::prelude::Buffer;
+use fabelgeist_hair::Head;
+use fabelgeist_hair::gpu::wgsl::common::{HEAD, MATH};
+use fabelgeist_hair::gpu::{GpuGroom, head_shape};
+
+use super::{HairGpu, KernelSource, params, storage, upload};
+use wgsl::{BARE, BLUR, DRAW, FINISH, HALVE, LONGEST, PACKING};
+
+mod wgsl;
+use crate::hair::AtlasLevel;
+use crate::hair::scalp_map::ScalpMap;
+
+/// The texture's side, texels: about an eighth of a millimetre a texel,
+/// near a hair's own width, so lying strands read as lines and a parting's
+/// edge as strands' ends.
+const SIZE: u32 = 2048;
+/// The longest step along a strand mapped as straight, metres: the map
+/// curves, and a strand drawn straight between points a centimetre apart
+/// would cut its corners.
+const STEP: f32 = 0.002;
+/// How far off the skin a strand is drawn, metres: the layer of hair the
+/// eye meets between cards.
+const REACH: f32 = 0.008;
+/// A strand's shade where it meets the skin, and at [`REACH`] off it, as a
+/// share of the hair's colour.
+const AT_SKIN: f32 = 0.25;
+const AT_REACH: f32 = 0.9;
+/// How much darker a lock may be than the lightest, and a strand than the
+/// rest of its lock.
+const LOCK_SPREAD: f32 = 0.5;
+const STRAND_SPREAD: f32 = 0.15;
+/// About how wide a lock is, metres: the cell of the noise its tone is
+/// drawn from, by where its strands are rooted.
+const LOCK_WIDTH: f32 = 0.004;
+/// How far off the skin hair still shadows it, metres: hair this near
+/// over a texel no strand lies on keeps it from showing bare.
+const SHADOW_REACH: f32 = 0.025;
+/// The side of the blocks shadowing is judged over, metres: one strand
+/// passing over a block shadows all of it, as hair further off the skin
+/// shadows more than the line of its own width.
+const SHADOW_BLOCK: f32 = 0.0015;
+/// How far round each texel the bare scalp is measured, metres, twice over
+/// so the nearest counts most: hair thins into a parting over about twice
+/// this.
+const BARE_REACH: f32 = 0.0008;
+/// The share of bare scalp round a texel at which skin starts to show
+/// there, and shows fully: most of a parting is bare, the gaps within and
+/// between an afro's coils single texels among strands.
+const BARE_START: f32 = 0.1;
+const BARE_FULL: f32 = 0.75;
+/// How much of a strand still shows where the scalp round it is bare: at
+/// a parting the hair thins strand by strand, the last strands' ends lying
+/// over the skin, rather than fading as a whole.
+const STRAND_OVER_SKIN: f32 = 0.5;
+/// The scalp's shade where no strand lies on it but hair lies over it.
+const SHADOWED: f32 = 0.35;
+/// Bytes of a texel.
+const TEXEL_BYTES: u64 = 4;
+
+/// The hair lying on the scalp, each a mip chain, largest first, over the
+/// cap's texture coordinates.
+pub struct ScalpTexture {
+    /// The scalp's shade as grey, as a share of the hair's colour, and
+    /// whether hair covers it as alpha.
+    pub shade: Vec<AtlasLevel>,
+    /// The direction the topmost strand runs across the texture, along `u`
+    /// and `v`, each from 0 backwards to 1 forwards (a half each where no
+    /// strand lies), and the shade again.
+    pub strands: Vec<AtlasLevel>,
+}
+
+/// The scalp's textures on the GPU: every mip level, largest first, one
+/// after another ([`levels`]), four bytes a texel.
+pub struct GpuScalpTexture {
+    shade: Buffer,
+    strands: Buffer,
+}
+
+/// The bake's kernels.
+pub(super) struct BakeKernels {
+    draw: Arc<Kernel>,
+    bare: Arc<Kernel>,
+    blur: Arc<Kernel>,
+    finish: Arc<Kernel>,
+    halve: Arc<Kernel>,
+    longest: Arc<Kernel>,
+}
+
+impl BakeKernels {
+    pub(super) fn new(source: &KernelSource) -> Result<Self> {
+        Ok(Self {
+            draw: source.compile(&format!("{DRAW}{MATH}{HEAD}{PACKING}"))?,
+            bare: source.compile(BARE)?,
+            blur: source.compile(BLUR)?,
+            finish: source.compile(&format!("{FINISH}{PACKING}"))?,
+            halve: source.compile(HALVE)?,
+            longest: source.compile(LONGEST)?,
+        })
+    }
+}
+
+/// One mip level's place in the chain: its side, texels; how far apart its
+/// rows start, texels, padded so a row is a whole number of the 256 bytes a
+/// copy into a texture moves rows in; and where it starts, texels in.
+#[derive(Clone, Copy, Debug)]
+pub struct Level {
+    pub side: u32,
+    pub stride: u32,
+    pub offset: u32,
+}
+
+/// Texels in a row a copy into a texture moves rows in multiples of.
+const ROW_TEXELS: u32 = 64;
+
+/// Every mip level of the texture, largest first.
+pub fn levels() -> Vec<Level> {
+    let mut levels = Vec::new();
+    let (mut side, mut offset) = (SIZE, 0);
+    loop {
+        let stride = side.max(ROW_TEXELS);
+        levels.push(Level {
+            side,
+            stride,
+            offset,
+        });
+        if side == 1 {
+            return levels;
+        }
+        offset += stride * side;
+        side /= 2;
+    }
+}
+
+impl GpuScalpTexture {
+    /// `groom`, grown on `bust`, baked into textures mapped by `map`.
+    pub(in crate::hair) fn bake(
+        gpu: &HairGpu,
+        groom: &GpuGroom,
+        bust: &Head,
+        map: &ScalpMap,
+    ) -> Result<Self> {
+        let context = gpu.context();
+        let texel = map.texel(SIZE as usize);
+        let block_side = ((SHADOW_BLOCK / texel).round() as u32).max(1);
+        let blocks = SIZE.div_ceil(block_side);
+        let bare_reach = ((BARE_REACH / texel).round() as u32).max(1);
+        let texels = u64::from(SIZE) * u64::from(SIZE);
+        let chain: u64 = levels()
+            .iter()
+            .map(|level| u64::from(level.stride) * u64::from(level.side))
+            .sum();
+        let topmost = storage(context, texels * TEXEL_BYTES, "hair scalp topmost")?;
+        let shadowed = storage(
+            context,
+            u64::from(blocks * blocks) * TEXEL_BYTES,
+            "hair scalp shadowed",
+        )?;
+        let bare = [
+            storage(context, texels * TEXEL_BYTES, "hair scalp bare")?,
+            storage(context, texels * TEXEL_BYTES, "hair scalp bare, blurred")?,
+        ];
+        let baked = Self {
+            shade: storage(context, chain * TEXEL_BYTES, "hair scalp shade")?,
+            strands: storage(context, chain * TEXEL_BYTES, "hair scalp strands")?,
+        };
+        let mut batch = KernelBatch::labelled(context, "hair scalp bake");
+        batch.encoder().clear_buffer(&topmost.buffer, 0, None);
+        batch.encoder().clear_buffer(&shadowed.buffer, 0, None);
+        let grid = Grid {
+            block_side,
+            blocks,
+            bare_reach,
+        };
+        grid.draw(gpu, &mut batch, groom, bust, map, [&topmost, &shadowed])?;
+        grid.bare(gpu, &mut batch, [&topmost, &shadowed], &bare)?;
+        baked.finish(gpu, &mut batch, &topmost, &bare[0])?;
+        batch.submit();
+        Ok(baked)
+    }
+
+    /// The shade texture's chain: shade as grey, coverage as alpha.
+    pub fn shade(&self) -> &Buffer {
+        &self.shade
+    }
+
+    /// The strands texture's chain: the way each runs, and its shade.
+    pub fn strands(&self) -> &Buffer {
+        &self.strands
+    }
+
+    /// The textures back on the host.
+    pub fn read(&self, gpu: &HairGpu) -> Result<ScalpTexture> {
+        let context = gpu.context();
+        let chain = |buffer: &Buffer| -> Result<Vec<AtlasLevel>> {
+            let texels: Vec<u32> = pollster::block_on(buffer.read(context))?;
+            let bytes: &[u8] = bytemuck::cast_slice(&texels);
+            Ok(levels()
+                .into_iter()
+                .map(|level| {
+                    let texel = TEXEL_BYTES as usize;
+                    let rgba = (0..level.side as usize)
+                        .flat_map(|row| {
+                            let start =
+                                (level.offset as usize + row * level.stride as usize) * texel;
+                            bytes[start..start + level.side as usize * texel]
+                                .iter()
+                                .copied()
+                        })
+                        .collect();
+                    AtlasLevel {
+                        width: level.side,
+                        height: level.side,
+                        rgba,
+                    }
+                })
+                .collect())
+        };
+        Ok(ScalpTexture {
+            shade: chain(&self.shade)?,
+            strands: chain(&self.strands)?,
+        })
+    }
+}
+
+/// How the bake's grid is judged: the side of the blocks shadowing is
+/// judged over, how many a row, and how far bare scalp is measured, texels.
+struct Grid {
+    block_side: u32,
+    blocks: u32,
+    bare_reach: u32,
+}
+
+impl Grid {
+    /// Record every strand of `groom`, grown on `bust`, drawn into
+    /// `topmost`, or marking the blocks it shadows.
+    fn draw(
+        &self,
+        gpu: &HairGpu,
+        batch: &mut KernelBatch<'_>,
+        groom: &GpuGroom,
+        bust: &Head,
+        map: &ScalpMap,
+        [topmost, shadowed]: [&Buffer; 2],
+    ) -> Result<()> {
+        let context = gpu.context();
+        let kernels = &gpu.bake;
+        let [center, axis, forward, side] = [map.center, map.axis, map.forward, map.side];
+        let (block_side, blocks) = (self.block_side, self.blocks);
+        batch.dispatch_folded(
+            &kernels.draw,
+            &params! {
+                "positions" => groom.positions.clone(),
+                "strands" => groom.attributes.clone(),
+                "head_shape" => upload(context, &head_shape(bust), "hair bust shape")?,
+                "topmost" => topmost.clone(),
+                "shadowed" => shadowed.clone(),
+                "center_x" => center.x,
+                "center_y" => center.y,
+                "center_z" => center.z,
+                "rim" => map.rim,
+                "axis_x" => axis.x,
+                "axis_y" => axis.y,
+                "axis_z" => axis.z,
+                "size" => SIZE,
+                "forward_x" => forward.x,
+                "forward_y" => forward.y,
+                "forward_z" => forward.z,
+                "count" => groom.strands,
+                "side_x" => side.x,
+                "side_y" => side.y,
+                "side_z" => side.z,
+                "points" => groom.points,
+                "step" => STEP,
+                "reach" => REACH,
+                "shadow_reach" => SHADOW_REACH,
+                "at_skin" => AT_SKIN,
+                "at_reach" => AT_REACH,
+                "lock_spread" => LOCK_SPREAD,
+                "strand_spread" => STRAND_SPREAD,
+                "lock_width" => LOCK_WIDTH,
+                "block_side" => block_side,
+                "blocks" => blocks,
+                "pad0" => 0u32,
+                "pad1" => 0u32,
+            },
+            groom.strands,
+        )?;
+        Ok(())
+    }
+
+    /// Record which texels are bare, into `bare[0]`, and their share round
+    /// each texel, blurred twice along rows and columns, back into it.
+    fn bare(
+        &self,
+        gpu: &HairGpu,
+        batch: &mut KernelBatch<'_>,
+        [topmost, shadowed]: [&Buffer; 2],
+        bare: &[Buffer; 2],
+    ) -> Result<()> {
+        let kernels = &gpu.bake;
+        let (block_side, blocks, bare_reach) = (self.block_side, self.blocks, self.bare_reach);
+        let texel_count = SIZE * SIZE;
+        batch.dispatch_folded(
+            &kernels.bare,
+            &params! {
+                "topmost" => topmost.clone(),
+                "shadowed" => shadowed.clone(),
+                "bare" => bare[0].clone(),
+                "size" => SIZE,
+                "block_side" => block_side,
+                "blocks" => blocks,
+                "pad0" => 0u32,
+            },
+            texel_count,
+        )?;
+        // Twice over, along rows then columns each time, so the nearest
+        // scalp counts most and the share falls smoothly.
+        for pass in 0..4u32 {
+            let (from, to) = (&bare[(pass % 2) as usize], &bare[((pass + 1) % 2) as usize]);
+            batch.dispatch_folded(
+                &kernels.blur,
+                &params! {
+                    "blur_in" => from.clone(),
+                    "blur_out" => to.clone(),
+                    "size" => SIZE,
+                    "stride" => if pass % 2 == 0 { 1 } else { SIZE },
+                    "reach" => bare_reach,
+                    "pad0" => 0u32,
+                },
+                texel_count,
+            )?;
+        }
+        Ok(())
+    }
+}
+
+impl GpuScalpTexture {
+    /// Record the textures written from `topmost` and the bare `share`, and
+    /// every smaller mip level.
+    fn finish(
+        &self,
+        gpu: &HairGpu,
+        batch: &mut KernelBatch<'_>,
+        topmost: &Buffer,
+        share: &Buffer,
+    ) -> Result<()> {
+        let kernels = &gpu.bake;
+        let texel_count = SIZE * SIZE;
+        batch.dispatch_folded(
+            &kernels.finish,
+            &params! {
+                "topmost" => topmost.clone(),
+                "share" => share.clone(),
+                "shade" => self.shade.clone(),
+                "strands" => self.strands.clone(),
+                "size" => SIZE,
+                "shadowed_shade" => SHADOWED,
+                "bare_start" => BARE_START,
+                "bare_full" => BARE_FULL,
+                "strand_over_skin" => STRAND_OVER_SKIN,
+                "pad0" => 0u32,
+                "pad1" => 0u32,
+                "pad2" => 0u32,
+            },
+            texel_count,
+        )?;
+        for pair in levels().windows(2) {
+            let [from, to] = [pair[0], pair[1]];
+            for texture in [&self.shade, &self.strands] {
+                batch.dispatch_folded(
+                    &kernels.halve,
+                    &params! {
+                        "chain" => texture.clone(),
+                        "from_side" => from.side,
+                        "from_stride" => from.stride,
+                        "from_offset" => from.offset,
+                        "to_side" => to.side,
+                        "to_stride" => to.stride,
+                        "to_offset" => to.offset,
+                        "pad0" => 0u32,
+                        "pad1" => 0u32,
+                    },
+                    to.side * to.side,
+                )?;
+            }
+        }
+        Ok(())
+    }
+}
+
+/// The longest of `groom`'s strands, metres.
+pub(crate) fn longest(gpu: &HairGpu, groom: &GpuGroom) -> Result<f32> {
+    let context = gpu.context();
+    let out = storage(context, 16, "hair longest strand")?;
+    let mut batch = KernelBatch::labelled(context, "hair longest strand");
+    batch.encoder().clear_buffer(&out.buffer, 0, None);
+    batch.dispatch_folded(
+        &gpu.bake.longest,
+        &params! {
+            "positions" => groom.positions.clone(),
+            "longest" => out.clone(),
+            "count" => groom.strands,
+            "points" => groom.points,
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+        },
+        groom.strands,
+    )?;
+    batch.submit();
+    let words: Vec<u32> = pollster::block_on(out.read(context))?;
+    Ok(f32::from_bits(words.first().copied().unwrap_or(0)))
+}
