--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/guides/packed.rs
@@ -0,0 +1,93 @@
+//! Native WGSL hairdo record: metres in the head frame, shader discriminants.
+use super::*;
+pub(super) struct HairdoUpload {
+    pub(super) gpu: HairdoGpu,
+    pub(super) axis: Vec<[f32; 4]>,
+}
+impl HairdoUpload {
+    pub(super) fn new(
+        hairdo: &Hairdo,
+        head: &Head,
+        variation: f32,
+        seed: u64,
+        count: u32,
+        points: u32,
+        max_path: u32,
+    ) -> Self {
+        let field = hairdo.follicles.field(head);
+        let whorl = |i: usize| field.whorls.get(i).copied();
+        let (w0, w1) = (whorl(0), whorl(1));
+        let (flow, flow_value) = hairdo.flow_code();
+        let tied = Tied::new(head, hairdo);
+        let axis: Vec<[f32; 4]> = tied.as_ref().map_or(vec![[0.0; 4]; 2], |t| {
+            t.axis.iter().map(|p| [p.x, p.y, p.z, 0.0]).collect()
+        });
+        let cut = &hairdo.haircut;
+        let style = &hairdo.hairstyle;
+        let follicles = &hairdo.follicles;
+        let fringe = cut.fringe.unwrap_or_default();
+        let to3 = |v: Vec3| v.to_array();
+        let gpu = HairdoGpu {
+            guides: count,
+            points,
+            max_path,
+            key: guide_key(seed),
+            variation,
+            angle: follicles.angle,
+            angle_spread: follicles.angle_spread,
+            direction_spread: follicles.direction_spread,
+            kink: follicles.kink,
+            growth: Growth::ALL
+                .iter()
+                .position(|g| *g == field.growth)
+                .unwrap_or(0) as u32,
+            whorls: field.whorls.len() as u32,
+            fringe_falls: u32::from(hairdo.fringe_falls()),
+            center: to3(field.center),
+            lanes: match hairdo.parting() {
+                Parting::Lanes { count } => count,
+                _ => 0,
+            },
+            w0: w0.map_or([0.0; 3], |w| to3(w.point)),
+            w0_spiral: w0.map_or(0.0, |w| w.spiral),
+            w0_hand: w0.map_or(1.0, |w| w.hand),
+            w0_reach: w0.map_or(0.07, |w| w.reach),
+            w1: w1.map_or([0.0; 3], |w| to3(w.point)),
+            w1_spiral: w1.map_or(0.0, |w| w.spiral),
+            w1_hand: w1.map_or(1.0, |w| w.hand),
+            w1_reach: w1.map_or(0.07, |w| w.reach),
+            top: cut.top,
+            front: cut.front,
+            sides: cut.sides,
+            back: cut.back,
+            has_hemline: u32::from(cut.hemline.is_some()),
+            hemline: cut.hemline.unwrap_or(0.0),
+            slope: cut.slope,
+            clip: cut.clip,
+            clipper: cut.clipper,
+            fade: cut.fade,
+            strip: cut.strip,
+            has_fringe: u32::from(cut.fringe.is_some()),
+            fringe_width: fringe.width,
+            fringe_depth: fringe.depth,
+            fringe_drop: fringe.drop,
+            dome: cut.dome,
+            flow,
+            flow_value,
+            part: style.part,
+            hold: style.hold,
+            lift: style.lift,
+            volume: style.volume,
+            cling: style.cling,
+            tuck: style.tuck,
+            hairline: head.hairline,
+            recession: head.recession,
+            peak: head.peak,
+            tied: u32::from(tied.is_some()),
+            tie: tied.as_ref().map_or([0.0; 3], |t| to3(t.point)),
+            out: tied.as_ref().map_or([0.0; 3], |t| to3(t.out)),
+            axis_len: axis.len() as u32,
+        };
+        Self { gpu, axis }
+    }
+}
diff --git a/crates/fabelgeist-hair/src/gpu/lods.rs b/crates/fabelgeist-hair/src/gpu/lods.rs
new file mode 100644
index 000000000..e6ad81ce7
--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/lods.rs
@@ -0,0 +1,597 @@
+//! [`GpuGroomer::lods`]: a groom grown on the GPU made ready to draw there.
+
+use fabelgeist_compute::KernelBatch;
+use fabelgeist_compute::ScanElementCount;
+use std::sync::Arc;
+
+use crate::gpu::error::Result;
+use fabelgeist_gpu::data::gpu::buffer::{Buffer, BufferDefinition};
+use fabelgeist_gpu::data::gpu::parameters::PassParameters;
+use fabelgeist_math::Vec3;
+
+use super::grow::params;
+use super::{GpuGroom, GpuGroomer, storage, upload};
+use crate::cards::{CardAtlas, CardSettings};
+use crate::lod::LodSettings;
+use fabelgeist_gpu::prelude::BufferUse;
+
+/// One strand level on the GPU, in the shuffled order, as the renderer
+/// draws it: positions with their sky visibility in `w`, and a
+/// [`crate::lod::StrandInfo`] a strand.
+pub struct GpuLevel {
+    pub points: u32,
+    pub count: u32,
+    pub positions: Buffer,
+    pub infos: Buffer,
+}
+
+/// One cut of cards: [`crate::cards::CardVertex`] vertices and a triangle
+/// list.
+pub struct GpuCards {
+    pub cards: u32,
+    pub segments: u32,
+    pub vertices: Buffer,
+    pub indices: Buffer,
+}
+
+impl GpuCards {
+    pub fn quads(&self) -> u32 {
+        self.cards * self.segments
+    }
+
+    pub fn index_count(&self) -> u32 {
+        self.quads() * 6
+    }
+}
+
+/// A groom ready to draw at any distance, all of it on the GPU: the GPU
+/// counterpart of [`crate::HairLods`].
+pub struct GpuLods {
+    pub levels: Vec<GpuLevel>,
+    pub cards: Vec<GpuCards>,
+    pub atlas: Arc<CardAtlas>,
+    pub bounds: [Vec3; 2],
+    pub center: Vec3,
+    /// How much hair covers each vertex of the head set with
+    /// [`GpuGroomer::set_head_mesh`]: roots growing, hair over it.
+    pub cover: Option<Buffer>,
+}
+
+impl GpuLods {
+    pub fn strand_count(&self) -> usize {
+        self.levels.first().map_or(0, |l| l.count as usize)
+    }
+
+    /// How many strands, levels and card levels there are.
+    pub fn counts(&self) -> crate::lod::LodCounts {
+        crate::lod::LodCounts {
+            strands: self.strand_count(),
+            levels: self.levels.len(),
+            cards: self.cards.len(),
+        }
+    }
+}
+
+/// A grid over a box: its origin, cell and size in cells.
+#[derive(Clone, Copy)]
+struct Grid {
+    lo: Vec3,
+    cell: f32,
+    dims: [u32; 3],
+}
+
+impl Grid {
+    fn over(lo: Vec3, hi: Vec3, cell: f32) -> Self {
+        let extent = hi - lo;
+        Self {
+            lo,
+            cell,
+            dims: [extent.x, extent.y, extent.z].map(|e| ((e / cell).ceil() as u32).max(1)),
+        }
+    }
+
+    fn cells(&self) -> u32 {
+        self.dims[0] * self.dims[1] * self.dims[2]
+    }
+
+    fn insert(&self, p: &mut PassParameters, count: u32) {
+        p.insert("nx", self.dims[0]);
+        p.insert("ny", self.dims[1]);
+        p.insert("nz", self.dims[2]);
+        p.insert("count", count);
+        p.insert("lo_x", self.lo.x);
+        p.insert("lo_y", self.lo.y);
+        p.insert("lo_z", self.lo.z);
+        p.insert("cell", self.cell);
+    }
+}
+
+mod prepare;
+use prepare::{CardBuffers, CoverDensity};
+
+impl GpuGroomer {
+    /// [`GpuGroomer::lods`], the coarse levels and cards kept off `body`
+    /// (as `head_shape` lays it out), or off nothing without one.
+    pub fn lods_against(
+        &mut self,
+        groom: &GpuGroom,
+        center: Vec3,
+        settings: &LodSettings,
+        body: Option<&Buffer>,
+    ) -> Result<GpuLods> {
+        let context = self.context.clone();
+        let count = groom.strands;
+        let points = groom.points;
+        let has_body = u32::from(body.is_some());
+        let head = match body {
+            Some(body) => body.clone(),
+            None => upload(&context, &[[0.0f32; 4]; 17], "hair no body".into())?,
+        };
+        let bounds = match groom.bounds {
+            Some(bounds) => bounds,
+            None => self.measure_bounds(groom)?,
+        };
+        let mut batch = KernelBatch::labelled(&context, "hair levels");
+
+        let order = self.record_order(&context, &mut batch, groom)?;
+        // Occlusion: the hair's optical density, the body opaque, and each
+        // cell's sky visibility.
+        let pad = Vec3::splat(0.02);
+        let (lo, hi) = (bounds[0] - pad, bounds[1] + pad);
+        let resolution = settings.occlusion.resolution.max(4) as u32;
+        let occlusion = Grid::over(lo, hi, (hi - lo).max_component() / resolution as f32);
+        let visibility = storage(
+            &context,
+            (occlusion.cells() as u64 * 4).into(),
+            "hair visibility".into(),
+        )?;
+        self.record_density(
+            &mut batch,
+            groom,
+            occlusion,
+            settings.occlusion.strength,
+            has_body,
+            &head,
+        )?;
+        let density = self.scratch.density.fit(
+            &context,
+            (occlusion.cells() as u64 * 4).into(),
+            "hair density".into(),
+        )?;
+        let mut p = params! {
+            "density" => density.clone(),
+            "visibility" => visibility.clone(),
+            "directions" => settings.occlusion.directions.max(4) as u32,
+            "steps" => resolution,
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+        };
+        occlusion.insert(&mut p, count);
+        batch.dispatch_folded(&self.kernels.occlusion, &p, occlusion.cells())?;
+
+        // The strand levels.
+        let mut counts = vec![points];
+        for &p in &settings.strand_points {
+            let p = p as u32;
+            if p >= 2 && p < *counts.last().unwrap() && p <= 32 {
+                counts.push(p);
+            }
+        }
+        let mut levels = Vec::with_capacity(counts.len());
+        for &n in &counts {
+            let positions = storage(
+                &context,
+                (count as u64 * n as u64 * 16).into(),
+                "hair level positions".into(),
+            )?;
+            let infos = storage(
+                &context,
+                (count as u64 * 16).into(),
+                "hair level infos".into(),
+            )?;
+            let mut p = params! {
+                "positions" => groom.positions.clone(),
+                "strands" => groom.attributes.clone(),
+                "order" => order.clone(),
+                "grid_values" => visibility.clone(),
+                "head_shape" => head.clone(),
+                "level_positions" => positions.clone(),
+                "infos" => infos.clone(),
+                "points" => points,
+                "level_points" => n,
+                "body" => has_body,
+                "pad0" => 0u32,
+                "clearance" => 0.0012f32,
+                "pad1" => 0u32,
+                "pad2" => 0u32,
+                "pad3" => 0u32,
+            };
+            occlusion.insert(&mut p, count);
+            batch.dispatch_folded(&self.kernels.level, &p, count)?;
+            levels.push(GpuLevel {
+                points: n,
+                count,
+                positions,
+                infos,
+            });
+        }
+
+        // The cards, a cut at a time: each needs its number of cards back
+        // to size its buffers.
+        let mut cards = Vec::with_capacity(settings.cards.len());
+        for card in &settings.cards {
+            let (built, next) = self.record_cards(
+                &context,
+                batch,
+                groom,
+                card,
+                center,
+                occlusion,
+                &visibility,
+                &head,
+                has_body,
+                settings.atlas_variants,
+            )?;
+            cards.push(built);
+            batch = next;
+        }
+
+        let cover = self.record_cover(&mut batch, groom, bounds)?;
+        batch.submit();
+
+        let [w, h] = settings.atlas_size;
+        let key = (settings.atlas_variants, [w, h]);
+        let atlas = match &self.atlas {
+            Some((v, size, atlas)) if (*v, *size) == key => atlas.clone(),
+            _ => {
+                let atlas = Arc::new(CardAtlas::paint(settings.atlas_variants, w, h, 0xA71A5));
+                self.atlas = Some((key.0, key.1, atlas.clone()));
+                atlas
+            }
+        };
+        Ok(GpuLods {
+            levels,
+            cards,
+            atlas,
+            bounds,
+            center,
+            cover,
+        })
+    }
+
+    /// The box every point of `groom` is in, measured on the GPU.
+    pub fn measure_bounds(&mut self, groom: &GpuGroom) -> Result<[Vec3; 2]> {
+        let context = self.context.clone();
+        let words = self
+            .scratch
+            .box_words
+            .fit(&context, 32_u64.into(), "hair box".into())?;
+        let mut batch = KernelBatch::labelled(&context, "hair box");
+        batch.clear_buffer(&words);
+        let count = groom.strands * groom.points;
+        batch.dispatch_folded(
+            &self.kernels.bounds,
+            &params! {
+                "positions" => groom.positions.clone(),
+                "box_words" => words.clone(),
+                "count" => count,
+                "pad0" => 0u32,
+                "pad1" => 0u32,
+                "pad2" => 0u32,
+            },
+            count,
+        )?;
+        let read: Vec<(Buffer, u32)> = (0..6).map(|k| (words.clone(), k)).collect();
+        let values = self.read_words(batch, &read)?;
+        // Back from ordered words: a set top bit was a positive float.
+        let float = |key: u32| {
+            f32::from_bits(if key & 0x8000_0000 != 0 {
+                key & 0x7FFF_FFFF
+            } else {
+                !key
+            })
+        };
+        let v = |k: usize, least: bool| {
+            if least {
+                float(!values[k])
+            } else {
+                float(values[k])
+            }
+        };
+        Ok([
+            Vec3::new(v(0, true), v(1, true), v(2, true)),
+            Vec3::new(v(3, false), v(4, false), v(5, false)),
+        ])
+    }
+
+    /// Segment density into `grid`'s cells (optical density times
+    /// `strength`), the body's cells opaque when there is one, into the
+    /// density scratch.
+    fn record_density(
+        &mut self,
+        batch: &mut KernelBatch,
+        groom: &GpuGroom,
+        grid: Grid,
+        strength: f32,
+        body: u32,
+        head: &Buffer,
+    ) -> Result<()> {
+        let context = self.context.clone();
+        let deposits = self.scratch.deposits.fit(
+            &context,
+            (grid.cells() as u64 * 4).into(),
+            "hair deposits".into(),
+        )?;
+        batch.clear_buffer(&deposits);
+        let mut p = params! {
+            "positions" => groom.positions.clone(),
+            "strands" => groom.attributes.clone(),
+            "deposits" => deposits.clone(),
+            "points" => groom.points,
+            "strength" => strength,
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+        };
+        grid.insert(&mut p, groom.strands);
+        batch.dispatch_folded(&self.kernels.splat, &p, groom.strands * (groom.points - 1))?;
+        let density = self.scratch.density.fit(
+            &context,
+            (grid.cells() as u64 * 4).into(),
+            "hair density".into(),
+        )?;
+        let mut p = params! {
+            "deposits" => deposits,
+            "head_shape" => head.clone(),
+            "density" => density,
+            "body" => body,
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+            "pad2" => 0u32,
+        };
+        grid.insert(&mut p, groom.strands);
+        batch.dispatch_folded(&self.kernels.densify, &p, grid.cells())?;
+        Ok(())
+    }
+
+    /// One cut of cards. Records the locks' statistics, reads back how many
+    /// cards there are, and records building them into a new batch, which
+    /// it hands back.
+    #[allow(clippy::too_many_arguments)]
+    fn record_cards<'a>(
+        &mut self,
+        context: &'a fabelgeist_gpu::globals::WgpuContext,
+        mut batch: KernelBatch<'a>,
+        groom: &GpuGroom,
+        card: &CardSettings,
+        center: Vec3,
+        grid: Grid,
+        visibility: &Buffer,
+        head: &Buffer,
+        body: u32,
+        variants: u32,
+    ) -> Result<(GpuCards, KernelBatch<'a>)> {
+        let count = groom.strands;
+        let segments = card.segments.clamp(1, 31) as u32;
+        let rows = segments + 1;
+        let guide_of = self.scratch.card_guides.fit(
+            context,
+            (count as u64 * 4).into(),
+            "hair card locks".into(),
+        )?;
+        self.record_map(
+            &mut batch,
+            &groom.roots,
+            &groom.attributes,
+            &guide_of,
+            count,
+            groom.root_bounds,
+            card.size,
+            1.0,
+            0xCA4D,
+        )?;
+        let stride = 4 + rows as u64 * 4;
+        let locks = self.scratch.locks.fit(
+            context,
+            (count as u64 * stride * 4).into(),
+            "hair card lock stats".into(),
+        )?;
+        batch.clear_buffer(&locks);
+        let card_params = |mut p: PassParameters| {
+            p.insert("count", count);
+            p.insert("points", groom.points);
+            p.insert("segments", segments);
+            p.insert("min_strands", card.min_strands as u32);
+            p
+        };
+        batch.dispatch_folded(
+            &self.kernels.card_accumulate,
+            &card_params(params! {
+                "positions" => groom.positions.clone(),
+                "guide_of" => guide_of.clone(),
+                "locks" => locks.clone(),
+            }),
+            count,
+        )?;
+        let flags = self.scratch.flags.fit(
+            context,
+            ((count as u64 + 1) * 4).into(),
+            "hair card flags".into(),
+        )?;
+        batch.clear_buffer(&flags);
+        batch.dispatch_folded(
+            &self.kernels.card_flags,
+            &card_params(params! {
+                "locks" => locks.clone(),
+                "flags" => flags.clone(),
+            }),
+            count,
+        )?;
+        self.ensure_scan(count + 1)?;
+        self.scan.record(
+            &mut batch,
+            &flags,
+            &self.scan_scratch,
+            ScanElementCount::from_elements(count + 1),
+        )?;
+        let cards = self.read_word(batch, &flags, count)?;
+
+        let mut batch = KernelBatch::labelled(context, "hair cards");
+        batch.dispatch_folded(
+            &self.kernels.card_spread,
+            &card_params(params! {
+                "positions" => groom.positions.clone(),
+                "guide_of" => guide_of,
+                "locks" => locks.clone(),
+                "strands" => groom.attributes.clone(),
+                "center_x" => center.x,
+                "center_y" => center.y,
+                "center_z" => center.z,
+                "pad0" => 0u32,
+            }),
+            count,
+        )?;
+        let CardBuffers { vertices, indices } = CardBuffers::new(context, cards, rows, segments)?;
+        let mut p = params! {
+            "locks" => locks,
+            "slots" => flags,
+            "strands" => groom.attributes.clone(),
+            "grid_values" => visibility.clone(),
+            "head_shape" => head.clone(),
+            "card_vertices" => vertices.clone(),
+            "card_indices" => indices.clone(),
+            "count" => count,
+            "points" => groom.points,
+            "segments" => segments,
+            "min_strands" => card.min_strands as u32,
+            "body" => body,
+            "center_x" => center.x,
+            "center_y" => center.y,
+            "center_z" => center.z,
+            "size" => card.size,
+            "width_scale" => card.width_scale,
+            "variants" => variants.max(1),
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+        };
+        grid.insert(&mut p, count);
+        // The grid's `count` is the cards kernel's too: the strands.
+        p.insert("count", count);
+        batch.dispatch_folded(&self.kernels.card_build, &p, count)?;
+        Ok((
+            GpuCards {
+                cards,
+                segments,
+                vertices,
+                indices,
+            },
+            batch,
+        ))
+    }
+
+    /// How much hair covers each vertex of the head: the roots around it
+    /// (on the spatial hash grid over the roots), the hair over it (a
+    /// density grid of four millimetres), smoothed over the mesh.
+    fn record_cover(
+        &mut self,
+        batch: &mut KernelBatch,
+        groom: &GpuGroom,
+        bounds: [Vec3; 2],
+    ) -> Result<Option<Buffer>> {
+        let Some(mesh) = &self.head_mesh else {
+            return Ok(None);
+        };
+        let (vertices, head_points, head_normals, start, adjacency) = (
+            mesh.vertices,
+            mesh.points.clone(),
+            mesh.normals.clone(),
+            mesh.adjacency_start.clone(),
+            mesh.adjacency.clone(),
+        );
+        let context = self.context.clone();
+        let count = groom.strands;
+        let radius = 0.004f32;
+        self.grid.ensure_capacity(&context, count)?;
+        self.grid.record_build(batch, &groom.roots, count, radius)?;
+        let root_counts = self.scratch.root_counts.fit(
+            &context,
+            (vertices as u64 * 4).into(),
+            "hair cover roots".into(),
+        )?;
+        let totals =
+            self.scratch
+                .totals
+                .fit(&context, 16_u64.into(), "hair cover totals".into())?;
+        batch.clear_buffer(&totals);
+        let mut p = params! {
+            "points" => groom.roots.clone(),
+            "head_points" => head_points.clone(),
+            "root_counts" => root_counts.clone(),
+            "totals" => totals.clone(),
+            "count" => count,
+            "table_size" => self.grid.table_size(),
+            "inverse_cell" => self.grid.inverse_cell(),
+            "pad" => 0u32,
+            "vertices" => vertices,
+            "radius" => radius,
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+        };
+        self.grid.bind(&mut p);
+        batch.dispatch_folded(&self.kernels.cover_count, &p, vertices)?;
+
+        let reach = 0.024f32;
+        let CoverDensity { grid, density } =
+            self.record_cover_density(batch, groom, bounds, reach)?;
+        let raw =
+            self.scratch
+                .cover
+                .fit(&context, (vertices as u64 * 8).into(), "hair cover".into())?;
+        let mut p = params! {
+            "head_points" => head_points,
+            "head_normals" => head_normals,
+            "root_counts" => root_counts,
+            "totals" => totals,
+            "grid_values" => density,
+            "cover" => raw.clone(),
+            "vertices" => vertices,
+            "reach" => reach,
+            "pad0" => 0u32,
+            "pad1" => 0u32,
+        };
+        grid.insert(&mut p, count);
+        batch.dispatch_folded(&self.kernels.cover_finish, &p, vertices)?;
+
+        // Smoothed over the mesh, three passes, into a buffer of its own.
+        let spare = storage(
+            &context,
+            (vertices as u64 * 8).into(),
+            "hair cover smoothing".into(),
+        )?;
+        // Drawn from directly: the head's second vertex buffer.
+        let out = Buffer::new(
+            &context,
+            (vertices as u64 * 8).into(),
+            BufferDefinition::storage()
+                .with_usage(BufferUse::Vertex)
+                .with_label("hair head cover".into()),
+        )?;
+        let passes = [(&raw, &spare), (&spare, &raw), (&raw, &out)];
+        for (from, to) in passes {
+            batch.dispatch_folded(
+                &self.kernels.cover_smooth,
+                &params! {
+                    "adjacency_start" => start.clone(),
+                    "adjacency" => adjacency.clone(),
+                    "cover_in" => (*from).clone(),
+                    "cover_out" => (*to).clone(),
+                    "vertices" => vertices,
+                    "pad0" => 0u32,
+                    "pad1" => 0u32,
+                    "pad2" => 0u32,
+                },
+                vertices,
+            )?;
+        }
+        Ok(Some(out))
+    }
+}
diff --git a/crates/fabelgeist-hair/src/gpu/lods/prepare.rs b/crates/fabelgeist-hair/src/gpu/lods/prepare.rs
new file mode 100644
index 000000000..c0dfd4854
--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/lods/prepare.rs
@@ -0,0 +1,94 @@
+//! Native GPU layout preparation for level-of-detail passes.
+use super::*;
+pub(super) struct CoverDensity {
+    pub(super) grid: Grid,
+    pub(super) density: Buffer,
+}
+pub(super) struct CardBuffers {
+    pub(super) vertices: Buffer,
+    pub(super) indices: Buffer,
+}
+impl CardBuffers {
+    pub(super) fn new(
+        context: &fabelgeist_gpu::globals::WgpuContext,
+        cards: u32,
+        rows: u32,
+        segments: u32,
+    ) -> Result<Self> {
+        let vertices = Buffer::new(
+            context,
+            ((cards.max(1) as u64) * rows as u64 * 2 * 64).into(),
+            BufferDefinition::storage()
+                .with_usage(BufferUse::Vertex)
+                .with_label("hair card vertices".into()),
+        )?;
+        let indices = Buffer::new(
+            context,
+            ((cards.max(1) as u64) * segments as u64 * 6 * 4).into(),
+            BufferDefinition::storage()
+                .with_usage(BufferUse::Index)
+                .with_label("hair card indices".into()),
+        )?;
+        Ok(Self { vertices, indices })
+    }
+}
+impl GpuGroomer {
+    pub(super) fn record_order(
+        &mut self,
+        context: &fabelgeist_gpu::globals::WgpuContext,
+        batch: &mut KernelBatch,
+        groom: &GpuGroom,
+    ) -> Result<Buffer> {
+        let count = groom.strands;
+        // The shuffled order.
+        let keys =
+            self.scratch
+                .keys
+                .fit(context, (count as u64 * 4).into(), "hair order keys".into())?;
+        let order = storage(context, (count as u64 * 4).into(), "hair order".into())?;
+        batch.dispatch_folded(
+            &self.kernels.order_keys,
+            &params! {
+                "strands" => groom.attributes.clone(),
+                "keys" => keys.clone(),
+                "order" => order.clone(),
+                "count" => count,
+                "pad0" => 0u32,
+                "pad1" => 0u32,
+                "pad2" => 0u32,
+            },
+            count,
+        )?;
+        self.sort_scratch.ensure(context, count)?;
+        self.sort
+            .record(batch, &keys, &order, &mut self.sort_scratch, count, 32)?;
+
+        Ok(order)
+    }
+    pub(super) fn record_cover_density(
+        &mut self,
+        batch: &mut KernelBatch,
+        groom: &GpuGroom,
+        bounds: [Vec3; 2],
+        reach: f32,
+    ) -> Result<CoverDensity> {
+        let context = self.context.clone();
+        // Hair over the skin: its density on a grid of four millimetres.
+        let pad = Vec3::splat(reach + 0.004);
+        let grid = Grid::over(bounds[0] - pad, bounds[1] + pad, 0.004);
+        let grid = if grid.cells() > 32 << 20 {
+            let cell = ((bounds[1] - bounds[0] + pad * 2.0).max_component()) / 300.0;
+            Grid::over(bounds[0] - pad, bounds[1] + pad, cell)
+        } else {
+            grid
+        };
+        let head = upload(&context, &[[0.0f32; 4]; 17], "hair no body".into())?;
+        self.record_density(batch, groom, grid, 1.0, 0, &head)?;
+        let density = self.scratch.density.fit(
+            &context,
+            (grid.cells() as u64 * 4).into(),
+            "hair density".into(),
+        )?;
+        Ok(CoverDensity { grid, density })
+    }
+}
diff --git a/crates/fabelgeist-hair/src/gpu/mod.rs b/crates/fabelgeist-hair/src/gpu/mod.rs
new file mode 100644
index 000000000..6cafcad78
--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/mod.rs
@@ -0,0 +1,1562 @@
+//! Grooming on the GPU.
+//!
+//! The groom's stack is embarrassingly parallel -- every operation after
+//! interpolation works on each strand alone, and a head is a hundred
+//! thousand strands of up to two hundred and fifty-six points -- so it runs
+//! as compute kernels, and what it grows stays on the GPU: the renderer
+//! draws the levels of detail straight from the buffers the kernels wrote.
+//!
+//! [`GpuGroomer`] holds the kernels, on the compute layer: one
+//! [`KernelBatch`] a groom (every dispatch into one encoder, one submit),
+//! [`PrefixSum`] to compact the roots and the cards, its
+//! [`RadixSort`] for the shuffled strand order the levels of detail share,
+//! and its spatial hash grid for the roots about each vertex of the head.
+//! The kernels themselves ([`wgsl`]) mirror the host operations in
+//! [`crate::ops`] line for line; the host operations remain, the reference
+//! the kernels are checked against and the path for a machine without a
+//! GPU.
+//!
+//! * [`GpuGroomer::grow_look`] grows a [`crate::Look`] whole, and
+//!   [`GpuGroomer::grow`] any [`Groom`] from [`Guides`]: a hairdo's, grown
+//!   there, or the host's. A hairdo's guide roots are placed as the host
+//!   places them -- candidates hashed by index, kept greedily in order by
+//!   one workgroup -- and each guide is combed by a workgroup of its own,
+//!   its lanes sampling the head's field together and drawing the same
+//!   numbers as the host ([`crate::rng::Stream`]), so the guides come out
+//!   as the host's to a micrometre or so. The operations before
+//!   interpolation (the drape, a solve per strand, with a strand's joints
+//!   in workgroup memory; the shrinkwrap) run on the guides, the rest on
+//!   the strands.
+//! * [`GpuGroomer::cut_scalp`] cuts the scalp they grow on ([`GpuScalp`]):
+//!   surface nets over the head's field and the part above the hairline,
+//!   to the host's own triangles, in the host's order -- a count, a scan
+//!   and an emit for the triangles, vertices numbered by where they are
+//!   first used, the running area added up in the host's order, the open
+//!   edges found by sorting. [`GpuGroomer::upload_scalp`] takes any other
+//!   (DiffLocks' `scalp.ply`, say). Roots are placed by area over the scalp
+//!   in one pass -- each triangle its share, spread by a low-discrepancy
+//!   sequence -- thinned by the density masks and compacted by a scan.
+//!   Clump guides are chosen on a grid, the lowest-hashed strand of each
+//!   cell leading it. A strand sampling its guide walks the guide from the
+//!   root, transporting its frame as it goes, so no frames are stored.
+//! * [`GpuGroomer::lods`] prepares a grown groom for drawing: sorted into
+//!   the shuffled order, occlusion baked into a volume and every point,
+//!   each strand level resampled (and kept off the head), the cards cut
+//!   from the locks, and how much hair covers each vertex of the head.
+//! * [`GpuGroomer::simulate`] makes real-time physics for it ([`GpuSim`]):
+//!   [`crate::sim::HairSim`]'s rods, bound and stepped where they are
+//!   drawn, a substep a dispatch (an invocation a strand solving its own
+//!   implicit steps), and meeting each other -- the volume and
+//!   friction on a density grid in the head's frame, collisions found by
+//!   samples sorted into a grid of cells and resolved segment against
+//!   segment. [`GpuGroomer::resimulate`] moves it to another level of
+//!   detail, its motion carried across.
+//! * [`GpuGroomer::upload`] brings strands made elsewhere -- a DiffLocks
+//!   sample, a host groom -- to the GPU, to prepare and draw the same way.
+//!
+//! A sweep along a strand keeps its points in registers or in the kernel's
+//! own output, never in a large local array: dynamically indexed
+//! `array<vec3<f32>, 32>`s came out differently from run to run on the same
+//! input, and the tests grow every groom twice to hold that down.
+//!
+//! ```no_run
+//! # fn main() -> anyhow::Result<()> {
+//! use fabelgeist_hair::gpu::{GpuGroomer, headless_context};
+//! use fabelgeist_hair::{Head, LodSettings, Look, Preset};
+//!
+//! let mut groomer = GpuGroomer::new(headless_context()?)?;
+//! let look = Look::new(Preset::Afro);
+//! let head = look.head(&Head::mannequin());
+//! // The scalp, cut once for as long as the hairline stays.
+//! let scalp = groomer.cut_scalp(&head, 0.004)?;
+//! let grown = groomer.grow_look(&look, &head, &scalp)?;
+//! let lods = groomer.lods(&grown, head.cranium.center, &LodSettings::default())?;
+//! // `HairRenderer::set_gpu_groom(&lods)` draws it; `grown.read(..)` has
+//! // the strands back on the host, to write out.
+//! # Ok(())
+//! # }
+//! ```
+
+mod buffers;
+pub mod error;
+use crate::identity::PartingGroup;
+use crate::identity::StrandId;
+use buffers::{Scratch, storage, upload};
+use fabelgeist_compute::ScanElementCount;
+mod collide;
+mod grow;
+mod guides;
+mod lods;
+mod scalp;
+mod sim;
+pub mod wgsl;
+
+use std::sync::Arc;
+
+use crate::gpu::error::{HairGpuError, Result};
+use fabelgeist_compute::{
+    Kernel, KernelBatch, KernelCache, PrefixSum, PrefixSumScratch, RadixSort, SortScratch,
+};
+use fabelgeist_gpu::data::gpu::buffer::Buffer;
+use fabelgeist_gpu::globals::WgpuContext;
+use fabelgeist_math::Vec3;
+use fabelgeist_spatial_hash::gpu::{GpuHashGrid, HashKernels};
+
+use crate::cards::CardAtlas;
+use crate::head::Head;
+use crate::strands::{Attachment, Strands};
+use crate::surface::Surface;
+
+pub use collide::FieldHeader;
+pub use guides::{GpuGuides, Guides};
+pub use lods::{GpuCards, GpuLevel, GpuLods};
+pub use scalp::GpuScalp;
+pub use sim::GpuSim;
+
+/// A strand's per-strand data on the GPU.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Default, bytemuck::Pod, bytemuck::Zeroable)]
+pub struct StrandGpu {
+    pub normal: [f32; 3],
+    pub id: u32,
+    pub uv: [f32; 2],
+    pub group: i32,
+    pub radius: f32,
+}
+
+/// A groom grown on the GPU, and still there.
+pub struct GpuGroom {
+    pub strands: u32,
+    pub points: u32,
+    /// Strand-major, `xyz` a point.
+    pub positions: Buffer,
+    /// [`StrandGpu`] a strand.
+    pub attributes: Buffer,
+    /// Each strand's root, `w` how far in from the hairline (0 to 1).
+    pub roots: Buffer,
+    /// A box the hair is inside, when it is known on the host (strands
+    /// brought from there); otherwise measured on the GPU when needed.
+    pub bounds: Option<[Vec3; 2]>,
+    /// A box the roots are inside.
+    pub root_bounds: [Vec3; 2],
+    /// Grown against the mannequin: coarse levels are kept off it.
+    pub head: Option<Head>,
+    /// The guides it was grown from.
+    pub guides: Option<GpuGuides>,
+}
+
+/// The mannequin's shapes, as the kernels' `head_shape` reads them.
+pub fn head_shape(head: &Head) -> Vec<[f32; 4]> {
+    let e = |c: Vec3| [c.x, c.y, c.z, 0.0];
+    vec![
+        e(head.cranium.center),
+        e(head.cranium.radii),
+        e(head.jaw.center),
+        e(head.jaw.radii),
+        e(head.nose.center),
+        e(head.nose.radii),
+        e(head.ears[0].center),
+        e(head.ears[0].radii),
+        e(head.ears[1].center),
+        e(head.ears[1].radii),
+        [
+            head.neck.a.x,
+            head.neck.a.y,
+            head.neck.a.z,
+            head.neck.radius,
+        ],
+        e(head.neck.b),
+        e(head.shoulders.center),
+        e(head.shoulders.radii),
+        e(head.chest.center),
+        e(head.chest.radii),
+        [head.base, 0.0, 0.0, 0.0],
+    ]
+}
+
+struct Kernels {
+    roots: Arc<Kernel>,
+    roots_compact: Arc<Kernel>,
+    interp_select: Arc<Kernel>,
+    interp_points: Arc<Kernel>,
+    orient: Arc<Kernel>,
+    trim: Arc<Kernel>,
+    map_candidates: Arc<Kernel>,
+    map_assign: Arc<Kernel>,
+    clump: Arc<Kernel>,
+    curl: Arc<Kernel>,
+    wave: Arc<Kernel>,
+    noise: Arc<Kernel>,
+    frizz: Arc<Kernel>,
+    smooth: Arc<Kernel>,
+    shrinkwrap: Arc<Kernel>,
+    profile: Arc<Kernel>,
+    order_keys: Arc<Kernel>,
+    splat: Arc<Kernel>,
+    densify: Arc<Kernel>,
+    occlusion: Arc<Kernel>,
