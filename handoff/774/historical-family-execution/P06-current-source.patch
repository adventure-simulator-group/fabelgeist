+    #[test]
+    fn the_transpose_undoes_a_rotation() {
+        let r = DMat3::from_axis_angle(DVec3::new(1.0, 2.0, 3.0), 0.7);
+        let v = DVec3::new(-4.0, 5.0, 0.25);
+        assert!(close(r.transpose() * (r * v), v));
+    }
+}
