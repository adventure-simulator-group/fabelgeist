index 000000000..b7e0af8cf
--- /dev/null
+++ b/crates/fabelgeist-hair/src/ops/clump.rs
@@ -0,0 +1,233 @@
+//! `Clump Hair Curves_V2`: strands gathering into locks.
+//!
+//! Every strand is pulled towards its clump guide ([`GuideMap`]). At each
+//! point, at its own factor along its length, the guide is sampled at the
+//! same factor; the strand's root offset from the guide's root, taken in the
+//! guide's root frame, is carried along in the guide's frame there, so that
+//! with no pull a strand runs parallel to its guide. The pull mixes the
+//! point towards that parallel position shrunk by the falloff `f =
+//! shape_range(factor, Shape)` -- towards the guide itself where `f` is
+//! one -- plus the tip spread (a random offset per strand in the guide's tip
+//! frame) and the clump offset (one per clump), both grown by `f`. The mix
+//! is `f * Factor`, faded by the root's distance from the guide's
+//! (`Distance Threshold`, `Distance Falloff`).
+//!
+//! Twist then turns each point about the guide's tangent through the
+//! guide's point, by an angle growing with arc length (radians per metre),
+//! randomised per clump by `Twist Random Clump`. `Preserve Length` restores
+//! the segment lengths afterwards.
+
+use fabelgeist_math::Vec3;
+use rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::noise;
+use crate::ops::{GuideMap, parameters, restore_lengths, shape_range, smoothstep};
+use crate::rng;
+use crate::strands::{Strands, rotate};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Clump {
+    /// Clump guides are at least this far apart at the root.
+    pub guide_distance: f32,
+    /// Chance a strand is a candidate guide.
+    pub guide_mask: f32,
+    /// Reuse the clumps an earlier operation chose (`Existing Guide Map`).
+    pub reuse_guide_map: bool,
+    pub factor: f32,
+    /// Falloff along the strand: 0 clumps all along, 0.5 grows linearly to
+    /// the tip, towards 1 only the tips gather.
+    pub shape: f32,
+    /// Radians per metre of arc length.
+    pub twist: f32,
+    /// How much of the twist is random per clump.
+    pub twist_random: f32,
+    pub twist_factor: f32,
+    /// How far tips stray from their clump, metres.
+    pub tip_spread: f32,
+    /// How far each clump's tips stray from its guide, metres.
+    pub clump_offset: f32,
+    /// Roots within the threshold of their guide's clump fully; the pull
+    /// fades out over the falloff beyond it.
+    pub distance_falloff: f32,
+    pub distance_threshold: f32,
+    pub preserve_length: bool,
+    pub seed: i32,
+    /// Strands shorter than this barely clump, fading in to twice it:
+    /// clumped stubble is a honeycomb, not hair.
+    #[serde(default)]
+    pub min_length: f32,
+}
+
+impl Default for Clump {
+    fn default() -> Self {
+        Self {
+            guide_distance: 0.01,
+            guide_mask: 1.0,
+            reuse_guide_map: false,
+            factor: 1.0,
+            shape: 0.5,
+            twist: 0.0,
+            twist_random: 0.0,
+            twist_factor: 1.0,
+            tip_spread: 0.0,
+            clump_offset: 0.0,
+            distance_falloff: 0.0,
+            distance_threshold: 0.0,
+            preserve_length: false,
+            seed: 0,
+            min_length: 0.0,
+        }
+    }
+}
+
+impl Clump {
+    pub fn apply(&self, strands: &mut Strands) {
+        let seed = rng::seed(self.seed, 148_762);
+        let map = GuideMap::get(
+            strands,
+            self.reuse_guide_map,
+            self.guide_distance,
+            self.guide_mask,
+            seed,
+        );
+        let samplers = map.samplers(strands);
+        let reference = strands.positions.clone();
+        let points = strands.points;
+        let ids = &strands.id;
+        let normals = &strands.root_normal;
+
+        strands
+            .positions
+            .par_chunks_mut(points)
+            .enumerate()
+            .for_each_init(
+                || (Vec::new(), Vec::new()),
+                |(lengths, factors), (s, strand)| {
+                    let g = map.guide[s] as usize;
+                    let Some(guide) = samplers[g].as_ref() else {
+                        return;
+                    };
+                    let root = reference[s * points];
+                    let guide_root = guide.at_factor(0.0);
+                    let offset = root - guide_root.position;
+                    // The root's offset lies in the scalp; the guide leaves
+                    // the scalp nearly along it. Across the flow stays
+                    // across; along the flow becomes depth -- so a patch of
+                    // roots becomes a round lock rather than a flat one.
+                    let scalp = normals[g];
+                    let t0 = guide_root.tangent;
+                    let across = crate::strands::safe_normalize(t0.cross(scalp), guide_root.normal);
+                    let along = crate::strands::safe_normalize(t0 - scalp * t0.dot(scalp), t0);
+                    let depth =
+                        crate::strands::safe_normalize(across.cross(t0), guide_root.binormal());
+                    let placed = across * offset.dot(across) + depth * offset.dot(along);
+                    let x = guide_root.normal.dot(placed);
+                    let y = guide_root.binormal().dot(placed);
+
+                    // What the tips gather to, in the guide's tip frame.
+                    let tip = guide.at_factor(1.0);
+                    let mut gather = Vec3::default();
+                    if self.tip_spread != 0.0 {
+                        let r = rng::signed_vec3((ids[s]).word(), seed) * self.tip_spread;
+                        gather += tip.normal * r.x + tip.binormal() * r.y + tip.tangent * r.z;
+                    }
+                    if self.clump_offset != 0.0 {
+                        let r =
+                            rng::signed_vec3((ids[g]).word(), seed ^ 0x0FF5) * self.clump_offset;
+                        gather += tip.normal * r.x + tip.binormal() * r.y;
+                    }
+
+                    let d = offset.length();
+                    let weight = if self.distance_threshold != 0.0 && self.distance_falloff == 0.0 {
+                        if d <= self.distance_threshold {
+                            1.0
+                        } else {
+                            0.0
+                        }
+                    } else {
+                        1.0 - smoothstep(
+                            self.distance_threshold,
+                            self.distance_threshold + self.distance_falloff,
+                            d,
+                        )
+                    };
+                    let clump_random = noise::white(Vec3::new(g as f32, 0.0, 0.0));
+
+                    parameters(strand, lengths, factors);
+                    let weight = if self.min_length > 0.0 {
+                        let length = lengths.last().copied().unwrap_or(0.0);
+                        weight * smoothstep(self.min_length, 2.0 * self.min_length, length)
+                    } else {
+                        weight
+                    };
+                    // The root stays in its follicle.
+                    for (j, p) in strand.iter_mut().enumerate().skip(1) {
+                        let t = factors[j];
+                        let f = shape_range(t, 0.0, 1.0, self.shape, 2.0);
+                        let at = guide.at_factor(t);
+                        let parallel = at.normal * x + at.binormal() * y;
+                        let target = at.position + parallel * (1.0 - f) + gather * f;
+                        let mix = f * self.factor * weight;
+                        *p = p.lerp(target, mix);
+
+                        let base = lengths[j] * self.twist;
+                        let angle = self.twist_factor
+                            * (base + (base * clump_random - base) * self.twist_random);
+                        if angle != 0.0 {
+                            *p = at.position + rotate(*p - at.position, at.tangent, angle);
+                        }
+                    }
+                    if self.preserve_length {
+                        restore_lengths(strand, &reference[s * points..(s + 1) * points], 1.0);
+                    }
+                },
+            );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::identity::{PartingGroup, StrandId};
+    use crate::strands::Attachment;
+
+    /// Parallel straight strands on a line of roots.
+    fn comb(n: usize) -> Strands {
+        let mut strands = Strands::new(16);
+        for i in 0..n {
+            let x = i as f32 * 0.002;
+            let positions: Vec<Vec3> = (0..16)
+                .map(|j| Vec3::new(x, -(j as f32) * 0.01, 0.0))
+                .collect();
+            strands.push(
+                &positions,
+                Attachment {
+                    normal: Vec3::up(),
+                    id: StrandId::from_word(i as u32),
+                    group: PartingGroup::Unassigned,
+                    ..Default::default()
+                },
+            );
+        }
+        strands
+    }
+
+    #[test]
+    fn tips_gather_to_their_guide_and_roots_stay() {
+        let mut strands = comb(20);
+        let before = strands.clone();
+        Clump {
+            guide_distance: 0.05,
+            ..Default::default()
+        }
+        .apply(&mut strands);
+        let map = strands.guide_map.clone().unwrap();
+        assert_eq!(map.guides.len(), 1);
+        let guide_tip = strands.strand(map.guides[0] as usize)[15];
+        for s in 0..strands.len() {
+            assert!((strands.root(s) - before.root(s)).length() < 1e-6);
+            assert!((strands.strand(s)[15] - guide_tip).length() < 1e-4);
+        }
+    }
+}
diff --git a/crates/fabelgeist-hair/src/ops/curl.rs b/crates/fabelgeist-hair/src/ops/curl.rs
new file mode 100644
index 000000000..e1a91a5e0
--- /dev/null
+++ b/crates/fabelgeist-hair/src/ops/curl.rs
@@ -0,0 +1,141 @@
+//! `Curl Hair Curves`: ringlets.
+//!
+//! Strands curl in locks: each follows its clump guide ([`GuideMap`]),
+//! sampled at the same arc length, around a circle in the guide's frame
+//! there. The angle grows with the strand's own arc length, `Frequency`
+//! times three turns a metre, from a phase random per clump plus a little
+//! random per strand (`Random Offset` turns at most). The radius runs from
+//! `Factor Start` to `Factor End` of `Radius` along the strand, and the curl
+//! eases in over the first `Curl Start` of it (smootherstep, then square
+//! root). A strand moves to guide point plus circle, by `Factor` -- so a
+//! clump curls together, a guide around its own path and its strands along
+//! with it.
+//!
+//! Where it departs: the node group can subdivide strands first
+//! (`Subdivision`) for points enough to draw the curl; strands here keep
+//! their point count, which a groom sets for the tightest curl it wants.
+
+use rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::ops::{GuideMap, parameters, smootherstep};
+use crate::rng;
+use crate::strands::Strands;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Curl {
+    pub guide_distance: f32,
+    pub guide_mask: f32,
+    pub reuse_guide_map: bool,
+    pub factor: f32,
+    /// Share of the strand over which the curl eases in.
+    pub curl_start: f32,
+    /// Metres.
+    pub radius: f32,
+    pub factor_start: f32,
+    pub factor_end: f32,
+    /// Three turns a metre per unit.
+    pub frequency: f32,
+    /// Turns a strand's phase may differ from its clump's.
+    pub random_offset: f32,
+    pub seed: i32,
+}
+
+impl Default for Curl {
+    fn default() -> Self {
+        Self {
+            guide_distance: 0.1,
+            guide_mask: 1.0,
+            reuse_guide_map: true,
+            factor: 1.0,
+            curl_start: 0.1,
+            radius: 0.1,
+            factor_start: 1.0,
+            factor_end: 1.0,
+            frequency: 1.0,
+            random_offset: 0.25,
+            seed: 0,
+        }
+    }
+}
+
+impl Curl {
+    pub fn apply(&self, strands: &mut Strands) {
+        let seed = rng::seed(self.seed, 91_487);
+        let map = GuideMap::get(
+            strands,
+            self.reuse_guide_map,
+            self.guide_distance,
+            self.guide_mask,
+            seed,
+        );
+        let samplers = map.samplers(strands);
+        let points = strands.points;
+        let ids = &strands.id;
+        let turns_per_metre = self.frequency * 3.0;
+
+        strands
+            .positions
+            .par_chunks_mut(points)
+            .enumerate()
+            .for_each_init(
+                || (Vec::new(), Vec::new()),
+                |(lengths, factors), (s, strand)| {
+                    let g = map.guide[s] as usize;
+                    let Some(guide) = samplers[g].as_ref() else {
+                        return;
+                    };
+                    parameters(strand, lengths, factors);
+                    let phase0 = rng::unit((ids[g]).word(), seed) * 3.9
+                        + rng::unit((ids[s]).word(), seed ^ 0xC0FF) * self.random_offset;
+                    // The root stays attached whatever the ease.
+                    for (j, p) in strand.iter_mut().enumerate().skip(1) {
+                        let t = factors[j];
+                        let phase = (lengths[j] * turns_per_metre + phase0) * std::f32::consts::TAU;
+                        let radius = self.radius
+                            * (self.factor_start + (self.factor_end - self.factor_start) * t);
+                        let (sin, cos) = phase.sin_cos();
+                        let at = guide.at_length(lengths[j]);
+                        let circle = at.normal * (sin * radius) + at.binormal() * (cos * radius);
+                        let ease = smootherstep(-1e-5, self.curl_start, t).sqrt();
+                        *p += (at.position - *p + circle) * (ease * self.factor);
+                    }
+                },
+            );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::strands::Attachment;
+    use fabelgeist_math::Vec3;
+
+    #[test]
+    fn a_lone_strand_becomes_a_helix_of_the_radius() {
+        let mut strands = Strands::new(200);
+        let positions: Vec<Vec3> = (0..200)
+            .map(|j| Vec3::new(0.0, -(j as f32) * 0.002, 0.0))
+            .collect();
+        strands.push(
+            &positions,
+            Attachment {
+                normal: Vec3::up(),
+                ..Default::default()
+            },
+        );
+        Curl {
+            radius: 0.01,
+            frequency: 10.0,
+            curl_start: 0.0,
+            random_offset: 0.0,
+            ..Default::default()
+        }
+        .apply(&mut strands);
+        // Away from the root, every point is a radius from the old axis.
+        for p in &strands.strand(0)[20..] {
+            let r = (p.x * p.x + p.z * p.z).sqrt();
+            assert!((r - 0.01).abs() < 1e-3, "{r}");
+        }
+    }
+}
diff --git a/crates/fabelgeist-hair/src/ops/displace.rs b/crates/fabelgeist-hair/src/ops/displace.rs
new file mode 100644
index 000000000..9dd77d5d2
--- /dev/null
+++ b/crates/fabelgeist-hair/src/ops/displace.rs
@@ -0,0 +1,335 @@
+//! Displacements along each strand's own frame: `Frizz Hair Curves`, `Hair
+//! Curves Noise` and `Smooth Hair Curves`.
+//!
+//! Frizz and noise both build an offset per point in the strand's frame
+//! (tangent, binormal, normal), scaled by `Factor * Distance`. Frizz draws
+//! it at random per point; noise samples 3D Perlin noise at the root's
+//! position (times `Scale`), moved along one axis by the arc length (times
+//! `Scale along Curve`) and a random amount per strand (`Offset per Curve`)
+//! -- so neighbouring strands wave together. With `Cumulative Offset` the
+//! offsets are summed from the root out (each point's own counted half), a
+//! walk rather than a jitter; either way the root's own offset is taken
+//! away, and the result is faded in along the strand by
+//! `shape_range(factor, Shape)`.
+
+use fabelgeist_math::Vec3;
+use rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::noise;
+use crate::ops::{parameters, restore_lengths, shape_range};
+use crate::rng;
+use crate::strands::{Strands, blur, normals, tangents};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Frizz {
+    pub cumulative: bool,
+    pub factor: f32,
+    /// Metres.
+    pub distance: f32,
+    pub shape: f32,
+    pub preserve_length: bool,
+    pub seed: i32,
+    /// Share of strands that frizz fully; the rest frizz `calm` times as
+    /// much. Real hair has a few flyaways, not a halo (1 frizzes all, as
+    /// Blender's node does).
+    #[serde(default = "one")]
+    pub share: f32,
+    #[serde(default = "one")]
+    pub calm: f32,
+    /// Turns of the frizz a metre along the strand: smooth wandering in
+    /// place of Blender's new direction at every point (0).
+    #[serde(default)]
+    pub frequency: f32,
+}
+
+fn one() -> f32 {
+    1.0
+}
+
+impl Default for Frizz {
+    fn default() -> Self {
+        Self {
+            cumulative: true,
+            factor: 1.0,
+            distance: 0.01,
+            shape: 0.5,
+            preserve_length: false,
+            seed: 0,
+            share: 1.0,
+            calm: 1.0,
+            frequency: 0.0,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Noise {
+    pub cumulative: bool,
+    pub factor: f32,
+    /// Metres.
+    pub distance: f32,
+    pub shape: f32,
+    /// Noise cells a metre across the scalp (times the node's fixed 5).
+    pub scale: f32,
+    /// Noise cells a metre along a strand (times the node's fixed 5).
+    pub scale_along_curve: f32,
+    pub offset_per_curve: f32,
+    pub preserve_length: bool,
+    pub seed: i32,
+}
+
+impl Default for Noise {
+    fn default() -> Self {
+        Self {
+            cumulative: true,
+            factor: 1.0,
+            distance: 0.01,
+            shape: 0.5,
+            scale: 1.0,
+            scale_along_curve: 1.0,
+            offset_per_curve: 0.0,
+            preserve_length: false,
+            seed: 0,
+        }
+    }
+}
+
+/// Add frame-space offsets to a strand, walked from the root if
+/// `cumulative`, faded in by `shape`.
+fn displace(
+    strand: &mut [Vec3],
+    offsets: &mut [Vec3],
+    factors: &[f32],
+    cumulative: bool,
+    shape: f32,
+) {
+    let root = offsets[0];
+    if cumulative {
+        let mut trailing = Vec3::default();
+        for o in offsets.iter_mut() {
+            let v = *o;
+            let leading = trailing + v;
+            *o = (leading + trailing - root) * 0.5;
+            trailing = leading;
+        }
+    } else {
+        for o in offsets.iter_mut() {
+            *o -= root;
+        }
+    }
+    for (j, p) in strand.iter_mut().enumerate() {
+        *p += offsets[j] * shape_range(factors[j], 0.0, 1.0, shape, 2.0);
+    }
+}
+
+impl Frizz {
+    pub fn apply(&self, strands: &mut Strands) {
+        let seed = rng::seed(self.seed, 64_785);
+        let scale = self.factor * self.distance;
+        let points = strands.points;
+        let reference = self.preserve_length.then(|| strands.positions.clone());
+        let ids = &strands.id;
+        strands
+            .positions
+            .par_chunks_mut(points)
+            .enumerate()
+            .for_each_init(
+                || (Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new()),
+                |(lengths, factors, t, n, offsets), (s, strand)| {
+                    parameters(strand, lengths, factors);
+                    tangents(strand, t);
+                    normals(t, n);
+                    offsets.clear();
+                    let wild = rng::unit((ids[s]).word(), seed ^ 0xF1A7) < self.share;
+                    let scale = if wild { scale } else { scale * self.calm };
+                    if scale == 0.0 {
+                        return;
+                    }
+                    let origin = rng::signed_vec3((ids[s]).word(), seed ^ 0x0F75) * 50.0;
+                    for j in 0..points {
+                        let r = if self.frequency > 0.0 {
+                            // A smooth wander: noise along the strand, the
+                            // step between neighbours small.
+                            let q = origin + Vec3::new(0.0, 0.0, lengths[j] * self.frequency);
+                            let c = noise::noise_color(q, 1.0) - Vec3::splat(0.5);
+                            c * (2.0 * scale * lengths[1].max(1e-6) * self.frequency)
+                        } else {
+                            rng::signed_vec3(rng::hash((ids[s]).word(), j as u32), seed) * scale
+                        };
+                        let b = t[j].cross(n[j]);
+                        offsets.push(t[j] * r.x + b * r.y + n[j] * r.z);
+                    }
+                    displace(strand, offsets, factors, self.cumulative, self.shape);
+                    if let Some(reference) = &reference {
+                        restore_lengths(strand, &reference[s * points..(s + 1) * points], 1.0);
+                    }
+                },
+            );
+    }
+}
+
+impl Noise {
+    pub fn apply(&self, strands: &mut Strands) {
+        let seed = rng::seed(self.seed, 368_741);
+        let scale = self.factor * self.distance;
+        let points = strands.points;
+        let reference = self.preserve_length.then(|| strands.positions.clone());
+        let ids = &strands.id;
+        let origin = rng::signed_vec3(self.seed as u32, seed) * 100.0;
+        strands
+            .positions
+            .par_chunks_mut(points)
+            .enumerate()
+            .for_each_init(
+                || (Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new()),
+                |(lengths, factors, t, n, offsets), (s, strand)| {
+                    parameters(strand, lengths, factors);
+                    tangents(strand, t);
+                    normals(t, n);
+                    let base = strand[0] * self.scale + origin;
+                    let along = rng::signed((ids[s]).word(), seed) * self.offset_per_curve;
+                    offsets.clear();
+                    for j in 0..points {
+                        let z = lengths[j] * self.scale_along_curve + along;
+                        let c = noise::noise_color(base + Vec3::new(0.0, 0.0, z), 5.0);
+                        let r = (c - Vec3::splat(0.5)) * (2.0 * scale);
+                        let b = t[j].cross(n[j]);
+                        offsets.push(t[j] * r.x + b * r.y + n[j] * r.z);
+                    }
+                    displace(strand, offsets, factors, self.cumulative, self.shape);
+                    if let Some(reference) = &reference {
+                        restore_lengths(strand, &reference[s * points..(s + 1) * points], 1.0);
+                    }
+                },
+            );
+    }
+}
+
+/// `Smooth Hair Curves`: average each point with its neighbours, root held.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Smooth {
+    pub iterations: usize,
+    pub factor: f32,
+    pub preserve_length: bool,
+}
+
+impl Default for Smooth {
+    fn default() -> Self {
+        Self {
+            iterations: 5,
+            factor: 1.0,
+            preserve_length: true,
+        }
+    }
+}
+
+impl Smooth {
+    pub fn apply(&self, strands: &mut Strands) {
+        let points = strands.points;
+        let weight = vec![self.factor; points];
+        let reference = self.preserve_length.then(|| strands.positions.clone());
+        strands
+            .positions
+            .par_chunks_mut(points)
+            .enumerate()
+            .for_each(|(s, strand)| {
+                // The tip may move too; only the root is pinned.
+                let tip = strand.len() - 1;
+                let extended_tip = strand[tip] * 2.0 - strand[tip - 1];
+                let mut values: Vec<Vec3> = strand.to_vec();
+                values.push(extended_tip);
+                blur(&mut values, self.iterations, &weight);
+                strand.copy_from_slice(&values[..points]);
+                if let Some(reference) = &reference {
+                    restore_lengths(strand, &reference[s * points..(s + 1) * points], 1.0);
+                }
+            });
+    }
+}
+
+/// Waves: hair that is neither straight nor curled, bending side to side in
+/// the plane it lies in -- across the strand and along the head, so a lock
+/// of wavy hair ripples rather than spirals. Not one of DiffLocks' node
+/// groups (its curls are all helices); waves are what most hair is.
+///
+/// Each point moves across its strand by `amplitude` times a sine of its
+/// arc length over `wavelength`, eased in from `start` of the way along.
+/// The phase is shared by a lock (the guide map, as the curl uses) and
+/// jittered per strand, and segment lengths are restored, so a wavy strand
+/// is as long as a straight one and hangs shorter.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Wave {
+    /// Metres either side.
+    pub amplitude: f32,
+    /// Metres from crest to crest.
+    pub wavelength: f32,
+    /// Share of the strand before the waves start.
+    pub start: f32,
+    /// Locks that wave together are this far apart at the root.
+    pub guide_distance: f32,
+    pub reuse_guide_map: bool,
+    /// Turns a strand's phase may stray from its lock's.
+    pub random_phase: f32,
+    pub seed: i32,
+}
+
+impl Default for Wave {
+    fn default() -> Self {
+        Self {
+            amplitude: 0.01,
+            wavelength: 0.07,
+            start: 0.15,
+            guide_distance: 0.02,
+            reuse_guide_map: true,
+            random_phase: 0.08,
+            seed: 0,
+        }
+    }
+}
+
+impl Wave {
+    pub fn apply(&self, strands: &mut Strands) {
+        let seed = rng::seed(self.seed, 0x3A7E);
+        let map = crate::ops::GuideMap::get(
+            strands,
+            self.reuse_guide_map,
+            self.guide_distance,
+            1.0,
+            seed,
+        );
+        let points = strands.points;
+        let reference = strands.positions.clone();
+        let ids = &strands.id;
+        let normals_at_root = &strands.root_normal;
+        strands
+            .positions
+            .par_chunks_mut(points)
+            .enumerate()
+            .for_each_init(
+                || (Vec::new(), Vec::new(), Vec::new()),
+                |(lengths, factors, t), (s, strand)| {
+                    parameters(strand, lengths, factors);
+                    tangents(strand, t);
+                    let lock = ids[map.guide[s] as usize];
+                    let phase = (rng::unit((lock).word(), seed)
+                        + rng::signed((ids[s]).word(), seed ^ 0x51) * self.random_phase)
+                        * std::f32::consts::TAU;
+                    let out = normals_at_root[s];
+                    for j in 1..points {
+                        let across = crate::strands::safe_normalize(
+                            t[j].cross(out),
+                            crate::strands::orthogonal(t[j]),
+                        );
+                        let ease =
+                            crate::ops::smoothstep(self.start * 0.5, self.start + 0.1, factors[j]);
+                        let wave = (lengths[j] / self.wavelength.max(1e-3) * std::f32::consts::TAU
+                            + phase)
+                            .sin();
+                        strand[j] += across * (self.amplitude * ease * wave);
+                    }
+                    restore_lengths(strand, &reference[s * points..(s + 1) * points], 1.0);
+                },
+            );
+    }
+}
diff --git a/crates/fabelgeist-hair/src/ops/interpolate.rs b/crates/fabelgeist-hair/src/ops/interpolate.rs
new file mode 100644
index 000000000..3c00e9a36
--- /dev/null
+++ b/crates/fabelgeist-hair/src/ops/interpolate.rs
@@ -0,0 +1,433 @@
+//! `Interpolate Hair Curves V2`: from a few guides to a full head of hair.
+//!
+//! The node group scatters points over the scalp -- Poisson-disk, as dense
+//! as `Density` asks, thinned by a density mask (DiffLocks' balding patterns)
+//! -- and grows a strand from each by `Interpolate Curves`: the shapes of the
+//! nearest guides (`Interpolation Guides` of them, only those in the same
+//! parting group), each taken relative to its own root and blended by
+//! distance, placed at the new root. With `Follow Surface Normal` each
+//! guide's shape is first turned from its root's normal to the new root's,
+//! so a shape combed on the crown still lies along the head at the temple.
+//! Strands closer than `Distance to Guides` to a guide's root are dropped.
+//!
+//! Where it departs: the node group takes a density per unit area; here the
+//! stack asks for a strand count (the dataset's "~100K strands") and the
+//! Poisson radius follows from it and the scalp's area. And it blends only
+//! guides that agree ([`Interpolate::divergence`]): the mean of a guide
+//! combed left and one combed right is a strand combed straight down
+//! between them -- across the face, from the front hairline -- where real
+//! hair would part and go one way or the other.
+
+use crate::identity::PartingGroup;
+use crate::identity::StrandId;
+use fabelgeist_math::Vec3;
+use rayon::prelude::*;
+use serde::{Deserialize, Serialize};
+
+use crate::grid::PointGrid;
+use crate::ops::Context;
+use crate::rng::{self, Rng};
+use crate::strands::{Attachment, Strands, rotate, safe_normalize};
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Interpolate {
+    /// How many strands to grow (before the density mask thins them).
+    pub count: usize,
+    /// Blend the nearest this many guides (`Interpolation Guides`).
+    pub neighbors: usize,
+    /// Drop new strands closer than this to a guide's root (0 keeps all).
+    pub distance_to_guides: f32,
+    /// Space roots out (`Poisson Disk Distribution`) rather than scatter
+    /// them independently.
+    pub poisson: bool,
+    /// Turn each guide's shape from its root normal to the new root's.
+    pub follow_surface_normal: bool,
+    /// Along how much of the strand the turn fades out, metres. Blender
+    /// turns the whole strand; on a curved scalp that swings long hair's
+    /// tips out by the angle between neighbouring roots.
+    pub follow_length: f32,
+    /// Keep interpolation within parting groups (`Part by Texture`).
+    pub parting: Parting,
+    /// Blend only guides whose shapes agree with the nearest one's: a
+    /// guide is left out where its course strays from the nearest guide's
+    /// by more than this share of how far that one has come (0: blend all).
+    /// Where combing diverges, strands follow one side or the other, and
+    /// the hair parts there as hair does.
+    #[serde(default)]
+    pub divergence: f32,
+    /// How likely a root is to be kept, over the scalp.
+    pub density: DensityMask,
+    /// How unevenly roots cover the scalp, 0 to 1: patches a few
+    /// centimetres across thinned by up to this much.
+    #[serde(default)]
+    pub patchiness: f32,
+    /// Over how far in from the scalp's edge -- the hairline -- roots thin
+    /// out and strands grow finer, metres (0: a sharp edge).
+    #[serde(default)]
+    pub edge: f32,
+    /// Keep the guides themselves among the strands.
+    pub keep_guides: bool,
+    /// Root radius of the new strands, metres.
+    pub radius: f32,
+    pub seed: i32,
+}
+
+impl Default for Interpolate {
+    fn default() -> Self {
+        Self {
+            count: 30_000,
+            neighbors: 4,
+            distance_to_guides: 0.0,
+            poisson: true,
+            follow_surface_normal: true,
+            follow_length: 0.05,
+            parting: Parting::None,
+            divergence: 0.0,
+            density: DensityMask::Uniform,
+            patchiness: 0.0,
+            edge: 0.0,
+            keep_guides: false,
+            radius: 35e-6,
+            seed: 0,
+        }
+    }
+}
+
+/// Where hair parts: a plane through the head (the part line is where it
+/// meets the scalp) over the front of the head. Roots on either side are
+/// kept apart; behind `until` (a `z`, towards the back) the part has ended
+/// and roots take from both sides.
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+pub enum Parting {
+    #[default]
+    None,
+    Plane {
+        normal: [f32; 3],
+        offset: f32,
+        until: f32,
+    },
+    /// Sectors round the head, the front one in the middle: a braid's
+    /// lanes, gathered from the left, the top and the right.
+    Lanes { count: u32 },
+    /// A fringe: the front of the scalp (in front of `front`, within
+    /// `half_width` of the middle) apart from the rest, whose front is
+    /// split left from right -- hair combed to either side of a fringe must
+    /// not be averaged into hair combed down the face.
+    Fringe { front: f32, half_width: f32 },
+}
+
+impl Parting {
+    /// A part along the head from front to crown, `offset` metres to the
+    /// side (0 in the middle).
+    pub fn line(offset: f32, until: f32) -> Self {
+        Parting::Plane {
+            normal: [1.0, 0.0, 0.0],
+            offset,
+            until,
+        }
+    }
+
+    /// The group of a root: 0 or 1 on either side of the part, -1 where
+    /// there is none.
+    pub fn group(&self, p: Vec3) -> PartingGroup {
+        let word = match self {
+            Parting::None => -1,
+            Parting::Plane {
+                normal,
+                offset,
+                until,
+            } => {
+                if p.z < *until {
+                    -1
+                } else if Vec3::from_array(*normal).dot(p) > *offset {
+                    1
+                } else {
+                    0
+                }
+            }
+            Parting::Fringe { front, half_width } => {
+                if p.z > *front && p.x.abs() < *half_width {
+                    1
+                } else if p.z > -0.03 {
+                    if p.x >= 0.0 { 2 } else { 0 }
+                } else {
+                    -1
+                }
+            }
+            Parting::Lanes { count } => {
+                let a = p.x.atan2(p.z + 0.02);
+                let t = (a + std::f32::consts::PI) / std::f32::consts::TAU;
+                ((t * *count as f32) as i32).clamp(0, *count as i32 - 1)
+            }
+        };
+        PartingGroup::from_gpu_word(word)
+    }
+}
+
+/// Whether a strand of group `own` may take its shape from a guide of group
+/// `guide`: the same side, or either has no side.
+pub fn compatible(own: PartingGroup, guide: PartingGroup) -> bool {
+    own.is_unassigned() || guide.is_unassigned() || own == guide
+}
+
+/// How likely a root is to be kept, over the scalp. Patterns read the scalp
+/// UV map as [`crate::Head`] lays it out: the crown in the middle, the face
+/// towards `+v`, the hairline near the rim.
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+pub enum DensityMask {
+    #[default]
+    Uniform,
+    /// Male-pattern loss: a thinned crown, temples receding, the top
+    /// thinning between them. Each amount from 0 (none) to 1.
+    Balding { crown: f32, temples: f32, top: f32 },
+    /// A mask image over the UV square, row-major from `v = 0`, values 0 to 1.
+    Image {
+        width: usize,
+        height: usize,
+        values: Vec<f32>,
+    },
+}
+
+impl DensityMask {
+    pub fn at(&self, uv: [f32; 2]) -> f32 {
+        match self {
+            DensityMask::Uniform => 1.0,
+            DensityMask::Balding {
+                crown,
+                temples,
+                top,
+            } => {
+                let (x, y) = (uv[0] - 0.5, uv[1] - 0.5);
+                let r = (x * x + y * y).sqrt() * 2.0;
+                // The crown whorl sits a little behind the top.
+                let cx = x;
+                let cy = y + 0.08;
+                let crown_r = (cx * cx + cy * cy).sqrt() * 2.0;
+                let crown_loss =
+                    crown * (1.0 - super::smoothstep(0.1, 0.1 + 0.35 * crown, crown_r));
+                // Temples: towards the front at either side.
+                let angle = x.atan2(y);
+                let temple = (-((angle.abs() - 0.55) / 0.3).powi(2)).exp();
+                let temple_loss =
+                    temples * temple * super::smoothstep(0.62 - 0.35 * temples, 0.8, r);
+                // The top: a band from the front hairline back to the crown.
+                let band = (-(x / 0.16).powi(2)).exp() * super::smoothstep(-0.2, 0.3, y);
+                let top_loss = top * band * super::smoothstep(0.0, 0.5, r);
+                (1.0 - crown_loss.max(temple_loss).max(top_loss)).clamp(0.0, 1.0)
+            }
+            DensityMask::Image {
+                width,
+                height,
+                values,
+            } => {
+                if *width == 0 || *height == 0 {
+                    return 1.0;
+                }
+                let x = (uv[0].clamp(0.0, 1.0) * (*width - 1) as f32).max(0.0);
+                let y = (uv[1].clamp(0.0, 1.0) * (*height - 1) as f32).max(0.0);
+                let (x0, y0) = (x as usize, y as usize);
+                let (x1, y1) = ((x0 + 1).min(width - 1), (y0 + 1).min(height - 1));
+                let (fx, fy) = (x - x0 as f32, y - y0 as f32);
+                let v = |x: usize, y: usize| values[y * width + x];
+                let top = v(x0, y0) * (1.0 - fx) + v(x1, y0) * fx;
+                let bottom = v(x0, y1) * (1.0 - fx) + v(x1, y1) * fx;
+                top * (1.0 - fy) + bottom * fy
+            }
+        }
+    }
+}
+
+impl Interpolate {
+    pub fn apply(&self, guides: &Strands, context: &Context) -> Strands {
+        let points = guides.points;
+        let scalp = context.scalp;
+        let mut rng = Rng::new(rng::seed(self.seed, 0x1A7E) as u64);
+
+        // Roots: area-sampled, spaced out, thinned by the mask.
+        let spacing = 0.55 * (scalp.area() / self.count.max(1) as f32).sqrt();
+        let mut placed = PointGrid::new(spacing.max(1e-5));
+        let mut roots = Vec::with_capacity(self.count);
+        let attempts = if self.poisson {
+            self.count * 2
+        } else {
+            self.count
+        };
+        for _ in 0..attempts {
+            if roots.len() >= self.count {
+                break;
+            }
+            let point = scalp.sample(&mut rng);
+            if self.poisson && placed.any_within(point.position, spacing, |_| true) {
+                continue;
+            }
+            placed.insert(point.position, PartingGroup::from_gpu_word(0));
+            roots.push(point);
+        }
+        let seed = rng::seed(self.seed, 0xD3_5E);
+        let edge = self.edge_distance(scalp);
+        let offset = rng::signed_vec3(seed, 0x9A7C) * 50.0;
+        let inset = |p: Vec3| {
+            if self.edge > 0.0 {
+                let d = edge
+                    .nearest(p, self.edge, |_| true)
+                    .map_or(self.edge, |(_, d)| d);
+                super::smoothstep(0.0, self.edge, d)
+            } else {
+                1.0
+            }
+        };
+        roots.retain(|r| {
+            let mut keep = self.density.at(r.uv);
+            if self.patchiness > 0.0 {
+                let n = crate::noise::fractal(r.position * 30.0 + offset, 3, 0.5);
+                keep *= 1.0 - self.patchiness * super::smoothstep(0.45, 0.7, n);
+            }
+            // Thinning out to the edge, a few fine hairs right at it.
+            keep *= 0.08 + 0.92 * inset(r.position).powf(1.5);
+            keep >= 1.0 || rng::unit(r.position.x.to_bits() ^ r.position.z.to_bits(), seed) < keep
+        });
+
+        // The guides, by root, in their parting groups.
+        let guide_groups: Vec<PartingGroup> = (0..guides.len())
+            .map(|g| match self.parting {
+                Parting::None => PartingGroup::Unassigned,
+                _ => self.parting.group(guides.root(g)),
+            })
+            .collect();
+        let grid = PointGrid::build(
+            &(0..guides.len())
+                .map(|g| (guides.root(g), guide_groups[g]))
+                .collect::<Vec<_>>(),
+            spacing.max(0.01),
+        );
+        let near_guide = |p: Vec3| {
+            self.distance_to_guides > 0.0 && grid.any_within(p, self.distance_to_guides, |_| true)
+        };
+
+        let neighbors = self.neighbors.max(1);
+        let grown: Vec<Option<(Vec<Vec3>, Attachment)>> = roots
+            .par_iter()
+            .enumerate()
+            .map(|(i, root)| {
+                if near_guide(root.position) {
+                    return None;
+                }
+                let group = self.parting.group(root.position);
+                let nearest = grid.nearest_k(root.position, neighbors, f32::INFINITY, |g| {
+                    compatible(group, g)
+                });
+                if nearest.is_empty() {
+                    return None;
+                }
+                let nearest = if self.divergence > 0.0 && points >= 3 {
+                    let reference = guides.strand(nearest[0].0 as usize);
+                    let samples = [points / 3, 2 * points / 3, points - 1];
+                    nearest
+                        .into_iter()
+                        .filter(|&(g, _)| {
+                            let strand = guides.strand(g as usize);
+                            samples.iter().all(|&j| {
+                                let own = reference[j] - reference[0];
+                                let theirs = strand[j] - strand[0];
+                                (own - theirs).length() <= self.divergence * own.length().max(0.02)
+                            })
+                        })
+                        .collect()
+                } else {
+                    nearest
+                };
+                // Inverse-square weights; a root on top of a guide takes it.
+                let mut weights: Vec<f32> = nearest
+                    .iter()
+                    .map(|&(_, d)| 1.0 / (d * d + 1e-10))
+                    .collect();
+                let total: f32 = weights.iter().sum();
+                weights.iter_mut().for_each(|w| *w /= total);
+
+                let mut shape = vec![Vec3::default(); points];
+                for (&(g, _), &w) in nearest.iter().zip(&weights) {
+                    let g = g as usize;
+                    let strand = guides.strand(g);
+                    let guide_root = strand[0];
+                    let turn = if self.follow_surface_normal {
+                        Some((guides.root_normal[g], root.normal))
+                    } else {
+                        None
+                    };
+                    let mut along = 0.0;
+                    for (j, p) in strand.iter().enumerate() {
+                        if j > 0 {
+                            along += (*p - strand[j - 1]).length();
+                        }
+                        let mut offset = *p - guide_root;
+                        if let Some((from, to)) = turn {
+                            // Turned fully at the root, not at all past
+                            // `follow_length`: the strand leaves the scalp
+                            // as the scalp there faces, and hangs as its
+                            // guide hangs.
+                            let share = 1.0 - super::smoothstep(0.0, self.follow_length, along);
+                            offset = turn_between(offset, from, to, share);
+                        }
+                        shape[j] += offset * w;
+                    }
+                }
+                let positions: Vec<Vec3> = shape.iter().map(|o| root.position + *o).collect();
+                let id = rng::hash(i as u32, rng::seed(self.seed, 0x51D));
+                // Hair at the hairline is finer.
+                let radius = self.radius * (0.45 + 0.55 * inset(root.position));
+                Some((
+                    positions,
+                    Attachment {
+                        uv: root.uv,
+                        normal: root.normal,
+                        id: StrandId::from_word(id),
+                        group,
+                        radius,
+                    },
+                ))
+            })
+            .collect();
+
+        let mut out = Strands::with_capacity(points, grown.len() + guides.len());
+        if self.keep_guides {
+            for (g, &group) in guide_groups.iter().enumerate() {
+                let mut a = guides.attachment(g);
+                a.group = group;
+                a.radius = self.radius;
+                out.push(guides.strand(g), a);
+            }
+        }
+        for (positions, attachment) in grown.into_iter().flatten() {
+            out.push(&positions, attachment);
+        }
+        out
+    }
+}
+
+impl Interpolate {
+    /// Points along the scalp's open edges, a millimetre apart, to measure
+    /// how far in from the hairline a root is.
+    fn edge_distance(&self, scalp: &crate::surface::Surface) -> PointGrid {
+        let mut grid = PointGrid::new(self.edge.max(0.002));
+        if self.edge <= 0.0 {
+            return grid;
+        }
+        for p in scalp.boundary(0.001) {
+            grid.insert(p, PartingGroup::from_gpu_word(0));
+        }
+        grid
+    }
+}
+
+/// Turn `v` by `share` of the rotation taking direction `from` to `to`.
+fn turn_between(v: Vec3, from: Vec3, to: Vec3, share: f32) -> Vec3 {
+    let from = safe_normalize(from, Vec3::up());
+    let to = safe_normalize(to, Vec3::up());
+    let axis = from.cross(to);
+    let s = axis.length();
+    let c = from.dot(to);
+    if s < 1e-6 {
+        return v;
+    }
+    rotate(v, axis * (1.0 / s), s.atan2(c) * share)
+}
