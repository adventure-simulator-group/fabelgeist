+//! The grooming kernels: every operation of a groom's stack after
+//! interpolation, one invocation a strand (or a point), reading one
+//! position buffer (`src`) and writing the other (`dst`).
+//!
+//! Each mirrors the host operation of the same name in [`crate::ops`]; see
+//! there for what the arithmetic means.
+
+use super::common::{HEAD, INDEX, MATH, NOISE, RANDOM, STRAND, WALK};
+
+fn kernel(bindings: &str, helpers: &[&str], body: &str) -> String {
+    let mut source = String::from(bindings);
+    for h in helpers {
+        source.push_str(h);
+    }
+    source.push_str(INDEX);
+    source.push_str(body);
+    source
+}
+
+/// `GrowthField::direction`, from the parameters `growth`, `whorls`,
+/// `center_*`, `w0_*` and `w1_*`.
+pub(super) const GROWTH: &str = r#"
+fn whorl_direction(point: vec3<f32>, spiral: f32, hand: f32, reach: f32, p: vec3<f32>, n: vec3<f32>) -> vec3<f32> {
+    let offset = p - point;
+    let away_raw = in_plane(offset, n);
+    if (dot(away_raw, away_raw) < 1e-10) {
+        return safe_normalize(in_plane(vec3<f32>(0.0, 0.0, -1.0), n), vec3<f32>(0.0, 0.0, -1.0));
+    }
+    let away = normalize(away_raw);
+    let around = cross(n, away) * hand;
+    let turn = spiral * (1.0 - smoothstep1(0.0, reach, length(offset)));
+    return away * cos(turn) + around * sin(turn);
+}
+
+// `GrowthField::direction`.
+fn growth_direction(p: vec3<f32>, n: vec3<f32>) -> vec3<f32> {
+    let down = in_plane(vec3<f32>(0.0, -1.0, 0.0), n);
+    let fallback = safe_normalize(down, vec3<f32>(0.0, 0.0, -1.0));
+    let w0 = vec3<f32>(params.w0_x, params.w0_y, params.w0_z);
+    let w1 = vec3<f32>(params.w1_x, params.w1_y, params.w1_z);
+    var v = down;
+    switch params.growth {
+        case 0u, 3u: {
+            if (params.whorls >= 1u) {
+                v = whorl_direction(w0, params.w0_spiral, params.w0_hand, params.w0_reach, p, n);
+            }
+        }
+        case 1u: {
+            if (params.whorls >= 2u) {
+                let t = smoothstep1(-0.004, 0.004, distance(p, w0) - distance(p, w1));
+                v = whorl_direction(w0, params.w0_spiral, params.w0_hand, params.w0_reach, p, n) * (1.0 - t)
+                    + whorl_direction(w1, params.w1_spiral, params.w1_hand, params.w1_reach, p, n) * t;
+            }
+        }
+        case 2u: {
+            if (params.whorls >= 2u) {
+                let t = 1.0 - smoothstep1(0.5 * params.w1_reach, params.w1_reach, distance(p, w1));
+                v = whorl_direction(w0, params.w0_spiral, params.w0_hand, params.w0_reach, p, n) * (1.0 - t)
+                    + whorl_direction(w1, params.w1_spiral, params.w1_hand, params.w1_reach, p, n) * t;
+            }
+        }
+        case 4u: {
+            let over = smoothstep1(0.35, 0.75, n.y);
+            v = in_plane(vec3<f32>(0.0, -0.15, 1.0), n) * over + down * (1.0 - over);
+        }
+        case 5u: {
+            let over = smoothstep1(0.2, 0.6, n.y + 0.5 * n.z);
+            v = in_plane(vec3<f32>(0.0, -0.15, -1.0), n) * over + down * (1.0 - over);
+        }
+        case 6u: {
+            let q = p - vec3<f32>(params.center_x, params.center_y, params.center_z);
+            let out = vec3<f32>(q.x, 0.0, q.z * 0.3);
+            v = in_plane(vec3<f32>(0.0, -1.0, 0.0) + safe_normalize(out, vec3<f32>(1.0, 0.0, 0.0)) * 0.35, n);
+        }
+        default: {}
+    }
+    return safe_normalize(in_plane(v, n), fallback);
+}
+"#;
+
+/// `Parting::group`, from the parameters `parting`, `lanes`, `plane_*`,
+/// `until` and `fringe_*`.
+pub(super) const PARTING: &str = r#"
+fn parting_group(p: vec3<f32>) -> i32 {
+    switch params.parting {
+        case 1u: {
+            if (p.z < params.until) {
+                return -1;
+            }
+            let side = dot(vec3<f32>(params.plane_x, params.plane_y, params.plane_z), p) > params.plane_offset;
+            return select(0, 1, side);
+        }
+        case 2u: {
+            let a = atan2(p.x, p.z + 0.02);
+            let t = (a + PI) / TAU;
+            return clamp(i32(t * f32(params.lanes)), 0, i32(params.lanes) - 1);
+        }
+        case 3u: {
+            if (p.z > params.fringe_front && abs(p.x) < params.fringe_half_width) {
+                return 1;
+            }
+            if (p.z > -0.03) {
+                return select(0, 2, p.x >= 0.0);
+            }
+            return -1;
+        }
+        default: {
+            return -1;
+        }
+    }
+}
+"#;
+
+/// Candidate roots, stratified over the scalp by area, each kept or not by
+/// the density masks: the balding pattern, uneven cover, the hairline's
+/// thinning. Writes the candidate and a 0/1 flag for the scan.
+pub fn roots() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> tri_cdf: array<f32>;
+@group(0) @binding(1) var<storage, read> tri_index: array<vec4<u32>>;
+@group(0) @binding(2) var<storage, read> scalp_points: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read> scalp_normals: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read> scalp_extra: array<vec4<f32>>;
+@group(0) @binding(5) var<storage, read_write> cand_position: array<vec4<f32>>;
+@group(0) @binding(6) var<storage, read_write> cand_normal: array<vec4<f32>>;
+@group(0) @binding(7) var<storage, read_write> keep: array<u32>;
+
+struct Params {
+    count: u32,
+    triangles: u32,
+    seed: u32,
+    balding: u32,
+    total_area: f32,
+    crown: f32,
+    temples: f32,
+    top: f32,
+    patchiness: f32,
+    edge: f32,
+    offset_x: f32,
+    offset_y: f32,
+    offset_z: f32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(8) var<uniform> params: Params;
+"#,
+        &[RANDOM, NOISE, MATH],
+        r#"
+fn balding_keep(uv: vec2<f32>) -> f32 {
+    let x = uv.x - 0.5;
+    let y = uv.y - 0.5;
+    let r = sqrt(x * x + y * y) * 2.0;
+    let cy = y + 0.08;
+    let crown_r = sqrt(x * x + cy * cy) * 2.0;
+    let crown_loss = params.crown * (1.0 - smoothstep1(0.1, 0.1 + 0.35 * params.crown, crown_r));
+    let angle = atan2(x, y);
+    let temple = exp(-pow((abs(angle) - 0.55) / 0.3, 2.0));
+    let temple_loss = params.temples * temple * smoothstep1(0.62 - 0.35 * params.temples, 0.8, r);
+    let band = exp(-pow(x / 0.16, 2.0)) * smoothstep1(-0.2, 0.3, y);
+    let top_loss = params.top * band * smoothstep1(0.0, 0.5, r);
+    return clamp(1.0 - max(crown_loss, max(temple_loss, top_loss)), 0.0, 1.0);
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let c = item(id, groups);
+    if (c >= params.count) {
+        return;
+    }
+    // Systematic sampling along the triangles' cumulative area: each
+    // triangle gets its share of candidates, spread over it by a
+    // low-discrepancy sequence.
+    let target_area = (f32(c) + 0.5) / f32(params.count) * params.total_area;
+    var lo = 0u;
+    var hi = params.triangles - 1u;
+    while (lo < hi) {
+        let mid = (lo + hi) / 2u;
+        if (tri_cdf[mid] < target_area) {
+            lo = mid + 1u;
+        } else {
+            hi = mid;
+        }
+    }
+    let t = lo;
+    var before = 0.0;
+    if (t > 0u) {
+        before = tri_cdf[t - 1u];
+    }
+    let area = max(tri_cdf[t] - before, 1e-12);
+    let k = (target_area - before) / area * (area / params.total_area * f32(params.count));
+    var r1 = fract(k * 0.7548776662 + unit(t, params.seed));
+    var r2 = fract(k * 0.5698402910 + unit(t, params.seed ^ 0x51u));
+    if (r1 + r2 > 1.0) {
+        r1 = 1.0 - r1;
+        r2 = 1.0 - r2;
+    }
+    let w = vec3<f32>(1.0 - r1 - r2, r1, r2);
+    let tri = tri_index[t];
+    let position = scalp_points[tri.x].xyz * w.x + scalp_points[tri.y].xyz * w.y + scalp_points[tri.z].xyz * w.z;
+    let normal = normalize(scalp_normals[tri.x].xyz * w.x + scalp_normals[tri.y].xyz * w.y + scalp_normals[tri.z].xyz * w.z);
+    let extra = scalp_extra[tri.x] * w.x + scalp_extra[tri.y] * w.y + scalp_extra[tri.z] * w.z;
+
+    var keep_here = 1.0;
+    if (params.balding != 0u) {
+        keep_here = balding_keep(extra.xy);
+    }
+    if (params.patchiness > 0.0) {
+        let n = fractal(position * 30.0 + vec3<f32>(params.offset_x, params.offset_y, params.offset_z), 3u, 0.5);
+        keep_here *= 1.0 - params.patchiness * smoothstep1(0.45, 0.7, n);
+    }
+    var inset = 1.0;
+    if (params.edge > 0.0) {
+        inset = smoothstep1(0.0, params.edge, extra.z);
+    }
+    keep_here *= 0.08 + 0.92 * pow(inset, 1.5);
+    let kept = keep_here >= 1.0 || unit(c, params.seed ^ 0xD35Eu) < keep_here;
+    cand_position[c] = vec4<f32>(position, inset);
+    cand_normal[c] = vec4<f32>(normal, 0.0);
+    cand_position[c + params.count] = vec4<f32>(extra.xy, 0.0, 0.0);
+    keep[c] = select(0u, 1u, kept);
+}
+"#,
+    )
+}
+
+/// The kept candidates into their strand slots (the flags scanned into
+/// offsets), with their parting group, id and radius.
+pub fn roots_compact() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+@group(0) @binding(0) var<storage, read> cand_position: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> cand_normal: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> keep: array<u32>;
+@group(0) @binding(3) var<storage, read_write> roots: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read_write> strands: array<StrandGpu>;
+
+struct Params {{
+    count: u32,
+    id_seed: u32,
+    parting: u32,
+    lanes: u32,
+    plane_x: f32,
+    plane_y: f32,
+    plane_z: f32,
+    plane_offset: f32,
+    until: f32,
+    fringe_front: f32,
+    fringe_half_width: f32,
+    radius: f32,
+}};
+@group(0) @binding(5) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM, MATH, PARTING],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let c = item(id, groups);
+    if (c >= params.count || keep[c + 1u] == keep[c]) {
+        return;
+    }
+    let s = keep[c];
+    let p = cand_position[c];
+    roots[s] = p;
+    var strand: StrandGpu;
+    strand.normal = cand_normal[c].xyz;
+    strand.id = hash2(s, params.id_seed);
+    strand.uv = cand_position[c + params.count].xy;
+    strand.group = parting_group(p.xyz);
+    // Hair at the hairline is finer.
+    strand.radius = params.radius * (0.45 + 0.55 * p.w);
+    strands[s] = strand;
+}
+"#,
+    )
+}
+
+/// For each strand, the guides it takes its shape from: the nearest
+/// `neighbors` in its parting group, those whose courses stray from the
+/// nearest one's left out, weighted by inverse square distance.
+pub fn interp_select() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+@group(0) @binding(0) var<storage, read> roots: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> strands: array<StrandGpu>;
+@group(0) @binding(2) var<storage, read> guide_points: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read> guide_info: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read_write> neighbors: array<vec4<u32>>;
+@group(0) @binding(5) var<storage, read_write> weights: array<vec4<f32>>;
+
+struct Params {{
+    count: u32,
+    guides: u32,
+    points: u32,
+    wanted: u32,
+    divergence: f32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+}};
+@group(0) @binding(6) var<uniform> params: Params;
+"#
+        ),
+        &[],
+        r#"
+fn compatible(own: i32, guide: i32) -> bool {
+    return own < 0 || guide < 0 || own == guide;
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let root = roots[s].xyz;
+    let own = strands[s].group;
+    let k = min(params.wanted, 8u);
+    var best_d: array<f32, 8>;
+    var best_g: array<u32, 8>;
+    var found = 0u;
+    // Brute force: a few hundred guides, a hundred thousand strands.
+    for (var sweep = 0u; sweep < 2u && found == 0u; sweep++) {
+        for (var g = 0u; g < params.guides; g++) {
+            let group = i32(guide_info[g].w);
+            if (sweep == 0u && !compatible(own, group)) {
+                continue;
+            }
+            let d = distance(guide_points[g * params.points].xyz, root);
+            if (found < k || d < best_d[found - 1u]) {
+                var at = min(found, k - 1u);
+                if (found < k) {
+                    found += 1u;
+                }
+                while (at > 0u && best_d[at - 1u] > d) {
+                    best_d[at] = best_d[at - 1u];
+                    best_g[at] = best_g[at - 1u];
+                    at -= 1u;
+                }
+                best_d[at] = d;
+                best_g[at] = g;
+            }
+        }
+    }
+    // Guides that agree with the nearest one.
+    let p = params.points;
+    let reference = best_g[0] * p;
+    var kept = 0u;
+    var ids: array<u32, 8>;
+    var w: array<f32, 8>;
+    var total = 0.0;
+    for (var n = 0u; n < found; n++) {
+        let g = best_g[n];
+        var agrees = true;
+        if (params.divergence > 0.0 && p >= 3u) {
+            let samples = array<u32, 3>(p / 3u, 2u * p / 3u, p - 1u);
+            for (var q = 0u; q < 3u; q++) {
+                let j = samples[q];
+                let own_offset = guide_points[reference + j].xyz - guide_points[reference].xyz;
+                let theirs = guide_points[g * p + j].xyz - guide_points[g * p].xyz;
+                if (length(own_offset - theirs) > params.divergence * max(length(own_offset), 0.02)) {
+                    agrees = false;
+                }
+            }
+        }
+        if (agrees) {
+            ids[kept] = g;
+            w[kept] = 1.0 / (best_d[n] * best_d[n] + 1e-10);
+            total += w[kept];
+            kept += 1u;
+        }
+    }
+    var a = vec4<u32>(0u);
+    var b = vec4<u32>(0u);
+    var wa = vec4<f32>(0.0);
+    var wb = vec4<f32>(0.0);
+    for (var n = 0u; n < kept; n++) {
+        let weight = w[n] / total;
+        if (n < 4u) {
+            a[n] = ids[n];
+            wa[n] = weight;
+        } else {
+            b[n - 4u] = ids[n];
+            wb[n - 4u] = weight;
+        }
+    }
+    neighbors[s * 2u] = a;
+    neighbors[s * 2u + 1u] = b;
+    weights[s * 2u] = wa;
+    weights[s * 2u + 1u] = wb;
+}
+"#,
+    )
+}
+
+/// Every point of every strand: its guides' offsets from their roots,
+/// turned from their root's normal to this root's near the root, blended.
+pub fn interp_points() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+@group(0) @binding(0) var<storage, read> roots: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> strands: array<StrandGpu>;
+@group(0) @binding(2) var<storage, read> guide_points: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read> guide_info: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read> neighbors: array<vec4<u32>>;
+@group(0) @binding(5) var<storage, read> weights: array<vec4<f32>>;
+@group(0) @binding(6) var<storage, read_write> dst: array<vec4<f32>>;
+
+struct Params {{
+    count: u32,
+    points: u32,
+    follow: u32,
+    pad0: u32,
+    follow_length: f32,
+    pad1: u32,
+    pad2: u32,
+    pad3: u32,
+}};
+@group(0) @binding(7) var<uniform> params: Params;
+"#
+        ),
+        &[MATH],
+        r#"
+fn turn_between(v: vec3<f32>, source_raw: vec3<f32>, target_raw: vec3<f32>, share: f32) -> vec3<f32> {
+    let source = safe_normalize(source_raw, vec3<f32>(0.0, 1.0, 0.0));
+    let target_dir = safe_normalize(target_raw, vec3<f32>(0.0, 1.0, 0.0));
+    let axis = cross(source, target_dir);
+    let s = length(axis);
+    if (s < 1e-6) {
+        return v;
+    }
+    return rotate(v, axis / s, atan2(s, dot(source, target_dir)) * share);
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let i = item(id, groups);
+    let p = params.points;
+    if (i >= params.count * p) {
+        return;
+    }
+    let s = i / p;
+    let j = i % p;
+    let root = roots[s].xyz;
+    let normal = strands[s].normal;
+    var shape = vec3<f32>(0.0);
+    for (var n = 0u; n < 8u; n++) {
+        let half = n / 4u;
+        let weight = weights[s * 2u + half][n % 4u];
+        if (weight <= 0.0) {
+            continue;
+        }
+        let g = neighbors[s * 2u + half][n % 4u];
+        let here = guide_points[g * p + j];
+        var offset = here.xyz - guide_points[g * p].xyz;
+        if (params.follow != 0u) {
+            // `here.w` is the guide's arc length at this point.
+            let share = 1.0 - smoothstep1(0.0, params.follow_length, here.w);
+            offset = turn_between(offset, guide_info[g].xyz, normal, share);
+        }
+        shape += offset * weight;
+    }
+    dst[i] = vec4<f32>(root + shape, 0.0);
+}
+"#,
+    )
+}
+
+const PER_STRAND: &str = r#"
+@group(0) @binding(0) var<storage, read> src: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> dst: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> strands: array<StrandGpu>;
+"#;
+
+/// Each strand's root turned the way its own follicle points.
+pub fn orient() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+{PER_STRAND}
+struct Params {{
+    count: u32,
+    points: u32,
+    seed: u32,
+    growth: u32,
+    memory: f32,
+    direction_spread: f32,
+    angle_spread: f32,
+    whorls: u32,
+    center_x: f32,
+    center_y: f32,
+    center_z: f32,
+    pad0: u32,
+    w0_x: f32,
+    w0_y: f32,
+    w0_z: f32,
+    w0_spiral: f32,
+    w0_hand: f32,
+    w0_reach: f32,
+    w1_hand: f32,
+    w1_reach: f32,
+    w1_x: f32,
+    w1_y: f32,
+    w1_z: f32,
+    w1_spiral: f32,
+}};
+@group(0) @binding(3) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM, MATH, WALK, GROWTH],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let base = s * points;
+    let root = src[base].xyz;
+    let n = safe_normalize(strands[s].normal, vec3<f32>(0.0, 1.0, 0.0));
+    var ahead = -1;
+    for (var j = 1u; j < points; j++) {
+        if (distance(src[base + j].xyz, root) > 0.002) {
+            ahead = i32(j);
+            break;
+        }
+    }
+    if (ahead < 0) {
+        copy_strand(base, points);
+        return;
+    }
+    let leaves = src[base + u32(ahead)].xyz - root;
+    let flat_raw = in_plane(leaves, n);
+    let grows = growth_direction(root, n);
+    let sid = strands[s].id;
+    var turn = params.direction_spread * signed1(sid, params.seed);
+    if (length(flat_raw) > 0.25 * length(leaves)) {
+        let flat = normalize(flat_raw);
+        turn += atan2(dot(n, cross(flat, grows)), dot(flat, grows));
+    }
+    let tilt = params.angle_spread * signed1(sid, params.seed ^ 0x7117u);
+    let tilt_axis = safe_normalize(cross(grows, n), orthogonal(n));
+    let lift = (1.0 - cos(turn)) * 0.5 * params.memory * 0.35;
+    dst[base] = src[base];
+    var along = 0.0;
+    var previous = root;
+    for (var j = 1u; j < points; j++) {
+        let p = src[base + j].xyz;
+        along += distance(p, previous);
+        previous = p;
+        let share = 1.0 - smoothstep1(0.0, params.memory, along);
+        if (share <= 0.0) {
+            dst[base + j] = src[base + j];
+            continue;
+        }
+        var offset = rotate(p - root, n, turn * share);
+        offset = rotate(offset, tilt_axis, -tilt * share);
+        let rise = lift * smoothstep1(0.0, params.memory, along) * share * 4.0;
+        dst[base + j] = vec4<f32>(root + offset + n * rise, src[base + j].w);
+    }
+}
+"#,
+    )
+}
+
+/// Each strand cut to a share of its length, and resampled.
+pub fn trim() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+{PER_STRAND}
+struct Params {{
+    count: u32,
+    points: u32,
+    seed: u32,
+    pad0: u32,
+    keep_share: f32,
+    random: f32,
+    max_length: f32,
+    pad1: u32,
+}};
+@group(0) @binding(3) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM, MATH, WALK],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let base = s * points;
+    let total = strand_length(base, points);
+    var keep = total * clamp(params.keep_share * (1.0 - params.random * unit(strands[s].id, params.seed)), 0.02, 1.0);
+    if (params.max_length > 0.0) {
+        keep = min(keep, params.max_length);
+    }
+    if (total <= 0.0 || keep >= total * 0.9999) {
+        copy_strand(base, points);
+        return;
+    }
+    // Resampled evenly along the first `keep` of the arc.
+    var segment = 0u;
+    var segment_start = 0.0;
+    var segment_end = distance(point_at(base, 1u), point_at(base, 0u));
+    for (var j = 0u; j < points; j++) {
+        let target_length = keep * f32(j) / f32(points - 1u);
+        while (segment + 2u < points && segment_end < target_length) {
+            segment += 1u;
+            segment_start = segment_end;
+            segment_end += distance(point_at(base, segment + 1u), point_at(base, segment));
+        }
+        let span = segment_end - segment_start;
+        var t = 0.0;
+        if (span > 1e-12) {
+            t = clamp((target_length - segment_start) / span, 0.0, 1.0);
+        }
+        dst[base + j] = vec4<f32>(mix(point_at(base, segment), point_at(base, segment + 1u), t), 0.0);
+    }
+}
+"#,
+    )
+}
+
+/// `Create Guide Index Map`, on a grid: in every cell of side `distance`,
+/// for every parting group, the candidate whose hash is lowest leads (a
+/// packed `!(priority << 20 | strand)` kept by `atomicMax`, so an empty
+/// cell is zero).
+pub fn map_candidates() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+@group(0) @binding(0) var<storage, read> roots: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> strands: array<StrandGpu>;
+@group(0) @binding(2) var<storage, read_write> leaders: array<atomic<u32>>;
+
+struct Params {{
+    count: u32,
+    nx: u32,
+    ny: u32,
+    nz: u32,
+    lo_x: f32,
+    lo_y: f32,
+    lo_z: f32,
+    inverse_cell: f32,
+    mask: f32,
+    seed: u32,
+    pad0: u32,
+    pad1: u32,
+}};
+@group(0) @binding(3) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM],
+        MAP_CELL,
+    ) + r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let sid = strands[s].id;
+    if (unit(sid, params.seed ^ 0x2F0B1A3Du) >= params.mask) {
+        return;
+    }
+    let cell = map_cell(roots[s].xyz);
+    let slot = map_slot(cell, strands[s].group);
+    let priority = hash2(sid, params.seed) >> 20u;
+    atomicMax(&leaders[slot], ~((priority << 20u) | s));
+}
+"#
+}
+
+const MAP_CELL: &str = r#"
+fn map_cell(p: vec3<f32>) -> vec3<i32> {
+    let c = vec3<i32>(floor((p - vec3<f32>(params.lo_x, params.lo_y, params.lo_z)) * params.inverse_cell));
+    return clamp(c, vec3<i32>(0), vec3<i32>(i32(params.nx) - 1, i32(params.ny) - 1, i32(params.nz) - 1));
+}
+
+fn map_slot(c: vec3<i32>, group: i32) -> u32 {
+    let cell = (u32(c.z) * params.ny + u32(c.y)) * params.nx + u32(c.x);
+    return cell * 5u + u32(clamp(group + 1, 0, 4));
+}
+"#;
+
+/// Every strand to its nearest leader in the cells around it, its own
+/// parting group's first.
+pub fn map_assign() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+@group(0) @binding(0) var<storage, read> roots: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> strands: array<StrandGpu>;
+@group(0) @binding(2) var<storage, read> leaders: array<u32>;
+@group(0) @binding(3) var<storage, read_write> guide_of: array<u32>;
+
+struct Params {{
+    count: u32,
+    nx: u32,
+    ny: u32,
+    nz: u32,
+    lo_x: f32,
+    lo_y: f32,
+    lo_z: f32,
+    inverse_cell: f32,
+    mask: f32,
+    seed: u32,
+    pad0: u32,
+    pad1: u32,
+}};
+@group(0) @binding(4) var<uniform> params: Params;
+"#
+        ),
+        &[],
+        MAP_CELL,
+    ) + r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let p = roots[s].xyz;
+    let base = map_cell(p);
+    let own = strands[s].group;
+    var best = s;
+    var best_d = 1e30;
+    for (var sweep = 0u; sweep < 2u && best_d >= 1e30; sweep++) {
+        for (var n = 0u; n < 27u; n++) {
+            let c = base + vec3<i32>(i32(n % 3u) - 1, i32((n / 3u) % 3u) - 1, i32(n / 9u) - 1);
+            if (any(c < vec3<i32>(0)) || c.x >= i32(params.nx) || c.y >= i32(params.ny) || c.z >= i32(params.nz)) {
+                continue;
+            }
+            for (var g = 0; g < 5; g++) {
+                if (sweep == 0u && g != clamp(own + 1, 0, 4)) {
+                    continue;
+                }
+                let stored = leaders[map_slot(c, g - 1)];
+                if (stored == 0u) {
+                    continue;
+                }
+                let leader = (~stored) & 0xFFFFFu;
+                let d = distance(roots[leader].xyz, p);
+                if (d < best_d) {
+                    best_d = d;
+                    best = leader;
+                }
+            }
+        }
+    }
+    guide_of[s] = best;
+}
+"#
+}
+
+const WITH_GUIDES: &str = r#"
+@group(0) @binding(3) var<storage, read> guide_of: array<u32>;
+"#;
+
+/// `Clump Hair Curves`: strands gathered to their clump guide.
+pub fn clump() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+{PER_STRAND}
+{WITH_GUIDES}
+struct Params {{
+    count: u32,
+    points: u32,
+    seed: u32,
+    preserve: u32,
+    factor: f32,
+    shape: f32,
+    twist: f32,
+    twist_random: f32,
+    twist_factor: f32,
+    tip_spread: f32,
+    clump_offset: f32,
+    distance_falloff: f32,
+    distance_threshold: f32,
+    min_length: f32,
+    pad0: u32,
+    pad1: u32,
+}};
+@group(0) @binding(4) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM, NOISE, MATH, WALK],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let base = s * points;
+    let g = guide_of[s];
+    let guide_base = g * points;
+
+    // The guide's root frame, and its tip's.
+    var root_walk = walker_new(guide_base, points);
+    let guide_root = walker_at(&root_walk, 0.0);
+    var tip_walk = walker_new(guide_base, points);
+    let tip = walker_at(&tip_walk, tip_walk.total);
+
+    let root = src[base].xyz;
+    let offset = root - guide_root.position;
+    let scalp = strands[g].normal;
+    let t0 = guide_root.tangent;
+    let across = safe_normalize(cross(t0, scalp), guide_root.normal);
+    let along = safe_normalize(t0 - scalp * dot(t0, scalp), t0);
+    let depth = safe_normalize(cross(across, t0), guide_root.binormal);
+    let placed = across * dot(offset, across) + depth * dot(offset, along);
+    let x = dot(guide_root.normal, placed);
+    let y = dot(guide_root.binormal, placed);
+
+    var gather = vec3<f32>(0.0);
+    if (params.tip_spread != 0.0) {
+        let r = signed3(strands[s].id, params.seed) * params.tip_spread;
+        gather += tip.normal * r.x + tip.binormal * r.y + tip.tangent * r.z;
+    }
+    if (params.clump_offset != 0.0) {
+        let r = signed3(strands[g].id, params.seed ^ 0x0FF5u) * params.clump_offset;
+        gather += tip.normal * r.x + tip.binormal * r.y;
+    }
+
+    let d = length(offset);
+    var weight = 1.0 - smoothstep1(params.distance_threshold, params.distance_threshold + params.distance_falloff, d);
+    if (params.distance_threshold != 0.0 && params.distance_falloff == 0.0) {
+        weight = select(0.0, 1.0, d <= params.distance_threshold);
+    }
+    let clump_random = white(vec3<f32>(f32(g), 0.0, 0.0));
+    let total = strand_length(base, points);
+    if (params.min_length > 0.0) {
+        weight *= smoothstep1(params.min_length, 2.0 * params.min_length, total);
+    }
+
+    var walk = walker_new(guide_base, points);
+    dst[base] = src[base];
+    var travelled = 0.0;
+    for (var j = 1u; j < points; j++) {
+        travelled += distance(point_at(base, j), point_at(base, j - 1u));
+        let t = travelled / max(total, 1e-12);
+        let f = shape_range(t, 0.0, 1.0, params.shape);
+        let at = walker_at(&walk, t * walk.total);
+        let parallel = at.normal * x + at.binormal * y;
+        let target_point = at.position + parallel * (1.0 - f) + gather * f;
+        var p = mix(point_at(base, j), target_point, f * params.factor * weight);
+        let twist_base = travelled * params.twist;
+        let angle = params.twist_factor * (twist_base + (twist_base * clump_random - twist_base) * params.twist_random);
+        if (angle != 0.0) {
+            p = at.position + rotate(p - at.position, at.tangent, angle);
+        }
+        dst[base + j] = vec4<f32>(p, src[base + j].w);
+    }
+    if (params.preserve != 0u) {
+        restore_lengths(base, points, 1.0);
+    }
+}
+"#,
+    )
+}
+
+/// `Curl Hair Curves`: ringlets around the clump guide.
+pub fn curl() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+{PER_STRAND}
+{WITH_GUIDES}
+struct Params {{
+    count: u32,
+    points: u32,
+    seed: u32,
+    pad0: u32,
+    factor: f32,
+    curl_start: f32,
+    radius: f32,
+    factor_start: f32,
+    factor_end: f32,
+    turns_per_metre: f32,
+    random_offset: f32,
+    pad1: u32,
+}};
+@group(0) @binding(4) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM, MATH, WALK],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let base = s * points;
+    let g = guide_of[s];
+    let total = strand_length(base, points);
+    let phase0 = unit(strands[g].id, params.seed) * 3.9 + unit(strands[s].id, params.seed ^ 0xC0FFu) * params.random_offset;
+    var walk = walker_new(g * points, points);
+    dst[base] = src[base];
+    var travelled = 0.0;
+    for (var j = 1u; j < points; j++) {
+        travelled += distance(point_at(base, j), point_at(base, j - 1u));
+        let t = travelled / max(total, 1e-12);
+        let phase = (travelled * params.turns_per_metre + phase0) * TAU;
+        let r = params.radius * (params.factor_start + (params.factor_end - params.factor_start) * t);
+        let at = walker_at(&walk, travelled);
+        let circle = at.normal * (sin(phase) * r) + at.binormal * (cos(phase) * r);
+        let ease = sqrt(smootherstep1(-1e-5, params.curl_start, t));
+        let p = point_at(base, j);
+        dst[base + j] = vec4<f32>(p + (at.position - p + circle) * (ease * params.factor), src[base + j].w);
+    }
+}
+"#,
+    )
+}
+
+/// Waves across each strand, in the plane it lies in, a phase a lock.
+pub fn wave() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+{PER_STRAND}
+{WITH_GUIDES}
+struct Params {{
+    count: u32,
+    points: u32,
+    seed: u32,
+    pad0: u32,
+    amplitude: f32,
+    wavelength: f32,
+    start: f32,
+    random_phase: f32,
+}};
+@group(0) @binding(4) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM, MATH, WALK],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let base = s * points;
+    let total = strand_length(base, points);
+    let lock = strands[guide_of[s]].id;
+    let phase = (unit(lock, params.seed) + signed1(strands[s].id, params.seed ^ 0x51u) * params.random_phase) * TAU;
+    let out = strands[s].normal;
+    dst[base] = src[base];
+    var travelled = 0.0;
+    for (var j = 1u; j < points; j++) {
+        travelled += distance(point_at(base, j), point_at(base, j - 1u));
+        let t = tangent_at(base, points, j);
+        let across = safe_normalize(cross(t, out), orthogonal(t));
+        let ease = smoothstep1(params.start * 0.5, params.start + 0.1, travelled / max(total, 1e-12));
+        let w = sin(travelled / max(params.wavelength, 1e-3) * TAU + phase);
+        dst[base + j] = vec4<f32>(point_at(base, j) + across * (params.amplitude * ease * w), src[base + j].w);
+    }
+    restore_lengths(base, points, 1.0);
+}
+"#,
+    )
+}
+
+/// Offsets in each strand's own frame -- noise or frizz -- walked from the
+/// root if cumulative, faded in by the shape.
+const DISPLACE: &str = r#"
+fn displace(s: u32, scale: f32, cumulative: bool, shape: f32, preserve: bool) {
+    let points = params.points;
+    let base = s * points;
+    let total = strand_length(base, points);
+    let first_segment = distance(point_at(base, 1u), point_at(base, 0u));
+    var t = tangent_at(base, points, 0u);
+    var n = orthogonal(t);
+    var root_offset = vec3<f32>(0.0);
+    var trailing = vec3<f32>(0.0);
+    var travelled = 0.0;
+    for (var j = 0u; j < points; j++) {
+        if (j > 0u) {
+            travelled += distance(point_at(base, j), point_at(base, j - 1u));
+            let next = tangent_at(base, points, j);
+            n = transport(n, t, next);
+            t = next;
+        }
+        let r = offset_at(s, j, travelled, first_segment, scale);
+        let b = cross(t, n);
+        let v = t * r.x + b * r.y + n * r.z;
+        if (j == 0u) {
+            root_offset = v;
+        }
+        var o: vec3<f32>;
+        if (cumulative) {
+            let leading = trailing + v;
+            o = (leading + trailing - root_offset) * 0.5;
+            trailing = leading;
+        } else {
+            o = v - root_offset;
+        }
+        let fade = shape_range(travelled / max(total, 1e-12), 0.0, 1.0, shape);
+        dst[base + j] = vec4<f32>(point_at(base, j) + o * fade, src[base + j].w);
+    }
+    if (preserve) {
+        restore_lengths(base, points, 1.0);
+    }
+}
+"#;
+
+/// `Hair Curves Noise`: coherent Perlin waviness.
+pub fn noise() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+{PER_STRAND}
+struct Params {{
+    count: u32,
+    points: u32,
+    seed: u32,
+    cumulative: u32,
+    scale_total: f32,
+    shape: f32,
+    scale: f32,
+    scale_along: f32,
+    offset_per_curve: f32,
+    preserve: u32,
+    origin_x: f32,
+    origin_y: f32,
+    origin_z: f32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+}};
+@group(0) @binding(3) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM, NOISE, MATH, WALK],
+        r#"
+fn offset_at(s: u32, j: u32, travelled: f32, first_segment: f32, scale: f32) -> vec3<f32> {
+    let base = src[s * params.points].xyz * params.scale + vec3<f32>(params.origin_x, params.origin_y, params.origin_z);
+    let along = signed1(strands[s].id, params.seed) * params.offset_per_curve;
+    let z = travelled * params.scale_along + along;
+    let c = noise_color(base + vec3<f32>(0.0, 0.0, z), 5.0);
+    return (c - vec3<f32>(0.5)) * (2.0 * scale);
+}
+"#,
+    ) + DISPLACE
+        + r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    displace(s, params.scale_total, params.cumulative != 0u, params.shape, params.preserve != 0u);
+}
+"#
+}
+
+/// `Frizz Hair Curves`: a few flyaways wander, the rest barely.
+pub fn frizz() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+{PER_STRAND}
+struct Params {{
+    count: u32,
+    points: u32,
+    seed: u32,
+    cumulative: u32,
+    scale_total: f32,
+    shape: f32,
+    share: f32,
+    calm: f32,
+    frequency: f32,
+    preserve: u32,
+    pad0: u32,
+    pad1: u32,
+}};
+@group(0) @binding(3) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM, NOISE, MATH, WALK],
+        r#"
+fn offset_at(s: u32, j: u32, travelled: f32, first_segment: f32, scale: f32) -> vec3<f32> {
+    let sid = strands[s].id;
+    if (params.frequency > 0.0) {
+        let origin = signed3(sid, params.seed ^ 0x0F75u) * 50.0;
+        let q = origin + vec3<f32>(0.0, 0.0, travelled * params.frequency);
+        let c = noise_color(q, 1.0) - vec3<f32>(0.5);
+        return c * (2.0 * scale * max(first_segment, 1e-6) * params.frequency);
+    }
+    return signed3(hash2(sid, j), params.seed) * scale;
+}
+"#,
+    ) + DISPLACE
+        + r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let wild = unit(strands[s].id, params.seed ^ 0xF1A7u) < params.share;
+    let scale = select(params.scale_total * params.calm, params.scale_total, wild);
+    if (scale == 0.0) {
+        copy_strand(s * params.points, params.points);
+        return;
+    }
+    displace(s, scale, params.cumulative != 0u, params.shape, params.preserve != 0u);
+}
+"#
+}
+
+/// `Smooth Hair Curves`: each point averaged with its neighbours, the root
+/// held, the tip smoothed against its own extension.
+pub fn smooth() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+{PER_STRAND}
+struct Params {{
+    count: u32,
+    points: u32,
+    iterations: u32,
+    preserve: u32,
+    factor: f32,
+    pad0: u32,
+    pad1: u32,
+    pad2: u32,
+}};
+@group(0) @binding(3) var<uniform> params: Params;
+"#
+        ),
+        &[MATH, WALK],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let base = s * points;
+    copy_strand(base, points);
+    let tip = points - 1u;
+    let extended = point_at(base, tip) * 2.0 - point_at(base, tip - 1u);
+    let w = clamp(params.factor, 0.0, 1.0);
+    for (var k = 0u; k < params.iterations; k++) {
+        // Jacobi in place: the old value of the point before is carried.
+        var before = dst[base].xyz;
+        for (var j = 1u; j < points; j++) {
+            let here = dst[base + j].xyz;
+            var after = extended;
+            if (j + 1u < points) {
+                after = dst[base + j + 1u].xyz;
+            }
+            let average = (before + here + after) * (1.0 / 3.0);
+            dst[base + j] = vec4<f32>(mix(here, average, w), dst[base + j].w);
+            before = here;
+        }
+    }
+    if (params.preserve != 0u) {
+        restore_lengths(base, points, 1.0);
+    }
+}
+"#,
+    )
+}
+
+/// `Shrinkwrap Hair Curves`: out of the head, the move blurred along the
+/// strand, then anything still in pushed straight out.
+pub fn shrinkwrap() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+{PER_STRAND}
+@group(0) @binding(3) var<storage, read> head_shape: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read_write> moves: array<vec4<f32>>;
+struct Params {{
+    count: u32,
+    points: u32,
+    smoothing: u32,
+    lock_roots: u32,
+    factor: f32,
+    offset: f32,
+    above_surface: f32,
+    preserve: u32,
+}};
+@group(0) @binding(5) var<uniform> params: Params;
+"#
+        ),
+        &[MATH, HEAD, WALK],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let base = s * points;
+    let offset = max(params.offset, 1e-10);
+    var any_move = false;
+    for (var j = 0u; j < points; j++) {
+        let p = point_at(base, j);
+        let locked = j == 0u && params.lock_roots != 0u;
+        let d = head_distance(p);
+        var weight = 0.0;
+        if (!locked && d < offset) {
+            if (d < 0.0) {
+                weight = 1.0;
+            } else {
+                weight = 1.0 + (params.above_surface - 1.0) * (d / offset);
+            }
+        }
+        var m = vec3<f32>(0.0);
+        if (weight > 0.0) {
+            m = head_gradient(p) * (offset - d) * weight;
+            any_move = true;
+        }
+        moves[base + j] = vec4<f32>(m, select(1.0, 0.0, locked));
+    }
+    if (!any_move) {
+        copy_strand(base, points);
+        return;
+    }
+    // Blur the moves along the strand, root and tip held.
+    for (var k = 0u; k < params.smoothing; k++) {
+        var before = moves[base].xyz;
+        for (var j = 1u; j + 1u < points; j++) {
+            let here = moves[base + j];
+            let after = moves[base + j + 1u].xyz;
+            let average = (before + here.xyz + after) * (1.0 / 3.0);
+            moves[base + j] = vec4<f32>(mix(here.xyz, average, clamp(here.w, 0.0, 1.0)), here.w);
+            before = here.xyz;
+        }
+    }
+    for (var j = 0u; j < points; j++) {
+        dst[base + j] = vec4<f32>(point_at(base, j) + moves[base + j].xyz * params.factor, src[base + j].w);
+    }
+    if (params.preserve != 0u) {
+        restore_lengths(base, points, 1.0);
+    }
+    if (params.factor >= 1.0) {
+        for (var j = 1u; j < points; j++) {
+            dst[base + j] = vec4<f32>(push_out(dst[base + j].xyz, params.offset * 0.5), dst[base + j].w);
+        }
+    }
+}
+"#,
+    )
+}
+
+/// `Set Hair Curve Profile`: each strand's root radius.
+pub fn profile() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+@group(0) @binding(0) var<storage, read_write> strands: array<StrandGpu>;
+struct Params {{
+    count: u32,
+    seed: u32,
+    relative: u32,
+    pad0: u32,
+    radius: f32,
+    random: f32,
+    grown: f32,
+    pad1: u32,
+}};
+@group(0) @binding(1) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    var base = params.radius;
+    if (params.relative != 0u && params.grown > 0.0) {
+        base = params.radius * strands[s].radius / params.grown;
+    }
+    strands[s].radius = base * max(1.0 + params.random * signed1(strands[s].id, params.seed), 0.05);
+}
+"#,
+    )
+}
+
+/// One solve of the drape ([`crate::ops::Settle`]): each strand's
+/// equilibrium as an elastic rod under `load`, from its groomed shape in
+/// `src`, into `solved`. The suffix sums of a sweep and the joints'
+/// directions are kept in `moments` and `dirs`, a strand's own stretch of
+/// each, never in a local array.
+pub fn settle_solve() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> src: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> solved: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> moments: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> dirs: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read> head_shape: array<vec4<f32>>;
+struct Params {
+    count: u32,
+    points: u32,
+    iterations: u32,
+    pad0: u32,
+    load_x: f32,
+    load_y: f32,
+    load_z: f32,
+    compliance: f32,
+    collision_offset: f32,
+    pad1: u32,
+    pad2: u32,
+    pad3: u32,
+};
+@group(0) @binding(5) var<uniform> params: Params;
+"#,
+        &[MATH, HEAD],
+        r#"
+fn rest_dir(base: u32, i: u32) -> vec3<f32> {
+    return safe_normalize(src[base + i + 1u].xyz - src[base + i].xyz, vec3<f32>(0.0, -1.0, 0.0));
+}
+
+fn rest_length(base: u32, i: u32) -> f32 {
+    return distance(src[base + i + 1u].xyz, src[base + i].xyz);
+}
+
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let segments = points - 1u;
+    let base = s * points;
+    let load = vec3<f32>(params.load_x, params.load_y, params.load_z);
+    for (var j = 0u; j < points; j++) {
+        solved[base + j] = src[base + j];
+    }
+    let magnitude = length(load);
+    if (magnitude < 1e-6) {
+        return;
+    }
+    let force = load / magnitude;
+    for (var i = 0u; i < segments; i++) {
+        dirs[base + i] = vec4<f32>(rest_dir(base, i), 0.0);
+    }
+    for (var sweep = 0u; sweep < params.iterations; sweep++) {
+        // Suffix sums of each segment's centre times its length, and of the
+        // lengths: the moment about point i of the load on all past it.
+        var arm = vec3<f32>(0.0);
+        var total = 0.0;
+        moments[base + segments] = vec4<f32>(0.0);
+        for (var k = 0u; k < segments; k++) {
+            let j = segments - 1u - k;
+            let l = rest_length(base, j);
+            arm += (solved[base + j].xyz + solved[base + j + 1u].xyz) * 0.5 * l;
+            total += l;
+            moments[base + j] = vec4<f32>(arm, total);
+        }
+        // Root to tip: each joint bends from its groomed angle -- carried
+        // along as its parent turned -- towards the load.
+        var position = solved[base].xyz;
+        for (var i = 0u; i < segments; i++) {
+            var groomed = rest_dir(base, 0u);
+            if (i > 0u) {
+                groomed = transport(rest_dir(base, i), rest_dir(base, i - 1u), dirs[base + i - 1u].xyz);
+            }
+            let m = moments[base + i];
+            let moment = cross(m.xyz - solved[base + i].xyz * m.w, load);
+            let torque = length(moment);
+            var target_dir = groomed;
+            if (torque > 1e-12) {
+                let axis = cross(groomed, force);
+                let sin_angle = length(axis);
+                if (sin_angle > 1e-6) {
+                    let limit = atan2(sin_angle, dot(groomed, force));
+                    let bend = min(torque * params.compliance * rest_length(base, i), limit);
+                    target_dir = rotate(groomed, axis / sin_angle, bend);
+                }
+            }
+            let d = safe_normalize(lerp3(dirs[base + i].xyz, target_dir, 0.5), target_dir);
+            let l = rest_length(base, i);
+            var next = position + d * l;
+            // The body holds the hair up.
+            if (head_distance(next) < params.collision_offset) {
+                next = push_out(next, params.collision_offset);
+                next = position + safe_normalize(next - position, d) * l;
+            }
+            dirs[base + i] = vec4<f32>(safe_normalize(next - position, d), 0.0);
+            solved[base + i + 1u] = vec4<f32>(next, solved[base + i + 1u].w);
+            position = next;
+        }
+    }
+}
+"#,
+    )
+}
+
+/// The drape applied: the groom moved by what changed between the solve
+/// under the asked conditions and under standard ones, lengths restored
+/// and kept off the body (or, not relative, the solve itself).
+pub fn settle_apply() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+{PER_STRAND}
+@group(0) @binding(3) var<storage, read> under: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read> standard: array<vec4<f32>>;
+@group(0) @binding(5) var<storage, read> head_shape: array<vec4<f32>>;
+struct Params {{
+    count: u32,
+    points: u32,
+    relative: u32,
+    pad0: u32,
+    collision_offset: f32,
+    pad1: u32,
+    pad2: u32,
+    pad3: u32,
+}};
+@group(0) @binding(6) var<uniform> params: Params;
+"#
+        ),
+        &[MATH, HEAD, WALK],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let s = item(id, groups);
+    if (s >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let base = s * points;
+    if (params.relative == 0u) {
+        for (var j = 0u; j < points; j++) {
+            dst[base + j] = under[base + j];
+        }
+        return;
+    }
+    for (var j = 0u; j < points; j++) {
+        dst[base + j] = vec4<f32>(src[base + j].xyz + under[base + j].xyz - standard[base + j].xyz, src[base + j].w);
+    }
+    restore_lengths(base, points, 1.0);
+    for (var j = 1u; j < points; j++) {
+        dst[base + j] = vec4<f32>(push_out(dst[base + j].xyz, params.collision_offset * 0.5), dst[base + j].w);
+    }
+}
+"#,
+    )
+}
+
+/// The most points a strand may have for [`settle_solve_few`].
+pub const SETTLE_FEW_POINTS: u32 = 192;
+
+/// Both solves of the drape for a few strands -- the guides -- a workgroup
+/// a strand and a solve (`y` 0 under the asked load, 1 under the reference
+/// one). A few hundred invocations cannot hide storage's latency from
+/// each other, so each strand's joints live in workgroup memory while one
+/// lane runs its sweeps; the others load and store it.
+pub fn settle_solve_few() -> String {
+    kernel(
+        &format!(
+            r#"
+@group(0) @binding(0) var<storage, read> src: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read_write> under: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read_write> standard: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read> head_shape: array<vec4<f32>>;
+struct Params {{
+    count: u32,
+    points: u32,
+    iterations: u32,
+    pad0: u32,
+    load_x: f32,
+    load_y: f32,
+    load_z: f32,
+    compliance: f32,
+    reference_x: f32,
+    reference_y: f32,
+    reference_z: f32,
+    collision_offset: f32,
+}};
+@group(0) @binding(4) var<uniform> params: Params;
+
+const FEW: u32 = {SETTLE_FEW_POINTS}u;
+// Each segment's groomed direction and length.
+var<workgroup> segments_rest: array<vec4<f32>, FEW>;
+var<workgroup> solved: array<vec4<f32>, FEW>;
+var<workgroup> dirs: array<vec4<f32>, FEW>;
+// Suffix sums: each segment's centre times its length, and the lengths.
+var<workgroup> moments: array<vec4<f32>, FEW>;
+"#
+        ),
+        &[MATH, HEAD],
+        r#"
+@compute @workgroup_size(32)
+fn main(@builtin(workgroup_id) wid: vec3<u32>, @builtin(local_invocation_index) lane: u32) {
+    let s = wid.x;
+    let which = wid.y;
+    if (s >= params.count) {
+        return;
+    }
+    let points = params.points;
+    let segments = points - 1u;
+    let base = s * points;
+    var load = vec3<f32>(params.load_x, params.load_y, params.load_z);
+    if (which == 1u) {
+        load = vec3<f32>(params.reference_x, params.reference_y, params.reference_z);
+    }
+    for (var j = lane; j < points; j += 32u) {
+        solved[j] = src[base + j];
+        if (j < segments) {
+            let d = src[base + j + 1u].xyz - src[base + j].xyz;
+            let rest = safe_normalize(d, vec3<f32>(0.0, -1.0, 0.0));
+            segments_rest[j] = vec4<f32>(rest, length(d));
+            dirs[j] = vec4<f32>(rest, 0.0);
+        }
+    }
+    workgroupBarrier();
+    let magnitude = length(load);
+    if (lane == 0u && magnitude >= 1e-6) {
+        let force = load / magnitude;
+        for (var sweep = 0u; sweep < params.iterations; sweep++) {
+            var arm = vec3<f32>(0.0);
+            var total = 0.0;
+            moments[segments] = vec4<f32>(0.0);
+            for (var k = 0u; k < segments; k++) {
+                let j = segments - 1u - k;
+                let l = segments_rest[j].w;
+                arm += (solved[j].xyz + solved[j + 1u].xyz) * 0.5 * l;
+                total += l;
+                moments[j] = vec4<f32>(arm, total);
+            }
+            var position = solved[0].xyz;
+            for (var i = 0u; i < segments; i++) {
+                let rest = segments_rest[i];
+                var groomed = segments_rest[0].xyz;
+                if (i > 0u) {
+                    groomed = transport(rest.xyz, segments_rest[i - 1u].xyz, dirs[i - 1u].xyz);
+                }
+                let m = moments[i];
+                let torque = length(cross(m.xyz - solved[i].xyz * m.w, load));
+                var target_dir = groomed;
+                if (torque > 1e-12) {
+                    let axis = cross(groomed, force);
+                    let sin_angle = length(axis);
+                    if (sin_angle > 1e-6) {
+                        let limit = atan2(sin_angle, dot(groomed, force));
+                        let bend = min(torque * params.compliance * rest.w, limit);
+                        target_dir = rotate(groomed, axis / sin_angle, bend);
+                    }
+                }
+                let d = safe_normalize(lerp3(dirs[i].xyz, target_dir, 0.5), target_dir);
+                var next = position + d * rest.w;
+                // The body holds the hair up.
+                if (head_distance(next) < params.collision_offset) {
+                    next = push_out(next, params.collision_offset);
+                    next = position + safe_normalize(next - position, d) * rest.w;
+                }
+                dirs[i] = vec4<f32>(safe_normalize(next - position, d), 0.0);
+                solved[i + 1u] = vec4<f32>(next, solved[i + 1u].w);
+                position = next;
+            }
+        }
+    }
+    workgroupBarrier();
+    for (var j = lane; j < points; j += 32u) {
+        if (which == 0u) {
+            under[base + j] = solved[j];
+        } else {
+            standard[base + j] = solved[j];
+        }
+    }
+}
+"#,
+    )
+}
diff --git a/crates/fabelgeist-hair/src/gpu/wgsl/guides.rs b/crates/fabelgeist-hair/src/gpu/wgsl/guides.rs
new file mode 100644
index 000000000..235ec63cc
--- /dev/null
+++ b/crates/fabelgeist-hair/src/gpu/wgsl/guides.rs
@@ -0,0 +1,1129 @@
+//! The guides' kernels: [`crate::hairdo::Hairdo::guides`] on the GPU.
+//!
+//! Roots are drawn as the host draws them -- candidates hashed by index,
+//! kept greedily in index order while none is nearer another than the
+//! spacing, then a row along the hairline -- so the same roots come out.
+//! The greedy pass is sequential by nature; one workgroup runs it, a chunk
+//! of candidates at a time checked in parallel against the roots kept so
+//! far, the few survivors of a chunk settled among themselves in order.
+//! Then every guide is combed by an invocation of its own, drawing from a
+//! [`crate::rng::Stream`] as the host does: its path into a buffer, then
+//! resampled.
+
+use super::common::{HEAD, INDEX, MATH, RANDOM, STRAND};
+use super::groom::{GROWTH, PARTING};
+
+fn kernel(bindings: &str, helpers: &[&str], body: &str) -> String {
+    let mut source = String::from(bindings);
+    for h in helpers {
+        source.push_str(h);
+    }
+    source.push_str(INDEX);
+    source.push_str(body);
+    source
+}
+
+/// Scalp candidates for guide roots: candidate `i` at the shares
+/// [`crate::surface::Surface::sample_at`] takes, hashed from its index.
+/// Three words a candidate: position, normal, uv.
+pub fn guide_candidates() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> tri_cdf: array<f32>;
+@group(0) @binding(1) var<storage, read> tri_index: array<vec4<u32>>;
+@group(0) @binding(2) var<storage, read> scalp_points: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read> scalp_normals: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read> scalp_uvs: array<vec4<f32>>;
+@group(0) @binding(5) var<storage, read_write> candidates: array<vec4<f32>>;
+struct Params {
+    count: u32,
+    triangles: u32,
+    seed_share: u32,
+    seed_u: u32,
+    seed_v: u32,
+    area: f32,
+    pad0: u32,
+    pad1: u32,
+};
+@group(0) @binding(6) var<uniform> params: Params;
+"#,
+        &[RANDOM, MATH],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let i = item(id, groups);
+    if (i >= params.count) {
+        return;
+    }
+    let target_area = unit(i, params.seed_share) * params.area;
+    // The first triangle whose running area reaches the target.
+    var lo = 0u;
+    var hi = params.triangles;
+    while (lo < hi) {
+        let mid = (lo + hi) / 2u;
+        if (tri_cdf[mid] < target_area) {
+            lo = mid + 1u;
+        } else {
+            hi = mid;
+        }
+    }
+    let t = min(lo, params.triangles - 1u);
+    var u = unit(i, params.seed_u);
+    var v = unit(i, params.seed_v);
+    if (u + v > 1.0) {
+        u = 1.0 - u;
+        v = 1.0 - v;
+    }
+    let w = vec3<f32>(1.0 - u - v, u, v);
+    let tri = tri_index[t];
+    let position = scalp_points[tri.x].xyz * w.x + scalp_points[tri.y].xyz * w.y + scalp_points[tri.z].xyz * w.z;
+    let normal = normalize(scalp_normals[tri.x].xyz * w.x + scalp_normals[tri.y].xyz * w.y + scalp_normals[tri.z].xyz * w.z);
+    let uv = scalp_uvs[tri.x].xy * w.x + scalp_uvs[tri.y].xy * w.y + scalp_uvs[tri.z].xy * w.z;
+    candidates[i * 3u] = vec4<f32>(position, 0.0);
+    candidates[i * 3u + 1u] = vec4<f32>(normal, 0.0);
+    candidates[i * 3u + 2u] = vec4<f32>(uv, 0.0, 0.0);
+}
+"#,
+    )
+}
+
+/// The closest point on a triangle (Ericson's region test).
+const CLOSEST: &str = r#"
+fn closest_on_triangle(p: vec3<f32>, a: vec3<f32>, b: vec3<f32>, c: vec3<f32>) -> vec3<f32> {
+    let ab = b - a;
+    let ac = c - a;
+    let ap = p - a;
+    let d1 = dot(ab, ap);
+    let d2 = dot(ac, ap);
+    if (d1 <= 0.0 && d2 <= 0.0) {
+        return a;
+    }
+    let bp = p - b;
+    let d3 = dot(ab, bp);
+    let d4 = dot(ac, bp);
+    if (d3 >= 0.0 && d4 <= d3) {
+        return b;
+    }
+    let vc = d1 * d4 - d3 * d2;
+    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
+        return a + ab * (d1 / (d1 - d3));
+    }
+    let cp = p - c;
+    let d5 = dot(ab, cp);
+    let d6 = dot(ac, cp);
+    if (d6 >= 0.0 && d5 <= d6) {
+        return c;
+    }
+    let vb = d5 * d2 - d1 * d6;
+    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
+        return a + ac * (d2 / (d2 - d6));
+    }
+    let va = d3 * d6 - d5 * d4;
+    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
+        return b + (c - b) * ((d4 - d3) / ((d4 - d3) + (d5 - d6)));
+    }
+    let denom = 1.0 / (va + vb + vc);
+    return a + ab * (vb * denom) + ac * (vc * denom);
+}
+
+// Barycentric weights of `p` in the triangle, as `surface::barycentric`.
+fn barycentric3(p: vec3<f32>, a: vec3<f32>, b: vec3<f32>, c: vec3<f32>) -> vec3<f32> {
+    let v0 = b - a;
+    let v1 = c - a;
+    let v2 = p - a;
+    let d00 = dot(v0, v0);
+    let d01 = dot(v0, v1);
+    let d11 = dot(v1, v1);
+    let d20 = dot(v2, v0);
+    let d21 = dot(v2, v1);
+    let denom = d00 * d11 - d01 * d01;
+    if (abs(denom) < 1e-20) {
+        return vec3<f32>(1.0, 0.0, 0.0);
+    }
+    let v = (d11 * d20 - d01 * d21) / denom;
+    let w = (d00 * d21 - d01 * d20) / denom;
+    return vec3<f32>(1.0 - v - w, v, w);
+}
+"#;
+
+/// Each point along the scalp's hairline, moved to the closest point of the
+/// scalp within a centimetre: three words (position with `w` one if there
+/// is one, normal, uv).
+pub fn edge_closest() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> boundary: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> tri_index: array<vec4<u32>>;
+@group(0) @binding(2) var<storage, read> scalp_points: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read> scalp_normals: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read> scalp_uvs: array<vec4<f32>>;
+@group(0) @binding(5) var<storage, read_write> closest: array<vec4<f32>>;
+struct Params {
+    count: u32,
+    triangles: u32,
+    max_distance: f32,
+    pad0: u32,
+};
+@group(0) @binding(6) var<uniform> params: Params;
+"#,
+        &[CLOSEST],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let i = item(id, groups);
+    if (i >= params.count) {
+        return;
+    }
+    let p = boundary[i].xyz;
+    var best = params.max_distance;
+    var found = false;
+    var best_point = p;
+    var best_triangle = 0u;
+    for (var t = 0u; t < params.triangles; t++) {
+        let tri = tri_index[t];
+        let a = scalp_points[tri.x].xyz;
+        // A triangle is a few millimetres across: one whose corner is far
+        // cannot be near.
+        if (distance(p, a) > best + 0.03) {
+            continue;
+        }
+        let q = closest_on_triangle(p, a, scalp_points[tri.y].xyz, scalp_points[tri.z].xyz);
+        let d = distance(p, q);
+        if (d <= best) {
+            best = d;
+            best_point = q;
+            best_triangle = t;
+            found = true;
+        }
+    }
+    if (!found) {
+        closest[i * 3u] = vec4<f32>(p, 0.0);
+        return;
+    }
+    let tri = tri_index[best_triangle];
+    let w = barycentric3(best_point, scalp_points[tri.x].xyz, scalp_points[tri.y].xyz, scalp_points[tri.z].xyz);
+    let position = scalp_points[tri.x].xyz * w.x + scalp_points[tri.y].xyz * w.y + scalp_points[tri.z].xyz * w.z;
+    let normal = normalize(scalp_normals[tri.x].xyz * w.x + scalp_normals[tri.y].xyz * w.y + scalp_normals[tri.z].xyz * w.z);
+    let uv = scalp_uvs[tri.x].xy * w.x + scalp_uvs[tri.y].xy * w.y + scalp_uvs[tri.z].xy * w.z;
+    closest[i * 3u] = vec4<f32>(position, 1.0);
+    closest[i * 3u + 1u] = vec4<f32>(normal, 0.0);
+    closest[i * 3u + 2u] = vec4<f32>(uv, 0.0, 0.0);
+}
+"#,
+    )
+}
+
+/// The guides' roots, greedily in index order, one workgroup: candidates
+/// kept while no kept root is nearer than `spacing`, up to `wanted`; then
+/// the hairline's points, each moved onto the scalp, kept while no kept
+/// hairline point is nearer than `edge_spacing` and no root nearer than
+/// half the spacing. `counts` gets how many of each.
+pub fn guide_select() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> candidates: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> boundary: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> closest: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> root_position: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read_write> root_normal: array<vec4<f32>>;
+@group(0) @binding(5) var<storage, read_write> root_uv: array<vec4<f32>>;
+@group(0) @binding(6) var<storage, read_write> counts: array<u32>;
+struct Params {
+    candidate_count: u32,
+    wanted: u32,
+    boundary_count: u32,
+    pad0: u32,
+    spacing: f32,
+    edge_spacing: f32,
+    pad1: u32,
+    pad2: u32,
+};
+@group(0) @binding(7) var<uniform> params: Params;
+
+var<workgroup> kept: u32;
+var<workgroup> survive: array<u32, 256>;
+"#,
+        &[],
+        r#"
+fn keep_root(slot: u32, position: vec3<f32>, normal: vec3<f32>, uv: vec2<f32>, from_edge: f32) {
+    root_position[slot] = vec4<f32>(position, from_edge);
+    root_normal[slot] = vec4<f32>(normal, 0.0);
+    root_uv[slot] = vec4<f32>(uv, 0.0, 0.0);
+}
+
+// Whether `p` is nearer than `radius` to any kept root in `first..last`
+// (by the hairline point it came from, for the row: `w` holds its index
+// plus one).
+fn near_kept(p: vec3<f32>, first: u32, last: u32, radius: f32, by_edge: bool) -> bool {
+    let r2 = radius * radius;
+    for (var k = first; k < last; k++) {
+        var q = root_position[k].xyz;
+        if (by_edge) {
+            q = boundary[u32(root_position[k].w) - 1u].xyz;
+        }
+        let o = q - p;
+        if (dot(o, o) < r2) {
+            return true;
+        }
+    }
+    return false;
+}
+
+@compute @workgroup_size(256)
+fn main(@builtin(local_invocation_index) lid: u32) {
+    if (lid == 0u) {
+        kept = 0u;
+    }
+    // The roots.
+    var chunk = 0u;
+    loop {
+        storageBarrier();
+        let before = workgroupUniformLoad(&kept);
+        if (before >= params.wanted || chunk >= params.candidate_count) {
+            break;
+        }
+        let i = chunk + lid;
+        var ok = 0u;
+        if (i < params.candidate_count && !near_kept(candidates[i * 3u].xyz, 0u, before, params.spacing, false)) {
+            ok = 1u;
+        }
+        survive[lid] = ok;
+        workgroupBarrier();
+        if (lid == 0u) {
+            var n = before;
+            for (var k = 0u; k < 256u; k++) {
+                if (n >= params.wanted) {
+                    break;
+                }
+                if (survive[k] == 0u) {
+                    continue;
+                }
+                let c = (chunk + k) * 3u;
+                let p = candidates[c].xyz;
+                if (near_kept(p, before, n, params.spacing, false)) {
+                    continue;
+                }
+                keep_root(n, p, candidates[c + 1u].xyz, candidates[c + 2u].xy, 0.0);
+                n += 1u;
+            }
+            kept = n;
+        }
+        chunk += 256u;
+    }
+    storageBarrier();
+    let roots = workgroupUniformLoad(&kept);
+    // The row along the hairline, after them.
+    chunk = 0u;
+    loop {
+        storageBarrier();
+        let before = workgroupUniformLoad(&kept);
+        if (chunk >= params.boundary_count) {
+            break;
+        }
+        let i = chunk + lid;
+        var ok = 0u;
+        if (i < params.boundary_count && closest[i * 3u].w > 0.5) {
+            let p = boundary[i].xyz;
+            if (!near_kept(p, roots, before, params.edge_spacing, true)
+                && !near_kept(p, 0u, roots, 0.5 * params.spacing, false)) {
+                ok = 1u;
+            }
+        }
+        survive[lid] = ok;
+        workgroupBarrier();
+        if (lid == 0u) {
+            var n = before;
+            for (var k = 0u; k < 256u; k++) {
+                if (survive[k] == 0u) {
+                    continue;
+                }
+                let e = chunk + k;
+                if (near_kept(boundary[e].xyz, before, n, params.edge_spacing, true)) {
+                    continue;
+                }
+                let c = e * 3u;
+                keep_root(n, closest[c].xyz, closest[c + 1u].xyz, closest[c + 2u].xy, f32(e + 1u));
+                n += 1u;
+            }
+            kept = n;
+        }
+        chunk += 256u;
+    }
+    storageBarrier();
+    let all = workgroupUniformLoad(&kept);
+    if (lid == 0u) {
+        counts[0] = roots;
+        counts[1] = all;
+    }
+}
+"#,
+    )
+}
+
+/// The hairdo, as the comb reads it; [`crate::gpu::guides::HairdoGpu`]
+/// mirrors it field for field.
+const HAIRDO: &str = r#"
+struct Hairdo {
+    guides: u32,
+    points: u32,
+    max_path: u32,
+    key: u32,
+    variation: f32,
+    angle: f32,
+    angle_spread: f32,
+    direction_spread: f32,
+    kink: f32,
+    growth: u32,
+    whorls: u32,
+    fringe_falls: u32,
+    center_x: f32,
+    center_y: f32,
+    center_z: f32,
+    lanes: u32,
+    w0_x: f32,
+    w0_y: f32,
+    w0_z: f32,
+    w0_spiral: f32,
+    w0_hand: f32,
+    w0_reach: f32,
+    w1_x: f32,
+    w1_y: f32,
+    w1_z: f32,
+    w1_spiral: f32,
+    w1_hand: f32,
+    w1_reach: f32,
+    top: f32,
+    front: f32,
+    sides: f32,
+    back: f32,
+    has_hemline: u32,
+    hemline: f32,
+    slope: f32,
+    clip: f32,
+    clipper: f32,
+    fade: f32,
+    strip: f32,
+    has_fringe: u32,
+    fringe_width: f32,
+    fringe_depth: f32,
+    fringe_drop: f32,
+    dome: f32,
+    flow: u32,
+    flow_value: f32,
+    part: f32,
+    hold: f32,
+    lift: f32,
+    volume: f32,
+    cling: f32,
+    tuck: f32,
+    hairline_front: f32,
+    hairline_side: f32,
+    hairline_back: f32,
+    recession: f32,
+    peak: f32,
+    tied: u32,
+    tie_x: f32,
+    tie_y: f32,
+    tie_z: f32,
+    out_x: f32,
+    out_y: f32,
+    out_z: f32,
+    axis_len: u32,
+};
+"#;
+
+/// The head's hairline, from `hairdo` (or, replaced, any struct with the
+/// same fields): `Head`'s queries.
+pub(super) const HAIRLINE: &str = r#"
+fn cranium_center() -> vec3<f32> {
+    return head_shape[0].xyz;
+}
+
+fn azimuth(p: vec3<f32>) -> f32 {
+    let q = p - cranium_center();
+    return atan2(q.x, q.z);
+}
+
+fn around(front: f32, side: f32, back: f32, a: f32) -> f32 {
+    let a1 = (front - back) * 0.5;
+    let a0_plus_a2 = (front + back) * 0.5;
+    let a0 = (a0_plus_a2 + side) * 0.5;
+    let a2 = a0_plus_a2 - a0;
+    return a0 + a1 * cos(a) + a2 * cos(2.0 * a);
+}
+
+fn hairline_height(a: f32) -> f32 {
+    let t = (abs(a) - 0.62) / 0.3;
+    let temples = exp(-(t * t));
+    let m = a / 0.13;
+    let middle = exp(-(m * m));
+    return around(hairdo.hairline_front, hairdo.hairline_side, hairdo.hairline_back, a)
+        + hairdo.recession * temples - hairdo.peak * middle;
+}
+
+fn above_hairline(p: vec3<f32>) -> f32 {
+    return p.y - hairline_height(azimuth(p));
+}
+
+fn elevation(p: vec3<f32>) -> f32 {
+    let a = azimuth(p);
+    let h = hairline_height(a);
+    let c = cranium_center();
+    let edge = c + vec3<f32>(sin(a) * 0.09, h - c.y, cos(a) * 0.09);
+    let hairline = clamp(head_polar(edge), 0.1, 2.6);
+    return clamp(1.0 - head_polar(p) / hairline, 0.0, 1.0);
+}
+
+"#;
+
+/// The haircut's queries, from the hairdo: `Haircut`'s.
+const CUT: &str = r#"
+fn fringe_holds(root: vec3<f32>) -> bool {
+    return hairdo.has_fringe != 0u && root.z > 0.1 - hairdo.fringe_depth && abs(root.x) < hairdo.fringe_width;
+}
+
+fn cut_clipped(root: vec3<f32>) -> bool {
+    return (hairdo.clip > 0.0 && elevation(root) < hairdo.clip - 0.5 * hairdo.fade)
+        || (hairdo.strip > 0.0 && abs(root.x) > hairdo.strip);
+}
+
+fn cut_length(root: vec3<f32>) -> f32 {
+    if (fringe_holds(root)) {
+        return 0.1 + hairdo.fringe_drop;
+    }
+    let e = elevation(root);
+    let ring = around(hairdo.front, hairdo.sides, hairdo.back, azimuth(root));
+    var cut = ring + (hairdo.top - ring) * smoothstep1(0.25, 0.85, e);
+    if (hairdo.clip > 0.0) {
+        let half = 0.5 * hairdo.fade + 1e-3;
+        let t = smoothstep1(hairdo.clip - half, hairdo.clip + half, e);
+        cut = hairdo.clipper + (cut - hairdo.clipper) * t;
+    }
+    if (hairdo.strip > 0.0) {
+        let t = 1.0 - smoothstep1(hairdo.strip - 0.006, hairdo.strip, abs(root.x));
+        cut = hairdo.clipper + (cut - hairdo.clipper) * t;
+    }
+    return max(cut, 0.0005);
+}
+
+// Whether the strand from `root` is cut where it is at `p`.
+fn is_cut(root: vec3<f32>, p: vec3<f32>) -> bool {
+    if (fringe_holds(root)) {
+        return p.y < hairline_height(0.0) - hairdo.fringe_drop;
+    }
+    if (hairdo.has_hemline != 0u) {
+        return p.y < hairdo.hemline - hairdo.slope * p.z;
+    }
+    return false;
+}
+"#;
+
+/// A guide's own draws, as [`crate::rng::Stream`].
+const STREAM: &str = r#"
+var<private> stream_key: u32;
+var<private> stream_counter: u32;
+
+fn next_u32() -> u32 {
+    let value = hash2(stream_key, stream_counter);
+    stream_counter += 1u;
+    return value;
+}
+
+fn next_f32() -> f32 {
+    return f32(next_u32() >> 8u) / 16777216.0;
+}
+
+fn gaussian() -> f32 {
+    let u = max(next_f32(), 1e-7);
+    let v = next_f32();
+    return sqrt(-2.0 * log(u)) * cos(TAU * v);
+}
+"#;
+
+/// The tie: its axis from `tie_axis`, and where a strand is in its bundle.
+const TIE: &str = r#"
+fn tie_point() -> vec3<f32> {
+    return vec3<f32>(hairdo.tie_x, hairdo.tie_y, hairdo.tie_z);
+}
+
+fn tie_out() -> vec3<f32> {
+    return vec3<f32>(hairdo.out_x, hairdo.out_y, hairdo.out_z);
+}
+
+struct TieFrame {
+    p: vec3<f32>,
+    across: vec3<f32>,
+    depth: vec3<f32>,
+};
+
+fn tie_frame(s: f32) -> TieFrame {
+    let f = max(s / 0.002, 0.0);
+    let last = max(hairdo.axis_len, 2u) - 2u;
+    let i = min(u32(f), last);
+    let t = clamp(f - f32(i), 0.0, 1.0);
+    let a = tie_axis[i].xyz;
+    let b = tie_axis[i + 1u].xyz;
+    let d = safe_normalize(b - a, vec3<f32>(0.0, -1.0, 0.0));
+    let across = safe_normalize(cross(d, tie_out()), vec3<f32>(1.0, 0.0, 0.0));
+    return TieFrame(lerp3(a, b, t), across, cross(across, d));
+}
+
+fn bundled(along: f32, bundle: vec3<f32>, lane: f32, phase: f32) -> vec3<f32> {
+    let kind = u32(hairdo.flow_value);
+    if (kind == 1u) {
+        // The bun: coiled round the tie, out from the head as it winds.
+        let turns = along / 0.11;
+        let a = phase + turns * TAU;
+        let r = 0.018 + 0.01 * min(turns * 0.5, 1.0) + bundle.x;
+        let out = tie_out();
+        let u = safe_normalize(in_plane(vec3<f32>(0.0, 1.0, 0.0), out), vec3<f32>(0.0, 1.0, 0.0));
+        let v = cross(out, u);
+        return tie_point() + (u * cos(a) + v * sin(a)) * r
+            + out * (0.004 + 0.012 * min(turns * 0.4, 1.0) + bundle.y);
+    }
+    let frame = tie_frame(along);
+    if (kind == 2u) {
+        // The braid: three lanes plaited.
+        let phase_b = along / 0.035 * TAU + lane * TAU / 3.0;
+        let width = 0.016 * (1.0 - 0.45 * smoothstep1(0.0, 0.45, along));
+        let taper = 1.0 - smoothstep1(0.38, 0.5, along);
+        return frame.p + frame.across * (sin(phase_b) * width * taper + bundle.x * 0.6)
+            + frame.depth * (sin(2.0 * phase_b) * width * 0.35 * taper + bundle.y * 0.6);
+    }
+    // The tail.
+    let spread = 1.0 + 0.6 * smoothstep1(0.1, 0.4, along);
+    return frame.p + (frame.across * bundle.x + frame.depth * bundle.y) * spread;
+}
+"#;
+
+/// Every guide combed from its root, as `Hairdo::comb` combs it: a
+/// workgroup a guide, its lanes sampling the head's field together -- the
+/// distance at a point and the six around it the gradient is taken from,
+/// at once -- and running the rest of the comb in step, each drawing the
+/// same numbers. The path is kept in `path` and resampled to `points` into
+/// `positions`.
+pub fn guide_comb() -> String {
+    kernel(
+        &format!(
+            r#"
+{HAIRDO}
+@group(0) @binding(0) var<storage, read> root_position: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> root_normal: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> hairdo: Hairdo;
+@group(0) @binding(3) var<storage, read> head_shape: array<vec4<f32>>;
+@group(0) @binding(4) var<storage, read> tie_axis: array<vec4<f32>>;
+@group(0) @binding(5) var<storage, read_write> path: array<vec4<f32>>;
+@group(0) @binding(6) var<storage, read_write> positions: array<vec4<f32>>;
+
+var<workgroup> probes: array<f32, 8>;
+"#
+        ),
+        &[
+            RANDOM,
+            MATH,
+            HEAD,
+            &GROWTH.replace("params.", "hairdo."),
+            HAIRLINE,
+            CUT,
+            STREAM,
+            TIE,
+        ],
+        r#"
+const NATURAL: u32 = 0u;
+const PART: u32 = 1u;
+const SWEPT: u32 = 2u;
+const BACK: u32 = 3u;
+const FORWARD: u32 = 4u;
+const RADIAL: u32 = 5u;
+const DOWN: u32 = 6u;
+const TIE: u32 = 7u;
+
+// The head's field at `p`, the workgroup together: the outward normal (the
+// gradient by central differences, as `Head::gradient`) and the distance.
+// Every lane gets the same, so the comb stays in step.
+fn field(p: vec3<f32>, lane: u32) -> vec4<f32> {
+    workgroupBarrier();
+    if (lane < 7u) {
+        let e = 2e-4;
+        var o = vec3<f32>(0.0);
+        switch lane {
+            case 0u: { o.x = e; }
+            case 1u: { o.x = -e; }
+            case 2u: { o.y = e; }
+            case 3u: { o.y = -e; }
+            case 4u: { o.z = e; }
+            case 5u: { o.z = -e; }
+            default: {}
+        }
+        probes[lane] = head_distance(p + o);
+    }
+    let s = workgroupUniformLoad(&probes);
+    let g = vec3<f32>(s[0] - s[1], s[2] - s[3], s[4] - s[5]);
+    return vec4<f32>(safe_normalize(g, vec3<f32>(0.0, 1.0, 0.0)), s[6]);
+}
+
+// What a strand is combed by, for the helpers below.
+struct Comb {
+    root: vec3<f32>,
+    flow: u32,
+    falls: f32,
+    frontness: f32,
+    elevation: f32,
+    layer: f32,
+    rise: f32,
+    floor: f32,
+    fringe_gap: f32,
+};
+
+// Skin below the hairline that faces forward, near enough to lie on: `f`
+// is the field at `p`.
+fn over_face(p: vec3<f32>, f: vec4<f32>) -> bool {
+    return above_hairline(p) < 0.0 && f.w < 0.03 && f.z > 0.35;
+}
+
+fn layer_height(c: Comb, p: vec3<f32>, s: f32, f: vec4<f32>) -> f32 {
+    let own = c.layer * smoothstep1(0.0, c.rise, s) + c.floor;
+    if (over_face(p, f)) {
+        return min(own, c.fringe_gap);
+    }
+    return own;
+}
+
+fn down_at(c: Comb, p: vec3<f32>) -> vec3<f32> {
+    let outward = safe_normalize(p - cranium_center(), vec3<f32>(0.0, 1.0, 0.0));
+    if (p.z > 0.0) {
+        let side = select(-1.0, 1.0, c.root.x >= 0.0);
+        return vec3<f32>(side, -0.2, -0.6);
+    }
+    return vec3<f32>(outward.x, -0.6, outward.z - 0.3);
+}
+
+fn flow_at(c: Comb, p: vec3<f32>, f: vec4<f32>) -> vec3<f32> {
+    let down = vec3<f32>(0.0, -1.0, 0.0);
+    let fall = safe_normalize(down_at(c, p), down) * c.falls;
+    switch c.flow {
+        case NATURAL: {
+            return safe_normalize(growth_direction(p, f.xyz), down) * (1.0 - c.falls) + fall;
+        }
+        case PART: {
+            let side = select(-1.0, 1.0, c.root.x - hairdo.flow_value >= 0.0);
+            return vec3<f32>(side * (0.8 + 0.6 * c.frontness), -0.1, -0.35 * (1.0 - c.frontness));
+        }
+        case SWEPT: {
+            var side = hairdo.flow_value;
+            if ((c.root.x - hairdo.part) * side < 0.0) {
+                side = -side;
+            }
+            return vec3<f32>(side, -0.05, 0.1 * (1.0 - c.elevation));
+        }
+        case BACK: {
+            return vec3<f32>(0.0, -0.05, -1.0);
+        }
+        case FORWARD: {
+            return safe_normalize(vec3<f32>(0.0, -0.3, 1.0), down) * (1.0 - c.falls) + fall;
+        }
+        case RADIAL: {
+            return safe_normalize(p - cranium_center(), vec3<f32>(0.0, 1.0, 0.0));
+        }
+        case DOWN: {
+            return down_at(c, p);
+        }
+        default: {
+            if (hairdo.tied != 0u) {
+                return tie_point() - p;
+            }
+            return down;
+        }
+    }
+}
+
+// Bend `d` towards `force` as a cantilever with `remaining` metres still to
+// hang off it.
+fn cantilever(d: vec3<f32>, force: vec3<f32>, remaining: f32, stiffness: f32, ds: f32) -> vec3<f32> {
+    let axis = cross(d, force);
+    let s = length(axis);
+    if (s < 1e-6) {
+        return d;
+    }
+    let angle = atan2(s, dot(d, force));
+    let r = max(remaining, 0.0);
+    let curvature = r * r / (2.0 * stiffness * stiffness * stiffness) * s;
+    return rotate(d, axis / s, min(curvature * ds, angle));
+}
+
+// The braid's lane of a root: `Parting::Lanes`' group.
+fn lane_of(root: vec3<f32>) -> f32 {
+    if (hairdo.lanes == 0u) {
+        return 0.0;
+    }
+    let a = atan2(root.x, root.z + 0.02);
+    let t = (a + PI) / TAU;
+    return f32(clamp(i32(t * f32(hairdo.lanes)), 0, i32(hairdo.lanes) - 1));
+}
+
+@compute @workgroup_size(8)
+fn main(@builtin(workgroup_id) wid: vec3<u32>, @builtin(local_invocation_index) lane: u32) {
+    let g = wid.x;
+    if (g >= hairdo.guides) {
+        return;
+    }
+    let root = root_position[g].xyz;
+    let normal = root_normal[g].xyz;
+    stream_key = hash2(hairdo.key ^ 0x0C0Bu, g);
+    stream_counter = 0u;
+    let elev = elevation(root);
+    let az = azimuth(root);
+    let frontness = smoothstep1(0.3, 0.95, cos(az)) * pow(1.0 - elev, 0.5);
+
+    // The follicle: which way it points and at what angle.
+    let spread = hairdo.direction_spread * clamp(gaussian(), -2.5, 2.5);
+    let grows = rotate(growth_direction(root, normal), normal, spread);
+    let follicle_angle = hairdo.angle + hairdo.angle_spread * clamp(gaussian(), -2.5, 2.5);
+
+    var flow = hairdo.flow;
+    var stiffness = hairdo.hold;
+    var angle = follicle_angle + hairdo.lift;
+    var strand_length = cut_length(root);
+    var tuck = hairdo.tuck;
+    let fringed = fringe_holds(root) && hairdo.fringe_falls != 0u;
+    if (fringed) {
+        flow = FORWARD;
+        stiffness = 0.06;
+        tuck = 0.0;
+    } else if (cut_clipped(root)) {
+        flow = NATURAL;
+        angle = follicle_angle;
+        stiffness = 1.0;
+        tuck = 0.0;
+    }
+    angle = clamp(angle, 0.05, 1.5);
+    strand_length *= 1.0 + hairdo.variation * 0.12 * clamp(gaussian(), -2.0, 2.0);
+    let wx = gaussian();
+    let wy = gaussian() * 0.3;
+    let wz = gaussian();
+    let wander = vec3<f32>(wx, wy, wz) * (0.12 * hairdo.variation);
+
+    var c: Comb;
+    c.root = root;
+    c.flow = flow;
+    c.frontness = frontness;
+    c.elevation = elev;
+    c.layer = select(hairdo.volume * pow(elev, 0.7), 0.0, flow == RADIAL);
+    c.floor = 0.0008;
+    c.rise = max(c.layer / max(tan(angle), 0.05), 0.01);
+    c.fringe_gap = 0.005 + 0.004 * next_f32();
+    c.falls = 0.0;
+    if (!fringed && (flow == NATURAL || flow == FORWARD)) {
+        c.falls = 0.85 * smoothstep1(0.12, 0.3, strand_length);
+    }
+
+    let at_root = field(root, lane);
+    let first = rotate(
+        safe_normalize(in_plane(flow_at(c, root, at_root) + wander, normal), grows),
+        normal,
+        spread,
+    );
+    let leaving = first * cos(angle) + normal * sin(angle);
+    var p = root;
+    var d = safe_normalize(leaving, normal);
+    if (hairdo.dome > 0.0) {
+        let centre = cranium_center() + vec3<f32>(0.0, 0.04, 0.012);
+        let o = root - centre;
+        let b = dot(d, o);
+        let cc = dot(o, o) - hairdo.dome * hairdo.dome;
+        let reach = -b + sqrt(max(b * b - cc, 0.0));
+        strand_length = max(reach, 0.02) * (1.2 + 0.1 * clamp(gaussian(), -2.0, 2.0));
+    }
+    let ds = clamp(strand_length / 300.0, 0.0004, 0.002);
+    let steps = min(u32(ceil(strand_length / ds)), hairdo.max_path - 1u);
+    var tied_at = -1.0;
+    let bx = gaussian();
+    let by = gaussian();
+    let bundle = vec3<f32>(bx, by, 0.0) * 0.004;
+    let lane_in_braid = lane_of(root);
+    let tie = hairdo.tied != 0u;
+    var to_tie = 0.0;
+    if (tie) {
+        to_tie = distance(tie_point(), root);
+    }
+    let down = vec3<f32>(0.0, -1.0, 0.0);
+
+    let base = g * hairdo.max_path;
+    if (lane == 0u) {
+        path[base] = vec4<f32>(root, 0.0);
+    }
+    var n = 1u;
+    for (var k = 1u; k <= steps; k++) {
+        let s = f32(k) * ds;
+        let remaining = strand_length - s;
+
+        // Past the tie: the tail, the coil or the braid.
+        if (tie && tied_at >= 0.0) {
+            p = bundled(s - tied_at, bundle, lane_in_braid, az);
+            if (lane == 0u) {
+                path[base + n] = vec4<f32>(p, 0.0);
+            }
+            n += 1u;
+            if (is_cut(root, p)) {
+                break;
+            }
+            continue;
+        }
+
+        let here = field(p, lane);
+        let nrm = here.xyz;
+        let gap = here.w - layer_height(c, p, s, here);
+        // Hair over the forehead rests on it, however high it came from.
+        let on_face = over_face(p, here);
+        let resting = on_face && gap < 0.03;
+        let supported = (gap < hairdo.cling || resting) && nrm.y > -0.3 && flow != RADIAL;
+
+        if (flow == TIE && tie) {
+            if (distance(tie_point(), p) < 0.02 || s > 1.6 * to_tie + 0.03) {
+                tied_at = s;
+                continue;
+            }
+            // Over the scalp to the tie, held there.
+            let want = safe_normalize(in_plane(tie_point() - p, nrm), d);
+            d = safe_normalize(lerp3(d, want, min(ds / 0.01, 1.0)), want);
+        } else if (supported) {
+            // Lying on the hair beneath: the comb, and gravity down the
+            // slope as the hair still to come weighs.
+            var comb_to = flow_at(c, p, here) + wander;
+            if (on_face && fringed) {
+                comb_to = down;
+            }
+            let combed = safe_normalize(in_plane(comb_to, nrm), d);
+            let downhill = in_plane(down, nrm);
+            var slide = smoothstep1(0.0, 4.0 * stiffness, remaining);
+            if (!fringed) {
+                let ahead = p + safe_normalize(downhill, d) * 0.02;
+                // Only below the hairline is there a face to slide onto.
+                if (above_hairline(ahead) < 0.0 && over_face(ahead, field(ahead, lane))) {
+                    slide *= 0.05;
+                }
+            }
+            var want = safe_normalize(combed * (1.0 - slide) + downhill * slide, combed);
+            // Rising to its layer near the root, the strand keeps its angle.
+            let rising = 1.0 - smoothstep1(0.0, c.rise, s);
+            want = safe_normalize(want * (1.0 - rising) + leaving * rising, want);
+            d = safe_normalize(lerp3(d, want, min(ds / 0.012, 1.0)), want);
+        } else {
+            // Free: a cantilever under its own weight.
+            d = cantilever(d, down, remaining, stiffness, ds);
+        }
+        // Coily hair wanders: a random turn a step.
+        if (hairdo.kink > 0.0) {
+            let k0 = gaussian();
+            let k1 = gaussian();
+            let k2 = gaussian();
+            let axis = safe_normalize(cross(d, vec3<f32>(k0, k1, k2)), orthogonal(d));
+            d = rotate(d, axis, gaussian() * hairdo.kink * sqrt(ds));
+            let outward = safe_normalize(p - cranium_center(), d);
+            d = safe_normalize(d + outward * 0.05, d);
+        }
+        // The last few centimetres of a tucked cut turn in towards the neck.
+        if (tuck > 0.0 && remaining < 0.05) {
+            let neck = vec3<f32>(0.0, p.y, head_shape[10].z);
+            let inward = safe_normalize(in_plane(neck - p, d), d);
+            d = safe_normalize(d + inward * (tuck * ds / 0.05), d);
+        }
+
+        var next = p + d * ds;
+        let there = field(next, lane);
+        let floor_here = layer_height(c, next, s + ds, there);
+        if (there.w < floor_here) {
+            next += there.xyz * (floor_here - there.w);
+            next = p + safe_normalize(next - p, d) * ds;
+        } else if (supported && there.w > floor_here) {
+            // Lying on the layer below: settle onto it where it drops away.
+            next -= there.xyz * ((there.w - floor_here) * 0.15);
+            next = p + safe_normalize(next - p, d) * ds;
+        }
+        d = safe_normalize(next - p, d);
+        p = next;
+        if (lane == 0u) {
+            path[base + n] = vec4<f32>(p, 0.0);
+        }
+        n += 1u;
+        if (is_cut(root, p)) {
+            break;
+        }
+    }
+    if (lane != 0u) {
+        return;
+    }
+
+    // Resampled evenly by arc length, as `resample_into`.
+    if (n < 2u) {
+        path[base + 1u] = path[base];
+        n = 2u;
+    }
+    var total = 0.0;
+    for (var j = 1u; j < n; j++) {
+        total += distance(path[base + j].xyz, path[base + j - 1u].xyz);
+        path[base + j].w = total;
+    }
+    let points = hairdo.points;
+    let out = g * points;
+    var segment = 0u;
+    for (var j = 0u; j < points; j++) {
+        let target_length = total * f32(j) / f32(max(points - 1u, 1u));
+        while (segment + 2u < n && path[base + segment + 1u].w < target_length) {
+            segment += 1u;
+        }
+        let a = path[base + segment];
+        let b = path[base + segment + 1u];
+        let span = b.w - a.w;
+        var t = 0.0;
+        if (span > 1e-12) {
+            t = clamp((target_length - a.w) / span, 0.0, 1.0);
+        }
+        positions[out + j] = vec4<f32>(lerp3(a.xyz, b.xyz, t), 0.0);
+    }
+}
+"#,
+    )
+}
+
+/// Each guide's attributes, as the host's guides have them: its root's
+/// normal and UV, a stable ID, its parting group, the follicles' radius.
+pub fn guide_attributes() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+@group(0) @binding(0) var<storage, read> root_position: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> root_normal: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> root_uv: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> strands: array<StrandGpu>;
+@group(0) @binding(4) var<storage, read_write> roots: array<vec4<f32>>;
+struct Params {{
+    count: u32,
+    lanes: u32,
+    parting: u32,
+    pad0: u32,
+    plane_x: f32,
+    plane_y: f32,
+    plane_z: f32,
+    plane_offset: f32,
+    until: f32,
+    fringe_front: f32,
+    fringe_half_width: f32,
+    radius: f32,
+}};
+@group(0) @binding(5) var<uniform> params: Params;
+"#
+        ),
+        &[RANDOM, MATH, PARTING],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let g = item(id, groups);
+    if (g >= params.count) {
+        return;
+    }
+    let root = root_position[g].xyz;
+    roots[g] = vec4<f32>(root, 0.0);
+    strands[g] = StrandGpu(
+        root_normal[g].xyz,
+        hash2(g, 0x006D1DE5u),
+        root_uv[g].xy,
+        parting_group(root),
+        params.radius,
+    );
+}
+"#,
+    )
+}
+
+/// The guides as interpolation reads them: each point with its arc length,
+/// and each guide's root normal and parting group.
+pub fn guide_pack() -> String {
+    kernel(
+        &format!(
+            r#"
+{STRAND}
+@group(0) @binding(0) var<storage, read> positions: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> strands: array<StrandGpu>;
+@group(0) @binding(2) var<storage, read_write> guide_points: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> guide_info: array<vec4<f32>>;
+struct Params {{
+    count: u32,
+    points: u32,
+    lanes: u32,
+    parting: u32,
+    plane_x: f32,
+    plane_y: f32,
+    plane_z: f32,
+    plane_offset: f32,
+    until: f32,
+    fringe_front: f32,
+    fringe_half_width: f32,
+    pad0: u32,
+}};
+@group(0) @binding(4) var<uniform> params: Params;
+"#
+        ),
+        &[MATH, PARTING],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let g = item(id, groups);
+    if (g >= params.count) {
+        return;
+    }
+    let base = g * params.points;
+    var along = 0.0;
+    var previous = positions[base].xyz;
+    for (var j = 0u; j < params.points; j++) {
+        let p = positions[base + j].xyz;
+        along += distance(p, previous);
+        previous = p;
+        guide_points[base + j] = vec4<f32>(p, along);
+    }
+    let n = strands[g].normal;
+    guide_info[g] = vec4<f32>(n, f32(parting_group(positions[base].xyz)));
+}
+"#,
+    )
+}
+
+/// How far each scalp vertex is from the scalp's open edge, up to `edge`
+/// (1 everywhere when there is no edge), beside its UV.
+pub fn edge_distances() -> String {
+    kernel(
+        r#"
+@group(0) @binding(0) var<storage, read> scalp_points: array<vec4<f32>>;
+@group(0) @binding(1) var<storage, read> scalp_uvs: array<vec4<f32>>;
+@group(0) @binding(2) var<storage, read> boundary: array<vec4<f32>>;
+@group(0) @binding(3) var<storage, read_write> extra: array<vec4<f32>>;
+struct Params {
+    count: u32,
+    boundary_count: u32,
+    edge: f32,
+    pad0: u32,
+};
+@group(0) @binding(4) var<uniform> params: Params;
+"#,
+        &[],
+        r#"
+@compute @workgroup_size(64)
+fn main(@builtin(global_invocation_id) id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {
+    let v = item(id, groups);
+    if (v >= params.count) {
+        return;
+    }
+    var e = 1.0;
+    if (params.edge > 0.0) {
+        let p = scalp_points[v].xyz;
+        e = params.edge;
+        for (var b = 0u; b < params.boundary_count; b++) {
+            e = min(e, distance(p, boundary[b].xyz));
+        }
+    }
+    extra[v] = vec4<f32>(scalp_uvs[v].xy, e, 0.0);
+}
+"#,
+    )
+}
