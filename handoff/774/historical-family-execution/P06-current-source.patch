+    }
+
+    /// Contiguous rig-order values at a native numerical or serialization port.
+    pub fn as_native_slice(&self) -> &[T] {
+        &self.0
+    }
+
+    pub fn joint_count(&self) -> RigJointCount {
+        RigJointCount::from_table(self)
+    }
+
     pub fn push(&mut self, value: T) {
         self.0.push(value);
     }
