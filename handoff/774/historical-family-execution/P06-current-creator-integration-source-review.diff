+++ after/crates/adventuresim-character-creator/src/hair_preview.rs
@@ -0,0 +1,343 @@
+//! The hair on the previewed character.
+//!
+//! A worker thread grows a hairstyle on the hair crate's bust (once per
+//! style) and places it on the generated body (once per body): the strands
+//! are carried onto the character's head and every level of detail is
+//! prepared there, kept outside the character's own skin. The studio then
+//! draws the level the Hair page picks, skinned wholly to the head joint so
+//! it follows the walk preview, and paints the scalp under it.
+use super::*;
+use adventuresim_character_creator::hair::{
+    BodySurface, Groom, GroomedHair, HairDesign, HairGpu, HeadPlacement, HeadSkin, PlacedHair,
+    variant_label,
+};
+use bevy::camera::visibility::NoFrustumCulling;
+use fabelgeist_hair::lod::Form;
+use fabelgeist_rig::RigJointName;
+use std::sync::Arc;
+use std::thread::JoinHandle;
+
+mod assets;
+mod gpu;
+mod layers;
+#[cfg(test)]
+mod render_test;
+mod scalp_shade;
+mod scalp_upload;
+mod strand_shading;
+
+use assets::HairAssets;
+pub(super) use gpu::HairGpuPlugin;
+use layers::HairLayer;
+pub(super) use layers::{ShownLayers, show as show_layers};
+pub(super) use strand_shading::HairShadingPlugin;
+
+/// The hair mesh shown on the character: the design and the form it draws.
+#[derive(Component)]
+pub(super) struct HairMesh {
+    design: HairDesign,
+    form: Form,
+}
+
+/// The grown and placed hair, and the worker preparing the next.
+#[derive(Resource, Default)]
+pub(super) struct HairPreview {
+    grown: Option<Arc<GroomedHair>>,
+    placed: Option<PlacedStyle>,
+    worker: Option<Worker>,
+    /// The studio's render device, for growing hair on; there once the
+    /// renderer has started.
+    gpu: Option<gpu::StudioHairGpu>,
+}
+
+/// Hair placed on one generated body.
+pub(super) struct PlacedStyle {
+    pub(super) hair: PlacedHair,
+    /// The device the hair lies on, where its levels of detail are built.
+    pub(super) gpu: gpu::StudioHairGpu,
+    body: Arc<GeneratedCharacter>,
+    atlas: Handle<Image>,
+    /// The scalp's baked textures.
+    scalp: scalp_shade::ScalpImages,
+}
+
+struct Worker {
+    groom: Groom,
+    body: Arc<GeneratedCharacter>,
+    handle: JoinHandle<Result<Prepared>>,
+}
+
+/// What a worker hands back.
+struct Prepared {
+    grown: Arc<GroomedHair>,
+    placed: PlacedHair,
+    gpu: gpu::StudioHairGpu,
+}
+
+/// A body's copy of what placing hair on it reads, for the worker to own.
+pub(super) struct BodyHead {
+    positions: Vec<[f32; 3]>,
+    faces: Vec<[u32; 3]>,
+    joint_indices: fabelgeist_rig::PackedRigSkin<8>,
+    joint_weights: Vec<[f32; 8]>,
+    joint_names: fabelgeist_rig::RigJointTable<RigJointName>,
+    global_joint_states: fabelgeist_rig::RigJointTable<[f32; 8]>,
+}
+
+impl BodyHead {
+    pub(super) fn new(model: &BodyModel, generated: &GeneratedCharacter) -> Self {
+        let character = &model.mhr.character;
+        Self {
+            positions: generated.positions.clone(),
+            faces: character.mesh.faces.clone(),
+            joint_indices: character.skin_weights.index.clone(),
+            joint_weights: character.skin_weights.weight.clone(),
+            joint_names: character.skeleton.names.clone(),
+            global_joint_states: generated.global_joint_states.clone(),
+        }
+    }
+
+    /// Where the bust's head lies on this body.
+    pub(super) fn placement(&self, hair: &GroomedHair) -> Result<HeadPlacement> {
+        let skin = HeadSkin {
+            positions: &self.positions,
+            joint_indices: &self.joint_indices,
+            joint_weights: &self.joint_weights,
+            joint_names: &self.joint_names,
+            global_joint_states: &self.global_joint_states,
+        };
+        Ok(HeadPlacement::fit(&skin, hair.head())?)
+    }
+
+    /// `hair` placed on this body on `gpu`, kept outside its skin.
+    pub(super) fn place(&self, gpu: &HairGpu, hair: &GroomedHair) -> Result<PlacedHair> {
+        let placement = self.placement(hair)?;
+        let body = BodySurface {
+            positions: &self.positions,
+            faces: &self.faces,
+        };
+        hair.place(gpu, &placement, &body)
+    }
+}
+
+impl HairPreview {
+    /// The placed hair, if it is `groom` on `body`.
+    fn placed(&self, groom: Groom, body: &Arc<GeneratedCharacter>) -> Option<&PlacedStyle> {
+        self.placed
+            .as_ref()
+            .filter(|placed| placed.hair.groom == groom && Arc::ptr_eq(&placed.body, body))
+    }
+
+    /// Start preparing `groom` on `body` unless that is placed or under way
+    /// already; true when a worker started. A worker on another style or
+    /// body is left to finish and its hair dropped.
+    fn request(&mut self, groom: Groom, body: &Arc<GeneratedCharacter>, head: BodyHead) -> bool {
+        let under_way = self
+            .worker
+            .as_ref()
+            .is_some_and(|worker| worker.groom == groom && Arc::ptr_eq(&worker.body, body));
+        if self.placed(groom, body).is_some() || under_way {
+            return false;
+        }
+        let grown = self.grown.clone().filter(|grown| grown.groom == groom);
+        let gpu = self.gpu.clone();
+        let handle = std::thread::spawn(move || {
+            let gpu = gpu.context("the renderer has no device to grow hair on")?;
+            let kernels = gpu.kernels()?;
+            let grown = match grown {
+                Some(grown) => grown,
+                None => Arc::new(GroomedHair::grow(groom, kernels)?),
+            };
+            let placed = head.place(kernels, &grown)?;
+            Ok(Prepared { grown, placed, gpu })
+        });
+        self.worker = Some(Worker {
+            groom,
+            body: body.clone(),
+            handle,
+        });
+        true
+    }
+
+    /// Take the worker's hair once it has finished.
+    fn collect(
+        &mut self,
+        images: &mut Assets<Image>,
+        uploads: &scalp_upload::ScalpUploads,
+    ) -> Result<()> {
+        if !self
+            .worker
+            .as_ref()
+            .is_some_and(|worker| worker.handle.is_finished())
+        {
+            return Ok(());
+        }
+        let Some(worker) = self.worker.take() else {
+            return Ok(());
+        };
+        let prepared = worker
+            .handle
+            .join()
+            .map_err(|_| anyhow::anyhow!("the hair worker panicked"))??;
+        let atlas = images.add(assets::atlas_image(&prepared.placed));
+        let scalp = assets::scalp_images(&prepared.placed, images, uploads);
+        self.grown = Some(prepared.grown);
+        self.placed = Some(PlacedStyle {
+            hair: prepared.placed,
+            gpu: prepared.gpu,
+            body: worker.body,
+            atlas,
+            scalp,
+        });
+        Ok(())
+    }
+}
+
+/// A level of detail the Hair page offers, and its name there.
+pub(super) struct FormChoice {
+    pub(super) form: Form,
+    pub(super) label: String,
+}
+
+impl HairPreview {
+    /// The levels of detail of the placed hair, finest first; none until
+    /// it is placed.
+    pub(super) fn form_choices(&self) -> Vec<FormChoice> {
+        let Some(placed) = &self.placed else {
+            return Vec::new();
+        };
+        let hair = &placed.hair;
+        hair.forms()
+            .into_iter()
+            .map(|form| FormChoice {
+                form,
+                label: match form {
+                    Form::Strands { level, .. } => {
+                        format!("Strands, {} points each", hair.strand_points(level))
+                    }
+                    Form::Cards { level } => format!("Cards, {} strips", hair.card_count(level)),
+                },
+            })
+            .collect()
+    }
+
+    /// How many strands `form` draws of the placed hair's, and of how many.
+    pub(super) fn strands_drawn(&self, form: Form) -> Option<StrandsDrawn> {
+        let hair = &self.placed.as_ref()?.hair;
+        Some(StrandsDrawn {
+            drawn: hair.strands_drawn(form),
+            all: hair.strand_count(),
+        })
+    }
+
+    /// Whether hair is still being grown or placed.
+    pub(super) fn preparing(&self) -> bool {
+        self.worker.is_some()
+    }
+}
+
+/// Strands drawn out of a groom's.
+pub(super) struct StrandsDrawn {
+    pub(super) drawn: usize,
+    pub(super) all: usize,
+}
+
+/// Keep the shown hair in step with the recipe and the Hair page: grow and
+/// place a new style, place it again on every body the studio regenerates
+/// (which despawns it with the rest of the character), and redraw it when
+/// its colour or level of detail changes.
+#[expect(
+    clippy::too_many_arguments,
+    reason = "Bevy injects the studio, body caches, the shown meshes and their assets"
+)]
+pub(super) fn refresh(
+    mut commands: Commands,
+    mut preview: ResMut<HairPreview>,
+    mut studio: ResMut<Studio>,
+    mut cache: ResMut<studio_cache::StudioCache>,
+    model: Res<BodyModel>,
+    walk: Res<WalkPreview>,
+    shown: Query<(Entity, &HairMesh)>,
+    mut assets: HairAssets,
+    mut contexts: EguiContexts,
+) {
+    let uploads = assets.uploads.clone();
+    if let Err(error) = preview.collect(&mut assets.images, &uploads) {
+        studio.status = format!("Hair could not be placed: {error:#}");
+    }
+    let wanted = studio.recipe.hair.map(|design| (design, studio.hair_form));
+    for (entity, mesh) in &shown {
+        if Some((mesh.design, mesh.form)) != wanted {
+            commands.entity(entity).despawn();
+        }
+    }
+    let Some((design, form)) = wanted else {
+        return;
+    };
+    // A level of detail is drawn once its slider is let go.
+    if studio.dirty || walk.joints.is_empty() || studio_generation::dragging(&mut contexts) {
+        return;
+    }
+    let recipe = studio.recipe.clone();
+    let body = match cache.body(&model, &recipe) {
+        Ok(body) => body,
+        Err(error) => {
+            studio.status = format!("{error:#}");
+            return;
+        }
+    };
+    let Some(placed) = preview.placed(design.groom(), &body) else {
+        if preview.request(design.groom(), &body, BodyHead::new(&model, &body)) {
+            studio.status = format!(
+                "Growing {} hair",
+                variant_label(design.preset).to_lowercase()
+            );
+        }
+        return;
+    };
+    if shown
+        .iter()
+        .any(|(_, mesh)| (mesh.design, mesh.form) == (design, form))
+    {
+        return;
+    }
+    let Some(skin) = animation_preview::skin(&walk) else {
+        return;
+    };
+    let drawn = assets.hair(placed, design, form).and_then(|hair| {
+        let cap = assets.scalp_cap(placed, design)?;
+        Ok((hair, cap))
+    });
+    let (hair, (cap, cap_material)) = match drawn {
+        Ok(drawn) => drawn,
+        Err(error) => {
+            studio.status = format!("Hair could not be drawn: {error:#}");
+            return;
+        }
+    };
+    let shown = studio.hair_layers;
+    if let Some((mesh, material)) = hair {
+        // Its mesh holds no positions to bound it by: they lie on the GPU.
+        commands.spawn((
+            CharacterMesh,
+            HairMesh { design, form },
+            HairLayer::Hair,
+            shown.visibility(HairLayer::Hair),
+            Name::new("Hair"),
+            skin.clone(),
+            Mesh3d(mesh),
+            MeshMaterial3d(material),
+            NoFrustumCulling,
+        ));
+    }
+    commands.spawn((
+        CharacterMesh,
+        HairMesh { design, form },
+        HairLayer::Scalp,
+        shown.visibility(HairLayer::Scalp),
+        Name::new("Scalp"),
+        skin,
+        Mesh3d(cap),
+        MeshMaterial3d(cap_material),
+    ));
+}
--- before/crates/adventuresim-character-creator/src/hair_preview/assets.rs
+++ after/crates/adventuresim-character-creator/src/hair_preview/assets.rs
@@ -0,0 +1,225 @@
+//! Meshes, materials and the card atlas the previewed hair is drawn with.
+use super::scalp_shade::{ScalpImages, ScalpShading};
+use super::scalp_upload::ScalpUploads;
+use super::strand_shading::{HairShading, StrandShading};
+use super::*;
+use adventuresim_character_creator::hair::{AtlasLevel, GpuGeometry, HAIR_ROUGHNESS, ScalpCap};
+use bevy::{
+    asset::RenderAssetUsages,
+    image::{ImageAddressMode, ImageFilterMode, ImageSampler, ImageSamplerDescriptor},
+    mesh::{Indices, VertexAttributeValues},
+    render::render_resource::{Extent3d, TextureDimension, TextureFormat},
+};
+
+/// How far hair's highlights lean from white towards its pigment's hue.
+const HIGHLIGHT_HUE: f32 = 0.4;
+/// Coverage under which a card casts no shadow and writes no depth.
+const SHADOW_COVERAGE: f32 = 0.5;
+
+/// The assets hair is made of.
+#[derive(bevy::ecs::system::SystemParam)]
+pub(crate) struct HairAssets<'w> {
+    pub(super) meshes: ResMut<'w, Assets<Mesh>>,
+    hair_materials: ResMut<'w, Assets<HairShading>>,
+    scalp_materials: ResMut<'w, Assets<ScalpShading>>,
+    pub(super) images: ResMut<'w, Assets<Image>>,
+    pub(super) uploads: Res<'w, ScalpUploads>,
+}
+
+impl HairAssets<'_> {
+    /// `form` of the placed hair, built on the GPU and drawn from there:
+    /// its mesh, skinned wholly to the head joint, and its material. None
+    /// for a form the hair has not.
+    pub(super) fn hair(
+        &mut self,
+        placed: &PlacedStyle,
+        design: HairDesign,
+        form: Form,
+    ) -> Result<Option<(Handle<Mesh>, Handle<HairShading>)>> {
+        let Some(geometry) = placed.hair.gpu_geometry(placed.gpu.kernels()?, form)? else {
+            return Ok(None);
+        };
+        let mesh = mesh(&geometry, placed.hair.placement().head_joint)?;
+        let material = material(design, form, placed.atlas.clone(), &geometry);
+        Ok(Some((
+            self.meshes.add(mesh),
+            self.hair_materials.add(material),
+        )))
+    }
+
+    /// The scalp cap under `placed`, skinned wholly to the head joint and
+    /// shaded as hair of `design`, blended over the skin.
+    pub(super) fn scalp_cap(
+        &mut self,
+        placed: &PlacedStyle,
+        design: HairDesign,
+    ) -> Result<(Handle<Mesh>, Handle<ScalpShading>)> {
+        let hair = &placed.hair;
+        let mesh = cap_mesh(hair.cap(), hair.placement().head_joint)?;
+        Ok((
+            self.meshes.add(mesh),
+            self.scalp_materials
+                .add(scalp_shade::material(design, &placed.scalp)),
+        ))
+    }
+}
+
+/// The material `form` of hair of `design` is drawn with, shaded as strands
+/// ([`HairShading`]). A card is cut out of `atlas`: its coverage becomes a
+/// share of each pixel's samples, hashed per card as the hair crate's
+/// renderer does, while shadows and depth cut it at half. A ribbon is one
+/// strand, solid. Hair's highlights lean towards its pigment's hue: light
+/// reflected inside a strand is coloured by it, and white highlights over
+/// dark pigment read as grey hair. Its vertices are drawn from `geometry`,
+/// where they were built.
+pub(super) fn material(
+    design: HairDesign,
+    form: Form,
+    atlas: Handle<Image>,
+    geometry: &GpuGeometry,
+) -> HairShading {
+    let cards = matches!(form, Form::Cards { .. });
+    HairShading {
+        base: StandardMaterial {
+            base_color_texture: cards.then_some(atlas),
+            alpha_mode: AlphaMode::Mask(SHADOW_COVERAGE),
+            double_sided: true,
+            cull_mode: None,
+            ..hair_surface(design)
+        },
+        extension: StrandShading::new(geometry),
+    }
+}
+
+/// The surface of hair of `design`, wherever it is drawn: its colour, a
+/// rough dielectric's sheen, and highlights leaning towards its hue.
+pub(super) fn hair_surface(design: HairDesign) -> StandardMaterial {
+    let [red, green, blue] = design.pigment.color();
+    let brightest = red.max(green).max(blue);
+    let tint = |channel: f32| {
+        if brightest == 0.0 {
+            // Black has no hue to tint the dielectric highlight.
+            1.0
+        } else {
+            1.0 + (channel / brightest - 1.0) * HIGHLIGHT_HUE
+        }
+    };
+    StandardMaterial {
+        base_color: Color::linear_rgb(red, green, blue),
+        specular_tint: Color::linear_rgb(tint(red), tint(green), tint(blue)),
+        perceptual_roughness: HAIR_ROUGHNESS,
+        metallic: 0.0,
+        ..default()
+    }
+}
+
+/// The mesh `geometry` is drawn with, skinned wholly to `head_joint`: its
+/// triangles, and every vertex's skin. Its vertices are drawn from where
+/// they were built, so its positions only count them.
+pub(super) fn mesh(
+    geometry: &GpuGeometry,
+    head_joint: fabelgeist_rig::RigJointOrdinal,
+) -> Result<Mesh> {
+    let count = geometry.vertices();
+    let head = u16::try_from(usize::from(head_joint))
+        .context("the head joint index exceeds a skin index")?;
+    Ok(Mesh::new(
+        PrimitiveTopology::TriangleList,
+        RenderAssetUsages::RENDER_WORLD,
+    )
+    .with_inserted_attribute(Mesh::ATTRIBUTE_POSITION, vec![[0.0f32; 3]; count])
+    .with_inserted_attribute(
+        Mesh::ATTRIBUTE_JOINT_INDEX,
+        VertexAttributeValues::Uint16x4(vec![[head, 0, 0, 0]; count]),
+    )
+    .with_inserted_attribute(
+        Mesh::ATTRIBUTE_JOINT_WEIGHT,
+        vec![[1.0f32, 0.0, 0.0, 0.0]; count],
+    )
+    .with_inserted_indices(Indices::U32(geometry.faces().into_flattened())))
+}
+
+/// The scalp `cap` as a mesh skinned wholly to `head_joint`, with its
+/// tangents along the texture and how much it shows as vertex alpha.
+pub(super) fn cap_mesh(
+    cap: &ScalpCap,
+    head_joint: fabelgeist_rig::RigJointOrdinal,
+) -> Result<Mesh> {
+    let count = cap.positions.len();
+    let head = u16::try_from(usize::from(head_joint))
+        .context("the head joint index exceeds a skin index")?;
+    Ok(Mesh::new(
+        PrimitiveTopology::TriangleList,
+        RenderAssetUsages::default(),
+    )
+    .with_inserted_attribute(Mesh::ATTRIBUTE_POSITION, cap.positions.clone())
+    .with_inserted_attribute(Mesh::ATTRIBUTE_NORMAL, cap.normals.clone())
+    .with_inserted_attribute(Mesh::ATTRIBUTE_UV_0, cap.texcoords.clone())
+    .with_inserted_attribute(Mesh::ATTRIBUTE_TANGENT, cap.tangents.clone())
+    .with_inserted_attribute(Mesh::ATTRIBUTE_COLOR, scalp_shade::colors(&cap.opacity))
+    .with_inserted_attribute(
+        Mesh::ATTRIBUTE_JOINT_INDEX,
+        VertexAttributeValues::Uint16x4(vec![[head, 0, 0, 0]; count]),
+    )
+    .with_inserted_attribute(
+        Mesh::ATTRIBUTE_JOINT_WEIGHT,
+        vec![[1.0f32, 0.0, 0.0, 0.0]; count],
+    )
+    .with_inserted_indices(Indices::U32(cap.faces.as_flattened().to_vec())))
+}
+
+/// The card atlas with its mip chain, shade as grey and coverage as alpha.
+pub(super) fn atlas_image(hair: &PlacedHair) -> Image {
+    mip_image(&hair.atlas_levels())
+}
+
+/// The scalp's baked textures, copied into images on the GPU.
+pub(super) fn scalp_images(
+    hair: &PlacedHair,
+    images: &mut Assets<Image>,
+    uploads: &ScalpUploads,
+) -> ScalpImages {
+    let texture = hair.scalp_texture();
+    ScalpImages {
+        shade: uploads.image(texture.shade(), images),
+        strands: uploads.image(texture.strands(), images),
+    }
+}
+
+/// An image of `levels`, a mip chain largest first, filtered linearly.
+fn mip_image(levels: &[AtlasLevel]) -> Image {
+    let (width, height) = levels
+        .first()
+        .map_or((1, 1), |level| (level.width, level.height));
+    let base = levels
+        .first()
+        .map_or_else(Vec::new, |level| level.rgba.clone());
+    let mut image = Image::new(
+        Extent3d {
+            width,
+            height,
+            depth_or_array_layers: 1,
+        },
+        TextureDimension::D2,
+        base,
+        TextureFormat::Rgba8Unorm,
+        RenderAssetUsages::RENDER_WORLD,
+    );
+    // The whole chain, largest level first, as wgpu uploads mipmaps.
+    image.data = Some(
+        levels
+            .iter()
+            .flat_map(|level| level.rgba.iter().copied())
+            .collect(),
+    );
+    image.texture_descriptor.mip_level_count = levels.len() as u32;
+    image.sampler = ImageSampler::Descriptor(ImageSamplerDescriptor {
+        address_mode_u: ImageAddressMode::ClampToEdge,
+        address_mode_v: ImageAddressMode::ClampToEdge,
+        mag_filter: ImageFilterMode::Linear,
+        min_filter: ImageFilterMode::Linear,
+        mipmap_filter: ImageFilterMode::Linear,
+        ..default()
+    });
+    image
+}
