+        let mut trace = Vec::new();
+        for sample in 0..LIGHTING_READBACK_BUDGET {
+            assert_eq!(lighting_convergence(&trace), LightingConvergence::Pending);
+            trace.push(if sample % 2 == 0 { 40.0 } else { 80.0 });
