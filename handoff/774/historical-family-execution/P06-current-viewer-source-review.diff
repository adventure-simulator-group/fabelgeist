+fn joined_counters(
+    layout: &mut FurnitureLayout,
+    terrain: &SceneTerrain,
+) -> Result<BuildingReviewCamera> {
+    use FurnitureKind::*;
+    let variant = FurnitureVariant::Broad;
+    let size = FurnitureKey::natural(Counter, variant)
+        .interior_spec()?
