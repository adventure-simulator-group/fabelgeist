  "candidates": [
    {
      "id": "REVIEW-AUTORESOLVE-ATTACK-IDENTITY-WIDTH-001",
      "severity": "P3 conditional timeline and report identity collision; actual supported roster collision not established",
      "classification": "Current bounded trace of the existing CROSS-LENS-PACKED-ATTACK-ID-CAPACITY and PL13-134 pending family, not a new unique historical finding.",
      "trace": "ScheduledMeleeTiming::attack_id shifts a u64 attacker ID left 32 bits and XORs a quantized start tick, discarding the upper 32 attacker bits. For symbolic distinct IDs 1 and 4294967297 with the same start tick 0, both values are 4294967296. If those two scheduled attacks also share a contact time in one selected batch, contact_batch collects duplicate member IDs and uses position of the first matching ID for each, yielding order 0 for both. Contact timeline events retain that batch membership and order. The iteration evidence also compares canceled and contacted IDs by equality; a matching ID alone cannot distinguish different attacks. These are conditional source and integer/collection reasoning, not a generated battle.",
      "safeguards_and_limits": "scheduled_attack_is_current compares the individual attacker retained start/contact times directly, rather than this packed ID. No wrong simulation cancellation is asserted. Character storage and selected constructors use u64 and the field-actor producer sets a high bit, but no particular two real roster IDs with equal low 32 bits, equal quantized start, equal contact time or reachable misleading report has been observed. All battle invokers, time-identity policy, native readers and global aliases remain open.",
      "connected_repair": "Reconcile the canonical participant-plus-attack identity and native output across scheduled state, batch order, cancellation and consumers. Preserve optional scheduled measure where the existing supported fixture derives it; do not invent a 32-bit participant restriction or merely wrap the same lossy packing.",
      "acceptance": "A later review must distinguish supported distinct same-tick participants and preserve correct batch membership/order and cancellation matching, while retaining valid simultaneous and optional-measure behavior. Runtime validation remains deferred.",
      "discovery": "partial; supported roster/time reachability, all consumers and aliases open",
      "repair": "not started",
      "validation": "not performed"
    }
