"""Exact archived authority snapshot qualification over the Windows adapter.

No historical/source check is skipped: the two creation-time snapshot references
are verified from an authenticated archive by exact reconstructed byte hashes.
"""
import ast
import hashlib
import importlib.util
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
ROOT = Path('target/726-audit-adler-20261027')
HERE = ROOT / 'adler-continuation-20261030'
BASE = HERE / 'windows_l13_303_310.py'
assert hashlib.sha256(BASE.read_bytes()).hexdigest() == '73d86b671b6dbbaf53eb1f3359eb4a8dcfa90454c457221a395dc2cc2c637ae3'
spec = importlib.util.spec_from_file_location('windows_l13_exact_v1', BASE)
base = importlib.util.module_from_spec(spec)
spec.loader.exec_module(base)
Q = HERE / 'QUALIFICATION-L13-303-310-HISTORICAL-SNAPSHOT-001.json'
assert hashlib.sha256(Q.read_bytes()).hexdigest() == '1896bc00b390d53c80bc4eef9ba0c3e61793da95f1aea66e8e92374e33083203'
q = json.loads(Q.read_text(encoding='utf-8'))
manifest_path = ROOT / q['manifest']['path']
assert hashlib.sha256(manifest_path.read_bytes()).hexdigest() == q['manifest']['sha256']
manifest = json.loads(manifest_path.read_text(encoding='utf-8'))
snapshots = manifest['base_authority_snapshot']
assert snapshots['snapshot_only_not_guard_against_other_lens_progress'] is True
assert snapshots['ledger'] == {'path': (ROOT / 'evidence/continuation-segovb/ledger.json').as_posix(), 'sha256': q['ledger_sha256']}
assert snapshots['selector'] == {'path': (ROOT / 'CURRENT-ADLER.json').as_posix(), 'sha256': q['selector_sha256']}
archive = ROOT / q['archive']['path']
assert hashlib.sha256(archive.read_bytes()).hexdigest() == q['archive']['sha256']
saved = json.loads(archive.read_text(encoding='utf-8'))
for key, refkey in [('ledger', 'ledger'), ('current', 'selector')]:
    body = (json.dumps(saved[key], indent=2) + '\n').encode('utf-8')
    assert hashlib.sha256(body).hexdigest() == snapshots[refkey]['sha256']
assert saved['current']['ledger_sha256'] == q['ledger_sha256']

def exact_snapshot(value):
    return value == snapshots['ledger'] or value == snapshots['selector']

class SnapshotPortable(base.Portable):
    def visit_Assert(self, node):
        original_test = ast.unparse(node.test)
        self.generic_visit(node)
        if self.name == 'ROOT-ADOPTION-236-238-PROPOSAL.py' and original_test == "digest(value['path']) == value['sha256']":
            node.test = ast.BoolOp(op=ast.Or(), values=[
                ast.Call(func=ast.Name(id='_exact_snapshot', ctx=ast.Load()),
                         args=[ast.Name(id='value', ctx=ast.Load())], keywords=[]),
                node.test])
        return node

base.Portable = SnapshotPortable
original_exec_module = base.ExactLoader.exec_module

def exec_module(loader, module):
    module.__dict__['_exact_snapshot'] = exact_snapshot
    original_exec_module(loader, module)

base.ExactLoader.exec_module = exec_module
own_path = Path(__file__).resolve()
base.ADAPTER_REF = {
    'path': own_path.relative_to(ROOT.resolve()).as_posix(),
    'sha256': hashlib.sha256(own_path.read_bytes()).hexdigest(),
    'windows_adapter': {'path': BASE.relative_to(ROOT).as_posix(),
                        'sha256': hashlib.sha256(BASE.read_bytes()).hexdigest()},
    'historical_snapshot_qualification': {'path': Q.relative_to(ROOT).as_posix(),
                                         'sha256': hashlib.sha256(Q.read_bytes()).hexdigest()},
}

if __name__ == '__main__':
    assert sys.argv[1:] in ([], ['--apply-all'])
    importlib.util.spec_from_file_location = base.exact_spec
    entry = base.FOLDER / 'ROOT-ADOPTION-303-310-PROPOSAL.py'
    try:
        exec(base.source_tree(entry), {'__name__': '__main__', '__file__': str(entry),
                                     '_portable_str': base.portable_str,
                                     '_execution_adapter_ref': base.ADAPTER_REF,
                                     '_exact_snapshot': exact_snapshot})
    finally:
        importlib.util.spec_from_file_location = base.original_spec
        print(json.dumps({'execution_adapter': base.ADAPTER_REF, 'transforms': base.transforms}))
