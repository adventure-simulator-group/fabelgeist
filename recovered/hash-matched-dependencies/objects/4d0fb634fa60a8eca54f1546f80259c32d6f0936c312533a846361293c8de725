                for pair in value:
                    assert isinstance(pair,list) and len(pair)==2
                    assert all(type(n) is int for n in pair) and 1 <= pair[0] <= pair[1] <= 1435
                range_fields.append(location)
            else:
                required(value, location)
    elif isinstance(node,list):
        for i,value in enumerate(node): required(value,pointer+'/'+str(i))
