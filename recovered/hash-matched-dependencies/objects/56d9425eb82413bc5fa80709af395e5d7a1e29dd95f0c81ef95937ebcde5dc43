            gp = '/sources/0'
            reg = j['registration'] if section == 'rows' else row['registration']
            prospective = base.read_ref(reg)
            assert prospective['lens'] == 13 and prospective['authority_changes'] == 0 and 'prospective' in prospective['status'].lower()
            for key,val in base.at_pointer(prospective,gp).items():
                assert row[key] == val
            assert row['fresh_personal_assessed_ranges'] == [[1,row['actual_eof']]]
            record = {'read':ref(read_path), 'read_pointer':f'/{section}/{i}',
                      'registration':reg, 'registration_pointer':gp,
                      'registered_before_read_attestation':True, 'git_hash_eof_range_check':True,
                      'chronology_basis':'Exact immutable prospective registration and complete inherited receipt with preserved partial chronology.',
                      'assessed_ranges':row['fresh_personal_assessed_ranges']}
            verified.append(base.source_check(row, prospective, record, ref(read_path), f'/{section}/{i}', ledger))
            if section == 'connected':
                assert row['original'] == 1252 and row['actual_eof'] == 651
                assert row['original_credit_now'] == row['original_role_credit_now'] == 0 and row['registration_pointer'] == gp
                assert j['additional_registrations'] == [reg]
