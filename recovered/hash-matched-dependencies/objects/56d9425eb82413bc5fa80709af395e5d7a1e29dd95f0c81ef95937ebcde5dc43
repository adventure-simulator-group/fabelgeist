for n, eof, sh, vh in zip(range(311,314), [761,346,1029], state_hashes, verify_hashes, strict=True):
    read_path, state_path, verify_path = P/f'READ-PL13-{n}.json', P/f'STATE-PL13-{n}-PROPOSAL.json', P/f'VERIFY-PL13-{n}.json'
    assert sha(read_path) == manifest['read_hashes'][str(n)]
