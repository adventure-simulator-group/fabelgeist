    assert s['read'] == v['read'] == ref(read_path) and s['verification'] == ref(verify_path) and v['registration'] == j['registration']
    assert s['proposed_accounted_indices'] == list(range(index+1))
    assert s['proposed_next_original'] == s['proposed_original_accounted'] == j['proposed_next_original'] == v['proposed_next_original'] == index+1
    assert s['this_proposal_delta'] == j['original_delta_proposed'] == v['proposed_original_delta'] == 1
    assert v['verified_personal_complete_originals'] == [index]
    for key in ('authoritative_counts_changed','current_reconciled','global_clearance','product_execution'):
        assert j[key] is False
    assert j['accepted_unique_count_change'] == 0
    assert j['proposed_findings'] == j['necessary_extensions'] == j['current_delta_updates'] == j['qualified_same_lens_reuse'] == []
    assert len(j['rows']) == 1 and j['rows'][0]['original'] == index and j['rows'][0]['actual_eof'] == eof
    assert len(j['connected']) == (1 if n == 313 else 0)
    verified, connected = [], []
    for section in ('rows','connected'):
