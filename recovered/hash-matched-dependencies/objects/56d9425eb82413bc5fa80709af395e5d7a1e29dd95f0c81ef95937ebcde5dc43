        for key in ('original','source_id','sha256','actual_eof'):
            assert partial[key] == j['rows'][0][key]
        assert partial['lens'] == 13 and partial['registration'] == j['registration']
        assert partial['registered_before_read_attestation'] is partial['untruncated_body_outputs'] is True
        assert partial['assessed_ranges'] == [[1,end]] and partial['next_unread_range'] == [end+1,eof]
        assert partial['original_delta'] == 0 and partial['proposed_next_original_unchanged'] == index
        assert partial['product_execution'] is False
        if i:
            assert partial['previous_partial'] == partials[i-1] and partial['fresh_personal_ranges_this_checkpoint'] == [[ends[i-1]+1,end]]
    if ends:
        u = j['partial_read_union']
        assert len(u) == 1 and u[0]['original'] == index and u[0]['cumulative_assessed_ranges'] == [[1,eof]]
        assert u[0]['fresh_completion_ranges'] == [[ends[-1]+1,eof]] and u[0]['reread_claimed'] is False
        if n == 311: assert u[0]['earlier_personal_ranges'] == [[1,490]]
        else: assert u[0]['cumulative_prefixes'] == [460,920]
    else: assert j['partial_read_union'] == []
    if n != 313:
        assert j['future_same_lens_reuse_proofs'] == j['contract_updates'] == j['connected_contracts'] == []
    else:
        assert len(j['future_same_lens_reuse_proofs']) == 1
