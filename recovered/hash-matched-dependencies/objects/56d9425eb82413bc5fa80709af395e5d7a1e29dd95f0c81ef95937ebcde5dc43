    base.all_refs(j)
    g = base.read_ref(j['registration'])
    index = n + 924
    assert j['lens'] == s['lens'] == v['lens'] == g['lens'] == 13
    assert j['registered_before_read_attestation'] is True and 'prospective' in g['status'].lower() and g['authority_changes'] == 0
