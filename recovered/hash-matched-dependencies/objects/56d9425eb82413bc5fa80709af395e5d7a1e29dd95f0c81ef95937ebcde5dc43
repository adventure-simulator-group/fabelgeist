        for key in ('original','source_id','sha256','source_revision','actual_eof','registration','registration_pointer'):
            assert future[key] == row[key]
        assert future['assessed_ranges'] == [[1,651]] and future['read_pointer'] == '/connected/0'
        assert future['same_lens_only'] is future['count_once_when_frontier_reaches'] is True
        assert future['original_credit_now'] == future['original_role_credit_now'] == 0
        assert len(j['contract_updates']) == len(j['connected_contracts']) == 1
        assert j['contract_updates'][0]['contract_id_or_proposed_new_id'] == revisit_id
        assert j['connected_contracts'][0]['proposed_id'] == question_id
    plan[n] = {'manifest':ref(M), 'batch':{'read':ref(read_path),'state':ref(state_path),'verification':ref(verify_path)},
               'evidence':j, 'effective_connected_contracts':j['connected_contracts'],
               'verified':verified, 'connected':connected,
               'original_before':index,'original_after':index+1,
               'partial_qualification':{'partial_receipts':partials,'exact_partial_unions':j['partial_read_union'],
