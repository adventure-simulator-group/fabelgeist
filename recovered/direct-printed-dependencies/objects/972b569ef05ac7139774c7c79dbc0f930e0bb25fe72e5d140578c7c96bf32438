def exact_source(src):
    index=src['original'];f=files[index]
    assert src['source_id']==f['source_id'] and src['sha256']==f['sha256']
    assert src['source_id'].startswith('pr-working:')
    assert src['source_revision'] in (GIT,'pr-working exact frozen object; Git'+GIT)
    p=Path(src['object_path']);assert p.resolve().is_relative_to(R.resolve())
    body=p.read_bytes();assert hashlib.sha256(body).hexdigest()==src['sha256']
    assert len(body.splitlines())==src['actual_eof']
    if 'bytes' in f:assert len(body)==f['bytes']
    git_path=f['path']
    if index in (1244,1245,1247,1248,1249,1252,1253,1269,1273,1280,1289):
        qp=A/'QUALIFICATION-ROOT-L13-SNAPSHOT-LOCATORS-006.json'
        assert sha(qp)=='1af19f98643c7733fd74c494cf8740d80153dc5b08da0b8ef32aa2ef85856edf'
        q=load(qp);assert q['registry']==ref(registry_path)
        assert q['body_credit']==q['authority_changes']==0
        matches=[x for x in q['entries'] if x['original']==index];assert len(matches)==1
        entry=matches[0]
        assert entry['source_id']==src['source_id'] and entry['sha256']==src['sha256']
        assert entry['actual_eof']==src['actual_eof']==f['actual_line_count']
        assert entry['registry_path']==f['path']
        git_path=entry['git_path'];assert git_path==src['source_id'].split(':',1)[1]
        assert f['path']=='SNAPSHOTS\\pr-working\\'+git_path.replace('/','\\')
    assert body==subprocess.check_output(['git','show',GIT+':'+git_path])
    nested_ranges(f,src['actual_eof'],index)
