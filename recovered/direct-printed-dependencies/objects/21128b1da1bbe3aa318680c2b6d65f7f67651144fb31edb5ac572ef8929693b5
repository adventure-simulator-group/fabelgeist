import hashlib,json,subprocess
A=Path(__file__).resolve().parent;R=A.parent;W=R.parent.parent

def pack(v):return (json.dumps(v,indent=2)+'\n').encode()
def sha(p):
    with p.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
def read(p):return json.loads(p.read_bytes())
def ref(p):return {'path':p.relative_to(R).as_posix(),'sha256':sha(p)}
def checked(v):
    p=R/v['path'];assert p.resolve().is_relative_to(R) and sha(p)==v['sha256'];return read(p)
def pointer(v,p):
    for k in p.strip('/').split('/'):v=v[int(k)] if isinstance(v,list) else v[k]
    return v
def lines(rs):return {n for lo,hi in rs for n in range(lo,hi+1)}

