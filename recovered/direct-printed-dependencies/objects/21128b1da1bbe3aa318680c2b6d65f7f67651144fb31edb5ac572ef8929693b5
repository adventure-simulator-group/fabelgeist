        assert s['revision']=='33714256b6313ce86fdfbb534c54d92d024d7726'
        assert subprocess.check_output(['git','show',s['revision']+':'+s['git_path']],cwd=W)==raw
        prior=s['prior_own_lens_read'];rr=prior['receipt'];assert (rr['path'],rr['sha256']) in eligible
        old=pointer(checked(rr),prior['pointer'])
        assert old.get('source_sha256',old.get('sha256'))==s['source_sha256']
        assessed=lines(row['assessed_ranges']);f=lines(row['fresh_personal_body_reads']);prior_lines=lines(old[prior['range_field']])
