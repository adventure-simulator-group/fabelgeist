            assert len(hits)==1 and hits[0]['receipt']==rr and hits[0]['pointer']==prior['pointer'] and hits[0]['record']==old
            fresh_scopes.append({'source_id':s['source_id'],'source_sha256':s['source_sha256'],'ranges':row['fresh_personal_body_reads']})
        scopes.append({'source_id':s['source_id'],'source_sha256':s['source_sha256'],'ranges':s['ranges'],'fresh_ranges':row['fresh_personal_body_reads'],'previous_own_lens_body':prior,'original_author_fields_present':{k:old[k] for k in ['author','attribution','roles','status'] if k in old}})
        fresh+=len(f);reused+=len(assessed-f)
    assert (fresh,reused)==(98,450) and len(fresh_scopes)==1
    rp=R/'evidence/audit05/original-scope-072.json';assert sha(rp)=='d1c798df997434ae8e89e433237f798de5c87a38d634f3a7d2f1b0f8af9b1f0f'
    original=read(rp)['files'][2511]
