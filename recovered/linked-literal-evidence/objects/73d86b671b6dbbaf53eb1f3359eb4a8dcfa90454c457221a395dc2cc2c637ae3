original_spec = importlib.util.spec_from_file_location
transforms = {}

def portable_str(value):
    return value.as_posix() if isinstance(value, Path) else str(value)

class Portable(ast.NodeTransformer):
    def __init__(self, name):
        self.name = name
        self.count = 0
        self.writer_count = 0
        self.receipt_count = 0

    def visit_Call(self, node):
        self.generic_visit(node)
        if isinstance(node.func, ast.Name) and node.func.id == 'str':
            assert len(node.args) == 1 and not node.keywords
            node.func.id = '_portable_str'
            self.count += 1
        if self.name == 'ROOT-ADOPTION-236-238-PROPOSAL.py' and ast.unparse(node) == "Path(path).open('x')":
            node.keywords.extend([ast.keyword(arg='encoding', value=ast.Constant('utf-8')),
                                  ast.keyword(arg='newline', value=ast.Constant('\n'))])
            self.writer_count += 1
        return node

    def visit_Assign(self, node):
        self.generic_visit(node)
        if self.name == 'ROOT-ADOPTION-236-238-PROPOSAL.py' and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name) and node.targets[0].id == 'receipt':
            assert isinstance(node.value, ast.Dict)
            node.value.keys.append(ast.Constant('execution_adapter'))
            node.value.values.append(ast.Name(id='_execution_adapter_ref', ctx=ast.Load()))
            self.receipt_count += 1
        return node

def source_tree(path):
    path = Path(path)
    assert path.resolve().parent == FOLDER.resolve() and path.name in HASHES
    body = path.read_bytes()
    assert hashlib.sha256(body).hexdigest() == HASHES[path.name]
    original = ast.parse(body, filename=str(path))
    original_assertions = sum(isinstance(n, ast.Assert) for n in ast.walk(original))
    adapter = Portable(path.name)
    tree = ast.fix_missing_locations(adapter.visit(original))
    assert sum(isinstance(n, ast.Assert) for n in ast.walk(tree)) == original_assertions
    if path.name == 'ROOT-ADOPTION-236-238-PROPOSAL.py':
        assert adapter.writer_count == adapter.receipt_count == 1
    else:
        assert adapter.writer_count == adapter.receipt_count == 0
    transforms[path.name] = {'path_string_calls': adapter.count,
                             'assertions_preserved': original_assertions,
                             'exclusive_lf_writers': adapter.writer_count,
                             'additive_adapter_receipt_fields': adapter.receipt_count}
    return compile(tree, str(path), 'exec')

class ExactLoader:
    def __init__(self, path):
        self.path = Path(path)

    def create_module(self, spec):
        return None

    def exec_module(self, module):
        module.__dict__.update(_portable_str=portable_str,
                               _execution_adapter_ref=ADAPTER_REF)
        exec(source_tree(self.path), module.__dict__)

def exact_spec(name, location, *args, **kwargs):
    assert not args and not kwargs
    path = Path(location)
    assert path.resolve().parent == FOLDER.resolve() and path.name in HASHES
    return original_spec(name, path, loader=ExactLoader(path))

