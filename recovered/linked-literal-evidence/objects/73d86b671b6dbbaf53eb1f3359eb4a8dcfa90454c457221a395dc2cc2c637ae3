    importlib.util.spec_from_file_location = exact_spec
    entry = FOLDER / 'ROOT-ADOPTION-303-310-PROPOSAL.py'
    try:
        exec(source_tree(entry), {'__name__': '__main__', '__file__': str(entry),
                                '_portable_str': portable_str,
                                '_execution_adapter_ref': ADAPTER_REF})
    finally:
        importlib.util.spec_from_file_location = original_spec
