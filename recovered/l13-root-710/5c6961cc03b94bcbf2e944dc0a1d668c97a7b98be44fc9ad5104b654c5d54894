"""Qualify five viewer/rest/party/grounding admission roles before fresh body reads."""
from pathlib import Path
import hashlib
import json
import subprocess


def build(r, w, a, co, files):
    r, w, a = [p.resolve() for p in (r, w, a)]

    def sha(p):
        return hashlib.sha256(p.read_bytes()).hexdigest()

    def read(p):
        return json.loads(p.read_bytes())

    def resolve(v):
        ps = {p.resolve() for p in [r / v['path'], w / v['path'],
              r / 'evidence/continuation-segovb' / v['path']]
              if p.is_file() and sha(p) == v['sha256']}
        assert len(ps) == 1
        return ps.pop()

    assert co['next_original'] == 2704 and len(co['discovery_receipts']) == 713
    dp = w.parent / '726-intake-20261030/DISCOVERY-L13-2704-2708-METADATA-001.json'
    assert sha(dp) == '1248d65bd69ab571420946071d3d720635284c3857c82b178c4bee12642c1d10'
    d = read(dp)
    targets = {files[n]['sha256']: n for n in range(2704, 2709)}
    assert len(targets) == 5
    hits = []
    for v in co['discovery_receipts']:
        raw = resolve(v).read_bytes()
        for h, n in targets.items():
            if h.encode() in raw:
                hits.append({'original': n, 'receipt': v})
    futures = [v for v in co['future_same_lens_reuse_proofs']
               if any(h in json.dumps(v) for h in targets)]
    apps = [v for v in co['future_same_lens_ordered_applications']
            if any(h in json.dumps(v) for h in targets)]
    assert hits == d['exact_hash_prior_hits'] and [(x['original'],x['receipt']['path']) for x in hits] == [(2706,'segovb/READ-L13-PARALLEL-641.json'),(2705,'segovb/READ-L13-PARALLEL-644.json'),(2707,'segovb/READ-L13-PARALLEL-644.json')]
    assert futures == d['future_same_lens_proofs_navigation'] == []
    assert apps == d['prior_applications_preserved_navigation'] == []
    assert d['frontier'] == 2704 and d['prior_same_lens_receipts_authenticated'] == 713
    assert d['body_credit'] == d['authority_changes'] == 0
    fields = []

    def inspect(v, eof, p):
        if isinstance(v, dict):
            for k, x in v.items():
                at = p + '/' + k
                if (k.endswith('ranges') or k in ['read_ranges_as_recorded',
                        'material_contract_ranges_as_recorded',
                        'requested_range_limits', 'context_excluded','context_or_blank_no_material_credit']) and x:
                    assert isinstance(x, list) and all(isinstance(z, list)
                        and len(z) == 2 and all(isinstance(y, int) for y in z)
                        and 1 <= z[0] <= z[1] <= eof for z in x), (at, x, eof)
                    fields.append({'pointer': at, 'raw_value': x, 'actual_eof': eof})
                inspect(x, eof, at)
        elif isinstance(v, list):
            for j, x in enumerate(v):
                inspect(x, eof, p + '/' + str(j))

    specs = [(2704,4404,172605,[[1593,1644],[2656,3327]]),(2705,840,30485,[[1,21],[32,91],[104,158]]),(2706,484,17424,[[356,484]]),(2707,725,25046,[[38,44]]),(2708,58,2314,[[1,44]])]
    sources, entries = [], []
    for n, eof, size, rs in specs:
        f = files[n]
        gp = f['source_id'].split(':', 1)[1]
        assert d['entries'][n - 2704] == {'original': n, 'registry_entry': f}
        prefix,snapshot,pathpart={2704:('physical-p16','p16','p16'),2705:('physical-p16','physical-p16','p16'),2706:('physical-p16','physical-p16','p16'),2707:('physical-p16','physical-p16','p16'),2708:('pr-working','pr-working','pr-working')}[n]
        assert f['source_id']==prefix+':'+gp and f['snapshot']==snapshot
        assert f['path']==('SNAPSHOTS/'+pathpart+'/'+gp).replace('/','\\')
        assert f['actual_line_count'] == eof and f['bytes'] == size
        assert f['scope_kind'] == 'materially_reached_admission_contract'
        assert f['material_ranges'] == rs
        inspect(f, eof, f'/files/{n}')
        covered = {j for lo, hi in rs for j in range(lo, hi + 1)}
        assert {j for role in f['admission03_scope_observations']
                for lo, hi in role['effective_material_ranges']
                for j in range(lo, hi + 1)} == covered
        git = 'f82adcabd9d89c4fa2dd7f99253a45297a0681ee'
        ap = ('handoff/774/audit/reconcile-adler-20261023/recovered-sources/objects/'
              + f['sha256'])
        body = subprocess.check_output(['git', 'show', git + ':' + ap])
        assert hashlib.sha256(body).hexdigest() == f['sha256']
        assert len(body) == size and len(body.splitlines()) == eof
        if n in (2705,2706,2707,2708):
            assert body == subprocess.check_output(['git','show','6533e444fa37552927070cc8d8190907fd3b413e:'+gp])
        obj = a / 'objects' / f['sha256']
        if obj.is_file():
            assert obj.read_bytes() == body
        else:
            with obj.open('xb') as out:
                out.write(body)
        src = {'original': n, 'source_id': f['source_id'], 'sha256': f['sha256'],
               'actual_eof': eof, 'object_path': obj.relative_to(w).as_posix(),
               'source_revision': git, 'transport_git_path': ap,
               'prospective_ranges': rs,
               'revision_qualification': 'Exact recorded native prefix/snapshot/path; archivef82 transport only, literal frozenPR join only where independently checked, no current semantic transfer.',
               'purpose': 'Five viewer/rest/party/grounding roles1040material,769fresh/271prior; service helper44 fresh completes actual partial read, no execution.'}
        sources.append(src)
        unread = []
        for k in range(1, eof + 1):
            if k not in covered:
                if unread and unread[-1][1] == k - 1:
                    unread[-1][1] = k
                else:
                    unread.append([k, k])
        prior=None;partial=None
        if n in(2705,2706,2707):
            seq,ix,original,oldranges={2705:(644,0,2380,[[1,377]]),2706:(641,1,2375,[[296,484]]),2707:(644,2,2382,[[1,43]])}[n]
            rp=resolve(next(x['receipt']for x in hits if x['original']==n));root=read(rp);rawp=resolve(root['packet']);raw=read(rawp);row=raw['ordered'][ix];old=row['source'];pregp=resolve(row['registration']);preg=read(pregp);plan=read(resolve(root['plan']));vp=r/f'segovb/VERIFY-L13-PARALLEL-{seq}.json';statep=r/f'segovb/STATE-L13-PARALLEL-{seq}.json';v=read(vp)
            assert root['evidence']==raw and root['lens']==raw['lens']==preg['lens']==v['lens']==13 and raw['author']==row['author']=='/root' and raw['registered_before_read_attestation']is row['untruncated_body_outputs']is True
            assert row['registration_pointer']==f'/sources/{ix}' and preg['sources'][ix]==old and row['assessed_ranges']==old['prospective_ranges']==oldranges and old['original']==original and old['source_id']=='pr-working:'+gp and old['sha256']==f['sha256'] and old['actual_eof']==eof and preg['at']<raw['at']<root['at'] and plan['packet']==root['packet']
            assert v['receipt_sha256']==sha(rp) and v['state_sha256']==sha(statep) and v['writer']==root['writer'] and sha(resolve(root['writer']))==root['writer']['sha256'] and v['exact_registry_Git_hash_EOF_prospective_chronology_scope_and_reuse_checked']is True and v['other_lens_credit']==0 and v['product_execution']is v['gate']is False and (w/old['object_path']).read_bytes()==body
            def ref(p):return {'path':p.relative_to(r).as_posix(),'sha256':sha(p)}
            oldproof={'prior_adoption':ref(rp),'prior_packet':root['packet'],'prior_plan':root['plan'],'prior_registration':row['registration'],'prior_native_verification':ref(vp),'prior_state':ref(statep),'prior_row_pointer':f'/ordered/{ix}','prior_registration_pointer':f'/sources/{ix}','prior_source_row':row,'historical_attribution':'/root'}
            if n==2707:
                partial=oldproof
                assert set(range(38,44)).issubset({j for lo,hi in oldranges for j in range(lo,hi+1)}) and 44 not in {j for lo,hi in oldranges for j in range(lo,hi+1)}
                src['fresh_personal_assessed_ranges']=[[44,44]]
            else:
                prior=oldproof
                assert covered.issubset({j for lo,hi in oldranges for j in range(lo,hi+1)})
        e={'original': n, 'source': src, 'mode': 'root-reuse' if prior else 'fresh', 'bytes': size,
            'assessed_union': rs, 'material_line_count': len(covered),
            'new_root_personal_lines': 0 if prior else 1 if partial else len(covered),
            'registry_entry_sha256': hashlib.sha256(
                (json.dumps(f, indent=2) + '\n').encode()).hexdigest(),
            'registry_path_as_recorded': f['path'], 'source_current_reconciled': False,
            'unread_ranges': unread, 'whole_file_coverage': not unread}
        if prior:e['prior']=prior
        if partial:e.update(partial_prior=partial,qualified_prior_material_ranges=[[38,43]],fresh_personal_assessed_ranges=[[44,44]],prior_material_lines_reused=6)
        entries.append(e)
    assert len(fields)==33 and sum(e['material_line_count']for e in entries)==1040 and sum(e['new_root_personal_lines']for e in entries)==769
    return {'entries': entries, 'sources': sources, 'all_nested_range_fields': fields,
            'exact_hash_prior_hits': hits, 'future_proofs_preserved': futures,
            'old_ordered_applications_preserved': apps, 'discovery_metadata_sha256': sha(dp),
            'production_source_lines': 1040, 'fixture_source_lines': 0,
            'fixture_execution': False, 'exact_partial_scopes_preserved': True,
            'partial2707_prior6_fresh1_union_qualified': True,
            'native_context_exclusions_preserved': True}
