+}
+
+fn describe_observation<T>(
+    observation: &Observation<T>,
+    measured: impl FnOnce(&T) -> String,
+) -> String {
+    match observation {
+        Observation::NotApplicable => "not applicable".to_owned(),
+        Observation::Unavailable(reason) => format!("unavailable: {}", reason.description()),
