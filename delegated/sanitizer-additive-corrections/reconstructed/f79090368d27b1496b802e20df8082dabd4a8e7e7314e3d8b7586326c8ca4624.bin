actual_EOF": 140, "material_ranges": [[1, 140]], "scope_record": "continuation/cumulative-source-scope-parallel-061.json#/files/666"}, {"scope061_index": 667, "source_id": "pr-working:crates/adventuresim-building-generator/src/spatial_geometry/dimensions.rs", "sha256": "4ccc1188de7d5f8bdbf63b71160b8557f76fb524ae47f924381325da11198ee8", "actual_EOF": 105, "material_ranges": [[1, 105]], "scope_record": "continuation/cumulative-source-scope-parallel-061.json#/files/667"}, {"scope061_index": 668, "source_id": "pr-working:crates/adventuresim-building-generator/src/spatial_geometry/error.rs", "sha256": "c71c5590f1fb87ae1645a6e4f4ed54a0059d33b821ad0062e098821e1409b899", "actual_EOF": 28, "material_ranges": [[1, 28]], "scope_record": "continuation/cumulative-source-scope-parallel-061.json#/files/668"}, {"scope061_index": 669, "source_id": "pr-working:crates/adventuresim-building-generator/src/spatial_geometry/length.rs", "sha256": null, "base_sha256": "85b9e28a95b866246fdc9e3c87fbf6c59f3c8ab02b87d623ef1bdaeb3110411a", "actual_EOF": 0, "material_ranges": [], "scope_record": "continuation/cumulative-source-scope-parallel-061.json#/files/669", "source_state": "deleted_current_frozen_snapshot; base source not read/credited"}, {"scope061_index": 670, "source_id": "pr-working:crates/adventuresim-building-generator/src/spatial_geometry/measurement.rs", "sha256": null, "base_sha256": "1c74872f4983d3d79a526dff9b345c9d8dfbbf1178e1caccdbcdd897f9fb3b28", "actual_EOF": 0, "material_ranges": [], "scope_record": "continuation/cumulative-source-scope-parallel-061.json#/files/670", "source_state": "deleted_current_frozen_snapshot; base source not read/credited"}, {"scope061_index": 671, "source_id": "pr-working:crates/adventuresim-building-generator/src/spatial_geometry/orientation.rs", "sha256": "05f48ed8a27959acd5930fc56690d454e5307482f673cbdb5628d88970c3db1d", "actual_EOF": 142, "material_ranges": [[1, 142]], "scope_record": "continuation/cumulative-source-scope-parallel-061.json#/files/