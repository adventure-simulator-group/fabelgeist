 139     pub fn capacity(&self) -> u32 {
 140         self.capacity
 141     }
 142 
 143     /// Primitive count as of the last recorded build.
 144     pub fn count(&self) -> u32 {
 145         self.count
 146     }
 147 
 148     /// Node count for the current primitive count.
 149     pub fn node_count(&self) -> u32 {
 150         if self.count == 0 {
 151             0
 152         } else {
 153             2 * self.count - 1
 154         }
 155     }
 156 
 157     /// Reallocate if `capacity` no longer fits.
 158     pub fn ensure_capacity(&mut self, context: &WgpuContext, capacity: u32) -> Result<bool> {
 159         if capacity <= self.capacity {
 160             return Ok(false);
 161         }
 162         *self = Self::new(context, self.kernels.clone(), capacity)?;
 163         Ok(true)
 164     }
 165 
 166     /// The buffers a traversal generated by [`traversal_source`] expects,
 167     /// under the default [`TraversalConfig`] names.
 168     pub fn parameters(&self) -> PassParameters {
 169         let mut parameters = PassParameters::new();
 170         self.bind(&mut parameters, &TraversalConfig::default());
 171         parameters
 172     }
 173 
 174     /// The same, under whatever names `config` gives.
