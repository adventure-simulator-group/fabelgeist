   1 //! A linear BVH built on the GPU.
   2 //!
   3 //! Morton-code order, Karras hierarchy, atomic bottom-up refit -- the whole
   4 //! build records into a [`KernelBatch`] and never reads anything back, so a
   5 //! deforming mesh can be rebuilt inside the frame that deforms it.
   6 //!
   7 //! The tree it produces is worse than the surface-area-heuristic one in
   8 //! [`crate::cpu`]: Morton order splits on a fixed grid rather than on where
   9 //! the primitives actually are. It is built in milliseconds on the device the
  10 //! primitives already live on, which is the trade being made.
  11 //!
  12 //! When only the vertices move and the topology does not -- a posed body, a
  13 //! simulated cloth -- [`GpuBvh::record_refit`] skips straight to the refit and
  14 //! keeps the existing Morton ordering. That ordering slowly stops matching the
  15 //! geometry as the mesh deforms, so a full [`GpuBvh::record_build`] is still
  16 //! worth doing periodically.
  17 
  18 pub mod shaders;
  19 
  20 use fabelgeist_compute::prelude::*;
  21 use fabelgeist_gpu::prelude::*;
  22 
  23 pub use shaders::{TraversalConfig, traversal_source};
  24 
  25 use crate::morton;
  26 
  27 /// Bytes per node: two `vec4<f32>`.
  28 const NODE_BYTES: u64 = 32;
  29 /// Words per node in the atomic scratch: lower xyz then upper xyz.
  30 const BOUNDS_WORDS: u64 = 6;
  31 
  32 /// The compiled build passes, shared by every hierarchy on a device.
  33 #[derive(Clone, Debug)]
  34 pub struct BvhKernels {
  35     bounds: std::sync::Arc<Kernel>,
  36     codes: std::sync::Arc<Kernel>,
  37     hierarchy: std::sync::Arc<Kernel>,
  38     clear_bounds: std::sync::Arc<Kernel>,
  39     refit: std::sync::Arc<Kernel>,
  40     gather_bounds: std::sync::Arc<Kernel>,
  41     sort: RadixSort,
  42 }
  43 
  44 impl BvhKernels {
  45     pub fn new(context: &WgpuContext) -> Result<Self> {
  46         Self::with_cache(context, &KernelCache::new())
  47     }
  48 
  49     pub fn with_cache(context: &WgpuContext, cache: &KernelCache) -> Result<Self> {
  50         Ok(Self {
  51             bounds: cache.get(context, &shaders::bounds_source())?,
  52             codes: cache.get(context, &shaders::codes_source())?,
  53             hierarchy: cache.get(context, &shaders::hierarchy_source())?,
  54             clear_bounds: cache.get(context, &shaders::clear_bounds_source())?,
  55             refit: cache.get(context, &shaders::refit_source())?,
  56             gather_bounds: cache.get(context, &shaders::gather_bounds_source())?,
  57             sort: RadixSort::with_cache(context, cache)?,
  58         })
  59     }
  60 }
  61 
  62 /// A hierarchy over `count` primitives, and every buffer the build needs.
  63 ///
  64 /// The caller owns `primitive_bounds` -- two `vec4<f32>` per primitive, lower
  65 /// then upper -- because it is usually written by the caller's own kernel
  66 /// (triangle bounds from deformed vertices, particle bounds from positions).
  67 /// Everything else lives here.
  68 pub struct GpuBvh {
  69     kernels: BvhKernels,
  70 
  71     /// Two `vec4<f32>` per node. See [`shaders`] for the layout.
  72     pub nodes: Buffer,
  73     /// Right child of each internal node.
  74     pub right_children: Buffer,
  75     /// Primitives in Morton order.
  76     pub indices: Buffer,
  77     /// Parent of each node. The root's entry is never read.
  78     pub parents: Buffer,
  79 
  80     codes: Buffer,
  81     scene_bounds: Buffer,
  82     node_bounds: Buffer,
  83     sort_scratch: SortScratch,
  84 
  85     capacity: u32,
  86     count: u32,
  87 }
  88 
  89 impl GpuBvh {
  90     /// Allocate for up to `capacity` primitives.
  91     pub fn new(context: &WgpuContext, kernels: BvhKernels, capacity: u32) -> Result<Self> {
  92         let capacity = capacity.max(1);
  93         let nodes = 2 * capacity as u64 - 1;
  94         let storage = BufferDefinition::storage();
  95 
  96         Ok(Self {
  97             kernels,
  98             nodes: Buffer::new(
  99                 context,
 100                 (nodes * NODE_BYTES).into(),
 101                 storage.clone().with_label(("bvh nodes").into()),
 102             )?,
 103             right_children: Buffer::new(
 104                 context,
 105                 ((capacity as u64).max(1) * 4).into(),
 106                 storage.clone().with_label(("bvh right children").into()),
 107             )?,
 108             indices: Buffer::new(
 109                 context,
 110                 (capacity as u64 * 4).into(),
 111                 storage.clone().with_label(("bvh indices").into()),
 112             )?,
 113             parents: Buffer::new(
 114                 context,
 115                 (nodes * 4).into(),
 116                 storage.clone().with_label(("bvh parents").into()),
 117             )?,
 118             codes: Buffer::new(
 119                 context,
 120                 (capacity as u64 * 4).into(),
 121                 storage.clone().with_label(("bvh morton codes").into()),
 122             )?,
 123             scene_bounds: Buffer::new(
 124                 context,
 125                 (BOUNDS_WORDS * 4).into(),
 126                 storage.clone().with_label(("bvh scene bounds").into()),
 127             )?,
 128             node_bounds: Buffer::new(
 129                 context,
 130                 (nodes * BOUNDS_WORDS * 4).into(),
 131                 storage.with_label(("bvh node bounds").into()),
 132             )?,
 133             sort_scratch: SortScratch::new(context, capacity)?,
 134             capacity,
 135             count: 0,
 136         })
 137     }
 138 
