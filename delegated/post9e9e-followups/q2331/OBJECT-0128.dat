 195 "#
 196     )
 197 }
 198 
 199 /// Resolve every particle against a triangle mesh, through the mesh's own BVH.
 200 ///
 201 /// `traversal` is the source generated by `fabelgeist_bvh::gpu::traversal_source`,
 202 /// which calls back into `bvh_hit` for every candidate triangle. WGSL has no
 203 /// closures, so the callback keeps its result in module-scope `var`s -- the
 204 /// kernel is one particle per thread, so there is nothing to share them with.
 205 pub fn mesh_source(traversal: &str) -> String {
 206     format!(
 207         r#"
 208 @group(0) @binding(0) var<storage, read_write> positions: array<vec4<f32>>;
 209 @group(0) @binding(1) var<storage, read> previous: array<vec4<f32>>;
 210 @group(0) @binding(2) var<storage, read> mesh_positions: array<vec4<f32>>;
 211 @group(0) @binding(3) var<storage, read> mesh_triangles: array<u32>;
 212 @group(0) @binding(4) var<storage, read> bvh_nodes: array<vec4<f32>>;
 213 @group(0) @binding(5) var<storage, read> bvh_right_children: array<u32>;
 214 @group(0) @binding(6) var<storage, read> bvh_indices: array<u32>;
 215 
 216 struct Params {{
 217     count: u32,
 218     thickness: f32,
 219     friction: f32,
 220     // Widens the search beyond the shell. Zero for a normal substep, where the
 221     // swept box is enough; large for the recovery pass that has to find the
 222     // surface from deep inside the mesh.
 223     search_radius: f32,
 224 }};
 225 @group(0) @binding(7) var<uniform> params: Params;
 226 {RESPONSE}
 227 
 228 // The query, and the best candidate so far. One particle per thread, so these
 229 // stand in for the closure the traversal would otherwise take.
 230 var<private> query_point: vec3<f32>;
 231 var<private> best_distance_squared: f32;
 232 var<private> best_point: vec3<f32>;
 233 var<private> best_normal: vec3<f32>;
 234 var<private> found: bool;
 235 
 236 fn triangle_closest_point(p: vec3<f32>, a: vec3<f32>, b: vec3<f32>, c: vec3<f32>) -> vec3<f32> {{
 237     // Ericson, Real-Time Collision Detection 5.1.5: the three vertex regions
 238     // and the three edge regions come first, so a point outside the triangle's
 239     // prism gets the right answer rather than a projection onto the plane.
 240     let ab = b - a;
