   1 //! Exclusive prefix sum of `u32`s, recorded into a [`KernelBatch`].
   2 //!
   3 //! [`Scan`] folds with any WGSL operator, but each call submits on its own
   4 //! encoder, so it cannot sit between two dispatches of a frame's batch. Tree
   5 //! builds need exactly that: count how many nodes each element emits, sum the
   6 //! counts into offsets, and write the nodes -- three passes that have to run
   7 //! back to back without a trip to the host. This is that middle pass.
   8 //!
   9 //! The classic three-step scan, applied recursively: each workgroup scans its
  10 //! own block of 256 in shared memory and writes the block's total aside; the
  11 //! totals are scanned the same way; then every block adds its total's offset
  12 //! back. Three levels cover 16.7 million elements, and nothing limits the
  13 //! depth beyond that.
  14 
  15 use crate::prelude::*;
  16 use fabelgeist_gpu::prelude::BufferByteLength;
  17 use std::sync::Arc;
  18 
  19 /// Number of `u32` elements in an exclusive scan, not a byte extent.
  20 #[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
  21 pub struct ScanElementCount(u32);
  22 
  23 /// The scan's application-owned failures, retaining lower-level GPU causes.
  24 #[derive(Debug, thiserror::Error)]
  25 pub enum ScanError {
  26     #[error("scan requires {requested} elements but scratch holds {capacity}")]
  27     ScratchTooSmall {
  28         requested: ScanElementCount,
  29         capacity: ScanElementCount,
  30     },
  31     #[error("scan requires {required:?} but the input buffer holds {available:?}")]
  32     BufferTooSmall {
  33         required: BufferByteLength,
  34         available: BufferByteLength,
  35     },
  36     #[error("scan scratch is missing a recursion level")]
  37     MissingScratchLevel,
  38     #[error("scan GPU operation failed")]
  39     Gpu(#[from] anyhow::Error),
  40 }
  41 
  42 type Result<T> = std::result::Result<T, ScanError>;
  43 
  44 impl ScanElementCount {
  45     /// Admit an element count at a native collection or GPU-word boundary.
  46     pub const fn from_elements(elements: u32) -> Self {
  47         Self(elements)
  48     }
  49 
  50     /// The GPU uniform's fixed-width representation.
  51     pub const fn elements(self) -> u32 {
  52         self.0
  53     }
  54 
  55     pub fn byte_length(self) -> BufferByteLength {
  56         BufferByteLength::from(u64::from(self.0) * std::mem::size_of::<u32>() as u64)
  57     }
  58 }
  59 
  60 impl std::fmt::Display for ScanElementCount {
  61     fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
  62         self.0.fmt(formatter)
  63     }
  64 }
  65 
  66 /// Elements per block, and threads per workgroup.
  67 const BLOCK: u32 = 256;
  68 
  69 fn scan_blocks_code() -> String {
  70     format!(
  71         r#"
  72 @group(0) @binding(0) var<storage, read_write> data: array<u32>;
  73 @group(0) @binding(1) var<storage, read_write> sums: array<u32>;
  74 
  75 struct Params {{
  76     count: u32,
  77     write_sums: u32,
  78     pad0: u32,
  79     pad1: u32,
  80 }};
  81 @group(0) @binding(2) var<uniform> params: Params;
  82 
  83 var<workgroup> shared_values: array<u32, {BLOCK}u>;
  84 
  85 @compute @workgroup_size({BLOCK}u)
  86 fn main(
  87     @builtin(local_invocation_id) local_id: vec3<u32>,
  88     @builtin(workgroup_id) group_id: vec3<u32>,
  89     @builtin(num_workgroups) groups: vec3<u32>,
  90 ) {{
  91     // Blocks fold into y past the 65535 groups one dimension holds.
  92     let block = group_id.y * groups.x + group_id.x;
  93     let index = block * {BLOCK}u + local_id.x;
  94 
  95     var value = 0u;
  96     if (index < params.count) {{
  97         value = data[index];
  98     }}
  99     shared_values[local_id.x] = value;
 100     workgroupBarrier();
 101 
 102     // Hillis-Steele, inclusive. Every lane reads before any lane writes, so
 103     // the barrier between them is all the double-buffering it needs.
 104     for (var offset = 1u; offset < {BLOCK}u; offset = offset * 2u) {{
 105         var carried = 0u;
 106         if (local_id.x >= offset) {{
 107             carried = shared_values[local_id.x - offset];
 108         }}
 109         workgroupBarrier();
 110         shared_values[local_id.x] = shared_values[local_id.x] + carried;
 111         workgroupBarrier();
 112     }}
 113 
 114     let inclusive = shared_values[local_id.x];
 115     if (index < params.count) {{
 116         data[index] = inclusive - value;
 117     }}
 118     if (local_id.x == {BLOCK}u - 1u && params.write_sums != 0u) {{
 119         sums[block] = inclusive;
 120     }}
 121 }}
 122 "#
 123     )
 124 }
 125 
 126 fn add_offsets_code() -> String {
 127     format!(
 128         r#"
 129 @group(0) @binding(0) var<storage, read_write> data: array<u32>;
 130 @group(0) @binding(1) var<storage, read> sums: array<u32>;
 131 
 132 struct Params {{
 133     count: u32,
 134     write_sums: u32,
 135     pad0: u32,
 136     pad1: u32,
 137 }};
 138 @group(0) @binding(2) var<uniform> params: Params;
 139 
 140 @compute @workgroup_size({BLOCK}u)
 141 fn main(
 142     @builtin(local_invocation_id) local_id: vec3<u32>,
 143     @builtin(workgroup_id) group_id: vec3<u32>,
 144     @builtin(num_workgroups) groups: vec3<u32>,
 145 ) {{
 146     let block = group_id.y * groups.x + group_id.x;
 147     let index = block * {BLOCK}u + local_id.x;
 148     if (index < params.count) {{
 149         data[index] = data[index] + sums[block];
 150     }}
 151 }}
 152 "#
 153     )
 154 }
 155 
 156 /// Workgroups for `blocks` blocks, folded into y past one dimension's limit.
 157 fn grid(blocks: u32) -> [u32; 3] {
 158     let x = blocks.clamp(1, MAX_GROUPS);
 159     [x, blocks.div_ceil(x), 1]
 160 }
