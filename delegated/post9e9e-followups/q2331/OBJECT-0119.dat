   1 //! The WGSL the GPU hierarchy is built from, plus the traversal source other
   2 //! crates paste into their own kernels.
   3 //!
   4 //! A BVH is only useful to a solver if the solver can walk it *inside* its own
   5 //! kernel -- a contact pass wants to find candidate triangles and resolve them
   6 //! in one dispatch, not read a candidate list back and forth. So the traversal
   7 //! is published as source rather than as a kernel: call [`traversal_source`],
   8 //! paste the result into your kernel, and call `bvh_query_aabb` from it.
   9 //!
  10 //! # Buffer layout
  11 //!
  12 //! * `nodes: array<vec4<f32>>` -- two entries per node. `[0].xyz` is the lower
  13 //!   corner and `[0].w` (bitcast to `u32`) is the left child; `[1].xyz` is the
  14 //!   upper corner and `[1].w` is the primitive count, which is zero for an
  15 //!   internal node and one for a leaf.
  16 //! * `right_children: array<u32>` -- the right child of each internal node.
  17 //!   It lives outside the node because `[1].w` has to stay zero to mark the
  18 //!   node internal.
  19 //! * `indices: array<u32>` -- primitives in Morton order. Leaf `i` (node
  20 //!   `count - 1 + i`) holds primitive `indices[i]`.
  21 //! * `primitive_bounds: array<vec4<f32>>` -- two entries per primitive, lower
  22 //!   then upper.
  23 
  24 /// Encode/decode between `f32` and a `u32` that compares the same way, so that
  25 /// `atomicMin`/`atomicMax` can reduce floats. WGSL has no atomic float.
  26 ///
  27 /// A non-negative float already compares correctly as an integer once the sign
  28 /// bit is set; a negative one needs every bit flipped, which turns its
  29 /// descending integer order into an ascending one.
  30 pub const ORDERED_FLOAT: &str = r#"
  31 fn ordered_from_float(value: f32) -> u32 {
  32     let bits = bitcast<u32>(value);
  33     if ((bits & 0x80000000u) != 0u) {
  34         return ~bits;
  35     }
  36     return bits | 0x80000000u;
  37 }
  38 
  39 fn float_from_ordered(bits: u32) -> f32 {
  40     if ((bits & 0x80000000u) != 0u) {
  41         return bitcast<f32>(bits & 0x7FFFFFFFu);
  42     }
  43     return bitcast<f32>(~bits);
  44 }
  45 "#;
  46 
  47 /// Morton encoding, matching [`crate::morton`] bit for bit.
  48 pub const MORTON: &str = r#"
  49 fn bvh_expand_bits(value: u32) -> u32 {
  50     var v = value & 0x3FFu;
  51     v = (v | (v << 16u)) & 0x030000FFu;
  52     v = (v | (v << 8u))  & 0x0300F00Fu;
  53     v = (v | (v << 4u))  & 0x030C30C3u;
  54     v = (v | (v << 2u))  & 0x09249249u;
  55     return v;
  56 }
  57 
  58 fn bvh_morton(unit: vec3<f32>) -> u32 {
  59     let q = vec3<u32>(clamp(unit * 1024.0, vec3<f32>(0.0), vec3<f32>(1023.0)));
  60     return (bvh_expand_bits(q.x) << 2u) | (bvh_expand_bits(q.y) << 1u) | bvh_expand_bits(q.z);
  61 }
  62 "#;
  63 
  64 const PARAMS: &str = r#"
  65 struct Params {
  66     count: u32,
  67     pad0: u32,
  68     pad1: u32,
  69     pad2: u32,
  70 };
  71 "#;
  72 
  73 /// Reduce every primitive's box into the six words of the scene bounds.
  74 pub fn bounds_source() -> String {
  75     format!(
  76         r#"
  77 @group(0) @binding(0) var<storage, read> primitive_bounds: array<vec4<f32>>;
  78 @group(0) @binding(1) var<storage, read_write> scene_bounds: array<atomic<u32>>;
  79 {PARAMS}
  80 @group(0) @binding(2) var<uniform> params: Params;
  81 {ORDERED_FLOAT}
  82 
  83 @compute @workgroup_size(256)
  84 fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {{
  85     let index = global_id.x;
  86     if (index >= params.count) {{
  87         return;
  88     }}
  89     let lower = primitive_bounds[index * 2u].xyz;
  90     let upper = primitive_bounds[index * 2u + 1u].xyz;
  91 
  92     atomicMin(&scene_bounds[0], ordered_from_float(lower.x));
  93     atomicMin(&scene_bounds[1], ordered_from_float(lower.y));
  94     atomicMin(&scene_bounds[2], ordered_from_float(lower.z));
  95     atomicMax(&scene_bounds[3], ordered_from_float(upper.x));
  96     atomicMax(&scene_bounds[4], ordered_from_float(upper.y));
  97     atomicMax(&scene_bounds[5], ordered_from_float(upper.z));
  98 }}
  99 "#
 100     )
 101 }
 102 
 103 /// A Morton code per primitive, from its centroid's position in the scene box.
 104 pub fn codes_source() -> String {
 105     format!(
 106         r#"
 107 @group(0) @binding(0) var<storage, read> primitive_bounds: array<vec4<f32>>;
 108 @group(0) @binding(1) var<storage, read> scene_bounds: array<u32>;
 109 @group(0) @binding(2) var<storage, read_write> codes: array<u32>;
 110 @group(0) @binding(3) var<storage, read_write> indices: array<u32>;
 111 {PARAMS}
 112 @group(0) @binding(4) var<uniform> params: Params;
 113 {ORDERED_FLOAT}
 114 {MORTON}
 115 
 116 @compute @workgroup_size(256)
 117 fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {{
 118     let index = global_id.x;
 119     if (index >= params.count) {{
 120         return;
 121     }}
 122 
 123     let scene_min = vec3<f32>(
 124         float_from_ordered(scene_bounds[0]),
 125         float_from_ordered(scene_bounds[1]),
