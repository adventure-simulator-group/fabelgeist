    "conditional_cases": [
      "Ordinary generated CrenellationMask source special_maps221..224 produces Opacity and avoids this mismatch; no invalid committed asset or observed crash asserted.",
      "A missing required channel may leave default nativeImages while installed is marked; exact sparse-map readiness policy needs explicit decision, do not conflate it with proven extra-channel lookup precondition.",
      "Partial mips and height_range0 are admitted legitimate modes; this finding imposes no fullmip/checksum/compressionmode requirement.",
      "Public raw BakedMap\u2192Image preconditions are a separate direct API policy; this finding concerns successfully decoded recipe/channel mismatch reaching private runtime asset.",
      "Lazy native setup reserves handles but intentionally defers requests; no optionalmode defect."
    ],
    "connected_repair_scope": [
      "Declare the actual required/allowed map channels for each recipe at the canonical owner and use it in both stable handle reservation and runtime admission.",
      "Reject incompatible channel sets with owned diagnostic context before private asset publication; do not make render installation rely on a recipe/channel relationship the decoder has not admitted.",
      "Keep actual source loader identity checks, checked dimensions/payload lengths and supported optional modes."
    ],
    "repair_dependencies": [
      "Choose exact required-versus-allowed channel/subset policy for each recipe, including leaf/glass/surface/bark/ground/Crenellation roles.",
      "Same own-L3 source proof at current e275 is qualified; global exact alias inventory and other-lens/current obligations remain separate."
    ],
    "later_repair_acceptance_requirements": [
      "CrenellationMask+Normal structurally valid container is rejected before private asset publication; correctOpacity1byte shape admitted according to chosen recipe policy.",
      "Every accepted recipe map has a reserved stable destination and required consumers never observe a missing required map under completed readiness.",
      "Generated checked recipe channel sets and load/reserve mapping agree for all actualcatalogue cases, including lazy requests and legitimatepartialmips; later implementation/runtime checks must be explicit authorized work.",
      "Admission failure retains recipe/channel and owned error classification; no obsolete API/error prose/downcast behavior preservation."
    ],
    "policy_decisions_remaining": [
      "Does readiness require the exact required channelset or a documented allowed subset? Extra channels outside reservedset are incompatible either way."
    ],
    "existing_contract_revisit_identity_proof": {
      "contract_id": "REVIEW-L3-TEXTURE-RECIPE-CHANNEL-INSTALL-ADMISSION",
      "same_exact_question": "Prior named question explicitly awaited handles/destination bodies and actual requiredrecipechannel contract; exact source18 plus source19 and current identical qualification resolve this same question.",
      "not_alias": "ADLER-L11-TEXTURE-RESIDENCY-FAILURE-STATE concerns failed load collapsed to pending; this successfuldecode incompatiblechannel\u2192missingdestination first failure is distinct."
