# Private game testing. Backends listen only on loopback.
{{DOMAIN}} {
    encode zstd gzip
    basic_auth {
        {{TEST_USER}} {{TEST_PASSWORD_HASH}}
    }
    header Cache-Control "no-store"

    # Only mission listeners can be reached through this port capture.
    # Requiring this origin also prevents other sites opening tester sockets.
    @tactical {
        path_regexp tactical ^/t(600[1-9]|60[1-9][0-9]|6[1-9][0-9]{2})$
        header Origin https://{{DOMAIN}}
    }
    @reserved path_regexp reserved ^/t[0-9]+$
    route {
        reverse_proxy @tactical 127.0.0.1:{re.tactical.1} {
            header_up -Authorization
        }
        respond @reserved "Mission connection unavailable" 403
        reverse_proxy 127.0.0.1:8080 {
            header_up -Authorization
        }
    }
}
